+-- Veste um jogador de SWAT: primeiro a roupa, depois capacete, fone, óculos, balaclava e colete
+-- (se algum item do catálogo falhar, a roupa fica). Mantém a cor da pele e o rosto do jogador.
+function Pavel.vestirSwat(hum: Humanoid, comMascara: boolean, log: ((string) -> ())?)
+	local okBase, atual = pcall(function()
+		return hum:GetAppliedDescription()
+	end)
+	local base: HumanoidDescription = if okBase and atual then atual else Instance.new("HumanoidDescription")
+	local function montar(completo: boolean): HumanoidDescription
