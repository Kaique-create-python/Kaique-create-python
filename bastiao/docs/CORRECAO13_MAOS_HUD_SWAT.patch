+		end
+		d.HatAccessory = ""
+		if completo then
+			local chapeu = SWAT.capacete .. "," .. SWAT.fone
+			if comMascara then
+				chapeu ..= "," .. SWAT.balaclava .. "," .. SWAT.oculos
+			end
+			d.HatAccessory = chapeu
+			d.FrontAccessory = tostring(SWAT.colete)
+		end
+		return d
+	end
+	for _, completo in { false, true } do
+		local ok, erro = pcall(function()
+			hum:ApplyDescription(montar(completo))
+		end)
+		if not ok and log then
+			log("[Bastiao] uniforme tático " .. (if completo then "(equipamento)" else "(roupa)") .. " falhou: " .. tostring(erro))
+		end
+	end
+end
