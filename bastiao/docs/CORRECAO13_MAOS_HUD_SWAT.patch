+-- equipe tática: todo jogador entra de SWAT (depois que a aparência da conta carregar)
+local function vestirSwat(j: Player, c: Model)
+	if type(Pavel.vestirSwat) ~= "function" then
+		return
+	end
+	local hum = c:WaitForChild("Humanoid", 10)
+	if not hum or not hum:IsA("Humanoid") then
+		return
+	end
+	if not j:HasAppearanceLoaded() then
+		local pronto = false
+		local con = j.CharacterAppearanceLoaded:Connect(function()
+			pronto = true
+		end)
+		local inicio = os.clock()
+		while not pronto and os.clock() - inicio < 6 and c.Parent do
+			task.wait(0.2)
+		end
+		con:Disconnect()
+	end
+	if c.Parent and j.Character == c then
+		Pavel.vestirSwat(hum :: Humanoid, true, warn)
+	end
+end
+
 local function jogadorEntrou(j: Player)
 	preferencias:carregar(j)
 	j.CharacterAdded:Connect(function(c)
 		prepararPersonagem(j, c)
+		task.spawn(vestirSwat, j, c)
 	end)
 	j.CharacterRemoving:Connect(function()
