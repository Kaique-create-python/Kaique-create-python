+			local d = (corpo.Position - raiz.Position).Magnitude
+			local perto = math.clamp(1 - (d - 8) / 55, 0, 1)
+			if estado == "chase" or estado == "attack" or estado == "alert" then
+				alvo = perto
+			elseif estado == "search" then
+				alvo = perto * 0.45
