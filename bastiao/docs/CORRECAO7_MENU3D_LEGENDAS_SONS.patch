+			end
+		end
+	end))
+
+	local function destroy()
+		if not vivo then
+			return
+		end
+		vivo = false
+		for _, c in conexoes do
+			c:Disconnect()
+		end
+		limparCantos()
+		mostrarPainel()
+		fx:Destroy()
+		borda:Destroy()
+		cor:Destroy()
+	end
+	return { destroy = destroy }
+end
+
+return Efeitos
