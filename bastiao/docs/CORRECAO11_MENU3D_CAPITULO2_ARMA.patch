+			else
+				atualizarMunicao()
+			end
+		end))
+	end
+	table.insert(conexoes, hud:GetPropertyChangedSignal("AbsoluteSize"):Connect(posicionarBotoes))
+	pcall(function()
+		table.insert(conexoes, UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(posicionarBotoes))
+	end)
+	table.insert(conexoes, jogador.CharacterAdded:Connect(function()
+		segurando = false
+		recargaDesde = nil
+		task.delay(0.5, atualizar)
+	end))
+	atualizar()
+
+	api.disparar = disparar -- para testes
+	api.segurar = function(v: boolean)
+		segurando = v
+	end
+	function api.destroy()
+		vivo = false
+		segurando = false
+		for _, c in conexoes do
+			c:Disconnect()
+		end
+		table.clear(conexoes)
+		pcall(function()
+			RunService:UnbindFromRenderStep("BastiaoArma")
+			RunService:UnbindFromRenderStep("BastiaoCoiceUnwind")
+		end)
+		desfazerCoice()
+		destruirVm()
+		hud:Destroy()
+		pasta:Destroy()
+	end
+	return api
+end
+
+return Arma
