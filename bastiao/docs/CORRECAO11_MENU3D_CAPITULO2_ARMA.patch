+end
+
+export type Opcoes = { bracos: boolean?, ancorado: boolean? }
+
+-- Monta o modelo: PrimaryPart "Corpo", tudo soldado nele (WeldConstraint) e os pontos de encaixe.
+function ArmaModelo.construir(op: Opcoes?): Model
+	local opcoes = op or {}
+	local modelo = Instance.new("Model")
+	modelo.Name = "BastiaoAK74"
+	local lista = ArmaModelo.pecas()
+	if opcoes.bracos then
+		for _, b in bracos() do
+			table.insert(lista, b)
+		end
+	end
+	local corpo: BasePart? = nil
+	local partes = {}
+	for _, peca in lista do
