+		mola.vz += 7.5
+		mola.vp += 55
+		mola.vr += (math.random() * 2 - 1) * 30
+		coice.p += math.rad(0.55 + math.random() * 0.35)
+		coice.y += math.rad((math.random() * 2 - 1) * 0.35)
+		abertura = math.min(1, abertura + 0.22)
+	end
+
+	local function recarregar()
+		if not vivo or not remRecarga then
+			return
+		end
+		local pente = tonumber(jogador:GetAttribute("BastiaoPente")) or 0
+		local reserva = tonumber(jogador:GetAttribute("BastiaoReserva")) or 0
+		if pente >= 30 or reserva <= 0 or jogador:GetAttribute("BastiaoRecarregando") == true then
+			return
+		end
+		remRecarga:FireServer()
+		tocar("ak_recarga")
