+	end
+
+	-- ===== quadro a quadro: arma na câmera, mola do coice, mira e a cápsula =====
+	local function desfazerCoice()
+		local cam = workspace.CurrentCamera
+		if coiceAplicado and cam then
+			cam.CFrame = cam.CFrame * coiceAplicado:Inverse()
+		end
+		coiceAplicado = nil
+	end
+	RunService:BindToRenderStep("BastiaoCoiceUnwind", Enum.RenderPriority.Input.Value - 4, desfazerCoice)
+	RunService:BindToRenderStep("BastiaoArma", Enum.RenderPriority.Last.Value + 4, function(dt: number)
+		local cam = workspace.CurrentCamera
