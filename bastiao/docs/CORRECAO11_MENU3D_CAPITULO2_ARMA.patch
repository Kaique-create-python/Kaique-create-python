+		-- freio de boca de duas câmaras (marca do AK-74)
+		P("FreioBoca", "cilindro", V3(2.4, 2.4, 8), V3(0, 0, -58), METAL, M),
+		P("FreioRanhura", "cilindro", V3(2.46, 2.46, 0.6), V3(0, 0, -56.6), OXIDO, M),
+		P("FreioJanelaE", "bloco", V3(0.12, 0.9, 3.0), V3(-1.22, 0, -58.8), OXIDO, M),
+		P("FreioJanelaD", "bloco", V3(0.12, 0.9, 3.0), V3(1.22, 0, -58.8), OXIDO, M),
