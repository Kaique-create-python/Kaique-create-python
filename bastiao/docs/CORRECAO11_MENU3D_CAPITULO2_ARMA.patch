+		P("PunhoDireito", "bloco", V3(4.0, 4.0, 5), V3(1.6, -10.6, 10.6), LUVA, S, V3(-40, 8, 0)),
+		P("MangaDireita", "bloco", V3(5.0, 5.0, 26), V3(5.0, -16.5, 21), UNIFORME, F, V3(-34, 14, 0)),
