+	local monstroCache: { raiz: BasePart?, altura: number?, ate: number } = { raiz = nil, altura = nil, ate = 0 }
+	local function monstroAgora(): (BasePart?, number?)
+		if os.clock() > monstroCache.ate or (monstroCache.raiz and not monstroCache.raiz.Parent) then
+			monstroCache.raiz, monstroCache.altura = monstro()
+			monstroCache.ate = os.clock() + 1.5
+		end
+		return monstroCache.raiz, monstroCache.altura
+	end
