+	local corpo = m.PrimaryPart :: BasePart
+	local delta = destino * corpo.CFrame:Inverse()
+	for _, d in m:GetDescendants() do
+		if d:IsA("BasePart") then
+			d.CFrame = delta * d.CFrame
+		end
+	end
+end
+
+-- fuzil de pé no suporte: cano para cima, lado direito virado para a sala
+local function cfFuzil(base: CFrame, x: number): CFrame
+	local origem = base * CFrame.new(x, 1.72, 0.05)
+	local giro = CFrame.fromMatrix(Vector3.zero, V(0, 0, -1), V(1, 0, 0), V(0, -1, 0))
+	return origem * giro * CFrame.new(V(0, -1.5, -1.5) * CM)
+end
