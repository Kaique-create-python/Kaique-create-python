+		P("Manejo", "cilindro", V3(0.9, 0.9, 1.8), V3(2.3, 0.7, -8), ACO, M, V3(0, 90, 0)),
+		P("Retem", "bloco", V3(2.0, 1.2, 1.0), V3(0, -5.1, -3.8), OXIDO, M),
+		-- coronha fixa de madeira laminada com soleira de aço
+		P("CoronhaCima", "bloco", V3(3.6, 4.0, 24), V3(0, -0.6, 24), MADEIRA, W, V3(6, 0, 0)),
