+	local function disparar()
+		local cam = workspace.CurrentCamera
+		if not cam or not podeAtirar() then
+			return
+		end
+		local pente = tonumber(jogador:GetAttribute("BastiaoPente")) or 0
+		if pente <= 0 then
+			tocar("ak_vazio")
+			segurando = false
+			return
+		end
+		local espalha = DISPERSAO * (1 + abertura * 1.5)
+		local giro = CFrame.Angles((math.random() * 2 - 1) * espalha, (math.random() * 2 - 1) * espalha, 0)
+		local origem = cam.CFrame.Position
+		local direcao = (cam.CFrame * giro).LookVector
+		local params = RaycastParams.new()
+		params.FilterType = Enum.RaycastFilterType.Exclude
+		local ignorar: { Instance } = { pasta }
+		if vm then
+			table.insert(ignorar, vm)
+		end
+		for _, outro in Players:GetPlayers() do
+			if outro.Character then
+				table.insert(ignorar, outro.Character)
+			end
+		end
+		params.FilterDescendantsInstances = ignorar
+		local alcance = 320
+		local r = workspace:Raycast(origem, direcao * alcance, params)
+		local distParede = if r then (r.Position - origem).Magnitude else math.huge
+		local tipo, alvo, normal = "nada", origem + direcao * alcance, -direcao
+		if r then
+			tipo, alvo, normal = "parede", r.Position, r.Normal
+		end
+		local raiz, altura = monstroAgora()
+		if raiz and altura then
+			local raio = math.clamp(altura * 0.17, 1.1, 2.0)
+			local base = raiz.Position - Vector3.new(0, altura * 0.5 - raio, 0)
+			local topo = raiz.Position + Vector3.new(0, altura * 0.5 - raio * 0.6, 0)
+			-- mesmo teste do servidor (Arma.maisPerto), aqui só para o efeito sair na hora
+			local e = topo - base
+			local w = origem - base
+			local ee, de, dr, er = e:Dot(e), direcao:Dot(e), direcao:Dot(w), e:Dot(w)
+			local u = math.clamp(er / ee, 0, 1)
+			local den = ee - de * de
+			local s = 0
+			if den > 1e-6 then
+				s = math.clamp((de * er - dr * ee) / den, 0, alcance)
+				u = math.clamp((de * s + er) / ee, 0, 1)
+			end
+			s = math.clamp(de * u - dr, 0, alcance)
+			local dist = ((origem + direcao * s) - (base + e * u)).Magnitude
+			if dist <= raio then
+				local entrada = math.max(0, s - math.sqrt(math.max(0, raio * raio - dist * dist)))
+				if entrada < distParede then
+					tipo, alvo, normal = "carne", origem + direcao * entrada, -direcao
+				end
+			end
+		end
+		if remTiro then
+			remTiro:FireServer(origem, direcao)
+		end
+		-- efeitos na hora (o servidor confirma e mostra para os outros)
+		if cano then
+			clarao(cano, true)
+			if math.random() < 0.6 then
+				rastro(cano.WorldPosition, alvo)
+			end
+		end
+		capsula()
