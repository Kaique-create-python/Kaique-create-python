diff -ruN a/tests/server_arma_test.luau b/tests/server_arma_test.luau
--- a/tests/server_arma_test.luau
+++ b/tests/server_arma_test.luau
@@ -0,0 +1,145 @@
+-- Arma (servidor): acerto no monstro por cápsula, parede no caminho, cadência, munição, recarga,
+-- tiro falso recusado e efeito mandado para todos. Ambiente falso, sem motor.
+local fs = require("@lune/fs")
+local luau = require("@lune/luau")
+local roblox = require("@lune/roblox")
+local V3, CF = roblox.Vector3, roblox.CFrame
+
+local agora = 0
+local atrasados = {}
+local function rodar(ate)
+	agora = ate
+	local ainda = {}
+	for _, a in atrasados do if a.at <= ate then a.fn() else table.insert(ainda, a) end end
+	atrasados = ainda
+end
+local function sinal()
+	local s = { ouvintes = {} }
+	function s:Connect(fn) table.insert(self.ouvintes, fn); return { Disconnect = function() end } end
+	function s:Fire(...) for _, fn in self.ouvintes do fn(...) end end
+	return s
+end
+local function no(classe, nome)
+	local n = { ClassName = classe, Name = nome, filhos = {}, attrs = {} }
+	function n:FindFirstChild(x) for _, f in self.filhos do if f.Name == x then return f end end return nil end
+	function n:FindFirstChildOfClass(x) for _, f in self.filhos do if f.ClassName == x then return f end end return nil end
+	function n:WaitForChild(x) return self:FindFirstChild(x) end
+	function n:IsA(x) return self.ClassName == x or (x == "BasePart" and (self.ClassName == "Part" or self.ClassName == "MeshPart")) end
+	function n:SetAttribute(k, v) self.attrs[k] = v end
+	function n:GetAttribute(k) return self.attrs[k] end
+	function n:Destroy() self.Parent = nil end
+	return setmetatable(n, { __newindex = function(t, k, v)
+		if k == "Parent" and v and v.filhos then table.insert(v.filhos, t) end
+		rawset(t, k, v)
+	end })
+end
+local efeitos = {}
+local remotos = {}
+local Instance = { new = function(classe, pai)
+	local n = no(classe, classe)
+	if classe == "RemoteEvent" then
+		n.OnServerEvent = sinal()
+		function n:FireAllClients(msg) table.insert(efeitos, msg) end
+		remotos[#remotos + 1] = n
+	elseif classe == "Animator" then
+		function n:LoadAnimation() return { Play = function() end, Stop = function() end } end
+	end
+	if pai then n.Parent = pai end
+	return n
+end }
+-- mundo: uma parede em z = -30 (só se o tiro for nessa direção) e o monstro em (0, 4.5, -20), altura 9
+local paredeZ = -30
+local workspace = { Raycast = function(_, origem, dir)
+	if dir.Z < 0 then
+		local t = (paredeZ - origem.Z) / dir.Unit.Z
+		if t > 0 and t <= dir.Magnitude then
+			return { Position = origem + dir.Unit * t, Normal = V3.new(0, 0, 1), Instance = {} }
+		end
+	end
+	return nil
+end }
+local jogadores = {}
+local Players = { PlayerAdded = sinal(), PlayerRemoving = sinal() }
+function Players:GetPlayers() return jogadores end
+local game = { GetService = function(_, n) if n == "Players" then return Players end end }
+local RaycastParams = { new = function() return {} end }
+local env = { game = game, workspace = workspace, Instance = Instance, Vector3 = V3, CFrame = CF, Enum = roblox.Enum,
+	RaycastParams = RaycastParams, typeof = function(v) if type(v) == "userdata" then return typeof(v) end return type(v) end,
+	task = { delay = function(s, fn) table.insert(atrasados, { at = agora + s, fn = fn }) end, spawn = function(fn, ...) fn(...) end },
+	math = math, table = table, pcall = pcall, tostring = tostring, print = print }
+local Arma = luau.load(fs.readFile("src/server/Arma.luau"), { environment = env, injectGlobals = true })()
+
+-- 1) cápsula
+assert(math.abs(Arma.acertoCapsula(V3.new(0, 5, 0), V3.new(0, 0, -1), 320, V3.new(0, 4.5, -20), 9) - (20 - 1.53)) < 0.05, "entrada na cápsula errada")
+assert(Arma.acertoCapsula(V3.new(3, 5, 0), V3.new(0, 0, -1), 320, V3.new(0, 4.5, -20), 9) == nil, "tiro do lado pegou")
+assert(Arma.acertoCapsula(V3.new(0, 11, 0), V3.new(0, 0, -1), 320, V3.new(0, 4.5, -20), 9) == nil, "tiro por cima da cabeça pegou")
+assert(Arma.acertoCapsula(V3.new(0, 5, 0), V3.new(0, 0, 1), 320, V3.new(0, 4.5, -20), 9) == nil, "tiro para trás pegou")
+
+-- 2) jogador com personagem
+local jogador = no("Player", "Ana"); jogador.UserId = 101; jogador.CharacterAdded = sinal()
+local personagem = no("Model", "Ana")
+local cabeca = no("Part", "Head"); cabeca.Position = V3.new(0, 5, 0); cabeca.Parent = personagem
+local braco = no("Part", "Right Arm"); braco.Parent = personagem
+local humano = no("Humanoid", "Humanoid"); humano.Health = 100; humano.Parent = personagem
+jogador.Character = personagem
+table.insert(jogadores, jogador)
+local compartilhado = no("Folder", "BastiaoCompartilhado")
+local Modelo = { construir = function()
+	local m = no("Model", "BastiaoAK74")
+	local corpo = no("Part", "Corpo"); corpo.Parent = m; m.PrimaryPart = corpo
+	local mao = no("Attachment", "Mao"); mao.CFrame = CF.new(); mao.Parent = corpo
+	return m
+end }
+local acertos = {}
+local raiz = { Position = V3.new(0, 4.5, -20) }
+local criatura = { corpo = function() return raiz, 9 end, atingir = function(info) table.insert(acertos, info); return "doeu" end }
+local api = Arma.iniciar({ compartilhado = compartilhado, modelo = Modelo, criatura = criatura, agora = function() return agora end, log = function() end })
+assert(compartilhado:FindFirstChild("BastiaoArmaTiro") and compartilhado:FindFirstChild("BastiaoArmaRecarga") and compartilhado:FindFirstChild("BastiaoArmaEfeito"), "remotos não criados")
+assert(api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1)) == "sem_arma", "atirou sem arma")
+assert(api.dar(jogador) == true, "primeira entrega")
+assert(jogador:GetAttribute("BastiaoArma") == true and jogador:GetAttribute("BastiaoPente") == 30 and jogador:GetAttribute("BastiaoReserva") == 90, "atributos da arma")
+assert(personagem:FindFirstChild("BastiaoAK74"), "arma não foi para a mão")
+-- monstro antes da parede: carne
+local tipo, ponto = api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1))
+assert(tipo == "carne" and #acertos == 1 and acertos[1].jogador == jogador, "não acertou o monstro: " .. tostring(tipo))
+assert(math.abs(ponto.Z - (-18.47)) < 0.1, "ponto do acerto errado " .. tostring(ponto))
+assert(efeitos[#efeitos].tipo == "carne" and efeitos[#efeitos].atirador == 101, "efeito não foi para todos")
+assert(api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1)) == "rapido_demais", "cadência não segurou")
+-- parede antes do monstro: parede (o monstro atrás dela não é atingido)
+paredeZ = -12
+rodar(0.2)
+assert(api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1)) == "parede" and #acertos == 1, "atravessou a parede")
+paredeZ = -30
+-- tiro falso: direção sem tamanho 1, origem longe (vale a cabeça)
+rodar(0.4)
+assert(api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -5)) == "invalido", "direção falsa aceita")
+assert(api.atirar(jogador, V3.new(0, 5, 0), "x") == "invalido", "direção que não é vetor aceita")
+local t2 = api.atirar(jogador, V3.new(40, 5, -19), V3.new(-1, 0, 0))
+assert(t2 ~= "carne", "tiro de longe da cabeça (teleporte) acertou o monstro")
+-- esvazia o pente
+local tiros = 0
+for i = 1, 40 do
+	rodar(agora + 0.1)
+	local r = api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1))
+	if r == "vazio" then break end
+	tiros += 1
+end
+assert(jogador:GetAttribute("BastiaoPente") == 0 and api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1)) == "vazio", "pente não esvaziou")
+-- recarga
+assert(api.recarregar(jogador) == "recarregando" and jogador:GetAttribute("BastiaoRecarregando") == true, "não recarregou")
+rodar(agora + 0.5)
+assert(api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1)) == "recarregando", "atirou recarregando")
+rodar(agora + 2.0)
+assert(jogador:GetAttribute("BastiaoPente") == 30 and jogador:GetAttribute("BastiaoReserva") == 60 and jogador:GetAttribute("BastiaoRecarregando") == false, "recarga não encheu o pente")
+-- morto não atira
+humano.Health = 0
+rodar(agora + 0.2)
+assert(api.atirar(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1)) == "morto", "morto atirou")
+-- remoto ligado de verdade
+humano.Health = 100
+rodar(agora + 0.2)
+local antes = #efeitos
+compartilhado:FindFirstChild("BastiaoArmaTiro").OnServerEvent:Fire(jogador, V3.new(0, 5, 0), V3.new(0, 0, -1))
+assert(#efeitos == antes + 1, "remoto de tiro não chamou o servidor")
+api.destroy()
+print("PASS Arma servidor: cápsula, parede no caminho, cadência, munição, recarga, tiro falso recusado, morto não atira e efeito para todos")
