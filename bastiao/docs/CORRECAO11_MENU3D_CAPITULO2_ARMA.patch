+	-- ===== monstro: cápsula para saber se o meu tiro pegou nele (só para o efeito imediato) =====
+	local function monstro(): (BasePart?, number?)
+		for _, d in workspace:GetDescendants() do
+			if d:IsA("Model") and d:GetAttribute("BastiaoCreature") == true then
+				local raiz = d:FindFirstChild("HumanoidRootPart")
+				if raiz and raiz:IsA("BasePart") then
