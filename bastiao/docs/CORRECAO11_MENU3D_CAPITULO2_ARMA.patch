+	local function rastro(de: Vector3, ate: Vector3)
+		local dist = (ate - de).Magnitude
+		if dist < 3 then
+			return
+		end
+		local a0 = ancora(pasta, CFrame.new(de), 0.2)
+		local a1 = ancora(pasta, CFrame.new(de + (ate - de).Unit * math.min(dist, 14)), 0.2)
+		local b = Instance.new("Beam")
+		b.Attachment0, b.Attachment1 = a0, a1
+		b.FaceCamera = true
+		b.LightEmission = 1
+		b.LightInfluence = 0
+		b.Width0, b.Width1 = 0.035, 0.012
+		b.Color = ColorSequence.new(Color3.fromRGB(255, 220, 160))
+		b.Transparency = ns({ { 0, 0.85 }, { 0.4, 0.25 }, { 1, 0 } })
+		b.Parent = a0
+		-- o pedaço de luz corre até o alvo
+		local a1p = a1.Parent :: BasePart
+		local passo = 0
+		local tempo = math.clamp(dist / 900, 0.03, 0.14)
+		local c: RBXScriptConnection? = nil
+		c = RunService.RenderStepped:Connect(function(dt)
+			passo += dt
+			local k = math.clamp(passo / tempo, 0, 1)
+			local cabeca = de + (ate - de) * k
+			local cauda = de + (ate - de) * math.max(0, k - math.min(1, 14 / dist))
+			if a1p.Parent and (a0.Parent :: BasePart).Parent then
+				(a1p :: BasePart).CFrame = CFrame.new(cabeca);
+				(a0.Parent :: BasePart).CFrame = CFrame.new(cauda)
+			end
+			if k >= 1 and c then
+				c:Disconnect()
+				b.Enabled = false
+			end
+		end)
+	end
