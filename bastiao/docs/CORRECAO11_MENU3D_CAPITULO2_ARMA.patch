+local function peca(pai: Instance, nome: string, tam: Vector3, cf: CFrame, cor: Color3, material: Enum.Material?): Part
+	local p = Instance.new("Part")
+	p.Name = nome
+	p.Anchored = true
+	p.CanCollide = true
+	p.CanTouch = false
+	p.Size = tam
+	p.CFrame = cf
+	p.Color = cor
+	p.Material = material or Enum.Material.Metal
+	p.TopSurface = Enum.SurfaceType.Smooth
+	p.BottomSurface = Enum.SurfaceType.Smooth
