+	estrela = "rbxassetid://104522736604818", -- raios do impacto (Gewpy)
+	fumaca = "rbxassetid://13346862770", -- Transparent smoke 2, flipbook 4x4 (kirbyzaz)
+	poeira = "rbxassetid://6672985426", -- Smoke Particle (adoaks08)
+	sangue = "rbxassetid://123520418475309", -- Blood Splatter (mihailuser1)
+	gotas = "rbxassetid://119516896516751", -- blood_splatter_overlay (fool5abcd)
