diff -ruN a/src/server/Arma.luau b/src/server/Arma.luau
--- a/src/server/Arma.luau
+++ b/src/server/Arma.luau
@@ -0,0 +1,308 @@
+--!strict
+-- PROJETO BASTIÃO :: Arma (servidor) — o AK-74 do armário da oficina (capítulo 2).
+-- O cliente desenha e envia o tiro; o servidor decide: cadência, munição, de onde saiu, parede no
+-- caminho e se pegou o monstro. As peças do 731-A não aceitam raio (para não atrapalhar a visão
+-- dele), então o acerto nele é uma cápsula em volta do corpo, conferida contra as paredes.
+-- O monstro não morre: cada acerto dói, sete em poucos segundos o deixam atordoado e ele foge.
+
+local Players = game:GetService("Players")
+
+local Arma = {}
+
+Arma.PENTE = 30
+Arma.RESERVA = 90
+Arma.CADENCIA = 0.1 -- 600 tiros por minuto
+Arma.RECARGA = 2.4
+Arma.ALCANCE = 320
+Arma.ANIM_SEGURAR = "rbxassetid://182393478" -- R6 "toolnone": braço direito estendido à frente
+
+-- menor distância entre o segmento do tiro e o eixo do monstro (s = distância no tiro)
+function Arma.maisPerto(o: Vector3, d: Vector3, comprimento: number, a: Vector3, b: Vector3): (number, number)
+	local e = b - a
+	local r = o - a
+	local ee = e:Dot(e)
+	local de = d:Dot(e)
+	local dr = d:Dot(r)
+	local er = e:Dot(r)
+	local u = if ee > 1e-9 then math.clamp(er / ee, 0, 1) else 0
+	local s = 0
+	local den = ee - de * de
+	if den > 1e-6 then
+		s = math.clamp((de * er - dr * ee) / den, 0, comprimento)
+		u = if ee > 1e-9 then math.clamp((de * s + er) / ee, 0, 1) else 0
+	end
+	s = math.clamp(de * u - dr, 0, comprimento)
+	local p1 = o + d * s
+	local p2 = a + e * u
+	return s, (p1 - p2).Magnitude
+end
+
+-- distância até entrar na cápsula do monstro (nil se o tiro não passa por ela)
+function Arma.acertoCapsula(origem: Vector3, direcao: Vector3, alcance: number, raiz: Vector3, altura: number): number?
+	local raio = math.clamp(altura * 0.17, 1.1, 2.0)
+	local base = raiz - Vector3.new(0, altura * 0.5 - raio, 0)
+	local topo = raiz + Vector3.new(0, altura * 0.5 - raio * 0.6, 0)
+	local s, dist = Arma.maisPerto(origem, direcao, alcance, base, topo)
+	if dist > raio then
+		return nil
+	end
+	local volta = math.sqrt(math.max(0, raio * raio - dist * dist))
+	return math.max(0, s - volta)
+end
+
+export type Opcoes = {
+	compartilhado: Instance,
+	modelo: any, -- ArmaModelo
+	criatura: any?, -- { corpo(): (BasePart?, number?), atingir(info): string? }
+	ignorar: (() -> { Instance })?, -- coisas que o tiro atravessa (marcadores, peças invisíveis)
+	log: ((string) -> ())?,
+	agora: (() -> number)?,
+}
+
+function Arma.iniciar(op: Opcoes)
+	local log = op.log or print
+	local agora = op.agora or os.clock
+	local api = {}
+	local estados: { [Player]: any } = {}
+	local conexoes: { RBXScriptConnection } = {}
+
+	local function remoto(nome: string): RemoteEvent
+		local r = op.compartilhado:FindFirstChild(nome)
+		if r and r:IsA("RemoteEvent") then
+			return r
+		end
+		local novo = Instance.new("RemoteEvent")
+		novo.Name = nome
+		novo.Parent = op.compartilhado
+		return novo
+	end
+	local remTiro = remoto("BastiaoArmaTiro")
+	local remRecarga = remoto("BastiaoArmaRecarga")
+	local remEfeito = remoto("BastiaoArmaEfeito")
+
+	local function publicar(j: Player, e: any)
+		j:SetAttribute("BastiaoArma", e.tem == true)
+		j:SetAttribute("BastiaoPente", e.pente)
+		j:SetAttribute("BastiaoReserva", e.reserva)
+		j:SetAttribute("BastiaoRecarregando", e.recarregandoAte ~= nil)
+	end
+
+	-- arma na mão do personagem (o que os outros veem) e o braço estendido segurando
+	local function equipar(j: Player, personagem: Model)
+		local e = estados[j]
+		if not e or not e.tem then
+			return
+		end
+		local braco = personagem:WaitForChild("Right Arm", 10)
+		local humano = personagem:FindFirstChildOfClass("Humanoid")
+		if not braco or not braco:IsA("BasePart") or not humano or personagem ~= j.Character then
+			return
+		end
+		local velho = personagem:FindFirstChild("BastiaoAK74")
+		if velho then
+			velho:Destroy()
+		end
+		local arma = op.modelo.construir()
+		local corpo = arma.PrimaryPart :: BasePart
+		local mao = corpo:FindFirstChild("Mao") :: Attachment
+		local solda = Instance.new("Weld")
+		solda.Name = "BastiaoMaoArma"
+		solda.Part0 = braco
+		solda.Part1 = corpo
+		-- braço levantado à frente: o -Y do braço aponta para frente; o cano vai junto
+		solda.C0 = CFrame.new(0, -1.0, -0.15) * CFrame.Angles(-math.pi / 2, 0, 0)
+		solda.C1 = mao.CFrame
+		solda.Parent = corpo
+		arma.Parent = personagem
+		local animador = humano:FindFirstChildOfClass("Animator") or Instance.new("Animator", humano)
+		local anim = Instance.new("Animation")
+		anim.AnimationId = Arma.ANIM_SEGURAR
+		local ok, faixa = pcall(function()
+			return (animador :: Animator):LoadAnimation(anim)
+		end)
+		if ok and faixa then
+			faixa.Priority = Enum.AnimationPriority.Action
+			faixa.Looped = true
+			faixa:Play(0.2)
+			e.faixa = faixa
+		end
+	end
+
+	function api.dar(j: Player)
+		local e = estados[j]
+		if not e then
+			e = { tem = false, pente = 0, reserva = 0, ultimoTiro = -math.huge, recarregandoAte = nil, tiros = 0 }
+			estados[j] = e
+		end
+		local primeira = not e.tem
+		e.tem = true
+		e.pente = Arma.PENTE
+		e.reserva = math.max(e.reserva, Arma.RESERVA)
+		publicar(j, e)
+		if primeira and j.Character then
+			task.spawn(equipar, j, j.Character)
+		end
+		return primeira
+	end
+
+	function api.tem(j: Player): boolean
+		local e = estados[j]
+		return e ~= nil and e.tem == true
+	end
+
+	-- processa um tiro (exposto para teste): devolve "carne", "parede", "nada" ou o motivo da recusa
+	function api.atirar(j: Player, origem: any, direcao: any): (string, Vector3?, Vector3?)
+		local e = estados[j]
+		if not e or not e.tem then
+			return "sem_arma"
+		end
+		if typeof(origem) ~= "Vector3" or typeof(direcao) ~= "Vector3" then
+			return "invalido"
+		end
+		local m = direcao.Magnitude
+		if m < 0.9 or m > 1.1 or origem.X ~= origem.X or direcao.X ~= direcao.X then
+			return "invalido"
+		end
+		direcao = direcao.Unit
+		local t = agora()
+		if e.recarregandoAte then
+			return "recarregando"
+		end
+		if t - e.ultimoTiro < Arma.CADENCIA * 0.8 then
+			return "rapido_demais"
+		end
+		if e.pente <= 0 then
+			return "vazio"
+		end
+		local personagem = j.Character
+		local humano = personagem and personagem:FindFirstChildOfClass("Humanoid")
+		local cabeca = personagem and personagem:FindFirstChild("Head")
+		if not personagem or not humano or humano.Health <= 0 or not cabeca or not cabeca:IsA("BasePart") then
+			return "morto"
+		end
+		-- a bodycam fica no peito/cabeça: o tiro sai de perto do corpo, senão vale a cabeça
+		if (origem - cabeca.Position).Magnitude > 5 then
+			origem = cabeca.Position
+		end
+		e.ultimoTiro = t
+		e.pente -= 1
+		e.tiros += 1
+		publicar(j, e)
+		local ignorar: { Instance } = {}
+		for _, outro in Players:GetPlayers() do
+			if outro.Character then
+				table.insert(ignorar, outro.Character)
+			end
+		end
+		if op.ignorar then
+			for _, x in op.ignorar() do
+				table.insert(ignorar, x)
+			end
+		end
+		local params = RaycastParams.new()
+		params.FilterType = Enum.RaycastFilterType.Exclude
+		params.FilterDescendantsInstances = ignorar
+		local parede = workspace:Raycast(origem, direcao * Arma.ALCANCE, params)
+		local distParede = if parede then (parede.Position - origem).Magnitude else math.huge
+		local tipo, ponto, normal = "nada", origem + direcao * Arma.ALCANCE, -direcao
+		if parede then
+			tipo, ponto, normal = "parede", parede.Position, parede.Normal
+		end
+		local criatura = op.criatura
+		if criatura then
+			local raiz, altura = criatura.corpo()
+			if raiz and altura then
+				local s = Arma.acertoCapsula(origem, direcao, Arma.ALCANCE, raiz.Position, altura)
+				if s and s < distParede then
+					tipo, ponto, normal = "carne", origem + direcao * s, -direcao
+					local ok, r = pcall(criatura.atingir, { jogador = j, origem = origem, ponto = ponto, direcao = direcao })
+					if not ok then
+						log("[Bastiao] tiro no monstro falhou: " .. tostring(r))
+					end
+				end
+			end
+		end
+		remEfeito:FireAllClients({ atirador = j.UserId, origem = origem, ponto = ponto, normal = normal, tipo = tipo })
+		return tipo, ponto, normal
+	end
+
+	function api.recarregar(j: Player): string
+		local e = estados[j]
+		if not e or not e.tem then
+			return "sem_arma"
+		end
+		if e.recarregandoAte or e.pente >= Arma.PENTE or e.reserva <= 0 then
+			return "nao_precisa"
+		end
+		local ate = agora() + Arma.RECARGA
+		e.recarregandoAte = ate
+		publicar(j, e)
+		remEfeito:FireAllClients({ atirador = j.UserId, tipo = "recarga" })
+		task.delay(Arma.RECARGA, function()
+			if estados[j] ~= e or e.recarregandoAte ~= ate then
+				return
+			end
+			local n = math.min(Arma.PENTE - e.pente, e.reserva)
+			e.pente += n
+			e.reserva -= n
+			e.recarregandoAte = nil
+			publicar(j, e)
+		end)
+		return "recarregando"
+	end
+
+	table.insert(conexoes, remTiro.OnServerEvent:Connect(function(j: Player, origem: any, direcao: any)
+		local ok, err = pcall(api.atirar, j, origem, direcao)
+		if not ok then
+			log("[Bastiao] tiro recusado por erro: " .. tostring(err))
+		end
+	end))
+	table.insert(conexoes, remRecarga.OnServerEvent:Connect(function(j: Player)
+		pcall(api.recarregar, j)
+	end))
+
+	local function ligarJogador(j: Player)
+		table.insert(conexoes, j.CharacterAdded:Connect(function(personagem)
+			local e = estados[j]
+			if e and e.tem then
+				-- quem morre volta com o pente cheio (a reserva continua a mesma)
+				e.recarregandoAte = nil
+				e.pente = Arma.PENTE
+				publicar(j, e)
+				equipar(j, personagem)
+			end
+		end))
+	end
+	for _, j in Players:GetPlayers() do
+		ligarJogador(j)
+	end
+	table.insert(conexoes, Players.PlayerAdded:Connect(ligarJogador))
+	table.insert(conexoes, Players.PlayerRemoving:Connect(function(j)
+		estados[j] = nil
+	end))
+
+	function api.destroy()
+		for _, c in conexoes do
+			c:Disconnect()
+		end
+		table.clear(conexoes)
+		for j, e in estados do
+			if e.faixa then
+				pcall(function()
+					e.faixa:Stop(0)
+				end)
+			end
+			if j.Character then
+				local arma = j.Character:FindFirstChild("BastiaoAK74")
+				if arma then
+					arma:Destroy()
+				end
+			end
+		end
+		table.clear(estados)
+	end
+
+	return api
+end
+
+return Arma
