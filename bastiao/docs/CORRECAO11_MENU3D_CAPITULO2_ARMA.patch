+		local veloz = humano and humano.WalkSpeed > 14
+		if andando then
+			balanco += dt * (if veloz then 13 else 8.5)
+		end
+		local amp = if andando then (if veloz then 1.6 else 1) else 0.25
+		local bx = math.sin(balanco) * 0.012 * amp
+		local by = -math.abs(math.cos(balanco)) * 0.016 * amp
+		-- recarga: a arma tomba de lado, o pente sai e volta
+		local tomba = 0
