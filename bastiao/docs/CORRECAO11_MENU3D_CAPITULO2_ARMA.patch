--- a/src/server/Capitulo02.luau
+++ b/src/server/Capitulo02.luau
@@ -0,0 +1,128 @@
+--!strict
+-- PROJETO BASTIÃO :: Capítulo 2 — O andar que não existe (parte 1: o fuzil).
+-- Conteúdo declarativo, no mesmo formato do Capítulo 1. juntar() devolve a campanha inteira:
+-- o fim da lista do terminal (s8_lista_fim) não encerra mais a etapa; continua aqui:
+--   armário abre -> pegar o fuzil -> Pavel explica -> porta da oficina abre -> o 731-A ataca
+--   -> tiros o deixam atordoado e ele foge (evento da criatura) -> porta blindada do anel leste
+--   -> Pavel: o elevador de serviço está sem energia -> fim da parte 1 (checkpoint fim_cap2a).
+-- Quem chegar à porta blindada sem afastar o monstro também segue (o tiro não é obrigatório).
+
+local Capitulo02 = {}
+
+local function obj(texto: string?)
+	return { tipo = "objetivo", texto = texto }
+end
+local function ent(id: string, estado: string)
+	return { tipo = "entidade", id = id, estado = estado }
+end
+local function seq(id: string)
+	return { tipo = "sequencia", id = id }
+end
+
+local function copia(v: any): any
+	if type(v) ~= "table" then
+		return v
+	end
+	local t = {}
+	for k, x in v do
+		t[k] = copia(x)
+	end
+	return t
+end
+
+Capitulo02.flags = { rifle_taken = false, monster_repelled = false }
+
+Capitulo02.nodes = {
+	-- os três toques e "eu conheço esse sinal": o Pavel abre o armário de serviço
+	cap2_armario = {
+		onEnter = { ent("armario_armas", "aberto"), ent("fuzis", "disponiveis"), obj("fuzil"), seq("c2_armario") },
+		exits = {
+			{ event = "pegar_fuzil", kind = "interacao", to = "cap2_armado", set = { rifle_taken = true }, effects = { obj(nil), seq("c2_instrucao") } },
+		},
+	},
+	cap2_armado = {
+		exits = {
+			{
+				event = "c2_instrucao_fim",
+				kind = "sequencia",
+				to = "cap2_saida",
+				effects = { ent("porta_oficina", "aberta"), ent("pavel2", "porta_blindada"), obj("porta_blindada"), seq("c2_porta") },
+			},
+		},
+	},
+	cap2_saida = {
+		exits = {
