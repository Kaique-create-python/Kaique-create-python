+		if peca.nome == "Corpo" then
+			corpo = parte
+		end
+		table.insert(partes, parte)
+	end
+	assert(corpo, "fuzil sem corpo")
+	for nome, pos in ArmaModelo.PONTOS do
+		local a = Instance.new("Attachment")
+		a.Name = nome
+		a.Position = (corpo :: BasePart).CFrame:PointToObjectSpace(pos * CM)
+		a.Parent = corpo
+	end
+	for _, parte in partes do
+		if parte ~= corpo then
+			if opcoes.ancorado then
+				parte.Anchored = true
+			else
+				local solda = Instance.new("WeldConstraint")
+				solda.Part0 = corpo
+				solda.Part1 = parte
+				solda.Parent = parte
+			end
+		end
+		parte.Parent = modelo
+	end
+	if opcoes.ancorado then
+		(corpo :: BasePart).Anchored = true
+	end
+	modelo.PrimaryPart = corpo
+	return modelo
+end
+
+return ArmaModelo
