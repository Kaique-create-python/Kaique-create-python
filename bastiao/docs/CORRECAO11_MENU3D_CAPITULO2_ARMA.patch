+-- âncora invisível para efeitos num ponto do mundo (some sozinha)
+local function ancora(pasta: Instance, cf: CFrame, vida: number): Attachment
+	local p = Instance.new("Part")
+	p.Name = "BastiaoEfeitoTiro"
+	p.Anchored = true
+	p.CanCollide = false
+	p.CanQuery = false
+	p.CanTouch = false
+	p.Transparency = 1
+	p.Size = Vector3.new(0.05, 0.05, 0.05)
+	p.CFrame = cf
+	p.Parent = pasta
+	local a = Instance.new("Attachment")
+	a.Parent = p
+	task.delay(vida, function()
+		p:Destroy()
+	end)
+	return a
+end
