+	descoberta.exits[1].effects = {}
+	-- o final da etapa passa a ser o fim da parte 1 do capítulo 2 (novo ponto de renascer)
+	local fim = def.nodes.fim_etapa
+	assert(fim and fim.final, "capítulo 1 sem fim_etapa")
+	fim.onEnter = { ent("fim", "visivel"), { tipo = "checkpoint", id = "fim_cap2a" } }
+	return def
+end
+
+return Capitulo02
