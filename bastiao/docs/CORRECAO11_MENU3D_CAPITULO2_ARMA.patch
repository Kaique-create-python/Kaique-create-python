+--!strict
+-- PROJETO BASTIÃO :: ArmaModelo — fuzil AK-74 (coronha fixa de madeira laminada, carregador de
+-- baquelite), montado peça por peça. Serve para o armário da oficina, para a arma na mão dos
+-- outros jogadores e para a arma em primeira pessoa (com antebraços de uniforme).
+-- Medidas reais em centímetros (943 mm de ponta a ponta), convertidas para studs.
+-- Eixos do modelo: cano para -Z, cima +Y, direita +X; origem no gatilho, eixo do cano em y = 0.
+-- Pontos de encaixe (Attachment no "Corpo"): Cano (boca), Ejecao (janela), Mao (punho),
+-- MaoFrente (guarda-mão) e Ombro (soleira).
+
+local ArmaModelo = {}
+
+local CM = 0.03 -- 1 cm em studs (o fuzil inteiro fica com 2,8 studs)
+ArmaModelo.CM = CM
+
+local METAL = Color3.fromRGB(44, 45, 48)
+local OXIDO = Color3.fromRGB(24, 24, 26)
+local ACO = Color3.fromRGB(104, 106, 110)
