diff -ruN a/tests/client_menu3d_test.luau b/tests/client_menu3d_test.luau
--- a/tests/client_menu3d_test.luau
+++ b/tests/client_menu3d_test.luau
@@ -0,0 +1,119 @@
+-- Menu 3D de verdade: a cópia do painel numa placa na frente da câmera, em perspectiva, que gira,
+-- encaixa exatamente sobre o painel real (projeção de volta na tela) e some deixando o painel real.
+local Harness = require("./client_harness")
+local roblox = require("@lune/roblox")
+local V2, V3, CF = roblox.Vector2, roblox.Vector3, roblox.CFrame
+local h = Harness.new()
+h.services.RunService.RenderStepped = h:signal()
+h.heartbeat.Wait = function() return 0 end
+h.services.RunService.BindToRenderStep = function() end
+h.services.RunService.UnbindFromRenderStep = function() end
+h.services.ReplicatedStorage = h:new("ReplicatedStorage", "ReplicatedStorage")
+h.services.Lighting = h:new("Lighting", "Lighting")
+h.services.GuiService.ReducedMotionEnabled = false
+h.environment.CFrame = CF
+h.environment.ColorSequence = roblox.ColorSequence
+h.environment.ColorSequenceKeypoint = roblox.ColorSequenceKeypoint
+h.environment.NumberSequence = roblox.NumberSequence
+h.environment.NumberSequenceKeypoint = roblox.NumberSequenceKeypoint
+
+-- câmera com perspectiva de verdade (viewport 1280x720, FOV vertical 70) olhando um pouco de lado
+local W, H, FOV = 1280, 720, 70
+local cam = h:new("Camera", "Camera", h.workspace)
+cam.CFrame = CF.lookAt(V3.new(10, 6, 20), V3.new(4, 5, 0))
+cam.FieldOfView = FOV
+cam.CameraType = roblox.Enum.CameraType.Custom
+cam.ViewportSize = V2.new(W, H)
+local function metodo(no, nome, fn) no._p[nome] = fn end
+local t = math.tan(math.rad(FOV) / 2)
+metodo(cam, "ViewportPointToRay", function(self, x, y)
+	local dx = (x - W / 2) / (H / 2) * t
+	local dy = -(y - H / 2) / (H / 2) * t
+	local d = self.CFrame:VectorToWorldSpace(V3.new(dx, dy, -1)).Unit
+	return { Origin = self.CFrame.Position, Direction = d }
+end)
+h.workspace.CurrentCamera = cam
+local function projetar(p)
+	local l = cam.CFrame:PointToObjectSpace(p)
+	return V2.new(W / 2 + (l.X / -l.Z) / t * (H / 2), H / 2 - (l.Y / -l.Z) / t * (H / 2))
+end
+
+-- menu do Sector7 falso: o painel tem um título e a tela de efeitos começa 36 px acima (barra do topo)
+local menu = h:new("ScreenGui", "S7BodycamMenu", h.playerGui)
+menu.Enabled = false
+local canvas = h:new("Frame", "Canvas", menu)
+local overlay = h:new("Frame", "MenuOverlay", canvas)
+local painel = h:new("Frame", "CameraMenu", overlay)
+painel.Visible = true
+painel.AbsolutePosition = V2.new(370, 180)
+painel.AbsoluteSize = V2.new(540, 360)
+local titulo = h:new("TextLabel", "Titulo", painel)
+titulo.Text = "CÂMERA"
+local copias = 0
+metodo(painel, "Clone", function()
+	copias += 1
+	local c = h:new("Frame", "CameraMenu")
+	c.Visible = false
+	h:new("TextLabel", "Titulo", c).Text = titulo.Text
+	h:new("LocalScript", "NaoRoda", c)
+	return c
+end)
+local Efeitos = h:load("src/client/Efeitos.luau")
+local fx = Efeitos.iniciar({ jogador = h.player, playerGui = h.playerGui, efeito = function() return nil end, ui = function() end })
+h:flush()
+h.playerGui:FindFirstChild("BastiaoMenuFX").AbsolutePosition = V2.new(0, -36)
+
+menu.Enabled = true; menu:GetPropertyChangedSignal("Enabled"):Fire()
+h:tick(0.01)
+local placa = cam:FindFirstChild("BastiaoMenu3D")
+assert(placa, "a placa 3D não foi criada na frente da câmera")
+assert(copias == 1, "o painel tinha que ser copiado uma vez")
+assert(painel.Visible == false, "o painel real fica escondido enquanto a placa gira")
+local tela = placa:FindFirstChild("Tela")
+assert(tela and tela.AlwaysOnTop and tela.LightInfluence == 0, "SurfaceGui tem que ficar por cima e sem sombra")
+assert(tela.CanvasSize == V2.new(540, 360), "tela da placa com tamanho errado: " .. tostring(tela.CanvasSize))
+local copia = tela:FindFirstChild("CameraMenu")
+assert(copia and copia.Visible and copia:FindFirstChild("Titulo") and not copia:FindFirstChild("NaoRoda"), "cópia do painel errada (ou com script)")
+-- começo: de lado (quase de perfil para a câmera)
+local frente0 = placa.CFrame.LookVector:Dot(-cam.CFrame.LookVector)
+assert(frente0 < 0.5, "a placa tinha que começar virada de lado (" .. frente0 .. ")")
+-- meio do giro
+h.now += 0.3; h.services.RunService.RenderStepped:Fire(1 / 60)
+assert(placa.Parent, "a placa sumiu cedo")
+-- encaixe: no último quadro antes de sumir ela está de frente e cobre o painel real
+local ultimo = nil
+local conexaoTeste = h.services.RunService.RenderStepped:Connect(function() if placa.Parent then ultimo = placa.CFrame end end)
+h.now += 0.3; h.services.RunService.RenderStepped:Fire(1 / 60)
+h.now += 0.05; h.services.RunService.RenderStepped:Fire(1 / 60)
+conexaoTeste:Disconnect()
+assert(placa.Parent == nil, "a placa não saiu no fim do giro")
+assert(painel.Visible == true, "o painel real não voltou no fim")
+-- a placa final, projetada de volta, cai em cima do painel (corrigido pela barra do topo de 36 px)
+local cf = ultimo
+assert(cf, "sem quadro final da placa")
+assert(cf.LookVector:Dot(-cam.CFrame.LookVector) > 0.999, "a placa não terminou de frente para a câmera")
+local tam = placa.Size
+local cantos = {
+	projetar((cf * CF.new(tam.X / 2, tam.Y / 2, 0)).Position), -- +X da placa = esquerda da câmera (frente virada)
+	projetar((cf * CF.new(-tam.X / 2, -tam.Y / 2, 0)).Position),
+}
+local minX, maxX = math.min(cantos[1].X, cantos[2].X), math.max(cantos[1].X, cantos[2].X)
+local minY, maxY = math.min(cantos[1].Y, cantos[2].Y), math.max(cantos[1].Y, cantos[2].Y)
+local alvo = { 370, 180 + 36, 370 + 540, 180 + 36 + 360 }
+for i, v in { minX, minY, maxX, maxY } do
+	assert(math.abs(v - alvo[i]) < 1.5, string.format("placa não encaixou no painel: canto %d em %.1f (esperado %.1f)", i, v, alvo[i]))
+end
+-- texto da placa lido do lado certo: a direita da tela fica no -X da placa
+local direitaTela = projetar((cf * CF.new(-tam.X / 2, 0, 0)).Position).X
+assert(math.abs(direitaTela - maxX) < 1, "SurfaceGui espelhado: o -X da placa tem que ficar à direita da tela")
+-- fechar logo depois de abrir não deixa placa nem painel escondido
+menu.Enabled = false; menu:GetPropertyChangedSignal("Enabled"):Fire()
+h:tick(0.01)
+menu.Enabled = true; menu:GetPropertyChangedSignal("Enabled"):Fire(); h:tick(0.01)
+assert(cam:FindFirstChild("BastiaoMenu3D"), "segunda abertura sem placa")
+menu.Enabled = false; menu:GetPropertyChangedSignal("Enabled"):Fire(); h:tick(0.01)
+h.now += 0.1; h.services.RunService.RenderStepped:Fire(1 / 60)
+assert(cam:FindFirstChild("BastiaoMenu3D") == nil, "fechar no meio deixou a placa")
+assert(painel.Visible == true, "fechar no meio deixou o painel escondido")
+fx.destroy()
+print("PASS menu 3D: placa em perspectiva na frente da câmera, gira de lado para frente, encaixa no painel (com a barra do topo), sem espelhar e sem sobrar nada")
