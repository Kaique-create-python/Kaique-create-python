+local function emissor(pai: Instance, props: { [string]: any }): ParticleEmitter
+	local e = Instance.new("ParticleEmitter")
+	e.Enabled = false
+	e.LockedToPart = false
+	for k, v in props do
+		(e :: any)[k] = v
+	end
+	e.Parent = pai
+	return e
+end
