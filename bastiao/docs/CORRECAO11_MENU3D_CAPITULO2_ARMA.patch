+}
+local T = Arma.TEXTURAS
+
+local AMBAR = Color3.fromRGB(244, 186, 88)
+local BRANCO = Color3.fromRGB(238, 238, 232)
+local MONO = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
