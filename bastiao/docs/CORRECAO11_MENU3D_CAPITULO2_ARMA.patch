+
+Cenario02.ARMARIO = CFrame.lookAt(V(81.5, 0, -298.9), V(81.5, 0, -299.9)) -- costas na parede norte (face em z -298)
+Cenario02.PORTA_BLINDADA = V(59, 3, -389) -- anel leste, na frente da porta blindada das utilidades
