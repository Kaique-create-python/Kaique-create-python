+
+type Peca = {
+	nome: string,
+	forma: string, -- "bloco", "cilindro" (eixo ao longo de Z) ou "cunha"
+	tam: Vector3, -- cm
+	centro: Vector3, -- cm
+	giro: Vector3?, -- graus (X, Y, Z)
+	cor: Color3,
+	material: Enum.Material,
+}
+
+local function P(nome: string, forma: string, tam: Vector3, centro: Vector3, cor: Color3, material: Enum.Material, giro: Vector3?): Peca
+	return { nome = nome, forma = forma, tam = tam, centro = centro, cor = cor, material = material, giro = giro }
+end
