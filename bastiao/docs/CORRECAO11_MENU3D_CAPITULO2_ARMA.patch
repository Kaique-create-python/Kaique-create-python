+local MADEIRA_ESCURA = Color3.fromRGB(78, 34, 20)
+local BAQUELITE = Color3.fromRGB(112, 46, 27)
+local UNIFORME = Color3.fromRGB(118, 112, 80)
+local LUVA = Color3.fromRGB(32, 31, 29)
