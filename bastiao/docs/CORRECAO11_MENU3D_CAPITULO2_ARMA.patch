+	MaoFrente = V3(0, -3.9, -25),
+	Ombro = V3(0, -5, 36.6),
+}
+
+local function cfDe(peca: Peca): CFrame
+	local g = peca.giro or V3(0, 0, 0)
+	return CFrame.new(peca.centro * CM) * CFrame.Angles(math.rad(g.X), math.rad(g.Y), math.rad(g.Z))
+end
+
+local function criarParte(peca: Peca): BasePart
+	local parte: BasePart
+	if peca.forma == "cunha" then
+		parte = Instance.new("WedgePart")
+		parte.Size = peca.tam * CM
+		parte.CFrame = cfDe(peca)
+	elseif peca.forma == "cilindro" then
+		local cil = Instance.new("Part")
+		cil.Shape = Enum.PartType.Cylinder
+		-- o cilindro do Roblox tem o eixo em X: gira para o eixo ficar em Z
+		cil.Size = V3(peca.tam.Z, peca.tam.X, peca.tam.Y) * CM
+		cil.CFrame = cfDe(peca) * CFrame.Angles(0, math.rad(90), 0)
+		parte = cil
+	else
+		parte = Instance.new("Part")
+		parte.Size = peca.tam * CM
+		parte.CFrame = cfDe(peca)
+	end
+	parte.Name = peca.nome
+	parte.Color = peca.cor
+	parte.Material = peca.material
+	parte.TopSurface = Enum.SurfaceType.Smooth
+	parte.BottomSurface = Enum.SurfaceType.Smooth
+	parte.CanCollide = false
+	parte.CanTouch = false
+	parte.CanQuery = false
+	parte.Massless = true
+	parte.Anchored = false
+	parte.CastShadow = false
+	return parte
+end
+
+-- Antebraços com manga do uniforme e luvas (só para a primeira pessoa)
