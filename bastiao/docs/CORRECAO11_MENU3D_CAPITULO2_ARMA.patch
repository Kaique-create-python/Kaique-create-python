+
+-- campanha completa: capítulo 1 + parte 1 do capítulo 2 (o capítulo 1 não é alterado no disco)
+function Capitulo02.juntar(cap1: any): any
+	local def = copia(cap1)
+	def.id = "bastiao_cap01_cap02a"
+	def.version = 2
+	for k, v in Capitulo02.flags do
+		def.flagSchema[k] = v
+	end
+	for id, no in Capitulo02.nodes do
+		assert(def.nodes[id] == nil, "nó repetido no capítulo 2: " .. id)
+		def.nodes[id] = copia(no)
+	end
+	for id, s in Capitulo02.sequences do
+		assert(def.sequences[id] == nil, "sequência repetida no capítulo 2: " .. id)
+		def.sequences[id] = copia(s)
+	end
+	-- a lista do terminal agora leva ao capítulo 2
+	local descoberta = def.nodes.descoberta
+	assert(descoberta and descoberta.exits and descoberta.exits[1] and descoberta.exits[1].event == "s8_lista_fim", "capítulo 1 mudou: s8_lista_fim")
