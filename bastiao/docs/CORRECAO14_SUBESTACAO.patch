--- z13/src/server/Cenario03.luau	1970-01-01 00:00:00.000000000 +0000
+++ z14/src/server/Cenario03.luau	2026-11-18 14:41:56.164971904 +0000
@@ -0,0 +1,507 @@
+--!strict
+-- PROJETO BASTIÃO :: Cenario03 — capítulo 2, parte 2: a subestação.
+-- O mapa do Sector7 termina na parede leste da sala de utilidades (x 112). Aqui:
+--   * a parede leste ganha uma porta de manutenção (a parede original fica invisível e sem colisão,
+--     e é refeita em volta da abertura com o mesmo material; nada é apagado);
+--   * corredor curto, rampa de serviço descendo 24 studs e o salão da subestação (54 x 56 x 18):
+--     três transformadores, bandejas de cabo, armários de disjuntores, o painel principal com a
+--     alavanca e três caixas de fusíveis; luz vermelha de emergência até a energia voltar;
+--   * entidades porta_manutencao, fusiveis_sub, subestacao, monstro_isca e pavel3;
+--   * interações pegar_fusivel_1..3, colocar_fusiveis (avisa a história "fusiveis_ok") e
+--     religar_disjuntor; zona "subestacao" e os pontos de renascer "subestacao" e "fim_cap2".
+
+local Cenario03 = {}
+
+local V = Vector3.new
+Cenario03.PORTA = V(112.4, 0, -400)
+Cenario03.ZONA_SUB = V(180, -20.5, -400)
+Cenario03.SPAWN_SUB = CFrame.lookAt(V(178, -20.3, -400), V(192, -20.3, -400))
+Cenario03.SPAWN_FIM = CFrame.lookAt(V(58.5, 3.2, -378), V(58.5, 3.2, -392))
+Cenario03.ISCA = V(60, 0, -392) -- onde o barulho da subestação atrai o 731-A (na frente do elevador)
+local PISO = -23.5 -- topo do piso do salão
+local X0, X1, Z0, Z1 = 172, 226, -428, -372 -- salão
+local TETO = -5.5
+
+local CONCRETO = Color3.fromRGB(92, 93, 88)
+local CONCRETO_ESCURO = Color3.fromRGB(58, 58, 55)
+local METAL = Color3.fromRGB(70, 76, 72)
+local METAL_ESCURO = Color3.fromRGB(40, 43, 42)
+local AMARELO = Color3.fromRGB(214, 168, 32)
+local VERMELHO = Color3.fromRGB(170, 28, 22)
+
+export type Opcoes = {
+	pasta: Instance,
+	mundo: any,
+	cena: any,
+	reportar: (nome: string) -> (),
+	atrair: ((pos: Vector3) -> ())?,
+	aviso: ((jogador: Player, chave: string) -> ())?,
+	ruido: ((chave: string, pos: Vector3) -> ())?,
+	tween: ((inst: Instance, tempo: number, alvo: { [string]: any }) -> ())?,
+	log: ((string) -> ())?,
+}
+
+local function peca(pai: Instance, nome: string, tam: Vector3, cf: CFrame, cor: Color3, material: Enum.Material?, colide: boolean?): Part
+	local p = Instance.new("Part")
+	p.Name = nome
+	p.Anchored = true
+	p.CanCollide = colide ~= false
+	p.CanTouch = false
+	p.Size = tam
+	p.CFrame = cf
+	p.Color = cor
+	p.Material = material or Enum.Material.Concrete
+	p.TopSurface = Enum.SurfaceType.Smooth
+	p.BottomSurface = Enum.SurfaceType.Smooth
+	p.Parent = pai
+	return p
+end
+
+local function cilindro(pai: Instance, nome: string, diametro: number, comprimento: number, cf: CFrame, cor: Color3, material: Enum.Material?): Part
+	local p = peca(pai, nome, V(comprimento, diametro, diametro), cf, cor, material or Enum.Material.Metal, false)
+	p.Shape = Enum.PartType.Cylinder
+	return p
+end
+
+local function placa(p: BasePart, face: Enum.NormalId, linhas: { { string } }, fundo: Color3)
+	local g = Instance.new("SurfaceGui")
+	g.Face = face
+	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
+	g.PixelsPerStud = 60
+	g.LightInfluence = 1
+	local f = Instance.new("Frame")
+	f.Size = UDim2.fromScale(1, 1)
+	f.BackgroundColor3 = fundo
+	f.BorderSizePixel = 0
+	f.Parent = g
+	local lista = Instance.new("UIListLayout")
+	lista.VerticalAlignment = Enum.VerticalAlignment.Center
+	lista.HorizontalAlignment = Enum.HorizontalAlignment.Center
+	lista.Parent = f
+	for i, l in linhas do
+		local t = Instance.new("TextLabel")
+		t.BackgroundTransparency = 1
+		t.Size = UDim2.fromScale(1, tonumber(l[3]) or 0.4)
+		t.Font = Enum.Font.GothamBlack
+		t.TextScaled = true
+		t.Text = l[1]
+		t.TextColor3 = if l[2] == "vermelho" then VERMELHO else Color3.fromRGB(20, 20, 20)
+		t.LayoutOrder = i
+		t.Parent = f
+	end
+	g.Parent = p
+end
+
+local function promptEm(pai: BasePart, nome: string): ProximityPrompt
+	local p = Instance.new("ProximityPrompt")
+	p.Name = nome
+	p.ActionText = nome
+	p.ObjectText = ""
+	p.Style = Enum.ProximityPromptStyle.Custom
+	p.MaxActivationDistance = 7
+	p.HoldDuration = 0.4
+	p.RequiresLineOfSight = false
+	p.Enabled = false
+	p.KeyboardKeyCode = Enum.KeyCode.E
+	p.GamepadKeyCode = Enum.KeyCode.ButtonX
+	p:SetAttribute("Bastiao", true)
+	p.Parent = pai
+	return p
+end
+
+local function luz(pai: BasePart, cor: Color3, brilho: number, alcance: number, sombra: boolean?): PointLight
+	local l = Instance.new("PointLight")
+	l.Color = cor
+	l.Brightness = brilho
+	l.Range = alcance
+	l.Shadows = sombra == true
+	l.Parent = pai
+	return l
+end
+
+-- a parede leste das utilidades vira parede com porta (a original fica escondida, nunca apagada)
+local function abrirParede(pasta: Instance, log: (string) -> ()): boolean
+	local s7 = workspace:FindFirstChild("Sector7World")
+	local estrutura = s7 and s7:FindFirstChild("Structure")
+	local parede: BasePart? = nil
+	if estrutura then
+		for _, p in estrutura:GetChildren() do
+			if p:IsA("BasePart") and p.Name == "UtilitiesOuterWall" then
+				local c = p.CFrame.Position
+				if math.abs(c.X - 112.4) < 1.5 and math.abs(c.Z + 400) < 3 then
+					parede = p
+				end
+			end
+		end
+	end
+	if not parede then
+		log("[Bastiao] subestação: parede leste das utilidades não encontrada; a porta fica só de enfeite")
+		return false
+	end
+	local p = parede :: BasePart
+	local c, t = p.CFrame.Position, p.Size
+	local baixo, alto = c.Y - t.Y / 2, c.Y + t.Y / 2
+	local zn, zs = c.Z - t.Z / 2, c.Z + t.Z / 2
+	p.Transparency = 1
+	p.CanCollide = false
+	p.CanQuery = false
+	p.CastShadow = false
+	p:SetAttribute("BastiaoEscondidaPelaSubestacao", true)
+	local function pedaco(nome: string, z0: number, z1: number, y0: number, y1: number)
+		local q = peca(pasta, nome, V(t.X, y1 - y0, z1 - z0), CFrame.new(c.X, (y0 + y1) / 2, (z0 + z1) / 2), p.Color, p.Material)
+		q.Transparency = 0
+	end
+	pedaco("BastiaoParedeLesteNorte", zn, -403, baixo, alto)
+	pedaco("BastiaoParedeLesteSul", -397, zs, baixo, alto)
+	pedaco("BastiaoParedeLesteVerga", -403, -397, 8.6, alto)
+	return true
+end
+
+function Cenario03.construir(op: Opcoes): any
+	local log = op.log or print
+	local pasta = Instance.new("Model")
+	pasta.Name = "BastiaoSubestacao"
+	pasta.Parent = op.pasta
+	abrirParede(pasta, log)
+
+	-- ===== porta de manutenção (persiana de aço que sobe) =====
+	local porta = peca(pasta, "BastiaoPortaManutencao", V(0.4, 8.2, 6.2), CFrame.new(113.1, 4.6, -400), METAL, Enum.Material.DiamondPlate)
+	local faixa = peca(pasta, "BastiaoFaixaPorta", V(0.42, 0.6, 6.2), CFrame.new(113.1, 1.0, -400), AMARELO, Enum.Material.SmoothPlastic, false)
+	local placaPorta = peca(pasta, "BastiaoPlacaSubestacao", V(0.1, 1.2, 4.4), CFrame.new(112.85, 9.2, -400) * CFrame.Angles(0, math.rad(180), 0), AMARELO, Enum.Material.SmoothPlastic, false)
+	placa(placaPorta, Enum.NormalId.Front, { { "ПОДСТАНЦИЯ 7-Б", "", 0.55 }, { "↓  −2", "vermelho", 0.4 } }, AMARELO)
+	local portaY = { fechada = 4.6, aberta = 12.4 }
+
+	-- ===== corredor e rampa de serviço =====
+	peca(pasta, "BastiaoCorredorPiso", V(11.2, 1, 8), CFrame.new(118.4, 0, -400), CONCRETO_ESCURO)
+	peca(pasta, "BastiaoCorredorTeto", V(11.2, 1, 8), CFrame.new(118.4, 9.6, -400), CONCRETO_ESCURO)
+	for _, z in { -404.5, -395.5 } do
+		peca(pasta, "BastiaoCorredorParede", V(11.2, 9.6, 1), CFrame.new(118.4, 4.8, z), CONCRETO)
+	end
+	local ang = -math.atan2(24, 48)
+	local normal = V(-math.sin(ang), math.cos(ang), 0)
+	local meio = V(148, -11.5, -400) - normal * 0.5
+	local giro = CFrame.Angles(0, 0, ang)
+	local comp = math.sqrt(48 * 48 + 24 * 24)
+	peca(pasta, "BastiaoRampa", V(comp, 1, 8), CFrame.new(meio) * giro, CONCRETO_ESCURO)
+	peca(pasta, "BastiaoRampaTeto", V(comp, 1, 8), CFrame.new(meio + V(0, 10.4, 0)) * giro, CONCRETO_ESCURO)
+	for _, z in { -404.5, -395.5 } do
+		peca(pasta, "BastiaoRampaParede", V(48.4, 35, 1), CFrame.new(148, -6.5, z), CONCRETO)
+	end
+	-- faixas antiderrapantes, corrimão e lâmpadas de serviço
+	for i = 1, 7 do
+		local k = (i - 0.5) / 7
+		local pt = V(124 + 48 * k, 0.5 - 24 * k, -400) + normal * 0.03
+		peca(pasta, "BastiaoFaixaRampa", V(0.5, 0.06, 7.6), CFrame.new(pt) * giro, AMARELO, Enum.Material.SmoothPlastic, false)
+	end
+	local corr0, corr1 = V(124, 3.6, -403.6), V(172, -20.4, -403.6)
+	cilindro(pasta, "BastiaoCorrimao", 0.25, (corr1 - corr0).Magnitude, CFrame.lookAt((corr0 + corr1) / 2, corr1) * CFrame.Angles(0, math.rad(90), 0), METAL_ESCURO)
+	for i = 0, 3 do
+		local x = 128 + i * 13
+		local y = 0.5 - 24 * ((x - 124) / 48) + 6.5
+		local l = peca(pasta, "BastiaoLampadaRampa", V(0.6, 0.6, 0.3), CFrame.new(x, y, -395.2), Color3.fromRGB(255, 160, 70), Enum.Material.Neon, false)
+		luz(l, Color3.fromRGB(255, 150, 70), 0.9, 16)
+	end
+
+	-- ===== salão =====
+	local cx, cz = (X0 + X1) / 2, (Z0 + Z1) / 2
+	local largX, largZ = X1 - X0, Z1 - Z0
+	local altura = TETO - PISO
+	local yMeio = (PISO + TETO) / 2
+	peca(pasta, "BastiaoSubPiso", V(largX, 1, largZ), CFrame.new(cx, PISO - 0.5, cz), CONCRETO_ESCURO)
+	peca(pasta, "BastiaoSubTeto", V(largX, 1, largZ), CFrame.new(cx, TETO + 0.5, cz), CONCRETO_ESCURO)
+	peca(pasta, "BastiaoSubParedeLeste", V(1, altura + 1, largZ), CFrame.new(X1 + 0.5, yMeio, cz), CONCRETO)
+	peca(pasta, "BastiaoSubParedeNorte", V(largX + 2, altura + 1, 1), CFrame.new(cx, yMeio, Z0 - 0.5), CONCRETO)
+	peca(pasta, "BastiaoSubParedeSul", V(largX + 2, altura + 1, 1), CFrame.new(cx, yMeio, Z1 + 0.5), CONCRETO)
+	peca(pasta, "BastiaoSubParedeOesteN", V(1, altura + 1, -404 - Z0), CFrame.new(X0 - 0.5, yMeio, (Z0 - 404) / 2), CONCRETO)
+	peca(pasta, "BastiaoSubParedeOesteS", V(1, altura + 1, Z1 + 396), CFrame.new(X0 - 0.5, yMeio, (Z1 - 396) / 2), CONCRETO)
+	peca(pasta, "BastiaoSubParedeOesteVerga", V(1, TETO - (PISO + 9), 8), CFrame.new(X0 - 0.5, (TETO + PISO + 9) / 2, -400), CONCRETO)
+	-- rodapé listrado e pilares
+	for _, z in { Z0 + 0.05, Z1 - 0.05 } do
+		peca(pasta, "BastiaoSubRodape", V(largX, 0.8, 0.1), CFrame.new(cx, PISO + 0.4, z), AMARELO, Enum.Material.SmoothPlastic, false)
+	end
+	for _, x in { 190, 210 } do
+		for _, z in { -414, -386 } do
+			peca(pasta, "BastiaoSubPilar", V(2, altura, 2), CFrame.new(x, yMeio, z), CONCRETO)
+			peca(pasta, "BastiaoSubPilarFaixa", V(2.1, 1.2, 2.1), CFrame.new(x, PISO + 1.6, z), AMARELO, Enum.Material.SmoothPlastic, false)
+		end
+	end
+	-- três transformadores na parede norte, com aletas, isoladores e placa de perigo
