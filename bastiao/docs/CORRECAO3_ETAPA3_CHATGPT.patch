+class FontesPropriasTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.state = Path(temporary.name) / "state"
+        self.original = (ROOT / "tests/fixture_place.rbxl").read_bytes()
+        self.api = PlaceAPI(self.original)
+
+    def runtime(self, pacote, digest):
+        return Runtime(self.state, 3, digest, pacote.patch, lambda version, verify: ["teste"])
+
+    def quiet(self, fn, *args):
+        with contextlib.redirect_stdout(io.StringIO()):
+            return fn(*args)
+
+    def test_saved_reprovado_nao_trava_o_proximo_pacote(self):
+        antigo = Aceitar(rows("A"))
+        self.api.pass_task = False
+        with self.assertRaises(Failure):
+            self.quiet(self.runtime(antigo, "a" * 64).test, self.api)
+        self.assertEqual(self.api.latest, 2)  # Saved do pacote antigo ficou como última versão
+        novo = Aceitar(rows("B"))
+        rt = self.runtime(novo, "b" * 64)
+        # sem reconhecer as próprias fontes: bloqueia (comportamento antigo)
+        with self.assertRaises(Failure) as erro:
+            self.quiet(rt.test, self.api)
+        self.assertIn("fonte desconhecida", str(erro.exception))
+        # reconhecendo: passa, cria um Saved novo e publica só com a confirmação escrita
+        self.assertGreater(novo.aceitar_proprias(rt.fontes_proprias()), 0)
+        self.api.pass_task = True
+        prova = self.quiet(rt.test, self.api)
+        self.assertEqual(prova["base"], 3)
+        with mock.patch("builtins.input", return_value="PUBLICAR ETAPA3"):
+            self.quiet(rt.publish, self.api)
+        publicado = self.api.versions[self.api.latest]
+        self.assertTrue(publicado["published"])
+        doc = Binary(publicado["raw"])
+        fontes = {doc.value(ref, "Source").decode() for ref, obj in doc.objects.items()
+                  if obj["class"] in ("Script", "LocalScript", "ModuleScript")}
+        self.assertIn("-- criatura B\nreturn {}\n", fontes)
+        self.assertNotIn("-- criatura A\nreturn {}\n", fontes)
+
+    def test_script_mexido_por_outra_pessoa_continua_bloqueado(self):
+        antigo = Aceitar(rows("A"))
+        self.api.pass_task = False
+        with self.assertRaises(Failure):
+            self.quiet(self.runtime(antigo, "a" * 64).test, self.api)
+        # alguém mexe no CriaturaCore pelo Studio: nova versão com fonte estranha
+        mexido = Aceitar(rows("A"))
+        for row in mexido.entries:
+            if row["path"][-1] == "CriaturaCore":
+                row["source"] = "-- editado por outra pessoa\nreturn {}\n"
+                row["known"] = [__import__("hashlib").sha256(b"-- criatura A\nreturn {}\n").hexdigest()]
+        raw, _ = patch_place(self.api.versions[2]["raw"], mexido.entries)
+        self.api.latest = 3
+        self.api.versions[3] = {"raw": raw, "published": False}
+        novo = Aceitar(rows("B"))
+        rt = self.runtime(novo, "b" * 64)
+        novo.aceitar_proprias(rt.fontes_proprias())
+        self.api.pass_task = True
+        with self.assertRaises(Failure) as erro:
+            self.quiet(rt.test, self.api)
+        self.assertIn("fonte desconhecida", str(erro.exception))
+        self.assertIn("CriaturaCore", str(erro.exception))
+
+    def test_fontes_bastiao_le_so_scripts_do_bastiao(self):
+        raw, _ = patch_place(self.original, rows("A"))
+        achadas = fontes_bastiao(raw)
+        import hashlib
+        self.assertIn(hashlib.sha256(b"-- criatura A\nreturn {}\n").hexdigest(), achadas)
+        doc = Binary(self.original)
+        for ref, obj in doc.objects.items():
+            if obj["class"] in ("Script", "LocalScript", "ModuleScript"):
+                fonte = doc.value(ref, "Source").decode()
+                self.assertNotIn(hashlib.sha256(fonte.encode()).hexdigest(), achadas, "script Sector7 entrou na lista")
+
+
+if __name__ == "__main__":
+    unittest.main()
