+class RecusaElevenLabsTests(AudioProductionTests):
+    """Recusa clara do ElevenLabs: motivo visível, nada incerto, instalação segue com o que existe."""
+    def recusa(self, caminho, status, detalhe):
+        base = self.api()
+        def transporte(method, url, headers, body):
+            path = url.split("api.elevenlabs.io", 1)[-1]
+            if path.startswith(caminho) and (method == "POST" or caminho == "/v1/voices"):
+                base.calls.append((method, path, None))
+                return audio.HTTPResponse(status, {"content-type": "application/json"},
+                                          json.dumps({"detail": detalhe}).encode())
+            return base(method, url, headers, body)
+        transporte.calls = base.calls
+        return transporte
+
+    def test_401_na_lista_de_vozes_mostra_o_motivo_sem_a_chave(self):
+        api = self.recusa("/v1/voices", 401, {"status": "detected_unusual_activity", "message": "Free Tier usage disabled for secret-token-must-never-be-written"})
+        with self.assertRaises(audio.AudioProductionError) as caught:
+            audio.prepare(self.plan_path, "secret-token-must-never-be-written", transport=api)
+        texto = str(caught.exception)
+        self.assertIn("detected_unusual_activity", texto)
+        self.assertIn("plano pago", texto)
+        self.assertNotIn("secret-token", texto)
+        self.assertFalse((self.root / "receipts" / "line1.json").exists())
+
+    def test_post_recusado_nao_fica_incerto_e_pode_tentar_de_novo(self):
+        api = self.recusa("/v1/text-to-speech", 401, {"status": "missing_permissions", "message": "The API key you used is missing the permission text_to_speech"})
+        with self.assertRaises(audio.AudioProductionError) as caught:
+            audio.prepare(self.plan_path, "test-key", transport=api)
+        self.assertIn("nada foi gerado nem cobrado", str(caught.exception))
+        self.assertIn("permissões", str(caught.exception))
+        self.assertEqual(audio.inspect_plan(self.plan_path)["clips"]["line1"]["status"], "missing")
+        manifest = audio.prepare(self.plan_path, "test-key", transport=self.api())
+        self.assertIn("line1", manifest["segments"])
+
+    def test_monta_so_com_o_que_existe_quando_permitido(self):
+        fonte = self.root / "pronto.mp3"
+        fonte.write_bytes(self.mp3)
+        self.plan["clips"].append({"key": "pronto", "kind": "reuse", "sourcePath": "pronto.mp3",
+                                   "sha256": hashlib.sha256(self.mp3).hexdigest(), "profile": "foley",
+                                   "category": "Foley", "volume": 0.5})
+        self.write_plan()
+        with self.assertRaises(audio.AudioProductionError):
+            audio.build_atlases(self.plan_path)
+        manifest = audio.build_atlases(self.plan_path, allow_missing=True)
+        self.assertEqual(set(manifest["segments"]), {"pronto"})
+        self.assertTrue(manifest["production"]["partial"])
+        self.assertEqual(manifest["production"]["missing"], ["line1"])
+
