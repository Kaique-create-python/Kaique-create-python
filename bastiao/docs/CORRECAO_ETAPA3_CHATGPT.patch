+def _motivo(response, secret=""):
+    """Motivo curto que o ElevenLabs deu para a recusa (ex.: missing_permissions,
+    detected_unusual_activity, quota_exceeded). Nunca devolve a chave."""
+    try:
+        data = json.loads(response.body.decode("utf-8", "replace"))
+    except (ValueError, AttributeError):
+        return ""
+    detail = data.get("detail") if isinstance(data, dict) else None
+    if isinstance(detail, dict):
+        texto = " - ".join(str(detail.get(k)) for k in ("status", "message") if detail.get(k))
+    elif isinstance(detail, str):
+        texto = detail
+    else:
+        texto = ""
+    texto = re.sub(r"\s+", " ", texto)[:240]
+    if secret:
+        texto = texto.replace(secret, "[OCULTA]")
+    return texto
+
+
+def _dica(status, motivo):
+    m = motivo.lower()
+    if "unusual" in m or "free tier" in m or "free_tier" in m:
+        return " A conta gratuita do ElevenLabs foi bloqueada por 'atividade incomum'; só volta a gerar com plano pago (elevenlabs.io/pricing)."
+    if "permission" in m:
+        return " A chave não tem todas as permissões: crie uma chave nova no ElevenLabs (Developers > API Keys) com acesso total ou marcando Text to Speech, Sound Effects, Voices, Models e User."
+    if "quota" in m or "credit" in m or status == 402:
+        return " Acabaram os créditos da conta ElevenLabs deste mês."
+    if status == 401:
+        return " Chave errada, apagada ou sem permissão: copie de novo a chave inteira em ElevenLabs > Developers > API Keys."
+    if status == 429:
+        return " Muitos pedidos ao mesmo tempo (fila gratuita cheia); tente mais tarde."
+    return ""
+
