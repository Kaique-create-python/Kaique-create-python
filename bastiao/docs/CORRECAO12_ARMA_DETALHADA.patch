+-- ===== recargas em quadros-chave =====
+-- arma: deslocamento (studs) e giro (graus) em volta da mão direita; pente: em volta da trava dianteira (cm);
+-- mão esquerda: em volta do ponto onde ela segura o guarda-mão (cm). "segura": janelas em que a mão leva o pente.
+local function suave(a: number): number
+	return a * a * (3 - 2 * a)
+end
+local function preparar(chaves: { { number } }, esc: number): { any }
+	local l = {}
+	for _, k in chaves do
+		table.insert(l, { k[1], CFrame.new((k[2] or 0) * esc, (k[3] or 0) * esc, (k[4] or 0) * esc)
+			* CFrame.Angles(math.rad(k[5] or 0), math.rad(k[6] or 0), math.rad(k[7] or 0)) })
+	end
+	return l
+end
+local function amostra(l: { any }, t: number): CFrame
+	if t <= l[1][1] then
+		return l[1][2]
+	end
+	for i = 1, #l - 1 do
+		local a, b = l[i], l[i + 1]
+		if t < b[1] then
+			return a[2]:Lerp(b[2], suave((t - a[1]) / (b[1] - a[1])))
+		end
+	end
+	return l[#l][2]
+end
+local function amostraN(l: { { number } }, t: number): number
+	if t <= l[1][1] then
+		return l[1][2]
+	end
+	for i = 1, #l - 1 do
+		local a, b = l[i], l[i + 1]
+		if t < b[1] then
+			return a[2] + (b[2] - a[2]) * suave((t - a[1]) / (b[1] - a[1]))
+		end
+	end
+	return l[#l][2]
+end
