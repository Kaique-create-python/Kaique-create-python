+--!strict
+-- PROJETO BASTIÃO :: Maleta (cliente) — inventário no estilo da maleta do RE4: uma grade dentro de
+-- uma maleta de couro, com cada item desenhado de verdade (ViewportFrame com o próprio modelo do
+-- jogo: o AK-74, os fusíveis da subestação e o cartão do arsenal). Escolhe arma na mão ou mãos
+-- vazias (EQUIPAR / GUARDAR). Abre no I (ou TAB, se a lista de jogadores estiver desligada), no botão da troca rápida e no ↓ do
+-- controle; fecha no X, no ESC/B ou no mesmo botão.
+-- Itens-chave são do grupo (atributos do workspace que o servidor publica): BastiaoItemFusiveis
+-- (quantos fusíveis estão com o grupo) e BastiaoItemCartao. Munição e fuzil vêm do próprio jogador.
+-- Não pausa o jogo (é cooperativo): enquanto aberta, o tiro fica travado e a mira some.
+
+local Players = game:GetService("Players")
+local UserInputService = game:GetService("UserInputService")
+local TweenService = game:GetService("TweenService")
+local GuiService = game:GetService("GuiService")
+
+local Maleta = {}
+
+local COLS, LINHAS, CEL = 10, 6, 34
+local MONO = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Bold)
+local MONO_N = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Medium)
+local AMBAR = Color3.fromRGB(244, 186, 88)
+local BRANCO = Color3.fromRGB(238, 238, 232)
+local DIM = Color3.fromRGB(150, 146, 136)
+local COURO = Color3.fromRGB(34, 28, 22)
+local LATAO = Color3.fromRGB(122, 98, 60)
+local FUNDO_GRADE = Color3.fromRGB(19, 17, 14)
+local LINHA_GRADE = Color3.fromRGB(58, 50, 38)
+
+-- Itens: tamanho na grade (colunas x linhas), lugar fixo e textos (PT/EN/RU pelo idioma do jogo).
+Maleta.TEXTOS = {
+	pt = {
+		titulo = "MALETA", naMao = "NA MÃO", nada = "NADA", equipar = "EQUIPAR", guardar = "GUARDAR",
+		chave = "Item-chave do grupo.", vazio = "Escolha um item.",
+		fuzil = { "AK-74", "Fuzil 5,45x39 mm. Pente de 30. Tecla 1 saca, 2 guarda." },
+		municao = { "MUNIÇÃO 5,45", "Balas de reserva para o AK-74." },
+		fusivel = { "FUSÍVEL", "Fusível cerâmico da subestação. O painel precisa de três." },
+		cartao = { "CARTÃO DO ARSENAL", "Cartão de acesso da Guarnição 7. Abre a porta do arsenal." },
+	},
+	en = {
+		titulo = "CASE", naMao = "IN HAND", nada = "NOTHING", equipar = "EQUIP", guardar = "HOLSTER",
+		chave = "Team key item.", vazio = "Pick an item.",
+		fuzil = { "AK-74", "5.45x39 mm rifle. 30-round magazine. Key 1 draws, 2 holsters." },
+		municao = { "5.45 AMMO", "Reserve rounds for the AK-74." },
+		fusivel = { "FUSE", "Ceramic substation fuse. The panel needs three." },
+		cartao = { "ARMORY CARD", "Garrison 7 access card. Opens the armory door." },
+	},
+	ru = {
+		titulo = "КЕЙС", naMao = "В РУКАХ", nada = "НИЧЕГО", equipar = "ВЗЯТЬ", guardar = "УБРАТЬ",
+		chave = "Ключевой предмет группы.", vazio = "Выберите предмет.",
+		fuzil = { "АК-74", "Автомат 5,45x39 мм. Магазин на 30. Клавиша 1 — взять, 2 — убрать." },
+		municao = { "ПАТРОНЫ 5,45", "Запасные патроны для АК-74." },
+		fusivel = { "ПРЕДОХРАНИТЕЛЬ", "Керамический предохранитель подстанции. Щиту нужно три." },
+		cartao = { "КАРТА АРСЕНАЛА", "Карта доступа Гарнизона 7. Открывает арсенал." },
+	},
+}
+
+export type Opcoes = {
+	jogador: Player,
+	playerGui: Instance,
+	compartilhado: Instance,
+	modelo: any, -- ArmaModelo (para desenhar o fuzil)
+	icones: { [string]: string }?,
+	idioma: (() -> string)?,
+	som: ((chave: string) -> Sound?)?,
+	empunhar: ((naMao: boolean) -> ())?,
+}
+
+local function novo(classe: string, props: { [string]: any }, pai: Instance?): any
+	local i = Instance.new(classe)
+	for k, v in props do
+		(i :: any)[k] = v
+	end
+	if pai then
+		i.Parent = pai
+	end
+	return i
+end
+
+local function canto(pai: Instance, r: number)
+	novo("UICorner", { CornerRadius = UDim.new(0, r) }, pai)
+end
+
+-- modelos pequenos dos itens-chave (iguais aos do mapa: Cenario03 e Cenario04)
+local function modeloFusivel(): Model
+	local m = Instance.new("Model")
+	local corpo = novo("Part", { Name = "Corpo", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.0, 0.45, 0.45),
+		Color = Color3.fromRGB(232, 228, 214), Material = Enum.Material.SmoothPlastic, Anchored = true }, m)
+	for _, x in { -0.47, 0.47 } do
+		novo("Part", { Name = "Ponta", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.1, 0.48, 0.48),
+			Color = Color3.fromRGB(150, 150, 154), Material = Enum.Material.Metal, Anchored = true,
+			CFrame = CFrame.new(x, 0, 0) }, m)
+	end
+	m.PrimaryPart = corpo
+	return m
+end
+local function modeloCartao(): Model
+	local m = Instance.new("Model")
+	local c = novo("Part", { Name = "Cartao", Size = Vector3.new(0.7, 0.06, 0.45), Color = Color3.fromRGB(200, 196, 170),
+		Material = Enum.Material.SmoothPlastic, Anchored = true }, m)
+	novo("Part", { Name = "Listra", Size = Vector3.new(0.7, 0.07, 0.1), Color = Color3.fromRGB(170, 30, 24),
+		Material = Enum.Material.SmoothPlastic, Anchored = true, CFrame = CFrame.new(0, 0, -0.12) }, m)
+	m.PrimaryPart = c
+	return m
+end
+
+-- desenha um modelo do jogo dentro da célula (câmera calculada para caber, luz de cima)
+local function vitrine(pai: GuiObject, modelo: Model, giro: CFrame, aspecto: number)
+	local vp = novo("ViewportFrame", {
+		Name = "Vitrine", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
+		Ambient = Color3.fromRGB(150, 146, 140), LightColor = Color3.fromRGB(255, 236, 210),
+		LightDirection = Vector3.new(-0.4, -1, -0.5),
+	}, pai)
+	local cam = novo("Camera", { FieldOfView = 24 }, vp)
+	vp.CurrentCamera = cam
+	modelo:PivotTo(giro)
+	for _, p in modelo:GetDescendants() do
+		if p:IsA("BasePart") then
+			p.Anchored = true
+		end
+	end
+	modelo.Parent = vp
+	local cf, tam = modelo:GetBoundingBox()
+	local tv = math.tan(math.rad(cam.FieldOfView / 2))
+	local th = tv * aspecto
+	-- cabe na largura e na altura, com folga
+	local d = math.max((tam.X / 2) / th, (tam.Y / 2) / tv) * 1.18 + tam.Z / 2
+	cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, 0, d), cf.Position)
+end
+
+function Maleta.iniciar(op: Opcoes)
+	local jogador = op.jogador
+	local api = {}
+	local conexoes: { RBXScriptConnection } = {}
+	local vivo = true
+	local ICO = op.icones or {}
+
+	local function T(): any
+		local l = if op.idioma then op.idioma() else "pt"
+		return Maleta.TEXTOS[l] or Maleta.TEXTOS.pt
+	end
+	local function tocar(chave: string, velocidade: number?, volume: number?)
+		if op.som then
+			local ok, s = pcall(op.som, chave)
+			if ok and typeof(s) == "Instance" and s:IsA("Sound") then
+				if velocidade then
+					s.PlaybackSpeed = velocidade
+				end
+				if volume then
+					s.Volume *= volume
+				end
+			end
+		end
+	end
+
+	local velho = op.playerGui:FindFirstChild("BastiaoMaleta")
+	if velho then
+		velho:Destroy()
+	end
+	local gui = novo("ScreenGui", {
+		Name = "BastiaoMaleta", ResetOnSpawn = false, DisplayOrder = 19, -- acima do HUD e das falas, abaixo do menu (20)
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Enabled = false,
+	}, op.playerGui)
+	pcall(function()
+		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
+	end)
+	local escuro = novo("Frame", {
+		Name = "Escuro", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45,
+		BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
+	}, gui)
+	local W, H = 572, 304
+	local cartao = novo("Frame", {
+		Name = "Maleta", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
+		Size = UDim2.fromOffset(W, H), BackgroundColor3 = COURO, BorderSizePixel = 0,
+	}, gui)
+	canto(cartao, 10)
+	novo("UIGradient", {
+		Rotation = 90,
+		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 160, 150)),
+	}, cartao)
+	novo("UIStroke", { Color = LATAO, Thickness = 2, Transparency = 0.15 }, cartao)
+	local escala = novo("UIScale", {}, cartao)
+	-- cantoneiras de latão (detalhe da maleta)
+	for _, a in { Vector2.new(0, 0), Vector2.new(1, 0), Vector2.new(0, 1), Vector2.new(1, 1) } do
+		local c = novo("Frame", {
+			Name = "Cantoneira", AnchorPoint = a, Position = UDim2.fromScale(a.X, a.Y), Size = UDim2.fromOffset(18, 18),
+			BackgroundColor3 = LATAO, BackgroundTransparency = 0.1, BorderSizePixel = 0,
+		}, cartao)
+		canto(c, 4)
+	end
+	local titulo = novo("TextLabel", {
+		Name = "Titulo", BackgroundTransparency = 1, Position = UDim2.fromOffset(18, 10), Size = UDim2.fromOffset(200, 22),
+		FontFace = MONO, TextSize = 16, TextColor3 = AMBAR, TextXAlignment = Enum.TextXAlignment.Left, Text = "MALETA",
+	}, cartao)
+	-- fechar: quadrado vermelho com X branco no canto (o padrão que todo jogador conhece).
+	-- Modal: no primeira pessoa o mouse fica solto enquanto a maleta está aberta.
+	local fechar = novo("TextButton", {
+		Name = "Fechar", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(30, 30),
+		BackgroundColor3 = Color3.fromRGB(176, 40, 32), Text = "X", FontFace = MONO, TextSize = 15, TextColor3 = BRANCO,
+		AutoButtonColor = true, Modal = true,
+	}, cartao)
+	canto(fechar, 5)
+	-- área de toque maior que o desenho (44 px)
+	novo("TextButton", {
+		Name = "ToqueFechar", BackgroundTransparency = 1, Text = "", AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(44, 44),
+	}, fechar).Activated:Connect(function()
+		api.fechar()
+	end)
+
+	-- grade (10 x 6) com as linhas da maleta
+	local grade = novo("Frame", {
+		Name = "Grade", Position = UDim2.fromOffset(16, 44), Size = UDim2.fromOffset(COLS * CEL, LINHAS * CEL),
+		BackgroundColor3 = FUNDO_GRADE, BorderSizePixel = 0,
+	}, cartao)
+	novo("UIStroke", { Color = LINHA_GRADE, Thickness = 1 }, grade)
+	for x = 1, COLS - 1 do
+		novo("Frame", { Name = "Coluna", BackgroundColor3 = LINHA_GRADE, BackgroundTransparency = 0.35, BorderSizePixel = 0,
+			Position = UDim2.fromOffset(x * CEL, 0), Size = UDim2.new(0, 1, 1, 0) }, grade)
+	end
+	for y = 1, LINHAS - 1 do
+		novo("Frame", { Name = "Linha", BackgroundColor3 = LINHA_GRADE, BackgroundTransparency = 0.35, BorderSizePixel = 0,
+			Position = UDim2.fromOffset(0, y * CEL), Size = UDim2.new(1, 0, 0, 1) }, grade)
+	end
+
+	-- painel da direita: nome, descrição, botão e o que está na mão
+	local lado = novo("Frame", {
+		Name = "Detalhe", BackgroundTransparency = 1, Position = UDim2.fromOffset(16 + COLS * CEL + 14, 44),
+		Size = UDim2.fromOffset(W - (16 + COLS * CEL + 14) - 16, LINHAS * CEL),
+	}, cartao)
+	local nomeItem = novo("TextLabel", {
+		Name = "Nome", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), FontFace = MONO, TextSize = 15,
+		TextColor3 = BRANCO, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = "",
+	}, lado)
+	local descricao = novo("TextLabel", {
+		Name = "Descricao", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 92),
+		FontFace = MONO_N, TextSize = 12, TextColor3 = DIM, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
+		TextYAlignment = Enum.TextYAlignment.Top, Text = "",
+	}, lado)
+	local acao = novo("TextButton", {
+		Name = "Acao", Position = UDim2.fromOffset(0, 122), Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Color3.fromRGB(46, 38, 26),
+		FontFace = MONO, TextSize = 14, TextColor3 = AMBAR, Text = "", AutoButtonColor = true, Visible = false,
+	}, lado)
+	canto(acao, 6)
+	novo("UIStroke", { Color = AMBAR, Thickness = 1, Transparency = 0.45, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, acao)
+	local naMaoLinha = novo("Frame", {
+		Name = "NaMao", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
+		Size = UDim2.new(1, 0, 0, 30),
+	}, lado)
+	local naMaoIcone = novo("ImageLabel", {
+		Name = "Icone", BackgroundTransparency = 1, Size = UDim2.fromOffset(40, 26), ScaleType = Enum.ScaleType.Fit,
+		ImageColor3 = BRANCO, Image = ICO.mao or "",
+	}, naMaoLinha)
+	local naMaoTexto = novo("TextLabel", {
+		Name = "Texto", BackgroundTransparency = 1, Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -46, 1, 0),
+		FontFace = MONO, TextSize = 12, TextColor3 = BRANCO, TextXAlignment = Enum.TextXAlignment.Left, Text = "",
+	}, naMaoLinha)
+
+	-- ===== itens =====
+	local botoes: { [string]: TextButton } = {}
+	local escolhido: string? = nil
+	local function naMao(): boolean
+		return jogador:GetAttribute("BastiaoArma") == true and jogador:GetAttribute("BastiaoArmaNaMao") ~= false
+	end
+	local function itens(): { any }
+		local l = {}
+		if jogador:GetAttribute("BastiaoArma") == true then
+			table.insert(l, { id = "fuzil", x = 0, y = 0, w = 7, h = 2 })
+			local r = tonumber(jogador:GetAttribute("BastiaoReserva")) or 0
+			if r > 0 then
+				table.insert(l, { id = "municao", x = 0, y = 2, w = 2, h = 1, conta = "x" .. r })
+			end
+		end
+		local f = math.clamp(tonumber(workspace:GetAttribute("BastiaoItemFusiveis")) or 0, 0, 3)
+		for i = 1, f do
+			table.insert(l, { id = "fusivel", n = i, x = 6 + i, y = 0, w = 1, h = 2 })
+		end
+		if workspace:GetAttribute("BastiaoItemCartao") == true then
+			table.insert(l, { id = "cartao", x = 2, y = 2, w = 2, h = 1 })
+		end
+		return l
+	end
+	local function marcarEscolhido()
+		for chave, b in botoes do
+			local s = b:FindFirstChild("Selecao") :: UIStroke?
+			if s then
+				s.Transparency = if chave == escolhido then 0 else 1
+			end
+			b.BackgroundTransparency = if chave == escolhido then 0.55 else 0.85
+		end
+		local t = T()
+		local item = escolhido and string.match(escolhido, "^(%a+)")
+		local txt = item and t[item]
+		nomeItem.Text = if txt then txt[1] else ""
+		descricao.Text = if txt then txt[2] .. (if item == "fusivel" or item == "cartao" then "\n\n" .. t.chave else "") else t.vazio
+		acao.Visible = item == "fuzil"
+		acao.Text = if naMao() then t.guardar else t.equipar
+		naMaoIcone.Image = if naMao() then (ICO.fuzil or "") else (ICO.mao or "")
+		naMaoTexto.Text = t.naMao .. ": " .. (if naMao() then "AK-74" else t.nada)
+		titulo.Text = t.titulo
+	end
+	local function escolher(chave: string)
+		escolhido = chave
+		tocar("ak_vazio", 1.7, 0.35)
+		marcarEscolhido()
+	end
+	local function redesenhar()
+		for _, b in botoes do
+			b:Destroy()
+		end
+		table.clear(botoes)
+		local primeiro: string? = nil
+		for _, it in itens() do
+			local chave = it.id .. (if it.n then tostring(it.n) else "")
+			primeiro = primeiro or chave
+			local b = novo("TextButton", {
+				Name = chave, Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(70, 60, 44),
+				BackgroundTransparency = 0.85, BorderSizePixel = 0,
+				Position = UDim2.fromOffset(it.x * CEL + 2, it.y * CEL + 2), Size = UDim2.fromOffset(it.w * CEL - 3, it.h * CEL - 3),
+			}, grade)
+			novo("UIStroke", { Name = "Selecao", Color = AMBAR, Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
+			local aspecto = (it.w * CEL) / (it.h * CEL)
+			if it.id == "fuzil" and op.modelo and type(op.modelo.construir) == "function" then
+				local ok, m = pcall(op.modelo.construir, { ancorado = true })
+				if ok and m then
+					-- de lado, cano para a direita, mostrando o lado do seletor
+					pcall(vitrine, b, m, CFrame.Angles(0, math.rad(-90), 0), aspecto)
+				end
+			elseif it.id == "fusivel" then
+				pcall(vitrine, b, modeloFusivel(), CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(math.rad(20), 0, 0), aspecto)
+			elseif it.id == "cartao" then
+				pcall(vitrine, b, modeloCartao(), CFrame.Angles(math.rad(70), 0, 0), aspecto)
+			elseif it.id == "municao" then
+				novo("ImageLabel", {
+					Name = "Icone", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0),
+					Size = UDim2.fromOffset(22, 22), ScaleType = Enum.ScaleType.Fit, Image = ICO.bala or "", ImageColor3 = AMBAR,
+				}, b)
+			end
+			if it.conta then
+				novo("TextLabel", {
+					Name = "Conta", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -2),
+					Size = UDim2.fromOffset(60, 14), FontFace = MONO, TextSize = 11, TextColor3 = BRANCO,
+					TextXAlignment = Enum.TextXAlignment.Right, TextStrokeTransparency = 0.4, Text = it.conta,
+				}, b)
+			end
+			b.Activated:Connect(function()
+				if escolhido == chave and it.id == "fuzil" and op.empunhar then
+					op.empunhar(not naMao()) -- dois toques no fuzil: saca ou guarda
+				end
+				escolher(chave)
+			end)
+			botoes[chave] = b
+		end
+		if not (escolhido and botoes[escolhido]) then
+			escolhido = primeiro
+		end
+		marcarEscolhido()
+	end
+	acao.Activated:Connect(function()
+		if op.empunhar then
+			op.empunhar(not naMao())
+		end
+	end)
+
+	-- ===== abrir e fechar =====
+	local aberta = false
+	local function encaixar()
+		local s = gui.AbsoluteSize
+		if s.X > 10 and s.Y > 10 then
+			escala.Scale = math.min(1.25, (s.X - 24) / W, (s.Y - 16) / H)
+		end
+	end
+	function api.abrir()
+		if aberta or not vivo then
+			return
+		end
+		aberta = true
+		jogador:SetAttribute("BastiaoMaletaAberta", true)
+		redesenhar()
+		gui.Enabled = true
+		encaixar()
+		local alvo = escala.Scale
+		escala.Scale = alvo * 0.92
+		cartao.Rotation = -1.5
+		escuro.BackgroundTransparency = 1
+		local info = TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
+		TweenService:Create(escala, info, { Scale = alvo }):Play()
+		TweenService:Create(cartao, info, { Rotation = 0 }):Play()
+		TweenService:Create(escuro, TweenInfo.new(0.2), { BackgroundTransparency = 0.45 }):Play()
+		tocar("ak_vazio", 0.6, 0.5)
+		local ok, pref = pcall(function()
+			return UserInputService.PreferredInput
+		end)
+		if ok and pref == Enum.PreferredInput.Gamepad and escolhido and botoes[escolhido] then
+			GuiService.SelectedObject = botoes[escolhido]
+		end
+	end
+	function api.fechar()
+		if not aberta then
+			return
+		end
+		aberta = false
+		jogador:SetAttribute("BastiaoMaletaAberta", false)
+		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then
+			GuiService.SelectedObject = nil
+		end
+		gui.Enabled = false
+		tocar("ak_vazio", 0.8, 0.35)
+	end
+	function api.alternar()
+		if aberta then
+			api.fechar()
+		else
+			api.abrir()
+		end
+	end
+	function api.aberta(): boolean
+		return aberta
+	end
+
+	-- o TAB do Roblox também mostra a lista de jogadores: só vale quando o jogo desligou essa lista
+	local function tabLivre(): boolean
+		local ok, ligada = pcall(function()
+			return game:GetService("StarterGui"):GetCoreGuiEnabled(Enum.CoreGuiType.PlayerList)
+		end)
+		return not (ok and ligada == true)
+	end
