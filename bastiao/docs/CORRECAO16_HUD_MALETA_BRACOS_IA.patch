+-- ===== primeira pessoa (correção 16): braços do boneco R6 segurando o fuzil =====
+-- Braços de bloco do Roblox (1 x 2 x 1, com a camisa do jogador) e luvas pretas na mão. A mão
+-- direita envolve o punho e a esquerda o guarda-mão; os braços vão para baixo e para trás, até
+-- sair da tela (podem "flutuar", sem ombro, como na maioria dos jogos de tiro do Roblox).
+-- vm encolhe tudo junto (braços e fuzil) para caber perto da câmera; o fuzil fica na proporção
+-- do que os outros veem na mão do boneco (escala da arma em relação ao braço).
+ArmaModelo.VM = 0.45
+ArmaModelo.ESCALA_MAO = 1.6 -- na mão do boneco (terceira pessoa)
+ArmaModelo.ESCALA_PRIMEIRA = 2.4 -- na primeira pessoa (vm x escala = 1,08: quase o tamanho do fuzil antigo)
+-- direção do cotovelo (eixo do fuzil: x direita, y cima, z para trás) e onde fica a mão (cm do fuzil)
+ArmaModelo.BRACO_DIR = { mao = V3(0.6, -9.6, 6.2), cotovelo = V3(0.55, -0.68, 0.48) }
+ArmaModelo.BRACO_ESQ = { mao = V3(-0.6, -10.5, -27), cotovelo = V3(-0.42, -0.78, 0.46) }
+
+local function blocoBraco(nome: string, maoStuds: Vector3, cotovelo: Vector3, u: number, cor: Color3, luva: string): { BasePart }
+	local y = cotovelo.Unit
+	local xg = V3(1, 0, 0)
+	local x = (xg - y * xg:Dot(y)).Unit
+	local z = x:Cross(y)
+	-- a mão fica a meio stud da ponta do braço; o centro do braço, 1 stud acima da ponta
+	local base = CFrame.fromMatrix(maoStuds, x, y, z)
+	local braco = Instance.new("Part")
+	braco.Name = nome
+	braco.Size = V3(1, 2, 1) * u
+	braco.CFrame = base * CFrame.new(0, 0.5 * u, 0)
+	braco.Color = cor
+	braco.Material = Enum.Material.SmoothPlastic
+	local l = Instance.new("Part")
+	l.Name = luva
+	l.Size = V3(1.06, 0.62, 1.06) * u
+	l.CFrame = base * CFrame.new(0, -0.19 * u, 0)
+	l.Color = LUVA
+	l.Material = Enum.Material.Fabric
+	local partes = { braco, l }
+	for _, p in partes do
+		p.TopSurface = Enum.SurfaceType.Smooth
+		p.BottomSurface = Enum.SurfaceType.Smooth
+		p.CanCollide = false
+		p.CanTouch = false
+		p.CanQuery = false
+		p.Massless = true
+		p.CastShadow = false
+		p.Anchored = true
+	end
+	return partes
+end
+
+export type OpcoesPrimeiraPessoa = { vm: number?, escala: number?, corBraco: Color3? }
+
+-- Fuzil + braços na origem do fuzil (a mesma origem do construir: gatilho, cano para -Z).
+-- Nomes "Right Arm" e "Left Arm" para a camisa (Shirt) do jogador aparecer neles.
+function ArmaModelo.primeiraPessoa(op: OpcoesPrimeiraPessoa?): Model
+	local o = op or {}
+	local u = o.vm or ArmaModelo.VM
+	local esc = (o.escala or ArmaModelo.ESCALA_PRIMEIRA) * u
+	local cm = CM * esc
+	local modelo = ArmaModelo.construir({ ancorado = true, escala = esc })
+	local cor = o.corBraco or UNIFORME
+	local d, e = ArmaModelo.BRACO_DIR, ArmaModelo.BRACO_ESQ
+	for _, p in blocoBraco("Right Arm", d.mao * cm, d.cotovelo, u, cor, "DirLuva") do
+		p.Parent = modelo
+	end
+	for _, p in blocoBraco("Left Arm", e.mao * cm, e.cotovelo, u, cor, "EsqLuva") do
+		p.Parent = modelo
+	end
+	return modelo
+end
+
 return ArmaModelo
