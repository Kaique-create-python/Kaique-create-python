+-- o que o harness básico não tem e estes módulos usam
+local novoOriginal = h.new
+function h:new(class, name, parent)
+	local n = novoOriginal(self, class, name, parent)
+	n._p.InputBegan = self:signal()
+	n._p.InputEnded = self:signal()
+	return n
+end
+local passosRender = {}
+h.services.RunService.RenderStepped = h:signal()
+h.services.RunService.BindToRenderStep = function(_, nome, _, fn) passosRender[nome] = fn end
+h.services.RunService.UnbindFromRenderStep = function(_, nome) passosRender[nome] = nil end
+local entradaComeca, entradaTermina = h:signal(), h:signal()
+h.services.UserInputService.InputBegan = entradaComeca
+h.services.UserInputService.InputEnded = entradaTermina
+h.services.UserInputService.GetFocusedTextBox = function() return nil end
+h.services.GuiService.MenuIsOpen = false
+h.environment.CFrame = roblox.CFrame
+h.environment.ColorSequence = roblox.ColorSequence
+h.environment.ColorSequenceKeypoint = roblox.ColorSequenceKeypoint
+h.environment.NumberSequence = roblox.NumberSequence
+h.environment.NumberSequenceKeypoint = roblox.NumberSequenceKeypoint
+h.environment.math = math
+h.workspace.CurrentCamera = h:new("Camera", "Camera", h.workspace)
+h.workspace.CurrentCamera.CFrame = roblox.CFrame.new(0, 5, 0)
+h.workspace.CurrentCamera.CameraType = roblox.Enum.CameraType.Custom
+function h.workspace:BulkMoveTo(partes, cfs)
+	for i, p in partes do p.CFrame = cfs[i] end
+end
+local function renderizar(dt)
+	h:tick(dt)
+	h.services.RunService.RenderStepped:Fire(dt)
+	for _, fn in table.clone(passosRender) do fn(dt) end
+end
+
+local compartilhado = h:new("Folder", "Compartilhado")
