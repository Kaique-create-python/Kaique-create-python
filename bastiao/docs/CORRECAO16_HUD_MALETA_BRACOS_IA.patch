+local Harness = require("./client_harness")
+local roblox = require("@lune/roblox")
+local h = Harness.new()
+local passed, failed = 0, 0
+local function test(name, fn)
+	local ok, message = pcall(fn)
+	if ok then
+		passed += 1
+		print("PASS", name)
