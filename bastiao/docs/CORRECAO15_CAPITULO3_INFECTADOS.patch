+	for i, z in { -116, -136, -152 } do
+		local lado = if i % 2 == 0 then 1 else -1
+		peca(pasta, "BastiaoPortaLateral", V(0.3, 7, 4), CFrame.new(3.85 * lado, PISO + 3.5, z), METAL, Enum.Material.Metal)
