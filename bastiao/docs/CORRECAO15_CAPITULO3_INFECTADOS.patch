+	peca(pasta, "BastiaoBotaoSemNumero", V(0.12, 0.35, 0.35), painel.CFrame * CFrame.new(-0.15, 0, 0), Color3.fromRGB(190, 30, 24), Enum.Material.Neon, false)
+	peca(pasta, "BastiaoCorrimaoCabine", V(0.2, 0.2, 7), CFrame.new(-3.6, PISO + 3.4, -80), METAL_ESCURO, Enum.Material.Metal, false)
+
+	-- ===== saguão: barricada de sacos de areia, mesa virada, sangue =====
+	for i = 0, 7 do
