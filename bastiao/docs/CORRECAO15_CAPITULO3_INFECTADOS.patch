diff -ruN z14/src/client/InfectadosCliente.luau z15/src/client/InfectadosCliente.luau
--- z14/src/client/InfectadosCliente.luau	1970-01-01 00:00:00.000000000 +0000
+++ z15/src/client/InfectadosCliente.luau	2026-11-18 15:05:35.520284333 +0000
@@ -0,0 +1,260 @@
+--!strict
+-- PROJETO BASTIÃO :: InfectadosCliente — como os soldados infectados se mexem e soam (capítulo 3).
+-- Nada de andar duro com os braços para frente: corpo curvado, uma perna mancando e arrastando,
+-- um braço mole, ombros que se contraem, cabeça caída de lado com espasmos rápidos, arrancadas
+-- e uma garra de cima para baixo no ataque. Tudo procedural nas juntas R6 (Motor6D.Transform),
+-- cada infectado com o seu jeito (BastiaoSemente). Também toca os sons (gemido, grito, ataque, dor
+-- e morte, na cabeça deles) e escurece a tela no blackout do andar sem número.
+
+local RunService = game:GetService("RunService")
+local CollectionService = game:GetService("CollectionService")
+local Lighting = game:GetService("Lighting")
+local TweenService = game:GetService("TweenService")
+
+local InfectadosCliente = {}
+InfectadosCliente.TAG = "BastiaoInfectado"
+local rad = math.rad
+
+local function suave(a: number): number
+	a = math.clamp(a, 0, 1)
+	return a * a * (3 - 2 * a)
+end
+
+-- rotação E (nos eixos da peça-mãe, em volta da junta) convertida para Transform da Motor6D
+local function naJunta(m: Motor6D, e: CFrame): CFrame
+	local r = m.C0.Rotation
+	return r:Inverse() * e * r
+end
+
+export type Opcoes = {
+	som: any?, -- { efeito(chave, pos?): Sound? }
+}
+
+function InfectadosCliente.iniciar(op: Opcoes)
+	local api = {}
+	local vivo = true
+	local conexoes: { RBXScriptConnection } = {}
+	local corpos: { [Model]: any } = {}
+
+	local function tocar(chave: string, pos: Vector3, pitch: number?): Sound?
+		if op.som and op.som.efeito then
+			local ok, s = pcall(op.som.efeito, chave, pos)
+			if ok and typeof(s) == "Instance" then
+				if pitch then
+					(s :: Sound).PlaybackSpeed = pitch
+				end
+				return s :: Sound
+			end
+		end
+		return nil
+	end
+
+	local function ligar(m: Instance)
+		if not m:IsA("Model") or corpos[m] then
+			return
+		end
+		local raiz = m:WaitForChild("HumanoidRootPart", 5)
+		local torso = m:WaitForChild("Torso", 5)
+		if not raiz or not torso or not raiz:IsA("BasePart") then
+			return
+		end
+		local function junta(pai: Instance, nome: string): Motor6D?
+			local j = pai:FindFirstChild(nome)
+			return if j and j:IsA("Motor6D") then j else nil
+		end
+		local semente = tonumber(m:GetAttribute("BastiaoSemente")) or 1
+		local r = Random.new(semente)
+		local z = {
+			modelo = m, raiz = raiz :: BasePart, cabeca = m:FindFirstChild("Head") :: BasePart?,
+			root = junta(raiz, "RootJoint"), pescoco = junta(torso, "Neck"),
+			ombroD = junta(torso, "Right Shoulder"), ombroE = junta(torso, "Left Shoulder"),
+			quadrilD = junta(torso, "Right Hip"), quadrilE = junta(torso, "Left Hip"),
+			fase = r:NextNumber() * 6.28, curva = rad(r:NextNumber(22, 34)), lado = if r:NextNumber() < 0.5 then -1 else 1,
+			mancaDireita = r:NextNumber() < 0.5, ritmo = r:NextNumber(0.75, 1.1),
+			espasmo = 0, alvoEspasmo = CFrame.identity, espasmoAte = 0, proxEspasmo = os.clock() + r:NextNumber(0.5, 2.5),
+			proxGemido = os.clock() + r:NextNumber(1, 6), ataqueEm = -10, dorEm = -10, rng = r,
+			ultimoGrito = m:GetAttribute("BastiaoGrito"), ultimoAtaque = m:GetAttribute("BastiaoAtaque"), ultimaDor = m:GetAttribute("BastiaoDor"),
+			somDorEm = -10, morreuSom = false,
+		}
+		corpos[m] = z
+		table.insert(conexoes, m:GetAttributeChangedSignal("BastiaoGrito"):Connect(function()
+			if z.cabeca then
+				tocar(if z.rng:NextNumber() < 0.5 then "infectado_grito_1" else "infectado_grito_2", z.cabeca.Position, z.rng:NextNumber(0.9, 1.08))
+			end
+		end))
+		table.insert(conexoes, m:GetAttributeChangedSignal("BastiaoAtaque"):Connect(function()
+			z.ataqueEm = os.clock()
+			if z.cabeca then
+				tocar(if z.rng:NextNumber() < 0.5 then "infectado_ataque_1" else "infectado_ataque_2", z.cabeca.Position, z.rng:NextNumber(0.92, 1.1))
+			end
+		end))
+		table.insert(conexoes, m:GetAttributeChangedSignal("BastiaoDor"):Connect(function()
+			local agora = os.clock()
+			z.dorEm = agora
+			if z.cabeca and agora - z.somDorEm > 0.3 then
+				z.somDorEm = agora
+				tocar("infectado_dor", z.cabeca.Position, z.rng:NextNumber(0.85, 1.15))
+			end
+		end))
+		table.insert(conexoes, m:GetAttributeChangedSignal("BastiaoMorto"):Connect(function()
+			if m:GetAttribute("BastiaoMorto") == true and not z.morreuSom and z.cabeca then
+				z.morreuSom = true
+				tocar("infectado_morte", z.cabeca.Position, z.rng:NextNumber(0.9, 1.05))
+			end
+		end))
+	end
+	for _, m in CollectionService:GetTagged(InfectadosCliente.TAG) do
+		task.spawn(ligar, m)
+	end
+	table.insert(conexoes, CollectionService:GetInstanceAddedSignal(InfectadosCliente.TAG):Connect(function(m)
+		task.spawn(ligar, m)
+	end))
+	table.insert(conexoes, CollectionService:GetInstanceRemovedSignal(InfectadosCliente.TAG):Connect(function(m)
+		corpos[m :: Model] = nil
+	end))
+
+	-- ===== pose de cada quadro =====
+	local function animar(z: any, dt: number, agora: number, cam: Vector3)
+		local m = z.modelo
+		if m:GetAttribute("BastiaoMorto") == true or not z.root then
+			return
+		end
+		local pos = z.raiz.Position
+		if (pos - cam).Magnitude > 140 then
+			return
+		end
+		local v = z.raiz.AssemblyLinearVelocity
+		local vel = Vector3.new(v.X, 0, v.Z).Magnitude
+		local andando = math.clamp(vel / 8, 0, 1)
+		local dormindo = m:GetAttribute("BastiaoEstado") == "dormindo"
+		z.fase += dt * (vel * 0.85 * z.ritmo + (if andando < 0.1 then 0.9 else 0))
+		local f = z.fase
+		-- espasmos: a cabeça estala para um lado e volta (de vez em quando)
+		if agora >= z.proxEspasmo then
+			z.proxEspasmo = agora + z.rng:NextNumber(0.8, 3.2)
+			z.alvoEspasmo = CFrame.Angles(z.rng:NextNumber(-0.25, 0.35), z.rng:NextNumber(-0.7, 0.7), z.rng:NextNumber(-0.55, 0.55))
+			z.espasmoAte = agora + z.rng:NextNumber(0.08, 0.2)
+		end
+		local estala = if agora < z.espasmoAte then 1 else 0
+		z.espasmo += (estala - z.espasmo) * math.min(1, dt * (if estala > 0 then 40 else 9))
+		-- ataque (garra de cima para baixo) e tranco do tiro
+		local ta = agora - z.ataqueEm
+		local garra, bote = 0, 0
+		if ta < 0.55 then
+			garra = if ta < 0.3 then suave(ta / 0.3) else 1 - suave((ta - 0.3) / 0.25)
+			bote = if ta < 0.3 then 0 else math.sin(math.pi * math.clamp((ta - 0.3) / 0.25, 0, 1))
+		end
+		local td = agora - z.dorEm
+		local tranco = if td < 0.22 then math.sin(math.pi * td / 0.22) else 0
+		-- tronco curvado que balança e torce com o passo mancado
+		local curva = z.curva + (if dormindo then rad(14) else 0) + rad(10) * bote - rad(12) * tranco
+		local balanco = math.sin(f) * andando
+		local respira = math.sin(agora * 1.3 + z.lado) * (1 - andando)
+		local root = CFrame.Angles(-curva + rad(3) * math.sin(2 * f) * andando, rad(9) * balanco * z.lado, rad(7) * balanco + rad(4) * respira * z.lado)
+		z.root.Transform = naJunta(z.root, root)
+		-- cabeça caída de lado, levantada para olhar a presa, com espasmos
+		if z.pescoco then
+			local olhar = if dormindo then -rad(22) else curva * 0.6
+			local cab = CFrame.Angles(olhar + rad(8) * tranco, rad(6) * math.sin(agora * 0.7), rad(20) * z.lado + rad(5) * respira)
+			z.pescoco.Transform = naJunta(z.pescoco, cab:Lerp(cab * z.alvoEspasmo, z.espasmo))
+		end
+		-- braços soltos (pendurados pelo corpo curvado), um deles mole; na garra sobem e descem
+		local pendura = curva * 0.9
+		local molhe = if z.mancaDireita then 1 else -1
+		if z.ombroD then
+			local sw = rad(14) * math.sin(f + math.pi) * andando
+			local e = CFrame.Angles(pendura + sw + rad(115) * garra - rad(20) * tranco, 0, rad(7) + rad(18) * garra)
+			z.ombroD.Transform = naJunta(z.ombroD, e)
+		end
+		if z.ombroE then
+			local sw = rad(8) * math.sin(f + 0.6) * andando
+			local e = CFrame.Angles(pendura + sw + rad(95) * suave((ta - 0.08) / 0.3) * (if ta < 0.55 then 1 else 0) - rad(15) * tranco,
+				0, -rad(12) - rad(6) * molhe)
+			z.ombroE.Transform = naJunta(z.ombroE, e)
+		end
+		-- pernas: uma passa normal, a outra arrasta (passo curto, atrás)
+		local passoBom = rad(28) * math.sin(f) * andando
+		local passoRuim = rad(12) * math.sin(f + math.pi) * andando - rad(5) * andando
+		local dir = if z.mancaDireita then passoRuim else passoBom
+		local esq = if z.mancaDireita then passoBom else passoRuim
+		if z.quadrilD then
+			z.quadrilD.Transform = naJunta(z.quadrilD, CFrame.Angles(curva + dir, 0, rad(3)))
+		end
+		if z.quadrilE then
+			z.quadrilE.Transform = naJunta(z.quadrilE, CFrame.Angles(curva + esq, 0, -rad(3)))
+		end
+		-- gemidos de tempos em tempos
+		if agora >= z.proxGemido then
+			z.proxGemido = agora + z.rng:NextNumber(3.5, 8)
+			if z.cabeca and (pos - cam).Magnitude < 70 then
+				tocar(if z.rng:NextNumber() < 0.5 then "infectado_idle_1" else "infectado_idle_2", z.cabeca.Position, z.rng:NextNumber(0.88, 1.1))
+			end
+		end
+	end
+	table.insert(conexoes, RunService.Stepped:Connect(function(_t: number, dt: number)
+		if not vivo then
+			return
+		end
+		local camera = workspace.CurrentCamera
+		local cam = if camera then camera.CFrame.Position else Vector3.zero
+		local agora = os.clock()
+		for m, z in corpos do
+			if not m.Parent then
+				corpos[m] = nil
+			else
+				local ok = pcall(animar, z, math.min(dt, 0.1), agora, cam)
+				if not ok then
+					corpos[m] = nil
+				end
+			end
+		end
+	end))
+
+	-- ===== blackout: a tela escurece e perde a cor no andar sem número =====
+	local cc: ColorCorrectionEffect? = nil
+	local escuroAtual = false
+	local function atualizarBlackout()
+		local camera = workspace.CurrentCamera
+		local abaixo = camera ~= nil and camera.CFrame.Position.Y < -80
+		local quer = workspace:GetAttribute("BastiaoBlackout") == true and abaixo
+		if quer == escuroAtual then
+			return
+		end
+		escuroAtual = quer
+		if not cc then
+			local novo = Instance.new("ColorCorrectionEffect")
+			novo.Name = "BastiaoBlackoutCC"
+			novo.Brightness = 0
+			novo.Contrast = 0
+			novo.Saturation = 0
+			novo.Parent = Lighting
+			cc = novo
+		end
+		local alvo = if quer then { Brightness = -0.16, Contrast = 0.3, Saturation = -0.7, TintColor = Color3.fromRGB(205, 215, 255) }
+			else { Brightness = 0, Contrast = 0, Saturation = 0, TintColor = Color3.new(1, 1, 1) }
+		TweenService:Create(cc :: ColorCorrectionEffect, TweenInfo.new(if quer then 0.25 else 1.2), alvo):Play()
+	end
+	table.insert(conexoes, workspace:GetAttributeChangedSignal("BastiaoBlackout"):Connect(atualizarBlackout))
+	task.spawn(function()
+		while vivo do
+			pcall(atualizarBlackout)
+			task.wait(1)
+		end
+	end)
+
+	function api.destroy()
+		vivo = false
+		for _, c in conexoes do
+			c:Disconnect()
+		end
+		table.clear(conexoes)
+		table.clear(corpos)
+		if cc then
+			cc:Destroy()
+			cc = nil
+		end
+	end
+	return api
+end
+
+return InfectadosCliente
