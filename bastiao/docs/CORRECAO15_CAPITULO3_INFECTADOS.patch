+
+	-- ===== corredor: canos no teto, portas fechadas dos lados, barricada furada =====
+	for _, x in { -3, -2.2 } do
+		peca(pasta, "BastiaoCano3", V(0.5, 0.5, 60), CFrame.new(x, PISO + 8.2, -134), METAL_ESCURO, Enum.Material.Metal, false)
