+
+	local function vestir(hum: Humanoid, semente: number)
+		local d = Instance.new("HumanoidDescription")
+		d.Shirt = ROUPA.camisa
+		d.Pants = ROUPA.calca
+		local r = Random.new(semente)
+		local chapeu = CHAPEUS[r:NextInteger(1, #CHAPEUS)]
+		d.HatAccessory = chapeu
+		d.FaceAccessory = if r:NextNumber() < 0.35 then MASCARA else ""
+		d.HeadColor, d.LeftArmColor, d.RightArmColor = PELE, PELE, PELE
+		d.TorsoColor, d.LeftLegColor, d.RightLegColor = PELE, PELE, PELE
+		local ok, erro = pcall(function()
+			hum:ApplyDescription(d)
+		end)
+		if not ok then
+			log("[Bastiao] uniforme do infectado falhou: " .. tostring(erro))
+		end
+	end
+
+	local function olhos(cabeca: BasePart)
