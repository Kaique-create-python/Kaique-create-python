+Cenario04.DORMINDO = { CFrame.lookAt(V(2.6, PISO, -140), V(4, PISO, -140)), CFrame.lookAt(V(-16, PISO, -178), V(-20, PISO, -178)),
+	CFrame.lookAt(V(17, PISO, -197), V(22, PISO, -197)) }
+Cenario04.ONDA = { CFrame.lookAt(V(-21.5, PISO, -172), V(0, PISO, -180)), CFrame.lookAt(V(21.5, PISO, -174), V(0, PISO, -180)),
+	CFrame.lookAt(V(-21.5, PISO, -197), V(0, PISO, -185)), CFrame.lookAt(V(21.5, PISO, -199), V(0, PISO, -185)),
+	CFrame.lookAt(V(0, PISO, -216), V(0, PISO, -190)), CFrame.lookAt(V(0, PISO, -118), V(0, PISO, -150)),
+	CFrame.lookAt(V(-10, PISO, -98), V(0, PISO, -110)) }
+
+local CONCRETO = Color3.fromRGB(84, 86, 82)
+local CONCRETO_ESCURO = Color3.fromRGB(52, 53, 50)
+local PINTURA = Color3.fromRGB(70, 88, 78) -- verde-cinza soviético na metade de baixo das paredes
