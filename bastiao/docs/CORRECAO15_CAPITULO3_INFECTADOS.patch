+		local y = PISO + 0.45 + math.floor(i / 4) * 0.85
+		peca(pasta, "BastiaoSacoAreia", V(2, 0.85, 1.1), CFrame.new(x, y, -96) * CFrame.Angles(0, math.rad((i * 7) % 11 - 5), 0), AREIA, Enum.Material.Fabric)
