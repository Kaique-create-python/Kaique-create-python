+			o.CanCollide = false
+			o.CanQuery = false
+			o.CanTouch = false
+			o.Massless = true
+			o.CastShadow = false
+			o.CFrame = cabeca.CFrame * CFrame.new(x, 0.12, -0.5)
+			local w = Instance.new("WeldConstraint")
+			w.Part0 = cabeca
+			w.Part1 = o
+			w.Parent = o
+			o.Parent = cabeca
+		end
+		local l = Instance.new("PointLight")
+		l.Color = OLHOS
+		l.Brightness = 0.7
+		l.Range = 5
+		l.Parent = cabeca
+	end
+
+	local function contarVivos(): number
+		local n = 0
+		for _, z in lista do
+			if not z.morto then
+				n += 1
+			end
+		end
+		return n
+	end
+	local function talvezFim()
+		if ondaAtiva and not avisouFim and contarVivos() == 0 then
+			avisouFim = true
+			if op.aoTodosMortos then
+				task.spawn(op.aoTodosMortos)
+			end
+		end
+	end
+
+	local function morrer(z: any)
+		if z.morto then
+			return
+		end
+		z.morto = true
+		z.modelo:SetAttribute("BastiaoMorto", true)
+		z.modelo:SetAttribute("BastiaoEstado", "morto")
+		pcall(ragdoll, z.modelo)
+		pcall(function()
+			z.hum:ChangeState(Enum.HumanoidStateType.Physics)
+		end)
+		task.delay(40, function()
+			if z.modelo.Parent then
+				z.modelo:Destroy()
+			end
+		end)
+		talvezFim()
+	end
+
+	-- cria um infectado num ponto; acordado = já sai caçando
+	function api.criar(cf: CFrame, acordado: boolean?): Model?
+		local rig = criarRig()
+		if not rig then
+			log("[Bastiao] infectado: sem StarterCharacter para clonar")
+			return nil
+		end
+		for _, d in rig:GetDescendants() do
+			if d:IsA("LuaSourceContainer") then
+				d:Destroy()
+			end
+		end
+		local hum = rig:FindFirstChildOfClass("Humanoid")
+		local raiz = rig:FindFirstChild("HumanoidRootPart")
+		local cabeca = rig:FindFirstChild("Head")
+		if not hum or not raiz or not raiz:IsA("BasePart") or not cabeca or not cabeca:IsA("BasePart") then
+			rig:Destroy()
+			return nil
+		end
+		local semente = math.random(1, 1000000)
+		rig.Name = "BastiaoInfectado"
+		rig.PrimaryPart = raiz
+		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
+		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
+		hum.BreakJointsOnDeath = false
+		hum.RequiresNeck = false
+		hum.MaxHealth = Infectados.VIDA
+		hum.Health = Infectados.VIDA
+		hum.WalkSpeed = 8 + (semente % 5)
+		rig:SetAttribute(Infectados.TAG, true)
+		rig:SetAttribute("BastiaoSemente", semente)
+		rig:SetAttribute("BastiaoEstado", if acordado then "cacando" else "dormindo")
+		rig:SetAttribute("BastiaoGrito", 0)
+		rig:SetAttribute("BastiaoAtaque", 0)
+		rig:SetAttribute("BastiaoDor", 0)
+		rig:PivotTo(cf + Vector3.new(0, 3, 0))
+		olhos(cabeca)
+		rig.Parent = pasta
+		CollectionService:AddTag(rig, Infectados.TAG)
+		pcall(function()
+			raiz:SetNetworkOwner(nil)
+		end)
+		local z = {
+			modelo = rig, hum = hum, raiz = raiz, cabeca = cabeca, semente = semente,
+			estado = if acordado then "cacando" else "dormindo", alvo = nil :: Player?, morto = false,
+			ultimoAtaque = -10, proxCaminho = 0, pontos = {} :: { Vector3 }, pi = 1, calculando = false,
+		}
+		table.insert(lista, z)
+		table.insert(conexoes, hum.Died:Connect(function()
+			morrer(z)
+		end))
+		task.spawn(vestir, hum, semente)
+		return rig
+	end
+
+	local function acordar(z: any)
+		if z.morto or z.estado ~= "dormindo" then
+			return
+		end
+		z.estado = "cacando"
+		z.modelo:SetAttribute("BastiaoEstado", "cacando")
+		z.modelo:SetAttribute("BastiaoGrito", (z.modelo:GetAttribute("BastiaoGrito") or 0) + 1)
+	end
+	function api.acordarTodos()
+		ondaAtiva = true
+		for _, z in lista do
+			acordar(z)
+		end
+		talvezFim()
+	end
+	function api.comecarOnda()
+		ondaAtiva = true
+		avisouFim = false
+		talvezFim()
+	end
+	-- tiro faz barulho: quem está perto acorda
+	function api.ouvir(pos: Vector3, raio: number)
+		for _, z in lista do
+			if not z.morto and z.estado == "dormindo" and (z.raiz.Position - pos).Magnitude <= raio then
+				acordar(z)
+			end
+		end
+	end
+
+	-- o modelo de infectado de uma peça (ou nil)
+	function api.de(inst: Instance?): Model?
+		local m = inst and inst:FindFirstAncestorWhichIsA("Model")
+		while m do
+			if m:GetAttribute(Infectados.TAG) == true then
+				return m
+			end
+			m = m:FindFirstAncestorWhichIsA("Model")
+		end
+		return nil
+	end
+	-- tiro do servidor (Arma) acertou uma peça de infectado
+	function api.atingir(parte: BasePart, _jogador: Player?): boolean
+		local m = api.de(parte)
+		if not m then
+			return false
+		end
+		for _, z in lista do
+			if z.modelo == m and not z.morto then
+				local dano = if parte.Name == "Head" or parte.Name == "BastiaoOlho" then Infectados.DANO_CABECA else Infectados.DANO_CORPO
+				m:SetAttribute("BastiaoDor", (m:GetAttribute("BastiaoDor") or 0) + 1)
+				acordar(z)
+				z.hum:TakeDamage(dano)
+				if z.hum.Health <= 0 then
+					morrer(z)
+				end
+				return true
+			end
+		end
+		return true
+	end
+	function api.restantes(): number
+		return contarVivos()
+	end
+	function api.total(): number
+		return #lista
+	end
+	function api.matarTodos()
+		for _, z in lista do
+			if not z.morto then
+				z.hum.Health = 0
+				morrer(z)
+			end
+		end
+	end
+
+	-- ===== cérebro (10 vezes por segundo) =====
+	local function maisPerto(z: any, alcance: number): (Player?, Vector3?, number)
+		local melhor, pos, dist = nil, nil, alcance
+		for _, j in Players:GetPlayers() do
+			local c = j.Character
+			local h = c and c:FindFirstChildOfClass("Humanoid")
+			local r = c and c:FindFirstChild("HumanoidRootPart")
+			if h and h.Health > 0 and r and r:IsA("BasePart") then
+				local d = (r.Position - z.raiz.Position).Magnitude
+				if d < dist then
+					melhor, pos, dist = j, r.Position, d
+				end
+			end
+		end
+		return melhor, pos, dist
+	end
+	local function enxerga(z: any, alvo: Vector3): boolean
+		local filtro: { Instance } = { pasta }
+		for _, j in Players:GetPlayers() do
+			if j.Character then
+				table.insert(filtro, j.Character)
+			end
+		end
+		paramsVista.FilterDescendantsInstances = filtro
+		local o = z.cabeca.Position
+		return workspace:Raycast(o, alvo - o, paramsVista) == nil
+	end
+	local function caminhar(z: any, destino: Vector3, agora: number)
+		if agora >= z.proxCaminho and not z.calculando then
+			z.proxCaminho = agora + 0.8
+			z.calculando = true
+			task.spawn(function()
+				local ok, pontos = pcall(function()
+					local caminho = PathfindingService:CreatePath({ AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = false })
+					caminho:ComputeAsync(z.raiz.Position, destino)
+					if caminho.Status ~= Enum.PathStatus.Success then
+						return nil
+					end
+					local l = {}
+					for _, w in caminho:GetWaypoints() do
+						table.insert(l, w.Position)
+					end
+					return l
+				end)
+				z.calculando = false
+				if ok and pontos and #pontos > 1 then
+					z.pontos, z.pi = pontos, 2
+				else
+					z.pontos, z.pi = { destino }, 1
+				end
+			end)
+		end
+		local p = z.pontos[z.pi]
+		if p and (Vector3.new(p.X, 0, p.Z) - Vector3.new(z.raiz.Position.X, 0, z.raiz.Position.Z)).Magnitude < 2 then
+			z.pi += 1
+			p = z.pontos[z.pi]
+		end
+		z.hum:MoveTo(p or destino)
+	end
+	local function pensar(z: any, agora: number)
+		if z.morto or not z.modelo.Parent then
+			return
+		end
+		local alcance = if z.estado == "dormindo" then Infectados.VISAO_DORMINDO else Infectados.VISAO_ACORDADO
+		local alvo, pos, dist = maisPerto(z, alcance)
+		if z.estado == "dormindo" then
+			if alvo and pos and enxerga(z, pos) then
+				acordar(z)
+			else
+				z.hum:MoveTo(z.raiz.Position)
+				return
+			end
+		end
+		if not alvo or not pos then
+			z.hum:MoveTo(z.raiz.Position)
+			return
+		end
+		-- arrancada quando chega perto: anda torto e de repente corre
+		local base = 8 + (z.semente % 5)
+		z.hum.WalkSpeed = if dist < 12 then base + 7 else base
+		if dist <= 3.6 then
+			z.hum:MoveTo(pos)
+			if agora - z.ultimoAtaque >= Infectados.RECARGA_ATAQUE then
+				z.ultimoAtaque = agora
+				z.modelo:SetAttribute("BastiaoAtaque", (z.modelo:GetAttribute("BastiaoAtaque") or 0) + 1)
+				local vitima = alvo
+				task.delay(0.32, function()
+					local c = vitima.Character
+					local h = c and c:FindFirstChildOfClass("Humanoid")
+					local r = c and c:FindFirstChild("HumanoidRootPart")
+					if not z.morto and h and h.Health > 0 and r and r:IsA("BasePart") and (r.Position - z.raiz.Position).Magnitude <= 4.6 then
+						h:TakeDamage(Infectados.DANO_ATAQUE)
+					end
+				end)
+			end
+			return
+		end
+		caminhar(z, pos, agora)
+	end
+	local acumulado = 0
+	table.insert(conexoes, RunService.Heartbeat:Connect(function(dt: number)
+		if not vivo then
+			return
+		end
+		acumulado += dt
+		if acumulado < 0.1 then
+			return
+		end
+		acumulado = 0
+		local agora = os.clock()
+		for _, z in lista do
+			local ok, erro = pcall(pensar, z, agora)
+			if not ok then
+				log("[Bastiao] infectado: " .. tostring(erro))
+			end
+		end
+	end))
+
+	function api.destroy()
+		vivo = false
+		for _, c in conexoes do
+			c:Disconnect()
+		end
+		table.clear(conexoes)
+		pasta:Destroy()
+		table.clear(lista)
+	end
+	return api
+end
+
+return Infectados
