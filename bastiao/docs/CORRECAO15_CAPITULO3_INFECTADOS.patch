@@ -0,0 +1,146 @@
+--!strict
+-- PROJETO BASTIÃO :: Capítulo 3 — A Guarnição (parte 1).
+-- O elevador do capítulo 2 desce para o andar sem número: a Guarnição 7, a antiga unidade do Pavel.
+--   chegada (todos na cabine, fuzis entregues) -> alojamento -> o cartão do arsenal no corpo do
+--   tenente Orlov -> BLACKOUT: as grades caem e os soldados infectados atacam (estes morrem; o 731-A
+--   não) -> todos mortos (evento da criatura "infectados_mortos") -> luz vermelha de emergência ->
+--   leitor de cartão abre o arsenal -> fim da parte 1 (checkpoint fim_cap3a).
+-- juntar() recebe a campanha já com os capítulos 1 e 2 e não mexe neles no disco.
+
+local Capitulo03 = {}
+
+local function obj(texto: string?)
+	return { tipo = "objetivo", texto = texto }
+end
+local function ent(id: string, estado: string)
+	return { tipo = "entidade", id = id, estado = estado }
+end
+local function seq(id: string)
+	return { tipo = "sequencia", id = id }
+end
+local function copia(v: any): any
+	if type(v) ~= "table" then
+		return v
+	end
+	local t = {}
+	for k, x in v do
+		t[k] = copia(x)
+	end
+	return t
+end
+
+Capitulo03.flags = { card_taken = false, infected_cleared = false }
+
+Capitulo03.nodes = {
+	cap3_chegada = {
+		exits = {
+			{
+				event = "cap3_quartel",
+				kind = "zona",
+				to = "cap3_quartel",
+				effects = { obj("cartao"), ent("cartao3", "visivel"), ent("pavel4", "cap3_quartel"), seq("c3_quartel"), { tipo = "checkpoint", id = "cap3_quartel" } },
+			},
+		},
+	},
+	cap3_quartel = {
+		exits = {
+			{
+				event = "pegar_cartao",
+				kind = "interacao",
+				to = "cap3_onda",
+				set = { card_taken = true },
+				effects = { ent("cartao3", "pego"), ent("luz3", "apagada"), ent("infectados3", "acordados"), obj("sobreviver"), seq("c3_blackout") },
+			},
+		},
+	},
+	cap3_onda = {
+		exits = {
+			{
+				event = "infectados_mortos",
+				kind = "criatura",
+				to = "cap3_limpo",
+				set = { infected_cleared = true },
+				effects = { ent("luz3", "emergencia"), obj("arsenal"), seq("c3_limpo") },
+			},
+		},
+	},
+	cap3_limpo = {
+		exits = {
+			{
+				event = "abrir_arsenal",
+				kind = "interacao",
+				to = "cap3_arsenal",
+				effects = { ent("porta_arsenal", "aberta"), ent("pavel4", "cap3_arsenal"), obj(nil), seq("c3_arsenal") },
+			},
+		},
+	},
+	cap3_arsenal = {
+		exits = {
+			{ event = "c3_arsenal_fim", kind = "sequencia", to = "fim_etapa", effects = {} },
+		},
+	},
+}
+
+Capitulo03.sequences = {
+	c3_chegada = {
+		cues = {
+			{ t = 0.0, som = "portas" },
+			{ t = 2.6, fala = "pavel_c3_chegada" },
+		},
+	},
+	c3_quartel = {
+		cues = {
+			{ t = 0.4, fala = "pavel_c3_quartel" },
+		},
+	},
+	c3_blackout = {
+		cues = {
+			{ t = 0.0, som = "blackout" },
+			{ t = 1.2, fala = "pavel_c3_blackout" },
+		},
+	},
+	c3_limpo = {
+		cues = {
+			{ t = 0.8, fala = "pavel_c3_limpo" },
+		},
+	},
+	c3_arsenal = {
+		cues = {
+			{ t = 0.0, som = "trava", pos = { 5, -116, -223.7 } },
+			{ t = 1.4, fala = "pavel_c3_arsenal" },
+		},
+	},
+}
+
+-- campanha completa: capítulos 1 e 2 + a parte 1 do capítulo 3
+function Capitulo03.juntar(anterior: any): any
+	local def = copia(anterior)
+	def.id = "bastiao_cap01_cap03"
+	def.version = 4
+	for k, v in Capitulo03.flags do
+		def.flagSchema[k] = v
+	end
+	for id, no in Capitulo03.nodes do
+		assert(def.nodes[id] == nil, "nó repetido no capítulo 3: " .. id)
+		def.nodes[id] = copia(no)
+	end
+	for id, s in Capitulo03.sequences do
+		assert(def.sequences[id] == nil, "sequência repetida no capítulo 3: " .. id)
+		def.sequences[id] = copia(s)
+	end
+	-- a descida do elevador do capítulo 2 agora chega no andar sem número
+	local descida = def.nodes.cap2_descida
+	assert(descida and descida.exits and descida.exits[1] and descida.exits[1].event == "c2_descida_fim", "capítulo 2 mudou: c2_descida_fim")
+	descida.exits[1].to = "cap3_chegada"
+	descida.exits[1].effects = {
+		ent("elevador3", "chegou"), ent("armas3", "entregues"), ent("luz3", "acesa"), ent("infectados3", "dormindo"),
+		ent("cartao3", "escondido"), ent("porta_arsenal", "fechada"), ent("pavel4", "cap3_elevador"),
+		obj("cap3_explorar"), seq("c3_chegada"), { tipo = "checkpoint", id = "cap3_elevador" },
+	}
+	local fim = def.nodes.fim_etapa
+	assert(fim and fim.final, "campanha sem fim_etapa")
+	fim.onEnter = { ent("fim", "visivel"), { tipo = "checkpoint", id = "fim_cap3a" } }
+	return def
+end
+
+return Capitulo03
