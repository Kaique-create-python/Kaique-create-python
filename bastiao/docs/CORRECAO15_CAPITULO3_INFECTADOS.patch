+Infectados.VISAO_DORMINDO = 14
+Infectados.VISAO_ACORDADO = 70
+-- uniforme da guarnição (catálogo, os mesmos itens soviéticos que o Pavel usava) e pele doente
+local ROUPA = { camisa = 6865584651, calca = 6866147363 }
+local CHAPEUS = { "46348897", "" } -- ushanka (Roblox) em metade deles
+local MASCARA = "21069972" -- Dust Mask (Roblox) em alguns
+local PELE = Color3.fromRGB(118, 124, 104)
+local OLHOS = Color3.fromRGB(200, 255, 120)
+
+export type Opcoes = {
+	pasta: Instance,
+	aoTodosMortos: (() -> ())?,
+	log: ((string) -> ())?,
+}
+
+local function criarRig(): Model?
+	local base = StarterPlayer:FindFirstChild("StarterCharacter")
+	if base and base:IsA("Model") then
+		return base:Clone()
+	end
+	local ok, r = pcall(function()
+		return Players:CreateHumanoidModelFromDescription(Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R6)
+	end)
+	return if ok then r else nil
+end
+
+-- corpo mole: cada junta vira uma rótula com limite e o corpo cai de verdade
+local function ragdoll(m: Model)
+	for _, j in m:GetDescendants() do
+		if j:IsA("Motor6D") and j.Part0 and j.Part1 then
+			local a0 = Instance.new("Attachment")
+			a0.CFrame = j.C0
+			a0.Parent = j.Part0
+			local a1 = Instance.new("Attachment")
+			a1.CFrame = j.C1
+			a1.Parent = j.Part1
+			local b = Instance.new("BallSocketConstraint")
+			b.Attachment0 = a0
+			b.Attachment1 = a1
+			b.LimitsEnabled = true
+			b.UpperAngle = 55
+			b.TwistLimitsEnabled = true
+			b.TwistLowerAngle = -40
+			b.TwistUpperAngle = 40
+			b.Parent = j.Parent
+			j.Enabled = false
+		end
+	end
+	for _, p in m:GetDescendants() do
+		if p:IsA("BasePart") then
+			p.CanCollide = p.Name ~= "HumanoidRootPart"
+		end
+	end
+end
+
+function Infectados.iniciar(op: Opcoes)
+	local log = op.log or print
+	local api = {}
+	local lista: { any } = {}
+	local conexoes: { RBXScriptConnection } = {}
+	local vivo = true
+	local ondaAtiva = false
+	local avisouFim = false
