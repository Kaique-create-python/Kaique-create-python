+
+	-- ===== alojamento: beliches, armários, grades de ventilação e o tenente =====
+	for _, x in { -18, 18 } do
+		for k = 0, 4 do
+			local z = -170 - k * 7.4
+			local base = CFrame.new(x, PISO, z)
+			for _, c in { { -0.9, -2.9 }, { 0.9, -2.9 }, { -0.9, 2.9 }, { 0.9, 2.9 } } do
+				peca(pasta, "BastiaoBelichePe", V(0.2, 6, 0.2), base * CFrame.new(c[1], 3, c[2]), METAL_ESCURO, Enum.Material.Metal, false)
+			end
+			for _, y in { 1.2, 4.4 } do
+				peca(pasta, "BastiaoBelicheEstrado", V(2, 0.2, 6), base * CFrame.new(0, y, 0), METAL, Enum.Material.Metal)
+				peca(pasta, "BastiaoColchao", V(1.9, 0.45, 5.8), base * CFrame.new(0, y + 0.32, 0) * CFrame.Angles(0, math.rad((k * 3) % 7 - 3), 0), Color3.fromRGB(96, 104, 82), Enum.Material.Fabric)
+			end
+		end
+	end
