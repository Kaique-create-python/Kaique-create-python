+	d.Face = face
+	d.Color3 = Color3.fromRGB(90, 10, 10)
+	d.Transparency = transp or 0.1
+	d.Parent = pai
+end
+
+-- sala retangular: piso, teto e quatro paredes (com vãos de porta de 8 de largura onde pedir)
+local function jogadores(): { Player }
+	local ok, l = pcall(function()
+		return Players:GetPlayers()
+	end)
+	return if ok and type(l) == "table" then l else {}
+end
+
+local function sala(pai: Instance, nome: string, x0: number, x1: number, z0: number, z1: number, altura: number, vaos: { [string]: number })
+	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
+	local lx, lz = x1 - x0, z1 - z0
+	peca(pai, nome .. "Piso", V(lx, 1, lz), CFrame.new(cx, PISO - 0.5, cz), CONCRETO_ESCURO)
+	peca(pai, nome .. "Teto", V(lx, 1, lz), CFrame.new(cx, PISO + altura + 0.5, cz), CONCRETO_ESCURO)
+	local function parede(lado: string, a0: number, a1: number, fixo: number, eixoX: boolean)
+		local vao = vaos[lado]
+		local trechos = if vao then { { a0, vao - 4 }, { vao + 4, a1 } } else { { a0, a1 } }
+		for _, t in trechos do
+			local comp = t[2] - t[1]
+			if comp > 0.05 then
+				local meio = (t[1] + t[2]) / 2
+				local tam = if eixoX then V(comp, altura, 1) else V(1, altura, comp)
+				local cf = if eixoX then CFrame.new(meio, PISO + altura / 2, fixo) else CFrame.new(fixo, PISO + altura / 2, meio)
+				peca(pai, nome .. "Parede", tam, cf, CONCRETO)
+				-- metade de baixo pintada (padrão de quartel soviético)
+				local tamP = if eixoX then V(comp, 3.2, 1.06) else V(1.06, 3.2, comp)
+				local cfP = if eixoX then CFrame.new(meio, PISO + 1.6, fixo) else CFrame.new(fixo, PISO + 1.6, meio)
+				peca(pai, nome .. "Barrado", tamP, cfP, PINTURA, Enum.Material.SmoothPlastic, false)
+			end
+		end
+		if vao and altura > 8 then
+			local tamV = if eixoX then V(8, altura - 8, 1) else V(1, altura - 8, 8)
+			local cfV = if eixoX then CFrame.new(vao, PISO + 8 + (altura - 8) / 2, fixo) else CFrame.new(fixo, PISO + 8 + (altura - 8) / 2, vao)
+			peca(pai, nome .. "Verga", tamV, cfV, CONCRETO)
+		end
+	end
+	parede("norte", x0, x1, z1 + 0.5, true)
+	parede("sul", x0, x1, z0 - 0.5, true)
+	parede("oeste", z0, z1, x0 - 0.5, false)
+	parede("leste", z0, z1, x1 + 0.5, false)
+end
+
