-- Generated installer: run in Studio Command Bar while NOT playing.
-- Replaces only Sector7-owned folders, map and StarterCharacter.
assert(not game:GetService('RunService'):IsRunning(), 'Stop Play before installing')
local RS=game:GetService('ReplicatedStorage');local SS=game:GetService('ServerScriptService');local SP=game:GetService('StarterPlayer')
for _,p in {RS,SS} do local old=p:FindFirstChild('Sector7');if old then old:Destroy() end local f=Instance.new('Folder');f.Name='Sector7';f.Parent=p end
local client=SP.StarterPlayerScripts:FindFirstChild('Sector7Client');if client then client:Destroy() end
do local s=Instance.new('ModuleScript');s.Name="Config";s.Source="-- All balance and camera values live here. No paid assets required.\nreturn table.freeze({\n    WalkSpeed = 10,\n    SprintSpeed = 18,\n    MaxStamina = 100,\n    DrainRate = 22,\n    RegenRate = 16,\n    RegenDelay = 1.5,\n    RestartThreshold = 30,\n    InteractionDistance = 14,\n    ThreatSpeed = 8,\n    ThreatChaseSpeed = 13,\n    ThreatRange = 55,\n    ThreatDamage = 24,\n    ThreatHitCooldown = 1.4,\n    Camera = table.freeze({BaseFov=74, SprintFov=80, BobStrength=0.045, MaxBlur=4}),\n    Animations = table.freeze({Walk=\"\", Run=\"\", Idle=\"\"}),\n})\n";s.Parent=RS.Sector7 end
do local s=Instance.new('ModuleScript');s.Name="Stamina";s.Source="-- Pure simulation: the server owns this state, the HUD only observes it.\nlocal Stamina = {}\nfunction Stamina.new(config)\n    return {value=config.MaxStamina, running=false, exhausted=false, rest=0}\nend\nfunction Stamina.step(state, wantsSprint, moving, allowed, dt, config)\n    dt = math.max(0, dt)\n    local running = allowed and wantsSprint and moving and not state.exhausted and state.value > 0\n    if running then\n        state.rest = 0\n        state.value = math.max(0, state.value - config.DrainRate * dt)\n        if state.value <= 0 then state.exhausted = true; running = false end\n    else\n        state.rest += dt\n        if state.rest >= config.RegenDelay then\n            state.value = math.min(config.MaxStamina, state.value + config.RegenRate * dt)\n        end\n        if state.exhausted and state.value >= config.RestartThreshold then state.exhausted = false end\n    end\n    state.running = running\n    return state\nend\nreturn Stamina\n";s.Parent=RS.Sector7 end
do local s=Instance.new('ModuleScript');s.Name="Mission";s.Source="local Mission = {}\nfunction Mission.new()\n    return {collected={},fuses=0,power=false,keycard=false,escaped=false}\nend\nfunction Mission.attempt(state, id)\n    if id == \"Fuse1\" or id == \"Fuse2\" or id == \"Fuse3\" then\n        if state.collected[id] then return false, \"Este fusível já foi recolhido.\" end\n        state.collected[id] = true\n        state.fuses += 1\n        return true, \"Fusível recuperado. \" .. state.fuses .. \"/3\"\n    elseif id == \"Generator\" then\n        if state.power then return false, \"O gerador já está funcionando.\" end\n        if state.fuses < 3 then return false, \"Encontre os três fusíveis antes de ligar o gerador.\" end\n        state.power = true\n        return true, \"Energia restaurada. Procure o cartão no arquivo. Algo acordou nos túneis.\"\n    elseif id == \"Keycard\" then\n        if not state.power then return false, \"O arquivo está sem energia. Restaure o gerador.\" end\n        if state.keycard then return false, \"O cartão já foi recuperado.\" end\n        state.keycard = true\n        return true, \"Cartão de evacuação recuperado. Siga até a porta do Setor 7.\"\n    elseif id == \"Exit\" then\n        if state.escaped then return false, \"A saída já está aberta. Atravesse para evacuar.\" end\n        if not state.power or not state.keycard then return false, \"A saída precisa de energia e do cartão de evacuação.\" end\n        state.escaped = true\n        return true, \"A porta foi liberada. Atravesse para evacuar.\"\n    end\n    return false, \"Interação desconhecida.\"\nend\nreturn Mission\n";s.Parent=SS.Sector7 end
do local s=Instance.new('Script');s.Name="Server";s.Source="local Players=game:GetService(\"Players\")\nlocal ReplicatedStorage=game:GetService(\"ReplicatedStorage\")\nlocal RunService=game:GetService(\"RunService\")\nlocal Lighting=game:GetService(\"Lighting\")\n-- Portable XML place uses ObjectValue references to restore authored attributes.\nlocal manifest=script.Parent:FindFirstChild(\"AttributeManifest\")\nif manifest then\n    for _,entry in manifest:GetChildren() do\n        if entry:IsA(\"ObjectValue\") and entry.Value and entry:FindFirstChild(\"Data\") then\n            local data=game:GetService(\"HttpService\"):JSONDecode(entry.Data.Value)\n            for key,value in pairs(data) do entry.Value:SetAttribute(key,value) end\n        end\n    end\nend\nlocal shared=ReplicatedStorage:WaitForChild(\"Sector7\")\nlocal Config=require(shared.Config)\nlocal Stamina=require(shared.Stamina)\nlocal Mission=require(script.Parent.Mission)\nlocal Threat=require(script.Parent.Threat)\nlocal WorldBuilder=require(script.Parent.WorldBuilder)\n\nlocal remotes=shared:FindFirstChild(\"Remotes\") or Instance.new(\"Folder\")\nremotes.Name=\"Remotes\";remotes.Parent=shared\nlocal function remote(name)\n    local r=remotes:FindFirstChild(name) or Instance.new(\"RemoteEvent\")\n    r.Name=name;r.Parent=remotes\n    return r\nend\nlocal sprint=remote(\"Sprint\")\nlocal flashlight=remote(\"Flashlight\")\nlocal feedback=remote(\"Feedback\")\nlocal world=workspace:FindFirstChild(\"Sector7World\") or WorldBuilder.Build()\nlocal mission=Mission.new()\nlocal states={}\nlocal function publish()\n    workspace:SetAttribute(\"S7Fuses\",mission.fuses)\n    workspace:SetAttribute(\"S7Power\",mission.power)\n    workspace:SetAttribute(\"S7Keycard\",mission.keycard)\n    workspace:SetAttribute(\"S7Escaped\",mission.escaped)\nend\npublish()\nLighting.ClockTime=0\nLighting.Brightness=1\nLighting.Ambient=Color3.fromRGB(18,21,23)\nLighting.OutdoorAmbient=Color3.fromRGB(12,14,16)\nLighting.FogColor=Color3.fromRGB(15,19,20)\nLighting.FogStart=35;Lighting.FogEnd=145\nlocal grade=Lighting:FindFirstChild(\"Sector7Grade\") or Instance.new(\"ColorCorrectionEffect\")\ngrade.Name=\"Sector7Grade\";grade.Saturation=-.35;grade.Contrast=.12;grade.Brightness=-.025;grade.Parent=Lighting\n\nlocal function send(player,text,title,kind)\n    feedback:FireClient(player,{kind=kind or \"notice\",title=title or \"SETOR 7\",text=text})\nend\nlocal function characterAdded(player,character)\n    local state=states[player]\n    if not state then return end\n    state.stamina=Stamina.new(Config);state.wants=false\n    player:SetAttribute(\"Escaped\",false)\n    player:SetAttribute(\"Stamina\",Config.MaxStamina)\n    player:SetAttribute(\"Sprinting\",false);player:SetAttribute(\"Exhausted\",false)\n    player:SetAttribute(\"FlashlightOn\",true)\n    local humanoid=character:WaitForChild(\"Humanoid\",10)\n    local root=character:WaitForChild(\"HumanoidRootPart\",10)\n    if not humanoid or not root then return end\n    if humanoid.RigType~=Enum.HumanoidRigType.R6 then\n        warn(\"[Sector7] R6 StarterCharacter required; run installer.\")\n    end\n    humanoid.WalkSpeed=Config.WalkSpeed;humanoid.JumpPower=32\n    humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None\n    character:PivotTo(CFrame.new(0,4,12))\n    humanoid.Died:Connect(function()\n        state.wants=false\n        player:SetAttribute(\"Sprinting\",false)\n    end)\n    -- Server-owned flashlight is visible to other players too.\n    local head=character:FindFirstChild(\"Head\") or root\n    local light=Instance.new(\"SpotLight\")\n    light.Name=\"Sector7Flashlight\";light.Angle=80;light.Range=48\n    light.Brightness=2.8;light.Color=Color3.fromRGB(221,226,202)\n    light.Face=Enum.NormalId.Front;light.Shadows=false;light.Parent=head\n    task.delay(2,function()\n        if player.Parent then send(player,\"Encontre três fusíveis. Ligue o gerador, recupere o cartão e escape.\",\"17 NOV 1989 · INSTALAÇÃO 7\") end\n    end)\nend\nlocal function playerAdded(player)\n    states[player]={stamina=Stamina.new(Config),wants=false,lastSprint=0,lastFlash=0,lastInteract=0}\n    player.CharacterAdded:Connect(function(c) characterAdded(player,c) end)\n    if player.Character then task.spawn(characterAdded,player,player.Character) end\nend\nPlayers.PlayerAdded:Connect(playerAdded)\nfor _,p in Players:GetPlayers() do playerAdded(p) end\nPlayers.PlayerRemoving:Connect(function(p) states[p]=nil end)\nsprint.OnServerEvent:Connect(function(player,value)\n    local state=states[player]\n    if not state or typeof(value)~=\"boolean\" then return end\n    local now=os.clock()\n    -- Always accept release so a quick tap cannot latch sprint on.\n    if value and state.wants and now-state.lastSprint<.08 then return end\n    state.lastSprint=now;state.wants=value\nend)\nflashlight.OnServerEvent:Connect(function(player,value)\n    local state=states[player]\n    if not state or typeof(value)~=\"boolean\" or os.clock()-state.lastFlash<.15 then return end\n    state.lastFlash=os.clock()\n    player:SetAttribute(\"FlashlightOn\",value)\n    local c=player.Character\n    local light=c and c:FindFirstChild(\"Sector7Flashlight\",true)\n    if light then light.Enabled=value end\nend)\n\nlocal notes={\n    Note1={\"ORDEM DE MANUTENÇÃO\",\"17 de novembro de 1989. Três fusíveis foram retirados: um no depósito, outro na sala de máquinas e o último no arquivo. Reponha os três no circuito antes de tentar ligar o gerador. A porta de evacuação continua sem energia.\"},\n    Note2={\"REGISTRO DE ESCUTA\",\"O sinal voltou às 02h17. Não veio da antena. Veio dos canos. A voz repetiu nossos nomes na ordem do livro de presença. Se ouvir alguém chamando no túnel vazio, mantenha a lanterna acesa e continue andando.\"},\n    Note3={\"PROTOCOLO DO ARQUIVO\",\"Depois de restabelecer a energia, retire o cartão de acesso do arquivo. O leitor da saída só libera a porta com o gerador ligado e o cartão recuperado. Não abra a sala de escuta.\"},\n    Note4={\"ÚLTIMA TRANSMISSÃO\",\"Apagamos a frequência e a voz continuou. Morozov correu até ficar sem ar; ela o alcançou no escuro. Caminhe quando puder. Guarde fôlego para a saída. Se a porta abrir, não espere pelo último sinal.\"},\n}\nlocal function escaped(player)\n    if player:GetAttribute(\"Escaped\") then return end\n    player:SetAttribute(\"Escaped\",true)\n    local state=states[player];if state then state.wants=false end\n    send(player,\"Você saiu. Às suas costas, o rádio repete seu nome. Fim da base jogável — SETOR 7: O Último Sinal.\",\"EVACUAÇÃO CONCLUÍDA\",\"escape\")\nend\nlocal function interact(player,part,prompt)\n    local state=states[player]\n    local c=player.Character\n    local root=c and c:FindFirstChild(\"HumanoidRootPart\")\n    local h=c and c:FindFirstChildOfClass(\"Humanoid\")\n    if not state or not root or not h or h.Health<=0 or player:GetAttribute(\"Escaped\") then return end\n    if (root.Position-part.Position).Magnitude>Config.InteractionDistance then return end\n    if os.clock()-state.lastInteract<.25 then return end\n    -- Geometry check prevents prompt calls through the side-room walls.\n    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={c}\n    local hit=workspace:Raycast(root.Position,part.Position-root.Position,params)\n    if hit and hit.Instance~=part and not hit.Instance:IsDescendantOf(part) then return end\n    state.lastInteract=os.clock()\n    local id=part:GetAttribute(\"InteractionId\")\n    if notes[id] then send(player,notes[id][2],notes[id][1],\"note\");return end\n    local ok,message=Mission.attempt(mission,id)\n    if not ok then send(player,message);return end\n    publish()\n    if string.sub(id,1,4)==\"Fuse\" or id==\"Keycard\" then\n        prompt.Enabled=false;part.Transparency=1;part.CanCollide=false\n        for _,v in part:GetDescendants() do\n            if v:IsA(\"BasePart\") then v.Transparency=1;v.CanCollide=false end\n        end\n    elseif id==\"Generator\" then\n        prompt.Enabled=false\n        for _,v in world:GetDescendants() do\n            if v:IsA(\"PointLight\") and v:GetAttribute(\"PowerLight\") then v.Brightness=1.8;v.Color=Color3.fromRGB(207,208,166) end\n        end\n    elseif id==\"Exit\" then\n        local door=world:FindFirstChild(\"ExitDoor\",true)\n        if door and door:IsA(\"BasePart\") then\n            door.CanCollide=false;prompt.Enabled=false\n            game:GetService(\"TweenService\"):Create(door,TweenInfo.new(1.8),{CFrame=door.CFrame+Vector3.new(0,11,0)}):Play()\n        end\n    end\n    feedback:FireAllClients({kind=\"notice\",title=\"OBJETIVO ATUALIZADO\",text=message})\nend\nfor _,part in world:GetDescendants() do\n    if part:IsA(\"BasePart\") and part:GetAttribute(\"InteractionId\") then\n        local prompt=part:FindFirstChildOfClass(\"ProximityPrompt\")\n        if prompt then prompt.Triggered:Connect(function(p) interact(p,part,prompt) end) end\n    end\nend\nlocal accumulator=0\nRunService.Heartbeat:Connect(function(dt)\n    dt=math.min(dt,.25);accumulator+=dt\n    local update=accumulator>=.1\n    if update then accumulator=0 end\n    for player,state in pairs(states) do\n        local c=player.Character\n        local h=c and c:FindFirstChildOfClass(\"Humanoid\")\n        local root=c and c:FindFirstChild(\"HumanoidRootPart\")\n        local allowed=h and h.Health>0 and not player:GetAttribute(\"Escaped\")\n        -- MoveDirection is not server-replicated reliably; horizontal velocity is.\n        local moving=root and (root.AssemblyLinearVelocity*Vector3.new(1,0,1)).Magnitude>1\n        Stamina.step(state.stamina,state.wants,moving,allowed,dt,Config)\n        if h then h.WalkSpeed=state.stamina.running and Config.SprintSpeed or Config.WalkSpeed end\n        if update then\n            player:SetAttribute(\"Stamina\",math.round(state.stamina.value*10)/10)\n            player:SetAttribute(\"Sprinting\",state.stamina.running)\n            player:SetAttribute(\"Exhausted\",state.stamina.exhausted)\n            if allowed and mission.escaped and root then\n                local zone=world:FindFirstChild(\"ExitZone\")\n                if zone then\n                    local p=zone.CFrame:PointToObjectSpace(root.Position)\n                    local half=zone.Size*.5\n                    if math.abs(p.X)<half.X and math.abs(p.Y)<half.Y and math.abs(p.Z)<half.Z then escaped(player) end\n                end\n            end\n        end\n    end\nend)\nThreat.start(world,Config,feedback)\nprint(\"[Sector7] Ready — R6 / cooperative session / validated prompts\")\n";s.Parent=SS.Sector7 end
do local s=Instance.new('ModuleScript');s.Name="Threat";s.Source="-- Small, deterministic threat. Server raycasts prevent seeing/hitting through walls.\nlocal Players = game:GetService(\"Players\")\nlocal Threat = {}\nfunction Threat.start(world, config, feedback)\n    local model = Instance.new(\"Model\")\n    model.Name = \"TheListener\"\n    local function part(name, size, offset, color)\n        local p = Instance.new(\"Part\")\n        p.Name=name; p.Size=size; p.CFrame=CFrame.new(offset)\n        p.Color=color; p.Material=Enum.Material.Slate; p.Anchored=true\n        p.CanCollide=false; p.CanTouch=false; p.Parent=model\n        return p\n    end\n    local dark=Color3.fromRGB(24,27,25)\n    local core=part(\"Body\",Vector3.new(2.2,3.5,1.2),Vector3.new(0,4,0),dark)\n    part(\"Head\",Vector3.new(1.2,1.7,1.1),Vector3.new(0,6.4,0),dark)\n    part(\"ArmL\",Vector3.new(.55,4,.6),Vector3.new(-1.5,3.7,0),dark)\n    part(\"ArmR\",Vector3.new(.55,4,.6),Vector3.new(1.5,3.7,0),dark)\n    part(\"LegL\",Vector3.new(.7,2.8,.8),Vector3.new(-.6,1.5,0),dark)\n    part(\"LegR\",Vector3.new(.7,2.8,.8),Vector3.new(.6,1.5,0),dark)\n    for _,x in ipairs({-.28,.28}) do\n        local eye=part(\"Eye\",Vector3.new(.12,.12,.08),Vector3.new(x,6.5,-.57),Color3.fromRGB(200,165,102))\n        eye.Material=Enum.Material.Neon\n    end\n    model.PrimaryPart=core\n    model.Parent=world\n    local nodes=world:FindFirstChild(\"CreatureNodes\")\n    local route=nodes and nodes:GetChildren() or {}\n    table.sort(route,function(a,b) return a.Name<b.Name end)\n    local position=Vector3.new(0,0,-160)\n    local index=1\n    local lastHit,lastScare={},{}\n    local params=RaycastParams.new()\n    params.FilterType=Enum.RaycastFilterType.Exclude\n    params.FilterDescendantsInstances={model}\n    local function visible(character, root)\n        local origin=position+Vector3.new(0,4,0)\n        local hit=workspace:Raycast(origin,root.Position-origin,params)\n        return not hit or hit.Instance:IsDescendantOf(character)\n    end\n    task.spawn(function()\n        while model.Parent do\n            local dt=task.wait(.1)\n            if not workspace:GetAttribute(\"S7Power\") then\n                model:PivotTo(CFrame.new(0,-100,-160))\n                continue\n            end\n            local target,nearest=nil,config.ThreatRange\n            for _,player in Players:GetPlayers() do\n                local c=player.Character\n                local root=c and c:FindFirstChild(\"HumanoidRootPart\")\n                local h=c and c:FindFirstChildOfClass(\"Humanoid\")\n                if root and h and h.Health>0 and not player:GetAttribute(\"Escaped\") then\n                    local distance=(root.Position-(position+Vector3.new(0,3,0))).Magnitude\n                    if distance<nearest and visible(c,root) then target=player;nearest=distance end\n                end\n            end\n            local goal\n            if target then\n                local targetRoot=target.Character and target.Character:FindFirstChild(\"HumanoidRootPart\")\n                if targetRoot then goal=targetRoot.Position*Vector3.new(1,0,1) end\n                local now=os.clock()\n                if now-(lastScare[target] or -99)>12 then\n                    lastScare[target]=now\n                    feedback:FireClient(target,{kind=\"scare\",title=\"ELE ESTÁ OUVINDO\",text=\"Guarde fôlego. Quebre a linha de visão.\"})\n                end\n                if nearest<4.5 and now-(lastHit[target] or -99)>config.ThreatHitCooldown then\n                    lastHit[target]=now\n                    target.Character:FindFirstChildOfClass(\"Humanoid\"):TakeDamage(config.ThreatDamage)\n                end\n            elseif #route>0 then\n                goal=route[index].Position*Vector3.new(1,0,1)\n                if (goal-position).Magnitude<2 then index=index%#route+1 end\n            end\n            if goal then\n                local delta=goal-position\n                local distance=delta.Magnitude\n                if distance>.1 then\n                    local step=delta.Unit*math.min(distance,(target and config.ThreatChaseSpeed or config.ThreatSpeed)*math.min(dt,.25))\n                    local hit=workspace:Raycast(position+Vector3.new(0,3,0),step.Unit*(step.Magnitude+1.1),params)\n                    if not hit or (target and hit.Instance:IsDescendantOf(target.Character)) then\n                        position+=step\n                    elseif not target then index=index%math.max(#route,1)+1 end\n                    -- Model pivot is its original bounding-box center, about y=3.5.\n                    model:PivotTo(CFrame.lookAt(position+Vector3.new(0,3.5,0),position+Vector3.new(step.X,3.5,step.Z)))\n                end\n            end\n        end\n    end)\nend\nreturn Threat\n";s.Parent=SS.Sector7 end
do local s=Instance.new('ModuleScript');s.Name="WorldBuilder";s.Source="--!strict\n-- Deterministic, asset-free bunker. No signs or environmental lettering.\n-- Geometry stays owned by Sector7World.\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal WorldBuilder = {}\n\nlocal WORLD_NAME = \"Sector7World\"\nlocal BUILD_VERSION = 1\nlocal MAIN_MIN_Z = -202\nlocal MAIN_MAX_Z = 24\nlocal CONCRETE = Color3.fromRGB(76, 80, 77)\nlocal PALE_CONCRETE = Color3.fromRGB(91, 92, 83)\nlocal DARK_CONCRETE = Color3.fromRGB(48, 53, 51)\nlocal STEEL = Color3.fromRGB(47, 54, 52)\nlocal RUST = Color3.fromRGB(91, 54, 35)\nlocal DULL_GREEN = Color3.fromRGB(61, 72, 55)\nlocal PAPER = Color3.fromRGB(169, 158, 119)\nlocal AMBER = Color3.fromRGB(255, 185, 96)\nlocal RED = Color3.fromRGB(194, 53, 39)\n\ntype RoomDefinition = {\n\tname: string,\n\tside: number,\n\tz: number,\n}\n\nlocal ROOMS: { RoomDefinition } = {\n\t{ name = \"Workshop\", side = -1, z = -38 },\n\t{ name = \"GeneratorRoom\", side = 1, z = -92 },\n\t{ name = \"Archive\", side = -1, z = -142 },\n}\n\nfunction WorldBuilder.Build(): Model\n\tlocal previous = Workspace:FindFirstChild(WORLD_NAME)\n\tif previous then\n\t\tassert(previous:IsA(\"Model\") and previous:GetAttribute(\"Sector7Owned\") == true,\n\t\t\t\"Sector7World already exists and is not owned by WorldBuilder\")\n\t\tprevious:Destroy()\n\tend\n\n\tlocal world = Instance.new(\"Model\")\n\tworld.Name = WORLD_NAME\n\tworld:SetAttribute(\"Sector7Owned\", true)\n\tworld:SetAttribute(\"BuildVersion\", BUILD_VERSION)\n\tworld:SetAttribute(\"Ready\", false)\n\t-- Parent early and yield during creation so Studio does not receive one huge update.\n\tworld.Parent = Workspace\n\n\tlocal geometry = Instance.new(\"Folder\")\n\tgeometry.Name = \"Structure\"\n\tgeometry.Parent = world\n\tlocal details = Instance.new(\"Folder\")\n\tdetails.Name = \"Details\"\n\tdetails.Parent = world\n\tlocal interactions = Instance.new(\"Folder\")\n\tinteractions.Name = \"Interactions\"\n\tinteractions.Parent = world\n\tlocal lamps = Instance.new(\"Folder\")\n\tlamps.Name = \"Lamps\"\n\tlamps.Parent = world\n\tlocal nodes = Instance.new(\"Folder\")\n\tnodes.Name = \"CreatureNodes\"\n\tnodes.Parent = world\n\n\tlocal random = Random.new(7131989)\n\tlocal partCount = 0\n\n\tlocal function part(\n\t\tname: string,\n\t\tsize: Vector3,\n\t\ttransform: CFrame,\n\t\tcolor: Color3,\n\t\tmaterial: Enum.Material?,\n\t\tparent: Instance?,\n\t\tcollidable: boolean?\n\t): Part\n\t\tlocal result = Instance.new(\"Part\")\n\t\tresult.Name = name\n\t\tresult.Size = size\n\t\tresult.CFrame = transform\n\t\tresult.Color = color\n\t\tresult.Material = material or Enum.Material.Concrete\n\t\tresult.Anchored = true\n\t\tresult.CanCollide = collidable ~= false\n\t\tresult.TopSurface = Enum.SurfaceType.Smooth\n\t\tresult.BottomSurface = Enum.SurfaceType.Smooth\n\t\tresult.CastShadow = true\n\t\tresult.Parent = parent or details\n\t\tpartCount += 1\n\t\tif partCount % 180 == 0 then\n\t\t\ttask.wait()\n\t\tend\n\t\treturn result\n\tend\n\n\tlocal function block(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?, parent: Instance?, collidable: boolean?): Part\n\t\treturn part(name, size, CFrame.new(position), color, material, parent, collidable)\n\tend\n\n\tlocal function cylinder(name: string, center: Vector3, length: number, diameter: number, axis: string, color: Color3, parent: Instance?): Part\n\t\tlocal rotation = CFrame.identity\n\t\tif axis == \"Y\" then\n\t\t\trotation = CFrame.Angles(0, 0, math.pi / 2)\n\t\telseif axis == \"Z\" then\n\t\t\trotation = CFrame.Angles(0, math.pi / 2, 0)\n\t\tend\n\t\tlocal result = part(name, Vector3.new(length, diameter, diameter), CFrame.new(center) * rotation, color, Enum.Material.Metal, parent, false)\n\t\tresult.Shape = Enum.PartType.Cylinder\n\t\treturn result\n\tend\n\n\tlocal function interact(target: BasePart, id: string, action: string, object: string, duration: number)\n\t\ttarget:SetAttribute(\"InteractionId\", id)\n\t\tlocal prompt = Instance.new(\"ProximityPrompt\")\n\t\tprompt.Name = \"Interact\"\n\t\tprompt.ActionText = action\n\t\tprompt.ObjectText = object\n\t\tprompt.KeyboardKeyCode = Enum.KeyCode.E\n\t\tprompt.GamepadKeyCode = Enum.KeyCode.ButtonX\n\t\tprompt.MaxActivationDistance = 9\n\t\tprompt.HoldDuration = duration\n\t\tprompt.RequiresLineOfSight = true\n\t\tprompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton\n\t\tprompt.Parent = target\n\tend\n\n\tlocal function tableProp(name: string, position: Vector3, width: number, depth: number)\n\t\tblock(name .. \"Top\", Vector3.new(width, 0.22, depth), position + Vector3.new(0, 2.65, 0), DULL_GREEN, Enum.Material.Metal)\n\t\tfor _, x in { -1, 1 } do\n\t\t\tfor _, z in { -1, 1 } do\n\t\t\t\tblock(name .. \"Leg\", Vector3.new(0.16, 2.55, 0.16), position + Vector3.new(x * (width / 2 - 0.2), 1.3, z * (depth / 2 - 0.2)), STEEL, Enum.Material.Metal)\n\t\t\tend\n\t\tend\n\tend\n\n\tlocal function note(id: string, position: Vector3, rotation: CFrame?)\n\t\tlocal paper = part(id, Vector3.new(1.25, 0.045, 1.65), CFrame.new(position) * (rotation or CFrame.identity), PAPER, Enum.Material.SmoothPlastic, interactions, false)\n\t\tinteract(paper, id, \"Ler registro\", \"Registro \" .. string.sub(id, 5), 0.1)\n\t\t-- Deliberately no narrative text here: Server is the authority for note content.\n\t\tfor index = 1, 4 do\n\t\t\tpart(\"Ink\", Vector3.new(0.78 - (index % 2) * 0.18, 0.006, 0.025), paper.CFrame * CFrame.new(0, 0.027, -0.45 + index * 0.2), Color3.fromRGB(73, 71, 59), Enum.Material.SmoothPlastic, details, false)\n\t\tend\n\tend\n\n\tlocal function fuse(id: string, position: Vector3)\n\t\tblock(id .. \"Tray\", Vector3.new(2.0, 0.12, 1.4), position - Vector3.new(0, 0.3, 0), STEEL, Enum.Material.Metal)\n\t\tlocal pickup = cylinder(id, position, 1.2, 0.42, \"X\", Color3.fromRGB(171, 142, 77), interactions)\n\t\tpickup.Material = Enum.Material.Glass\n\t\tpickup.Transparency = 0.13\n\t\tfor _, offset in { -0.48, 0.48 } do\n\t\t\tcylinder(id .. \"End\", position + Vector3.new(offset, 0, 0), 0.2, 0.46, \"X\", Color3.fromRGB(104, 112, 103), pickup)\n\t\tend\n\t\t-- Child decoration disappears with the authoritative collected Part.\n\t\tinteract(pickup, id, \"Coletar fusível\", \"Fusível cerâmico\", 0.25)\n\tend\n\n\tlocal function cagedLamp(name: string, position: Vector3, side: number, emergency: boolean?)\n\t\tlocal fixture = Instance.new(\"Model\")\n\t\tfixture.Name = name\n\t\tfixture.Parent = lamps\n\t\tblock(\"WallBracket\", Vector3.new(0.8, 0.18, 0.16), position + Vector3.new(side * 0.32, 0.4, 0), STEEL, Enum.Material.Metal, fixture, false)\n\t\tlocal bulb = block(\"Bulb\", Vector3.new(0.34, 0.62, 0.34), position, if emergency then RED else AMBER, Enum.Material.Neon, fixture, false)\n\t\tbulb:SetAttribute(\"BackupLight\", true)\n\t\tlocal light = Instance.new(\"PointLight\")\n\t\tlight.Name = \"BunkerLight\"\n\t\tlight.Color = bulb.Color\n\t\tlight.Brightness = if emergency then 0.65 else 0.95\n\t\tlight.Range = if emergency then 17 else 23\n\t\tlight.Shadows = true\n\t\tlight:SetAttribute(\"PowerLight\", true)\n\t\tlight.Parent = bulb\n\t\tfor _, y in { -0.4, 0.4 } do\n\t\t\tblock(\"CageRing\", Vector3.new(0.66, 0.09, 0.66), position + Vector3.new(0, y, 0), STEEL, Enum.Material.Metal, fixture, false)\n\t\tend\n\t\tfor _, x in { -0.28, 0.28 } do\n\t\t\tfor _, z in { -0.28, 0.28 } do\n\t\t\t\tblock(\"CageBar\", Vector3.new(0.045, 0.8, 0.045), position + Vector3.new(x, 0, z), STEEL, Enum.Material.Metal, fixture, false)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Continuous floor, with no steps between corridor and side-room thresholds.\n\tblock(\"TunnelFloor\", Vector3.new(16, 0.8, MAIN_MAX_Z - MAIN_MIN_Z), Vector3.new(0, -0.4, (MAIN_MAX_Z + MAIN_MIN_Z) / 2), DARK_CONCRETE, Enum.Material.Concrete, geometry)\n\tblock(\"RearBulkhead\", Vector3.new(16.7, 12, 0.9), Vector3.new(0, 6, MAIN_MAX_Z), CONCRETE, Enum.Material.Concrete, geometry)\n\tblock(\"EvacuationEndWall\", Vector3.new(16.7, 12, 0.9), Vector3.new(0, 6, MAIN_MIN_Z), CONCRETE, Enum.Material.Concrete, geometry)\n\n\t-- Cut actual holes in each side wall. There is no invisible wall across a room entry.\n\tfor _, side in { -1, 1 } do\n\t\tlocal openings: { { lo: number, hi: number } } = {}\n\t\tfor _, room in ROOMS do\n\t\t\tif room.side == side then\n\t\t\t\ttable.insert(openings, { lo = room.z - 5.5, hi = room.z + 5.5 })\n\t\t\tend\n\t\tend\n\t\ttable.sort(openings, function(a, b) return a.lo < b.lo end)\n\t\tlocal cursor = MAIN_MIN_Z\n\t\tfor _, opening in openings do\n\t\t\tblock(\"TunnelSideWall\", Vector3.new(0.8, 7.2, opening.lo - cursor), Vector3.new(side * 8.35, 3.6, (cursor + opening.lo) / 2), CONCRETE, Enum.Material.Concrete, geometry)\n\t\t\tcursor = opening.hi\n\t\tend\n\t\tblock(\"TunnelSideWall\", Vector3.new(0.8, 7.2, MAIN_MAX_Z - cursor), Vector3.new(side * 8.35, 3.6, (cursor + MAIN_MAX_Z) / 2), CONCRETE, Enum.Material.Concrete, geometry)\n\tend\n\n\t-- The upper half-circle is built from broad concrete facets, not dense mesh detail.\n\tlocal sectionLength = 10\n\tlocal sectionZ = MAIN_MIN_Z\n\twhile sectionZ < MAIN_MAX_Z do\n\t\tlocal depth = math.min(sectionLength, MAIN_MAX_Z - sectionZ)\n\t\tlocal z = sectionZ + depth / 2\n\t\tfor slice = 0, 11 do\n\t\t\tlocal angle = (slice + 0.5) * math.pi / 12\n\t\t\tlocal center = Vector3.new(math.cos(angle) * 8.05, 7.0 + math.sin(angle) * 8.05, z)\n\t\t\tpart(\"VaultPanel\", Vector3.new(2.18, 0.65, depth + 0.07), CFrame.new(center) * CFrame.Angles(0, 0, angle + math.pi / 2), if (slice + math.floor(-z / 10)) % 4 == 0 then PALE_CONCRETE else CONCRETE, Enum.Material.Concrete, geometry)\n\t\tend\n\t\t-- Raised ribs cast the repeated shadow rhythm visible in old service tunnels.\n\t\tif math.floor(-sectionZ / 10) % 2 == 0 then\n\t\t\tfor slice = 0, 11 do\n\t\t\t\tlocal angle = (slice + 0.5) * math.pi / 12\n\t\t\t\tlocal center = Vector3.new(math.cos(angle) * 7.96, 7.0 + math.sin(angle) * 7.96, sectionZ)\n\t\t\t\tpart(\"VaultRib\", Vector3.new(2.12, 0.16, 0.24), CFrame.new(center) * CFrame.Angles(0, 0, angle + math.pi / 2), DARK_CONCRETE, Enum.Material.Concrete, details, false)\n\t\t\tend\n\t\tend\n\t\tsectionZ += sectionLength\n\tend\n\n\tlocal function inDoorway(side: number, z: number, margin: number): boolean\n\t\tfor _, room in ROOMS do\n\t\t\tif room.side == side and math.abs(z - room.z) < 5.5 + margin then\n\t\t\t\treturn true\n\t\t\tend\n\t\tend\n\t\treturn false\n\tend\n\n\tfor z = 17, -195, -8 do\n\t\tfor _, side in { -1, 1 } do\n\t\t\tif not inDoorway(side, z, 3.2) then\n\t\t\t\tlocal panelColor = if random:NextNumber() > 0.47 then RUST else STEEL\n\t\t\t\tblock(\"RustedWallPlate\", Vector3.new(0.12, 3.5, 5.9), Vector3.new(side * 7.88, 2.4, z), panelColor, Enum.Material.CorrodedMetal, details, false)\n\t\t\t\tblock(\"PlateSeam\", Vector3.new(0.18, 3.6, 0.09), Vector3.new(side * 7.79, 2.4, z - 2.85), STEEL, Enum.Material.Metal, details, false)\n\t\t\t\tfor _, y in { 0.95, 3.82 } do\n\t\t\t\t\tfor _, dz in { -2.55, 2.55 } do\n\t\t\t\t\t\tblock(\"PlateRivet\", Vector3.new(0.08, 0.12, 0.12), Vector3.new(side * 7.76, y, z + dz), Color3.fromRGB(115, 103, 77), Enum.Material.Metal, details, false)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tfor z = 18, -198, -12 do\n\t\tfor _, x in { -3.65, 3.65 } do\n\t\t\tblock(\"ServiceRail\", Vector3.new(0.15, 0.18, 12.1), Vector3.new(x, 0.09, z - 6), RUST, Enum.Material.CorrodedMetal, details, false)\n\t\tend\n\t\tfor offset = 0, 9, 3 do\n\t\t\tblock(\"RailSleeper\", Vector3.new(8.1, 0.055, 0.34), Vector3.new(0, 0.027, z - offset), STEEL, Enum.Material.Metal, details, false)\n\t\tend\n\t\tblock(\"DrainChannel\", Vector3.new(0.75, 0.025, 11.9), Vector3.new(0, 0.018, z - 6), Color3.fromRGB(21, 27, 26), Enum.Material.Metal, details, false)\n\t\tfor offset = 0, 10, 2 do\n\t\t\tblock(\"DrainGrate\", Vector3.new(0.86, 0.035, 0.1), Vector3.new(0, 0.035, z - offset), STEEL, Enum.Material.Metal, details, false)\n\t\tend\n\t\tlocal puddle = part(\"FloorDamp\", Vector3.new(random:NextNumber(2.2, 4.9), 0.016, random:NextNumber(4, 8)), CFrame.new(random:NextNumber(-3.9, 3.9), 0.05, z - 5) * CFrame.Angles(0, random:NextNumber(-0.4, 0.4), 0), Color3.fromRGB(26, 37, 35), Enum.Material.Glass, details, false)\n\t\tpuddle.Transparency = 0.6\n\t\tpuddle.Reflectance = 0.19\n\t\tpuddle.CastShadow = false\n\tend\n\n\tfor z = 18, -198, -10 do\n\t\t-- Runs sit above head height and bridge door openings without blocking them.\n\t\tcylinder(\"HeatingMain\", Vector3.new(6.85, 6.1, z - 5), 10.05, 0.45, \"Z\", RUST)\n\t\tcylinder(\"HeatingReturn\", Vector3.new(6.85, 5.42, z - 5), 10.05, 0.24, \"Z\", STEEL)\n\t\tcylinder(\"PipeCollar\", Vector3.new(6.85, 6.1, z), 0.2, 0.59, \"Z\", STEEL)\n\t\tblock(\"PipeBracket\", Vector3.new(0.8, 0.09, 0.25), Vector3.new(7.2, 5.9, z), STEEL, Enum.Material.Metal, details, false)\n\t\tfor cable = 0, 2 do\n\t\t\tcylinder(\"CableRun\", Vector3.new(-6.9, 5.6 + cable * 0.18, z - 5), 10.05, 0.075, \"Z\", Color3.fromRGB(24, 27, 25))\n\t\tend\n\t\tblock(\"CableTray\", Vector3.new(0.75, 0.1, 0.2), Vector3.new(-7.12, 5.4, z), STEEL, Enum.Material.Metal, details, false)\n\tend\n\n\tfor index = 0, 12 do\n\t\tlocal z = 10 - index * 16\n\t\tlocal side = if index % 2 == 0 then -1 else 1\n\t\t-- Keep the fixture out of the 11-stud-wide room portals.\n\t\tif not inDoorway(side, z, 0.7) then\n\t\t\tcagedLamp(string.format(\"TunnelLamp%02d\", index + 1), Vector3.new(side * 7.28, 5.0, z), side, index == 10)\n\t\tend\n\tend\n\n\tfor _, room in ROOMS do\n\t\tlocal centerX = room.side * 20\n\t\tlocal outerX = room.side * 32.35\n\t\tblock(room.name .. \"Floor\", Vector3.new(24.8, 0.8, 24.8), Vector3.new(centerX, -0.4, room.z), DARK_CONCRETE, Enum.Material.Concrete, geometry)\n\t\tblock(room.name .. \"Ceiling\", Vector3.new(25, 0.65, 24.8), Vector3.new(centerX, 8.55, room.z), CONCRETE, Enum.Material.Concrete, geometry)\n\t\tblock(room.name .. \"OuterWall\", Vector3.new(0.8, 8.5, 24.8), Vector3.new(outerX, 4.25, room.z), CONCRETE, Enum.Material.Concrete, geometry)\n\t\tfor _, dz in { -12.2, 12.2 } do\n\t\t\tblock(room.name .. \"EndWall\", Vector3.new(24.8, 8.5, 0.8), Vector3.new(centerX, 4.25, room.z + dz), CONCRETE, Enum.Material.Concrete, geometry)\n\t\tend\n\t\tfor _, dz in { -5.7, 5.7 } do\n\t\t\tblock(\"PortalJamb\", Vector3.new(1.05, 7.0, 0.4), Vector3.new(room.side * 8.2, 3.5, room.z + dz), DARK_CONCRETE, Enum.Material.Concrete, geometry)\n\t\tend\n\t\tblock(\"PortalLintel\", Vector3.new(1.05, 1.4, 11.8), Vector3.new(room.side * 8.2, 7.7, room.z), DARK_CONCRETE, Enum.Material.Concrete, geometry)\n\t\tfor _, xOffset in { -5.5, 5.5 } do\n\t\t\tblock(\"CeilingBeam\", Vector3.new(0.3, 0.48, 24), Vector3.new(centerX + xOffset, 8.04, room.z), STEEL, Enum.Material.Metal, details, false)\n\t\tend\n\t\tcagedLamp(room.name .. \"Lamp\", Vector3.new(room.side * 31.1, 6.0, room.z), room.side, false)\n\t\tcagedLamp(room.name .. \"BackupLamp\", Vector3.new(room.side * 20, 6.8, room.z - 10.9), 0, room.name == \"GeneratorRoom\")\n\tend\n\n\t-- Workshop: wall tools, workbench, spare fuse, restrained floor clutter.\n\ttableProp(\"WorkshopBench\", Vector3.new(-27.2, 0, -31), 6.0, 2.5)\n\ttableProp(\"WorkshopDesk\", Vector3.new(-27.0, 0, -44), 5.3, 3)\n\tfuse(\"Fuse1\", Vector3.new(-27.8, 3.08, -31))\n\tnote(\"Note2\", Vector3.new(-27.0, 2.8, -44), CFrame.Angles(0, -0.12, 0))\n\tblock(\"ToolBoard\", Vector3.new(0.16, 3.1, 7.3), Vector3.new(-31.76, 4.5, -34), DULL_GREEN, Enum.Material.Metal, details, false)\n\tfor index = 0, 6 do\n\t\tpart(\"HangingTool\", Vector3.new(0.08, 1.0 + (index % 3) * 0.2, 0.12), CFrame.new(-31.6, 4.7, -36.6 + index * 0.8) * CFrame.Angles(0.1 * index, 0, 0), STEEL, Enum.Material.Metal, details, false)\n\tend\n\tfor index = 0, 2 do\n\t\tcylinder(\"OilDrum\", Vector3.new(-30 + index * 2.1, 1.45, -48), 2.9, 1.65, \"Y\", if index == 1 then RUST else DULL_GREEN)\n\tend\n\tblock(\"WorkshopCrate\", Vector3.new(3, 2.3, 2.6), Vector3.new(-13.8, 1.15, -47.5), Color3.fromRGB(82, 69, 47), Enum.Material.WoodPlanks)\n\n\t-- Generator room. Machinery occupies the back half; the entrance stays wide open.\n\tblock(\"GeneratorFoundation\", Vector3.new(9.1, 0.4, 6.6), Vector3.new(25.5, 0.2, -93.5), DARK_CONCRETE, Enum.Material.Concrete)\n\tblock(\"GeneratorBody\", Vector3.new(7.5, 3.4, 5.0), Vector3.new(25.5, 2.1, -93.5), DULL_GREEN, Enum.Material.CorrodedMetal)\n\tblock(\"GeneratorTop\", Vector3.new(6.5, 0.45, 4.7), Vector3.new(25.5, 4.0, -93.5), STEEL, Enum.Material.Metal)\n\tcylinder(\"GeneratorRotor\", Vector3.new(20.9, 2.4, -93.5), 1.6, 3.2, \"X\", STEEL)\n\tfor index = 0, 6 do\n\t\tblock(\"CoolingFin\", Vector3.new(0.18, 2.6, 4.9), Vector3.new(23.1 + index * 0.8, 2.2, -93.5), STEEL, Enum.Material.Metal, details, false)\n\tend\n\tcylinder(\"GeneratorExhaust\", Vector3.new(28.5, 5.6, -94.7), 4.0, 0.5, \"Y\", RUST)\n\tcylinder(\"ExhaustReturn\", Vector3.new(30, 7.4, -94.7), 3.0, 0.5, \"X\", RUST)\n\tlocal console = block(\"Generator\", Vector3.new(2.2, 1.3, 1.2), Vector3.new(18.4, 2.7, -89), DULL_GREEN, Enum.Material.Metal, interactions)\n\tblock(\"ControlPedestal\", Vector3.new(1.4, 2.1, 0.8), Vector3.new(18.4, 1.05, -89), STEEL, Enum.Material.Metal)\n\tlocal indicator = block(\"PowerIndicator\", Vector3.new(0.18, 0.18, 0.08), Vector3.new(17.8, 2.9, -88.35), RED, Enum.Material.Neon, details, false)\n\tindicator:SetAttribute(\"PowerIndicator\", true)\n\tfor index = 0, 2 do\n\t\tblock(\"ConsoleSwitch\", Vector3.new(0.12, 0.25, 0.09), Vector3.new(18.1 + index * 0.42, 2.6, -88.34), STEEL, Enum.Material.Metal, details, false)\n\tend\n\tinteract(console, \"Generator\", \"Ligar gerador\", \"Painel de energia\", 1.0)\n\ttableProp(\"GeneratorSpares\", Vector3.new(28.2, 0, -83), 5.4, 2.3)\n\tfuse(\"Fuse2\", Vector3.new(28.8, 3.08, -83))\n\tnote(\"Note3\", Vector3.new(31.78, 3.25, -100), CFrame.Angles(0, 0, math.pi / 2))\n\tfor index = 0, 2 do\n\t\tblock(\"ElectricalCabinet\", Vector3.new(1.5, 5.4, 2.6), Vector3.new(31, 2.7, -85.2 - index * 3.0), STEEL, Enum.Material.Metal)\n\tend\n\n\t-- Archive: narrow aisles around the outer cabinets, with a reachable central desk.\n\tfor index = 0, 3 do\n\t\tlocal z = -133.7 - index * 4.4\n\t\tblock(\"ArchiveCabinet\", Vector3.new(2.3, 5.8, 3.3), Vector3.new(-30.5, 2.9, z), DULL_GREEN, Enum.Material.Metal)\n\t\tfor drawer = 0, 3 do\n\t\t\tblock(\"DrawerFront\", Vector3.new(0.08, 1.0, 2.8), Vector3.new(-29.3, 0.85 + drawer * 1.33, z), STEEL, Enum.Material.Metal, details, false)\n\t\t\tblock(\"DrawerHandle\", Vector3.new(0.1, 0.12, 0.7), Vector3.new(-29.23, 0.91 + drawer * 1.33, z), Color3.fromRGB(115, 113, 90), Enum.Material.Metal, details, false)\n\t\tend\n\tend\n\ttableProp(\"ArchiveDesk\", Vector3.new(-21.5, 0, -143.5), 7.4, 4.0)\n\ttableProp(\"ArchiveShelf\", Vector3.new(-24.8, 0, -150.8), 5.8, 2.4)\n\tfuse(\"Fuse3\", Vector3.new(-24.8, 3.08, -150.8))\n\tlocal keycard = part(\"Keycard\", Vector3.new(0.72, 0.05, 1.05), CFrame.new(-20.8, 2.82, -143.4) * CFrame.Angles(0, 0.25, 0), Color3.fromRGB(156, 161, 135), Enum.Material.SmoothPlastic, interactions, false)\n\tinteract(keycard, \"Keycard\", \"Pegar cartão\", \"Cartão de evacuação\", 0.25)\n\tblock(\"CardStripe\", Vector3.new(0.55, 0.008, 0.14), Vector3.new(-20.8, 2.85, -143.55), RED, Enum.Material.SmoothPlastic, keycard, false)\n\tnote(\"Note4\", Vector3.new(-23.5, 2.81, -143), CFrame.Angles(0, 0.2, 0))\n\tfor index = 0, 2 do\n\t\tblock(\"PaperStack\", Vector3.new(1.4, 0.16, 1.9), Vector3.new(-22.3, 2.88 + index * 0.17, -144.5), PAPER, Enum.Material.SmoothPlastic, details, false)\n\tend\n\n\t-- Small story document; no wall signs or environmental lettering.\n\tnote(\"Note1\", Vector3.new(7.76, 3.5, 7), CFrame.Angles(0, 0, math.pi / 2))\n\n\t-- The exit uses ONE moving/collidable leaf. Decorations do not block the opening.\n\tfor _, x in { -7.95, 7.95 } do\n\t\tblock(\"ExitFrameJamb\", Vector3.new(0.5, 10.4, 1.5), Vector3.new(x, 5.2, -180), STEEL, Enum.Material.Metal, geometry)\n\tend\n\tblock(\"ExitFrameLintel\", Vector3.new(16.4, 0.6, 1.5), Vector3.new(0, 10.4, -180), STEEL, Enum.Material.Metal, geometry)\n\tlocal exitDoor = block(\"ExitDoor\", Vector3.new(15.4, 10, 1), Vector3.new(0, 5, -180), DULL_GREEN, Enum.Material.CorrodedMetal, world)\n\texitDoor:SetAttribute(\"ClosedCFrame\", exitDoor.CFrame)\n\texitDoor:SetAttribute(\"OpenOffset\", Vector3.new(0, 11, 0))\n\tinteract(exitDoor, \"Exit\", \"Abrir evacuação\", \"Porta de evacuação\", 0.8)\n\tcagedLamp(\"ExitEmergencyLamp\", Vector3.new(7.25, 6.3, -176), 1, true)\n\tcagedLamp(\"EvacuationLamp\", Vector3.new(-7.25, 6.3, -191), -1, false)\n\tlocal exitZone = block(\"ExitZone\", Vector3.new(14, 8, 14), Vector3.new(0, 4, -191), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, world, false)\n\texitZone.Transparency = 1\n\texitZone.CanQuery = false\n\texitZone.CastShadow = false\n\n\tlocal spawn = Instance.new(\"SpawnLocation\")\n\tspawn.Name = \"BunkerSpawn\"\n\tspawn.Size = Vector3.new(7, 0.15, 7)\n\tspawn.CFrame = CFrame.new(0, 0.075, 12)\n\tspawn.Anchored = true\n\tspawn.CanCollide = false\n\tspawn.Transparency = 1\n\tspawn.Neutral = true\n\tspawn.Duration = 0\n\tspawn.AllowTeamChangeOnTouch = false\n\tspawn.Parent = world\n\tpartCount += 1\n\tlocal spawnPoint = block(\"SpawnPoint\", Vector3.new(1, 1, 1), Vector3.new(0, 3, 12), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, world, false)\n\tspawnPoint.Transparency = 1\n\tspawnPoint.CanQuery = false\n\tspawnPoint.CanTouch = false\n\tspawnPoint.CastShadow = false\n\n\t-- Adjacent numbered nodes form a clear walking route, including room detours.\n\tlocal route = {\n\t\tVector3.new(0, 3, 10), Vector3.new(0, 3, -12), Vector3.new(0, 3, -38),\n\t\tVector3.new(-14, 3, -38), Vector3.new(-25, 3, -38), Vector3.new(-14, 3, -38),\n\t\tVector3.new(0, 3, -38), Vector3.new(0, 3, -65), Vector3.new(0, 3, -92),\n\t\tVector3.new(13, 3, -92), Vector3.new(17, 3, -98), Vector3.new(13, 3, -92),\n\t\tVector3.new(0, 3, -92), Vector3.new(0, 3, -119), Vector3.new(0, 3, -142),\n\t\tVector3.new(-14, 3, -142), Vector3.new(-16, 3, -149), Vector3.new(-14, 3, -142),\n\t\tVector3.new(0, 3, -142), Vector3.new(0, 3, -164),\n\t}\n\tfor index, position in route do\n\t\tlocal node = block(string.format(\"Node%02d\", index), Vector3.new(1, 1, 1), position, Color3.fromRGB(255, 0, 255), Enum.Material.SmoothPlastic, nodes, false)\n\t\tnode.Transparency = 1\n\t\tnode.CanQuery = false\n\t\tnode.CanTouch = false\n\t\tnode.CastShadow = false\n\t\tnode:SetAttribute(\"Order\", index)\n\tend\n\n\tworld:SetAttribute(\"PartCount\", partCount)\n\tworld:SetAttribute(\"Ready\", true)\n\treturn world\nend\n\nreturn WorldBuilder\n";s.Parent=SS.Sector7 end
do local s=Instance.new('LocalScript');s.Name="Sector7Client";s.Source="--!nonstrict\n-- SETOR 7 client: presentation and input only. Movement and gameplay live on the server.\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ContextActionService = game:GetService(\"ContextActionService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal Lighting = game:GetService(\"Lighting\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal player = Players.LocalPlayer\nlocal playerGui = player:WaitForChild(\"PlayerGui\")\nlocal package = ReplicatedStorage:WaitForChild(\"Sector7\")\nlocal Config = require(package:WaitForChild(\"Config\"))\nlocal remotes = package:WaitForChild(\"Remotes\")\nlocal sprintRemote = remotes:WaitForChild(\"Sprint\")\nlocal flashlightRemote = remotes:WaitForChild(\"Flashlight\")\nlocal feedbackRemote = remotes:WaitForChild(\"Feedback\")\nlocal cameraConfig = Config.Camera or {}\nlocal maxStamina = math.max(1, Config.MaxStamina or 100)\nlocal baseFov = cameraConfig.BaseFov or 74\nlocal sprintFov = cameraConfig.SprintFov or 80\nlocal maxBlur = math.clamp(cameraConfig.MaxBlur or 4, 0, 4)\nlocal bobStrength = math.clamp(cameraConfig.BobStrength or 0.045, 0, 0.08)\n\nlocal colors = {\n\tbackground = Color3.fromRGB(15, 19, 19),\n\tpanel = Color3.fromRGB(24, 30, 29),\n\tink = Color3.fromRGB(233, 236, 221),\n\tmuted = Color3.fromRGB(165, 177, 164),\n\tgreen = Color3.fromRGB(175, 198, 147),\n\tamber = Color3.fromRGB(229, 182, 104),\n\tred = Color3.fromRGB(218, 114, 101),\n\tline = Color3.fromRGB(73, 86, 75),\n}\n\nlocal connections = {}\nlocal characterConnections = {}\nlocal humanoid = nil\nlocal rootPart = nil\nlocal characterVersion = 0\nlocal alive = false\nlocal destroyed = false\nlocal modalKind = nil\nlocal coreMenuOpen = false\nlocal keyboardSprint = false\nlocal gamepadSprint = false\nlocal touchSprint = false\nlocal lastSprintRequest = false\nlocal displayedStamina = maxStamina\nlocal scarePulse = 0\nlocal toastVersion = 0\nlocal originalCameraMode = player.CameraMode\nlocal originalMouseIcon = UserInputService.MouseIconEnabled\nlocal cameraFovs = {}\nlocal runTrack = nil\n\nif player:GetAttribute(\"ReducedMotion\") == nil then\n\tplayer:SetAttribute(\"ReducedMotion\", false)\nend\nif player:GetAttribute(\"CameraBlurEnabled\") == nil then\n\tplayer:SetAttribute(\"CameraBlurEnabled\", true)\nend\nplayer.CameraMode = Enum.CameraMode.LockFirstPerson\n\nlocal function connect(signal, callback)\n\tlocal connection = signal:Connect(callback)\n\ttable.insert(connections, connection)\n\treturn connection\nend\n\nlocal function make(className, properties, parent)\n\tlocal object = Instance.new(className)\n\tfor key, value in pairs(properties) do\n\t\tobject[key] = value\n\tend\n\tobject.Parent = parent\n\treturn object\nend\n\nlocal function corner(parent, radius)\n\tmake(\"UICorner\", { CornerRadius = UDim.new(0, radius or 6) }, parent)\nend\n\nlocal function outline(parent)\n\tmake(\"UIStroke\", { Color = colors.line, Thickness = 1, Transparency = 0.25 }, parent)\nend\n\nlocal function label(parent, properties)\n\tlocal defaults = {\n\t\tBackgroundTransparency = 1,\n\t\tBorderSizePixel = 0,\n\t\tFont = Enum.Font.Gotham,\n\t\tTextColor3 = colors.ink,\n\t\tTextSize = 14,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t\tTextYAlignment = Enum.TextYAlignment.Center,\n\t\tRichText = false,\n\t}\n\tfor key, value in pairs(properties) do\n\t\tdefaults[key] = value\n\tend\n\treturn make(\"TextLabel\", defaults, parent)\nend\n\nlocal function button(parent, properties)\n\tlocal defaults = {\n\t\tBackgroundColor3 = colors.panel,\n\t\tBorderSizePixel = 0,\n\t\tAutoButtonColor = true,\n\t\tFont = Enum.Font.GothamMedium,\n\t\tTextColor3 = colors.ink,\n\t\tTextSize = 14,\n\t\tSelectable = true,\n\t}\n\tfor key, value in pairs(properties) do\n\t\tdefaults[key] = value\n\tend\n\tlocal object = make(\"TextButton\", defaults, parent)\n\tcorner(object, 6)\n\toutline(object)\n\treturn object\nend\n\nfor _, name in ipairs({ \"Sector7Effects\", \"Sector7HUD\" }) do\n\tlocal existing = playerGui:FindFirstChild(name)\n\tif existing then\n\t\texisting:Destroy()\n\tend\nend\n\n-- Only noninteractive ambience ignores screen insets. HUD controls stay in the safe area.\nlocal effectsGui = make(\"ScreenGui\", {\n\tName = \"Sector7Effects\",\n\tResetOnSpawn = false,\n\tDisplayOrder = 1,\n\tScreenInsets = Enum.ScreenInsets.None,\n\tClipToDeviceSafeArea = false,\n\tZIndexBehavior = Enum.ZIndexBehavior.Sibling,\n}, playerGui)\nlocal effectsRoot = make(\"Frame\", {\n\tName = \"FullBleed\",\n\tSize = UDim2.fromScale(1, 1),\n\tBackgroundTransparency = 1,\n\tBorderSizePixel = 0,\n\tActive = false,\n}, effectsGui)\n\n-- Gentle edge shade; no flicker, grain animation, or image asset dependency.\nfor _, side in ipairs({ \"Top\", \"Bottom\" }) do\n\tlocal top = side == \"Top\"\n\tlocal edge = make(\"Frame\", {\n\t\tName = side .. \"Shade\",\n\t\tSize = UDim2.fromScale(1, 0.14),\n\t\tPosition = UDim2.fromScale(0, top and 0 or 1),\n\t\tAnchorPoint = Vector2.new(0, top and 0 or 1),\n\t\tBackgroundColor3 = Color3.new(0, 0, 0),\n\t\tBackgroundTransparency = 0.8,\n\t\tBorderSizePixel = 0,\n\t\tActive = false,\n\t}, effectsRoot)\n\tmake(\"UIGradient\", {\n\t\tRotation = top and 90 or 270,\n\t\tTransparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),\n\t}, edge)\nend\nlocal scareShade = make(\"Frame\", {\n\tName = \"ThreatShade\",\n\tSize = UDim2.fromScale(1, 1),\n\tBackgroundColor3 = Color3.fromRGB(63, 15, 13),\n\tBackgroundTransparency = 1,\n\tBorderSizePixel = 0,\n\tActive = false,\n}, effectsRoot)\n\nlocal hud = make(\"ScreenGui\", {\n\tName = \"Sector7HUD\",\n\tResetOnSpawn = false,\n\tDisplayOrder = 10,\n\tScreenInsets = Enum.ScreenInsets.DeviceSafeInsets,\n\tClipToDeviceS