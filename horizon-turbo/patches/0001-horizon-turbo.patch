+/// Keep the public tunnel open until stopped: open it, put its endpoint in
+/// the code, carry its visitors to the direct port, and open it again (a
+/// new port, so a new code) when the server drops it. `first` hears the
+/// first attempt's outcome.
+fn run_tunnel(shared: Arc<Shared>, config: TunnelConfig, port: u16, first: Sender<()>) {
+    let local = SocketAddr::from(([127, 0, 0, 1], port));
+    let mut first = Some(first);
+    let mut backoff = Duration::from_secs(2);
+    while !shared.stopped() {
+        match tunnel::open(&config) {
+            Ok(control) => {
+                backoff = Duration::from_secs(2);
+                if let Ok(c) = control.closer() {
+                    *shared.tunnel_control.lock().unwrap() = Some(c);
+                }
+                if shared.stopped() {
+                    if let Some(c) = shared.tunnel_control.lock().unwrap().take() {
+                        let _ = c.shutdown(Shutdown::Both);
+                    }
+                    break;
+                }
+                let public = control.public;
+                {
+                    let mut s = shared.state.lock().unwrap();
+                    s.tunnel = Some(format!("{}:{}", config.host(), public.port()));
+                    s.tunnel_problem = None;
+                }
+                shared.set_tunnel(Some(public));
+                if let Some(f) = first.take() {
+                    let _ = f.send(());
+                }
+                let ended = control.serve(local, &shared.stop);
+                shared.tunnel_control.lock().unwrap().take();
+                if shared.stopped() {
+                    break;
+                }
+                shared.state.lock().unwrap().tunnel = None;
+                shared.set_tunnel(None);
+                shared.state.lock().unwrap().tunnel_problem = Some(match ended {
+                    Ok(()) => format!(
+                        "The public tunnel through {} closed; opening it again…",
+                        config.host()
+                    ),
+                    Err(e) => format!(
+                        "The public tunnel through {} closed ({e}); opening it again…",
+                        config.host()
+                    ),
+                });
+            }
+            Err(e) => {
+                if shared.stopped() {
+                    break;
+                }
+                shared.state.lock().unwrap().tunnel_problem = Some(format!(
+                    "Couldn't open the public tunnel through {} ({e}); trying again…",
+                    config.host()
+                ));
