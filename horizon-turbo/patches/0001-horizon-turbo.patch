+//! The public tunnel end to end on loopback: a host shares through a
+//! bore-compatible server (a small one in this file, written from bore's
+//! protocol; `HORIZON_TEST_BORE=host[:port]` runs the first test against a
+//! real `bore server` instead), and a guest whose code holds nothing but the
+//! tunnel's endpoint joins through it, end-to-end encrypted as always.
+use horizon_friends::{
+    Host, HostConfig, PathMode,
+    guest::{self, GuestConfig},
+    invite::{self, Invite, Parsed},
+    reach,
+    tunnel::TunnelConfig,
+};
+use serde_json::json;
+use std::{
+    collections::HashMap,
+    io::{self, BufRead, BufReader, Read, Write},
+    net::{Shutdown, SocketAddr, TcpListener, TcpStream},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+const PROTOCOL: i32 = 777;
+
+/// Echoes every connection back until it closes.
+fn echo_server() -> SocketAddr {
+    let l = TcpListener::bind("127.0.0.1:0").unwrap();
+    let a = l.local_addr().unwrap();
+    thread::spawn(move || {
+        for s in l.incoming() {
+            let Ok(mut s) = s else { continue };
+            thread::spawn(move || {
+                let mut out = s.try_clone().unwrap();
+                let _ = io::copy(&mut s, &mut out);
+            });
+        }
+    });
+    a
+}
+
+// ----- A bore-compatible server ---------------------------------------------------------------
+
+#[derive(Clone, Default)]
+struct Bore {
+    control: Option<SocketAddr>,
+    /// Hosts whose control connection is open.
+    hosts: Arc<AtomicUsize>,
+    /// Visitors carried so far.
+    carried: Arc<AtomicUsize>,
+}
+
+fn send_frame(s: &mut TcpStream, v: serde_json::Value) -> io::Result<()> {
+    let mut b = serde_json::to_vec(&v).unwrap();
+    b.push(0);
+    s.write_all(&b)
+}
+
+fn read_frame(r: &mut impl BufRead) -> Option<serde_json::Value> {
+    let mut f = Vec::new();
+    if r.read_until(0, &mut f).ok()? == 0 || f.pop() != Some(0) {
+        return None;
+    }
+    serde_json::from_slice(&f).ok()
+}
+
+fn uuid(n: usize) -> String {
+    format!("6f1d0c2a-0000-4000-8000-{n:012x}")
+}
+
+/// bore's answer, computed apart from the client's code: HMAC-SHA256 keyed
+/// by SHA-256 of the secret, over the uuid's 16 bytes, in hex.
+fn expected_answer(secret: &str, challenge: &str) -> String {
+    use sha2::{Digest, Sha256};
+    let hex: String = challenge.chars().filter(|c| *c != '-').collect();
+    let id: Vec<u8> = (0..16)
+        .map(|i| u8::from_str_radix(&hex[2 * i..2 * i + 2], 16).unwrap())
+        .collect();
+    let mut key = [0u8; 64];
+    key[..32].copy_from_slice(&Sha256::digest(secret.as_bytes()));
+    let pad = |x: u8| key.iter().map(|b| b ^ x).collect::<Vec<u8>>();
+    let inner = Sha256::new()
+        .chain_update(pad(0x36))
+        .chain_update(&id)
+        .finalize();
+    let outer = Sha256::new()
+        .chain_update(pad(0x5c))
+        .chain_update(inner)
+        .finalize();
+    outer.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// bore's server: `Hello(0)` gets a port and heartbeats, each visitor a
+/// `Connection(id)`, and `Accept(id)` on a new connection carries it.
+fn bore_server(secret: Option<&'static str>) -> Bore {
+    let l = TcpListener::bind("127.0.0.1:0").unwrap();
+    let bore = Bore {
+        control: Some(l.local_addr().unwrap()),
+        ..Bore::default()
+    };
+    let pending: Arc<Mutex<HashMap<String, TcpStream>>> = Arc::default();
+    let next = Arc::new(AtomicUsize::new(1));
+    let b = bore.clone();
+    thread::spawn(move || {
+        for s in l.incoming() {
+            let Ok(s) = s else { continue };
+            let (b, pending, next) = (b.clone(), pending.clone(), next.clone());
+            thread::spawn(move || {
+                let _ = serve(s, &b, &pending, &next, secret);
+            });
+        }
+    });
+    bore
+}
+
+fn serve(
+    mut s: TcpStream,
+    bore: &Bore,
+    pending: &Mutex<HashMap<String, TcpStream>>,
+    next: &AtomicUsize,
+    secret: Option<&str>,
+) -> io::Result<()> {
+    s.set_read_timeout(Some(Duration::from_secs(3)))?;
+    let mut r = BufReader::new(s.try_clone()?);
+    if let Some(secret) = secret {
+        let challenge = uuid(next.fetch_add(1, Ordering::Relaxed));
+        send_frame(&mut s, json!({ "Challenge": challenge }))?;
+        let answer = read_frame(&mut r);
+        if answer.as_ref().and_then(|v| v["Authenticate"].as_str())
+            != Some(expected_answer(secret, &challenge).as_str())
+        {
+            // bore: "invalid secret", and the connection ends.
+            return Ok(());
+        }
+    }
+    let first = read_frame(&mut r).ok_or_else(|| io::Error::other("no first message"))?;
+    if let Some(port) = first.get("Hello").and_then(|p| p.as_u64()) {
+        assert_eq!(port, 0, "the host asks for any port");
+        let visitors = TcpListener::bind("127.0.0.1:0")?;
+        visitors.set_nonblocking(true)?;
+        send_frame(&mut s, json!({ "Hello": visitors.local_addr()?.port() }))?;
+        bore.hosts.fetch_add(1, Ordering::Relaxed);
+        let ended = (|| -> io::Result<()> {
+            loop {
+                send_frame(&mut s, json!("Heartbeat"))?;
+                let until = Instant::now() + Duration::from_millis(500);
+                while Instant::now() < until {
+                    match visitors.accept() {
+                        Ok((v, _)) => {
+                            v.set_nonblocking(false)?;
+                            let id = uuid(next.fetch_add(1, Ordering::Relaxed));
+                            pending.lock().unwrap().insert(id.clone(), v);
+                            send_frame(&mut s, json!({ "Connection": id }))?;
+                        }
+                        Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                            thread::sleep(Duration::from_millis(10));
+                        }
+                        Err(e) => return Err(e),
+                    }
+                }
+            }
+        })();
+        bore.hosts.fetch_sub(1, Ordering::Relaxed);
+        return ended;
+    }
+    if let Some(id) = first.get("Accept").and_then(|i| i.as_str()) {
+        let Some(mut visitor) = pending.lock().unwrap().remove(id) else {
+            return Ok(());
+        };
+        visitor.write_all(r.buffer())?;
+        s.set_read_timeout(None)?;
+        bore.carried.fetch_add(1, Ordering::Relaxed);
+        let (mut from_host, mut to_visitor) = (s.try_clone()?, visitor.try_clone()?);
+        let up = thread::spawn(move || {
+            let _ = io::copy(&mut from_host, &mut to_visitor);
+            let _ = to_visitor.shutdown(Shutdown::Both);
+        });
+        let _ = io::copy(&mut visitor, &mut s);
+        let _ = s.shutdown(Shutdown::Both);
+        let _ = up.join();
+    }
+    Ok(())
+}
+
+// ----- The game's ends ------------------------------------------------------------------------
+
+fn start(tunnel: TunnelConfig) -> Host {
+    Host::start(HostConfig {
+        lan: echo_server(),
+        protocol: PROTOCOL,
+        game: "26.3".into(),
+        relay: None,
+        path: PathMode::Auto,
+        port: 0,
+        reach: reach::Options {
+            map_port: false,
+            stun: Vec::new(),
+            loopback: false,
+        },
+        tunnel: Some(tunnel),
+    })
+    .unwrap()
+}
+
+fn long(code: &str) -> Invite {
+    match invite::parse(code) {
+        Some(Parsed::Long(i)) => i,
+        other => panic!("{other:?}"),
+    }
+}
+
+/// The code once it holds the tunnel's endpoint, and that endpoint.
+fn tunnel_code(host: &Host) -> (String, SocketAddr) {
+    let deadline = Instant::now() + Duration::from_secs(20);
+    loop {
+        let s = host.state();
+        if let (Some(code), Some(address)) = (s.invite, s.tunnel) {
+            let port: u16 = address.rsplit(':').next().unwrap().parse().unwrap();
+            if let Some(e) = long(&code).endpoints.iter().find(|e| e.port() == port) {
+                return (code, *e);
+            }
+        }
+        assert!(
+            Instant::now() < deadline,
+            "no tunnel: {:?}",
+            host.state().tunnel_problem
+        );
+        thread::sleep(Duration::from_millis(20));
+    }
+}
+
+/// The same code with nothing but the tunnel's endpoint: only the tunnel
+/// can carry a guest that has it.
+fn only_through(code: &str, endpoint: SocketAddr) -> String {
+    let mut invite = long(code);
+    invite.endpoints = vec![endpoint];
+    invite.relay = None;
+    invite.encode()
+}
+
+fn join(code: &str) -> guest::Tunnel {
+    guest::join(&GuestConfig {
+        code: code.to_owned(),
+        relay: None,
+        protocol: PROTOCOL,
+        game: "26.3".into(),
+        path: PathMode::Auto,
+    })
+    .unwrap()
+}
+
+/// What the game's client does: connect to the loopback port, send, read
+/// the echo back.
+fn round_trip(tunnel: guest::Tunnel, payload: &[u8]) {
+    let (port, done) = tunnel.serve_loopback().unwrap();
+    let mut s = TcpStream::connect(("127.0.0.1", port)).unwrap();
+    s.set_read_timeout(Some(Duration::from_secs(30))).unwrap();
+    let mut w = s.try_clone().unwrap();
+    let send = payload.to_vec();
+    let writer = thread::spawn(move || w.write_all(&send).unwrap());
+    let mut got = vec![0u8; payload.len()];
+    s.read_exact(&mut got).unwrap();
+    writer.join().unwrap();
+    assert!(got == payload, "echo differs");
+    drop(s);
+    done.join().unwrap();
+}
+
+fn payload(n: usize) -> Vec<u8> {
+    (0..n).map(|i| (i * 7 + i / 251) as u8).collect()
+}
+
+fn wait_until(what: &str, mut f: impl FnMut() -> bool) {
+    let deadline = Instant::now() + Duration::from_secs(20);
+    while !f() {
+        assert!(Instant::now() < deadline, "{what}");
+        thread::sleep(Duration::from_millis(20));
+    }
+}
+
+#[test]
+fn friends_join_through_the_public_tunnel() {
+    let real = std::env::var("HORIZON_TEST_BORE").ok();
+    let bore = if real.is_some() {
+        Bore::default()
+    } else {
+        bore_server(None)
+    };
+    let server = real.unwrap_or_else(|| bore.control.unwrap().to_string());
+    let mut host = start(TunnelConfig::from_setting(Some(&server), None).unwrap());
+    let (code, endpoint) = tunnel_code(&host);
+    assert!(
+        long(&code).endpoints[0] == endpoint,
+        "the tunnel leads the code"
+    );
+    assert!(host.state().tunnel_problem.is_none());
+    let code = only_through(&code, endpoint);
+    round_trip(join(&code), &payload(1 << 20));
+    // Two guests at once.
+    let (a, b) = (join(&code), join(&code));
+    let ta = thread::spawn(move || round_trip(a, &payload(50_000)));
+    round_trip(b, &payload(70_000));
+    ta.join().unwrap();
+    if bore.control.is_some() {
+        assert!(bore.carried.load(Ordering::Relaxed) >= 3);
+        // Stopping closes the tunnel at the server.
+        host.stop();
+        wait_until("the tunnel stays open", || {
+            bore.hosts.load(Ordering::Relaxed) == 0
+        });
+    }
+}
+
+#[test]
+fn a_server_with_a_secret_takes_only_its_secret() {
+    let bore = bore_server(Some("s3cret"));
+    let server = bore.control.unwrap().to_string();
+    let host = start(TunnelConfig::from_setting(Some(&server), Some("s3cret")).unwrap());
+    let (code, endpoint) = tunnel_code(&host);
+    round_trip(join(&only_through(&code, endpoint)), &payload(10_000));
+    for secret in [Some("wrong"), None] {
+        let host = start(TunnelConfig::from_setting(Some(&server), secret).unwrap());
+        wait_until("no problem shown", || {
+            let s = host.state();
+            s.tunnel_problem.is_some() && s.invite.is_some()
+        });
+        let state = host.state();
+        assert!(state.tunnel.is_none(), "{secret:?}");
+        // The code still comes, for every other path, without a tunnel port.
+        let ports = long(&state.invite.unwrap()).endpoints;
+        assert!(ports.iter().all(|e| e.port() == state.port), "{ports:?}");
+    }
+}
+
+#[test]
+fn an_unreachable_server_leaves_the_code_to_the_other_paths() {
+    // A port nothing listens on any more.
+    let dead = TcpListener::bind("127.0.0.1:0")
+        .unwrap()
+        .local_addr()
+        .unwrap();
+    let host = start(TunnelConfig::from_setting(Some(&dead.to_string()), None).unwrap());
+    wait_until("no code", || {
+        let s = host.state();
+        s.invite.is_some() && s.tunnel_problem.is_some()
+    });
+    let state = host.state();
+    assert!(state.tunnel.is_none());
+    assert!(
+        !long(&state.invite.unwrap())
+            .endpoints
+            .iter()
+            .any(|e| e.port() == dead.port() && e.ip().is_loopback())
+    );
+}
