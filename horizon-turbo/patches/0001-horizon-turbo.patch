+//! The public tunnel: friends anywhere reach the host's direct port through a
+//! bore server (`bore.pub` by default, or one the player runs with
+//! `bore server`), however many NATs are in the way, mobile data and a
+//! provider's carrier-grade NAT (CGNAT) included, because the host only ever
+//! dials out. The host keeps one control connection; the server gives it a
+//! public TCP port and announces each visitor, for whom the host opens one
+//! more outbound connection and joins it to the direct port. What goes
+//! through is the same end-to-end encrypted session as a direct one, keyed
+//! by the code's secret: the server sees addresses and encrypted bytes,
+//! never the game. The invite code carries the server's address with the
+//! public port as one more endpoint, so a guest needs no setting, and a
+//! guest whose game doesn't know about tunnels dials it like any endpoint.
+//!
+//! The protocol is bore's (github.com/ekzhang/bore, MIT): JSON messages
+//! ending in a NUL byte on TCP port 7835. `{"Hello":0}` asks for a port; the
+//! server answers `{"Hello":port}`, then sends `"Heartbeat"` twice a second
+//! and `{"Connection":id}` per visitor; `{"Accept":id}` on a new connection
+//! takes that visitor, and the bytes that follow are the visitor's. A server
+//! started with `--secret` first sends `{"Challenge":uuid}`, answered with
+//! `{"Authenticate":hex(HMAC-SHA256(SHA-256(secret), the uuid's 16 bytes))}`.
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    io::{self, BufRead, BufReader, Read, Write},
+    net::{IpAddr, Shutdown, SocketAddr, TcpStream, ToSocketAddrs},
+    sync::{
+        Arc,
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+    },
+    time::Duration,
+};
+
+/// The server used when the player sets none: bore's own public one.
+pub const DEFAULT_SERVER: &str = "bore.pub";
+/// bore's control port.
+pub const CONTROL_PORT: u16 = 7835;
+/// bore's longest message.
+const MAX_FRAME: usize = 256;
+/// Connecting, and the answers during the opening (bore itself waits 3 s).
+const TIMEOUT: Duration = Duration::from_secs(5);
+/// The server sends a heartbeat every half second: this long without a
+/// message and the control connection is dead.
+const SILENCE: Duration = Duration::from_secs(20);
+/// Visitors carried at once (each holds two connections and two threads);
+/// more are left to the server, which drops them after ten seconds.
+const MAX_VISITORS: usize = 32;
+
+/// Where the tunnel goes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct TunnelConfig {
+    /// The server: `host`, `host:port` or `[v6]:port` (its control port,
+    /// 7835 when left out).
+    pub server: String,
+    /// The server's `--secret`, when it was started with one.
+    pub secret: Option<String>,
+}
+
+impl TunnelConfig {
+    /// From the player's settings: nothing or an empty text means the default
+    /// server, `none` (or `off`, `0`, `false`) no tunnel.
+    pub fn from_setting(server: Option<&str>, secret: Option<&str>) -> Option<Self> {
+        let server = server.map(str::trim).unwrap_or("");
+        if matches!(
+            server.to_ascii_lowercase().as_str(),
+            "none" | "off" | "0" | "false" | "no"
+        ) {
+            return None;
+        }
+        let server = server.trim_start_matches("tcp://").trim_end_matches('/');
+        Some(Self {
+            server: if server.is_empty() {
+                DEFAULT_SERVER.to_owned()
+            } else {
+                server.to_owned()
+            },
+            secret: secret
+                .map(str::trim)
+                .filter(|s| !s.is_empty())
+                .map(str::to_owned),
+        })
+    }
+
+    /// The server's name as the player reads it, without its port.
+    pub fn host(&self) -> &str {
+        let s = self.server.as_str();
+        if let Some(rest) = s.strip_prefix('[') {
+            return rest.split(']').next().unwrap_or(rest);
+        }
+        match s.rsplit_once(':') {
+            Some((host, port)) if !host.contains(':') && port.parse::<u16>().is_ok() => host,
+            _ => s,
+        }
+    }
+
+    /// The server's addresses, IPv4 first: bore opens the public ports on
+    /// IPv4 (`--bind-tunnels 0.0.0.0` by default), and most phones' networks
+    /// only have IPv4 anyway.
+    fn addresses(&self) -> io::Result<Vec<SocketAddr>> {
+        let s = self.server.as_str();
+        let with_port = if s.parse::<SocketAddr>().is_ok() {
+            s.to_owned()
+        } else if s.parse::<IpAddr>().is_ok_and(|ip| ip.is_ipv6()) {
+            format!("[{s}]:{CONTROL_PORT}")
+        } else if s.starts_with('[') {
+            if s.contains("]:") {
+                s.to_owned()
+            } else {
+                format!("{s}:{CONTROL_PORT}")
+            }
+        } else if s
+            .rsplit_once(':')
+            .is_some_and(|(host, port)| !host.contains(':') && port.parse::<u16>().is_ok())
+        {
+            s.to_owned()
+        } else {
+            format!("{s}:{CONTROL_PORT}")
+        };
+        let mut found: Vec<SocketAddr> = with_port.to_socket_addrs()?.collect();
+        found.sort_by_key(|a| a.is_ipv6());
+        found.dedup();
+        if found.is_empty() {
+            return Err(io::Error::new(
+                io::ErrorKind::NotFound,
+                "the tunnel server's name didn't resolve",
+            ));
+        }
+        Ok(found)
+    }
+}
+
+/// A message to the server.
+#[derive(Debug, Serialize)]
+enum ToServer {
+    Authenticate(String),
+    Hello(u16),
+    Accept(String),
+}
+
+/// A message from the server.
+#[derive(Debug, Deserialize)]
+enum FromServer {
+    Challenge(String),
+    Hello(u16),
+    Heartbeat,
+    Connection(String),
+    Error(String),
+}
+
+fn invalid(what: impl Into<String>) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, what.into())
+}
+
+fn send(stream: &mut impl Write, message: &ToServer) -> io::Result<()> {
+    let mut bytes = serde_json::to_vec(message).map_err(io::Error::other)?;
+    bytes.push(0);
+    stream.write_all(&bytes)?;
+    stream.flush()
+}
+
+/// The next message: the bytes up to the next NUL (taken from `reader`'s
+/// buffer, so nothing after it is lost).
+fn recv(reader: &mut impl BufRead) -> io::Result<FromServer> {
+    let mut frame = Vec::new();
+    let n = (&mut *reader)
+        .take(MAX_FRAME as u64 + 1)
+        .read_until(0, &mut frame)?;
+    if n == 0 {
+        return Err(io::ErrorKind::UnexpectedEof.into());
+    }
+    if frame.last() != Some(&0) {
+        return Err(if n > MAX_FRAME {
+            invalid("the tunnel server sent a message that is too long")
+        } else {
+            io::ErrorKind::UnexpectedEof.into()
+        });
+    }
+    frame.pop();
+    serde_json::from_slice(&frame)
+        .map_err(|e| invalid(format!("the tunnel server said something unknown ({e})")))
+}
+
+/// HMAC-SHA256 (RFC 2104), the only MAC bore's authentication uses.
+fn hmac_sha256(key: &[u8], message: &[u8]) -> [u8; 32] {
+    const BLOCK: usize = 64;
+    let mut block = [0u8; BLOCK];
+    if key.len() > BLOCK {
+        block[..32].copy_from_slice(&Sha256::digest(key));
+    } else {
+        block[..key.len()].copy_from_slice(key);
+    }
+    let mut inner = Sha256::new();
+    inner.update(block.map(|b| b ^ 0x36));
+    inner.update(message);
+    let inner = inner.finalize();
+    let mut outer = Sha256::new();
+    outer.update(block.map(|b| b ^ 0x5c));
+    outer.update(inner);
+    outer.finalize().into()
+}
+
+/// A UUID's 16 bytes from its text (`8-4-4-4-12` hex digits, or 32 in a row).
+fn uuid_bytes(text: &str) -> Option<[u8; 16]> {
+    let digits: Vec<u8> = text.bytes().filter(|&b| b != b'-').collect();
+    if digits.len() != 32 {
+        return None;
+    }
+    let mut out = [0u8; 16];
+    for (i, pair) in digits.chunks(2).enumerate() {
+        out[i] = u8::from_str_radix(std::str::from_utf8(pair).ok()?, 16).ok()?;
+    }
+    Some(out)
+}
+
+/// The answer to a challenge: bore's `Authenticator::answer`.
+fn answer(secret: &str, challenge: &str) -> io::Result<String> {
+    let id =
+        uuid_bytes(challenge).ok_or_else(|| invalid("the tunnel server sent a bad challenge"))?;
+    let key = Sha256::digest(secret.as_bytes());
+    Ok(hmac_sha256(&key, &id)
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect())
+}
+
+/// Answer the server's challenge, first thing on a connection.
+fn authenticate(reader: &mut impl BufRead, stream: &mut TcpStream, secret: &str) -> io::Result<()> {
+    match recv(reader)? {
+        FromServer::Challenge(id) => send(stream, &ToServer::Authenticate(answer(secret, &id)?)),
+        FromServer::Error(e) => Err(io::Error::other(format!("the tunnel server refused: {e}"))),
+        _ => Err(invalid(
+            "the tunnel server didn't ask for the secret: leave the secret empty",
+        )),
+    }
+}
+
+/// The control connection of an open tunnel.
+pub struct Control {
+    reader: BufReader<TcpStream>,
+    stream: TcpStream,
+    /// Where friends dial: the server's (IPv4) address with the port it gave.
+    pub public: SocketAddr,
+    /// The address the control connection reached, where visitors are taken.
+    server: SocketAddr,
+    secret: Option<String>,
+}
+
+/// Ask the server for a public port.
+pub fn open(config: &TunnelConfig) -> io::Result<Control> {
+    let addresses = config.addresses()?;
+    // The public port is reached on the server's IPv4 address even when the
+    // control connection went over IPv6.
+    let public_ip = addresses.iter().find(|a| a.is_ipv4()).map(SocketAddr::ip);
+    let mut last = io::Error::other("no address");
+    for server in addresses {
+        match open_at(server, public_ip, config.secret.as_deref()) {
+            Ok(control) => return Ok(control),
+            Err(e) => last = e,
+        }
+    }
+    Err(last)
+}
+
+fn open_at(
+    server: SocketAddr,
+    public_ip: Option<IpAddr>,
+    secret: Option<&str>,
+) -> io::Result<Control> {
+    let mut stream = TcpStream::connect_timeout(&server, TIMEOUT)?;
+    let _ = stream.set_nodelay(true);
+    stream.set_read_timeout(Some(TIMEOUT))?;
+    let mut reader = BufReader::new(stream.try_clone()?);
+    if let Some(secret) = secret {
+        authenticate(&mut reader, &mut stream, secret)?;
+    }
+    send(&mut stream, &ToServer::Hello(0))?;
+    loop {
+        match recv(&mut reader)? {
+            FromServer::Hello(0) => return Err(invalid("the tunnel server gave no port")),
+            FromServer::Hello(port) => {
+                return Ok(Control {
+                    reader,
+                    stream,
+                    public: SocketAddr::new(public_ip.unwrap_or(server.ip()), port),
+                    server,
+                    secret: secret.map(str::to_owned),
+                });
+            }
+            FromServer::Heartbeat => {}
+            FromServer::Error(e) => {
+                return Err(io::Error::other(format!("the tunnel server refused: {e}")));
+            }
+            FromServer::Challenge(_) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::PermissionDenied,
+                    "the tunnel server needs its secret (friendsTunnelSecret)",
+                ));
+            }
+            FromServer::Connection(_) => return Err(invalid("a visitor came before the port")),
+        }
+    }
+}
+
+impl Control {
+    /// A handle that ends [`Control::serve`] from another thread (shut it down).
+    pub fn closer(&self) -> io::Result<TcpStream> {
+        self.stream.try_clone()
+    }
+
+    /// Take each visitor and carry it to `local` until the control
+    /// connection ends (the error says why) or `stop` is set.
+    pub fn serve(mut self, local: SocketAddr, stop: &AtomicBool) -> io::Result<()> {
+        self.stream.set_read_timeout(Some(SILENCE))?;
+        let visitors = Arc::new(AtomicUsize::new(0));
+        loop {
+            if stop.load(Ordering::Relaxed) {
+                let _ = self.stream.shutdown(Shutdown::Both);
+                return Ok(());
+            }
+            let message = match recv(&mut self.reader) {
+                Ok(m) => m,
+                Err(_) if stop.load(Ordering::Relaxed) => return Ok(()),
+                Err(e)
+                    if matches!(
+                        e.kind(),
+                        io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut
+                    ) =>
+                {
+                    return Err(io::Error::new(
+                        io::ErrorKind::TimedOut,
+                        "the tunnel server went silent",
+                    ));
+                }
+                Err(e) => return Err(e),
+            };
+            match message {
+                FromServer::Heartbeat => {}
+                FromServer::Connection(id) => {
+                    if visitors.fetch_add(1, Ordering::Relaxed) >= MAX_VISITORS {
+                        visitors.fetch_sub(1, Ordering::Relaxed);
+                        continue;
+                    }
+                    let (server, secret, count) =
+                        (self.server, self.secret.clone(), visitors.clone());
+                    let spawned = std::thread::Builder::new()
+                        .name("horizon-tunnel-visitor".into())
+                        .spawn(move || {
+                            let _ = take_visitor(server, secret.as_deref(), &id, local);
+                            count.fetch_sub(1, Ordering::Relaxed);
+                        });
+                    if spawned.is_err() {
+                        visitors.fetch_sub(1, Ordering::Relaxed);
+                    }
+                }
+                FromServer::Error(e) => {
+                    return Err(io::Error::other(format!(
+                        "the tunnel server ended the tunnel: {e}"
+                    )));
+                }
+                FromServer::Hello(_) | FromServer::Challenge(_) => {
+                    return Err(invalid("the tunnel server sent an unexpected message"));
+                }
+            }
+        }
+    }
+}
+
+/// One visitor: a new connection to the server that accepts it, joined to
+/// `local` both ways.
+fn take_visitor(
+    server: SocketAddr,
+    secret: Option<&str>,
+    id: &str,
+    local: SocketAddr,
+) -> io::Result<()> {
+    let mut remote = TcpStream::connect_timeout(&server, TIMEOUT)?;
+    let _ = remote.set_nodelay(true);
+    remote.set_read_timeout(Some(TIMEOUT))?;
+    // Bytes the reader took past the challenge belong to the visitor (none
+    // in practice: the server waits for the answer before it carries any).
+    let mut early = Vec::new();
+    if let Some(secret) = secret {
+        let mut reader = BufReader::new(remote.try_clone()?);
+        authenticate(&mut reader, &mut remote, secret)?;
+        early.extend_from_slice(reader.buffer());
+    }
+    send(&mut remote, &ToServer::Accept(id.to_owned()))?;
+    let mut local = TcpStream::connect_timeout(&local, TIMEOUT)?;
+    let _ = local.set_nodelay(true);
+    if !early.is_empty() {
+        local.write_all(&early)?;
+    }
+    remote.set_read_timeout(None)?;
+    join(remote, local)
+}
+
+/// Copy both ways until either side ends, then close both.
+fn join(a: TcpStream, b: TcpStream) -> io::Result<()> {
+    let (mut a_in, mut b_out) = (a.try_clone()?, b.try_clone()?);
+    let up = std::thread::Builder::new()
+        .name("horizon-tunnel-copy".into())
+        .spawn(move || {
+            let _ = io::copy(&mut a_in, &mut b_out);
+            let _ = b_out.shutdown(Shutdown::Both);
+            let _ = a_in.shutdown(Shutdown::Both);
+        })?;
+    let (mut b_in, mut a_out) = (b, a);
+    let _ = io::copy(&mut b_in, &mut a_out);
+    let _ = a_out.shutdown(Shutdown::Both);
+    let _ = b_in.shutdown(Shutdown::Both);
+    let _ = up.join();
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn hmac_matches_rfc_4231() {
+        // Test case 2: key "Jefe".
+        let mac = hmac_sha256(b"Jefe", b"what do ya want for nothing?");
+        let hex: String = mac.iter().map(|b| format!("{b:02x}")).collect();
+        assert_eq!(
+            hex,
+            "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
+        );
+        // Test case 6: a key longer than the block is hashed first.
+        let mac = hmac_sha256(
+            &[0xaa; 131],
+            b"Test Using Larger Than Block-Size Key - Hash Key First",
+        );
+        let hex: String = mac.iter().map(|b| format!("{b:02x}")).collect();
+        assert_eq!(
+            hex,
+            "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
+        );
+    }
+
+    #[test]
+    fn the_answer_is_bores() {
+        // bore: HMAC keyed by SHA-256 of the secret over the uuid's bytes.
+        let id = "67e55044-10b1-426f-9247-bb680e5fe0c8";
+        let key = Sha256::digest(b"secret");
+        let expected: String = hmac_sha256(&key, &uuid_bytes(id).unwrap())
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        assert_eq!(answer("secret", id).unwrap(), expected);
+        assert_eq!(answer("secret", id).unwrap().len(), 64);
+        assert_eq!(
+            uuid_bytes(id).unwrap(),
+            uuid_bytes("67e5504410b1426f9247bb680e5fe0c8").unwrap()
+        );
+        assert!(uuid_bytes("not-a-uuid").is_none());
+    }
+
+    #[test]
+    fn messages_are_bores_json() {
+        assert_eq!(
+            serde_json::to_string(&ToServer::Hello(0)).unwrap(),
+            r#"{"Hello":0}"#
+        );
+        assert_eq!(
+            serde_json::to_string(&ToServer::Accept("a-b".into())).unwrap(),
+            r#"{"Accept":"a-b"}"#
+        );
+        let mut input: &[u8] =
+            b"{\"Hello\":41234}\0\"Heartbeat\"\0{\"Connection\":\"x\"}\0{\"Error\":\"no\"}\0";
+        assert!(matches!(
+            recv(&mut input).unwrap(),
+            FromServer::Hello(41234)
+        ));
+        assert!(matches!(recv(&mut input).unwrap(), FromServer::Heartbeat));
+        assert!(matches!(recv(&mut input).unwrap(), FromServer::Connection(id) if id == "x"));
+        assert!(matches!(recv(&mut input).unwrap(), FromServer::Error(e) if e == "no"));
+        assert_eq!(
+            recv(&mut input).unwrap_err().kind(),
+            io::ErrorKind::UnexpectedEof
+        );
+        let long = [b'x'; 300];
+        assert_eq!(
+            recv(&mut &long[..]).unwrap_err().kind(),
+            io::ErrorKind::InvalidData
+        );
+    }
+
+    #[test]
+    fn settings() {
+        assert_eq!(
+            TunnelConfig::from_setting(None, None).unwrap().server,
+            "bore.pub"
+        );
+        assert_eq!(
+            TunnelConfig::from_setting(Some(" "), None).unwrap().server,
+            "bore.pub"
+        );
+        assert!(TunnelConfig::from_setting(Some("none"), None).is_none());
+        assert!(TunnelConfig::from_setting(Some("OFF"), None).is_none());
+        let own =
+            TunnelConfig::from_setting(Some("tcp://example.org:9000/"), Some(" s3 ")).unwrap();
+        assert_eq!(own.server, "example.org:9000");
+        assert_eq!(own.secret.as_deref(), Some("s3"));
+        assert_eq!(own.host(), "example.org");
+        assert_eq!(
+            TunnelConfig::from_setting(Some("bore.pub"), None)
+                .unwrap()
+                .host(),
+            "bore.pub"
+        );
+        assert_eq!(
+            TunnelConfig::from_setting(Some("[::1]:7835"), None)
+                .unwrap()
+                .host(),
+            "::1"
+        );
+        let local = TunnelConfig::from_setting(Some("127.0.0.1"), None).unwrap();
+        assert_eq!(
+            local.addresses().unwrap(),
+            vec![SocketAddr::from(([127, 0, 0, 1], CONTROL_PORT))]
+        );
+        let v6 = TunnelConfig::from_setting(Some("::1"), None).unwrap();
+        assert_eq!(v6.addresses().unwrap()[0].port(), CONTROL_PORT);
+    }
+}
