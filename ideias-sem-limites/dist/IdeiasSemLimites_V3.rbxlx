        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Fuzzy</string>
            <string name="Source"><![CDATA[--!strict
-- Correção simples de digitação: distância de Damerau–Levenshtein (variante OSA)
-- com corte antecipado. O vocabulário é agrupado por tamanho, então cada palavra
-- desconhecida é comparada só com candidatos de tamanho parecido.

local Fuzzy = {}

function Fuzzy.distance(a: string, b: string, maxDist: number): number
	local la, lb = #a, #b
	if math.abs(la - lb) > maxDist then
		return maxDist + 1
	end
	if a == b then
		return 0
	end
	local prevPrev: { number } = {}
	local prev: { number } = {}
	for j = 0, lb do
		prev[j] = j
	end
	for i = 1, la do
		local cur: { number } = { [0] = i }
		local rowMin = i
		local ai = string.byte(a, i)
		for j = 1, lb do
			local bj = string.byte(b, j)
			local cost = if ai == bj then 0 else 1
			local v = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
			if i > 1 and j > 1 and ai == string.byte(b, j - 1) and string.byte(a, i - 1) == bj then
				v = math.min(v, prevPrev[j - 2] + 1)
			end
			cur[j] = v
			if v < rowMin then
				rowMin = v
			end
		end
		if rowMin > maxDist then
			return maxDist + 1
		end
		prevPrev = prev
		prev = cur
	end
	return prev[lb]
end

-- tolerância conforme o tamanho da palavra
function Fuzzy.tolerance(word: string): number
	local n = #word
	if n < 4 then
		return 0
	elseif n <= 6 then
		return 1
	else
		return 2
	end
end

export type Index = { byLength: { [number]: { string } } }

function Fuzzy.buildIndex(words: { string }): Index
	local byLength: { [number]: { string } } = {}
	local seen: { [string]: boolean } = {}
	for _, w in words do
		if #w >= 3 and not seen[w] then
			seen[w] = true
			local bucket = byLength[#w]
			if not bucket then
				bucket = {}
				byLength[#w] = bucket
			end
			table.insert(bucket, w)
		end
	end
	for _, bucket in byLength do
		table.sort(bucket)
	end
	return { byLength = byLength }
end

-- melhor candidato; empate resolvido pela ordem alfabética (determinístico)
function Fuzzy.best(index: Index, word: string): (string?, number)
	local tol = Fuzzy.tolerance(word)
	if tol == 0 then
		return nil, math.huge
	end
	local bestWord: string? = nil
	local bestDist = tol + 1
	for len = #word - tol, #word + tol do
		local bucket = index.byLength[len]
		if bucket then
			for _, cand in bucket do
				-- exige a mesma primeira letra: reduz falsos positivos
				if string.byte(cand, 1) == string.byte(word, 1) then
					local d = Fuzzy.distance(word, cand, bestDist - 1)
					if d < bestDist then
						bestDist = d
						bestWord = cand
					end
				end
			end
		end
	end
	if bestWord then
		return bestWord, bestDist
	end
	return nil, math.huge
end

return Fuzzy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Inflect</string>
            <string name="Source"><![CDATA[--!strict
-- Morfologia simples (português + inglês) para palavras já sem acento:
-- plurais, diminutivos/aumentativos e prefixos como "mega", "mini", "robo".

local Inflect = {}

-- regras de plural em ordem de prioridade: {sufixo, substituto}
local PLURAL_RULES = {
	{ "oes", "ao" }, -- dragoes -> dragao
	{ "aes", "ao" }, -- caes -> cao, paes -> pao
	{ "aos", "ao" }, -- maos -> mao
	{ "ais", "al" }, -- animais -> animal
	{ "eis", "el" }, -- papeis -> papel
	{ "ois", "ol" }, -- farois -> farol
	{ "uis", "ul" },
	{ "is", "il" }, -- barris -> barril
	{ "ns", "m" }, -- homens -> homem
	{ "res", "r" }, -- flores -> flor
	{ "zes", "z" }, -- luzes -> luz
	{ "ses", "s" }, -- gases? -> gas
	{ "ies", "y" }, -- ponies -> pony
	{ "ves", "f" }, -- wolves -> wolf
	{ "es", "" }, -- boxes -> box
	{ "s", "" }, -- zumbis -> zumbi
}

function Inflect.singulars(word: string): { string }
	local out = {}
	if #word < 3 then
		return out
	end
	for _, rule in PLURAL_RULES do
		local suffix, repl = rule[1], rule[2]
		if #word > #suffix + 1 and string.sub(word, -#suffix) == suffix then
			table.insert(out, string.sub(word, 1, #word - #suffix) .. repl)
		end
	end
	return out
end

-- diminutivos e aumentativos: devolve {base, modificador}
local SIZE_SUFFIXES = {
	{ "zinhos", "", "small" },
	{ "zinhas", "", "small" },
	{ "zinho", "", "small" },
	{ "zinha", "", "small" },
	{ "inhos", "o", "small" },
	{ "inhas", "a", "small" },
	{ "inho", "o", "small" },
	{ "inha", "a", "small" },
	{ "zao", "", "giant" },
	{ "zona", "", "giant" },
	{ "ao", "o", "giant" }, -- gatao -> gato (só usado se a palavra original não existir)
	{ "ona", "a", "giant" },
}

function Inflect.sizeVariants(word: string): { { base: string, modifier: string } }
	local out = {}
	for _, rule in SIZE_SUFFIXES do
		local suffix, repl, mod = rule[1], rule[2], rule[3]
		if #word > #suffix + 2 and string.sub(word, -#suffix) == suffix then
			table.insert(out, { base = string.sub(word, 1, #word - #suffix) .. repl, modifier = mod })
		end
	end
	return out
end

-- prefixos que viram modificadores ("megadragao", "minirobo", "cyberzumbi")
local PREFIXES = {
	{ "mega", "giant" },
	{ "giga", "colossal" },
	{ "super", "giant" },
	{ "ultra", "colossal" },
	{ "hiper", "giant" },
	{ "hyper", "giant" },
	{ "mini", "small" },
	{ "micro", "tiny" },
	{ "robo", "robotic" },
	{ "cyber", "robotic" },
	{ "ciber", "robotic" },
	{ "mecha", "robotic" },
	{ "zumbi", "undead" },
	{ "zombie", "undead" },
	{ "neon", "neon" },
	{ "piro", "fire" },
	{ "crio", "ice" },
	{ "eletro", "electric" },
}

function Inflect.prefixVariants(word: string): { { base: string, modifier: string } }
	local out = {}
	for _, rule in PREFIXES do
		local prefix, mod = rule[1], rule[2]
		if #word >= #prefix + 3 and string.sub(word, 1, #prefix) == prefix then
			table.insert(out, { base = string.sub(word, #prefix + 1), modifier = mod })
		end
	end
	return out
end

return Inflect
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Normalizer</string>
            <string name="Source"><![CDATA[--!strict
-- Normalização de texto: minúsculas (inclusive letras acentuadas), remoção de
-- acentos, pontuação, letras repetidas ("gigaaante") e separação número/palavra.
-- O resultado contém apenas [a-z0-9], espaços e o marcador "," (lista/combinação).

local Normalizer = {}

-- segundo byte da sequência UTF-8 0xC3 0xNN -> letra ASCII
local LATIN1: { [number]: string } = {}
local function map(from: number, to: number, ascii: string)
	for b = from, to do
		LATIN1[b] = ascii
	end
end
map(0x80, 0x85, "a")
map(0xA0, 0xA5, "a")
map(0x86, 0x86, "ae")
map(0xA6, 0xA6, "ae")
map(0x87, 0x87, "c")
map(0xA7, 0xA7, "c")
map(0x88, 0x8B, "e")
map(0xA8, 0xAB, "e")
map(0x8C, 0x8F, "i")
map(0xAC, 0xAF, "i")
map(0x90, 0x90, "d")
map(0xB0, 0xB0, "d")
map(0x91, 0x91, "n")
map(0xB1, 0xB1, "n")
map(0x92, 0x96, "o")
map(0xB2, 0xB6, "o")
map(0x98, 0x98, "o")
map(0xB8, 0xB8, "o")
map(0x97, 0x97, " ")
map(0xB7, 0xB7, " ")
map(0x99, 0x9C, "u")
map(0xB9, 0xBC, "u")
map(0x9D, 0x9D, "y")
map(0xBD, 0xBD, "y")
map(0xBF, 0xBF, "y")
map(0x9E, 0x9E, "th")
map(0xBE, 0xBE, "th")
map(0x9F, 0x9F, "ss")

local function stripLatin(s: string): string
	return (string.gsub(s, "\xC3([\x80-\xBF])", function(c: string): string
		return LATIN1[string.byte(c)] or " "
	end))
end

-- reduz sequências de 3+ letras iguais para uma ("gigaaante" -> "gigante")
local function squeezeRuns(s: string): string
	local out = table.create(#s)
	local last, run = "", 0
	for i = 1, #s do
		local ch = string.sub(s, i, i)
		if ch == last and string.match(ch, "%a") then
			run += 1
		else
			last, run = ch, 1
		end
		out[#out + 1] = ch
		if run == 3 then
			-- remove as duas cópias anteriores, mantendo uma letra só
			out[#out] = nil
			out[#out] = nil
		elseif run > 3 then
			out[#out] = nil
		end
	end
	return table.concat(out)
end

function Normalizer.normalize(raw: string): string
	local s = string.lower(raw)
	s = stripLatin(s)
	-- qualquer outro caractere não ASCII (emoji, etc.) vira espaço
	s = string.gsub(s, "[\128-\255]+", " ")
	-- marcadores de combinação
	s = string.gsub(s, "[,;&%+/|]", " , ")
	-- apóstrofos somem ("dragon's" -> "dragons")
	s = string.gsub(s, "'", "")
	-- demais símbolos viram espaço
	s = string.gsub(s, "[^%w%s,]", " ")
	-- separa números colados em palavras ("100zumbis")
	s = string.gsub(s, "(%d)(%a)", "%1 %2")
	s = string.gsub(s, "(%a)(%d)", "%1 %2")
	s = squeezeRuns(s)
	s = string.gsub(s, "%s+", " ")
	s = string.gsub(s, "^ ", "")
	s = string.gsub(s, " $", "")
	return s
end

function Normalizer.tokens(raw: string, maxTokens: number?): { string }
	local norm = Normalizer.normalize(raw)
	local list = {}
	local limit = maxTokens or 32
	for word in string.gmatch(norm, "%S+") do
		-- vírgulas repetidas viram uma só
		if not (word == "," and list[#list] == ",") then
			list[#list + 1] = word
		end
		if #list >= limit then
			break
		end
	end
	-- remove vírgulas nas pontas
	while list[1] == "," do
		table.remove(list, 1)
	end
	while list[#list] == "," do
		list[#list] = nil
	end
	return list
end

-- Limpeza de segurança do texto bruto enviado pelo cliente (antes de qualquer uso)
function Normalizer.sanitize(raw: string, maxLen: number): string?
	if type(raw) ~= "string" then
		return nil
	end
	if utf8.len(raw) == nil then
		return nil -- UTF-8 inválido
	end
	-- remove caracteres de controle
	local s = string.gsub(raw, "[%c]", " ")
	s = string.gsub(s, "%s+", " ")
	s = string.gsub(s, "^ ", "")
	s = string.gsub(s, " $", "")
	if #s == 0 then
		return nil
	end
	-- corta respeitando limites de caracteres UTF-8
	if (utf8.len(s) or 0) > maxLen then
		local cut = utf8.offset(s, maxLen + 1)
		if cut then
			s = string.sub(s, 1, cut - 1)
		end
	end
	return s
end

return Normalizer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Numbers</string>
            <string name="Source"><![CDATA[--!strict
-- Reconhece quantidades escritas com dígitos ou por extenso (PT/EN).

local Numbers = {}

local WORDS: { [string]: number } = {
	-- português (sem acento)
	um = 1,
	uma = 1,
	dois = 2,
	duas = 2,
	tres = 3,
	quatro = 4,
	cinco = 5,
	seis = 6,
	sete = 7,
	oito = 8,
	nove = 9,
	dez = 10,
	onze = 11,
	doze = 12,
	quinze = 15,
	vinte = 20,
	trinta = 30,
	quarenta = 40,
	cinquenta = 50,
	cem = 100,
	cento = 100,
	mil = 1000,
	milhao = 1000000,
	milhoes = 1000000,
	bilhao = 1000000000,
	-- inglês
	one = 1,
	two = 2,
	three = 3,
	four = 4,
	five = 5,
	six = 6,
	seven = 7,
	eight = 8,
	nine = 9,
	ten = 10,
	twelve = 12,
	twenty = 20,
	fifty = 50,
	hundred = 100,
	thousand = 1000,
	million = 1000000,
	dozen = 12,
	duzia = 12,
}

function Numbers.parse(token: string): number?
	if string.match(token, "^%d+$") then
		if #token > 9 then
			return 999999999
		end
		return tonumber(token)
	end
	return WORDS[token]
end

-- "um"/"uma"/"one" funcionam como artigo: não devem ser tratados como pedido de quantidade
function Numbers.isArticle(token: string): boolean
	return token == "um" or token == "uma" or token == "one"
end

return Numbers
]]></string>
          </Properties>
        </Item>
