        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Powers</string>
            <string name="Source"><![CDATA[--!strict
-- Poderes aplicados ao próprio jogador (handler "power") e ferramentas que vão
-- para a mochila (handler "tool"). Ferramentas usam mira automática (bom no celular).

local function pw(handler: string, id: string, label: string, gender: string, aliases: { string }, params: { [string]: any }, tags: { string }, extra: { [string]: any }?)
	local def: { [string]: any } = {
		id = id,
		label = label,
		gender = gender,
		category = if handler == "tool" then "tool" else "power",
		handler = handler,
		aliases = aliases,
		params = params,
		tags = tags,
		maxCount = 1,
		lifetime = if handler == "tool" then 90 else 20,
	}
	if extra then
		for k, v in extra do
			def[k] = v
		end
	end
	return def
end

return {
	-- PODERES ----------------------------------------------------------------
	pw("power", "heal", "Cura", "f", { "cura", "curar", "heal", "healing", "vida", "life", "saude", "health", "regenerar", "remedio", "pocao de vida", "medkit", "kit medico" }, { kind = "heal" }, { "good" }),
	pw("power", "power_speed", "Super Velocidade", "f", { "velocidade", "speed", "super velocidade", "correr", "run", "corrida", "flash", "supersonico" }, { kind = "speed" }, { "good" }),
	pw("power", "super_jump", "Super Pulo", "m", { "super pulo", "pulo", "jump", "pular", "salto", "super jump", "mola nos pes", "pernas de mola" }, { kind = "jump" }, { "good" }),
	pw("power", "power_fly", "Voo", "m", { "voar", "voo", "fly", "flight", "levitar", "levitacao", "jetpack", "mochila a jato", "asas", "wings" }, { kind = "fly" }, { "good", "flying" }),
	pw("power", "power_giant", "Ficar Gigante", "m", { "crescer", "grow", "aumentar", "ficar gigante", "ficar grande", "growth" }, { kind = "giant" }, { "good" }),
	pw("power", "power_tiny", "Ficar Pequeno", "m", { "encolher", "shrink", "diminuir", "ficar pequeno", "formiga humana", "homem formiga" }, { kind = "tiny" }, { "good" }),
	pw("power", "invisible", "Invisibilidade", "f", { "invisivel", "invisibilidade", "invisible", "invisibility", "sumir de vista", "camuflagem", "camouflage", "furtividade" }, { kind = "invisible" }, { "magic" }),
	pw("power", "shield", "Escudo de Energia", "m", { "escudo", "shield", "campo de forca", "force field", "forcefield", "protecao", "protection", "imortal", "invencivel", "invincible", "armadura", "armor", "bolha" }, { kind = "shield" }, { "good" }),
	pw("power", "teleport", "Teletransporte", "m", { "teleporte", "teletransporte", "teleport", "teleportar", "warp", "viajar", "travel" }, { kind = "teleport" }, { "magic" }),
	pw("power", "clone", "Clones", "m", { "clone", "clones", "clonar", "copia", "duplicar", "sosia", "doppelganger" }, { kind = "clone" }, { "magic" }),
	pw("power", "time_stop", "Parar o Tempo", "m", { "parar o tempo", "pausar", "pause", "time stop", "congelar o tempo", "the world", "zawarudo", "tempo parado" }, { kind = "time_stop" }, { "magic", "time" }, { lifetime = 8 }),
	pw("power", "slowmo", "Câmera Lenta", "f", { "camera lenta", "slow motion", "slowmo", "tempo lento", "matrix", "bullet time" }, { kind = "slowmo" }, { "magic", "time" }, { lifetime = 12 }),
	pw("power", "pet", "Mascote", "m", { "mascote", "bichinho de estimacao", "animal de estimacao", "companheiro", "companion", "parceiro", "sidekick" }, { kind = "pet" }, { "good", "cute" }),
	pw("power", "aura", "Aura Brilhante", "f", { "aura", "brilho", "glow", "brilhar", "poder maximo", "power up", "energia", "energy" }, { kind = "aura" }, { "good", "magic" }, { lifetime = 30 }),
	pw("power", "cape", "Capa de Herói", "f", { "capa", "cape", "manto", "cloak", "uniforme de heroi" }, { kind = "cape" }, { "good", "clothing" }, { lifetime = 60 }),
	pw("power", "potion", "Poção Misteriosa", "f", { "pocao", "potion", "elixir", "pocao magica", "frasco", "veneno magico" }, { kind = "potion" }, { "magic" }),

	-- FERRAMENTAS ------------------------------------------------------------
	pw("tool", "sword", "Espada", "f", { "espada", "sword", "katana", "sabre", "lamina", "blade", "adaga", "dagger", "faca", "machado", "axe" }, { kind = "sword", dmg = 30 }, { "weapon" }),
	pw("tool", "hammer", "Martelo", "m", { "martelo", "hammer", "marreta", "mjolnir", "martelo de thor", "clava", "porrete", "bastao de beisebol" }, { kind = "hammer", dmg = 40 }, { "weapon" }),
	pw("tool", "wand", "Varinha Mágica", "f", { "varinha", "varinha magica", "wand", "magic wand", "cajado", "staff", "cetro", "bastao magico" }, { kind = "wand", dmg = 22, element = "light" }, { "weapon", "magic" }),
	pw("tool", "blaster", "Blaster Laser", "m", { "blaster", "laser", "arma laser", "pistola laser", "raygun", "ray gun", "canhao de plasma", "arma", "pistola", "gun", "rifle", "metralhadora" }, { kind = "blaster", dmg = 18, element = "electric" }, { "weapon", "science" }),
	pw("tool", "bow", "Arco e Flecha", "m", { "arco e flecha", "arco", "bow", "flecha", "arrow", "besta", "crossbow", "estilingue", "slingshot" }, { kind = "bow", dmg = 24 }, { "weapon" }),
	pw("tool", "snowball", "Bolas de Neve", "f", { "bola de neve", "bolas de neve", "snowball", "guerra de neve" }, { kind = "snowball", dmg = 8, element = "ice" }, { "weapon", "ice", "fun" }),
	pw("tool", "water_gun", "Pistola de Água", "f", { "pistola de agua", "arma de agua", "water gun", "super soaker", "hose", "extintor", "extinguisher" }, { kind = "water_gun", dmg = 6, element = "water" }, { "weapon", "water", "fun" }),
	pw("tool", "flamethrower", "Lança-chamas", "m", { "lanca chamas", "flamethrower", "bafo de dragao", "maçarico", "macarico" }, { kind = "flamethrower", dmg = 10, element = "fire" }, { "weapon", "fire" }),
	pw("tool", "grapple", "Gancho", "m", { "gancho", "grappling hook", "gancho de escalada", "teia", "web", "teia de aranha", "spider web", "corda", "rope" }, { kind = "grapple" }, { "utility" }),
	pw("tool", "pickaxe", "Picareta", "f", { "picareta", "pickaxe", "pa", "shovel", "furadeira", "drill", "britadeira" }, { kind = "hammer", dmg = 26 }, { "weapon", "utility" }),
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Progression</string>
            <string name="Source"><![CDATA[--!strict
-- Conquistas, missões e recompensas cosméticas (dados compartilhados:
-- o servidor valida e o cliente mostra a lista). Nada exige Robux.

local Progression = {}

-- stat: contador do perfil; goal: valor para desbloquear
Progression.Achievements = {
	{ id = "first_idea", title = "Primeira Ideia", desc = "Crie sua primeira ideia.", stat = "created", goal = 1, reward = 5 },
	{ id = "ideas_25", title = "Mente Inquieta", desc = "Crie 25 ideias.", stat = "created", goal = 25, reward = 20 },
	{ id = "ideas_100", title = "Fábrica de Ideias", desc = "Crie 100 ideias.", stat = "created", goal = 100, reward = 60 },
	{ id = "ideas_500", title = "Sem Limites", desc = "Crie 500 ideias.", stat = "created", goal = 500, reward = 200 },
	{ id = "discover_10", title = "Explorador de Palavras", desc = "Descubra 10 conceitos.", stat = "discovered", goal = 10, reward = 15 },
	{ id = "discover_50", title = "Dicionário Vivo", desc = "Descubra 50 conceitos.", stat = "discovered", goal = 50, reward = 50 },
	{ id = "discover_120", title = "Enciclopédia", desc = "Descubra 120 conceitos.", stat = "discovered", goal = 120, reward = 150 },
	{ id = "secret_1", title = "Combinação Secreta", desc = "Encontre uma combinação secreta.", stat = "secrets", goal = 1, reward = 20 },
	{ id = "secret_10", title = "Mestre dos Segredos", desc = "Encontre 10 combinações secretas.", stat = "secrets", goal = 10, reward = 120 },
	{ id = "combo_5", title = "Alquimista", desc = "Combine duas ideias 5 vezes.", stat = "combos", goal = 5, reward = 20 },
	{ id = "kills_10", title = "Defensor", desc = "Derrote 10 inimigos (você ou seus aliados).", stat = "kills", goal = 10, reward = 25 },
	{ id = "kills_100", title = "Lenda da Arena", desc = "Derrote 100 inimigos.", stat = "kills", goal = 100, reward = 120 },
	{ id = "surprise_10", title = "Caixinha de Surpresas", desc = "Gere 10 surpresas com palavras desconhecidas.", stat = "surprises", goal = 10, reward = 20 },
	{ id = "regions_all", title = "Viajante", desc = "Visite todas as regiões do mapa.", stat = "regions", goal = 9, reward = 60 },
	{ id = "eat_10", title = "Comilão", desc = "Coma 10 comidas criadas.", stat = "eat", goal = 10, reward = 15 },
	{ id = "colossal", title = "Pensando Grande", desc = "Crie algo colossal.", stat = "colossal", goal = 1, reward = 15 },
}

-- missões rotativas (3 por sessão)
Progression.Quests = {
	{ id = "q_creatures", title = "Crie 3 criaturas", stat = "q_creature", goal = 3, reward = 15 },
	{ id = "q_disaster", title = "Crie 2 desastres", stat = "q_disaster", goal = 2, reward = 15 },
	{ id = "q_ice", title = "Crie algo de gelo", stat = "q_ice", goal = 1, reward = 10 },
	{ id = "q_fire", title = "Crie algo de fogo", stat = "q_fire", goal = 1, reward = 10 },
	{ id = "q_versus", title = "Use \"contra\" para criar uma batalha", stat = "q_versus", goal = 1, reward = 15 },
	{ id = "q_kills", title = "Derrote 5 inimigos", stat = "q_kills", goal = 5, reward = 20 },
	{ id = "q_food", title = "Crie 2 comidas", stat = "q_food", goal = 2, reward = 10 },
	{ id = "q_vehicle", title = "Crie um veículo e dirija", stat = "q_vehicle", goal = 1, reward = 10 },
	{ id = "q_visit_volcano", title = "Visite a Região Vulcânica", stat = "q_visit_volcano", goal = 1, reward = 10 },
	{ id = "q_visit_glacier", title = "Visite a Região Glacial", stat = "q_visit_glacier", goal = 1, reward = 10 },
	{ id = "q_discover", title = "Descubra 3 palavras novas", stat = "q_discover", goal = 3, reward = 15 },
	{ id = "q_building", title = "Construa 2 construções", stat = "q_building", goal = 2, reward = 10 },
	{ id = "q_brazil", title = "Crie algo do folclore ou da comida brasileira", stat = "q_brazil", goal = 1, reward = 15 },
}

-- cosméticos comprados com Faíscas (ganhas jogando)
Progression.Cosmetics = {
	{ id = "trail_blue", kind = "trail", title = "Rastro Azul", price = 20, colors = { { 80, 200, 255 }, { 120, 120, 255 } } },
	{ id = "trail_fire", kind = "trail", title = "Rastro de Fogo", price = 40, colors = { { 255, 220, 80 }, { 255, 80, 30 } } },
	{ id = "trail_rainbow", kind = "trail", title = "Rastro Arco-íris", price = 80, colors = { { 255, 70, 70 }, { 255, 230, 60 }, { 80, 220, 90 }, { 70, 160, 255 }, { 150, 90, 255 } } },
	{ id = "trail_gold", kind = "trail", title = "Rastro Dourado", price = 120, colors = { { 255, 240, 160 }, { 255, 190, 40 } } },
	{ id = "title_creator", kind = "title", title = "Criador", price = 10 },
	{ id = "title_dragon", kind = "title", title = "Domador de Dragões", price = 50 },
	{ id = "title_chaos", kind = "title", title = "Mestre do Caos", price = 60 },
	{ id = "title_genius", kind = "title", title = "Gênio das Ideias", price = 100 },
	{ id = "title_legend", kind = "title", title = "Lenda Sem Limites", price = 250 },
	{ id = "aura_sparkle", kind = "aura", title = "Aura Brilhante", price = 70, colors = { { 255, 240, 150 } } },
	{ id = "aura_shadow", kind = "aura", title = "Aura Sombria", price = 90, colors = { { 120, 60, 200 } } },
}

Progression.CosmeticById = {} :: { [string]: any }
for _, c in Progression.Cosmetics do
	Progression.CosmeticById[c.id] = c
end
Progression.QuestById = {} :: { [string]: any }
for _, q in Progression.Quests do
	Progression.QuestById[q.id] = q
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Secrets</string>
            <string name="Source"><![CDATA[--!strict
-- Combinações secretas: descobertas especiais que dão título e Faíscas.
-- match:
--   concept   id do conceito de algum acontecimento do plano
--   mods      modificadores exigidos nesse acontecimento
--   payload   conceito carregado ("tornado de tubarões")
--   rain      true se for "chuva de ..."
--   concepts  lista de conceitos presentes no mesmo plano
--   link      tipo de vínculo exigido entre os conceitos da lista
--   minRequested  quantidade mínima pedida (antes do limite de desempenho)

export type Secret = {
	id: string,
	title: string,
	hint: string,
	reward: number,
	match: { [string]: any },
}

local secrets: { Secret } = {
	{ id = "golden_dragon", title = "Tesouro Alado", hint = "Um dragão feito de riqueza.", reward = 40, match = { concept = "dragon", mods = { "gold" } } },
	{ id = "winter_lord", title = "Senhor do Inverno", hint = "O maior dragão do frio.", reward = 60, match = { concept = "dragon", mods = { "ice", "giant" } } },
	{ id = "mecha_dragon", title = "Dragão Mecânico", hint = "Escamas de aço.", reward = 40, match = { concept = "dragon", mods = { "robotic" } } },
	{ id = "sharknado", title = "Tubarnado", hint = "Um tornado com recheio perigoso.", reward = 60, match = { concept = "tornado", payload = "shark" } },
	{ id = "pizza_rain", title = "Pizzaria Celeste", hint = "Quando o céu tem fome.", reward = 30, match = { concept = "pizza", rain = true } },
	{ id = "coxinha_rain", title = "Lanche Brasileiro", hint = "Chove salgado na festa.", reward = 30, match = { concept = "coxinha", rain = true } },
	{ id = "light_vs_dark", title = "Luz contra Trevas", hint = "A batalha mais antiga.", reward = 50, match = { concepts = { "hero", "demon" }, link = "rivals" } },
	{ id = "castle_guardian", title = "Guardião do Castelo", hint = "Asas que protegem muralhas.", reward = 60, match = { concepts = { "dragon", "castle" }, link = "guard" } },
	{ id = "zombie_king", title = "Rei dos Mortos", hint = "Toda horda precisa de um líder.", reward = 40, match = { concept = "zombie", mods = { "boss" } } },
	{ id = "mechasaur", title = "Mecassauro", hint = "Pré-história com bateria.", reward = 40, match = { concept = "dinosaur", mods = { "robotic" } } },
	{ id = "glacial_comet", title = "Cometa Glacial", hint = "Um impacto que congela.", reward = 30, match = { concept = "meteor", mods = { "ice" } } },
	{ id = "apocalypse", title = "Apocalipse", hint = "Peça zumbis demais.", reward = 50, match = { concept = "zombie", minRequested = 50 } },
	{ id = "flying_cow", title = "Mu-Voadora", hint = "Uma vaca que desafia a gravidade.", reward = 30, match = { concept = "cow", mods = { "flying" } } },
	{ id = "chickenzilla", title = "Galinhazilla", hint = "Cocoricó colossal.", reward = 40, match = { concept = "chicken", mods = { "colossal" } } },
	{ id = "burning_soul", title = "Alma Ardente", hint = "Um espírito em chamas.", reward = 30, match = { concept = "ghost", mods = { "fire" } } },
	{ id = "pure_magic", title = "Magia Pura", hint = "Um unicórnio com todas as cores.", reward = 40, match = { concept = "unicorn", mods = { "rainbow" } } },
	{ id = "fire_and_ice", title = "Fogo e Gelo", hint = "Dois opostos de uma vez.", reward = 40, match = { concepts = { "fire", "ice_burst" } } },
	{ id = "sweet_hole", title = "Buraco Doce", hint = "Um buraco negro com gosto bom.", reward = 40, match = { concept = "black_hole", payload = "chocolate" } },
	{ id = "capybara_army", title = "Exército da Paz", hint = "Muitas capivaras tranquilas.", reward = 40, match = { concept = "capybara", minRequested = 8 } },
	{ id = "saci_storm", title = "Redemoinho do Saci", hint = "O saci adora vento.", reward = 40, match = { concepts = { "saci", "tornado" } } },
	{ id = "classic_rivalry", title = "Rivalidade Clássica", hint = "Gato e cachorro, de novo.", reward = 30, match = { concepts = { "cat", "dog" }, link = "rivals" } },
	{ id = "golden_throne", title = "Trono de Ouro", hint = "O banheiro mais caro do mundo.", reward = 30, match = { concept = "toilet", mods = { "gold" } } },
	{ id = "party_dino", title = "Dino Baladeiro", hint = "Até dinossauros dançam.", reward = 30, match = { concept = "dinosaur", mods = { "dancing" } } },
	{ id = "dragon_rider", title = "Cavaleiro de Dragão", hint = "Alguém montando um dragão.", reward = 50, match = { concepts = { "knight", "dragon" }, link = "ride" } },
	{ id = "pet_dragon", title = "Dragão de Estimação", hint = "O mascote mais perigoso.", reward = 50, match = { concept = "dragon", mods = { "pet" } } },
	{ id = "cheese_moon", title = "Lua de Queijo", hint = "Diziam que era feita disso.", reward = 30, match = { concepts = { "moon", "cheese" } } },
	{ id = "lava_shark", title = "Tubarão Vulcânico", hint = "Nadando no magma.", reward = 30, match = { concept = "shark", mods = { "lava" } } },
	{ id = "tiny_whale", title = "Baleia de Bolso", hint = "O maior animal, bem pequeno.", reward = 30, match = { concept = "whale", mods = { "tiny" } } },
	-- cadeias, híbridos e personagens por nome
	{ id = "absurd_chain", title = "Reação em Cadeia", hint = "Uma coisa que solta outra, que solta outra...", reward = 40, match = { chainDepth = 3 } },
	{ id = "dog_launcher", title = "Lança-Cachorro", hint = "Uma arma com munição de quatro patas.", reward = 30, match = { action = { verb = "shoot", target = "dog" } } },
	{ id = "mad_lab", title = "Laboratório Maluco", hint = "Misture dois bichos numa palavra só.", reward = 25, match = { fusion = true } },
	{ id = "energy_clash", title = "Choque de Energia", hint = "Dois guerreiros de energia frente a frente.", reward = 35, match = { concepts = { "energy_warrior", "energy_tyrant" }, link = "rivals" } },
	{ id = "one_punch", title = "Um Soco Basta", hint = "O herói careca contra um monstro gigante.", reward = 35, match = { concepts = { "bald_hero", "kaiju" }, link = "rivals" } },
	{ id = "brainrot_party", title = "Festa Absurda", hint = "Junte dois memes absurdos.", reward = 30, match = { concepts = { "tum_tum_log", "skate_shark" } } },
}

return secrets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Vehicles</string>
            <string name="Source"><![CDATA[--!strict
-- Veículos (handler "vehicle"). drive: ground | air | water | rocket
-- Veículos terrestres e aquáticos podem ser dirigidos (assento VehicleSeat);
-- aéreos fazem um voo panorâmico automático quando alguém senta.

local function veh(id: string, label: string, gender: string, aliases: { string }, params: { [string]: any }, tags: { string }, extra: { [string]: any }?)
	local def: { [string]: any } = {
		id = id,
		label = label,
		gender = gender,
		category = "vehicle",
		handler = "vehicle",
		aliases = aliases,
		params = params,
		tags = tags,
		maxCount = 3,
		lifetime = 90,
	}
	if extra then
		for k, v in extra do
			def[k] = v
		end
	end
	return def
end

return {
	veh("car", "Carro", "m", { "carro", "car", "automovel", "fusca", "kart", "taxi", "jipe", "jeep", "suv" }, { model = "vehicle", variant = "car", drive = "ground", speed = 70 }, { "machine", "vehicle" }),
	veh("sportscar", "Carro Esportivo", "m", { "carro esportivo", "esportivo", "ferrari", "lamborghini", "supercarro", "carro de corrida", "race car", "formula 1" }, { model = "vehicle", variant = "sportscar", drive = "ground", speed = 110 }, { "machine", "vehicle" }),
	veh("police_car", "Viatura", "f", { "viatura", "carro de policia", "police car", "camburao" }, { model = "vehicle", variant = "police_car", drive = "ground", speed = 85 }, { "machine", "vehicle", "good" }),
	veh("truck", "Caminhão", "m", { "caminhao", "truck", "carreta", "jamanta", "caminhonete", "pickup" }, { model = "vehicle", variant = "truck", drive = "ground", speed = 55 }, { "machine", "vehicle" }),
	veh("firetruck", "Caminhão de Bombeiros", "m", { "caminhao de bombeiros", "carro de bombeiro", "fire truck", "firetruck" }, { model = "vehicle", variant = "firetruck", drive = "ground", speed = 60, element = "water" }, { "machine", "vehicle", "good", "water" }),
	veh("bus", "Ônibus", "m", { "onibus", "bus", "busao", "micro onibus" }, { model = "vehicle", variant = "bus", drive = "ground", speed = 50 }, { "machine", "vehicle" }),
	veh("tractor", "Trator", "m", { "trator", "tractor", "colheitadeira", "escavadeira", "retroescavadeira", "excavator" }, { model = "vehicle", variant = "tractor", drive = "ground", speed = 35 }, { "machine", "vehicle", "farm" }),
	veh("tank", "Tanque", "m", { "tanque", "tank", "tanque de guerra", "blindado de guerra" }, { model = "vehicle", variant = "tank", drive = "ground", speed = 40 }, { "machine", "vehicle" }),
	veh("motorcycle", "Moto", "f", { "moto", "motocicleta", "motorcycle", "motorbike", "lambreta", "scooter", "bicicleta", "bike", "bicycle", "bike motorizada" }, { model = "vehicle", variant = "motorcycle", drive = "ground", speed = 90 }, { "machine", "vehicle" }),
	veh("boat", "Barco", "m", { "barco", "boat", "lancha", "canoa", "jangada", "bote", "caiaque" }, { model = "vehicle", variant = "boat", drive = "water", speed = 60 }, { "machine", "vehicle", "water" }),
	veh("ship", "Navio Pirata", "m", { "navio", "ship", "navio pirata", "caravela", "galeao", "pirate ship", "embarcacao" }, { model = "vehicle", variant = "ship", drive = "water", speed = 40 }, { "machine", "vehicle", "water" }, { maxCount = 1 }),
	veh("plane", "Avião", "m", { "aviao", "plane", "airplane", "aeronave", "jato", "jet", "caca", "teco teco" }, { model = "vehicle", variant = "plane", drive = "air", speed = 90 }, { "machine", "vehicle", "flying" }),
	veh("helicopter", "Helicóptero", "m", { "helicoptero", "helicopter", "heli", "chopper" }, { model = "vehicle", variant = "helicopter", drive = "air", speed = 60 }, { "machine", "vehicle", "flying" }),
	veh("rocket", "Foguete", "m", { "foguete", "rocket", "missil", "missile", "onibus espacial", "space shuttle" }, { model = "vehicle", variant = "rocket", drive = "rocket", speed = 120 }, { "machine", "vehicle", "flying", "space" }, { lifetime = 45 }),
	veh("spaceship", "Nave Espacial", "f", { "nave espacial", "nave", "spaceship", "starship", "nave estelar", "spacecraft" }, { model = "vehicle", variant = "spaceship", drive = "air", speed = 100 }, { "machine", "vehicle", "flying", "space" }),
	veh("balloon_air", "Balão de Ar Quente", "m", { "balao de ar quente", "hot air balloon", "dirigivel", "zepelim", "zeppelin", "blimp" }, { model = "vehicle", variant = "hot_air_balloon", drive = "air", speed = 25 }, { "vehicle", "flying" }),
	veh("train", "Trem", "m", { "trem", "train", "locomotiva", "maria fumaca", "metro", "subway" }, { model = "vehicle", variant = "train", drive = "ground", speed = 50 }, { "machine", "vehicle" }, { maxCount = 1 }),
	veh("skateboard", "Skate", "m", { "skate", "skateboard", "hoverboard", "patinete" }, { model = "vehicle", variant = "skateboard", drive = "ground", speed = 75 }, { "vehicle", "sport" }),
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Configuração central do "Ideias Sem Limites" (V3).
-- Todos os limites de desempenho e segurança ficam aqui para facilitar ajustes.

local Config = {}

Config.Version = "3.0.0"
Config.WorldSeed = 20261109

-- Pedidos dos jogadores ------------------------------------------------------
Config.Request = {
	Cooldown = 3.0, -- segundos entre ideias do mesmo jogador
	MaxTextLength = 120, -- caracteres aceitos depois da limpeza (frases com cadeias de ação)
	MaxRawLength = 200, -- acima disso o pedido é descartado sem processar
	MaxTokens = 24, -- palavras analisadas por pedido
	MaxGroups = 4, -- ideias combinadas em um único pedido (inclui elos de cadeia)
	SpamWindow = 10, -- janela (s) para detectar spam de RemoteEvent
	SpamMaxRequests = 7, -- pedidos permitidos na janela antes do bloqueio
	SpamMute = 15, -- bloqueio temporário (s) após spam
	GlobalWindow = 2, -- janela (s) do limite global do servidor
	GlobalMaxRequests = 10, -- ideias executadas por janela no servidor inteiro
}

-- Orçamento do mundo ---------------------------------------------------------
Config.Budget = {
	events = 12, -- acontecimentos simultâneos
	npcs = 28, -- NPCs vivos ao mesmo tempo
	dynamic = 240, -- partes físicas soltas (meteoros, objetos caindo, destroços)
	effects = 80, -- emissores de partículas, luzes e feixes
	parts = 3200, -- partes estáticas criadas por acontecimentos
	perPlayer = 3, -- acontecimentos ativos por jogador
	recycleMinAge = 8, -- idade mínima (s) para reciclar o acontecimento mais antigo
}

Config.Limits = {
	NpcPerEvent = 12,
	MaxScale = 6,
	MinScale = 0.25,
	DefaultLifetime = 60,
	MaxLifetime = 150,
	SpawnDistance = 18, -- distância à frente do jogador
}

Config.Combat = {
	PvP = false, -- jogadores não causam dano entre si
	PlayerDamageScale = 1.0,
	NpcThinkInterval = 0.3,
	PathRecomputeInterval = 1.6,
	TargetRange = 120,
}

Config.World = {
	DayLengthMinutes = 18, -- duração de um ciclo dia/noite completo
	RestoreDelay = 28, -- tempo até partes destruídas do mapa voltarem
	AmbientEventInterval = 75, -- acontecimentos ambientais aleatórios
}

Config.Data = {
	StoreName = "IdeiasPerfil_v3",
	AutosaveInterval = 120,
	MaxFavorites = 20,
	MaxHistory = 15,
}

-- Sons: arquivos embutidos no cliente Roblox (rbxasset://). Podem ser trocados por
-- IDs da Loja de Criadores (rbxassetid://...) sem mexer no resto do código.
Config.Sounds = {
	Click = "rbxasset://sounds/electronicpingshort.wav",
	Create = "rbxasset://sounds/electronicpingshort.wav",
	Error = "rbxasset://sounds/button.wav",
	Whoosh = "rbxasset://sounds/swoosh.wav",
	Impact = "rbxasset://sounds/collide.wav",
	Splash = "rbxasset://sounds/impact_water.mp3",
	Rocket = "rbxasset://sounds/Rocket shot.wav",
	Ghost = "rbxasset://sounds/HalloweenGhost.wav",
	Glass = "rbxasset://sounds/glassbreak.wav",
	Splat = "rbxasset://sounds/splat.wav",
	Hit = "rbxasset://sounds/hit.wav",
	Snap = "rbxasset://sounds/snap.wav",
}

-- Efeitos sonoros gerados no ElevenLabs, juntos num único áudio ("sprite").
-- `bash ideias.sh sons` envia o arquivo ao Roblox e grava o ID aqui (marcador).
-- Com Id = 0 o jogo usa os sons embutidos do Roblox (fallback de cada efeito).
Config.SoundSprite = {
	Id = 0, --@@SPRITE_ID@@
	Regions = {
		explosion = { 0.0, 1.0 },
		create = { 1.3, 2.3 },
		error = { 2.6, 3.6 },
		punch = { 3.9, 4.546 },
		charge = { 4.846, 5.739 },
		beam = { 6.039, 7.039 },
		laser = { 7.339, 8.139 },
		roar = { 8.439, 10.239 },
		fart = { 10.539, 11.639 },
	},
}

-- efeito -> trecho do sprite (sprite) ou som embutido (fallback)
Config.SoundCues = {
	explosion = { sprite = "explosion", fallback = "rbxasset://sounds/collide.wav", volume = 1 },
	create = { sprite = "create", fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.55 },
	error = { sprite = "error", fallback = "rbxasset://sounds/button.wav", volume = 0.45 },
	punch = { sprite = "punch", fallback = "rbxasset://sounds/swordlunge.wav", volume = 0.9 },
	charge = { sprite = "charge", fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.8 },
	beam = { sprite = "beam", fallback = "rbxasset://sounds/Rocket shot.wav", volume = 0.9 },
	laser = { sprite = "laser", fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6 },
	roar = { sprite = "roar", fallback = "rbxasset://sounds/HalloweenGhost.wav", volume = 0.8 },
	fart = { sprite = "fart", fallback = "rbxasset://sounds/splat.wav", volume = 0.8 },
	poof = { fallback = "rbxasset://sounds/swoosh.wav", volume = 0.4 },
	launch = { fallback = "rbxasset://sounds/swoosh.wav", volume = 0.8 },
	splash = { fallback = "rbxasset://sounds/impact_water.mp3", volume = 0.7 },
	crack = { fallback = "rbxasset://sounds/glassbreak.wav", volume = 0.6 },
	hiss = { fallback = "rbxasset://sounds/snap.wav", volume = 0.6 },
	holy = { sprite = "create", fallback = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, speed = 0.7 },
	drum = { sprite = "punch", fallback = "rbxasset://sounds/collide.wav", volume = 1, speed = 0.65 },
}

Config.Textures = {
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">FxPaths</string>
          <string name="Source"><![CDATA[--!strict
-- Trajetórias determinísticas dos desastres que se movem.
-- O servidor usa estas funções para aplicar dano/empurrões; os clientes usam
-- as MESMAS funções para desenhar o visual localmente (suave e sem tráfego).
-- Parâmetros vêm dos atributos da pasta do acontecimento (FxPos, FxVel, FxT0...).

local FxPaths = {}

export type Spec = {
	pos: Vector3,
	vel: Vector3,
	t0: number,
	dur: number,
	radius: number,
	height: number,
	seed: number,
	power: number,
}

function FxPaths.fromFolder(folder: Instance): Spec
	return {
		pos = folder:GetAttribute("FxPos") :: Vector3 or Vector3.zero,
		vel = folder:GetAttribute("FxVel") :: Vector3 or Vector3.zero,
		t0 = folder:GetAttribute("FxT0") :: number or 0,
		dur = folder:GetAttribute("FxDur") :: number or 10,
		radius = folder:GetAttribute("FxRadius") :: number or 10,
		height = folder:GetAttribute("FxHeight") :: number or 40,
		seed = folder:GetAttribute("FxSeed") :: number or 0,
		power = folder:GetAttribute("FxPower") :: number or 1,
	}
end

function FxPaths.write(folder: Instance, kind: string, spec: Spec, element: string?)
	folder:SetAttribute("FxKind", kind)
	folder:SetAttribute("FxPos", spec.pos)
	folder:SetAttribute("FxVel", spec.vel)
	folder:SetAttribute("FxT0", spec.t0)
	folder:SetAttribute("FxDur", spec.dur)
	folder:SetAttribute("FxRadius", spec.radius)
	folder:SetAttribute("FxHeight", spec.height)
	folder:SetAttribute("FxSeed", spec.seed)
	folder:SetAttribute("FxPower", spec.power)
	if element then
		folder:SetAttribute("FxElement", element)
	end
end

-- tornado: avança na direção de vel e serpenteia lateralmente
function FxPaths.tornado(s: Spec, t: number): Vector3
	local dt = math.clamp(t - s.t0, 0, s.dur)
	local dir = if s.vel.Magnitude > 0.01 then s.vel.Unit else Vector3.xAxis
	local perp = Vector3.new(-dir.Z, 0, dir.X)
	return s.pos + s.vel * dt + perp * math.sin(dt * 0.55 + s.seed) * 22
end

-- tsunami: frente da onda avançando em linha reta
function FxPaths.wave(s: Spec, t: number): Vector3
	local dt = math.clamp(t - s.t0, 0, s.dur)
	return s.pos + s.vel * dt
end

-- meteoro: queda em linha reta de pos (céu) até pos+vel (alvo) em dur segundos
function FxPaths.meteor(s: Spec, t: number): (Vector3, number)
	local a = math.clamp((t - s.t0) / s.dur, 0, 1)
	-- leve aceleração no fim
	local eased = a * a * 0.35 + a * 0.65
	return s.pos:Lerp(s.pos + s.vel, eased), a
end

-- progresso 0..1 de um efeito estático (buraco negro, explosão)
function FxPaths.progress(s: Spec, t: number): number
	return math.clamp((t - s.t0) / s.dur, 0, 1)
end

return FxPaths
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Lexicon</string>
          <string name="Source"><![CDATA[--!strict
-- Índice de vocabulário construído a partir do catálogo.
-- Cada frase normalizada aponta para uma "entrada" com tudo que ela pode ser:
-- conceito, modificador, relação, quantificador, região, número...
-- A mesma frase pode ter vários papéis (ex.: "fogo" = conceito e modificador);
-- o Parser decide pelo contexto.

local Catalog = require(script.Parent.Catalog)
local Normalizer = require(script.Parent.Text.Normalizer)
local Fuzzy = require(script.Parent.Text.Fuzzy)
local Inflect = require(script.Parent.Text.Inflect)

export type Entry = {
	phrase: string,
	concept: any?,
	modifier: any?,
	relation: string?,
	quantifier: any?,
	region: any?,
	intensifier: boolean?,
	self: boolean?,
	stop: boolean?,
	verb: string?,
}

local Lexicon = {}

local index: { [string]: Entry } = {}
local vocabulary: { [string]: boolean } = {} -- palavras isoladas que existem em alguma frase
local maxPhraseWords = 1
local collisions: { string } = {}

local function entryFor(phrase: string): Entry
	local e = index[phrase]
	if not e then
		e = { phrase = phrase }
		index[phrase] = e
		local words = 0
		for w in string.gmatch(phrase, "%S+") do
			vocabulary[w] = true
			words += 1
		end
		if words > maxPhraseWords then
			maxPhraseWords = words
		end
	end
	return e
end

local function addRole(raw: string, role: string, value: any, owner: string)
	local phrase = Normalizer.normalize(raw)
	if phrase == "" then
		return
	end
	local e = entryFor(phrase)
	local current = (e :: any)[role]
	if current ~= nil and current ~= value then
		-- mesma frase com dois significados do mesmo tipo: registrar (teste falha)
		local currentId = if type(current) == "table" then (current.id or "?") else tostring(current)
		local newId = if type(value) == "table" then (value.id or "?") else tostring(value)
		table.insert(collisions, string.format("'%s' (%s): %s x %s [%s]", phrase, role, currentId, newId, owner))
		return
	end;
	(e :: any)[role] = value
end

-- Monta o índice (executado uma vez ao carregar o módulo)
do
	local G = Catalog.Grammar
	for _, def in Catalog.Concepts do
		for _, alias in def.aliases do
			addRole(alias, "concept", def, def.id)
		end
	end
	for _, mod in Catalog.Modifiers do
		for _, alias in mod.aliases do
			addRole(alias, "modifier", mod, mod.id)
		end
	end
	for rel, list in G.Relations do
		for _, phrase in list do
			addRole(phrase, "relation", rel, "relation")
		end
	end
	for _, q in G.Quantifiers do
		for _, phrase in q.phrases do
			addRole(phrase, "quantifier", q, "quantifier")
		end
	end
	for _, region in G.Regions do
		for _, alias in region.aliases do
			addRole(alias, "region", region, region.id)
		end
	end
	for _, w in G.Intensifiers do
		addRole(w, "intensifier", true, "intensifier")
	end
	for _, w in G.Self do
		addRole(w, "self", true, "self")
	end
	for _, w in G.Stopwords do
		addRole(w, "stop", true, "stop")
	end
	for kind, list in G.Verbs do
		for _, phrase in list do
			addRole(phrase, "verb", kind, "verb")
		end
	end
end

local fuzzyIndex: Fuzzy.Index
do
	local words = {}
	for w in vocabulary do
		-- só palavras de conteúdo entram na correção ortográfica
		local e = index[w]
		if e and (e.concept or e.modifier) then
			table.insert(words, w)
		elseif not e then
			table.insert(words, w)
		end
	end
	fuzzyIndex = Fuzzy.buildIndex(words)
end

function Lexicon.lookup(phrase: string): Entry?
	return index[phrase]
end

function Lexicon.maxWords(): number
	return maxPhraseWords
end

function Lexicon.isWord(word: string): boolean
	return vocabulary[word] == true
end

-- Forma canônica de uma palavra desconhecida: singular conhecido, se houver.
function Lexicon.canonical(word: string): (string, string?)
	if vocabulary[word] or index[word] then
		return word, nil
	end
	for _, cand in Inflect.singulars(word) do
		if vocabulary[cand] or index[cand] then
			return cand, "plural"
		end
	end
	return word, nil
end

-- Tenta morfologia (diminutivo/aumentativo/prefixo) e correção de digitação.
-- Retorna: palavra base, modificador extra (id) ou nil, tipo da correção
function Lexicon.rescue(word: string): (string?, string?, string?)
	for _, v in Inflect.sizeVariants(word) do
		local base = Lexicon.canonical(v.base)
		local e = index[base]
		if e and e.concept then
			return base, v.modifier, "morfologia"
		end
	end
	for _, v in Inflect.prefixVariants(word) do
		local base = Lexicon.canonical(v.base)
		local e = index[base]
		if e and e.concept then
			return base, v.modifier, "prefixo"
		end
	end
	-- palavra composta escrita junta ("dragaorobo"): procura um conceito no início
	if #word >= 7 then
		for cut = #word - 3, 4, -1 do
			local head = string.sub(word, 1, cut)
			local e = index[head]
			if e and e.concept then
				return head, nil, "composto"
			end
		end
	end
	local best, dist = Fuzzy.best(fuzzyIndex, word)
	if best and dist <= Fuzzy.tolerance(word) then
		return best, nil, "digitacao"
	end
	return nil, nil, nil
end

function Lexicon.collisions(): { string }
	return collisions
end

function Lexicon.size(): number
	local n = 0
	for _ in index do
		n += 1
	end
	return n
end

return Lexicon
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">MapLayout</string>
          <string name="Source"><![CDATA[--!strict
-- Disposição das regiões do mapa (compartilhado entre servidor e cliente).
-- Coordenadas em studs. O mapa é uma ilha de ~1250 studs de diâmetro cercada
-- por oceano; o centro de criação fica na origem.

local MapLayout = {}

export type Region = {
	id: string,
	label: string,
	center: Vector3,
	radius: number,
	color: Color3,
	ambient: string,
}

MapLayout.IslandRadius = 600
MapLayout.SeaLevel = -3

MapLayout.Regions = {
	{ id = "hub", label = "Centro de Criação", center = Vector3.new(0, 0, 0), radius = 95, color = Color3.fromRGB(90, 200, 255), ambient = "hub" },
	{ id = "forest", label = "Floresta Encantada", center = Vector3.new(0, 0, -370), radius = 175, color = Color3.fromRGB(110, 220, 120), ambient = "forest" },
	{ id = "city", label = "Cidade Neon", center = Vector3.new(370, 0, 0), radius = 170, color = Color3.fromRGB(255, 80, 220), ambient = "city" },
	{ id = "glacier", label = "Região Glacial", center = Vector3.new(0, 0, 370), radius = 175, color = Color3.fromRGB(170, 230, 255), ambient = "glacier" },
	{ id = "volcano", label = "Região Vulcânica", center = Vector3.new(-370, 0, 0), radius = 175, color = Color3.fromRGB(255, 110, 40), ambient = "volcano" },
	{ id = "desert", label = "Deserto das Ruínas", center = Vector3.new(300, 0, -300), radius = 120, color = Color3.fromRGB(240, 200, 120), ambient = "desert" },
	{ id = "beach", label = "Praia dos Coqueiros", center = Vector3.new(-310, 0, 310), radius = 120, color = Color3.fromRGB(255, 230, 160), ambient = "beach" },
	{ id = "sky", label = "Ilhas Flutuantes", center = Vector3.new(-290, 190, -290), radius = 110, color = Color3.fromRGB(200, 170, 255), ambient = "sky" },
	{ id = "arena", label = "Arena Subterrânea", center = Vector3.new(300, -120, 300), radius = 70, color = Color3.fromRGB(255, 70, 70), ambient = "arena" },
} :: { Region }

MapLayout.ById = {} :: { [string]: Region }
for _, r in MapLayout.Regions do
	MapLayout.ById[r.id] = r
end

-- região mais próxima de uma posição (para missões "visite..." e música ambiente)
function MapLayout.regionAt(pos: Vector3): Region
	local best, bestD = MapLayout.Regions[1], math.huge
	for _, r in MapLayout.Regions do
		local d = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(r.center.X, 0, r.center.Z)).Magnitude / r.radius
		if r.id == "sky" then
			d = if pos.Y > 120 then d * 0.5 else math.huge
		elseif r.id == "arena" then
			d = if pos.Y < -60 then 0 else math.huge
		end
		if d < bestD then
			best, bestD = r, d
		end
	end
	return best
end

return MapLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Parser</string>
          <string name="Source"><![CDATA[--!strict
-- Interpretador: texto -> itens reconhecidos -> grupos (uma ideia cada) -> relações.
--
--   "dragão de gelo gigante protegendo castelo"
--     itens:  [dragão:conceito] [de:of] [gelo:conceito→mod] [gigante:mod]
--             [protegendo:guard] [castelo:conceito]
--     grupos: #1 {cabeça=dragon, mods={ice, giant}}  #2 {cabeça=castle}
--     relação: #2 guard -> #1
--
-- O texto é tratado SEMPRE como dado. Nada aqui executa código do jogador.

local Catalog = require(script.Parent.Catalog)
local Config = require(script.Parent.Config)
local Normalizer = require(script.Parent.Text.Normalizer)
local Numbers = require(script.Parent.Text.Numbers)
local Lexicon = require(script.Parent.Lexicon)
local Inflect = require(script.Parent.Text.Inflect)

local Parser = {}

export type Item = {
	text: string,
	concept: any?,
	modifier: any?,
	relation: string?,
	quantifier: any?,
	region: any?,
	intensifier: boolean?,
	self: boolean?,
	stop: boolean?,
	number: number?,
	extraModifier: string?,
	unknown: boolean?,
	ofFlag: boolean?,
	plural: boolean?,
	verb: string?,
}

export type Group = {
	items: { Item },
	count: number?,
	rain: boolean?,
	heavy: boolean?,
	intensify: number,
	relToPrev: string?,
	ofPending: boolean?,
	unknown: { string },
	actions: { any },
	chainFrom: any?,
}

export type GroupSpec = {
	head: any?,
	mods: { any },
	ignored: { any },
	payload: any?,
	count: number?,
	rain: boolean?,
	heavy: boolean?,
	relToPrev: string?,
	words: { string },
	actions: { { verb: string, word: string, target: number? } }?,
	chainTarget: boolean?,
	fusion: any?,
	customName: string?,
}

export type ParseResult = {
	input: string,
	normalized: string,
	items: { Item },
	groups: { GroupSpec },
	location: any?,
	selfRef: boolean,
	guardSelf: boolean,
	unknown: { string },
	corrections: { { from: string, to: string, kind: string } },
}

-- 1) reconhecimento ---------------------------------------------------------
function Parser.match(tokens: { string }): ({ Item }, { { from: string, to: string, kind: string } })
	local canon = table.create(#tokens)
	local pluralAt: { [number]: boolean } = {}
	local corrections = {}
	for i, tok in tokens do
		local c, kind = Lexicon.canonical(tok)
		canon[i] = c
		if kind then
			table.insert(corrections, { from = tok, to = c, kind = kind })
			if kind == "plural" then
				pluralAt[i] = true
			end
		end
	end

	local items: { Item } = {}
	local i = 1
	local maxWords = Lexicon.maxWords()
	while i <= #canon do
		local matched = false
		for n = math.min(maxWords, #canon - i + 1), 1, -1 do
			local phrase = table.concat(canon, " ", i, i + n - 1)
			local e = Lexicon.lookup(phrase)
			if e then
				local item: Item = {
					text = phrase,
					concept = e.concept,
					modifier = e.modifier,
					relation = e.relation,
					quantifier = e.quantifier,
					region = e.region,
					intensifier = e.intensifier,
					self = e.self,
					stop = e.stop,
					verb = e.verb,
				}
				-- plural ("dragões", "zumbis") sem número explícito vira um pequeno grupo
				if n == 1 and e.concept then
					if pluralAt[i] then
						item.plural = true
					elseif #tokens[i] > 3 then
						for _, cand in Inflect.singulars(tokens[i]) do
							local se = Lexicon.lookup(cand)
							if se and se.concept == e.concept then
								item.plural = true
								break
							end
						end
					end
				end
				table.insert(items, item)
				i += n
				matched = true
				break
			end
		end
		if not matched then
			local tok = canon[i]
			local num = Numbers.parse(tok)
			if num then
				if Numbers.isArticle(tok) then
					table.insert(items, { text = tok, stop = true })
				else
					table.insert(items, { text = tok, number = num })
				end
			else
				local base, extraMod, kind = Lexicon.rescue(tok)
				local e = if base then Lexicon.lookup(base) else nil
				if base and e then
					table.insert(corrections, { from = tok, to = base, kind = kind or "?" })
					table.insert(items, {
						text = base,
						concept = e.concept,
						modifier = e.modifier,
						region = e.region,
						extraModifier = extraMod,
					})
				else
					table.insert(items, { text = tok, unknown = true })
				end
			end
			i += 1
		end
	end
	return items, corrections
end

-- 2) agrupamento ------------------------------------------------------------
local function newGroup(): Group
	return { items = {}, intensify = 0, unknown = {}, actions = {} }
end

local function hasContent(g: Group): boolean
	return #g.items > 0 or #g.unknown > 0
end

-- Palavras desconhecidas que parecem um nome ("verity", "joao pedro"): viram um
-- personagem com esse nome. Sequências impronunciáveis ("xyzqwe") não.
local VOWELS = { a = true, e = true, i = true, o = true, u = true }
function Parser.nameLike(words: { string }): boolean
	if #words == 0 or #words > 3 then
		return false
	end
	local total = 0
	for _, w in words do
		if not string.match(w, "^%a+$") then
			return false
		end
		local n = #w
		if n < 2 or n > 14 then
			return false
		end
		total += n + 1
		local vowels, run, maxRun = 0, 0, 0
		for i = 1, n do
			local ch = string.sub(w, i, i)
			if VOWELS[ch] or (ch == "y" and i == n) then
				vowels += 1
				run = 0
			else
				run += 1
				maxRun = math.max(maxRun, run)
			end
		end
		if vowels == 0 or maxRun > 3 or vowels / n < 0.2 then
			return false
		end
	end
	return total <= 26
end

function Parser.displayName(words: { string }): string
	local out = {}
	for _, w in words do
		table.insert(out, string.upper(string.sub(w, 1, 1)) .. string.sub(w, 2))
	end
	return table.concat(out, " ")
end

-- Duas ideias na mesma frase sem palavra de ligação podem virar um híbrido:
-- "gato tubarão", "homem tubarão", "macaco banana", "crocodilo avião".
local FUSE_WITH_CREATURE = { creature = true, food = true, object = true, nature = true, vehicle = true }
function Parser.fusable(a: any, b: any): boolean
	if a == b or a.sacred or b.sacred or a.handler == "composite" or b.handler == "composite" then
		return false
	end
	if a.noFusion or b.noFusion then
		return false
	end
	if a.category == "creature" then
		return FUSE_WITH_CREATURE[b.category] == true and b.handler ~= "world"
	end
	if b.category == "creature" then
		return FUSE_WITH_CREATURE[a.category] == true and a.handler ~= "world"
	end
	return false
end

local UPGRADE = { giant = "colossal", small = "tiny" }

local function chooseHead(conceptItems: { Item }): Item?
	-- a) conceito "puro" (não funciona como modificador)
	for _, it in conceptItems do
		if not it.concept.asModifier and not it.modifier then
			return it
		end
	end
	-- b) conceito que vira modificador, mas prefere ser cabeça
	for _, it in conceptItems do
		if not it.concept.preferModifier and not it.modifier then
			return it
		end
	end
	-- c) todos preferem ser modificador: o de eixo "trait" (zumbi, robô...) vira
	--    cabeça antes dos de posto/elemento/material ("rei zumbi" = zumbi chefe)
	local best: Item? = nil
	local bestScore = math.huge
	for _, it in conceptItems do
		local mod = it.concept.asModifier and Catalog.ModifierById[it.concept.asModifier]
		local score = if mod and mod.axis == "trait" then 1 else 2
		if score < bestScore then
			best, bestScore = it, score
		end
	end
	return best or conceptItems[1]
end

local function resolveGroup(g: Group, extraGroups: { GroupSpec }): GroupSpec
	local spec: GroupSpec = {
		head = nil,
		mods = {},
		ignored = {},
		count = g.count,
		rain = g.rain,
		heavy = g.heavy,
		relToPrev = g.relToPrev,
		words = {},
	}
	local conceptItems = {}
	for _, it in g.items do
		table.insert(spec.words, it.text)
		if it.concept then
			table.insert(conceptItems, it)
		end
	end
	local rawMods = {}
	local headItem = chooseHead(conceptItems)
	-- "verity gigante": o nome é a ideia; "gigante" vira modificador
	if headItem and headItem.modifier and #g.unknown > 0 and Parser.nameLike(g.unknown) then
		headItem = nil
	end
	if headItem then
		spec.head = headItem.concept
		if headItem.plural and not spec.count then
			spec.count = 3
		end
	end
	for _, it in g.items do
		if it ~= headItem then
			if it.concept then
				local c = it.concept
				if it.modifier then
					table.insert(rawMods, it.modifier)
				elseif c.asModifier then
					table.insert(rawMods, Catalog.ModifierById[c.asModifier])
				elseif it.ofFlag and spec.head and spec.head.params.payload and not spec.payload then
					spec.payload = c
				elseif not spec.fusion and spec.head and Parser.fusable(spec.head, c) then
					spec.fusion = c
				else
					-- conceito independente na mesma frase: vira outra ideia
					table.insert(extraGroups, {
						head = c,
						mods = {},
						ignored = {},
						relToPrev = "conjunction",
						words = { it.text },
					})
				end
			elseif it.modifier then
				table.insert(rawMods, it.modifier)
			end
		end
		if it.extraModifier then
			table.insert(rawMods, Catalog.ModifierById[it.extraModifier])
		end
	end

	-- nada reconhecido, mas há um nome ("verity"): personagem com esse nome
	if not spec.head and #g.unknown > 0 and Parser.nameLike(g.unknown) and Catalog.ById.mystery_person then
		spec.head = Catalog.ById.mystery_person
		spec.customName = Parser.displayName(g.unknown)
	end

	-- só modificadores: palavra isolada vira conceito ("gigante" -> poder de crescer)
	if not spec.head then
		for idx, m in rawMods do
			if m.standalone then
				spec.head = Catalog.ById[m.standalone]
				table.remove(rawMods, idx)
				break
			end
		end
	end

	-- aplica modificadores respeitando eixos aceitos e um por eixo
	local byAxis: { [string]: any } = {}
	for _, m in rawMods do
		if m then
			local existing = byAxis[m.axis]
			if existing then
				if existing.id == m.id and UPGRADE[m.id] then
					byAxis[m.axis] = Catalog.ModifierById[UPGRADE[m.id]] -- "gigante gigante"
				else
					table.insert(spec.ignored, m)
				end
			elseif spec.head and not spec.head.axes[m.axis] then
				table.insert(spec.ignored, m)
			else
				byAxis[m.axis] = m
			end
		end
	end
	if g.intensify > 0 and byAxis.size and UPGRADE[byAxis.size.id] then
		byAxis.size = Catalog.ModifierById[UPGRADE[byAxis.size.id]]
	end
	for _, m in byAxis do
		table.insert(spec.mods, m)
	end
	table.sort(spec.mods, function(a, b)
		local oa, ob = a.order or 99, b.order or 99
		if oa == ob then
			return a.id < b.id
		end
		return oa < ob
	end)
	return spec
end

function Parser.parse(raw: string): ParseResult
	local tokens = Normalizer.tokens(raw, Config.Request.MaxTokens)
	local items, corrections = Parser.match(tokens)
	local result: ParseResult = {
		input = raw,
		normalized = table.concat(tokens, " "),
		items = items,
		groups = {},
		location = nil,
		selfRef = false,
		guardSelf = false,
		unknown = {},
		corrections = corrections,
	}

	local groups: { Group } = {}
	local cur = newGroup()
	local locationMode = false
	local danglingGuard = false
	local refGroup: Group? = nil -- "o cachorro" já citado antes, sujeito do próximo verbo

	local function push()
		if hasContent(cur) then
			table.insert(groups, cur)
		end
		cur = newGroup()
	end

	local function nextMeaningful(from: number): Item?
		for j = from + 1, #items do
			local n = items[j]
			if not (n.stop and not n.concept and not n.modifier and not n.verb) then
				return n
			end
		end
		return nil
	end

	local function groupWith(concept: any): Group?
		for _, it in cur.items do
			if it.concept == concept then
				return cur
			end
		end
		for gi = #groups, 1, -1 do
			for _, it in groups[gi].items do
				if it.concept == concept then
					return groups[gi]
				end
			end
		end
		return nil
	end

	for idx, it in items do
		-- verbo de ação com sujeito: monta a cadeia ("arma que atira cachorro")
		if it.verb then
			local subject: Group? = refGroup or (if #cur.items > 0 then cur else nil) or groups[#groups]
			if subject and not subject.chainFrom and #subject.items == 0 then
				subject = nil
			end
			if subject then
				local kind = it.verb :: string
				if Catalog.Grammar.TransitiveVerbs[kind] then
					if hasContent(cur) then
						push()
					end
					cur.relToPrev = nil
					cur.chainFrom = { group = subject, verb = kind }
					table.insert(subject.actions, { verb = kind, word = it.text, target = cur })
				else
					table.insert(subject.actions, { verb = kind, word = it.text })
				end
				refGroup = nil
				continue
			end
		end
		-- "...e o cachorro caga...": o cachorro é o mesmo citado antes
		if it.concept and not it.verb then
			local nxt = nextMeaningful(idx)
			if nxt and nxt.verb then
				local found = groupWith(it.concept)
				if found then
					refGroup = found
					continue
				end
			end
		end
		if it.unknown then
			table.insert(result.unknown, it.text)
			table.insert(cur.unknown, it.text)
		elseif it.self then
			result.selfRef = true
			if danglingGuard then
				result.guardSelf = true
			end
		elseif it.intensifier and not it.concept and not it.modifier then
			cur.intensify += 1
		elseif it.number then
			cur.count = math.max(cur.count or 0, it.number)
		elseif it.quantifier and not it.concept then
			local q = it.quantifier
			if q.rain then
				cur.rain = true
				cur.heavy = q.heavy == true
			else
				cur.count = math.max(cur.count or 0, q.count)
			end
		elseif it.relation and not it.concept and not it.modifier then
			local rel = it.relation
			if rel == "of" then
				cur.ofPending = true
			elseif rel == "location" then
				locationMode = true
			else
				if rel == "guard" then
					danglingGuard = true
					if result.selfRef then
						result.guardSelf = true
					end
				end
				if hasContent(cur) then
					push()
					cur.relToPrev = rel
				elseif #groups > 0 and not cur.chainFrom then
					cur.relToPrev = rel
				end
			end
		elseif it.region and (locationMode or (not it.concept and not it.modifier)) then
			result.location = it.region
			locationMode = false
		elseif it.concept or it.modifier then
			if locationMode and it.concept then
				if hasContent(cur) then
					push()
				end
				cur.relToPrev = "location"
				locationMode = false
			end
			if cur.ofPending then
				it.ofFlag = true
				cur.ofPending = false
			end
			table.insert(cur.items, it)
			if it.concept then
				danglingGuard = false
			end
		end
		-- stopwords e o resto são ignorados
	end
	push()

	-- se a última relação ficou "pendurada" em "guard" sem alvo e houve "me/mim"
	if result.selfRef and danglingGuard then
		result.guardSelf = true
	end

	local specs: { GroupSpec } = {}
	local specOf: { [Group]: number } = {}
	for gi, g in groups do
		local extras: { GroupSpec } = {}
		local spec = resolveGroup(g, extras)
		if gi == 1 then
			spec.relToPrev = nil
		end
		if g.chainFrom then
			spec.chainTarget = true
			spec.relToPrev = nil
		end
		table.insert(specs, spec)
		specOf[g] = #specs
		for _, extra in extras do
			table.insert(specs, extra)
		end
		if #specs >= Config.Request.MaxGroups then
			break
		end
	end
	while #specs > Config.Request.MaxGroups do
		table.remove(specs)
	end
	-- ações: índices dos grupos-alvo (cadeias)
	for g, si in specOf do
		local spec = specs[si]
		if spec and #g.actions > 0 then
			local acts = {}
			for _, a in g.actions do
				local target = if a.target then specOf[a.target] else nil
				if a.target and (not target or not specs[target]) then
					continue -- verbo sem objeto ("arma que atira")
				end
				table.insert(acts, { verb = a.verb, word = a.word, target = target })
			end
			spec.actions = acts
		end
	end
	result.groups = specs
	return result
end

return Parser
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Planner</string>
          <string name="Source"><![CDATA[--!strict
-- Planejamento: transforma o resultado do Parser em um plano executável.
--   * mescla parâmetros do conceito com os modificadores
--   * expande combinações prontas (composite) e "chuva de ..."
--   * aplica regras de interação (rivais, guarda, montaria, caça)
--   * limita quantidades e calcula o rótulo exibido
--   * escolhe um acontecimento surpresa determinístico para palavras desconhecidas
-- Função pura: mesma entrada -> mesmo plano (testável fora do Roblox).

local Catalog = require(script.Parent.Catalog)
local Config = require(script.Parent.Config)
local Parser = require(script.Parent.Parser)
local Hash = require(script.Parent.Util.Hash)

local Planner = {}

export type EventSpec = {
	concept: any,
	handler: string,
	mods: { string },
	params: { [string]: any },
	count: number,
	requested: number,
	rain: boolean,
	heavy: boolean,
	payload: any?,
	label: string,
	baseLabel: string?,
	actions: { any }?,
}

export type Link = { type: string, a: number, b: number }

export type Plan = {
	input: string,
	normalized: string,
	events: { EventSpec },
	links: { Link },
	location: any?,
	guardSelf: boolean,
	surprise: boolean,
	label: string,
	notes: { string },
	unknown: { string },
	corrections: { any },
	secrets: { string },
}

-- Rótulo em português com concordância simples de gênero
function Planner.labelFor(def: any, mods: { any }, payload: any?): string
	local parts = { def.label }
	for _, m in mods do
		local lab = if def.gender == "f" and m.labelF then m.labelF else m.label
		table.insert(parts, lab)
	end
	local s = table.concat(parts, " ")
	if payload then
		s ..= " de " .. payload.label
	end
	return s
end

local function deepCopy(t: any): any
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in t do
		out[k] = deepCopy(v)
	end
	return out
end

-- Mescla os patches dos modificadores nos parâmetros do conceito
function Planner.applyMods(def: any, mods: { any }): { [string]: any }
	local p = deepCopy(def.params)
	p.scale = p.scale or 1
	p.hpMul = 1
	p.speedMul = 1
	for _, m in mods do
		for key, value in m.patch do
			if key == "scale" then
				p.scale *= value
			elseif key == "hp" then
				p.hpMul *= value
			elseif key == "speed" then
				p.speedMul *= value
			elseif key == "element" then
				p.element = value
				p.elementMod = true -- elemento pedido pelo jogador (tinge o modelo)
			else
				p[key] = value
			end
		end
	end
	p.scale = math.clamp(p.scale, Config.Limits.MinScale, Config.Limits.MaxScale)
	return p
end

local function selectorMatches(sel: any, def: any): boolean
	if sel.category then
		local ok = false
		if type(sel.category) == "table" then
			for _, c in sel.category do
				if c == def.category then
					ok = true
				end
			end
		else
			ok = sel.category == def.category
		end
		if not ok then
			return false
		end
	end
	if sel.tag and not def.tagSet[sel.tag] then
		return false
	end
	if sel.notTag and def.tagSet[sel.notTag] then
		return false
	end
	return true
end

-- Encontra a regra de interação para (A rel B); devolve link já orientado
function Planner.interaction(rel: string, a: any, b: any): (string?, boolean)
	for _, rule in Catalog.Interactions do
		if rule.rel == rel then
			if selectorMatches(rule.a, a) and selectorMatches(rule.b, b) then
				return rule.link, false
			end
			if selectorMatches(rule.a, b) and selectorMatches(rule.b, a) then
				return rule.link, true
			end
		end
	end
	return nil, false
end

-- Dicas por terminação para palavras desconhecidas ("megassauro", "turbobot")
local SUFFIX_HINTS = {
	{ "saurus", { "dinosaur", "raptor", "triceratops", "stegosaurus", "brachiosaurus" } },
	{ "sauro", { "dinosaur", "raptor", "triceratops", "stegosaurus", "brachiosaurus" } },
	{ "dactilo", { "pterodactyl" } },
	{ "zilla", { "kaiju" } },
	{ "tron", { "robot", "mech" } },
	{ "bot", { "robot", "drone" } },
	{ "nado", { "tornado" } },
	{ "monstro", { "troll", "cyclops", "kaiju", "slime" } },
	{ "mon", { "dragon", "slime", "kaiju", "unicorn" } },
	{ "ita", { "crystal" } },
	{ "ite", { "crystal" } },
	{ "landia", { "city" } },
	{ "polis", { "city" } },
	{ "burgo", { "castle" } },
	{ "berg", { "castle" } },
}

local SURPRISE_CATEGORIES = {
	creature = 4,
	disaster = 3,
	object = 2,
	food = 2,
	vehicle = 1.5,
	building = 1.2,
	weather = 1,
	magic = 1,
	nature = 1,
}

local surprisePool: { any } = {}
for _, def in Catalog.Concepts do
	local w = SURPRISE_CATEGORIES[def.category]
	if w and def.handler ~= "composite" and not def.tagSet.utility then
		table.insert(surprisePool, def)
	end
end
table.sort(surprisePool, function(a, b)
	return a.id < b.id
end)

local ELEMENT_MODS = { "fire", "ice", "electric", "poison", "shadow", "light", "rainbow", "gold", "giant", "small", "crystal", "neon" }

function Planner.surprise(normalized: string): (any, { any })
	local h = Hash.str(normalized)
	-- terminações conhecidas primeiro
	for word in string.gmatch(normalized, "%a+") do
		for _, hint in SUFFIX_HINTS do
			local suffix = hint[1]
			if #word > #suffix + 1 and string.sub(word, -#suffix) == suffix then
				local list = hint[2]
				return Catalog.ById[list[(h % #list) + 1]], {}
			end
		end
	end
	local total = 0
	for _, def in surprisePool do
		total += SURPRISE_CATEGORIES[def.category]
	end
	local roll = (h % 100000) / 100000 * total
	local chosen = surprisePool[#surprisePool]
	for _, def in surprisePool do
		roll -= SURPRISE_CATEGORIES[def.category]
		if roll < 0 then
			chosen = def
			break
		end
	end
	local mods = {}
	local h2 = Hash.str(normalized .. "#mod")
	if h2 % 100 < 45 then
		local m = Catalog.ModifierById[ELEMENT_MODS[(h2 % #ELEMENT_MODS) + 1]]
		if m and chosen.axes[m.axis] then
			table.insert(mods, m)
		end
	end
	return chosen, mods
end

local function makeEvent(def: any, mods: { any }, requested: number, rain: boolean, heavy: boolean, payload: any?, notes: { string }): EventSpec
	local params = Planner.applyMods(def, mods)
	local limit = def.maxCount or 1
	if def.handler == "npc" then
		limit = math.min(limit, Config.Limits.NpcPerEvent)
	end
	if rain then
		limit = math.max(limit, 12)
	end
	local count = math.clamp(math.floor(requested), 1, limit)
	if requested > count then
		table.insert(notes, string.format("%s: %d de %d (limite de desempenho)", def.label, count, math.floor(math.min(requested, 1e9))))
	end
	local modIds = {}
	for _, m in mods do
		table.insert(modIds, m.id)
	end
	local label = Planner.labelFor(def, mods, payload)
	if rain then
		label = "Chuva de " .. label
	elseif count > 1 then
		label = string.format("%d× %s", count, label)
	end
	if payload then
		params.payload = payload.id
	end
	return {
		concept = def,
		handler = if rain then "rain" else def.handler,
		mods = modIds,
		params = params,
		count = count,
		requested = requested,
		rain = rain,
		heavy = heavy,
		payload = payload,
		label = label,
		baseLabel = label,
	}
end

-- Dica por terminação ("megassauro" -> dinossauro); nil se não houver
function Planner.suffixHint(word: string): any?
	local h = Hash.str(word)
	for _, hint in SUFFIX_HINTS do
		local suffix = hint[1]
		if #word > #suffix + 1 and string.sub(word, -#suffix) == suffix then
			local list = hint[2]
			return Catalog.ById[list[(h % #list) + 1]]
		end
	end
	return nil
end

-- Conceitos que, como objeto de "atira/cospe/solta", viram o elemento do sujeito
local ELEMENT_OF_CONCEPT = {
	fire = "fire",
	ice_burst = "ice",
	blizzard = "ice",
	lightning = "electric",
	laser_storm = "electric",
	acid_rain = "poison",
	lava_pool = "lava",
	volcano_eruption = "lava",
	tornado = "wind",
	wind = "wind",
	tsunami = "water",
	rain = "water",
	rainbow = "rainbow",
}
Planner.ElementOfConcept = ELEMENT_OF_CONCEPT

local MAX_ATTACKS = 4

local function mergeAttacks(a: { string }?, b: { string }?): { string }
	local out = {}
	for _, list in { a or {}, b or {} } do
		for _, atk in list do
			if not table.find(out, atk) and #out < MAX_ATTACKS then
				table.insert(out, atk)
			end
		end
	end
	return out
end

-- Personagem com nome digitado: aparência e poderes derivados do próprio nome
local NAMED_ATTACKS = { { "melee" }, { "bolt", "melee" }, { "melee", "charge" }, { "heal", "bolt" }, { "bolt" }, { "melee", "stomp" } }
local NAMED_ELEMENTS = { "fire", "ice", "electric", "poison", "light", "shadow", "water", "nature", "rainbow" }
function Planner.applyName(ev: EventSpec, name: string)
	local h = Hash.str(string.lower(name))
	ev.params.customName = name
	ev.params.seed = h
	if not ev.params.attacksFromMods then
		ev.params.attacks = NAMED_ATTACKS[(h % #NAMED_ATTACKS) + 1]
	end
	if not ev.params.element and (h // 7) % 3 ~= 0 then
		ev.params.element = NAMED_ELEMENTS[((h // 13) % #NAMED_ELEMENTS) + 1]
	end
	ev.baseLabel = name
	ev.label = name
end

-- Híbrido: corpo de A com a cabeça (ou o corpo inteiro, para objetos) de B
function Planner.applyFusion(ev: EventSpec, other: any)
	local a = ev.concept
	local p = ev.params
	local op = other.params or {}
	p.fusionHead = {
		id = other.id,
		category = other.category,
		model = op.model,
		variant = op.variant,
		size = op.size,
		element = op.element,
	}
	if a.category == "creature" and other.category == "creature" then
		p.attacks = mergeAttacks(p.attacks, op.attacks)
		p.fly = p.fly == true or op.fly == true
		p.element = p.element or op.element
		p.hp = math.max(p.hp or 100, op.hp or 100)
		p.dmg = math.max(p.dmg or 8, op.dmg or 8)
		p.speed = ((p.speed or 16) + (op.speed or 16)) / 2
		if p.faction == "neutral" and op.faction == "hostile" then
			p.faction = "hostile"
		end
	end
	local label
	if a.id == "villager" then
		label = other.label .. " Humanoide"
	else
		label = a.label .. "-" .. other.label
	end
	ev.baseLabel = label
	ev.label = if ev.count > 1 then string.format("%d× %s", ev.count, label) else label
	ev.fusion = other
end

-- Liga um verbo da frase ao acontecimento (cadeia de ações)
local function attachAction(ev: EventSpec, act: any, nodeOf: { [number]: EventSpec })
	if ev.concept.sacred then
		return
	end
	local kind = act.verb
	ev.actions = ev.actions or {}
	if Catalog.Grammar.TransitiveVerbs[kind] then
		local target = act.target and nodeOf[act.target]
		if not target or target.concept.sacred then
			return
		end
		local element = ELEMENT_OF_CONCEPT[target.concept.id]
		if element and (kind == "shoot" or kind == "spawn") then
			-- "dragão que cospe fogo", "arma que atira gelo": o elemento vira o poder
			ev.params.element = element
			ev.params.elementMod = true
			if ev.handler == "npc" then
				local atk = table.clone(ev.params.attacks or { "melee" })
				if not table.find(atk, "bolt") and not table.find(atk, "breath") then
					table.insert(atk, 1, if kind == "spawn" then "breath" else "bolt")
				end
				ev.params.attacks = atk
			end
			table.insert((ev.actions :: any), { verb = kind, word = act.word, label = target.concept.label, elementOnly = true })
			return
		end
		table.insert((ev.actions :: any), { verb = kind, word = act.word, node = target })
	else
		local p = ev.params
		if kind == "fly" then
			p.fly = true
		elseif kind == "dance" then
			p.behavior = "dance"
		elseif kind == "burn" then
			p.element = "fire"
			p.elementMod = true
		elseif kind == "freeze" then
			p.element = "ice"
			p.elementMod = true
		elseif kind == "sing" and ev.handler == "npc" then
			local atk = table.clone(p.attacks or { "melee" })
			if not table.find(atk, "sing") then
				table.insert(atk, 1, "sing")
			end
			p.attacks = atk
		end
		table.insert((ev.actions :: any), { verb = kind, word = act.word })
	end
end

local function chainParts(ev: any, depth: number, out: { string })
	for _, a in ev.actions or {} do
		local verb = a.word or Catalog.Grammar.VerbLabels[a.verb] or a.verb
		if a.node then
			table.insert(out, verb .. " " .. (a.node.baseLabel or a.node.label))
			if depth < 5 then
				chainParts(a.node, depth + 1, out)
			end
		elseif a.label then
			table.insert(out, verb .. " " .. a.label)
		else
			table.insert(out, verb)
		end
	end
end

-- profundidade da cadeia (1 = "cachorro explode", 3 = arma -> cachorro -> elefante)
function Planner.chainDepth(ev: any, depth: number?): number
	local d = depth or 0
	local best = d
	for _, a in ev.actions or {} do
		if a.node then
			best = math.max(best, Planner.chainDepth(a.node, d + 1))
		else
			best = math.max(best, d + 1)
		end
	end
	return best
end

-- Recalcula rótulos (usado depois que o servidor filtra nomes digitados)
function Planner.relabel(plan: any)
	local labels = {}
	for _, ev in plan.events do
		local base = ev.baseLabel or ev.label
		if ev.count > 1 and not ev.rain and not string.find(base, "×", 1, true) then
			base = string.format("%d× %s", ev.count, base)
		elseif ev.rain and not string.find(base, "^Chuva de ") then
			base = "Chuva de " .. base
		end
		local parts = {}
		chainParts(ev, 1, parts)
		ev.label = if #parts > 0 then base .. " → " .. table.concat(parts, " → ") else base
		table.insert(labels, ev.label)
	end
	plan.label = table.concat(labels, " + ")
	if plan.surprise then
		plan.label = "Surpresa: " .. plan.label
	end
	if plan.location and not (#plan.events == 1 and plan.events[1].concept.id == "teleport") then
		plan.label ..= " (" .. plan.location.label .. ")"
	end
end

function Planner.plan(raw: string): Plan
	local parsed = Parser.parse(raw)
	local plan: Plan = {
		input = raw,
		normalized = parsed.normalized,
		events = {},
		links = {},
		location = parsed.location,
		guardSelf = parsed.guardSelf,
		surprise = false,
		label = "",
		notes = {},
		unknown = parsed.unknown,
		corrections = parsed.corrections,
		secrets = {},
	}

	-- índice do evento "principal" de cada grupo (para vínculos)
	local groupEvent: { [number]: number } = {}
	local pendingRel: { { gi: number, rel: string } } = {}
	local nodeOf: { [number]: EventSpec } = {} -- todo grupo vira um "nó" (inclusive elos de cadeia)

	for gi, g in parsed.groups do
		local head = g.head
		local mods = g.mods
		local rain = g.rain == true
		local customName = g.customName
		-- nome com terminação conhecida ("megassauro") vira dica, não nome
		if head and customName and not string.find(customName, " ") then
			local hinted = Planner.suffixHint(string.lower(customName))
			if hinted then
				head = hinted
				customName = nil
				plan.surprise = true
			end
		end
		-- híbrido: a criatura é o corpo; com veículo, o veículo é o corpo
		local fusionWith = g.fusion
		if head and fusionWith then
			if head.category ~= "creature" and fusionWith.category == "creature" and head.category ~= "vehicle" then
				head, fusionWith = fusionWith, head
			elseif head.category == "creature" and fusionWith.category == "vehicle" then
				head, fusionWith = fusionWith, head
			end
		end
		if head and head.sacred then
			mods = {}
			rain = false
		end
		if head and rain and head.params.rainAs then
			head = Catalog.ById[head.params.rainAs]
		end
		if head and rain and (head.category == "weather" or head.category == "magic" or head.category == "power" or head.category == "tool") then
			rain = false -- "chuva de magia" não faz sentido físico: executa o conceito
		end
		if head and rain and head.category == "disaster" then
			rain = false
			if head.id == "fire" then
				head = Catalog.ById.meteor_shower
			elseif head.id == "ice_burst" or head.id == "blizzard" then
				head = Catalog.ById.rockfall
				table.insert(mods, Catalog.ModifierById.ice)
			elseif head.id == "meteor" then
				head = Catalog.ById.meteor_shower
			end
		end
		if head then
			if g.ignored and #g.ignored > 0 then
				local names = {}
				for _, m in g.ignored do
					table.insert(names, m.label)
				end
				table.insert(plan.notes, "Ignorado: " .. table.concat(names, ", "))
			end
			if head.handler == "composite" then
				local base = #plan.events
				for _, part in head.params.compose do
					local def = Catalog.ById[part.id]
					local accepted = {}
					for _, m in mods do
						if def.axes[m.axis] then
							table.insert(accepted, m)
						end
					end
					table.insert(plan.events, makeEvent(def, accepted, part.count or 1, false, false, nil, plan.notes))
				end
				for _, l in head.params.links or {} do
					local link = table.clone(l)
					if link.a then
						link.a += base
					end
					if link.b then
						link.b += base
					end
					if link.guard then
						link.a = link.guard + base
						link.b = link.target + base
					end
					table.insert(plan.links, { type = link.type, a = link.a, b = link.b })
				end
				groupEvent[gi] = base + 1
				nodeOf[gi] = plan.events[base + 1]
			else
				local count = g.count or 1
				if g.chainTarget then
					count = math.min(count, 3) -- cada disparo/cria gera no máximo 3
				end
				local ev = makeEvent(head, mods, count, rain and not g.chainTarget, g.heavy == true, if head.sacred then nil else g.payload, plan.notes)
				if customName then
					Planner.applyName(ev, customName)
				end
				if fusionWith then
					Planner.applyFusion(ev, fusionWith)
				end
				nodeOf[gi] = ev
				if not g.chainTarget then
					table.insert(plan.events, ev)
					groupEvent[gi] = #plan.events
				end
			end
			if g.relToPrev and not g.chainTarget then
				table.insert(pendingRel, { gi = gi, rel = g.relToPrev })
			end
		end
	end

	-- vínculos entre grupos consecutivos
	for _, pr in pendingRel do
		local bIdx = groupEvent[pr.gi]
		local aIdx: number? = nil
		for back = pr.gi - 1, 1, -1 do
			if groupEvent[back] then
				aIdx = groupEvent[back]
				break
			end
		end
		if aIdx and bIdx and not plan.events[aIdx].concept.sacred and not plan.events[bIdx].concept.sacred then
			local a = plan.events[aIdx].concept
			local b = plan.events[bIdx].concept
			local link, swapped = Planner.interaction(pr.rel, a, b)
			if link then
				if swapped then
					table.insert(plan.links, { type = link, a = bIdx, b = aIdx })
				else
					table.insert(plan.links, { type = link, a = aIdx, b = bIdx })
				end
			end
		end
	end

	-- "dragão me protegendo": criaturas viram guarda-costas do jogador
	if plan.guardSelf then
		for idx, ev in plan.events do
			if ev.concept.category == "creature" then
				ev.params.faction = "pet"
				table.insert(plan.links, { type = "bodyguard", a = idx, b = 0 })
			end
		end
	end

	-- só uma região ("praia", "na arena"): leva o jogador até lá
	if #plan.events == 0 and plan.location then
		table.insert(plan.events, makeEvent(Catalog.ById.teleport, {}, 1, false, false, nil, plan.notes))
		plan.events[1].params.region = plan.location.id
		plan.events[1].label = "Viagem: " .. plan.location.label
		plan.events[1].baseLabel = plan.events[1].label
	end

	-- nada reconhecido: surpresa determinística
	if #plan.events == 0 then
		local leftoverMods = {}
		for _, g in parsed.groups do
			for _, m in g.mods do
				table.insert(leftoverMods, m)
			end
		end
		local def, mods = Planner.surprise(if plan.normalized ~= "" then plan.normalized else "?")
		for _, m in leftoverMods do
			if def.axes[m.axis] then
				local dup = false
				for _, existing in mods do
					if existing.axis == m.axis then
						dup = true
					end
				end
				if not dup then
					table.insert(mods, m)
				end
			end
		end
		table.insert(plan.events, makeEvent(def, mods, 1, false, false, nil, plan.notes))
		plan.surprise = true
	end

	-- cadeias de ação ("arma que atira cachorro", "cachorro caga elefante", "explode")
	for gi, g in parsed.groups do
		local ev = nodeOf[gi]
		if ev and g.actions then
			for _, act in g.actions do
				attachAction(ev, act, nodeOf)
			end
		end
	end

	Planner.relabel(plan)
	plan.secrets = Planner.matchSecrets(plan)
	return plan
end

-- Combinações secretas presentes no plano
function Planner.matchSecrets(plan: Plan): { string }
	local found = {}
	local present: { [string]: number } = {}
	for idx, ev in plan.events do
		present[ev.concept.id] = idx
	end
	for _, secret in Catalog.Secrets do
		local m = secret.match
		local ok = true
		if m.concept then
			local idx = present[m.concept]
			if not idx then
				ok = false
			else
				local ev = plan.events[idx]
				for _, mid in m.mods or {} do
					if not table.find(ev.mods, mid) then
						ok = false
					end
				end
				if m.payload and (not ev.payload or ev.payload.id ~= m.payload) then
					ok = false
				end
				if m.rain and not ev.rain then
					ok = false
				end
				if m.minRequested and ev.requested < m.minRequested then
					ok = false
				end
			end
		end
		if ok and m.concepts then
			for _, cid in m.concepts do
				if not present[cid] then
					ok = false
				end
			end
			if ok and m.link then
				local a, b = present[m.concepts[1]], present[m.concepts[2]]
				local linked = false
				for _, l in plan.links do
					if l.type == m.link and ((l.a == a and l.b == b) or (l.a == b and l.b == a)) then
						linked = true
					end
				end
				ok = linked
			end
		end
		if ok and m.chainDepth then
			local best = 0
			for _, ev in plan.events do
				best = math.max(best, Planner.chainDepth(ev))
			end
			ok = best >= m.chainDepth
		end
		if ok and m.action then
			local hit = false
			for _, ev in plan.events do
				for _, a in ev.actions or {} do
					if a.verb == m.action.verb and a.node and a.node.concept.id == m.action.target then
						hit = true
					end
				end
			end
			ok = hit
		end
		if ok and m.fusion then
			local hit = false
			for _, ev in plan.events do
				if ev.fusion then
					hit = true
				end
			end
			ok = hit
		end
		if ok then
			table.insert(found, secret.id)
		end
	end
	return found
end

return Planner
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Tests</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">ParserSpec</string>
            <string name="Source"><![CDATA[--!strict
-- Casos de teste do interpretador. Rodam no Lune (offline) e na nuvem
-- (Luau Execution API) com o mesmo código.
-- expect.events[i]: concept, mods (todos presentes), count, requested, rain, payload, faction
-- expect.links: lista de {type, a = conceito, b = conceito}
-- expect.secrets, expect.surprise, expect.location, expect.label

local Spec = {}

Spec.cases = {
	-- básicos e variações de escrita
	{ input = "dragão", expect = { events = { { concept = "dragon", count = 1 } }, label = "Dragão" } },
	{ input = "dragao", expect = { events = { { concept = "dragon" } } } },
	{ input = "DRAGÃO!!!", expect = { events = { { concept = "dragon" } } } },
	{ input = "dargão", expect = { events = { { concept = "dragon" } } } },
	{ input = "dragon", expect = { events = { { concept = "dragon" } } } },
	{ input = "dragões", expect = { events = { { concept = "dragon", count = 3 } } } },
