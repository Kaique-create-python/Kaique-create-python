      <Item class="Folder" referent="89">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Gera o mundo inteiro de forma determinística (mesma semente = mesmo mapa).
-- Ilha cercada por oceano (terreno), regiões temáticas, estradas e decoração.
-- Pode ser chamado de novo para "reconstruir" o mapa (restauração completa).

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.IdeiasShared
local Config = require(Shared.Config)
local Rng = require(Shared.Util.Rng)
local Hash = require(Shared.Util.Hash)
local MapLayout = require(Shared.MapLayout)
local MapKit = require(script.Parent.MapKit)

local Regions = script.Parent.Regions
local Outlands = require(Regions.Outlands)
local REGION_MODULES = {
	require(Regions.Hub),
	require(Regions.Forest),
	require(Regions.City),
	require(Regions.Glacier),
	require(Regions.Volcano),
	Outlands.Desert,
	Outlands.Beach,
	Outlands.Sky,
	Outlands.Arena,
}

local MapBuilder = {}

local function islandBase()
	local M = Enum.Material
	local terrain = Workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(40, 140, 190)
	terrain.WaterTransparency = 0.55
	terrain.WaterReflectance = 0.5
	terrain.WaterWaveSize = 0.15
	terrain.WaterWaveSpeed = 8
	-- oceano
	MapKit.fillBlock(CFrame.new(0, -12, 0), Vector3.new(1600, 16, 1600), M.Water)
	-- praia em volta e ilha
	MapKit.fillCylinder(CFrame.new(0, -11, 0), 16, 620, M.Sand)
	MapKit.fillCylinder(CFrame.new(0, -10, 0), 20, 585, M.Grass)
	-- leito do mar (fundo)
	MapKit.fillBlock(CFrame.new(0, -24, 0), Vector3.new(1600, 8, 1600), M.Sand)
end

local function roads(folder: Instance)
	local M = Enum.Material
	local Kit = require(script.Parent.Parent.Builders).Kit
	local b = Kit.new("Estradas", CFrame.identity, { anchored = true, collide = true })
	for _, r in MapLayout.Regions do
		if r.id ~= "hub" and r.id ~= "sky" and r.id ~= "arena" then
			local dir = Vector3.new(r.center.X, 0, r.center.Z).Unit
			local startD, endD = 96, (Vector3.new(r.center.X, 0, r.center.Z)).Magnitude - r.radius * 0.45
			local d = startD
			while d < endD do
				local p = dir * (d + 6)
				local y = MapKit.heightAt(p.X, p.Z)
				b:box(Vector3.new(12, 0.5, 12.4), CFrame.lookAt(Vector3.new(p.X, y + 0.2, p.Z), Vector3.new(p.X + dir.X, y + 0.2, p.Z + dir.Z)), Color3.fromRGB(165, 155, 140), { role = "fixed", material = M.Cobblestone })
				-- bordas e postes de luz a cada 48 studs
				if math.floor(d) % 48 < 12 then
					local side = dir:Cross(Vector3.yAxis)
					local lp = p + side * 8
					b:cylY(9, 0.5, CFrame.new(lp.X, y + 4.5, lp.Z), Color3.fromRGB(50, 50, 58), { role = "fixed", material = M.Metal })
					b:ball(1.4, CFrame.new(lp.X, y + 9.4, lp.Z), r.color, { role = "fixed", material = M.Neon })
				end
				d += 12
			end
		end
	end
	local m = b:finish()
	m.Parent = folder
	local n = 0
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			n += 1
		end
	end
	return n
end

export type Stats = { parts: number, regions: { [string]: number }, seconds: number, terrainOps: number? }

function MapBuilder.build(opts: { fast: boolean?, seed: number? }?): Stats
	local o = opts or {}
	local t0 = os.clock()
	local seed = o.seed or Config.WorldSeed
	MapKit.resetTerrain()
	local old = Workspace:FindFirstChild("Mapa")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "Mapa"
	root.Parent = Workspace
	local destr = Instance.new("Model")
	destr.Name = "Destrutiveis"
	destr:AddTag("DestrutivelGrupo")
	destr.Parent = root

	islandBase()
	local stats: Stats = { parts = 0, regions = {}, seconds = 0 }
	for _, mod in REGION_MODULES do
		local region = MapLayout.ById[mod.id]
		local folder = Instance.new("Model")
		folder.Name = "Regiao_" .. mod.id
		folder:SetAttribute("Regiao", mod.id)
		folder.Parent = root
		local rng = Rng.new(seed + Hash.str(mod.id) % 100000)
		local ctx = MapKit.region(folder, destr, rng, region.center)
		local ok, err = pcall(mod.build, ctx)
		if not ok then
			warn("[Ideias] região " .. mod.id .. " falhou: " .. tostring(err))
		end
		stats.regions[mod.id] = ctx.parts
		stats.parts += ctx.parts
		if not o.fast then
			task.wait()
		end
	end
	local roadParts = roads(root)
	stats.regions.estradas = roadParts
	stats.parts += roadParts
	local destrCount = 0
	for _, d in destr:GetDescendants() do
		if d:IsA("BasePart") then
			destrCount += 1
		end
	end
	stats.regions.destrutiveis = destrCount
	stats.seconds = os.clock() - t0
	-- as plataformas iniciais do arquivo ficam sob o palco
	local spawn = Workspace:FindFirstChild("SpawnCentral") :: BasePart?
	if spawn then
		spawn.CFrame = CFrame.new(0, MapKit.heightAt(0, 34) + 1.4, 34)
	end
	return stats
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">MapKit</string>
            <string name="Source"><![CDATA[--!strict
-- Ferramentas para gerar o mapa:
--   * terreno (Terrain) com registro das elevações -> heightAt(x, z) analítico,
--     sem depender de raycast (funciona igual no Roblox e nos testes do Lune)
--   * atalhos para peças, objetos e construções reutilizando os construtores
--   * marcação de destrutíveis, perigos (lava), plataformas de salto e teleportes
-- A conexão de eventos (prompts, toques) fica em MapRuntime, fora da geração.

local Workspace = game:GetService("Workspace")
local Builders = require(script.Parent.Parent.Builders)
local Kit = Builders.Kit

local MapKit = {}
MapKit.__index = MapKit

export type Hill = { x: number, z: number, r: number, top: number, kind: string }

local hills: { Hill } = {}
local flats: { { x: number, z: number, r: number, y: number } } = {}

MapKit.SURFACE = 0 -- altura do chão da ilha

function MapKit.resetTerrain()
	table.clear(hills)
	table.clear(flats)
end

-- altura do chão em (x, z) considerando morros e platôs registrados
function MapKit.heightAt(x: number, z: number): number
	local h = MapKit.SURFACE
	local dist = math.sqrt(x * x + z * z)
	if dist > 585 then
		h = -3
	end
	for _, f in flats do
		local d = math.sqrt((x - f.x) ^ 2 + (z - f.z) ^ 2)
		if d < f.r then
			h = f.y
		end
	end
	for _, hill in hills do
		local d = math.sqrt((x - hill.x) ^ 2 + (z - hill.z) ^ 2)
		if d < hill.r then
			local y: number
			if hill.kind == "cone" then
				y = hill.top * (1 - d / hill.r)
			else
				-- calota esférica
				local t = d / hill.r
				y = hill.top * math.sqrt(math.max(0, 1 - t * t))
			end
			h = math.max(h, y)
		end
	end
	return h
end

local terrain = Workspace.Terrain

function MapKit.fillBlock(cf: CFrame, size: Vector3, material: Enum.Material)
	terrain:FillBlock(cf, size, material)
end

function MapKit.fillBall(center: Vector3, radius: number, material: Enum.Material)
	terrain:FillBall(center, radius, material)
end

function MapKit.fillCylinder(cf: CFrame, height: number, radius: number, material: Enum.Material)
	terrain:FillCylinder(cf, height, radius, material)
end

-- morro arredondado: bola enterrada; registra altura para heightAt
function MapKit.hill(x: number, z: number, radius: number, top: number, material: Enum.Material)
	-- esfera de raio R com centro em y = top - R corta o chão em raio r
	local R = (radius * radius + top * top) / (2 * top)
	terrain:FillBall(Vector3.new(x, top - R, z), R, material)
	table.insert(hills, { x = x, z = z, r = radius, top = top, kind = "dome" })
end

-- montanha cônica em degraus de cilindros
function MapKit.mountain(x: number, z: number, radius: number, top: number, material: Enum.Material, capMaterial: Enum.Material?)
	local steps = 8
	for i = 0, steps - 1 do
		local t0 = i / steps
		local r = radius * (1 - t0)
		local y0 = top * t0
		local mat = if capMaterial and t0 > 0.65 then capMaterial else material
		terrain:FillCylinder(CFrame.new(x, y0 + top / steps / 2 - 1, z), top / steps + 2, r, mat)
	end
	table.insert(hills, { x = x, z = z, r = radius, top = top, kind = "cone" })
end

function MapKit.flat(x: number, z: number, radius: number, y: number)
	table.insert(flats, { x = x, z = z, r = radius, y = y })
end

-- Contexto de uma região -----------------------------------------------------------
function MapKit.region(folder: Instance, destructibles: Instance, rng: any, center: Vector3): any
	return setmetatable({ folder = folder, destr = destructibles, rng = rng, center = center, parts = 0 }, MapKit)
end

function MapKit.at(self: any, x: number, z: number, yOffset: number?, rotY: number?): CFrame
	local wx, wz = self.center.X + x, self.center.Z + z
	return CFrame.new(wx, MapKit.heightAt(wx, wz) + (yOffset or 0), wz) * CFrame.Angles(0, rotY or 0, 0)
end

function MapKit.world(self: any, x: number, z: number): (number, number)
	return self.center.X + x, self.center.Z + z
end

local function count(self: any, m: Instance)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			self.parts += 1
		end
	end
	if m:IsA("BasePart") then
		self.parts += 1
	end
end

-- constrói peças com o Kit e coloca na região
function MapKit.build(self: any, name: string, cf: CFrame, fn: (any) -> (), params: { [string]: any }?): Model
	local p = params or {}
	if p.anchored == nil then
		p.anchored = true
	end
	local b = Kit.new(name, cf, p)
	fn(b)
	local m = b:finish()
	m.Parent = self.folder
	count(self, m)
	return m
end

function MapKit.prop(self: any, model: string, variant: string, cf: CFrame, scale: number?, extra: { [string]: any }?): Model
	local params: { [string]: any } = { scale = scale or 1, rng = self.rng }
	if extra then
		for k, v in extra do
			params[k] = v
		end
	end
	local r = Builders.Props.build(cf, params, model, variant)
	r.model.Parent = self.folder
	count(self, r.model)
	return r.model
end

function MapKit.building(self: any, variant: string, cf: CFrame, params: { [string]: any }?): any
	local p: { [string]: any } = params or {}
	p.rng = self.rng
	p.scale = p.scale or 1
	local r = Builders.Buildings.build(cf, p, variant)
	r.model.Parent = self.folder
	pcall(function()
		(r.model :: any).ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	end)
	count(self, r.model)
	return r
end

-- veículo decorativo (estacionado e ancorado)
function MapKit.parkedVehicle(self: any, variant: string, cf: CFrame): Model
	local v = Builders.Vehicles.build(cf, { rng = self.rng, scale = 1 }, variant)
	for _, d in v.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("VehicleSeat") then
			d.Disabled = true
		end
	end
	v.model:RemoveTag("IdeiasVeiculo")
	v.model.Parent = self.folder
	count(self, v.model)
	return v.model
end

-- move um modelo para o grupo de destrutíveis (volta sozinho depois)
function MapKit.destructible(self: any, model: Instance)
	model.Parent = self.destr
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d:AddTag("Destrutivel")
		end
	end
	if model:IsA("BasePart") then
		model:AddTag("Destrutivel")
	end
end

function MapKit.hazard(part: BasePart, kind: string, dps: number)
	part:AddTag("Perigo")
	part:SetAttribute("Perigo", kind)
	part:SetAttribute("Dano", dps)
end

function MapKit.jumpPad(self: any, cf: CFrame, direction: Vector3, force: number, color: Color3?): BasePart
	local m = self:build("PlataformaSalto", cf, function(b)
		b:cylY(1, 10, CFrame.new(0, 0.5, 0), Color3.fromRGB(40, 40, 55), { role = "fixed", material = Enum.Material.DiamondPlate })
		local pad = b:cylY(0.4, 8, CFrame.new(0, 1.1, 0), color or Color3.fromRGB(80, 255, 200), { role = "fixed", material = Enum.Material.Neon, name = "Pulo" })
		pad:AddTag("IdeiasPulo")
		pad:SetAttribute("Forca", force)
		pad:SetAttribute("Direcao", direction.Unit)
		b:part("wedge", Vector3.new(1.4, 0.6, 2.4), CFrame.new(0, 1.5, 0) * CFrame.lookAt(Vector3.zero, Vector3.new(direction.X, 0, direction.Z)).Rotation * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(255, 255, 255), { role = "fixed", material = Enum.Material.Neon, collide = false })
	end)
	return m:FindFirstChild("Pulo", true) :: BasePart
end

-- plataforma de teleporte com ProximityPrompt (conectada em MapRuntime)
function MapKit.teleportPad(self: any, cf: CFrame, target: CFrame, label: string, color: Color3): BasePart
	local m = self:build("Teleporte", cf, function(b)
		b:cylY(1.2, 12, CFrame.new(0, 0.6, 0), Color3.fromRGB(35, 35, 45), { role = "fixed", material = Enum.Material.Slate })
		local ring = b:cylY(0.3, 10, CFrame.new(0, 1.3, 0), color, { role = "fixed", material = Enum.Material.Neon, name = "Anel" })
		ring:AddTag("IdeiasTeleporte")
		ring:SetAttribute("Destino", target)
		ring:SetAttribute("Rotulo", label)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Viajar"
		prompt.ObjectText = label
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = ring
		local e = Instance.new("ParticleEmitter")
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Rate = 6
		e.Lifetime = NumberRange.new(1, 1.6)
		e.Speed = NumberRange.new(3, 6)
		e.EmissionDirection = Enum.NormalId.Top
		e.Color = ColorSequence.new(color)
		e.Parent = ring
	end)
	return m:FindFirstChild("Anel", true) :: BasePart
end

function MapKit.sign(part: BasePart, text: string, color: Color3, face: Enum.NormalId?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face or Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(600, 150)
	gui.LightInfluence = 0
	gui.MaxDistance = 300
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color
	label.Font = Enum.Font.GothamBlack
	label.TextStrokeTransparency = 0.5
	label.Parent = gui
	gui.Parent = part
end

function MapKit.spin(part: BasePart, axis: string, speed: number)
	part:AddTag("IdeiasGirar")
	part:SetAttribute("GirarEixo", axis)
	part:SetAttribute("GirarVel", speed)
end

function MapKit.emitter(part: BasePart, texture: string, color: Color3, rate: number, opts: { [string]: any }?): ParticleEmitter
	local o = opts or {}
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = o.lifetime or NumberRange.new(2, 4)
	e.Speed = o.speed or NumberRange.new(1, 3)
	e.SpreadAngle = o.spread or Vector2.new(180, 180)
	e.Size = o.size or NumberSequence.new(0.5)
	e.LightEmission = o.light or 0.5
	e.Transparency = o.transparency or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	if o.accel then
		e.Acceleration = o.accel
	end
	e.Parent = part
	return e
end

return MapKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">MapRuntime</string>
            <string name="Source"><![CDATA[--!strict
-- Comportamentos do mapa em tempo de jogo (separados da geração para que
-- a geração rode também nos testes offline):
--   * plataformas de teleporte (ProximityPrompt)
--   * zonas de perigo (lava) checadas por raycast barato a cada 0,5 s
--   * acontecimentos ambientais ocasionais por região

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.IdeiasShared.Config)
local Status = require(script.Parent.Parent.Core.Status)
local Fx = require(script.Parent.Parent.Core.Fx)

local MapRuntime = {}

local function hookTeleport(part: Instance)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		return
	end
	prompt.Triggered:Connect(function(player)
		local target = part:GetAttribute("Destino")
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if typeof(target) == "CFrame" and root then
			Fx.near(root.Position, 200, "poof", { p = root.Position, s = 1 })
			root.CFrame = target :: CFrame
			Fx.to(player, "toast", { t = "✈️ " .. tostring(part:GetAttribute("Rotulo")), c = Color3.fromRGB(150, 220, 255) })
		end
	end)
end

local function hazards()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	while true do
		task.wait(0.5)
		for _, player in Players:GetPlayers() do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				params.FilterDescendantsInstances = { char :: Instance }
				local hit = Workspace:Raycast(root.Position, Vector3.new(0, -8, 0), params)
				local part = hit and hit.Instance
				if part and part:HasTag("Perigo") then
					local dps = (part:GetAttribute("Dano") :: number?) or 8
					hum:TakeDamage(dps * 0.5)
					Status.apply(hum, "burn", 2)
				elseif hit and hit.Material == Enum.Material.CrackedLava then
					hum:TakeDamage(3)
					Status.apply(hum, "burn", 1.5)
				end
			end
		end
	end
end

function MapRuntime.start()
	for _, part in CollectionService:GetTagged("IdeiasTeleporte") do
		hookTeleport(part)
	end
	CollectionService:GetInstanceAddedSignal("IdeiasTeleporte"):Connect(hookTeleport)
	task.spawn(hazards)
	-- eventos ambientais leves (sem custo de orçamento): meteoritos decorativos
	-- no céu à noite, gêiser de vapor no vulcão
	task.spawn(function()
		while true do
			task.wait(Config.World.AmbientEventInterval)
			local clock = game:GetService("Lighting").ClockTime
			if clock > 19 or clock < 5 then
				Fx.near(nil, nil, "shootingstar", {})
			end
		end
	end)
end

return MapRuntime
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="93">
          <Properties>
            <string name="Name">Regions</string>
          </Properties>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">City</string>
              <string name="Source"><![CDATA[--!strict
-- Cidade Neon: ruas com faixas, calçadas, prédios variados com fachadas de
-- vidro e neon, painéis holográficos, passarela elevada, torre central com
-- anel giratório, laboratório em cúpula, carros estacionados e postes neon.

local MapKit = require(script.Parent.Parent.MapKit)

local City = { id = "city" }

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

local NEON = { rgb(255, 60, 200), rgb(60, 220, 255), rgb(140, 255, 120), rgb(255, 200, 60), rgb(170, 100, 255) }
local SIGNS = { "NEON", "IDEIAS", "LOJA 24H", "CAFÉ", "ROBÔS", "FUTURO", "PIZZA", "GAMES", "HOTEL", "LAB" }

function City.build(ctx: any)
	local rng = ctx.rng
	local c = ctx.center
	local M = Enum.Material
	MapKit.fillBlock(CF(c.X, -1.5, c.Z), V(320, 3, 320), M.Concrete)
	MapKit.flat(c.X, c.Z, 165, 0)

	-- malha de ruas
	ctx:build("Ruas", CF(c.X, 0, c.Z), function(b)
		local asphalt = rgb(48, 48, 54)
		for _, k in { -96, -32, 32, 96 } do
			b:box(V(300, 0.3, 16), CF(0, 0.15, k), asphalt, { role = "fixed", material = M.Asphalt })
			b:box(V(16, 0.31, 300), CF(k, 0.155, 0), asphalt, { role = "fixed", material = M.Asphalt })
			for s = -140, 140, 12 do
				if math.abs(s - (-96)) > 9 and math.abs(s + 32) > 9 and math.abs(s - 32) > 9 and math.abs(s - 96) > 9 then
					b:box(V(5, 0.33, 0.5), CF(s, 0.17, k), rgb(250, 220, 70), { role = "fixed", collide = false })
					b:box(V(0.5, 0.34, 5), CF(k, 0.17, s), rgb(250, 220, 70), { role = "fixed", collide = false })
				end
			end
		end
	end)

	-- quarteirões com prédios
	local blocks = { -128, -64, 0, 64, 128 }
	local lots = 0
	for _, bx in blocks do
		for _, bz in blocks do
			if not (bx == 0 and bz == 0) then
				lots += 1
				-- calçada
				ctx:build("Calcada", CF(c.X + bx, 0, c.Z + bz), function(b)
					b:box(V(44, 0.6, 44), CF(0, 0.3, 0), rgb(150, 150, 158), { role = "fixed", material = M.Pavement })
				end)
				if math.abs(bx) == 128 or math.abs(bz) == 128 or rng:chance(0.7) then
					local floors = rng:int(4, 11)
					if math.abs(bx) <= 64 and math.abs(bz) <= 64 then
						floors += 4
					end
					ctx:build("Predio", CF(c.X + bx, 0.6, c.Z + bz), function(b)
						local w = rng:range(22, 32)
						local d = rng:range(22, 32)
						local fh = 5
						local body = rng:pick({ rgb(40, 44, 60), rgb(60, 64, 80), rgb(30, 34, 46), rgb(80, 80, 96) })
						local glow = rng:pick(NEON)
						b:box(V(w, floors * fh, d), CF(0, floors * fh / 2, 0), body, { role = "fixed", material = M.Concrete })
						for f = 1, floors do
							if f % 2 == 1 or floors < 6 then
								b:box(V(w + 0.3, 1.8, d + 0.3), CF(0, (f - 0.4) * fh, 0), rgb(130, 200, 255), { role = "fixed", material = M.Glass, transparency = 0.2, reflectance = 0.25 })
							end
						end
						b:box(V(w + 0.6, 0.5, d + 0.6), CF(0, floors * fh, 0), glow, { role = "fixed", material = M.Neon })
						for _, x in { -w / 2, w / 2 } do
							b:box(V(0.4, floors * fh, 0.4), CF(x, floors * fh / 2, -d / 2 - 0.2), glow, { role = "fixed", material = M.Neon, collide = false })
						end
						if rng:chance(0.6) then
							local sign = b:box(V(12, 4, 0.6), CF(0, floors * fh * 0.55, -d / 2 - 0.6), rgb(20, 20, 30), { role = "fixed", name = "Painel" })
							MapKit.sign(sign, rng:pick(SIGNS), glow, Enum.NormalId.Front)
							sign:AddTag("IdeiasTela")
						end
						if rng:chance(0.5) then
							b:cylY(10, 0.5, CF(w * 0.2, floors * fh + 5, 0), rgb(180, 180, 190), { role = "fixed", material = M.Metal })
							local l = b:ball(1, CF(w * 0.2, floors * fh + 10.5, 0), rgb(255, 50, 50), { role = "fixed", material = M.Neon })
							local _ = l
						end
					end)
				else
					-- praça de bolso: árvore, bancos e carro
					ctx:prop("nature", "tree", CF(c.X + bx, 0.6, c.Z + bz), 1)
					local bench = ctx:prop("prop", "bench", CF(c.X + bx + 10, 0.6, c.Z + bz), 0.8)
					ctx:destructible(bench)
				end
			end
		end
	end

	-- torre central com anel girando
	ctx:build("TorreCentral", CF(c.X, 0, c.Z), function(b)
		b:box(V(44, 0.6, 44), CF(0, 0.3, 0), rgb(160, 160, 170), { role = "fixed", material = M.Pavement })
		b:cylY(110, 10, CF(0, 55, 0), rgb(200, 205, 220), { role = "fixed", material = M.Metal })
		for k = 0, 9 do
			b:cylY(1, 11, CF(0, 8 + k * 10, 0), NEON[(k % #NEON) + 1], { role = "fixed", material = M.Neon })
		end
		b:cone(18, 10, CF(0, 110, 0), rgb(200, 205, 220), 4, { role = "fixed", material = M.Metal })
		local pivot = b:box(V(1, 1, 1), CF(0, 80, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false, name = "Pivo" })
		MapKit.spin(pivot, "Y", 0.3)
		for k = 0, 15 do
			local a = k / 16 * math.pi * 2
			local seg = b:box(V(5, 1, 1.4), CF(math.cos(a) * 16, 80, math.sin(a) * 16) * ANG(0, -a + math.pi / 2, 0), rgb(60, 220, 255), { role = "fixed", material = M.Neon, collide = false })
			seg.Parent = pivot
		end
		local top = b:ball(3, CF(0, 129, 0), rgb(255, 80, 200), { role = "fixed", material = M.Neon })
		b:light(top, rgb(255, 90, 210), 60, 3)
	end)

	-- passarela elevada entre dois quarteirões
	ctx:build("Passarela", CF(c.X - 64, 26, c.Z - 32), function(b)
		b:box(V(8, 1, 44), CF(0, 0, 0), rgb(200, 205, 215), { role = "fixed", material = M.Metal })
		b:box(V(8.2, 4, 44), CF(0, 2.5, 0), rgb(140, 220, 255), { role = "fixed", material = M.Glass, transparency = 0.6 })
		b:box(V(8.4, 0.3, 44), CF(0, -0.6, 0), rgb(60, 220, 255), { role = "fixed", material = M.Neon })
	end)

	-- laboratório em cúpula
	ctx:build("Laboratorio", CF(c.X + 128, 0.6, c.Z + 128), function(b)
		b:cylY(4, 34, CF(0, 2, 0), rgb(220, 225, 235), { role = "fixed", material = M.Metal })
		b:part("ball", V(30, 30, 30), CF(0, 4, 0), rgb(150, 220, 255), { role = "fixed", material = M.Glass, transparency = 0.5 })
		local core = b:ball(6, CF(0, 9, 0), rgb(120, 255, 160), { role = "fixed", material = M.Neon })
		b:light(core, rgb(120, 255, 160), 30, 2)
	end)

	-- carros estacionados e postes neon
	for k = 1, 8 do
		local lane = rng:pick({ -96, -32, 32, 96 })
		local along = rng:range(-130, 130)
		local horizontal = rng:chance(0.5)
		local x = if horizontal then along else lane + 5
		local z = if horizontal then lane + 5 else along
		local rot = if horizontal then math.pi / 2 else 0
		ctx:parkedVehicle(rng:pick({ "car", "sportscar", "car", "police_car" }), CF(c.X + x, 0.5, c.Z + z) * ANG(0, rot, 0))
	end
	for _, k in { -96, -32, 32, 96 } do
		for s = -128, 128, 64 do
			local lamp = ctx:build("PosteNeon", CF(c.X + s + 10, 0.6, c.Z + k + 9), function(b)
				b:cylY(12, 0.5, CF(0, 6, 0), rgb(40, 40, 48), { role = "fixed", material = M.Metal })
				b:box(V(4, 0.4, 0.8), CF(-1.8, 12, 0), rgb(40, 40, 48), { role = "fixed", material = M.Metal })
				b:box(V(3, 0.3, 0.7), CF(-2.4, 11.7, 0), rng:pick(NEON), { role = "fixed", material = M.Neon })
			end)
			ctx:destructible(lamp)
		end
	end
	-- caixas e lixeiras destrutíveis
	for k = 1, 12 do
		local m = ctx:prop("prop", rng:pick({ "crate", "barrel" }), CF(c.X + rng:range(-140, 140), 0.6, c.Z + rng:range(-140, 140)), 0.6)
		ctx:destructible(m)
	end
end

return City
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">Forest</string>
              <string name="Source"><![CDATA[--!strict
-- Floresta Encantada: morros, árvores variadas, árvore mágica gigante,
-- cogumelos luminosos, ruínas, cachoeira com lago, rio com ponte de pedra,
-- caverna, trilha e casa na árvore.

local MapKit = require(script.Parent.Parent.MapKit)

local Forest = { id = "forest" }

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

function Forest.build(ctx: any)
	local rng = ctx.rng
	local c = ctx.center
	local M = Enum.Material
	-- relevo: morros nas bordas
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2 + 0.3
		local r = 150 + rng:range(-10, 20)
		MapKit.hill(c.X + math.cos(a) * r, c.Z + math.sin(a) * r, rng:range(45, 70), rng:range(12, 24), if k % 2 == 0 then M.Grass else M.LeafyGrass)
	end
	MapKit.hill(c.X - 70, c.Z + 40, 40, 9, M.LeafyGrass)
	-- penhasco com cachoeira ao fundo
	local cliffX, cliffZ = c.X + 40, c.Z - 150
	MapKit.fillBlock(CF(cliffX, 22, cliffZ), V(110, 48, 34), M.Rock)
	MapKit.fillBlock(CF(cliffX, 47, cliffZ + 4), V(110, 4, 30), M.Grass)
	MapKit.fillBlock(CF(cliffX, 23, cliffZ + 18), V(12, 44, 3), M.Water)
	-- lago e rio até o mar
	MapKit.fillCylinder(CF(cliffX, -3, cliffZ + 40), 6, 26, M.Air)
	MapKit.fillCylinder(CF(cliffX, -4.5, cliffZ + 40), 3, 26, M.Water)
	MapKit.fillBlock(CF(cliffX + 70, -3, cliffZ + 40) * ANG(0, 0.25, 0), V(130, 6, 14), M.Air)
	MapKit.fillBlock(CF(cliffX + 70, -4.5, cliffZ + 40) * ANG(0, 0.25, 0), V(130, 3, 14), M.Water)
	-- caverna: morro de pedra com túnel
	MapKit.hill(c.X - 110, c.Z - 60, 38, 26, M.Slate)
	MapKit.fillCylinder(CF(c.X - 110, 6, c.Z - 60) * ANG(0, 0, math.rad(90)), 90, 7, M.Air)

	-- espuma da cachoeira
	ctx:build("Cachoeira", CF(cliffX, 0, cliffZ + 22), function(b)
		local mist = b:box(V(14, 1, 4), CF(0, 0.5, 0), rgb(220, 240, 255), { role = "fixed", transparency = 0.9, collide = false, name = "Nevoa" })
		MapKit.emitter(mist, "rbxasset://textures/particles/smoke_main.dds", rgb(235, 245, 255), 14, { speed = NumberRange.new(2, 5), size = NumberSequence.new(4, 9), lifetime = NumberRange.new(1.5, 2.5) })
	end)

	-- árvore mágica gigante no centro
	ctx:build("ArvoreMagica", ctx:at(0, 0), function(b)
		local bark = rgb(95, 68, 52)
		b:cylY(48, 12, CF(0, 24, 0), bark, { role = "fixed", material = M.Wood })
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			b:beam(V(math.cos(a) * 4, 4, math.sin(a) * 4), V(math.cos(a) * 12, 0, math.sin(a) * 12), 3.2, bark, { role = "fixed", material = M.Wood }, true)
			b:beam(V(0, 34 + k, 0), V(math.cos(a) * 20, 44 + k * 1.5, math.sin(a) * 20), 2.4, bark, { role = "fixed", material = M.Wood }, true)
		end
		for k = 0, 9 do
			local a = k / 10 * math.pi * 2
			local r = if k % 2 == 0 then 20 else 12
			b:ball(22, CF(math.cos(a) * r, 50 + (k % 3) * 4, math.sin(a) * r), rgb(70, 170, 120), { role = "fixed", material = M.Grass, shadow = k < 4 })
		end
		b:ball(26, CF(0, 60, 0), rgb(80, 185, 130), { role = "fixed", material = M.Grass })
		for k = 0, 13 do
			local a = k * 2.3
			local fruit = b:ball(2, CF(math.cos(a) * 21, 44 + (k % 4) * 3, math.sin(a) * 21), rgb(255, 120, 210), { role = "fixed", material = M.Neon, collide = false })
			if k % 4 == 0 then
				b:light(fruit, rgb(255, 140, 220), 18, 1.2)
			end
		end
	end)

	-- árvores espalhadas (evita o centro e o lago)
	local placed = 0
	local tries = 0
	while placed < 60 and tries < 300 do
		tries += 1
		local x, z = rng:range(-160, 160), rng:range(-160, 160)
		local d = math.sqrt(x * x + z * z)
		local nearLake = math.abs(x - 40) < 40 and math.abs(z + 110) < 40
		if d > 34 and d < 165 and not nearLake and math.abs(x) > 8 then
			placed += 1
			local kind = rng:pick({ "tree", "tree", "pine", "pine", "tree" })
			ctx:prop("nature", kind, ctx:at(x, z, 0, rng:range(0, 6)), rng:range(0.9, 1.5))
		end
	end
	-- cogumelos luminosos, flores, arbustos e pedras
	for k = 1, 22 do
		local x, z = rng:range(-150, 150), rng:range(-150, 150)
		if math.sqrt(x * x + z * z) > 30 then
			local pick = k % 4
			if pick == 0 then
				ctx:prop("nature", "mushroom", ctx:at(x, z), rng:range(0.6, 1.3), { collide = true })
			elseif pick == 1 then
				ctx:prop("nature", "flowers", ctx:at(x, z), 0.8)
			elseif pick == 2 then
				ctx:prop("nature", "bush", ctx:at(x, z), rng:range(0.9, 1.4))
			else
				ctx:prop("nature", "rock", ctx:at(x, z), rng:range(0.7, 1.6))
			end
		end
	end

	-- ruínas antigas
	ctx:build("Ruinas", ctx:at(-60, 70), function(b)
		local stone = rgb(170, 165, 150)
		b:box(V(30, 1.2, 22), CF(0, 0.6, 0), stone, { role = "fixed", material = M.Cobblestone })
		for k = 0, 5 do
			local h = if k % 2 == 0 then 14 else rng:range(4, 9)
			b:cylY(h, 2.4, CF(-12 + k * 4.8, 1.2 + h / 2, -8), stone, { role = "fixed", material = M.Marble })
		end
		b:box(V(10, 2, 3), CF(-9.6, 16, -8), stone, { role = "fixed", material = M.Marble })
		b:box(V(4, 3, 3), CF(8, 2.7, 6) * ANG(0.3, 0.6, 0.2), stone, { role = "fixed", material = M.Marble })
		b:box(V(3, 2, 6), CF(-4, 2.2, 7) * ANG(0, 0.4, 1.2), stone, { role = "fixed", material = M.Marble })
		local rune = b:box(V(6, 6, 0.6), CF(0, 4, 9) * ANG(0, 0, math.rad(45)), rgb(120, 255, 200), { role = "fixed", material = M.Neon, transparency = 0.3 })
		b:light(rune, rgb(120, 255, 200), 16, 1)
	end)

	-- ponte de pedra sobre o rio
	ctx:build("PonteRio", CF(cliffX + 60, 0, cliffZ + 36) * ANG(0, 0.25 + math.pi / 2, 0), function(b)
		local stone = rgb(150, 145, 140)
		for k = -4, 4 do
			local y = 3 - (k * k) * 0.12
			b:box(V(6, 1, 4.2), CF(0, y, k * 4), stone, { role = "fixed", material = M.Cobblestone })
		end
		for _, x in { -3.2, 3.2 } do
			for k = -4, 4, 2 do
				b:cylY(2, 0.6, CF(x, 4.4 - (k * k) * 0.12, k * 4), stone, { role = "fixed", material = M.Cobblestone })
			end
		end
	end)

	-- casa na árvore reaproveitando o construtor de construções
	ctx:building("treehouse", ctx:at(90, 60, 0, -0.8), { scale = 1 })

	-- vagalumes (partículas suaves) em pontos da floresta
	for k = 1, 5 do
		local x, z = rng:range(-120, 120), rng:range(-120, 120)
		ctx:build("Vagalumes", ctx:at(x, z, 6), function(b)
			local p = b:box(V(30, 8, 30), CF(0, 0, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false, name = "Area" })
			p.CanQuery = false
			MapKit.emitter(p, "rbxasset://textures/particles/sparkles_main.dds", rgb(220, 255, 140), 5, { speed = NumberRange.new(0.3, 1), size = NumberSequence.new(0.25), lifetime = NumberRange.new(3, 6), light = 1 })
		end)
	end

	-- trilha de pedras até o hub
	ctx:build("Trilha", CF(c.X, 0, c.Z), function(b)
		for k = 0, 24 do
			local z = 30 + k * 7
			local x = math.sin(k * 0.4) * 6
			b:part("cyl", V(0.4, rng:range(3, 4.5), rng:range(3, 4.5)), CF(x, MapKit.heightAt(c.X + x, c.Z + z) + 0.15, z) * ANG(0, 0, math.rad(90)), rgb(160, 150, 135), { role = "fixed", material = M.Slate, collide = false })
		end
	end)
end

return Forest
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">Glacier</string>
              <string name="Source"><![CDATA[--!strict
-- Região Glacial: montanhas nevadas, lago congelado, castelo de gelo,
-- cristais, iglus, pinheiros com neve, ponte de gelo sobre uma fenda e neve caindo.

local MapKit = require(script.Parent.Parent.MapKit)

local Glacier = { id = "glacier" }

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

function Glacier.build(ctx: any)
	local rng = ctx.rng
	local c = ctx.center
	local M = Enum.Material
	MapKit.fillCylinder(CF(c.X, -1.5, c.Z), 3.2, 180, M.Snow)
	-- montanhas ao fundo
	for k = 0, 4 do
		local a = math.pi * 0.15 + k / 4 * math.pi * 0.7
		local r = 150
		MapKit.mountain(c.X + math.cos(a) * r, c.Z + math.sin(a) * r, rng:range(45, 65), rng:range(50, 85), M.Rock, M.Snow)
	end
	MapKit.hill(c.X - 120, c.Z - 40, 50, 14, M.Snow)
	-- lago congelado
	MapKit.fillCylinder(CF(c.X + 70, -1.2, c.Z - 30), 2.6, 42, M.Glacier)
	MapKit.flat(c.X + 70, c.Z - 30, 42, 0.1)
	-- fenda com ponte de gelo
	MapKit.fillBlock(CF(c.X - 50, -6, c.Z + 30), V(14, 16, 90), M.Air)

	-- castelo de gelo
	ctx:building("castle", ctx:at(-20, 60, 0, math.pi), { scale = 0.9, material = "ice", color = { 0.75, 0.9, 1 } })

	ctx:build("PonteDeGelo", CF(c.X - 50, 0, c.Z + 30) * ANG(0, math.pi / 2, 0), function(b)
		for k = -2, 2 do
			b:box(V(6, 1, 3.6), CF(0, 0.5 + (4 - k * k) * 0.25, k * 3.6), rgb(190, 235, 255), { role = "fixed", material = M.Ice, transparency = 0.1 })
		end
		for _, x in { -2.8, 2.8 } do
			b:box(V(0.4, 1.4, 18), CF(x, 2.6, 0), rgb(200, 240, 255), { role = "fixed", material = M.Glass, transparency = 0.3 })
		end
	end)

	-- cristais de gelo e pinheiros nevados
	for k = 1, 14 do
		local x, z = rng:range(-150, 150), rng:range(-150, 150)
		if math.sqrt(x * x + z * z) > 40 then
			ctx:prop("nature", "crystal", ctx:at(x, z), rng:range(0.8, 1.8), { material = "ice" })
		end
	end
	for k = 1, 26 do
		local x, z = rng:range(-160, 160), rng:range(-160, 160)
		if math.sqrt(x * x + z * z) > 50 and not (math.abs(x - 70) < 46 and math.abs(z + 30) < 46) then
			local tree = ctx:prop("nature", "pine", ctx:at(x, z), rng:range(0.9, 1.4))
			local top = tree:GetExtentsSize()
			ctx:build("NeveNoPinheiro", ctx:at(x, z, top.Y * 0.55), function(b)
				b:part("ball", V(8, 2.5, 8), CF(0, 0, 0), rgb(250, 252, 255), { role = "fixed", material = M.Snow, collide = false })
			end)
		end
	end
	-- iglus e bonecos de neve
	ctx:building("igloo", ctx:at(90, 70, 0, -0.5))
	ctx:building("igloo", ctx:at(115, 40, 0, 0.8), { scale = 0.8 })
	for k = 1, 4 do
		ctx:prop("prop", "snowman", ctx:at(rng:range(-90, 90), rng:range(-20, 120)), rng:range(0.7, 1))
	end
	-- neve caindo sobre a região
	ctx:build("Neve", CF(c.X, 90, c.Z), function(b)
		for k = 0, 2 do
			local p = b:box(V(140, 1, 140), CF((k - 1) * 110, 0, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false, name = "Nuvem" })
			p.CanQuery = false
			MapKit.emitter(p, "rbxasset://textures/particles/sparkles_main.dds", rgb(255, 255, 255), 40, {
				speed = NumberRange.new(10, 16),
				spread = Vector2.new(10, 10),
				lifetime = NumberRange.new(6, 8),
				size = NumberSequence.new(0.45),
				accel = V(2, 0, 1),
				light = 0.3,
			}).EmissionDirection = Enum.NormalId.Bottom
		end
	end)
end

return Glacier
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">Hub</string>
              <string name="Source"><![CDATA[--!strict
-- Centro de Criação: praça circular com palco, lâmpada gigante (símbolo do
-- jogo), anel holográfico girando, quatro portais para as regiões, fontes,
-- jardins, bancos, postes e plataformas de viagem rápida.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapLayout = require(ReplicatedStorage.IdeiasShared.MapLayout)
local MapKit = require(script.Parent.Parent.MapKit)

local Hub = { id = "hub" }

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

function Hub.build(ctx: any)
	local rng = ctx.rng
	-- piso em anéis concêntricos
	ctx:build("Praca", CF(0, 0, 0), function(b)
		b:cylY(0.6, 190, CF(0, 0.3, 0), rgb(150, 150, 158), { role = "fixed", material = Enum.Material.Pavement })
		b:cylY(0.7, 150, CF(0, 0.35, 0), rgb(214, 210, 200), { role = "fixed", material = Enum.Material.Marble })
		b:cylY(0.75, 147, CF(0, 0.38, 0), rgb(90, 200, 255), { role = "fixed", material = Enum.Material.Neon })
		b:cylY(0.8, 144, CF(0, 0.4, 0), rgb(222, 218, 210), { role = "fixed", material = Enum.Material.Marble })
		b:cylY(0.85, 96, CF(0, 0.43, 0), rgb(70, 72, 92), { role = "fixed", material = Enum.Material.Slate })
		-- mosaico radial
		for k = 0, 23 do
			local a = k / 24 * math.pi * 2
			b:box(V(1.2, 0.2, 22), CF(math.cos(a) * 60, 0.86, math.sin(a) * 60) * ANG(0, -a + math.pi / 2, 0), if k % 2 == 0 then rgb(200, 190, 175) else rgb(180, 170, 158), { role = "fixed", material = Enum.Material.Marble, collide = false })
		end
	end)

	-- palco circular com degraus
	ctx:build("Palco", CF(0, 0, 0), function(b)
		for k = 0, 2 do
			b:cylY(1.2, 46 - k * 6, CF(0, 1.2 + k * 1.2, 0), if k == 2 then rgb(60, 60, 80) else rgb(225, 222, 215), { role = "fixed", material = if k == 2 then Enum.Material.Slate else Enum.Material.Marble })
		end
		b:cylY(0.2, 33.6, CF(0, 4.35, 0), rgb(110, 220, 255), { role = "fixed", material = Enum.Material.Neon })
		b:cylY(0.25, 32, CF(0, 4.4, 0), rgb(50, 52, 70), { role = "fixed", material = Enum.Material.Slate })
	end)

	-- lâmpada gigante: base, vidro, filamento brilhante
	local bulb = ctx:build("LampadaDasIdeias", CF(0, 4.4, 0), function(b)
		b:cylY(3, 7, CF(0, 1.5, 0), rgb(160, 165, 175), { role = "fixed", material = Enum.Material.Metal })
		for k = 0, 3 do
			b:cylY(0.6, 7.6, CF(0, 3.2 + k * 0.9, 0), rgb(190, 195, 205), { role = "fixed", material = Enum.Material.Metal })
		end
		b:cylY(1.2, 4, CF(0, 7.2, 0), rgb(40, 40, 45), { role = "fixed" })
		b:ball(20, CF(0, 17.5, 0), rgb(220, 245, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.55, name = "Vidro" })
		local core = b:ball(5.4, CF(0, 17, 0), rgb(255, 230, 120), { role = "fixed", material = Enum.Material.Neon, name = "Filamento" })
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			b:beam(V(math.cos(a) * 1.2, 8.5, math.sin(a) * 1.2), V(math.cos(a) * 1.6, 15, math.sin(a) * 1.6), 0.3, rgb(255, 210, 110), { role = "fixed", material = Enum.Material.Neon })
		end
		b:light(core, rgb(255, 230, 150), 60, 3)
	end)
	local _ = bulb

	-- anel holográfico girando em volta da lâmpada
	ctx:build("AnelHolografico", CF(0, 4.4, 0), function(b)
		local pivot = b:box(V(1, 1, 1), CF(0, 18, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false, name = "Pivo" })
		MapKit.spin(pivot, "Y", 0.35)
		for k = 0, 19 do
			local a = k / 20 * math.pi * 2
			local seg = b:box(V(4, 0.6, 0.6), CF(math.cos(a) * 15, 18 + math.sin(a * 3) * 0.8, math.sin(a) * 15) * ANG(0, -a + math.pi / 2, 0), if k % 2 == 0 then rgb(90, 220, 255) else rgb(200, 120, 255), { role = "fixed", material = Enum.Material.Neon, collide = false })
			seg.Parent = pivot
		end
	end)

	-- letreiro com o nome do jogo flutuando acima do palco, girando devagar
	ctx:build("Letreiro", CF(0, 0, 0), function(b)
		local pivot = b:box(V(1, 1, 1), CF(0, 40, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false, name = "PivoLetreiro" })
		MapKit.spin(pivot, "Y", 0.12)
		for k = 0, 1 do
			local a = k * math.pi
			local board = b:box(V(34, 6, 1), CF(0, 40, 0) * ANG(0, a, 0) * CF(0, 0, -4), rgb(30, 32, 50), { role = "fixed", collide = false, name = "Placa" })
			MapKit.sign(board, "IDEIAS SEM LIMITES", rgb(120, 230, 255), Enum.NormalId.Front)
			board.Parent = pivot
			local edge = b:box(V(34.4, 0.4, 1.2), CF(0, 37, 0) * ANG(0, a, 0) * CF(0, 0, -4), rgb(110, 220, 255), { role = "fixed", material = Enum.Material.Neon, collide = false })
			edge.Parent = pivot
		end
	end)

	-- portais para as regiões, com viagem rápida
	local gates = {
		{ id = "forest", angle = -math.pi / 2 },
		{ id = "city", angle = 0 },
		{ id = "glacier", angle = math.pi / 2 },
		{ id = "volcano", angle = math.pi },
	}
	for _, g in gates do
		local region = MapLayout.ById[g.id]
		local dir = V(math.cos(g.angle), 0, math.sin(g.angle))
		local pos = dir * 84
		local cf = CF(pos) * CFrame.lookAt(Vector3.zero, dir).Rotation
		ctx:build("Portal_" .. g.id, cf, function(b)
			for _, x in { -9, 9 } do
				b:cylY(16, 3, CF(x, 8, 0), rgb(220, 218, 212), { role = "fixed", material = Enum.Material.Marble })
				b:ball(3.6, CF(x, 16.5, 0), region.color, { role = "fixed", material = Enum.Material.Neon })
			end
			b:box(V(22, 2.4, 3), CF(0, 17, 0), rgb(220, 218, 212), { role = "fixed", material = Enum.Material.Marble })
			local board = b:box(V(16, 3.2, 0.6), CF(0, 20.4, 0), rgb(30, 32, 45), { role = "fixed", name = "Placa" })
			MapKit.sign(board, region.label, region.color, Enum.NormalId.Front)
			MapKit.sign(board, region.label, region.color, Enum.NormalId.Back)
			b:box(V(18, 0.3, 1), CF(0, 15.6, 0), region.color, { role = "fixed", material = Enum.Material.Neon })
		end)
		local target = CF(region.center + V(0, 8, 0) - dir * 40)
		ctx:teleportPad(CF(dir * 72 + V(0, 0.9, 0)), target, region.label, region.color)
	end
	-- plataformas para Deserto, Praia, Céu e Arena
	local extra = {
		{ id = "desert", angle = -math.pi / 4 },
		{ id = "beach", angle = math.pi * 3 / 4 },
		{ id = "arena", angle = math.pi / 4 },
	}
	for _, e in extra do
		local region = MapLayout.ById[e.id]
		local dir = V(math.cos(e.angle), 0, math.sin(e.angle))
		local target = if e.id == "arena" then CF(region.center + V(0, 6, 40)) else CF(region.center + V(0, 8, 0) - dir * 30)
		ctx:teleportPad(CF(dir * 80 + V(0, 0.9, 0)), target, region.label, region.color)
	end
	-- salto para as ilhas flutuantes
	local skyDir = (MapLayout.ById.sky.center - V(0, MapLayout.ById.sky.center.Y, 0)).Unit
	ctx:jumpPad(CF(V(-62, 0.9, -62)), (skyDir * 0.62 + V(0, 1, 0)).Unit, 380, rgb(200, 160, 255))

	-- fontes entre os portais
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		local p = V(math.cos(a) * 52, 0, math.sin(a) * 52)
		ctx:build("Fonte", CF(p), function(b)
			b:cylY(2.4, 18, CF(0, 1.2, 0), rgb(225, 222, 215), { role = "fixed", material = Enum.Material.Marble })
			b:cylY(1.6, 15.6, CF(0, 1.8, 0), rgb(80, 170, 240), { role = "fixed", material = Enum.Material.Glass, transparency = 0.35, collide = false })
			b:cylY(6, 2.4, CF(0, 4, 0), rgb(225, 222, 215), { role = "fixed", material = Enum.Material.Marble })
			b:cylY(0.8, 7, CF(0, 7, 0), rgb(225, 222, 215), { role = "fixed", material = Enum.Material.Marble })
			local spout = b:ball(1.6, CF(0, 8.2, 0), rgb(150, 220, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.3 })
			MapKit.emitter(spout, "rbxasset://textures/particles/sparkles_main.dds", rgb(170, 225, 255), 18, {
				speed = NumberRange.new(8, 12),
				spread = Vector2.new(25, 25),
				accel = V(0, -25, 0),
				lifetime = NumberRange.new(0.8, 1.2),
				size = NumberSequence.new(0.6),
			})
		end)
	end

	-- jardins, árvores, bancos e postes em anel
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2 + math.pi / 16
		local r = 104
		local p = V(math.cos(a) * r, 0, math.sin(a) * r)
		if k % 2 == 0 then
			ctx:prop("nature", rng:pick({ "tree", "tree", "pine" }), CF(p), rng:range(0.9, 1.2))
		else
			ctx:prop("nature", "flowers", CF(p), 0.9)
		end
	end
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		local p = V(math.cos(a) * 92, 0, math.sin(a) * 92)
		local face = CFrame.lookAt(p, Vector3.zero)
		local bench = ctx:prop("prop", "bench", face, 0.9)
		ctx:destructible(bench)
		local lamp = ctx:build("Poste", CF(V(math.cos(a + 0.13) * 97, 0, math.sin(a + 0.13) * 97)), function(b)
			b:cylY(12, 0.6, CF(0, 6, 0), rgb(40, 42, 50), { role = "fixed", material = Enum.Material.Metal })
			local l = b:ball(1.8, CF(0, 12.4, 0), rgb(255, 240, 200), { role = "fixed", material = Enum.Material.Neon })
			if k % 2 == 0 then
				b:light(l, rgb(255, 230, 180), 26, 1.4)
			end
		end)
		ctx:destructible(lamp)
	end
	-- caixas e barris espalhados (destrutíveis)
	for k = 1, 10 do
		local a = rng:range(0, math.pi * 2)
		local r = rng:range(112, 140)
		local m = ctx:prop("prop", rng:pick({ "crate", "crate", "barrel" }), CF(math.cos(a) * r, 0, math.sin(a) * r) * ANG(0, rng:range(0, 6), 0), 0.8)
		ctx:destructible(m)
	end
	-- escotilha para a arena subterrânea (visual) já coberta pela plataforma acima
	MapKit.flat(0, 0, 96, 0)
end

return Hub
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">Outlands</string>
              <string name="Source"><![CDATA[--!strict
-- Áreas adicionais: Deserto das Ruínas, Praia dos Coqueiros, Ilhas Flutuantes
-- e Arena Subterrânea.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapLayout = require(ReplicatedStorage.IdeiasShared.MapLayout)
local MapKit = require(script.Parent.Parent.MapKit)

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

local Desert = { id = "desert" }
function Desert.build(ctx: any)
	local rng = ctx.rng
	local c = ctx.center
	local M = Enum.Material
	MapKit.fillCylinder(CF(c.X, -1.5, c.Z), 3.2, 130, M.Sand)
	for k = 1, 7 do
		MapKit.hill(c.X + rng:range(-110, 110), c.Z + rng:range(-110, 110), rng:range(25, 45), rng:range(5, 12), M.Sand)
	end
	-- oásis
	MapKit.fillCylinder(CF(c.X + 50, -2, c.Z + 40), 4, 18, M.Air)
	MapKit.fillCylinder(CF(c.X + 50, -3.5, c.Z + 40), 2, 18, M.Water)
	ctx:building("pyramid", ctx:at(-30, -40, 0, 0.3), { scale = 1.3 })
	ctx:building("pyramid", ctx:at(40, -80, 0, -0.2), { scale = 0.7 })
	-- obeliscos e colunas quebradas
	for k = 1, 4 do
		ctx:build("Obelisco", ctx:at(rng:range(-90, 90), rng:range(-90, 90)), function(b)
			local h = rng:range(14, 24)
			b:box(V(3, h, 3), CF(0, h / 2, 0), rgb(215, 185, 125), { role = "fixed", material = M.Sandstone })
			b:part("wedge", V(3, 2, 1.5), CF(0, h + 1, -0.75), rgb(255, 215, 90), { role = "fixed", material = M.Foil })
			b:part("wedge", V(3, 2, 1.5), CF(0, h + 1, 0.75) * ANG(0, math.pi, 0), rgb(255, 215, 90), { role = "fixed", material = M.Foil })
		end)
	end
	for k = 1, 8 do
		local m = ctx:build("Coluna", ctx:at(rng:range(-100, 100), rng:range(-100, 100), 0, rng:range(0, 6)), function(b)
			local h = rng:range(3, 9)
			b:cylY(h, 2.6, CF(0, h / 2, 0), rgb(220, 200, 160), { role = "fixed", material = M.Sandstone })
		end)
		if k % 2 == 0 then
			ctx:destructible(m)
		end
	end
	for k = 1, 12 do
		ctx:prop("nature", "cactus", ctx:at(rng:range(-110, 110), rng:range(-110, 110)), rng:range(0.7, 1.3))
	end
	for k = 1, 5 do
		local a = k / 5 * math.pi * 2
		ctx:prop("nature", "palm", ctx:at(50 + math.cos(a) * 24, 40 + math.sin(a) * 24), rng:range(0.9, 1.2))
	end
end

local Beach = { id = "beach" }
function Beach.build(ctx: any)
	local rng = ctx.rng
	local c = ctx.center
	local M = Enum.Material
	-- areia descendo até o mar
	for k = 0, 4 do
		local off = V(-1, 0, 1).Unit * (k * 26)
		MapKit.fillCylinder(CF(c.X + off.X, -1.5 - k * 0.6, c.Z + off.Z), 3.2, 110 - k * 8, M.Sand)
	end
	MapKit.flat(c.X, c.Z, 100, 0)
	for k = 1, 14 do
		ctx:prop("nature", "palm", ctx:at(rng:range(-90, 70), rng:range(-70, 90)), rng:range(0.9, 1.4))
	end
	for k = 1, 6 do
		local x, z = rng:range(-60, 60), rng:range(-40, 60)
		ctx:prop("prop", "umbrella", ctx:at(x, z), 0.9)
		ctx:build("Toalha", ctx:at(x + 4, z), function(b)
			b:box(V(4, 0.15, 7), CF(0, 0.08, 0), rng:pick({ rgb(255, 90, 90), rgb(90, 160, 255), rgb(255, 220, 80) }), { role = "fixed", material = M.Fabric, collide = false })
		end)
	end
	-- castelo de areia e píer
	ctx:building("castle", ctx:at(20, -30, 0, 0.4), { scale = 0.18, material = "stone", color = { 0.9, 0.8, 0.55 } })
	ctx:build("Pier", ctx:at(-70, 70, 0, -math.pi / 4), function(b)
		local wood = rgb(150, 110, 70)
		for k = 0, 11 do
			b:box(V(8, 0.6, 4), CF(0, 1.5, -k * 4.2), wood, { role = "fixed", material = M.WoodPlanks })
			if k % 3 == 0 then
				for _, x in { -3.6, 3.6 } do
					b:cylY(8, 0.8, CF(x, -1.5, -k * 4.2), rgb(110, 80, 50), { role = "fixed", material = M.Wood })
				end
			end
		end
	end)
	ctx:build("Salvavidas", ctx:at(-30, 30), function(b)
		for _, x in { -2, 2 } do
			for _, z in { -2, 2 } do
				b:cylY(8, 0.5, CF(x, 4, z), rgb(250, 250, 250), { role = "fixed" })
			end
		end
		b:box(V(6, 0.6, 6), CF(0, 8.3, 0), rgb(230, 60, 60), { role = "fixed" })
		b:roof(6.6, 6.6, 2.4, CF(0, 11.5, 0), rgb(230, 60, 60), { role = "fixed" })
		b:box(V(6, 3, 0.3), CF(0, 9.8, -3), rgb(250, 250, 250), { role = "fixed" })
	end)
end

local Sky = { id = "sky" }
function Sky.build(ctx: any)
	local rng = ctx.rng
	local c = ctx.center
	local M = Enum.Material
	local islands = {
		{ V(0, 0, 0), 46 },
		{ V(80, 20, 40), 26 },
		{ V(-70, 35, 50), 22 },
		{ V(40, 50, -80), 24 },
		{ V(-60, -15, -60), 20 },
	}
	for i, isl in islands do
		local pos, r = c + isl[1], isl[2]
		ctx:build("Ilha", CF(pos), function(b)
			b:cylY(5, r * 2, CF(0, 0, 0), rgb(110, 190, 90), { role = "fixed", material = M.Grass })
			b:cylY(3, r * 2 - 2, CF(0, -3.5, 0), rgb(130, 100, 75), { role = "fixed", material = M.Ground })
			b:cone(r * 1.1, r * 1.9, CF(0, -4, 0) * ANG(math.pi, 0, 0), rgb(120, 105, 95), 5, { role = "fixed", material = M.Slate })
			for k = 1, math.floor(r / 8) do
				local a = rng:range(0, math.pi * 2)
				local d = rng:range(4, r * 0.7)
				local col = rng:pick({ rgb(255, 160, 220), rgb(160, 230, 255), rgb(200, 255, 170) })
				b:cylY(rng:range(6, 9), 1.4, CF(math.cos(a) * d, 6, math.sin(a) * d), rgb(110, 80, 60), { role = "fixed", material = M.Wood })
				b:ball(rng:range(7, 10), CF(math.cos(a) * d, 11, math.sin(a) * d), col, { role = "fixed", material = M.Grass })
			end
			if i == 1 then
				-- templo do cristal no topo da ilha principal
				for k = 0, 5 do
					local a = k / 6 * math.pi * 2
					b:cylY(14, 2, CF(math.cos(a) * 12, 9.5, math.sin(a) * 12), rgb(245, 240, 255), { role = "fixed", material = M.Marble })
				end
				b:cylY(1.4, 30, CF(0, 17, 0), rgb(245, 240, 255), { role = "fixed", material = M.Marble })
				local crystal = b:part("wedge", V(6, 14, 6), CF(0, 10, 0), rgb(200, 150, 255), { role = "fixed", material = M.Neon, transparency = 0.15, name = "Cristal" })
				MapKit.spin(crystal, "Y", 0.4)
				b:light(crystal, rgb(200, 150, 255), 50, 3)
				local fall = b:box(V(6, 60, 1.6), CF(r - 2, -28, 0), rgb(160, 220, 255), { role = "fixed", material = M.Glass, transparency = 0.45, collide = false })
				MapKit.emitter(fall, "rbxasset://textures/particles/smoke_main.dds", rgb(235, 245, 255), 4, { speed = NumberRange.new(0, 1), size = NumberSequence.new(4, 8) })
			end
		end)
	end
	-- trilha de nuvens entre as ilhas
	for i = 2, #islands do
		local a, bpos = c + islands[1][1], c + islands[i][1]
		for k = 1, 4 do
			local p = a:Lerp(bpos, k / 5) + V(0, 3, 0)
			ctx:build("Nuvem", CF(p), function(b)
				for j = 0, 3 do
					b:ball(rng:range(5, 7), CF(math.cos(j * 1.6) * 2.6, 0, math.sin(j * 1.6) * 2.6), rgb(250, 252, 255), { role = "fixed", collide = true })
				end
			end)
		end
	end
	-- volta ao chão
	local hub = MapLayout.ById.hub
	ctx:teleportPad(CF(c + V(-20, 3, 20)), CF(hub.center + V(0, 8, 40)), "Voltar ao Centro", rgb(120, 220, 255))
end

local Arena = { id = "arena" }
function Arena.build(ctx: any)
	local c = ctx.center
	local M = Enum.Material
	ctx:build("Arena", CF(c), function(b)
		local stone = rgb(90, 80, 75)
		b:box(V(150, 4, 150), CF(0, -2, 0), rgb(120, 100, 80), { role = "fixed", material = M.Sand })
		b:box(V(150, 4, 150), CF(0, 44, 0), stone, { role = "fixed", material = M.Slate })
		for _, w in { { 0, -75, 150, 4 }, { 0, 75, 150, 4 }, { -75, 0, 4, 150 }, { 75, 0, 4, 150 } } do
			b:box(V(w[3], 46, w[4]), CF(w[1], 21, w[2]), stone, { role = "fixed", material = M.Cobblestone })
		end
		-- arquibancadas
		for k = 0, 3 do
			for _, side in { -1, 1 } do
				b:box(V(140, 2, 5), CF(0, 1 + k * 2.4, side * (70 - k * 5)), rgb(130, 115, 100), { role = "fixed", material = M.Concrete })
			end
		end
		-- marcações neon no chão
		b:cylY(0.2, 60, CF(0, 0.1, 0), rgb(255, 70, 70), { role = "fixed", material = M.Neon })
		b:cylY(0.25, 57, CF(0, 0.12, 0), rgb(120, 100, 80), { role = "fixed", material = M.Sand })
		-- tochas
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			local p = V(math.cos(a) * 66, 10, math.sin(a) * 66)
			local torch = b:box(V(1, 3, 1), CF(p), rgb(90, 60, 40), { role = "fixed" })
			local flame = b:ball(1.2, CF(p + V(0, 2, 0)), rgb(255, 150, 50), { role = "fixed", material = M.Neon, collide = false })
			local f = Instance.new("Fire")
			f.Size = 4
			f.Parent = flame
			b:light(flame, rgb(255, 150, 60), 40, 2)
			local _ = torch
		end
		local banner = b:box(V(40, 8, 1), CF(0, 30, 73), rgb(140, 20, 30), { role = "fixed", name = "Faixa" })
		MapKit.sign(banner, "ARENA SUBTERRÂNEA", rgb(255, 220, 120), Enum.NormalId.Front)
	end)
	local hub = MapLayout.ById.hub
	ctx:teleportPad(CF(c + V(0, 0.9, 55)), CF(hub.center + V(0, 8, 40)), "Voltar ao Centro", rgb(120, 220, 255))
end

return { Desert = Desert, Beach = Beach, Sky = Sky, Arena = Arena }
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">Volcano</string>
              <string name="Source"><![CDATA[--!strict
-- Região Vulcânica: vulcão central com cratera de lava, rios de lava que
-- queimam, pedras negras, forja industrial com chaminés e canos, pontes de
-- metal resistentes e brasas no ar.

local MapKit = require(script.Parent.Parent.MapKit)

local Volcano = { id = "volcano" }

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

function Volcano.build(ctx: any)
	local rng = ctx.rng
	local c = ctx.center
	local M = Enum.Material
	MapKit.fillCylinder(CF(c.X, -1.5, c.Z), 3.2, 185, M.Basalt)
	-- vulcão
	local vx, vz = c.X - 40, c.Z
	MapKit.mountain(vx, vz, 95, 92, M.Basalt, M.Rock)
	MapKit.fillCylinder(CF(vx, 86, vz), 20, 18, M.Air)
	MapKit.fillCylinder(CF(vx, 78, vz), 4, 18, M.CrackedLava)
	-- rios de lava descendo e cruzando a região
	local rivers = {}
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2 + 0.6
		local dir = V(math.cos(a), 0, math.sin(a))
		table.insert(rivers, { a = a, dir = dir })
		for s = 0, 6 do
			local d = 30 + s * 16
			local p = V(vx, 0, vz) + dir * d
			local y = MapKit.heightAt(p.X, p.Z)
			MapKit.fillBlock(CF(p.X, y - 1, p.Z) * ANG(0, -a, 0), V(18, 4, 9), M.CrackedLava)
		end
	end
	ctx:build("LavaViva", CF(0, 0, 0), function(b)
		for _, r in rivers do
			for s = 7, 10 do
				local p = V(vx, 0, vz) + r.dir * (30 + s * 16)
				local part = b:box(V(18, 0.6, 10), CF(p.X, MapKit.heightAt(p.X, p.Z) + 0.3, p.Z) * ANG(0, -r.a + math.pi / 2, 0), rgb(255, 95, 25), { role = "fixed", material = M.Neon, collide = false, name = "Lava" })
				MapKit.hazard(part, "lava", 10)
				if s % 2 == 0 then
					b:light(part, rgb(255, 120, 40), 26, 2)
				end
			end
		end
		local crater = b:part("cyl", V(1, 34, 34), CF(vx, 80.6, vz) * ANG(0, 0, math.rad(90)), rgb(255, 100, 30), { role = "fixed", material = M.Neon, name = "Cratera" })
		MapKit.hazard(crater, "lava", 20)
		b:light(crater, rgb(255, 130, 40), 60, 4)
		local smoke = Instance.new("Smoke")
		smoke.Color = rgb(70, 60, 60)
		smoke.Size = 30
		smoke.RiseVelocity = 18
		smoke.Opacity = 0.35
		smoke.Parent = crater
		MapKit.emitter(crater, "rbxasset://textures/particles/fire_main.dds", rgb(255, 150, 60), 30, { speed = NumberRange.new(15, 30), spread = Vector2.new(30, 30), lifetime = NumberRange.new(1.5, 3), size = NumberSequence.new(3, 0), accel = V(0, -10, 0), light = 1 })
	end)
	-- pontes de metal sobre os rios
	for _, r in rivers do
		local p = V(vx, 0, vz) + r.dir * 150
		ctx:build("PonteMetal", CF(p.X, MapKit.heightAt(p.X, p.Z), p.Z) * ANG(0, -r.a, 0), function(b)
			local steel = rgb(110, 110, 120)
			b:box(V(26, 1, 8), CF(0, 2.5, 0), steel, { role = "fixed", material = M.DiamondPlate })
			for _, z in { -3.8, 3.8 } do
				b:box(V(26, 0.5, 0.5), CF(0, 5.5, z), rgb(200, 120, 40), { role = "fixed", material = M.Metal })
				for x = -12, 12, 6 do
					b:box(V(0.5, 3, 0.5), CF(x, 4, z), steel, { role = "fixed", material = M.Metal })
					b:beam(V(x, 2.5, z), V(x + 3, 5.5, z), 0.35, steel, { role = "fixed", material = M.Metal })
				end
			end
		end)
	end
	-- forja industrial
	ctx:build("Forja", ctx:at(90, -70), function(b)
		local wall = rgb(70, 66, 70)
		b:box(V(40, 1, 30), CF(0, 0.5, 0), rgb(50, 48, 52), { role = "fixed", material = M.DiamondPlate })
		b:box(V(36, 16, 26), CF(0, 9, 0), wall, { role = "fixed", material = M.CorrodedMetal })
		b:box(V(12, 10, 0.6), CF(0, 6, -13.2), rgb(255, 120, 30), { role = "fixed", material = M.Neon, transparency = 0.2 })
		for k = 0, 2 do
			local chimney = b:cylY(18, 3.4, CF(-12 + k * 12, 26, 6), rgb(80, 70, 70), { role = "fixed", material = M.Brick })
			local smoke = Instance.new("Smoke")
			smoke.Color = rgb(60, 55, 55)
			smoke.Size = 6
			smoke.RiseVelocity = 10
			smoke.Opacity = 0.3
			smoke.Parent = chimney
		end
		for k = 0, 3 do
			b:part("cyl", V(30, 1.6, 1.6), CF(0, 4 + k * 2.5, 14.5), rgb(150, 90, 40), { role = "fixed", material = M.Metal })
		end
	end)
	-- pedras negras espalhadas e brasas
	for k = 1, 20 do
		local x, z = rng:range(-170, 170), rng:range(-170, 170)
		if (V(c.X + x, 0, c.Z + z) - V(vx, 0, vz)).Magnitude > 100 then
			ctx:prop("nature", "rock", ctx:at(x, z), rng:range(0.8, 2.2), { color = { 0.18, 0.17, 0.2 }, material = "stone" })
		end
	end
	for k = 1, 3 do
		ctx:build("Brasas", ctx:at(rng:range(-120, 120), rng:range(-120, 120), 3), function(b)
			local p = b:box(V(60, 4, 60), CF(0, 0, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false, name = "Area" })
			p.CanQuery = false
			MapKit.emitter(p, "rbxasset://textures/particles/sparkles_main.dds", rgb(255, 140, 50), 8, { speed = NumberRange.new(2, 5), accel = V(0, 3, 0), size = NumberSequence.new(0.3), lifetime = NumberRange.new(3, 5), light = 1 })
		end)
	end
end

return Volcano
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="100">
        <Properties>
          <string name="Name">Progress</string>
        </Properties>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">Profiles</string>
            <string name="Source"><![CDATA[--!strict
-- Perfis persistentes (DataStore) com tolerância a falhas: se o DataStore não
-- estiver disponível (Studio sem permissão, Luau Execution, falha de rede),
-- o jogo continua com um perfil só da sessão.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.IdeiasShared.Config)

local Profiles = {}

export type Profile = {
	v: number,
	discovered: { [string]: boolean },
	secrets: { [string]: boolean },
	achievements: { [string]: boolean },
	stats: { [string]: number },
	favorites: { string },
	sparks: number,
	owned: { [string]: boolean },
	equipped: { [string]: string },
	regions: { [string]: boolean },
}

local store: DataStore? = nil
local profiles: { [Player]: Profile } = {}
local dirty: { [Player]: boolean } = {}
Profiles.enabled = false

local function blank(): Profile
	return {
		v = 1,
		discovered = {},
		secrets = {},
		achievements = {},
		stats = {},
		favorites = {},
		sparks = 0,
		owned = {},
		equipped = {},
		regions = {},
	}
end

local function sanitize(data: any): Profile
	local p = blank()
	if type(data) ~= "table" then
		return p
	end
	for _, key in { "discovered", "secrets", "achievements", "owned", "regions" } do
		if type(data[key]) == "table" then
			for k, v in data[key] do
				if type(k) == "string" and v == true then
					(p :: any)[key][k] = true
				end
			end
		end
	end
	if type(data.stats) == "table" then
		for k, v in data.stats do
			if type(k) == "string" and type(v) == "number" then
				p.stats[k] = v
			end
		end
	end
	if type(data.favorites) == "table" then
		for _, f in data.favorites do
			if type(f) == "string" and #p.favorites < Config.Data.MaxFavorites then
				table.insert(p.favorites, string.sub(f, 1, 80))
			end
		end
	end
	if type(data.equipped) == "table" then
		for k, v in data.equipped do
			if type(k) == "string" and type(v) == "string" then
				p.equipped[k] = v
			end
		end
	end
	p.sparks = if type(data.sparks) == "number" then math.max(0, math.floor(data.sparks)) else 0
	return p
end

function Profiles.init()
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok and ds then
		store = ds
		Profiles.enabled = true
	else
		warn("[Ideias] DataStore indisponível; progresso só nesta sessão.")
	end
end

function Profiles.load(player: Player): Profile
	local profile = blank()
	if store then
		local ok, data = pcall(function()
			return (store :: DataStore):GetAsync("u" .. player.UserId)
		end)
		if ok then
			profile = sanitize(data)
		else
			warn("[Ideias] falha ao carregar perfil: " .. tostring(data))
		end
	end
	profiles[player] = profile
	return profile
end

function Profiles.get(player: Player): Profile?
	return profiles[player]
end

function Profiles.markDirty(player: Player)
	dirty[player] = true
end

function Profiles.save(player: Player)
	local profile = profiles[player]
	if not profile or not store then
		return
	end
	dirty[player] = nil
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync("u" .. player.UserId, function()
				return profile
			end)
		end)
		if ok then
			return
		end
		warn(string.format("[Ideias] falha ao salvar (%d/3): %s", attempt, tostring(err)))
		task.wait(attempt * 2)
	end
end

function Profiles.release(player: Player)
	Profiles.save(player)
	profiles[player] = nil
	dirty[player] = nil
end

function Profiles.start()
	Profiles.init()
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for player in dirty do
				if player.Parent then
					task.spawn(Profiles.save, player)
				end
			end
		end
	end)
	game:BindToClose(function()
		for player in profiles do
			Profiles.save(player)
		end
	end)
	Players.PlayerRemoving:Connect(Profiles.release)
end

return Profiles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">Progress</string>
            <string name="Source"><![CDATA[--!strict
-- Progressão: descobertas de conceitos, combinações secretas, conquistas,
-- missões da sessão, Faíscas (moeda ganha jogando), cosméticos e favoritos.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.IdeiasShared
local Catalog = require(Shared.Catalog)
local Progression = require(Shared.Catalog.Progression)
local MapLayout = require(Shared.MapLayout)
local Config = require(Shared.Config)
local Profiles = require(script.Parent.Profiles)

local Progress = {}

local quests: { [Player]: { { id: string, progress: number, done: boolean } } } = {}
local remote: RemoteEvent? = nil

local function send(player: Player, kind: string, data: any)
	if remote then
		remote:FireClient(player, kind, data)
	end
end

local function pickQuests(player: Player)
	local pool = table.clone(Progression.Quests)
	local list = {}
	for i = 1, 3 do
		local idx = math.random(1, #pool)
		table.insert(list, { id = pool[idx].id, progress = 0, done = false })
		table.remove(pool, idx)
	end
	quests[player] = list
end

function Progress.snapshot(player: Player): any
	local p = Profiles.get(player)
	if not p then
		return nil
	end
	local discovered = {}
	for id in p.discovered do
		table.insert(discovered, id)
	end
	local secrets = {}
	for id in p.secrets do
		table.insert(secrets, id)
	end
	local achievements = {}
	for id in p.achievements do
		table.insert(achievements, id)
	end
	local owned = {}
	for id in p.owned do
		table.insert(owned, id)
	end
	return {
		discovered = discovered,
		totalConcepts = #Catalog.Concepts,
		secrets = secrets,
		totalSecrets = #Catalog.Secrets,
		achievements = achievements,
		stats = p.stats,
		favorites = p.favorites,
		sparks = p.sparks,
		owned = owned,
		equipped = p.equipped,
		quests = quests[player],
		saved = Profiles.enabled,
	}
end

local function sync(player: Player)
	send(player, "perfil", Progress.snapshot(player))
end

local function addSparks(player: Player, n: number)
	local p = Profiles.get(player)
	if p then
		p.sparks += n
		Profiles.markDirty(player)
	end
end

local function bump(player: Player, stat: string, n: number?)
	local p = Profiles.get(player)
	if not p then
		return
	end
	p.stats[stat] = (p.stats[stat] or 0) + (n or 1)
	Profiles.markDirty(player)
	for _, a in Progression.Achievements do
		if a.stat == stat and not p.achievements[a.id] and p.stats[stat] >= a.goal then
			p.achievements[a.id] = true
			p.sparks += a.reward
			send(player, "conquista", { title = a.title, desc = a.desc, reward = a.reward })
		end
	end
end

local function questBump(player: Player, stat: string, n: number?)
	local list = quests[player]
	if not list then
		return
	end
	for _, q in list do
		local def = Progression.QuestById[q.id]
		if def.stat == stat and not q.done then
			q.progress += n or 1
			if q.progress >= def.goal then
				q.done = true
				addSparks(player, def.reward)
				send(player, "missao", { title = def.title, reward = def.reward })
			end
		end
	end
end

Progress.bump = bump
Progress.questBump = questBump
Progress.addSparks = addSparks

-- chamado após cada ideia executada
function Progress.onPlan(player: Player, plan: any): { discovered: { string }, secrets: { string } }
	local p = Profiles.get(player)
	local out = { discovered = {}, secrets = {} }
	if not p then
		return out
	end
	bump(player, "created")
	if plan.surprise then
		bump(player, "surprises")
	end
	if #plan.links > 0 then
		bump(player, "combos")
	end
	for _, ev in plan.events do
		local def = ev.concept
		if not p.discovered[def.id] then
			p.discovered[def.id] = true
			table.insert(out.discovered, def.label)
			bump(player, "discovered")
			questBump(player, "q_discover")
		end
		if table.find(ev.mods, "colossal") then
			bump(player, "colossal")
		end
		if def.category == "creature" then
			questBump(player, "q_creature")
		elseif def.category == "disaster" then
			questBump(player, "q_disaster")
		elseif def.category == "food" then
			questBump(player, "q_food")
		elseif def.category == "vehicle" then
			questBump(player, "q_vehicle")
		elseif def.category == "building" then
			questBump(player, "q_building")
		end
		if ev.params.element == "ice" then
			questBump(player, "q_ice")
		elseif ev.params.element == "fire" or def.id == "fire" then
			questBump(player, "q_fire")
		end
		if def.tagSet.brazil or def.tagSet.folklore then
			questBump(player, "q_brazil")
		end
	end
	for _, l in plan.links do
		if l.type == "rivals" then
			questBump(player, "q_versus")
		end
	end
	for _, sid in plan.secrets do
		if not p.secrets[sid] then
			p.secrets[sid] = true
			for _, s in Catalog.Secrets do
				if s.id == sid then
					table.insert(out.secrets, s.title)
					p.sparks += s.reward
					send(player, "segredo", { title = s.title, hint = s.hint, reward = s.reward })
				end
			end
			bump(player, "secrets")
		end
	end
	Profiles.markDirty(player)
	task.defer(sync, player)
	return out
end

function Progress.onKill(owner: Player)
	bump(owner, "kills")
	questBump(owner, "q_kills")
end

function Progress.reward(player: Player, kind: string, amount: number)
	if kind == "eat" then
		bump(player, "eat")
	else
		addSparks(player, amount)
	end
	task.defer(sync, player)
end

-- ações vindas do cliente (sempre validadas)
function Progress.action(player: Player, action: any, arg: any)
	local p = Profiles.get(player)
	if not p or type(action) ~= "string" then
		return
	end
	if action == "favoritar" and type(arg) == "string" then
		local label = string.sub(arg, 1, 80)
		local i = table.find(p.favorites, label)
		if i then
			table.remove(p.favorites, i)
		elseif #p.favorites < Config.Data.MaxFavorites then
			-- só aceita rótulos que o próprio interpretador reconhece (sem texto livre)
			local Planner = require(Shared.Planner)
			local plan = Planner.plan(label)
			if not plan.surprise then
				table.insert(p.favorites, plan.label)
			end
		end
		Profiles.markDirty(player)
	elseif action == "comprar" and type(arg) == "string" then
		local c = Progression.CosmeticById[arg]
		if c and not p.owned[c.id] and p.sparks >= c.price then
			p.sparks -= c.price
			p.owned[c.id] = true
			p.equipped[c.kind] = c.id
			Profiles.markDirty(player)
			Progress.applyCosmetics(player)
		end
	elseif action == "equipar" and type(arg) == "string" then
		local c = Progression.CosmeticById[arg]
		if c and p.owned[c.id] then
			p.equipped[c.kind] = if p.equipped[c.kind] == c.id then nil else c.id
			Profiles.markDirty(player)
			Progress.applyCosmetics(player)
		end
	end
	sync(player)
end

function Progress.applyCosmetics(player: Player)
	local p = Profiles.get(player)
	local char = player.Character
	if not p or not char then
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = char:FindFirstChild("Head") :: BasePart?
	if not root or not head then
		return
	end
	for _, name in { "RastroIdeias", "AuraIdeias", "TituloIdeias", "RastroA0", "RastroA1" } do
		local old = char:FindFirstChild(name, true)
		while old do
			old:Destroy()
			old = char:FindFirstChild(name, true)
		end
	end
	local trail = p.equipped.trail and Progression.CosmeticById[p.equipped.trail]
	if trail then
		local a0 = Instance.new("Attachment")
		a0.Name = "RastroA0"
		a0.Position = Vector3.new(0, 1, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "RastroA1"
		a1.Position = Vector3.new(0, -1, 0)
		a1.Parent = root
		local t = Instance.new("Trail")
		t.Name = "RastroIdeias"
		t.Attachment0 = a0
		t.Attachment1 = a1
		t.Lifetime = 0.6
		t.LightEmission = 0.6
		local keys = {}
		for i, c in trail.colors do
			table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(#trail.colors - 1, 1), Color3.fromRGB(c[1], c[2], c[3])))
		end
		t.Color = ColorSequence.new(keys)
		t.Transparency = NumberSequence.new(0.2, 1)
		t.Parent = root
	end
	local aura = p.equipped.aura and Progression.CosmeticById[p.equipped.aura]
	if aura then
		local e = Instance.new("ParticleEmitter")
		e.Name = "AuraIdeias"
		e.Texture = Config.Textures.Sparkle
		e.Rate = 8
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(1, 2)
		e.SpreadAngle = Vector2.new(180, 180)
		local c = aura.colors[1]
		e.Color = ColorSequence.new(Color3.fromRGB(c[1], c[2], c[3]))
		e.LightEmission = 0.7
		e.Parent = root
	end
	local title = p.equipped.title and Progression.CosmeticById[p.equipped.title]
	if title then
		local gui = Instance.new("BillboardGui")
		gui.Name = "TituloIdeias"
		gui.Size = UDim2.fromOffset(160, 24)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 60
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "★ " .. title.title
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.TextColor3 = Color3.fromRGB(255, 225, 120)
		label.TextStrokeTransparency = 0.4
		label.Parent = gui
		gui.Parent = head
	end
end

-- visitas às regiões (verificação barata a cada 3 s)
local function regionWatcher()
	while true do
		task.wait(3)
		for _, player in Players:GetPlayers() do
			local p = Profiles.get(player)
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if p and root then
				local region = MapLayout.regionAt(root.Position)
				local d = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(region.center.X, 0, region.center.Z)).Magnitude
				if d < region.radius and not p.regions[region.id] then
					p.regions[region.id] = true
					bump(player, "regions")
					send(player, "regiao", { label = region.label })
				end
				if d < region.radius then
					if region.id == "volcano" then
						questBump(player, "q_visit_volcano")
					elseif region.id == "glacier" then
						questBump(player, "q_visit_glacier")
					end
				end
			end
		end
	end
end

function Progress.start(estado: RemoteEvent?)
	remote = estado
	Profiles.start()
	local function setup(player: Player)
		task.spawn(function()
			Profiles.load(player)
			pickQuests(player)
			sync(player)
			if player.Character then
				Progress.applyCosmetics(player)
			end
		end)
		player.CharacterAdded:Connect(function()
			task.wait(1)
			Progress.applyCosmetics(player)
		end)
	end
	Players.PlayerAdded:Connect(setup)
	for _, player in Players:GetPlayers() do
		setup(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		quests[player] = nil
	end)
	task.spawn(regionWatcher)
end

return Progress
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="103">
        <Properties>
          <string name="Name">Tests</string>
        </Properties>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">ServerSpec</string>
            <string name="Source"><![CDATA[--!strict
-- Testes do servidor: executa de verdade cada conceito do catálogo, as
-- combinações e cenários de estresse, conferindo orçamento e limpeza.
-- Roda no Lune (offline, com eventos emulados) e na nuvem via Luau Execution
-- API (motor real do Roblox, sem jogadores conectados).

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.IdeiasShared

local Spec = {}

export type Result = { passed: number, failed: number, failures: { string }, stats: { [string]: any } }

-- jogador simulado (a Luau Execution roda sem jogadores conectados)
local function fakePlayer(id: number): any
	local backpack = Instance.new("Folder")
	backpack.Name = "Backpack"
	local p: any = { UserId = id, DisplayName = "Teste" .. id, Name = "Teste" .. id, Character = nil, Parent = game, backpack = backpack }
	function p.FindFirstChildOfClass(_self: any, className: string): Instance?
		return if className == "Backpack" then backpack else nil
	end
	function p.FindFirstChild(_self: any, name: string): Instance?
		return if name == "Backpack" then backpack else nil
	end
	return p
end

function Spec.run(opts: { map: boolean?, quick: boolean? }?): Result
	local o = opts or {}
	local Catalog = require(Shared.Catalog)
	local Planner = require(Shared.Planner)
	local Config = require(Shared.Config)
	local Server = script.Parent.Parent
	local Bootstrap = require(Server.Core.Bootstrap)
	local EventManager = require(Server.Core.EventManager)
	local Budget = require(Server.Core.Budget)
	local RequestGate = require(Server.Core.RequestGate)
	local Requests = require(Server.Core.Requests)

	local result: Result = { passed = 0, failed = 0, failures = {}, stats = {} }
	local function check(name: string, ok: boolean, detail: string?)
		if ok then
			result.passed += 1
		else
			result.failed += 1
			table.insert(result.failures, name .. (if detail then " => " .. detail else ""))
		end
	end

	-- 1) inicialização completa (mapa incluso) --------------------------------------
	local t0 = os.clock()
	local okStart, errStart = pcall(Bootstrap.start, { map = o.map ~= false, remotes = false, progress = false })
	check("Bootstrap.start", okStart, if okStart then nil else tostring(errStart))
	result.stats.bootSeconds = os.clock() - t0
	result.stats.map = Bootstrap.mapStats
	local events = Workspace:FindFirstChild("IdeiasEventos")
	check("pasta IdeiasEventos", events ~= nil)
	if not events then
		return result
	end

	local function countChildren(): number
		return #events:GetChildren()
	end

	-- 2) cada conceito do catálogo é executado e limpo ----------------------------
	local perHandler: { [string]: number } = {}
	local tConcepts = os.clock()
	local owner = fakePlayer(101)
	for _, def in Catalog.Concepts do
		local plan = Planner.plan(def.label)
		local ok, res = pcall(EventManager.executePlan, plan, owner)
		local detail: string? = nil
		local good = ok and res.ok
		if not ok then
			detail = tostring(res)
		elseif not res.ok then
			detail = "não criado: " .. table.concat(res.notes, "; ")
		end
		-- utilitários terminam na hora, são aceitos sem registro
		if ok and not res.ok and (def.id == "clear" or def.id == "restore") then
			good = true
		end
		check("executar " .. def.id, good, detail)
		perHandler[def.handler] = (perHandler[def.handler] or 0) + 1
		EventManager.clearAll()
	end
	result.stats.conceptSeconds = os.clock() - tConcepts
	result.stats.perHandler = perHandler

	-- deixa tarefas atrasadas (task.delay) rodarem e limpa de novo
	task.wait(0.2)
	EventManager.clearAll()
	local used = Budget.used()
	check("orçamento zerado após limpeza", used.events == 0 and used.npcs == 0 and used.parts == 0 and used.effects == 0, string.format("events=%d npcs=%d parts=%d effects=%d dynamic=%d", used.events, used.npcs, used.parts, used.effects, used.dynamic))
	check("nenhuma pasta esquecida em IdeiasEventos", countChildren() == 0, tostring(countChildren()) .. " pastas")

	-- 3) combinações com vínculos -------------------------------------------------
	local combos = {
		"herói contra demônio",
		"dragão protegendo castelo",
		"zumbi no carro",
		"cavaleiro montando dragão",
		"lobo e ovelha",
		"robô e dinossauro",
		"tornado de tubarões",
		"chuva de pizzas",
		"chuva de gatos",
		"dragão de gelo gigante",
		"meteoro congelante",
		"invasão alienígena",
		"guerra medieval",
		"fogo e gelo",
		"xyzqwe palavra estranha",
		"arma que atira cachorro e o cachorro caga elefante que o elefante explode",
		"cachorro explode",
		"vaca que vira dragão",
		"dragão que cospe gelo",
		"zumbis que se multiplicam",
		"gato tubarão",
		"crocodilo avião",
		"macaco pizza",
		"goku contra freeza",
		"jesus contra demônio",
		"deus",
		"verity",
		"tung tung tung sahur e tralalero tralala",
		"bombardiro crocodilo",
		"saitama contra kaiju",
		"naruto",
	}
	for _, text in combos do
		local plan = Planner.plan(text)
		local ok, res = pcall(EventManager.executePlan, plan, owner)
		check("combinação '" .. text .. "'", ok and res.ok, if ok then table.concat(res.notes, "; ") else tostring(res))
		EventManager.clearAll()
	end

	-- 3b) cadeias, híbridos, nomes e personagens sagrados -------------------------
	do
		local Chains = require(script.Parent.Parent.Core.Chains)
		local Combat = require(script.Parent.Parent.Core.Combat)
		local Rng = require(ReplicatedStorage.IdeiasShared.Util.Rng)
		local Requests = require(script.Parent.Parent.Core.Requests)

		-- lançador: o elo "cachorro" nasce dentro do acontecimento da arma
		local plan = Planner.plan("arma que atira cachorro e o cachorro caga elefante que o elefante explode")
		local ok, res = pcall(EventManager.executePlan, plan, owner)
		local rec = ok and res.records[1]
		check("arma lançadora criada", rec ~= nil and rec.def.id == "blaster", if ok then table.concat(res.notes, "; ") else tostring(res))
		if rec then
			local node = plan.events[1].actions[1].node
			local ctx = { id = rec.id, record = rec, folder = rec.folder, manager = EventManager, rng = Rng.new(7), owner = owner, lifetime = 60, plan = plan, spec = rec.spec }
			local before = Budget.used().npcs
			local h = Chains.spawnNode(ctx, node, CFrame.new(0, 3, 20))
			check("elo da cadeia nasce (cachorro)", h ~= nil and h.npcs ~= nil and #h.npcs == 1)
			check("elo usa o orçamento de NPCs", Budget.used().npcs == before + 1, tostring(Budget.used().npcs) .. " vs " .. tostring(before + 1))
			check("elo fica na pasta da arma", rec.folder:FindFirstChild("Elo_dog") ~= nil)
			check("elo herda as ações (caga elefante)", h ~= nil and h.npcs[1].ctx ~= nil and node.actions ~= nil and #node.actions >= 1)
			local spawned = 0
			for _ = 1, 40 do
				if Chains.spawnNode(ctx, node, CFrame.new(0, 3, 20)) then
					spawned += 1
				end
			end
			check("limite de elos por cadeia", (rec.chain.total :: number) <= Chains.MAX_TOTAL and rec.chain.alive <= Chains.MAX_ALIVE, tostring(rec.chain.total))
			EventManager.remove(rec, "teste")
			check("remover a raiz remove os elos", Budget.used().npcs == 0 and countChildren() == 0, "npcs=" .. Budget.used().npcs)
		end
		EventManager.clearAll()

		-- híbridos
		local p2 = Planner.plan("gato tubarão")
		local ok2, res2 = pcall(EventManager.executePlan, p2, owner)
		local npc2 = ok2 and res2.records[1] and res2.records[1].handle.npcs and res2.records[1].handle.npcs[1]
		check("híbrido gato-tubarão montado", npc2 ~= nil and npc2.model:GetAttribute("Hibrido") == "shark")
		EventManager.clearAll()
		local p3 = Planner.plan("crocodilo avião")
		local ok3, res3 = pcall(EventManager.executePlan, p3, owner)
		local hasHybrid = false
		if ok3 and res3.records[1] then
			for _, d in res3.records[1].folder:GetDescendants() do
				if d:IsA("Model") and d:GetAttribute("Hibrido") == "crocodile" then
					hasHybrid = true
				end
			end
		end
		check("avião com cabeça de crocodilo", hasHybrid)
		EventManager.clearAll()

		-- nome digitado passa pelo filtro (offline: vira "Personagem Misterioso")
		local p4 = Planner.plan("verity")
		Requests.filterNames(p4, owner)
		check("nome filtrado antes de aparecer", p4.events[1].params.customName == "Personagem Misterioso" or p4.events[1].params.customName == "Verity", tostring(p4.events[1].params.customName))
		check("rótulo usa o nome filtrado", p4.label == p4.events[1].params.customName, p4.label)

		-- Jesus: aparece, cura, não pode ser atacado
		local p5 = Planner.plan("jesus")
		local ok5, res5 = pcall(EventManager.executePlan, p5, owner)
		local jesus = ok5 and res5.records[1] and res5.records[1].handle.npcs and res5.records[1].handle.npcs[1]
		check("Jesus aparece como personagem", jesus ~= nil and jesus.model.Name == "Jesus")
		if jesus then
			local hp = jesus.humanoid.Health
			local hurt = Combat.damage(jesus, 500, nil, "fire")
			check("Jesus não toma dano", hurt == false and jesus.humanoid.Health == hp)
		end
		EventManager.clearAll()
	end

	-- 4) estresse: orçamento nunca é ultrapassado ---------------------------------
	local maxEvents, maxNpcs = 0, 0
	local players = { fakePlayer(201), fakePlayer(202), fakePlayer(203), fakePlayer(204), fakePlayer(205) }
	local storm = { "100 zumbis", "dragão gigante", "chuva de meteoros", "exército de robôs", "tornado", "horda de esqueletos", "castelo", "kraken" }
	for round = 1, (if o.quick then 2 else 4) do
		for i, p in players do
			local text = storm[((round + i) % #storm) + 1]
			pcall(EventManager.executePlan, Planner.plan(text), p)
			local u = Budget.used()
			maxEvents = math.max(maxEvents, u.events)
			maxNpcs = math.max(maxNpcs, u.npcs)
		end
	end
	check("limite de acontecimentos respeitado", maxEvents <= Config.Budget.events, maxEvents .. " > " .. Config.Budget.events)
	check("limite de NPCs respeitado", maxNpcs <= Config.Budget.npcs, maxNpcs .. " > " .. Config.Budget.npcs)
	local perPlayerOk = true
	local counts: { [any]: number } = {}
	for _, rec in EventManager.active() do
		counts[rec.owner] = (counts[rec.owner] or 0) + 1
		if counts[rec.owner] > Config.Budget.perPlayer then
			perPlayerOk = false
		end
	end
	check("limite por jogador respeitado", perPlayerOk)
	result.stats.stressMaxEvents = maxEvents
	result.stats.stressMaxNpcs = maxNpcs
	EventManager.clearAll()
	task.wait(0.1)
	check("limpeza após estresse", countChildren() == 0 and Budget.used().events == 0, countChildren() .. " pastas")

	-- 5) porteiro de pedidos ------------------------------------------------------
	RequestGate.reset()
	local key = {}
	local v1 = RequestGate.check(key, "dragão", 100)
	check("pedido válido aceito", v1.ok)
	local v2 = RequestGate.check(key, "dragão", 101)
	check("recarga bloqueia", not v2.ok and v2.reason == "cooldown")
	local v3 = RequestGate.check(key, "dragão", 104)
	check("após recarga aceita", v3.ok)
	check("tipo inválido recusado", not RequestGate.check({}, 42 :: any, 200).ok)
	check("texto vazio recusado", RequestGate.check({}, "   ", 300).reason == "empty")
	check("texto gigante recusado", RequestGate.check({}, string.rep("a", 5000), 400).reason == "too_long")
	check("UTF-8 inválido recusado", not RequestGate.check({}, "abc\255\254", 500).ok)
	local spamKey = {}
	local blocked = false
	for i = 1, 12 do
		local v = RequestGate.check(spamKey, "x" .. i, 600 + i * 0.1)
		if v.reason == "spam" then
			blocked = true
		end
	end
	check("spam bloqueado", blocked)
	local cut = RequestGate.check({}, string.rep("dragão ", 40), 700)
	check("texto longo é cortado", cut.ok and utf8.len(cut.text or "") <= Config.Request.MaxTextLength)
	RequestGate.reset()

	-- 6) fluxo completo de um pedido (como o RemoteFunction chama) ---------------
	local requester = fakePlayer(301)
	local reply = Requests.handle(requester :: any, "dragão de fogo")
	check("Requests.handle responde ok", type(reply) == "table" and reply.ok == true, if type(reply) == "table" then tostring(reply.message) else "sem resposta")
	check("resposta traz rótulo", type(reply) == "table" and reply.label == "Dragão de Fogo", type(reply) == "table" and tostring(reply.label) or "")
	local again = Requests.handle(requester :: any, "dragão de fogo")
	check("segundo pedido imediato recebe recarga", type(again) == "table" and again.ok == false and again.reason == "cooldown")
	EventManager.clearAll()
	RequestGate.reset()

	result.stats.eventManager = table.clone(EventManager.stats)
	return result
end

return Spec
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="105">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="106">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">180</float>
      <float name="CharacterJumpHeight">8.5</float>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="107">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="108">
        <Properties>
          <string name="Name">IdeiasClient</string>
        </Properties>
        <Item class="Folder" referent="109">
          <Properties>
            <string name="Name">FX</string>
          </Properties>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">Ambient</string>
              <string name="Source"><![CDATA[--!strict
-- Ambiente local: clima (chuva, neve, chuva ácida, areia, aurora, festa,
-- estrelas), animação procedural dos NPCs (Motor6D.Transform), peças que
-- giram/flutuam e telas que mudam de cor. Tudo roda só no cliente.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Settings = require(script.Parent.Parent.Settings)

local Ambient = {}

-- CLIMA ------------------------------------------------------------------------------
local weatherPart: BasePart? = nil
local weatherEmitter: ParticleEmitter? = nil
local partyLights: { PointLight } = {}
local auroraModel: Model? = nil

local CLIMAS = {
	chuva = { color = Color3.fromRGB(180, 200, 230), rate = 260, speed = 90, size = 0.12, tex = "rbxasset://textures/particles/sparkles_main.dds", stretch = true },
	tempestade = { color = Color3.fromRGB(170, 190, 220), rate = 360, speed = 110, size = 0.14, tex = "rbxasset://textures/particles/sparkles_main.dds", stretch = true },
	nevasca = { color = Color3.fromRGB(255, 255, 255), rate = 220, speed = 18, size = 0.35, tex = "rbxasset://textures/particles/sparkles_main.dds" },
	chuva_acida = { color = Color3.fromRGB(150, 255, 100), rate = 220, speed = 80, size = 0.14, tex = "rbxasset://textures/particles/sparkles_main.dds", stretch = true },
	areia = { color = Color3.fromRGB(230, 200, 140), rate = 160, speed = 30, size = 1.4, tex = "rbxasset://textures/particles/smoke_main.dds", side = true },
}

local function ensureWeatherPart(): BasePart
	if not weatherPart then
		local p = Instance.new("Part")
		p.Name = "ClimaLocal"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(160, 1, 160)
		p.Parent = Workspace.CurrentCamera
		local e = Instance.new("ParticleEmitter")
		e.EmissionDirection = Enum.NormalId.Bottom
		e.SpreadAngle = Vector2.new(4, 4)
		e.Lifetime = NumberRange.new(1.4, 2)
		e.Parent = p
		weatherPart = p
		weatherEmitter = e
	end
	return weatherPart :: BasePart
end

local function setWeather(clima: string)
	local cfg = CLIMAS[clima]
	ensureWeatherPart()
	local e = weatherEmitter :: ParticleEmitter
	if cfg then
		e.Enabled = true
		e.Texture = cfg.tex
		e.Color = ColorSequence.new(cfg.color)
		e.Rate = cfg.rate * Settings.quality().weather
		e.Speed = NumberRange.new(cfg.speed * 0.8, cfg.speed)
		e.Size = NumberSequence.new(cfg.size)
		e.Transparency = NumberSequence.new(0.3)
		e.LightEmission = 0.2
		e.Acceleration = if cfg.side then Vector3.new(40, 0, 10) else Vector3.zero
		e.Lifetime = if cfg.speed < 40 then NumberRange.new(4, 6) else NumberRange.new(1.2, 1.8)
	else
		e.Enabled = false
	end
	-- festa: luzes coloridas pulsando em volta do jogador
	for _, l in partyLights do
		l:Destroy()
	end
	table.clear(partyLights)
	if clima == "festa" then
		for i = 1, 3 do
			local l = Instance.new("PointLight")
			l.Range = 40
			l.Brightness = 3
			l.Parent = ensureWeatherPart()
			table.insert(partyLights, l)
		end
	end
	if auroraModel then
		auroraModel:Destroy()
		auroraModel = nil
	end
	if clima == "aurora" then
		local m = Instance.new("Model")
		m.Name = "Aurora"
		for i = 1, 14 do
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Size = Vector3.new(60, 50, 1)
			p.Transparency = 0.6
			p.Color = Color3.fromHSV(0.35 + i * 0.02, 0.8, 1)
			p.Parent = m
		end
		m.Parent = Workspace.CurrentCamera
		auroraModel = m
	end
end

-- ANIMAÇÃO PROCEDURAL -------------------------------------------------------------------
type Motor = { m: Motor6D, kind: string, axis: string, amp: number, phase: number, speed: number, acc: number, cur: number }
type Rig = { model: Model, root: BasePart?, motors: { Motor } }

local rigs: { [Model]: Rig } = {}

local function collect(model: Model)
	if rigs[model] then
		return
	end
	local rig: Rig = { model = model, root = model.PrimaryPart, motors = {} }
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d:GetAttribute("Anim") then
			table.insert(rig.motors, {
				m = d,
				kind = d:GetAttribute("Anim") :: string,
				axis = (d:GetAttribute("AnimAxis") :: string?) or "X",
				amp = (d:GetAttribute("AnimAmp") :: number?) or 0.5,
				phase = (d:GetAttribute("AnimPhase") :: number?) or 0,
				speed = (d:GetAttribute("AnimSpeed") :: number?) or 1,
				acc = 0,
				cur = 0,
			})
		end
	end
	if #rig.motors > 0 then
		rigs[model] = rig
	end
end

local function rot(axis: string, a: number): CFrame
	if axis == "Y" then
		return CFrame.Angles(0, a, 0)
	elseif axis == "Z" then
		return CFrame.Angles(0, 0, a)
	end
	return CFrame.Angles(a, 0, 0)
end

local function animate(dt: number)
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	local serverT = Workspace:GetServerTimeNow()
	for model, rig in rigs do
		if not model.Parent then
			rigs[model] = nil
			continue
		end
		local root = rig.root
		if not root then
			continue
		end
		local dist = (root.Position - camPos).Magnitude
		if dist > 220 then
			continue
		end
		local vel = root.AssemblyLinearVelocity
		local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		-- movimento suavizado: sem "tremedeira" parado e sem trancos ao começar a andar
		local rawMove = math.clamp(speed / 10, 0, 1)
		local prevMove = (rig :: any).move or 0
		local move = prevMove + (rawMove - prevMove) * math.min(1, dt * 6)
		;(rig :: any).move = move
		local dancing = model:GetAttribute("Dancando") == true
		local hitAt = model:GetAttribute("GolpeEm") :: number?
		local hitK = if hitAt then (serverT - hitAt) / 0.45 else 2
		local hitting = hitK >= 0 and hitK < 1
		local smooth = math.min(1, dt * 12)
		for _, mo in rig.motors do
			local k = mo.kind
			local a = 0
			if k == "leg" or k == "arm" then
				local f = 1.7 * mo.speed * (0.6 + move)
				a = math.sin(t * f * math.pi * 2 + mo.phase) * mo.amp * move
				if k == "arm" and move < 0.3 then
					-- respiração: braços balançam de leve parados
					a += math.sin(t * 1.6 + mo.phase) * 0.05
				end
				if dancing then
					a = math.sin(t * 8 + mo.phase) * mo.amp * 1.2
				elseif hitting and k == "arm" then
					-- golpe com preparação (recua) e soco (avança)
					a = if hitK < 0.3 then mo.amp * 0.8 * (hitK / 0.3) else -mo.amp * 1.8 * math.sin((hitK - 0.3) / 0.7 * math.pi)
				end
				mo.cur += (a - mo.cur) * smooth
				mo.m.Transform = rot(mo.axis, mo.cur)
			elseif k == "wing" then
				a = math.sin(t * 2 * math.pi * 1.1 * mo.speed + mo.phase) * mo.amp
				mo.m.Transform = rot(mo.axis, a)
			elseif k == "tail" or k == "segment" or k == "tentacle" or k == "fin" or k == "cape" then
				local f = 0.8 * mo.speed * (1 + move)
				a = math.sin(t * f * math.pi * 2 + mo.phase) * mo.amp
				mo.m.Transform = rot(mo.axis, a)
			elseif k == "head" then
				a = math.sin(t * 0.7 * mo.speed + mo.phase) * mo.amp
				if hitting then
					a = 0
				end
				mo.m.Transform = rot(mo.axis, a)
			elseif k == "jaw" then
				a = if hitting then mo.amp else math.abs(math.sin(t * 0.6)) * mo.amp * 0.2
				mo.m.Transform = rot(mo.axis, a)
			elseif k == "bob" then
				local y = math.sin(t * 2 * math.pi * 0.5 * mo.speed + mo.phase) * mo.amp * 0.5
				mo.m.Transform = CFrame.new(0, y + (if dancing then math.abs(math.sin(t * 6)) else 0), 0)
			elseif k == "spin" then
				mo.acc += dt * mo.speed * math.pi * 2 * 0.5
				mo.m.Transform = rot(mo.axis, mo.acc)
			elseif k == "wheel" then
				mo.acc += dt * speed * 0.6
				mo.m.Transform = rot(mo.axis, -mo.acc)
			end
		end
	end
end

-- PEÇAS QUE GIRAM / FLUTUAM / TELAS --------------------------------------------------------
type Spinner = { part: BasePart, base: CFrame, axis: string, vel: number, pivot: Vector3, children: { { any } } }
local spinners: { [BasePart]: Spinner } = {}
local floaters: { [Instance]: { base: CFrame } } = {}
local screens: { [Instance]: boolean } = {}

local function addSpinner(part: Instance)
	if not part:IsA("BasePart") or spinners[part] then
		return
	end
	local children = {}
	for _, d in part:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(children, { d, part.CFrame:ToObjectSpace(d.CFrame) })
		end
	end
	spinners[part] = {
		part = part,
		base = part.CFrame,
		axis = (part:GetAttribute("GirarEixo") :: string?) or "Y",
		vel = (part:GetAttribute("GirarVel") :: number?) or 1,
		pivot = (part:GetAttribute("GirarPivo") :: Vector3?) or Vector3.zero,
		children = children,
	}
end

local function spin(dt: number)
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local t = os.clock()
	for part, s in spinners do
		if not part.Parent then
			spinners[part] = nil
		elseif (s.base.Position - camPos).Magnitude < 450 then
			local r = rot(s.axis, t * s.vel)
			local cf = s.base * CFrame.new(s.pivot) * r * CFrame.new(-s.pivot)
			part.CFrame = cf
			for _, ch in s.children do
				ch[1].CFrame = cf * ch[2]
			end
		end
	end
	for inst, f in floaters do
		if not inst.Parent then
			floaters[inst] = nil
		elseif inst:IsA("Model") then
			inst:PivotTo(f.base + Vector3.new(0, math.sin(t * 1.3) * 0.8, 0))
		end
	end
	-- telas mudam de cor devagar
	local hue = (t * 0.05) % 1
	for scr in screens do
		if not scr.Parent then
			screens[scr] = nil
		else
			local gui = scr:FindFirstChildOfClass("SurfaceGui")
			local frame = gui and gui:FindFirstChildOfClass("Frame")
			if frame then
				frame.BackgroundColor3 = Color3.fromHSV(hue, 0.6, 0.9)
			end
		end
	end
	-- luzes de festa
	for i, l in partyLights do
		l.Color = Color3.fromHSV((t * 0.5 + i / 3) % 1, 1, 1)
	end
	if auroraModel then
		local base = camPos + Vector3.new(0, 140, -200)
		for i, p in auroraModel:GetChildren() do
			local bp = p :: BasePart
			bp.CFrame = CFrame.new(base + Vector3.new((i - 7) * 45, math.sin(t * 0.4 + i * 0.6) * 15, math.cos(t * 0.3 + i) * 20)) * CFrame.Angles(0, math.sin(t * 0.2 + i) * 0.5, 0)
		end
	end
	if weatherPart then
		weatherPart.CFrame = CFrame.new(camPos + Vector3.new(0, 45, 0))
	end
	local _ = dt
end

function Ambient.init()
	local events = Workspace:WaitForChild("IdeiasEventos", 30)
	local function onNpc(inst: Instance)
		if inst:IsA("Model") then
			task.defer(collect, inst)
		end
	end
	for _, m in CollectionService:GetTagged("IdeiasNpc") do
		onNpc(m)
	end
	CollectionService:GetInstanceAddedSignal("IdeiasNpc"):Connect(onNpc)
	-- veículos (rodas/hélices) também têm juntas animadas
	for _, m in CollectionService:GetTagged("IdeiasVeiculo") do
		onNpc(m)
	end
	CollectionService:GetInstanceAddedSignal("IdeiasVeiculo"):Connect(onNpc)
	for _, p in CollectionService:GetTagged("IdeiasGirar") do
		addSpinner(p)
	end
	CollectionService:GetInstanceAddedSignal("IdeiasGirar"):Connect(function(p)
		task.defer(addSpinner, p)
	end)
	local function onFloat(m: Instance)
		if m:IsA("Model") then
			floaters[m] = { base = m:GetPivot() }
		end
	end
	for _, m in CollectionService:GetTagged("IdeiasFlutuar") do
		onFloat(m)
	end
	CollectionService:GetInstanceAddedSignal("IdeiasFlutuar"):Connect(onFloat)
	for _, s in CollectionService:GetTagged("IdeiasTela") do
		screens[s] = true
	end
	CollectionService:GetInstanceAddedSignal("IdeiasTela"):Connect(function(s)
		screens[s] = true
	end)
	-- clima
	setWeather(Workspace:GetAttribute("Clima") or "")
	Workspace:GetAttributeChangedSignal("Clima"):Connect(function()
		setWeather(Workspace:GetAttribute("Clima") or "")
	end)
	RunService.Stepped:Connect(function(_t, dt)
		animate(dt)
	end)
	RunService.RenderStepped:Connect(spin)
	local _ = events
	local _l = Lighting
end

return Ambient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">Disasters</string>
              <string name="Source"><![CDATA[--!strict
-- Visual local dos desastres em movimento (meteoros, tornados, tsunami,
-- buraco negro, tempestade). Lê os atributos Fx* da pasta do acontecimento e
-- usa as MESMAS trajetórias do servidor (FxPaths): movimento suave a 60 fps
-- sem nenhum tráfego de rede por quadro.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local FxPaths = require(ReplicatedStorage:WaitForChild("IdeiasShared").FxPaths)
local Settings = require(script.Parent.Parent.Settings)

local Disasters = {}

type Active = { folder: Instance, kind: string, spec: FxPaths.Spec, model: Model, update: (number) -> (), stop: () -> () }

local active: { [Instance]: Active } = {}
local root: Folder

local ELEMENT_COLORS = {
	fire = Color3.fromRGB(255, 120, 40),
	ice = Color3.fromRGB(160, 225, 255),
	electric = Color3.fromRGB(255, 240, 100),
	poison = Color3.fromRGB(120, 230, 70),
	water = Color3.fromRGB(70, 160, 255),
	shadow = Color3.fromRGB(110, 60, 170),
	light = Color3.fromRGB(255, 245, 190),
	lava = Color3.fromRGB(255, 90, 20),
	wind = Color3.fromRGB(225, 235, 245),
	rainbow = Color3.fromRGB(255, 120, 220),
	stone = Color3.fromRGB(120, 110, 100),
}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function newPart(model: Model, props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = model
	return p
end

local function emitter(parent: Instance, texture: string, color: Color3, rate: number, opts: { [string]: any }?): ParticleEmitter
	local o = opts or {}
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Color = ColorSequence.new(color)
	e.Rate = rate * Settings.quality().particles
	e.Lifetime = o.lifetime or NumberRange.new(0.6, 1.2)
	e.Speed = o.speed or NumberRange.new(2, 5)
	e.SpreadAngle = o.spread or Vector2.new(180, 180)
	e.Size = o.size or NumberSequence.new(1)
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.LightEmission = o.light or 0.5
	if o.accel then
		e.Acceleration = o.accel
	end
	e.Parent = parent
	return e
end

-- clones locais do "molde" (recheio: tubarões no tornado, pizzas na onda...)
local function payloadClones(folder: Instance, model: Model, n: number): { Model }
	local mold = folder:FindFirstChild("Molde")
	local out = {}
	if mold and mold:IsA("Model") then
		for _ = 1, n do
			local c = mold:Clone()
			for _, d in c:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanQuery = false
				elseif d:IsA("Script") or d:IsA("Humanoid") then
					d:Destroy()
				end
			end
			c.Parent = model
			table.insert(out, c)
		end
	end
	return out
end

local BUILD: { [string]: (Instance, FxPaths.Spec, Model, Color3) -> ((number) -> ()) } = {}

BUILD.meteor = function(folder, spec, model, color)
	local parentFolder = folder.Parent
	local clones = if parentFolder then payloadClones(parentFolder, model, 1) else {}
	local rock: BasePart
	local mold: Model? = clones[1]
	if mold then
		rock = newPart(model, { Size = Vector3.new(1, 1, 1), Transparency = 1 })
	else
		rock = newPart(model, { Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1) * spec.radius * 0.8, Color = Color3.fromRGB(70, 55, 50), Material = Enum.Material.Basalt })
		local glow = newPart(model, { Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1) * spec.radius * 0.95, Color = color, Material = Enum.Material.Neon, Transparency = 0.55 })
		glow.Name = "Brilho"
	end
	local fireE = emitter(rock, "rbxasset://textures/particles/fire_main.dds", color, 60, { speed = NumberRange.new(1, 3), size = NumberSequence.new(spec.radius * 0.6, spec.radius * 0.1), lifetime = NumberRange.new(0.4, 0.8), light = 1 })
	local _ = fireE
	local smoke = emitter(rock, "rbxasset://textures/particles/smoke_main.dds", Color3.fromRGB(80, 70, 65), 20, { speed = NumberRange.new(0, 1), size = NumberSequence.new(spec.radius * 0.4, spec.radius), lifetime = NumberRange.new(1, 2) })
	local _s = smoke
	return function(t)
		local pos, a = FxPaths.meteor(spec, t)
		local visible = t >= spec.t0 and a < 1
		local cf = CFrame.lookAt(pos, pos + spec.vel)
		rock.CFrame = cf
		for _, d in model:GetChildren() do
			if d:IsA("BasePart") and d.Name == "Brilho" then
				d.CFrame = cf
				d.Transparency = if visible then 0.55 else 1
			end
		end
		rock.Transparency = if visible and not mold then 0 else 1
		for _, e in rock:GetChildren() do
			if e:IsA("ParticleEmitter") then
				e.Enabled = visible
			end
		end
		if mold then
			mold:PivotTo(cf * CFrame.Angles(t * 3, t * 2, 0))
		end
	end
end

BUILD.tornado = function(folder, spec, model, color)
	local rings = {}
	local levels = 9
	for i = 1, levels do
		local f = i / levels
		local r = spec.radius * (0.25 + f * 0.9)
		local p = newPart(model, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(spec.height / levels * 0.9, r * 2, r * 2),
			Color = color:Lerp(Color3.fromRGB(150, 150, 160), 0.4),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.55 + f * 0.15,
		})
		table.insert(rings, { part = p, y = spec.height * (f - 0.5 / levels), r = r })
	end
	local core = newPart(model, { Size = Vector3.new(4, spec.height, 4), Transparency = 1 })
	emitter(core, "rbxasset://textures/particles/smoke_main.dds", color, 40, { speed = NumberRange.new(6, 14), size = NumberSequence.new(spec.radius * 0.3, spec.radius * 0.8), lifetime = NumberRange.new(1, 2), accel = Vector3.new(0, 20, 0) })
	local debris = {}
	for i = 1, 14 do
		table.insert(debris, newPart(model, { Size = Vector3.new(1.4, 1.4, 1.4), Color = Color3.fromRGB(110, 95, 80), Material = Enum.Material.Wood }))
	end
	local clones = payloadClones(folder, model, 5)
	return function(t)
		local c = FxPaths.tornado(spec, t)
		local spin = t * 3
		for _, r in rings do
			r.part.CFrame = CFrame.new(c + Vector3.new(0, r.y, 0)) * CFrame.Angles(0, spin, 0) * CFrame.Angles(0, 0, math.rad(90))
		end
		core.CFrame = CFrame.new(c + Vector3.new(0, spec.height / 2, 0))
		for i, d in debris do
			local a = spin * 1.4 + i * 0.9
			local h = (i / #debris) * spec.height * 0.8
			local rr = spec.radius * (0.4 + i / #debris)
			d.CFrame = CFrame.new(c + Vector3.new(math.cos(a) * rr, h, math.sin(a) * rr)) * CFrame.Angles(a, a, 0)
		end
		for i, m in clones do
			local a = spin * 1.1 + i * (math.pi * 2 / #clones)
			local h = spec.height * (0.25 + 0.12 * i)
			local rr = spec.radius * (0.7 + 0.1 * i)
			m:PivotTo(CFrame.new(c + Vector3.new(math.cos(a) * rr, h, math.sin(a) * rr)) * CFrame.Angles(0, -a, 0.5))
		end
	end
end

BUILD.tsunami = function(folder, spec, model, color)
	local width = spec.radius * 2
	local dir = if spec.vel.Magnitude > 0 then spec.vel.Unit else Vector3.xAxis
	local wall = newPart(model, { Size = Vector3.new(width, spec.height, spec.height * 1.1), Color = color, Material = Enum.Material.Glass, Transparency = 0.25, Reflectance = 0.2 })
	local wedgeClass = Instance.new("WedgePart")
	wedgeClass.Anchored = true
	wedgeClass.CanCollide = false
	wedgeClass.CanQuery = false
	wedgeClass.CastShadow = false
	wedgeClass.Size = Vector3.new(width, spec.height, spec.height * 1.4)
	wedgeClass.Color = color
	wedgeClass.Material = Enum.Material.Glass
	wedgeClass.Transparency = 0.3
	wedgeClass.Parent = model
	local foam = newPart(model, { Size = Vector3.new(width, 3, 6), Color = Color3.fromRGB(240, 250, 255), Material = Enum.Material.SmoothPlastic })
	emitter(foam, "rbxasset://textures/particles/smoke_main.dds", Color3.fromRGB(245, 250, 255), 60, { speed = NumberRange.new(3, 8), size = NumberSequence.new(3, 6), lifetime = NumberRange.new(0.8, 1.4) })
	local clones = payloadClones(folder, model, 6)
	local right = Vector3.new(-dir.Z, 0, dir.X)
	return function(t)
		local front = FxPaths.wave(spec, t)
		local visible = t >= spec.t0 - 0.5
		local base = CFrame.lookAt(front, front + dir)
		wall.CFrame = base * CFrame.new(0, spec.height / 2 - 2, spec.height * 0.55)
		wedgeClass.CFrame = base * CFrame.new(0, spec.height / 2 - 2, -spec.height * 0.15) * CFrame.Angles(0, math.pi, 0)
		foam.CFrame = base * CFrame.new(0, spec.height - 1, 0)
		wall.Transparency = if visible then 0.25 else 1
		wedgeClass.Transparency = if visible then 0.3 else 1
		foam.Transparency = if visible then 0 else 1
		for i, m in clones do
			local lat = (i - (#clones + 1) / 2) * (width / (#clones + 1))
			m:PivotTo(CFrame.new(front + right * lat + Vector3.new(0, spec.height + 2 + math.sin(t * 3 + i) * 2, 0)) * CFrame.Angles(t + i, t * 0.7, 0))
		end
	end
end

BUILD.black_hole = function(folder, spec, model, _color)
	local core = newPart(model, { Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Color = Color3.fromRGB(5, 5, 8), Material = Enum.Material.SmoothPlastic })
	local halo = newPart(model, { Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), Color = Color3.fromRGB(120, 80, 220), Material = Enum.Material.ForceField, Transparency = 0.2 })
	local disk = newPart(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 1, 1), Color = Color3.fromRGB(255, 160, 70), Material = Enum.Material.Neon, Transparency = 0.15 })
	local disk2 = newPart(model, { Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 1, 1), Color = Color3.fromRGB(190, 120, 255), Material = Enum.Material.Neon, Transparency = 0.3 })
	emitter(halo, "rbxasset://textures/particles/sparkles_main.dds", Color3.fromRGB(200, 160, 255), 50, { speed = NumberRange.new(-20, -10), size = NumberSequence.new(1.5), lifetime = NumberRange.new(1, 1.5), light = 1 })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(180, 120, 255)
	light.Range = 60
	light.Brightness = 3
	light.Parent = disk
	local clones = payloadClones(folder, model, 6)
	return function(t)
		local p = FxPaths.progress(spec, t)
		local grow = math.min(1, p * 5)
		local collapse = if p > 0.95 then (1 - p) / 0.05 else 1
		local r = spec.radius * grow * collapse
		local c = spec.pos
		core.CFrame = CFrame.new(c)
		core.Size = Vector3.new(1, 1, 1) * math.max(r * 2, 0.1)
		halo.CFrame = CFrame.new(c)
		halo.Size = Vector3.new(1, 1, 1) * math.max(r * 2.6, 0.1)
		disk.CFrame = CFrame.new(c) * CFrame.Angles(0.35, t * 2, 0) * CFrame.Angles(0, 0, math.rad(90))
		disk.Size = Vector3.new(0.6, r * 5, r * 5)
		disk2.CFrame = CFrame.new(c) * CFrame.Angles(0.35, -t * 3, 0) * CFrame.Angles(0, 0, math.rad(90))
		disk2.Size = Vector3.new(0.4, r * 3.6, r * 3.6)
		for i, m in clones do
			local a = t * 2 + i
			local rr = r * (3 - (t % 3))
			m:PivotTo(CFrame.new(c + Vector3.new(math.cos(a) * rr, math.sin(a * 2) * 2, math.sin(a) * rr)) * CFrame.Angles(a, a, 0))
		end
	end
end

BUILD.storm = function(folder, _spec, model, _color)
	local center = folder:GetAttribute("FxPos") :: Vector3? or Vector3.zero
	local clouds = {}
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local p = newPart(model, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(80, 80, 80),
			Color = Color3.fromRGB(60, 62, 72),
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.35,
			CFrame = CFrame.new(center + Vector3.new(math.cos(a) * 60, 120, math.sin(a) * 60)),
		})
		table.insert(clouds, p)
	end
	return function(t)
		for i, p in clouds do
			p.CFrame = p.CFrame * CFrame.new(math.sin(t * 0.3 + i) * 0.05, 0, 0)
		end
	end
end

BUILD.wind = function(folder, _spec, model, _color)
	local dir = folder:GetAttribute("FxVel") :: Vector3? or Vector3.xAxis
	local holder = newPart(model, { Size = Vector3.new(1, 1, 1), Transparency = 1 })
	local e = emitter(holder, "rbxasset://textures/particles/smoke_main.dds", Color3.fromRGB(240, 245, 255), 30, { speed = NumberRange.new(40, 60), spread = Vector2.new(5, 30), size = NumberSequence.new(0.6, 2), lifetime = NumberRange.new(1, 2) })
	e.EmissionDirection = Enum.NormalId.Front
	return function(_t)
		local cam = Workspace.CurrentCamera
		if cam then
			local p = cam.CFrame.Position - dir * 40 + Vector3.new(0, 5, 0)
			holder.CFrame = CFrame.lookAt(p, p + dir)
		end
	end
end

local function attach(folder: Instance)
	if active[folder] then
		return
	end
	local kind = folder:GetAttribute("FxKind")
	if type(kind) ~= "string" or not BUILD[kind] then
		return
	end
	local spec = FxPaths.fromFolder(folder)
	local element = folder:GetAttribute("FxElement")
	local color = ELEMENT_COLORS[element or ""] or Color3.fromRGB(200, 200, 210)
	local model = Instance.new("Model")
	model.Name = "Visual_" .. kind
	model.Parent = root
	local ok, update = pcall(BUILD[kind], folder, spec, model, color)
	if not ok then
		warn("[Ideias] visual " .. kind .. ": " .. tostring(update))
		model:Destroy()
		return
	end
	active[folder] = {
		folder = folder,
		kind = kind,
		spec = spec,
		model = model,
		update = update,
		stop = function()
			model:Destroy()
		end,
	}
end

local function scan(inst: Instance)
	if inst:IsA("Folder") then
		if inst:GetAttribute("FxKind") then
			attach(inst)
		end
		inst:GetAttributeChangedSignal("FxKind"):Connect(function()
			attach(inst)
		end)
	end
end

function Disasters.init()
	root = Instance.new("Folder")
	root.Name = "DesastresLocais"
	root.Parent = Workspace.CurrentCamera or Workspace
	local events = Workspace:WaitForChild("IdeiasEventos", 30)
	if not events then
		return
	end
	for _, d in events:GetDescendants() do
		scan(d)
	end
	events.DescendantAdded:Connect(scan)
	RunService.RenderStepped:Connect(function()
		local t = now()
		for folder, a in active do
			if not folder.Parent then
				a.stop()
				active[folder] = nil
			else
				local ok = pcall(a.update, t)
				if not ok then
					a.stop()
					active[folder] = nil
				end
			end
		end
	end)
end

return Disasters
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[--!strict
-- Efeitos visuais locais disparados pelo servidor (Fx). Tudo é criado numa
-- pasta local da câmera e removido com Debris: nada fica acumulado.

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Settings = require(script.Parent.Parent.Settings)
local Config = require(game:GetService("ReplicatedStorage").IdeiasShared.Config)

local Effects = {}

local player = Players.LocalPlayer
local folder: Folder
local hud: any = nil
local movement: any = nil

local TEX_FIRE = "rbxasset://textures/particles/fire_main.dds"
local TEX_SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local TEX_SPARK = "rbxasset://textures/particles/sparkles_main.dds"
local RAINBOW = { Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 170, 50), Color3.fromRGB(255, 235, 60), Color3.fromRGB(80, 230, 100), Color3.fromRGB(70, 160, 255), Color3.fromRGB(170, 90, 255) }

local function camPos(): Vector3
	local cam = Workspace.CurrentCamera
	return if cam then cam.CFrame.Position else Vector3.zero
end

local function part(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = folder
	return p
end

local function tween(inst: Instance, t: number, goals: { [string]: any }, style: Enum.EasingStyle?)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goals)
	tw:Play()
	return tw
end

local function burst(at: Vector3, texture: string, colors: { Color3 }, count: number, speed: number, size: number, life: number, accel: Vector3?)
	local scale = Settings.quality().particles
	local holder = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(at), Transparency = 1 })
	local e = Instance.new("ParticleEmitter")
	e.Texture = texture
	e.Enabled = false
	local keys = {}
	for i, c in colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(#colors - 1, 1), c))
	end
	if #keys == 1 then
		table.insert(keys, ColorSequenceKeypoint.new(1, colors[1]))
	end
	e.Color = ColorSequence.new(keys)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 1.6) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(life * 0.6, life)
	e.LightEmission = 0.7
	e.Drag = 2
	if accel then
		e.Acceleration = accel
	end
	e.Parent = holder
	e:Emit(math.max(3, math.floor(count * scale)))
	Debris:AddItem(holder, life + 0.5)
end

local function ring(at: Vector3, radius: number, color: Color3, duration: number?)
	local d = duration or 0.6
	local p = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 2, 2), CFrame = CFrame.new(at + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = color, Transparency = 0.2 })
	tween(p, d, { Size = Vector3.new(0.4, radius * 2, radius * 2), Transparency = 1 })
	Debris:AddItem(p, d + 0.1)
end

local function sound(id: string, at: Vector3, volume: number?)
	if not Settings.values.sounds then
		return
	end
	local p = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(at), Transparency = 1 })
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.7
	s.RollOffMaxDistance = 400
	s.Parent = p
	s:Play()
	Debris:AddItem(p, 5)
end

-- som de um efeito: trecho do sprite do ElevenLabs ou som embutido (fallback)
local function cue(name: string, at: Vector3?, volume: number?)
	if not Settings.values.sounds then
		return
	end
	local c = Config.SoundCues[name]
	if not c then
		return
	end
	local sp = Config.SoundSprite
	local s = Instance.new("Sound")
	local region = c.sprite and sp.Regions[c.sprite]
	if sp.Id ~= 0 and region then
		s.SoundId = "rbxassetid://" .. tostring(sp.Id)
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(region[1], region[2])
	else
		s.SoundId = c.fallback
	end
	s.Volume = (volume or 1) * (c.volume or 0.7)
	s.PlaybackSpeed = c.speed or 1
	s.RollOffMaxDistance = 450
	if at then
		local holder = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(at), Transparency = 1 })
		s.Parent = holder
		Debris:AddItem(holder, 6)
	else
		s.Parent = game:GetService("SoundService")
		Debris:AddItem(s, 6)
	end
	s:Play()
end
Effects.cue = cue

local shakeAmount = 0
local function shake(intensity: number)
	if not Settings.values.shake then
		return
	end
	shakeAmount = math.min(shakeAmount + intensity, 3)
end

local tintEffect: ColorCorrectionEffect? = nil
local function tint(color: Color3, duration: number, gray: boolean?)
	if not tintEffect then
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "TintaLocal"
		cc.Parent = Lighting
		tintEffect = cc
	end
	local cc = tintEffect :: ColorCorrectionEffect
	cc.TintColor = color
	cc.Saturation = if gray then -1 else 0
	cc.Enabled = true
	task.delay(duration, function()
		tween(cc, 0.6, { TintColor = Color3.new(1, 1, 1), Saturation = 0 })
	end)
end

local function zigzag(a: Vector3, b: Vector3, color: Color3, width: number, life: number)
	local segments = 7
	local prev = a
	for i = 1, segments do
		local t = i / segments
		local p = a:Lerp(b, t)
		if i < segments then
			p += Vector3.new(math.random(-40, 40) / 10, 0, math.random(-40, 40) / 10) * (1 - t * 0.5)
		end
		local mid = (prev + p) / 2
		local len = (p - prev).Magnitude
		local seg = part({ Size = Vector3.new(width, width, len), CFrame = CFrame.lookAt(mid, p), Color = color })
		tween(seg, life, { Transparency = 1 })
		Debris:AddItem(seg, life + 0.1)
		prev = p
	end
end

-- manipuladores -----------------------------------------------------------------
local H: { [string]: (any) -> () } = {}

H.ring = function(d)
	ring(d.p, d.r, d.c)
end

H.shake = function(d)
	local dist = (camPos() - d.p).Magnitude
	shake(d.i * math.clamp(1 - dist / 400, 0.1, 1))
end

H.flash = function(d)
	local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(d.p), Color = d.c, Transparency = 0.1 })
	tween(p, 0.35, { Size = Vector3.new(d.s, d.s, d.s), Transparency = 1 })
	local l = Instance.new("PointLight")
	l.Color = d.c
	l.Range = math.min(d.s * 2, 60)
	l.Brightness = 5
	l.Parent = p
	Debris:AddItem(p, 0.5)
end

H.bolt = function(d)
	local dist = (d.b - d.a).Magnitude
	local t = dist / d.v
	local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(d.w, d.w, d.w) * 1.6, CFrame = CFrame.new(d.a), Color = d.c })
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, d.w * 0.4, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -d.w * 0.4, 0)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.25
	trail.Color = ColorSequence.new(d.c)
	trail.LightEmission = 1
	trail.Transparency = NumberSequence.new(0, 1)
	trail.Parent = p
	tween(p, t, { CFrame = CFrame.new(d.b) }, Enum.EasingStyle.Linear)
	task.delay(t, function()
		burst(d.b, TEX_SPARK, { d.c }, 10, 12, 0.6, 0.5)
	end)
	Debris:AddItem(p, t + 0.3)
end

H.zap = function(d)
	zigzag(d.a, d.b, d.c, 0.35, 0.25)
end

H.push = function(d)
	if movement then
		movement.push(d.v, d.m)
	end
end

H.tint = function(d)
	tint(d.c, d.d, d.gray)
end

H.toast = function(d)
	if hud then
		hud.toast(d.t, d.c)
	end
end

H.boom = function(d)
	local s = d.s or 1
	local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4) * s, CFrame = CFrame.new(d.p), Color = Color3.fromRGB(255, 170, 60), Transparency = 0 })
	tween(p, 0.5, { Size = Vector3.new(26, 26, 26) * s, Transparency = 1, Color = Color3.fromRGB(255, 80, 20) })
	Debris:AddItem(p, 0.6)
	burst(d.p, TEX_FIRE, { Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 80, 20) }, 30, 30 * s, 3 * s, 0.9)
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(90, 85, 80) }, 20, 14 * s, 5 * s, 2.5, Vector3.new(0, 6, 0))
	cue("explosion", d.p, 1)
	shake(0.8 * s * math.clamp(1 - (camPos() - d.p).Magnitude / 300, 0, 1))
end

H.poof = function(d)
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(240, 240, 250) }, 18, 10 * (d.s or 1), 2.5 * (d.s or 1), 1.2)
	cue("poof", d.p, 0.6)
end

H.spawn = function(d)
	ring(d.p, 10 * (d.s or 1), d.c, 0.8)
	burst(d.p + Vector3.new(0, 2, 0), TEX_SPARK, { d.c, Color3.new(1, 1, 1) }, 24, 16, 0.8, 1)
	-- coluna de luz rápida: o "portal" de onde a ideia sai
	local col = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(40, 3, 3) * (d.s or 1), CFrame = CFrame.new(d.p + Vector3.new(0, 20, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = d.c, Transparency = 0.35 })
	tween(col, 0.7, { Size = Vector3.new(40, 0.2, 0.2) * (d.s or 1), Transparency = 1 })
	Debris:AddItem(col, 0.8)
	cue("create", d.p, 0.8)
end

H.build = function(d)
	ring(d.p, d.r or 20, Color3.fromRGB(230, 220, 200), 1)
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(210, 200, 185) }, 26, 18, 4, 1.6)
end

H.confetti = function(d)
	burst(d.p + Vector3.new(0, 3, 0), TEX_SPARK, if d.gold then { Color3.fromRGB(255, 220, 80), Color3.fromRGB(255, 255, 200) } else RAINBOW, 60, 30, 0.7, 2, Vector3.new(0, -20, 0))
	sound("rbxasset://sounds/electronicpingshort.wav", d.p, 0.6)
end

H.steam = function(d)
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(250, 250, 255) }, 40, 20 * (d.s or 1), 6 * (d.s or 1), 2.5, Vector3.new(0, 10, 0))
end

H.dust = function(d)
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(170, 150, 120) }, 14, 10, 3 * (d.s or 1) / 3, 1.2)
end

H.warn = function(d)
	local p = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, d.r * 2, d.r * 2), CFrame = CFrame.new(d.p + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 50, 50), Transparency = 0.55 })
	tween(p, math.max(d.d or 1, 0.2), { Transparency = 0.2 })
	Debris:AddItem(p, math.max(d.d or 1, 0.2) + 0.1)
end

H.lightning = function(d)
	local top = d.p + Vector3.new(math.random(-15, 15), 180, math.random(-15, 15))
	zigzag(top, d.p, Color3.fromRGB(220, 240, 255), 0.8, 0.35)
	H.flash({ p = d.p, c = Color3.fromRGB(220, 235, 255), s = 30 })
	tint(Color3.fromRGB(230, 240, 255), 0.08)
	cue("explosion", d.p, 0.8)
	shake(0.5 * math.clamp(1 - (camPos() - d.p).Magnitude / 300, 0, 1))
end

H.laser = function(d)
	local p = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(300, 6, 6), CFrame = CFrame.new(d.p + Vector3.new(0, 150, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = d.c, Transparency = 0.1 })
	tween(p, 0.6, { Size = Vector3.new(300, 0.5, 0.5), Transparency = 1 })
	Debris:AddItem(p, 0.7)
	ring(d.p, 12, d.c, 0.5)
end

H.beam = function(d)
	local mid = (d.a + d.b) / 2
	local len = (d.b - d.a).Magnitude
	local p = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, 8, 8), CFrame = CFrame.lookAt(mid, d.b) * CFrame.Angles(0, math.rad(90), 0), Color = d.c, Transparency = 0.6 })
	tween(p, d.d or 1.5, { Transparency = 1 })
	Debris:AddItem(p, (d.d or 1.5) + 0.1)
end

H.whirl = function(d)
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(230, 220, 200) }, 30, 25, 3, 1.5, Vector3.new(0, 25, 0))
end

H.slash = function(d)
	for i = -2, 2 do
		local p = part({ Size = Vector3.new(0.3, 0.3, 4), CFrame = CFrame.new(d.p) * CFrame.Angles(0, i * 0.35, 0), Color = d.c })
		tween(p, 0.25, { Transparency = 1 })
		Debris:AddItem(p, 0.3)
	end
end

H.cone = function(d)
	local dir = (d.b - d.a)
	for k = 1, 6 do
		local at = d.a + dir * (k / 6)
		burst(at, TEX_FIRE, { Color3.fromRGB(255, 220, 90), d.c }, 6, 6, 1 + k * 0.4, 0.5)
	end
end

H.fireworks = function(d)
	for i = 1, d.n or 3 do
		task.delay(i * 0.25, function()
			local from = d.p + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
			local to = from + Vector3.new(math.random(-10, 10), math.random(50, 90), math.random(-10, 10))
			local c = RAINBOW[math.random(1, #RAINBOW)]
			H.bolt({ a = from, b = to, c = c, v = 80, w = 0.6 })
			task.delay((to - from).Magnitude / 80, function()
				burst(to, TEX_SPARK, { c, Color3.new(1, 1, 1) }, 60, 45, 1.2, 1.8, Vector3.new(0, -12, 0))
			end)
		end)
	end
end

H.nuke = function(d)
	local s = d.s or 3
	for k = 0, 4 do
		local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(10, 10, 10), CFrame = CFrame.new(d.p + Vector3.new(0, k * 14 * s * 0.4, 0)), Color = Color3.fromRGB(120, 105, 95), Material = Enum.Material.SmoothPlastic, Transparency = 0.2 })
		tween(p, 2.5, { Size = Vector3.new(30, 30, 30) * s * (if k == 4 then 1.6 else 0.6), Transparency = 1 })
		Debris:AddItem(p, 2.6)
	end
	tint(Color3.fromRGB(255, 220, 190), 1.5)
end

H.power = function(d)
	ring(d.p - Vector3.new(0, 2.5, 0), 8, Color3.fromRGB(255, 230, 120), 0.6)
	burst(d.p, TEX_SPARK, { Color3.fromRGB(255, 240, 160), Color3.fromRGB(140, 220, 255) }, 20, 10, 0.6, 1)
end

H.fly = function(d)
	if movement then
		movement.fly(d.d or 20)
	end
end

H.slowfall = function(d)
	if movement then
		movement.slowfall(d.d or 10)
	end
end

H.shootingstar = function(_d)
	local cam = camPos()
	local from = cam + Vector3.new(math.random(-300, 300), 260, math.random(-300, 300))
	local to = from + Vector3.new(math.random(-200, 200), -80, math.random(-200, 200))
	H.bolt({ a = from, b = to, c = Color3.fromRGB(255, 255, 230), v = 260, w = 1 })
end

-- EFEITOS DOS NOVOS PODERES --------------------------------------------------------
H.charge = function(d)
	local s = d.s or 1
	local ball = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(d.p + Vector3.new(0, 1.5 * s, 0)), Color = d.c, Transparency = 0.2 })
	tween(ball, d.d or 0.9, { Size = Vector3.new(5, 5, 5) * s, Transparency = 0.5 })
	Debris:AddItem(ball, (d.d or 0.9) + 0.1)
	ring(d.p, 7 * s, d.c, d.d or 0.9)
	burst(d.p, TEX_SPARK, { d.c, Color3.new(1, 1, 1) }, 40, 8, 0.7, 0.9, Vector3.new(0, 20, 0))
	cue("charge", d.p, 1)
end

H.kame = function(d)
	local mid = (d.a + d.b) / 2
	local len = (d.b - d.a).Magnitude
	local w = d.w or 2.5
	local cf = CFrame.lookAt(mid, d.b) * CFrame.Angles(0, math.rad(90), 0)
	local outer = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, w * 2.2, w * 2.2), CFrame = cf, Color = d.c, Transparency = 0.35 })
	local core = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, w, w), CFrame = cf, Color = Color3.new(1, 1, 1), Transparency = 0 })
	tween(outer, 1.1, { Size = Vector3.new(len, 0.3, 0.3), Transparency = 1 })
	tween(core, 1.1, { Size = Vector3.new(len, 0.1, 0.1), Transparency = 1 })
	Debris:AddItem(outer, 1.2)
	Debris:AddItem(core, 1.2)
	H.flash({ p = d.b, c = d.c, s = 18 })
	burst(d.b, TEX_SPARK, { d.c, Color3.new(1, 1, 1) }, 50, 40, 1.2, 1)
	cue("beam", d.a, 1)
end

H.punch = function(d)
	local s = d.s or 1
	ring(d.p, 16 * s, Color3.fromRGB(255, 255, 255), 0.5)
	ring(d.p + Vector3.new(0, 2, 0), 10 * s, Color3.fromRGB(255, 230, 120), 0.35)
	H.flash({ p = d.p, c = Color3.fromRGB(255, 250, 220), s = 14 * s })
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(230, 225, 215) }, 25, 35, 3, 1)
	cue("punch", d.p, 1)
	shake(1.2 * math.clamp(1 - (camPos() - d.p).Magnitude / 300, 0, 1))
end

H.web = function(d)
	zigzag(d.a, d.b, Color3.fromRGB(245, 245, 250), 0.15, 0.6)
	for k = 0, 3 do
		local p = part({ Size = Vector3.new(0.1, 0.1, 5), CFrame = CFrame.new(d.b) * CFrame.Angles(0, k * math.pi / 4, 0), Color = Color3.fromRGB(245, 245, 250), Material = Enum.Material.SmoothPlastic })
		tween(p, 2.5, { Transparency = 1 })
		Debris:AddItem(p, 2.6)
	end
	cue("launch", d.a, 0.5)
end

H.lasereyes = function(d)
	for _, off in { -0.25, 0.25 } do
		local a = d.a + Vector3.new(off, 0, 0)
		local mid = (a + d.b) / 2
		local len = (d.b - a).Magnitude
		local p = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(len, 0.35, 0.35), CFrame = CFrame.lookAt(mid, d.b) * CFrame.Angles(0, math.rad(90), 0), Color = d.c })
		tween(p, 0.4, { Transparency = 1 })
		Debris:AddItem(p, 0.5)
	end
	burst(d.b, TEX_FIRE, { d.c, Color3.fromRGB(255, 220, 90) }, 14, 12, 1, 0.6)
	cue("laser", d.a, 0.9)
end

H.holy = function(d)
	local dur = d.d or 10
	local pillar = part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(400, 14, 14), CFrame = CFrame.new(d.p + Vector3.new(0, 200, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(255, 240, 190), Transparency = 0.55 })
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(255, 240, 190)
	l.Range = 60
	l.Brightness = 3
	l.Parent = pillar
	tween(pillar, dur, { Transparency = 1, Size = Vector3.new(400, 4, 4) })
	Debris:AddItem(pillar, dur + 0.2)
	ring(d.p, d.r or 40, Color3.fromRGB(255, 235, 170), 2)
	burst(d.p + Vector3.new(0, 4, 0), TEX_SPARK, { Color3.fromRGB(255, 250, 220), Color3.fromRGB(255, 225, 140) }, 80, 12, 1, 3, Vector3.new(0, 6, 0))
	-- pombas brancas circulando
	for i = 1, 6 do
		local dove = part({ Size = Vector3.new(1.2, 0.3, 0.8), Color = Color3.fromRGB(250, 250, 255), Material = Enum.Material.SmoothPlastic, CFrame = CFrame.new(d.p) })
		local t0 = os.clock()
		local conn
		conn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - t0
			if t > dur or not dove.Parent then
				conn:Disconnect()
				dove:Destroy()
				return
			end
			local a = t * 0.9 + i * math.pi / 3
			local pos = d.p + Vector3.new(math.cos(a) * 14, 12 + math.sin(t * 2 + i) * 2, math.sin(a) * 14)
			dove.CFrame = CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a)))
		end)
	end
	tint(Color3.fromRGB(255, 245, 220), 1.2)
	cue("holy", d.p, 1)
end

H.calm = function(d)
	burst(d.p + Vector3.new(0, 4, 0), TEX_SPARK, { Color3.fromRGB(255, 240, 200), Color3.fromRGB(255, 200, 230) }, 12, 4, 0.6, 1.5, Vector3.new(0, 4, 0))
end

H.poop = function(d)
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(120, 85, 50), Color3.fromRGB(160, 120, 70) }, 22, 10 * (d.s or 1), 2.5 * (d.s or 1), 1.4)
	cue("fart", d.p, 1)
end

H.launch = function(d)
	local t = d.t or 0.8
	local ball = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(d.a), Color = d.c or Color3.fromRGB(255, 220, 120) })
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.5, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.5, 0)
	a1.Parent = ball
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.35
	trail.Color = ColorSequence.new(d.c or Color3.fromRGB(255, 220, 120))
	trail.LightEmission = 1
	trail.Parent = ball
	local t0 = os.clock()
	local h = math.max(8, (d.b - d.a).Magnitude * 0.35)
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local k = math.clamp((os.clock() - t0) / t, 0, 1)
		ball.CFrame = CFrame.new(d.a:Lerp(d.b, k) + Vector3.new(0, math.sin(k * math.pi) * h, 0))
		if k >= 1 then
			conn:Disconnect()
			ball:Destroy()
			H.poof({ p = d.b, s = 1.2 })
		end
	end)
	cue("launch", d.a, 1)
end

H.notes = function(d)
	for i = 1, 6 do
		task.delay(i * 0.2, function()
			local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(d.p + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3))), Color = RAINBOW[(i % #RAINBOW) + 1] })
			tween(p, 1.4, { CFrame = p.CFrame + Vector3.new(math.random(-2, 2), 7, math.random(-2, 2)), Transparency = 1 })
			Debris:AddItem(p, 1.5)
		end)
	end
end

H.fuse = function(d)
	local dur = d.d or 1.1
	local p = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(3, 3, 3), CFrame = CFrame.new(d.p + Vector3.new(0, 2, 0)), Color = Color3.fromRGB(255, 60, 40), Transparency = 0.5 })
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < dur and p.Parent do
			p.Transparency = if p.Transparency > 0.6 then 0.3 else 0.85
			task.wait(0.12)
		end
		p:Destroy()
	end)
	cue("hiss", d.p, 1)
end

H.petrify = function(d)
	H.flash({ p = d.p, c = Color3.fromRGB(170, 170, 160), s = 10 })
	burst(d.p, TEX_SMOKE, { Color3.fromRGB(150, 150, 145) }, 16, 8, 2, 1.2)
	cue("crack", d.p, 1)
end

H.drum = function(d)
	for k = 0, 2 do
		task.delay(k * 0.35, function()
			ring(d.p, (d.r or 14) * (0.6 + k * 0.2), Color3.fromRGB(200, 150, 90), 0.4)
			cue("drum", d.p, 1)
			shake(0.35 * math.clamp(1 - (camPos() - d.p).Magnitude / 200, 0, 1))
		end)
	end
end

function Effects.handle(data: any)
	if type(data) ~= "table" then
		return
	end
	local f = H[data.k]
	if f then
		local ok, err = pcall(f, data)
		if not ok then
			warn("[Ideias] efeito " .. tostring(data.k) .. ": " .. tostring(err))
		end
	end
end

function Effects.init(hudModule: any, movementModule: any)
	hud = hudModule
	movement = movementModule
	folder = Instance.new("Folder")
	folder.Name = "EfeitosLocais"
	folder.Parent = Workspace.CurrentCamera or Workspace
	-- tremor aplicado logo depois da câmera padrão (prioridade Camera + 1)
	RunService:BindToRenderStep("IdeiasTremor", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if shakeAmount > 0.01 then
			local cam = Workspace.CurrentCamera
			if cam then
				local a = shakeAmount * 0.35
				cam.CFrame *= CFrame.Angles(math.rad((math.random() - 0.5) * a * 4), math.rad((math.random() - 0.5) * a * 4), 0)
			end
			shakeAmount = math.max(0, shakeAmount - dt * 2.5)
		end
	end)
end

Effects.folder = function()
	return folder
end
Effects.burst = burst
Effects.part = part
Effects._player = player

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">Movement</string>
              <string name="Source"><![CDATA[--!strict
-- Movimento do próprio personagem (o cliente é dono da física dele):
-- plataformas de salto, empurrões vindos do servidor, poder de voar,
-- queda lenta (paraquedas) e direção de veículos com botões de altitude.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Theme = require(script.Parent.Parent.UI.Theme)

local Movement = {}

local player = Players.LocalPlayer
local flyUntil = 0
local slowUntil = 0
local flyVel: LinearVelocity? = nil
local slowForce: VectorForce? = nil
local padCooldown = 0
local airUp = 0
local airButtons: Frame? = nil

local function charParts(): (Model?, Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil, nil
	end
	return char, char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Movement.push(v: Vector3, mode: string?)
	local _, hum, root = charParts()
	if not root or not hum or hum.Sit then
		return
	end
	-- limita impulsos absurdos (proteção contra valores estranhos)
	if v.Magnitude > 400 then
		v = v.Unit * 400
	end
	if v.Y > 5 then
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	if mode == "set" then
		root.AssemblyLinearVelocity = v
	else
		root.AssemblyLinearVelocity += v
	end
end

function Movement.fly(duration: number)
	flyUntil = os.clock() + duration
end

function Movement.slowfall(duration: number)
	slowUntil = os.clock() + duration
end

local function hookPad(pad: Instance)
	if not pad:IsA("BasePart") then
		return
	end
	pad.Touched:Connect(function(hit)
		local char, hum, root = charParts()
		if not char or not root or not hum or not hit:IsDescendantOf(char) then
			return
		end
		if os.clock() < padCooldown then
			return
		end
		padCooldown = os.clock() + 1
		local force = (pad:GetAttribute("Forca") :: number?) or 120
		local dir = (pad:GetAttribute("Direcao") :: Vector3?) or Vector3.yAxis
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
		root.AssemblyLinearVelocity = dir.Unit * force
		if force > 200 then
			slowUntil = os.clock() + 6
		end
	end)
end

-- direção de veículos -------------------------------------------------------------
local yaw = 0
local currentSeat: VehicleSeat? = nil

local function vehicleOf(seat: Instance?): Model?
	if seat and seat:IsA("VehicleSeat") then
		local m = seat:FindFirstAncestorOfClass("Model")
		if m and m:GetAttribute("Veiculo") then
			return m
		end
	end
	return nil
end

local function drive(dt: number)
	local _, hum = charParts()
	local seat = hum and hum.SeatPart
	local model = vehicleOf(seat)
	if not model or not seat then
		if airButtons then
			airButtons.Visible = false
		end
		currentSeat = nil
		return
	end
	local vseat = seat :: VehicleSeat
	local chassis = model.PrimaryPart
	local lv = chassis and chassis:FindFirstChild("Tracao") :: LinearVelocity?
	local ao = chassis and chassis:FindFirstChild("Estabilizador") :: AlignOrientation?
	if not chassis or not lv or not ao then
		return
	end
	if currentSeat ~= vseat then
		currentSeat = vseat
		local look = chassis.CFrame.LookVector
		yaw = math.atan2(-look.X, -look.Z)
	end
	local drivemode = model:GetAttribute("Conducao")
	if drivemode == "rocket" then
		return -- o foguete é controlado pelo servidor
	end
	local maxSpeed = (model:GetAttribute("VelMax") :: number?) or 60
	local throttle = vseat.ThrottleFloat
	local steer = vseat.SteerFloat
	-- no celular o analógico também vale (MoveDirection relativo à câmera)
	if math.abs(throttle) < 0.05 and math.abs(steer) < 0.05 and hum then
		local md = hum.MoveDirection
		if md.Magnitude > 0.1 then
			local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
			local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
			throttle = md:Dot(forward)
			steer = md:Dot(right)
		end
	end
	yaw -= steer * 1.8 * dt * (if throttle < -0.1 then -1 else 1)
	local look = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local speed = throttle * maxSpeed * (if throttle < 0 then 0.45 else 1)
	ao.CFrame = CFrame.Angles(0, yaw, 0)
	if drivemode == "air" then
		if airButtons then
			airButtons.Visible = true
		end
		local up = airUp
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			up = 1
		elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			up = -1
		end
		lv.VectorVelocity = look * speed + Vector3.new(0, up * 30, 0)
	else
		if airButtons then
			airButtons.Visible = false
		end
		lv.PlaneVelocity = Vector2.new(look.X * speed, look.Z * speed)
	end
end

local function buildAirButtons(gui: ScreenGui)
	local frame = Theme.new("Frame", {
		Name = "Altitude",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.45, 0),
		Size = UDim2.fromOffset(64, 140),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	}, { Theme.new("UIListLayout", { Padding = UDim.new(0, 10) }) })
	for _, def in { { "▲", 1 }, { "▼", -1 } } do
		local b = Theme.button({ Text = def[1], TextSize = 26, Size = UDim2.fromOffset(64, 64), BackgroundColor3 = Theme.Colors.bg, BackgroundTransparency = 0.2, Parent = frame })
		Theme.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = b })
		b.MouseButton1Down:Connect(function()
			airUp = def[2] :: number
		end)
		b.MouseButton1Up:Connect(function()
			airUp = 0
		end)
		b.MouseLeave:Connect(function()
			airUp = 0
		end)
	end
	airButtons = frame
end

local function step(dt: number)
	local char, hum, root = charParts()
	if not char or not hum or not root then
		return
	end
	local now = os.clock()
	-- voo: velocidade segue a direção da câmera enquanto anda
	if now < flyUntil and not hum.Sit then
		if not flyVel or flyVel.Parent ~= root then
			local att = root:FindFirstChild("VooLocal") :: Attachment? or Instance.new("Attachment")
			att.Name = "VooLocal"
			att.Parent = root
			local lv = Instance.new("LinearVelocity")
			lv.Attachment0 = att
			lv.RelativeTo = Enum.ActuatorRelativeTo.World
			lv.MaxForce = 4e4
			lv.Parent = root
			flyVel = lv
		end
		local cam = Workspace.CurrentCamera
		local md = hum.MoveDirection
		local v = Vector3.zero
		if md.Magnitude > 0.05 and cam then
			local look = cam.CFrame.LookVector
			v = (md + Vector3.new(0, look.Y * md.Magnitude, 0)).Unit * 55
		end
		if hum.Jump then
			v += Vector3.new(0, 30, 0)
		end
		;(flyVel :: LinearVelocity).VectorVelocity = v
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	elseif flyVel then
		flyVel:Destroy()
		flyVel = nil
	end
	-- queda lenta
	if now < slowUntil then
		if not slowForce or slowForce.Parent ~= root then
			local att = root:FindFirstChild("QuedaLocal") :: Attachment? or Instance.new("Attachment")
			att.Name = "QuedaLocal"
			att.Parent = root
			local f = Instance.new("VectorForce")
			f.Attachment0 = att
			f.RelativeTo = Enum.ActuatorRelativeTo.World
			f.Parent = root
			slowForce = f
		end
		local mass = root.AssemblyMass
		local g = Workspace.Gravity
		local vy = root.AssemblyLinearVelocity.Y
		;(slowForce :: VectorForce).Force = Vector3.new(0, if vy < -12 then mass * g * 0.92 else mass * g * 0.3, 0)
	elseif slowForce then
		slowForce:Destroy()
		slowForce = nil
	end
	drive(dt)
end

function Movement.init(gui: ScreenGui)
	for _, pad in CollectionService:GetTagged("IdeiasPulo") do
		hookPad(pad)
	end
	CollectionService:GetInstanceAddedSignal("IdeiasPulo"):Connect(hookPad)
	buildAirButtons(gui)
	RunService.Heartbeat:Connect(step)
end

return Movement
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="114">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Ideias Sem Limites V3 — cliente.
-- Liga interface, efeitos, clima/animação, movimento e a comunicação com o
-- servidor. O cliente nunca decide o que é criado: só envia o texto.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local remotes = ReplicatedStorage:WaitForChild("IdeiasRemotes")
local criar = remotes:WaitForChild("Criar")
local estado = remotes:WaitForChild("Estado")
local acao = remotes:WaitForChild("Acao")
local fx = remotes:WaitForChild("Fx")

local root = script.Parent
local Settings = require(root.Settings)
local Hud = require(root.UI.Hud)
local Drawer = require(root.UI.Drawer)
local Effects = require(root.FX.Effects)
local Disasters = require(root.FX.Disasters)
local Ambient = require(root.FX.Ambient)
local Movement = require(root.FX.Movement)

Settings.init()
local gui = Hud.build(playerGui)
Drawer.build(gui)
Movement.init(gui)
Effects.init(Hud, Movement)
task.spawn(Disasters.init)
task.spawn(Ambient.init)

local busy = false
Hud.onSubmit = function(text)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, res = pcall(function()
			return criar:InvokeServer(text)
		end)
		busy = false
		if ok then
			Hud.result(res)
			-- câmera cinemática: olha para a ideia criada por alguns segundos
			if type(res) == "table" and res.ok and Settings.values.camera == "cinematica" then
				local cam = Workspace.CurrentCamera
				local char = player.Character
				local head = char and char:FindFirstChild("Head")
				if cam and head then
					local look = (head :: BasePart).CFrame.LookVector
					local target = (head :: BasePart).Position + look * 25
					cam.CameraType = Enum.CameraType.Scriptable
					local from = (head :: BasePart).Position - look * 18 + Vector3.new(0, 12, 0)
					cam.CFrame = CFrame.lookAt(from, target)
					task.delay(3.5, function()
						cam.CameraType = Enum.CameraType.Custom
					end)
				end
			end
		else
			Hud.result({ ok = false, message = "Conexão instável, tente de novo" })
		end
	end)
end

Drawer.sendAction = function(action, arg)
	acao:FireServer(action, arg)
end

estado.OnClientEvent:Connect(function(kind, data)
	if kind == "capacidade" then
		Hud.capacity(data)
	elseif kind == "feed" then
		Hud.toast(string.format("%s %s criou: %s", data.icon or "💡", data.name, data.label))
	elseif kind == "perfil" then
		Drawer.profile = data
		Drawer.refresh()
	elseif kind == "conquista" then
		Hud.banner("🏆 " .. data.title, data.desc .. "  +" .. data.reward .. " ✨")
	elseif kind == "segredo" then
		Hud.banner("🔮 Combinação secreta: " .. data.title, data.hint .. "  +" .. data.reward .. " ✨")
	elseif kind == "missao" then
		Hud.toast("🎯 Missão cumprida: " .. data.title .. "  +" .. data.reward .. " ✨", Color3.fromRGB(255, 220, 110))
	elseif kind == "regiao" then
		Hud.toast("🗺️ Nova região: " .. data.label, Color3.fromRGB(150, 230, 255))
	end
end)

fx.OnClientEvent:Connect(Effects.handle)

Hud.toast("Bem-vindo ao Ideias Sem Limites! Digite qualquer coisa e toque em CRIAR ✨", Color3.fromRGB(150, 230, 255))
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--!strict
-- Configurações locais do jogador (gráficos, câmera, som, notificações).
-- Guardadas como atributos no Player: persistem durante a sessão.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")

local Settings = {}

local player = Players.LocalPlayer
local listeners: { (string, any) -> () } = {}

Settings.values = {
	quality = "medio", -- baixo | medio | alto
	camera = "normal", -- normal | primeira | cinematica
	shake = true,
	sounds = true,
	notifications = true,
	uiScale = 1,
}

local QUALITY = {
	baixo = { particles = 0.35, post = false, shadows = false, weather = 0.4 },
	medio = { particles = 0.7, post = true, shadows = true, weather = 0.7 },
	alto = { particles = 1, post = true, shadows = true, weather = 1 },
}

function Settings.quality(): { particles: number, post: boolean, shadows: boolean, weather: number }
	return QUALITY[Settings.values.quality] or QUALITY.medio
end

local function applyGraphics()
	local q = Settings.quality()
	-- mudanças em Lighting feitas no cliente valem só para este jogador
	for _, name in { "BrilhoIdeias", "RaiosIdeias", "CorIdeias" } do
		local e = Lighting:FindFirstChild(name)
		if e and e:IsA("PostEffect") then
			e.Enabled = q.post
		end
	end
	Lighting.GlobalShadows = q.shadows
end

local function applyCamera()
	if Settings.values.camera == "primeira" then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	else
		player.CameraMode = Enum.CameraMode.Classic
	end
end

function Settings.set(key: string, value: any)
	(Settings.values :: any)[key] = value
	player:SetAttribute("Cfg_" .. key, value)
	if key == "quality" then
		applyGraphics()
	elseif key == "camera" then
		applyCamera()
	end
	for _, fn in listeners do
		task.spawn(fn, key, value)
	end
end

function Settings.onChanged(fn: (string, any) -> ())
	table.insert(listeners, fn)
end

function Settings.init()
	-- celulares começam no médio; telas grandes no alto
	local cam = workspace.CurrentCamera
	if cam and cam.ViewportSize.X > 1300 then
		Settings.values.quality = "alto"
	end
	for key, value in Settings.values do
		local saved = player:GetAttribute("Cfg_" .. key)
		if saved ~= nil then
			(Settings.values :: any)[key] = saved
		end
	end
	applyGraphics()
	applyCamera()
	-- efeitos de pós-processamento podem chegar depois do servidor criá-los
	Lighting.ChildAdded:Connect(function()
		task.defer(applyGraphics)
	end)
end

return Settings
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="116">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">Drawer</string>
              <string name="Source"><![CDATA[--!strict
-- Painel lateral recolhível: um "dock" de botões redondos à esquerda (acima do
-- analógico) abre abas com sugestões por categoria, histórico, favoritos,
-- progresso, loja de cosméticos e ajustes. Fechado por padrão: a tela fica limpa.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("IdeiasShared")
local Catalog = require(Shared.Catalog)
local Progression = require(Shared.Catalog.Progression)
local Planner = require(Shared.Planner)
local Theme = require(script.Parent.Theme)
local Hud = require(script.Parent.Hud)
local Settings = require(script.Parent.Parent.Settings)

local Drawer = {}

local C = Theme.Colors
local new = Theme.new

Drawer.sendAction = nil :: ((string, any) -> ())?
Drawer.profile = nil :: any

local panel: Frame
local content: ScrollingFrame
local title: TextLabel
local current: string? = nil
local selectedCategory = "creature"

local COMBOS = {
	"dragão de gelo gigante",
	"herói contra demônio",
	"chuva de pizzas",
	"dragão protegendo castelo",
	"robô dinossauro",
	"tornado de tubarões",
	"100 zumbis",
	"cavaleiro montando dragão",
	"tornado elétrico gigante",
	"meteoro congelante",
	"casa de ouro",
	"capivara de estimação",
	"zumbi no carro",
	"fogo e gelo",
}

local function clear()
	for _, ch in content:GetChildren() do
		if not ch:IsA("UIListLayout") and not ch:IsA("UIPadding") then
			ch:Destroy()
		end
	end
end

local order = 0
local function nextOrder(): number
	order += 1
	return order
end

local function section(text: string)
	Theme.label({ Text = text, TextSize = 14, TextColor3 = C.muted, FontFace = Theme.FontBold, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = nextOrder(), Parent = content })
end

local function chipGrid(items: { { text: string, fill: string, color: Color3? } })
	local grid = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = nextOrder(),
		Parent = content,
	}, {
		new("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 34), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for i, it in items do
		local b = Theme.button({ Text = it.text, TextSize = 14, TextWrapped = true, BackgroundColor3 = it.color or C.bg2, LayoutOrder = i, Parent = grid })
		b.Activated:Connect(function()
			Hud.setText(it.fill)
			Hud.sound("Click")
			Theme.pop(b)
		end)
	end
end

local function row(text: string, actions: { { label: string, fn: () -> () } }, onTap: (() -> ())?)
	local r = new("Frame", {
		BackgroundColor3 = C.bg2,
		Size = UDim2.new(1, 0, 0, 38),
		LayoutOrder = nextOrder(),
		Parent = content,
	}, { Theme.corner(10) })
	local tap = new("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, -40 * #actions, 1, 0),
		Parent = r,
	})
	Theme.label({ Text = text, TextSize = 15, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -10, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = tap })
	if onTap then
		tap.Activated:Connect(onTap)
	end
	for i, a in actions do
		local b = Theme.button({ Text = a.label, TextSize = 16, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4 - (i - 1) * 40, 0.5, 0), Size = UDim2.fromOffset(34, 30), BackgroundColor3 = C.panel, Parent = r })
		b.Activated:Connect(a.fn)
	end
end

local function progressBar(label: string, value: number, max: number, color: Color3)
	local f = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = nextOrder(), Parent = content })
	Theme.label({ Text = string.format("%s  %d/%d", label, value, max), TextSize = 14, Size = UDim2.new(1, 0, 0, 20), FontFace = Theme.FontBold, Parent = f })
	local back = new("Frame", { BackgroundColor3 = C.bg2, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 10), Parent = f }, { Theme.corner(5) })
	new("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(math.clamp(value / math.max(max, 1), 0, 1), 1), Parent = back }, { Theme.corner(5) })
end

local function choice(label: string, key: string, options: { { any } })
	section(label)
	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = nextOrder(), Parent = content }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }),
	})
	for _, opt in options do
		local active = (Settings.values :: any)[key] == opt[2]
		local b = Theme.button({ Text = opt[1], TextSize = 14, Size = UDim2.new(1 / #options, -6, 1, 0), BackgroundColor3 = if active then C.accent2 else C.bg2, Parent = holder })
		b.Activated:Connect(function()
			Settings.set(key, opt[2])
			Drawer.show(current)
		end)
	end
end

-- abas -------------------------------------------------------------------------
local TABS = {}

TABS.ideias = function()
	section("Categorias")
	local cats = {}
	for id, info in Catalog.CategoryInfo do
		table.insert(cats, { id = id, info = info })
	end
	table.sort(cats, function(a, b)
		return a.info.order < b.info.order
	end)
	local strip = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 3,
		LayoutOrder = nextOrder(),
		Parent = content,
	}, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
	for i, c in cats do
		local b = Theme.button({ Text = c.info.icon .. " " .. c.info.label, TextSize = 14, Size = UDim2.fromOffset(130, 34), LayoutOrder = i, BackgroundColor3 = if c.id == selectedCategory then C.accent2 else C.bg2, Parent = strip })
		b.Activated:Connect(function()
			selectedCategory = c.id
			Drawer.show("ideias")
		end)
	end
	local items = {}
	for _, def in Catalog.Concepts do
		if def.category == selectedCategory then
			table.insert(items, { text = def.label, fill = def.label })
		end
	end
	table.sort(items, function(a, b)
		return a.text < b.text
	end)
	section(string.format("%d ideias • toque para escrever", #items))
	chipGrid(items)
	section("Combinações (experimente!)")
	local combos = {}
	for _, cmb in COMBOS do
		table.insert(combos, { text = cmb, fill = cmb, color = Color3.fromRGB(40, 36, 70) })
	end
	chipGrid(combos)
	section("Dica: qualquer palavra funciona — palavras desconhecidas viram surpresas 🎲")
end

TABS.historico = function()
	if #Hud.history == 0 then
		section("Suas ideias aparecem aqui.")
		return
	end
	for _, text in Hud.history do
		row(text, {
			{
				label = "⭐",
				fn = function()
					local ok, plan = pcall(Planner.plan, text)
					if ok and not plan.surprise and Drawer.sendAction then
						Drawer.sendAction("favoritar", plan.label)
						Hud.toast("⭐ Favorito: " .. plan.label, C.gold)
					else
						Hud.toast("Só ideias reconhecidas podem ser favoritas", C.warn)
					end
				end,
			},
		}, function()
			Hud.setText(text)
		end)
	end
end

TABS.favoritos = function()
	local favs = Drawer.profile and Drawer.profile.favorites or {}
	if #favs == 0 then
		section("Toque em ⭐ no histórico para guardar ideias aqui.")
		return
	end
	for _, label in favs do
		row(label, {
			{
				label = "✕",
				fn = function()
					if Drawer.sendAction then
						Drawer.sendAction("favoritar", label)
					end
				end,
			},
		}, function()
			Hud.setText(label)
		end)
	end
end

TABS.progresso = function()
	local p = Drawer.profile
	if not p then
		section("Carregando...")
		return
	end
	section(string.format("✨ Faíscas: %d   %s", p.sparks or 0, if p.saved then "" else "(progresso só nesta sessão)"))
	progressBar("📖 Descobertas", #(p.discovered or {}), p.totalConcepts or 1, C.accent)
	progressBar("🔮 Combinações secretas", #(p.secrets or {}), p.totalSecrets or 1, C.accent2)
	section("Missões da sessão")
	for _, q in p.quests or {} do
		local def = Progression.QuestById[q.id]
		if def then
			progressBar((if q.done then "✅ " else "🎯 ") .. def.title, math.min(q.progress, def.goal), def.goal, if q.done then C.good else C.warn)
		end
	end
	section("Conquistas")
	local got = {}
	for _, id in p.achievements or {} do
		got[id] = true
	end
	for _, a in Progression.Achievements do
		row((if got[a.id] then "🏆 " else "🔒 ") .. a.title .. " — " .. a.desc, {})
	end
end

TABS.loja = function()
	local p = Drawer.profile
	if not p then
		section("Carregando...")
		return
	end
	section(string.format("✨ Faíscas: %d  •  ganhe criando, descobrindo e cumprindo missões", p.sparks or 0))
	local owned = {}
	for _, id in p.owned or {} do
		owned[id] = true
	end
	for _, c in Progression.Cosmetics do
		local equipped = p.equipped and p.equipped[c.kind] == c.id
		local icon = if c.kind == "trail" then "🌈" elseif c.kind == "aura" then "✨" else "🏷️"
		local text = string.format("%s %s", icon, c.title)
		if owned[c.id] then
			row(text .. (if equipped then "  (usando)" else ""), {
				{
					label = if equipped then "✓" else "👕",
					fn = function()
						if Drawer.sendAction then
							Drawer.sendAction("equipar", c.id)
						end
					end,
				},
			})
		else
			row(text .. "  —  " .. c.price .. " ✨", {
				{
					label = "🛒",
					fn = function()
						if (p.sparks or 0) < c.price then
							Hud.toast("Faíscas insuficientes", C.warn)
						elseif Drawer.sendAction then
							Drawer.sendAction("comprar", c.id)
						end
					end,
				},
			})
		end
	end
end

TABS.ajustes = function()
	choice("Gráficos", "quality", { { "Baixo", "baixo" }, { "Médio", "medio" }, { "Alto", "alto" } })
	choice("Câmera", "camera", { { "Normal", "normal" }, { "1ª pessoa", "primeira" }, { "Cinemática", "cinematica" } })
	choice("Tremor de câmera", "shake", { { "Ligado", true }, { "Desligado", false } })
	choice("Sons", "sounds", { { "Ligados", true }, { "Desligados", false } })
	choice("Avisos", "notifications", { { "Ligados", true }, { "Desligados", false } })
	choice("Tamanho da interface", "uiScale", { { "Menor", 0.85 }, { "Normal", 1 }, { "Maior", 1.15 } })
	section("Ideias Sem Limites • V3")
end

local TITLES = {
	ideias = "💡 Ideias",
	historico = "🕘 Histórico",
	favoritos = "⭐ Favoritos",
	progresso = "🏆 Progresso",
	loja = "🛍️ Loja",
	ajustes = "⚙️ Ajustes",
}

function Drawer.show(tab: string?)
	if not tab then
		return
	end
	current = tab
	clear()
	order = 0
	title.Text = TITLES[tab] or tab
	local f = TABS[tab]
	if f then
		f()
	end
	if not panel.Visible then
		panel.Visible = true
		panel.Position = UDim2.new(0, -360, 0.5, 0)
		Theme.tween(panel, 0.28, { Position = UDim2.new(0, 70, 0.5, 0) }, Enum.EasingStyle.Quint)
	end
end

function Drawer.hide()
	current = nil
	local tw = Theme.tween(panel, 0.22, { Position = UDim2.new(0, -360, 0.5, 0) })
	tw.Completed:Once(function()
		if not current then
			panel.Visible = false
		end
	end)
end

function Drawer.refresh()
	if current and panel.Visible then
		Drawer.show(current)
	end
end

function Drawer.build(gui: ScreenGui)
	local dock = new("Frame", {
		Name = "Dock",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.42, 0),
		Size = UDim2.fromOffset(50, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local buttons = {
		{ "ideias", "💡" },
		{ "historico", "🕘" },
		{ "favoritos", "⭐" },
		{ "progresso", "🏆" },
		{ "loja", "🛍️" },
		{ "ajustes", "⚙️" },
	}
	for i, bdef in buttons do
		local b = Theme.button({
			Text = bdef[2],
			TextSize = 22,
			Size = UDim2.fromOffset(48, 48),
			LayoutOrder = i,
			BackgroundColor3 = C.bg,
			BackgroundTransparency = 0.15,
			Parent = dock,
		})
		new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = b })
		Theme.stroke(C.accent, 1.5, 0.55).Parent = b
		b.Activated:Connect(function()
			Hud.sound("Click")
			if current == bdef[1] then
				Drawer.hide()
			else
				Drawer.show(bdef[1])
			end
		end)
	end

	panel = new("Frame", {
		Name = "Painel",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, -360, 0.5, 0),
		Size = UDim2.new(0, 340, 0.72, 0),
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.06,
		Visible = false,
		Parent = gui,
	}, {
		Theme.corner(16),
		Theme.stroke(C.accent2, 1.5, 0.4),
		new("UISizeConstraint", { MaxSize = Vector2.new(360, 520), MinSize = Vector2.new(260, 220) }),
	})
	title = Theme.label({ Text = "", TextSize = 20, FontFace = Theme.FontHeavy, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -60, 0, 30), Parent = panel })
	local close = Theme.button({ Text = "✕", TextSize = 18, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(32, 32), Parent = panel })
	close.Activated:Connect(Drawer.hide)
	content = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 44),
		Size = UDim2.new(1, 0, 1, -50),
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.accent,
		Parent = panel,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12) }),
	})
end

return Drawer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD principal: barra de ideias no topo (não cobre analógico nem botão de
-- pulo), prévia ao vivo da interpretação, botão CRIAR com recarga,
-- indicador de capacidade do mundo, notificações e destaques.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("IdeiasShared")
local Config = require(Shared.Config)
local Planner = require(Shared.Planner)
local Theme = require(script.Parent.Theme)
local Settings = require(script.Parent.Parent.Settings)

local Hud = {}

local player = Players.LocalPlayer
local C = Theme.Colors
local new = Theme.new

Hud.onSubmit = nil :: ((string) -> ())?
Hud.history = {} :: { string }

local gui: ScreenGui
local bar: Frame
local box: TextBox
local createBtn: TextButton
local cooldownFill: Frame
local previewLabel: TextLabel
local feedback: TextLabel
local capLabel: TextLabel
local capFill: Frame
local toastList: Frame
local banner: Frame
local cooldownUntil = 0
local sounds: { [string]: Sound } = {}

local Effects: any = nil
local function sound(name: string)
	if not Settings.values.sounds then
		return
	end
	-- criar/erro usam os sons do ElevenLabs quando o sprite está no jogo
	if name ~= "Click" and Config.SoundSprite and Config.SoundSprite.Id ~= 0 then
		if not Effects then
			local ok, mod = pcall(require, script.Parent.Parent.FX.Effects)
			Effects = if ok then mod else false
		end
		if Effects and Effects.cue then
			Effects.cue(if name == "Error" then "error" else "create", nil, 1)
			return
		end
	end
	local s = sounds[name]
	if s then
		s:Play()
	end
end
Hud.sound = sound

local function makeSounds()
	for name, id in Config.Sounds do
		local s = Instance.new("Sound")
		s.Name = "Ideias_" .. name
		s.SoundId = id
		s.Volume = 0.5
		s.Parent = SoundService
		sounds[name] = s
	end
end

function Hud.build(parent: Instance): ScreenGui
	makeSounds()
	gui = new("ScreenGui", {
		Name = "IdeiasHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = parent,
	})
	local uiScale = new("UIScale", { Parent = gui })
	local function rescale()
		local cam = workspace.CurrentCamera
		local vp = if cam then cam.ViewportSize else Vector2.new(1000, 600)
		local s = math.clamp(math.min(vp.X / 960, vp.Y / 520), 0.72, 1.25)
		uiScale.Scale = s * (Settings.values.uiScale or 1)
	end
	rescale()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	end
	Settings.onChanged(function(key)
		if key == "uiScale" then
			rescale()
		end
	end)

	-- barra de ideias -----------------------------------------------------------
	bar = new("Frame", {
		Name = "Barra",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.58, 0, 0, 52),
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.12,
		Parent = gui,
	}, {
		Theme.corner(26),
		Theme.stroke(C.accent, 2, 0.45),
		new("UISizeConstraint", { MinSize = Vector2.new(300, 52), MaxSize = Vector2.new(620, 52) }),
	})
	local icon = Theme.label({
		Text = "💡",
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(44, 52),
		Parent = bar,
	})
	local _ = icon
	box = new("TextBox", {
		Name = "Texto",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(44, 0),
		Size = UDim2.new(1, -170, 1, 0),
		Text = "",
		PlaceholderText = "Digite qualquer ideia... (ex.: dragão de gelo)",
		PlaceholderColor3 = C.muted,
		TextColor3 = C.text,
		FontFace = Theme.Font,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = bar,
	})
	createBtn = Theme.button({
		Name = "Criar",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(116, 40),
		Text = "CRIAR",
		TextSize = 19,
		FontFace = Theme.FontHeavy,
		BackgroundColor3 = C.accent,
		TextColor3 = Color3.fromRGB(10, 20, 35),
		ClipsDescendants = true,
		Parent = bar,
	})
	createBtn.Parent = bar
	new("UICorner", { CornerRadius = UDim.new(0, 20), Parent = createBtn })
	Theme.gradient(Color3.fromRGB(110, 230, 255), Color3.fromRGB(190, 130, 255), 0).Parent = createBtn
	cooldownFill = new("Frame", {
		Name = "Recarga",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 2,
		Parent = createBtn,
	}, { Theme.corner(20) })

	-- prévia + retorno logo abaixo da barra
	previewLabel = Theme.label({
		Name = "Previa",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 64),
		Size = UDim2.new(0.9, 0, 0, 22),
		Text = "",
		TextSize = 15,
		TextColor3 = C.accent,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.6,
		FontFace = Theme.FontBold,
		Parent = gui,
	})
	feedback = Theme.label({
		Name = "Retorno",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.new(0.9, 0, 0, 24),
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		FontFace = Theme.FontBold,
		TextTransparency = 1,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		Parent = gui,
	})

	-- capacidade do mundo (canto superior direito da barra)
	local cap = new("Frame", {
		Name = "Capacidade",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(96, 40),
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.2,
		Parent = gui,
	}, { Theme.corner(12), Theme.stroke(nil, 1, 0.6) })
	capLabel = Theme.label({
		Text = "🌍 0/12",
		TextSize = 15,
		FontFace = Theme.FontBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = cap,
	})
	local capBack = new("Frame", {
		BackgroundColor3 = C.bg2,
		Position = UDim2.new(0, 10, 1, -11),
		Size = UDim2.new(1, -20, 0, 5),
		Parent = cap,
	}, { Theme.corner(3) })
	capFill = new("Frame", { BackgroundColor3 = C.good, Size = UDim2.fromScale(0, 1), Parent = capBack }, { Theme.corner(3) })

	-- notificações (lado direito, abaixo do topo)
	toastList = new("Frame", {
		Name = "Avisos",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 120),
		Size = UDim2.fromOffset(300, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }),
	})

	-- destaque (conquistas, segredos)
	banner = new("Frame", {
		Name = "Destaque",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -140),
		Size = UDim2.fromOffset(420, 86),
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.05,
		Parent = gui,
	}, { Theme.corner(18), Theme.stroke(C.gold, 2.5, 0.1), Theme.gradient(Color3.fromRGB(40, 32, 70), Color3.fromRGB(20, 22, 36), 90) })
	Theme.label({ Name = "Titulo", Text = "", TextSize = 22, FontFace = Theme.FontHeavy, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 30), Parent = banner })
	Theme.label({ Name = "Texto", Text = "", TextSize = 16, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(10, 40), Size = UDim2.new(1, -20, 0, 40), Parent = banner })

	-- eventos ---------------------------------------------------------------------
	local lastTyped = 0
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > Config.Request.MaxTextLength then
			box.Text = string.sub(box.Text, 1, Config.Request.MaxTextLength)
		end
		lastTyped = os.clock()
		local stamp = lastTyped
		task.delay(0.18, function()
			if stamp == lastTyped then
				Hud.updatePreview()
			end
		end)
	end)
	box.FocusLost:Connect(function(enter)
		if enter then
			Hud.submit()
		end
	end)
	createBtn.Activated:Connect(function()
		Hud.submit()
	end)
	RunService.RenderStepped:Connect(function()
		local left = cooldownUntil - os.clock()
		if left > 0 then
			cooldownFill.Size = UDim2.fromScale(left / Config.Request.Cooldown, 1)
			createBtn.Text = string.format("%.1fs", left)
		elseif createBtn.Text ~= "CRIAR" then
			cooldownFill.Size = UDim2.fromScale(0, 1)
			createBtn.Text = "CRIAR"
		end
	end)
	return gui
end

function Hud.updatePreview()
	local text = box.Text
	if #string.gsub(text, "%s", "") == 0 then
		previewLabel.Text = ""
		return
	end
	local ok, plan = pcall(Planner.plan, text)
	if ok then
		previewLabel.Text = (if plan.surprise then "🎲 " else "→ ") .. plan.label
		previewLabel.TextColor3 = if plan.surprise then C.warn else C.accent
	else
		previewLabel.Text = ""
	end
end

function Hud.setText(text: string)
	box.Text = text
	Hud.updatePreview()
end

function Hud.focus()
	box:CaptureFocus()
end

function Hud.submit()
	local text = box.Text
	if #string.gsub(text, "%s", "") == 0 then
		Theme.shake(bar)
		Hud.feedback("Digite uma ideia primeiro 💡", C.warn)
		return
	end
	if os.clock() < cooldownUntil then
		Theme.shake(createBtn)
		sound("Error")
		return
	end
	cooldownUntil = os.clock() + Config.Request.Cooldown
	Theme.pop(createBtn)
	sound("Click")
	-- histórico local (texto do próprio jogador, mostrado só para ele)
	local i = table.find(Hud.history, text)
	if i then
		table.remove(Hud.history, i)
	end
	table.insert(Hud.history, 1, text)
	while #Hud.history > Config.Data.MaxHistory do
		table.remove(Hud.history)
	end
	if Hud.onSubmit then
		Hud.onSubmit(text)
	end
end

function Hud.result(res: any)
	if type(res) ~= "table" then
		Hud.feedback("Sem resposta do servidor", C.bad)
		return
	end
	if res.ok then
		box.Text = ""
		previewLabel.Text = ""
		sound("Create")
		local msg = (res.icon or "✨") .. " " .. tostring(res.label)
		if res.notes and #res.notes > 0 then
			msg ..= "  •  " .. tostring(res.notes[1])
		end
		Hud.feedback(msg, if res.surprise then C.warn else C.good)
		for _, d in res.discovered or {} do
			Hud.toast("📖 Nova descoberta: " .. d, C.accent)
		end
		if res.cooldown then
			cooldownUntil = os.clock() + res.cooldown
		end
	else
		sound("Error")
		Theme.shake(bar)
		Hud.feedback("⚠️ " .. tostring(res.message or "Não foi possível criar"), C.bad)
		if res.wait and res.wait > 0 then
			cooldownUntil = os.clock() + res.wait
		elseif res.reason ~= "cooldown" then
			cooldownUntil = 0
		end
	end
end

local feedbackStamp = 0
function Hud.feedback(text: string, color: Color3)
	feedbackStamp += 1
	local stamp = feedbackStamp
	feedback.Text = text
	feedback.TextColor3 = color
	feedback.TextTransparency = 0
	feedback.TextStrokeTransparency = 0.4
	task.delay(3.2, function()
		if stamp == feedbackStamp then
			Theme.tween(feedback, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local toastOrder = 0
function Hud.toast(text: string, color: Color3?)
	if not Settings.values.notifications then
		return
	end
	toastOrder += 1
	local item = new("Frame", {
		BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.15,
		Size = UDim2.fromOffset(290, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = toastOrder,
		Parent = toastList,
	}, {
		Theme.corner(10),
		Theme.padding(8),
		new("UIStroke", { Color = color or C.accent, Thickness = 1.5, Transparency = 0.3 }),
	})
	Theme.label({ Text = text, TextSize = 15, TextColor3 = color or C.text, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, FontFace = Theme.FontBold, Parent = item })
	-- no máximo 4 avisos visíveis
	local items = {}
	for _, ch in toastList:GetChildren() do
		if ch:IsA("Frame") then
			table.insert(items, ch)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #items > 4 do
		items[1]:Destroy()
		table.remove(items, 1)
	end
	task.delay(4.5, function()
		if item.Parent then
			Theme.tween(item, 0.4, { BackgroundTransparency = 1 })
			for _, d in item:GetDescendants() do
				if d:IsA("TextLabel") then
					Theme.tween(d, 0.4, { TextTransparency = 1 })
				elseif d:IsA("UIStroke") then
					Theme.tween(d, 0.4, { Transparency = 1 })
				end
			end
			task.wait(0.45)
			item:Destroy()
		end
	end)
end

function Hud.banner(title: string, text: string)
	sound("Create")
	local t = banner:FindFirstChild("Titulo") :: TextLabel
	local d = banner:FindFirstChild("Texto") :: TextLabel
	t.Text = title
	d.Text = text
	Theme.tween(banner, 0.45, { Position = UDim2.new(0.5, 0, 0, 104) }, Enum.EasingStyle.Back)
	task.delay(3.6, function()
		Theme.tween(banner, 0.4, { Position = UDim2.new(0.5, 0, 0, -140) })
	end)
end

function Hud.capacity(cap: any)
	if type(cap) ~= "table" then
		return
	end
	capLabel.Text = string.format("🌍 %d/%d", cap.events or 0, cap.maxEvents or 12)
	local load = math.clamp(cap.load or 0, 0, 1)
	Theme.tween(capFill, 0.3, { Size = UDim2.fromScale(load, 1) })
	capFill.BackgroundColor3 = if load > 0.85 then C.bad elseif load > 0.6 then C.warn else C.good
end

Hud._gui = function()
	return gui
end
Hud._guiService = GuiService
Hud._player = player

return Hud
]]></string>
