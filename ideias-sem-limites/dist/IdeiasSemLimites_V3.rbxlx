-- Personagem com nome digitado: aparência estável derivada do nome (seed)
local HAIRS = { "short", "long", "wild", "puffs", "spiky", "flame" }
local HATS = { {}, {}, { "cap" }, { "crown" }, { "wizard_hat" }, { "cowboy_hat" }, { "headband" }, { "helmet_army" }, { "tiara" } }
local EXTRAS = { {}, { "cape" }, { "scarf" }, { "sword" }, { "staff" }, { "belt" }, { "boots" }, { "wristbands" } }
local function customOutfit(seed: number): Outfit
	local function pick(list: { any }, k: number): any
		return list[((seed // k) % #list) + 1]
	end
	local function hsv(k: number, sat: number, val: number): Color3
		return Color3.fromHSV(((seed // k) % 360) / 360, sat, val)
	end
	local acc = {}
	for _, a in pick(HATS, 3) do
		table.insert(acc, a)
	end
	for _, a in pick(EXTRAS, 5) do
		table.insert(acc, a)
	end
	return {
		skin = pick(SKIN, 7),
		shirt = hsv(11, 0.6, 0.85),
		pants = hsv(17, 0.45, 0.45),
		shoes = hsv(19, 0.3, 0.3),
		hair = hsv(23, 0.5, 0.35 + ((seed // 29) % 5) / 10),
		hairStyle = pick(HAIRS, 31),
		cape = hsv(37, 0.7, 0.75),
		accent = hsv(41, 0.8, 1),
		acc = acc,
	}
end

-- Constrói um personagem; retorna RigResult
function Figures.build(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local o = if variant == "custom" then customOutfit(params.seed or 1) else (OUTFITS[variant] or OUTFITS.villager)
	local rng = params.rng
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local bulk = 1 + (o.bulk or 0)
	local headS = o.headSize or 1
	local skin = o.skin or (if rng then rng:pick(SKIN) else SKIN[2])
	local mat = o.mat or Enum.Material.SmoothPlastic
	local shirt = o.shirt
	if variant == "villager" and rng then
		shirt = Color3.fromHSV(rng:float(), 0.55, 0.85)
	end
	local acc = {}
	for _, a in o.acc or {} do
		acc[a] = true
	end

	local legH, torsoH = 2, 2
	local hipY = legH
	local torsoY = hipY + torsoH / 2
	local shoulderY = hipY + torsoH * 0.9
	local headY = hipY + torsoH + 0.65 * headS
	local root = R:makeRoot(Vector3.new(2 * bulk, 2, 1), torsoY)

	-- tronco
	local torso = b:box(Vector3.new(2 * bulk, torsoH, 1 * bulk), CFrame.new(0, torsoY, 0), shirt, { role = "primary", material = mat, name = "Tronco" })
	R:join(torso, root)

	-- pernas
	local legs = {}
	for i, side in { -1, 1 } do
		if acc.one_leg and side == 1 then
			continue
		end
		local m = R:mark()
		local x = side * 0.5 * bulk
		b:box(Vector3.new(0.95 * bulk, legH, 0.95 * bulk), CFrame.new(x, legH / 2, 0), o.pants, { role = "secondary", material = mat, name = "Perna" })
		local footZ = if acc.backward_feet then 0.35 else -0.2
		b:box(Vector3.new(1 * bulk, 0.35, 1.3), CFrame.new(x, 0.18, footZ), o.shoes or Kit.darker(o.pants, 0.3), { role = "secondary", material = mat })
		if acc.big_shoes then
			b:box(Vector3.new(1.2, 0.5, 2.2), CFrame.new(x, 0.25, -0.5), o.shoes or rgb(255, 60, 60), { role = "accent" })
		end
		if acc.socks then
			b:box(Vector3.new(1, 0.7, 1), CFrame.new(x, 0.75, 0), rgb(245, 245, 245), { role = "fixed" })
		end
		legs[i] = R:group(m, torso, Vector3.new(x, hipY, 0), { kind = "leg", axis = "X", amp = 0.7, phase = if side < 0 then 0 else math.pi })
	end
	if acc.one_leg then
		-- o saci pula numa perna só: a perna fica centralizada
		local m = R:mark()
		b:box(Vector3.new(0.95, legH, 0.95), CFrame.new(0, legH / 2, 0), skin, { role = "fixed" })
		R:group(m, torso, Vector3.new(0, hipY, 0), { kind = "bob", axis = "Y", amp = 0.6, speed = 2 })
	end

	-- braços
	local armPose = if o.pose == "zombie" then CFrame.Angles(math.rad(-80), 0, 0) else CFrame.identity
	local arms = {}
	for i, side in { -1, 1 } do
		local m = R:mark()
		local x = side * (1 + 0.5) * bulk
		local shoulder = Vector3.new(x, shoulderY, 0)
		local armCf = CFrame.new(shoulder) * armPose * CFrame.new(0, -0.9, 0)
		b:box(Vector3.new(0.9 * bulk, 1.9, 0.9 * bulk), armCf, shirt, { role = "primary", material = mat, name = "Braco" })
		b:box(Vector3.new(0.85 * bulk, 0.5, 0.85 * bulk), armCf * CFrame.new(0, -1, 0), o.gloves or skin, { role = "fixed", material = mat })
		if acc.wristbands then
			b:box(Vector3.new(0.95 * bulk, 0.25, 0.95 * bulk), armCf * CFrame.new(0, -0.65, 0), o.accent or rgb(200, 40, 40), { role = "accent" })
		end
		if acc.claws then
			b:part("wedge", Vector3.new(0.3, 0.6, 0.4), armCf * CFrame.new(0, -1.4, -0.3), rgb(240, 240, 230), { role = "fixed" })
		end
		arms[i] = R:group(m, torso, shoulder, { kind = "arm", axis = "X", amp = if o.pose == "zombie" then 0.15 else 0.6, phase = if side < 0 then math.pi else 0 })
	end
	local rightHand = Vector3.new(1.5 * bulk, shoulderY - 2, -0.2)
	if o.pose == "zombie" then
		rightHand = Vector3.new(1.5 * bulk, shoulderY - 0.2, -1.9)
	end

	-- cabeça
	local hm = R:mark()
	local head = b:box(Vector3.new(1.2 * headS, 1.2 * headS, 1.2 * headS), CFrame.new(0, headY, 0), skin, { role = "fixed", material = mat, name = "Cabeca" })
	R.head = head
	local eyeColor = o.eye or rgb(25, 25, 30)
	local eyeMat = if o.glowEyes then Enum.Material.Neon else Enum.Material.SmoothPlastic
	if acc.cyclops_eye then
		b:ball(0.7 * headS, CFrame.new(0, headY + 0.15, -0.6 * headS), rgb(250, 250, 250), { role = "fixed" })
		b:ball(0.32 * headS, CFrame.new(0, headY + 0.15, -0.9 * headS), eyeColor, { role = "eye" })
	elseif acc.alien_eyes then
		for _, side in { -1, 1 } do
			b:part("ball", Vector3.new(0.5, 0.7, 0.3) * headS, CFrame.new(side * 0.3 * headS, headY, -0.58 * headS) * CFrame.Angles(0, 0, side * 0.4), eyeColor, { role = "eye" })
		end
	elseif acc.spider_mask or acc.visor then
		-- máscara cobre o rosto: lentes no lugar dos olhos
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.34, 0.26, 0.06) * headS, CFrame.new(side * 0.27 * headS, headY + 0.12, -0.62 * headS) * CFrame.Angles(0, 0, side * 0.35), if acc.visor then rgb(120, 230, 255) else rgb(245, 245, 250), { role = if acc.visor then "eye" else "fixed", material = Enum.Material.Neon })
		end
	elseif not acc.space_helmet then
		for _, side in { -1, 1 } do
			if o.glowEyes then
				b:box(Vector3.new(0.2, 0.25, 0.08) * headS, CFrame.new(side * 0.28 * headS, headY + 0.1, -0.61 * headS), eyeColor, { role = "eye", material = eyeMat })
			else
				-- olho de desenho: branco, pupila e um pontinho de brilho
				b:box(Vector3.new(0.3, 0.34, 0.05) * headS, CFrame.new(side * 0.27 * headS, headY + 0.1, -0.605 * headS), rgb(250, 250, 252), { role = "fixed" })
				b:box(Vector3.new(0.17, 0.22, 0.06) * headS, CFrame.new(side * 0.25 * headS, headY + 0.08, -0.625 * headS), eyeColor, { role = "eye" })
				b:box(Vector3.new(0.06, 0.06, 0.07) * headS, CFrame.new(side * 0.22 * headS, headY + 0.14, -0.63 * headS), rgb(255, 255, 255), { role = "fixed", material = Enum.Material.Neon })
			end
		end
		-- sobrancelhas dão expressão (bravas em vilões)
		local angry = params.faction == "hostile"
		for _, side in { -1, 1 } do
			b:box(Vector3.new(0.3, 0.07, 0.05) * headS, CFrame.new(side * 0.27 * headS, headY + 0.33 * headS, -0.61 * headS) * CFrame.Angles(0, 0, if angry then side * 0.3 else side * -0.08), Kit.darker(o.hair or skin, 0.3), { role = "fixed" })
		end
		if not acc.ninja_mask and not acc.skull_eyes then
			b:box(Vector3.new(0.5, 0.08, 0.05) * headS, CFrame.new(0, headY - 0.28 * headS, -0.61 * headS), Kit.darker(skin, 0.45), { role = "fixed" })
		end
	end
	-- cabelo
	if o.hair and not acc.space_helmet then
		local hairStyle = o.hairStyle or "short"
		if hairStyle == "short" then
			b:box(Vector3.new(1.3, 0.35, 1.3) * headS, CFrame.new(0, headY + 0.6 * headS, 0.05), o.hair, { role = "fixed" })
		elseif hairStyle == "long" then
			b:box(Vector3.new(1.3, 0.35, 1.3) * headS, CFrame.new(0, headY + 0.6 * headS, 0.05), o.hair, { role = "fixed" })
			b:box(Vector3.new(1.3, 1.5, 0.35) * headS, CFrame.new(0, headY - 0.1, 0.62 * headS), o.hair, { role = "fixed" })
		elseif hairStyle == "wild" then
			for k = 0, 5 do
				local a = k / 6 * math.pi * 2
				b:ball(0.6 * headS, CFrame.new(math.cos(a) * 0.55, headY + 0.55, math.sin(a) * 0.55 + 0.1), o.hair, { role = "fixed" })
			end
		elseif hairStyle == "puffs" then
			for _, side in { -1, 1 } do
				b:ball(0.95 * headS, CFrame.new(side * 0.75 * headS, headY + 0.2, 0.1), o.hair, { role = "fixed" })
			end
		elseif hairStyle == "spiky" then
			for k = 0, 6 do
				local a = k / 7 * math.pi * 2
				local up = if k % 2 == 0 then 1.1 else 0.8
				b:part("wedge", Vector3.new(0.35, up, 0.55), CFrame.new(math.cos(a) * 0.42 * headS, headY + 0.75 * headS, math.sin(a) * 0.42 * headS + 0.1) * CFrame.Angles(math.sin(a) * 0.5, -a, -math.cos(a) * 0.5), o.hair, { role = "fixed" })
			end
			b:box(Vector3.new(1.28, 0.3, 1.28) * headS, CFrame.new(0, headY + 0.6 * headS, 0.05), o.hair, { role = "fixed" })
		elseif hairStyle == "snakes" then
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				local base = Vector3.new(math.cos(a) * 0.55, headY + 0.5, math.sin(a) * 0.55 + 0.1) * Vector3.new(headS, 1, headS)
				b:beam(base, base + Vector3.new(math.cos(a) * 0.6, 0.7, math.sin(a) * 0.6), 0.18, o.hair, { role = "fixed" }, true)
				b:ball(0.28, CFrame.new(base + Vector3.new(math.cos(a) * 0.65, 0.75, math.sin(a) * 0.65)), Kit.darker(o.hair, 0.15), { role = "fixed" })
			end
		elseif hairStyle == "flame" then
			for k = -2, 2 do
				b:part("wedge", Vector3.new(0.3, 0.9, 0.5), CFrame.new(k * 0.25, headY + 0.85 * headS, 0.1 + math.abs(k) * 0.1), o.hair, { role = "fixed", material = Enum.Material.Neon })
			end
		end
	end

	local accent = o.accent or rgb(255, 210, 60)
	-- acessórios da cabeça ---------------------------------------------------
	local top = headY + 0.6 * headS
	if acc.mask then
		b:box(Vector3.new(1.25, 0.3, 0.1) * headS, CFrame.new(0, headY + 0.1, -0.62 * headS), rgb(20, 30, 90), { role = "fixed" })
	end
	if acc.helmet_knight then
		b:box(Vector3.new(1.4, 1.4, 1.4) * headS, CFrame.new(0, headY + 0.05, 0), rgb(175, 180, 190), { role = "primary", material = Enum.Material.DiamondPlate })
		b:box(Vector3.new(1.0, 0.12, 0.05), CFrame.new(0, headY + 0.1, -0.72 * headS), rgb(15, 15, 20), { role = "fixed" })
		b:part("wedge", Vector3.new(0.25, 0.8, 1.2), CFrame.new(0, top + 0.45, 0.2), rgb(200, 30, 40), { role = "accent" })
	end
	if acc.ninja_mask then
		b:box(Vector3.new(1.25, 0.75, 1.25) * headS, CFrame.new(0, headY - 0.25, 0), rgb(25, 25, 30), { role = "fixed" })
		b:box(Vector3.new(1.25, 0.4, 1.25) * headS, CFrame.new(0, headY + 0.45, 0), rgb(25, 25, 30), { role = "fixed" })
	end
	if acc.headband then
		b:box(Vector3.new(1.26, 0.18, 1.26) * headS, CFrame.new(0, headY + 0.28, 0), rgb(200, 30, 40), { role = "accent" })
		b:box(Vector3.new(0.12, 0.15, 0.9), CFrame.new(0.2, headY + 0.25, 0.95), rgb(200, 30, 40), { role = "accent" })
	end
	if acc.tricorn then
		b:part("cyl", Vector3.new(0.2, 2.0, 2.0), CFrame.new(0, top + 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(25, 25, 30), { role = "fixed" })
		b:box(Vector3.new(1.2, 0.6, 1.2), CFrame.new(0, top + 0.45, 0), rgb(25, 25, 30), { role = "fixed" })
		b:box(Vector3.new(0.3, 0.3, 0.05), CFrame.new(0, top + 0.5, -0.62), rgb(240, 240, 240), { role = "fixed" })
	end
	if acc.eyepatch then
		b:box(Vector3.new(0.35, 0.35, 0.08), CFrame.new(0.28, headY + 0.1, -0.64 * headS), rgb(15, 15, 15), { role = "fixed" })
	end
	if acc.wizard_hat or acc.witch_hat then
		local col = if acc.wizard_hat then (o.robe or shirt) else rgb(25, 20, 30)
		b:part("cyl", Vector3.new(0.15, 2.2, 2.2), CFrame.new(0, top + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)), col, { role = "primary" })
		b:cone(2.4, 1.3, CFrame.new(0, top + 0.1, 0) * CFrame.Angles(math.rad(-8), 0, 0), col, 4, { role = "primary" })
		if acc.wizard_hat then
			b:ball(0.35, CFrame.new(0.2, top + 1.1, -0.5), accent, { role = "accent", material = Enum.Material.Neon })
		end
	end
	if acc.nose then
		b:part("wedge", Vector3.new(0.25, 0.5, 0.5), CFrame.new(0, headY, -0.8 * headS) * CFrame.Angles(math.rad(180), 0, 0), Kit.darker(skin, 0.1), { role = "fixed" })
	end
	if acc.fangs then
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.1, 0.2, 0.06), CFrame.new(side * 0.12, headY - 0.38, -0.62) * CFrame.Angles(math.rad(180), 0, 0), rgb(255, 255, 255), { role = "fixed" })
		end
	end
	if acc.police_cap then
		b:part("cyl", Vector3.new(0.45, 1.35, 1.35), CFrame.new(0, top + 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(30, 40, 90), { role = "fixed" })
		b:box(Vector3.new(1.1, 0.1, 0.5), CFrame.new(0, top - 0.05, -0.75), rgb(20, 20, 20), { role = "fixed" })
		b:box(Vector3.new(0.3, 0.3, 0.05), CFrame.new(0, top + 0.15, -0.68), accent, { role = "accent" })
	end
	if acc.helmet_army or acc.fire_helmet then
		local col = if acc.fire_helmet then rgb(200, 30, 30) else rgb(80, 95, 55)
		b:part("ball", Vector3.new(1.55, 1.2, 1.55) * headS, CFrame.new(0, top - 0.05, 0), col, { role = "fixed" })
		b:part("cyl", Vector3.new(0.12, 1.9, 1.9), CFrame.new(0, top - 0.25, 0.05) * CFrame.Angles(0, 0, math.rad(90)), col, { role = "fixed" })
	end
	if acc.santa_hat then
		b:part("cyl", Vector3.new(0.35, 1.35, 1.35), CFrame.new(0, top + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(250, 250, 250), { role = "fixed" })
		b:cone(1.6, 1.25, CFrame.new(0, top + 0.15, 0.1) * CFrame.Angles(math.rad(25), 0, 0), rgb(200, 25, 35), 3, { role = "fixed" })
		b:ball(0.4, CFrame.new(0, top + 1.45, 0.75), rgb(250, 250, 250), { role = "fixed" })
	end
	if acc.toque then
		b:part("cyl", Vector3.new(1.3, 1.25, 1.25), CFrame.new(0, top + 0.6, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(250, 250, 250), { role = "fixed" })
		b:ball(1.5, CFrame.new(0, top + 1.3, 0), rgb(250, 250, 250), { role = "fixed" })
	end
	if acc.space_helmet then
		b:ball(2.0 * headS, CFrame.new(0, headY, 0), rgb(240, 240, 245), { role = "fixed" })
		b:part("ball", Vector3.new(1.5, 1.1, 0.6), CFrame.new(0, headY + 0.05, -0.75), rgb(255, 190, 60), { role = "fixed", material = Enum.Material.Glass, reflectance = 0.4 })
	end
	if acc.goggles then
		for _, side in { -1, 1 } do
			b:part("cyl", Vector3.new(0.15, 0.4, 0.4), CFrame.new(side * 0.3, headY + 0.12, -0.65) * CFrame.Angles(0, math.rad(90), 0), rgb(120, 200, 255), { role = "fixed", material = Enum.Material.Glass })
		end
	end
	if acc.cowboy_hat then
		b:part("cyl", Vector3.new(0.12, 2.4, 2.4), CFrame.new(0, top + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(140, 95, 50), { role = "fixed" })
		b:box(Vector3.new(1.2, 0.7, 1.2), CFrame.new(0, top + 0.4, 0), rgb(140, 95, 50), { role = "fixed" })
	end
	if acc.bandana then
		b:part("wedge", Vector3.new(1.25, 0.6, 0.4), CFrame.new(0, headY - 0.45, -0.5) * CFrame.Angles(math.rad(180), 0, 0), rgb(200, 30, 40), { role = "accent" })
	end
	if acc.crown or acc.tiara then
		local n = if acc.crown then 6 else 5
		local r = if acc.crown then 0.55 else 0.5
		for k = 0, n - 1 do
			local a = k / n * math.pi * 2
			b:part("wedge", Vector3.new(0.25, if acc.crown then 0.55 else 0.35, 0.18), CFrame.new(math.cos(a) * r, top + 0.25, math.sin(a) * r) * CFrame.Angles(0, -a + math.pi / 2, 0), rgb(255, 205, 50), { role = "fixed", material = Enum.Material.Foil })
		end
		b:part("cyl", Vector3.new(0.25, r * 2.2, r * 2.2), CFrame.new(0, top + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(255, 205, 50), { role = "fixed", material = Enum.Material.Foil })
		b:ball(0.2, CFrame.new(0, top + 0.1, -r - 0.05), rgb(220, 30, 60), { role = "fixed", material = Enum.Material.Neon })
	end
	if acc.antenna then
		for _, side in { -1, 1 } do
			b:beam(Vector3.new(side * 0.3, top, 0), Vector3.new(side * 0.5, top + 0.9, 0), 0.08, skin, { role = "fixed" })
			b:ball(0.25, CFrame.new(side * 0.5, top + 0.95, 0), rgb(255, 80, 200), { role = "accent", material = Enum.Material.Neon })
		end
	end
	if acc.horns or acc.horns_small or acc.viking_helmet then
		local hs = if acc.horns_small then 0.6 else 1
		local hc = if acc.viking_helmet then rgb(240, 235, 220) else rgb(40, 30, 30)
		if acc.viking_helmet then
			b:part("ball", Vector3.new(1.5, 1.1, 1.5), CFrame.new(0, top - 0.1, 0), rgb(150, 150, 160), { role = "fixed", material = Enum.Material.Metal })
		end
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.3, 0.9 * hs, 0.5), CFrame.new(side * 0.6 * headS, top + 0.3, 0) * CFrame.Angles(0, 0, side * -0.5), hc, { role = "fixed" })
		end
	end
	if acc.halo then
		for k = 0, 9 do
			local a = k / 10 * math.pi * 2
			b:box(Vector3.new(0.3, 0.1, 0.18), CFrame.new(math.cos(a) * 0.7, top + 0.6, math.sin(a) * 0.7) * CFrame.Angles(0, -a, 0), rgb(255, 225, 90), { role = "fixed", material = Enum.Material.Neon })
		end
	end
	if acc.wolf_head then
		b:box(Vector3.new(0.7, 0.55, 0.8), CFrame.new(0, headY - 0.1, -0.9), Kit.darker(skin, 0.05), { role = "fixed", material = Enum.Material.Fabric })
		b:box(Vector3.new(0.25, 0.2, 0.2), CFrame.new(0, headY + 0.05, -1.3), rgb(20, 20, 20), { role = "fixed" })
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.2, 0.6, 0.4), CFrame.new(side * 0.4, top + 0.25, 0.1), skin, { role = "fixed" })
		end
	end
	if acc.fur_head then
		b:ball(1.7 * headS, CFrame.new(0, headY + 0.1, 0.15), rgb(240, 245, 250), { role = "primary", material = Enum.Material.Fabric })
	end
	if acc.goblin_ears then
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.15, 0.5, 1.0), CFrame.new(side * 0.85 * headS, headY + 0.1, 0) * CFrame.Angles(0, side * math.rad(90), 0), skin, { role = "fixed" })
		end
	end
	if acc.tusks then
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.15, 0.35, 0.15), CFrame.new(side * 0.3, headY - 0.35, -0.55), rgb(250, 245, 230), { role = "fixed" })
		end
	end
	if acc.croc_snout then
		b:box(Vector3.new(0.8, 0.5, 1.4), CFrame.new(0, headY - 0.15, -1.1), skin, { role = "fixed" })
		for k = -2, 2 do
			b:part("wedge", Vector3.new(0.1, 0.15, 0.1), CFrame.new(0.38, headY - 0.42, -1.1 + k * 0.25) * CFrame.Angles(math.rad(180), 0, 0), rgb(255, 255, 255), { role = "fixed" })
		end
	end
	if acc.saci_cap then
		b:cone(1.2, 1.3, CFrame.new(0, top - 0.05, 0.1) * CFrame.Angles(math.rad(-20), 0, 0), rgb(220, 30, 30), 3, { role = "fixed" })
	end
	if acc.pipe then
		b:box(Vector3.new(0.12, 0.12, 0.6), CFrame.new(0.2, headY - 0.3, -0.85), rgb(90, 55, 30), { role = "fixed" })
		b:part("cyl", Vector3.new(0.35, 0.25, 0.25), CFrame.new(0.2, headY - 0.18, -1.15) * CFrame.Angles(0, 0, math.rad(90)), rgb(90, 55, 30), { role = "fixed" })
	end
	if acc.beard_white or acc.beard_brown or acc.beard_red then
		local bc = if acc.beard_white then rgb(240, 240, 245) elseif acc.beard_red then rgb(200, 90, 40) else rgb(90, 60, 35)
		b:part("wedge", Vector3.new(1.1, 1.0, 0.45), CFrame.new(0, headY - 0.75, -0.45) * CFrame.Angles(0, math.rad(180), math.rad(180)), bc, { role = "fixed" })
	end
	if acc.mustache then
		b:box(Vector3.new(0.7, 0.15, 0.1), CFrame.new(0, headY - 0.18, -0.64), rgb(70, 40, 20), { role = "fixed" })
	end
	if acc.clown_nose then
		b:ball(0.35, CFrame.new(0, headY - 0.02, -0.7), rgb(255, 30, 40), { role = "fixed" })
	end
	if acc.skull_eyes then
		for _, side in { -1, 1 } do
			b:box(Vector3.new(0.3, 0.3, 0.06), CFrame.new(side * 0.28, headY + 0.1, -0.62), rgb(10, 10, 10), { role = "fixed" })
		end
		b:box(Vector3.new(0.6, 0.15, 0.06), CFrame.new(0, headY - 0.3, -0.62), rgb(20, 20, 20), { role = "fixed" })
	end
	if acc.spider_mask then
		b:box(Vector3.new(1.24, 1.24, 1.24) * headS, CFrame.new(0, headY, 0), o.skin or skin, { role = "primary" })
		for k = -1, 1 do
			b:box(Vector3.new(0.04, 1.26, 1.26) * headS, CFrame.new(k * 0.3 * headS, headY, 0), o.accent or rgb(240, 240, 245), { role = "fixed" })
		end
	end
	if acc.bat_cowl then
		b:box(Vector3.new(1.26, 0.8, 1.26) * headS, CFrame.new(0, headY + 0.25, 0), o.shirt, { role = "primary" })
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.2, 0.6, 0.3), CFrame.new(side * 0.42 * headS, top + 0.25, 0), o.shirt, { role = "primary" })
		end
	end
	if acc.visor then
		b:box(Vector3.new(1.3, 1.3, 1.3) * headS, CFrame.new(0, headY, 0.02), o.shirt, { role = "primary", material = Enum.Material.Metal })
	end
	if acc.headband_metal then
		b:box(Vector3.new(1.27, 0.22, 1.27) * headS, CFrame.new(0, headY + 0.32, 0), rgb(40, 50, 80), { role = "fixed" })
		b:box(Vector3.new(0.6, 0.2, 0.06), CFrame.new(0, headY + 0.32, -0.66 * headS), rgb(200, 205, 215), { role = "fixed", material = Enum.Material.Metal })
	end
	if acc.winged_helmet then
		b:part("ball", Vector3.new(1.45, 0.9, 1.45) * headS, CFrame.new(0, top - 0.05, 0), rgb(190, 195, 205), { role = "fixed", material = Enum.Material.Metal })
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.1, 0.8, 0.9), CFrame.new(side * 0.75 * headS, top + 0.25, 0.1) * CFrame.Angles(0, 0, side * -0.4), rgb(245, 245, 250), { role = "fixed" })
		end
	end
	if acc.spartan_helmet then
		b:box(Vector3.new(1.35, 1.3, 1.35) * headS, CFrame.new(0, headY + 0.1, 0), rgb(200, 160, 70), { role = "fixed", material = Enum.Material.Metal })
		b:box(Vector3.new(0.9, 0.18, 0.06), CFrame.new(0, headY + 0.1, -0.69 * headS), rgb(20, 20, 20), { role = "fixed" })
		b:box(Vector3.new(0.2, 0.5, 0.06), CFrame.new(0, headY - 0.15, -0.69 * headS), rgb(20, 20, 20), { role = "fixed" })
		b:box(Vector3.new(0.2, 0.55, 1.7), CFrame.new(0, top + 0.35, 0.05), rgb(180, 30, 30), { role = "accent", material = Enum.Material.Fabric })
	end
	if acc.bull_head then
		b:box(Vector3.new(0.8, 0.6, 0.7), CFrame.new(0, headY - 0.15, -0.8), Kit.darker(skin, 0.1), { role = "fixed" })
		b:box(Vector3.new(0.5, 0.12, 0.08), CFrame.new(0, headY - 0.2, -1.17), rgb(30, 20, 15), { role = "fixed" })
		for _, side in { -1, 1 } do
			b:part("wedge", Vector3.new(0.25, 1.0, 0.3), CFrame.new(side * 0.85 * headS, top + 0.2, 0) * CFrame.Angles(0, 0, side * -1.0), rgb(240, 235, 220), { role = "fixed" })
		end
	end
	if acc.ice_crown then
		for k = 0, 6 do
			local a = k / 7 * math.pi * 2
			b:part("wedge", Vector3.new(0.18, 0.7, 0.15), CFrame.new(math.cos(a) * 0.5, top + 0.35, math.sin(a) * 0.5) * CFrame.Angles(0, -a, 0), rgb(190, 240, 255), { role = "fixed", material = Enum.Material.Ice })
		end
	end
	if acc.cap then
		b:part("ball", Vector3.new(1.4, 0.8, 1.4) * headS, CFrame.new(0, top - 0.05, 0), o.accent or rgb(250, 140, 30), { role = "accent" })
		b:box(Vector3.new(1.2, 0.12, 0.7), CFrame.new(0, top - 0.25, -0.85), o.accent or rgb(250, 140, 30), { role = "accent" })
	end
	if acc.mustache_big then
		b:box(Vector3.new(0.95, 0.22, 0.14), CFrame.new(0, headY - 0.2, -0.66), o.hair or rgb(70, 40, 20), { role = "fixed" })
		b:ball(0.32, CFrame.new(0, headY - 0.02, -0.72), Kit.darker(skin, 0.05), { role = "fixed" })
	end
	if acc.noob_smile then
		b:box(Vector3.new(0.5, 0.08, 0.05), CFrame.new(0, headY - 0.3, -0.61), rgb(20, 20, 20), { role = "fixed" })
		for _, side in { -1, 1 } do
			b:box(Vector3.new(0.08, 0.15, 0.05), CFrame.new(side * 0.26, headY - 0.24, -0.61), rgb(20, 20, 20), { role = "fixed" })
		end
	end
	if acc.brow then
		b:box(Vector3.new(1.25, 0.2, 0.25) * headS, CFrame.new(0, headY + 0.32 * headS, -0.55 * headS), Kit.darker(skin, 0.15), { role = "fixed" })
	end
	R:group(hm, torso, Vector3.new(0, hipY + torsoH, 0), { kind = "head", axis = "Y", amp = 0.15, speed = 0.4 })
	R:setMouth(head, Vector3.new(0, -0.2, -0.7 * headS))

	-- acessórios do corpo ----------------------------------------------------
	local back = 0.5 * bulk + 0.05
	if acc.cape or acc.cape_red or acc.cape_vampire then
		local m = R:mark()
		local col = if acc.cape then (o.cape or rgb(200, 25, 35)) elseif acc.cape_red then rgb(200, 25, 35) else rgb(25, 20, 30)
		b:box(Vector3.new(2.1 * bulk, 3.6, 0.12), CFrame.new(0, shoulderY - 1.7, back + 0.1), col, { role = "fixed", name = "Capa" })
		if acc.cape_vampire then
			b:box(Vector3.new(2.0 * bulk, 3.5, 0.05), CFrame.new(0, shoulderY - 1.7, back + 0.03), o.accent or rgb(170, 20, 30), { role = "accent" })
		end
		R:group(m, torso, Vector3.new(0, shoulderY, back), { kind = "cape", axis = "X", amp = 0.25, speed = 0.8 })
	end
	if acc.collar then
		b:part("wedge", Vector3.new(2.2, 0.9, 0.3), CFrame.new(0, shoulderY + 0.4, back + 0.15), rgb(25, 20, 30), { role = "fixed" })
	end
	if acc.emblem then
		b:box(Vector3.new(0.9, 0.9, 0.08), CFrame.new(0, torsoY + 0.2, -0.54 * bulk) * CFrame.Angles(0, 0, math.rad(45)), accent, { role = "accent" })
	end
	if acc.badge then
		b:box(Vector3.new(0.35, 0.4, 0.06), CFrame.new(-0.5, torsoY + 0.45, -0.53), accent, { role = "fixed", material = Enum.Material.Foil })
	end
	if acc.vest or acc.fur_vest or acc.vest_army then
		local vc = if acc.fur_vest then rgb(150, 120, 90) elseif acc.vest_army then rgb(60, 70, 45) else (o.accent or rgb(120, 40, 40))
		b:box(Vector3.new(2.1 * bulk, 1.9, 1.1 * bulk), CFrame.new(0, torsoY, 0), vc, { role = "secondary", material = if acc.fur_vest then Enum.Material.Fabric else Enum.Material.SmoothPlastic })
		b:box(Vector3.new(0.5, 1.92, 1.12 * bulk), CFrame.new(0, torsoY, 0), shirt, { role = "primary" })
	end
	if acc.belt then
		b:box(Vector3.new(2.05 * bulk, 0.3, 1.05 * bulk), CFrame.new(0, hipY + 0.25, 0), rgb(20, 20, 20), { role = "fixed" })
		b:box(Vector3.new(0.45, 0.32, 1.07 * bulk), CFrame.new(0, hipY + 0.25, 0), rgb(255, 205, 50), { role = "fixed", material = Enum.Material.Foil })
	end
	if acc.trim or acc.ermine then
		b:box(Vector3.new(2.1 * bulk, 0.3, 1.1 * bulk), CFrame.new(0, hipY + 0.05, 0), rgb(250, 250, 250), { role = "fixed", material = Enum.Material.Fabric })
		b:box(Vector3.new(0.3, 2, 1.1 * bulk), CFrame.new(0, torsoY, -0.02), rgb(250, 250, 250), { role = "fixed", material = Enum.Material.Fabric })
	end
	if acc.coat then
		b:box(Vector3.new(2.15 * bulk, 3, 1.1 * bulk), CFrame.new(0, hipY + 0.5, 0), rgb(245, 245, 250), { role = "fixed" })
	end
	if acc.stethoscope then
		b:box(Vector3.new(0.1, 1.0, 0.1), CFrame.new(0.3, torsoY + 0.3, -0.55), rgb(40, 40, 50), { role = "fixed" })
		b:ball(0.25, CFrame.new(0.3, torsoY - 0.25, -0.6), rgb(190, 190, 200), { role = "fixed", material = Enum.Material.Metal })
	end
	if acc.cross then
		b:box(Vector3.new(0.5, 0.15, 0.06), CFrame.new(-0.5, torsoY + 0.45, -0.58), rgb(220, 30, 40), { role = "fixed" })
		b:box(Vector3.new(0.15, 0.5, 0.06), CFrame.new(-0.5, torsoY + 0.45, -0.58), rgb(220, 30, 40), { role = "fixed" })
	end
	if acc.apron then
		b:box(Vector3.new(1.7, 2.6, 0.08), CFrame.new(0, hipY + 0.3, -0.54), rgb(250, 250, 250), { role = "fixed" })
	end
	if acc.ruffle then
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			b:ball(0.55, CFrame.new(math.cos(a) * 0.8, hipY + torsoH + 0.05, math.sin(a) * 0.5), rgb(250, 250, 250), { role = "fixed" })
		end
	end
	if acc.collar_green then
		b:box(Vector3.new(0.8, 0.25, 0.08), CFrame.new(0, shoulderY + 0.05, -0.54), accent, { role = "accent" })
		b:box(Vector3.new(2.02 * bulk, 0.25, 1.02 * bulk), CFrame.new(0, hipY + 0.1, 0), accent, { role = "accent" })
	end
	if acc.stripes then
		for _, y in { torsoY - 0.4, hipY - 0.6 } do
			b:box(Vector3.new(2.06 * bulk, 0.18, 1.06 * bulk), CFrame.new(0, y, 0), accent, { role = "fixed", material = Enum.Material.Neon })
		end
	end
	if acc.ribs then
		for k = 0, 3 do
			b:box(Vector3.new(1.9, 0.14, 0.15), CFrame.new(0, torsoY + 0.6 - k * 0.38, -0.5), rgb(30, 30, 30), { role = "fixed" })
		end
	end
	if acc.bandages then
		for k = 0, 6 do
			b:box(Vector3.new(2.05 * bulk, 0.1, 1.05 * bulk), CFrame.new(0, 0.4 + k * 0.6, 0) * CFrame.Angles(0, 0, math.rad(if k % 2 == 0 then 6 else -6)), rgb(180, 165, 130), { role = "fixed" })
		end
	end
	if acc.torn then
		b:box(Vector3.new(0.6, 0.5, 0.06), CFrame.new(0.4, torsoY - 0.3, -0.53), skin, { role = "fixed" })
		b:box(Vector3.new(0.5, 0.4, 0.06), CFrame.new(-0.5, hipY - 0.8, -0.5), skin, { role = "fixed" })
	end
	if acc.runes then
		for k = 0, 2 do
			b:box(Vector3.new(0.5, 0.12, 0.06), CFrame.new(0, torsoY + 0.4 - k * 0.4, -0.52 * bulk), rgb(90, 220, 255), { role = "accent", material = Enum.Material.Neon })
		end
	end
	if acc.moss then
		b:box(Vector3.new(1.2, 0.3, 1.1), CFrame.new(-0.6 * bulk, shoulderY + 0.25, 0), rgb(80, 140, 60), { role = "fixed", material = Enum.Material.Grass })
	end
	if acc.belly then
		b:ball(2.0, CFrame.new(0, torsoY - 0.3, -0.45), o.skin or skin, { role = "fixed" })
	end
	if acc.loincloth then
		b:box(Vector3.new(2.0 * bulk, 0.9, 1.1 * bulk), CFrame.new(0, hipY - 0.2, 0), rgb(120, 80, 45), { role = "fixed" })
	end
	if acc.leaves then
		for k = 0, 4 do
			local a = k / 5 * math.pi * 2
			b:part("wedge", Vector3.new(0.5, 0.8, 0.3), CFrame.new(math.cos(a) * 0.9, hipY - 0.2, math.sin(a) * 0.5) * CFrame.Angles(math.rad(180), a, 0), rgb(60, 160, 60), { role = "fixed", material = Enum.Material.Grass })
		end
	end
	if acc.flower then
		b:ball(0.4, CFrame.new(0.5, top, -0.2), rgb(255, 120, 180), { role = "accent", material = Enum.Material.Neon })
	end
	if acc.backpack then
		b:box(Vector3.new(1.6 * bulk, 1.8, 0.8), CFrame.new(0, torsoY, back + 0.4), rgb(200, 200, 210), { role = "fixed" })
	end
	if acc.flag_patch then
		b:box(Vector3.new(0.5, 0.35, 0.05), CFrame.new(-0.6 * bulk, torsoY + 0.5, -0.54 * bulk), rgb(40, 160, 70), { role = "fixed" })
		b:box(Vector3.new(0.25, 0.18, 0.06), CFrame.new(-0.6 * bulk, torsoY + 0.5, -0.55 * bulk), rgb(255, 220, 40), { role = "fixed" })
	end
	if acc.dress or o.robe then
		local col = o.robe or shirt
		b:part("cyl", Vector3.new(2.3, 2.6 * bulk, 2.6 * bulk), CFrame.new(0, 1.15, 0) * CFrame.Angles(0, 0, math.rad(90)), col, { role = "primary" })
		b:part("cyl", Vector3.new(1, 2.2 * bulk, 2.2 * bulk), CFrame.new(0, 2.4, 0) * CFrame.Angles(0, 0, math.rad(90)), col, { role = "primary" })
	end

	if acc.gi_belt then
		b:box(Vector3.new(2.05 * bulk, 0.3, 1.05 * bulk), CFrame.new(0, hipY + 0.2, 0), o.accent or rgb(30, 120, 140), { role = "accent" })
		b:box(Vector3.new(0.25, 0.7, 0.1), CFrame.new(0.4, hipY - 0.2, -0.54 * bulk), o.accent or rgb(30, 120, 140), { role = "accent" })
		b:part("wedge", Vector3.new(2.0 * bulk, 1.0, 0.1), CFrame.new(0, torsoY + 0.4, -0.53 * bulk) * CFrame.Angles(0, 0, 0), Kit.darker(shirt, 0.08), { role = "fixed" })
	end
	if acc.scarf then
		local m = R:mark()
		b:box(Vector3.new(1.5, 0.35, 1.2), CFrame.new(0, shoulderY + 0.1, 0), o.accent or rgb(200, 40, 50), { role = "accent", material = Enum.Material.Fabric })
		b:box(Vector3.new(0.35, 0.2, 1.8), CFrame.new(0.4, shoulderY - 0.05, back + 0.9), o.accent or rgb(200, 40, 50), { role = "accent", material = Enum.Material.Fabric })
		R:group(m, torso, Vector3.new(0.4, shoulderY, back), { kind = "cape", axis = "Y", amp = 0.35, speed = 1.3 })
	end
	if acc.boots then
		for _, side in { -1, 1 } do
			b:box(Vector3.new(1.02 * bulk, 0.9, 1.05 * bulk), CFrame.new(side * 0.5 * bulk, 0.45, 0), o.shoes or rgb(200, 30, 40), { role = "accent" })
		end
	end
	if acc.spider_lines then
		for k = 0, 2 do
			b:box(Vector3.new(2.04 * bulk, 0.05, 1.04 * bulk), CFrame.new(0, torsoY + 0.6 - k * 0.6, 0), o.accent or rgb(240, 240, 245), { role = "fixed" })
		end
	end
	if acc.emblem_spider then
		b:ball(0.45, CFrame.new(0, torsoY + 0.25, -0.55 * bulk), rgb(15, 15, 20), { role = "fixed" })
		for _, side in { -1, 1 } do
			for k = -1, 1 do
				b:box(Vector3.new(0.5, 0.06, 0.05), CFrame.new(side * 0.35, torsoY + 0.25 + k * 0.15, -0.57 * bulk) * CFrame.Angles(0, 0, side * k * 0.5), rgb(15, 15, 20), { role = "fixed" })
			end
		end
	end
	if acc.chest_core then
		local core = b:part("cyl", Vector3.new(0.1, 0.6, 0.6), CFrame.new(0, torsoY + 0.35, -0.53 * bulk) * CFrame.Angles(0, math.rad(90), 0), o.accent or rgb(80, 220, 255), { role = "accent", material = Enum.Material.Neon })
		b:light(core, o.accent or rgb(80, 220, 255), 10, 2)
	end
	if acc.torn_shorts then
		b:box(Vector3.new(2.1 * bulk, 1.1, 1.1 * bulk), CFrame.new(0, hipY - 0.35, 0), o.pants, { role = "secondary", material = Enum.Material.Fabric })
	end
	if acc.overalls then
		b:box(Vector3.new(2.05 * bulk, 1.4, 1.05 * bulk), CFrame.new(0, hipY + 0.5, 0), o.pants, { role = "secondary" })
		for _, side in { -1, 1 } do
			b:box(Vector3.new(0.3, 1.0, 0.06), CFrame.new(side * 0.55, torsoY + 0.4, -0.54 * bulk), o.pants, { role = "secondary" })
			b:ball(0.2, CFrame.new(side * 0.55, torsoY + 0.1, -0.57 * bulk), rgb(250, 220, 60), { role = "fixed" })
		end
	end
	if acc.robe_stole then
		b:box(Vector3.new(0.5, 3.4, 0.08), CFrame.new(0.35, hipY + 0.2, -0.56 * bulk) * CFrame.Angles(0, 0, math.rad(12)), o.accent or rgb(170, 40, 45), { role = "accent", material = Enum.Material.Fabric })
		b:box(Vector3.new(2.3 * bulk, 0.25, 1.1 * bulk), CFrame.new(0, hipY + 0.3, 0), rgb(200, 180, 140), { role = "fixed", material = Enum.Material.Fabric })
	end
	if acc.big_shield then
		local lh = arms[1] or torso
		local m = R:mark()
		local x = -1.5 * bulk - 0.5
		for k, d in { 2.4, 1.7, 1.0, 0.45 } do
			b:part("cyl", Vector3.new(0.25 + k * 0.02, d, d), CFrame.new(x - k * 0.02, shoulderY - 1.3, -0.2), if k % 2 == 1 then (o.shirt) else (o.accent or rgb(240, 240, 240)), { role = "fixed", material = Enum.Material.Metal })
		end
		R:group(m, lh)
	end

	-- asas e cauda -----------------------------------------------------------
	if acc.wings_bat or acc.wings_feather or acc.wings_fairy then
		for _, side in { -1, 1 } do
			local m = R:mark()
			local col = if acc.wings_bat then rgb(60, 20, 25) elseif acc.wings_fairy then rgb(200, 240, 255) else rgb(250, 250, 255)
			local matW = if acc.wings_fairy then Enum.Material.Glass else Enum.Material.SmoothPlastic
			local span = if acc.wings_fairy then 2.2 else 3.2
			b:part("wedge", Vector3.new(0.1, 2.4, span), CFrame.new(side * (0.6 + span / 2), shoulderY - 0.4, back + 0.3) * CFrame.Angles(0, side * math.rad(90), 0), col, { role = "fixed", material = matW, transparency = if acc.wings_fairy then 0.35 else 0 })
			b:part("wedge", Vector3.new(0.1, 1.2, span * 0.8), CFrame.new(side * (0.6 + span * 0.4), shoulderY - 1.6, back + 0.3) * CFrame.Angles(math.rad(180), side * math.rad(90), 0), col, { role = "fixed", material = matW, transparency = if acc.wings_fairy then 0.35 else 0 })
			R:group(m, torso, Vector3.new(side * 0.5, shoulderY - 0.4, back), { kind = "wing", axis = "Y", amp = 0.45, phase = if side < 0 then 0 else math.pi, speed = if acc.wings_fairy then 3 else 1.2 })
		end
	end
	if acc.tail_demon then
		local m = R:mark()
		b:beam(Vector3.new(0, hipY + 0.2, back), Vector3.new(0, hipY - 0.6, back + 2), 0.2, skin, { role = "fixed" })
		b:part("wedge", Vector3.new(0.1, 0.5, 0.5), CFrame.new(0, hipY - 0.6, back + 2.2), skin, { role = "fixed" })
		R:group(m, torso, Vector3.new(0, hipY + 0.2, back), { kind = "tail", axis = "Y", amp = 0.5 })
	end

	-- itens nas mãos ---------------------------------------------------------
	local rh = arms[2] or torso
	local hand = rightHand
	local function inHand(fn: () -> ())
		local m = R:mark()
		fn()
		local g = R:group(m, rh)
		return g
	end
	if acc.sword or acc.katana_back or acc.cutlass or acc.dagger then
		inHand(function()
			local len = if acc.dagger then 1.2 elseif acc.cutlass then 2.4 else 3.2
			local cf = if acc.katana_back then CFrame.new(0, torsoY + 0.3, back + 0.15) * CFrame.Angles(0, 0, math.rad(40)) else CFrame.new(hand) * CFrame.new(0, 0, -len / 2)
			b:box(Vector3.new(0.18, 0.4, len), cf, rgb(220, 225, 235), { role = "accent", material = Enum.Material.Metal })
			b:box(Vector3.new(0.9, 0.18, 0.2), cf * CFrame.new(0, 0, len / 2), rgb(120, 90, 40), { role = "fixed" })
		end)
	end
	if acc.shield or acc.round_shield then
		local lh = arms[1] or torso
		local m = R:mark()
		local x = -1.5 * bulk - 0.5
		if acc.round_shield then
			b:part("cyl", Vector3.new(0.25, 2.2, 2.2), CFrame.new(x, shoulderY - 1.4, -0.2), rgb(150, 90, 50), { role = "fixed", material = Enum.Material.WoodPlanks })
			b:part("cyl", Vector3.new(0.3, 0.6, 0.6), CFrame.new(x - 0.05, shoulderY - 1.4, -0.2), rgb(170, 170, 180), { role = "fixed", material = Enum.Material.Metal })
		else
			b:box(Vector3.new(0.25, 2.2, 1.7), CFrame.new(x, shoulderY - 1.4, -0.2), rgb(40, 70, 160), { role = "accent" })
			b:box(Vector3.new(0.3, 1.2, 0.3), CFrame.new(x - 0.03, shoulderY - 1.4, -0.2), rgb(255, 210, 50), { role = "fixed" })
		end
		R:group(m, lh)
	end
	if acc.staff or acc.scepter or acc.trident then
		inHand(function()
			local len = if acc.scepter then 2.2 else 4.5
			b:part("cyl", Vector3.new(len, 0.25, 0.25), CFrame.new(hand + Vector3.new(0, len / 2 - 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), rgb(120, 80, 40), { role = "fixed" })
			if acc.trident then
				for k = -1, 1 do
					b:part("wedge", Vector3.new(0.12, 0.8, 0.2), CFrame.new(hand + Vector3.new(k * 0.35, len - 0.2, 0)), rgb(30, 30, 30), { role = "fixed" })
				end
			else
				b:ball(0.7, CFrame.new(hand + Vector3.new(0, len - 0.4, 0)), accent, { role = "accent", material = Enum.Material.Neon })
			end
		end)
	end
	if acc.pistol or acc.raygun or acc.rifle or acc.extinguisher then
		inHand(function()
			if acc.extinguisher then
				b:cylY(1.4, 0.6, CFrame.new(hand + Vector3.new(0, 0.1, -0.3)), rgb(220, 30, 30), { role = "fixed" })
			else
				local len = if acc.rifle then 2.6 else 1.1
				local col = if acc.raygun then rgb(120, 230, 255) else rgb(40, 40, 45)
				b:box(Vector3.new(0.25, 0.35, len), CFrame.new(hand + Vector3.new(0, 0.1, -len / 2)), col, { role = if acc.raygun then "accent" else "fixed", material = if acc.raygun then Enum.Material.Neon else Enum.Material.Metal })
			end
		end)
	end
	if acc.club or acc.axe then
		inHand(function()
			b:part("cyl", Vector3.new(3, 0.35, 0.35), CFrame.new(hand + Vector3.new(0, 0.6, -0.4)) * CFrame.Angles(0, 0, math.rad(90)), rgb(110, 75, 40), { role = "fixed", material = Enum.Material.Wood })
			if acc.axe then
				b:part("wedge", Vector3.new(0.15, 0.9, 1), CFrame.new(hand + Vector3.new(0, 1.8, -0.9)), rgb(190, 190, 200), { role = "fixed", material = Enum.Material.Metal })
			else
				b:ball(1.1, CFrame.new(hand + Vector3.new(0, 2.1, -0.4)), rgb(110, 75, 40), { role = "fixed", material = Enum.Material.Wood })
			end
		end)
	end
	if acc.hammer_hand then
		inHand(function()
			b:part("cyl", Vector3.new(2.4, 0.3, 0.3), CFrame.new(hand + Vector3.new(0, 0.5, -0.3)) * CFrame.Angles(0, 0, math.rad(90)), rgb(110, 75, 40), { role = "fixed", material = Enum.Material.Wood })
			b:box(Vector3.new(1.6, 1.0, 1.0), CFrame.new(hand + Vector3.new(0, 1.8, -0.3)), rgb(160, 165, 175), { role = "fixed", material = Enum.Material.Metal })
		end)
	end
	if acc.spear then
		inHand(function()
			b:part("cyl", Vector3.new(5, 0.22, 0.22), CFrame.new(hand + Vector3.new(0, 1.6, -0.2)) * CFrame.Angles(0, 0, math.rad(90)), rgb(110, 75, 40), { role = "fixed", material = Enum.Material.Wood })
			b:part("wedge", Vector3.new(0.15, 0.8, 0.35), CFrame.new(hand + Vector3.new(0, 4.4, -0.2)), rgb(200, 205, 215), { role = "fixed", material = Enum.Material.Metal })
		end)
	end
	if acc.flask then
		inHand(function()
			b:ball(0.6, CFrame.new(hand + Vector3.new(0, 0.2, -0.2)), rgb(120, 255, 90), { role = "accent", material = Enum.Material.Neon, transparency = 0.2 })
		end)
	end
	if acc.broom then
		local m = R:mark()
		b:part("cyl", Vector3.new(4, 0.22, 0.22), CFrame.new(0, hipY - 0.3, 0) * CFrame.Angles(0, math.rad(90), 0), rgb(120, 80, 40), { role = "fixed" })
		b:part("cyl", Vector3.new(1, 0.8, 0.8), CFrame.new(0, hipY - 0.3, 2.2) * CFrame.Angles(0, math.rad(90), 0), rgb(200, 170, 90), { role = "fixed" })
		R:group(m, torso)
	end

	if o.glow then
		local l = b:light(torso, o.glow, 16, 1.4)
		l.Name = "Brilho"
	end
	local result = R:finish({
		hp = params.hp or 100,
		speed = params.speed or 16,
		hipHeight = legH,
		height = headY + 0.6 * headS,
		radius = 1.2 * bulk,
		flying = params.fly == true,
	})
	return result
end

Figures.Outfits = OUTFITS

return Figures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Fusion</string>
            <string name="Source"><![CDATA[--!strict
-- Híbridos: "gato tubarão" = corpo de gato com cabeça de tubarão; "macaco
-- pizza" = macaco com uma pizza no lugar da cabeça; "crocodilo avião" = avião
-- com cabeça de crocodilo. A cabeça (ou o objeto inteiro) do segundo é
-- reconstruída, escalada e soldada no lugar da cabeça do primeiro.

local Fusion = {}

local function vmin(a: Vector3, b: Vector3): Vector3
	return Vector3.new(math.min(a.X, b.X), math.min(a.Y, b.Y), math.min(a.Z, b.Z))
end

local function vmax(a: Vector3, b: Vector3): Vector3
	return Vector3.new(math.max(a.X, b.X), math.max(a.Y, b.Y), math.max(a.Z, b.Z))
end

-- cabeça + tudo que está soldado diretamente nela (olhos, chapéu, chifres...)
function Fusion.headGroup(model: Instance, head: BasePart): { BasePart }
	local parts = { head }
	for _, d in model:GetDescendants() do
		if d:IsA("WeldConstraint") and d.Part0 == head and d.Part1 and d.Part1 ~= head then
			table.insert(parts, d.Part1 :: BasePart)
		end
	end
	return parts
end

function Fusion.bounds(parts: { BasePart }): (Vector3, Vector3)
	local lo = Vector3.new(math.huge, math.huge, math.huge)
	local hi = -lo
	for _, p in parts do
		local r = p.Size / 2
		local ext = Vector3.new(r.Magnitude, r.Magnitude, r.Magnitude) * 0.8
		lo = vmin(lo, p.Position - ext)
		hi = vmax(hi, p.Position + ext)
	end
	return (lo + hi) / 2, hi - lo
end

-- move e escala um conjunto de partes para caber em `size` centrado em `at`
function Fusion.fit(parts: { BasePart }, at: CFrame, maxSize: number)
	local center, size = Fusion.bounds(parts)
	local biggest = math.max(size.X, size.Y, size.Z, 0.1)
	local k = math.clamp(maxSize / biggest, 0.05, 20)
	for _, p in parts do
		local rel = CFrame.new(center):ToObjectSpace(p.CFrame)
		p.Size = p.Size * k
		p.CFrame = at * (CFrame.new(rel.Position * k) * rel.Rotation)
	end
end

-- solda as partes transplantadas em `anchor` (sem física própria)
function Fusion.attach(parts: { BasePart }, anchor: BasePart, model: Model)
	for _, p in parts do
		for _, j in p:GetChildren() do
			if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
				j:Destroy()
			end
		end
		p.Anchored = anchor.Anchored
		p.CanCollide = false
		p.Massless = true
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = anchor
		w.Part1 = p
		w.Parent = p
	end
end

-- esconde a cabeça original (mantém a parte que segura a junta animada)
function Fusion.hideHead(model: Instance, head: BasePart)
	for _, p in Fusion.headGroup(model, head) do
		if p == head then
			p.Transparency = 1
			p.CanCollide = false
		else
			p:Destroy()
		end
	end
	for _, d in head:GetChildren() do
		if d:IsA("ParticleEmitter") or d:IsA("PointLight") then
			d:Destroy()
		end
	end
end

-- Constrói a "cabeça" do segundo conceito. builders = { creature = fn, prop = fn }
function Fusion.makeHead(fh: any, params: { [string]: any }, builders: any): ({ BasePart }, Instance?)
	local origin = CFrame.new(0, -500, 0)
	if fh.category == "creature" then
		local ok, rig = pcall(builders.creature, origin, {
			model = fh.model,
			variant = fh.variant,
			size = fh.size or 1,
			scale = 1,
			rng = params.rng,
			element = fh.element,
			faction = params.faction,
		})
		if not ok or not rig then
			return {}, nil
		end
		local head = rig.head or rig.root
		local parts = Fusion.headGroup(rig.model, head)
		if head == rig.root or #parts <= 1 then
			-- criaturas sem cabeça separada (peixes, slimes): usa o corpo visível
			parts = {}
			for _, d in rig.model:GetDescendants() do
				if d:IsA("BasePart") and d ~= rig.root and d.Transparency < 1 then
					table.insert(parts, d)
				end
			end
		end
		return parts, rig.model
	end
	local ok, r = pcall(builders.prop, origin, { model = fh.model, variant = fh.variant, scale = 1, anchored = false })
	if not ok or not r then
		return {}, nil
	end
	local parts = {}
	for _, d in r.model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 then
			table.insert(parts, d)
		end
	end
	return parts, r.model
end

-- Aplica o híbrido num rig já montado (corpo = base). Retorna true se deu certo.
function Fusion.ontoRig(rig: any, fh: any, params: { [string]: any }, builders: any): boolean
	local head: BasePart? = rig.head
	if not head or head == rig.root then
		return false
	end
	local parts, leftover = Fusion.makeHead(fh, params, builders)
	if #parts == 0 then
		if leftover then
			leftover:Destroy()
		end
		return false
	end
	local _, headSize = Fusion.bounds(Fusion.headGroup(rig.model, head))
	local target = math.max(headSize.X, headSize.Y, headSize.Z) * (if fh.category == "creature" then 1.25 else 1.5)
	local at = head.CFrame * CFrame.new(0, headSize.Y * 0.12, 0)
	Fusion.hideHead(rig.model, head)
	Fusion.fit(parts, at, math.max(target, 1.2))
	Fusion.attach(parts, head, rig.model)
	if leftover then
		leftover:Destroy()
	end
	rig.model:SetAttribute("Hibrido", fh.id)
	return true
end

-- Cabeça de criatura como "carranca" na frente de um veículo
function Fusion.ontoVehicle(model: Model, fh: any, params: { [string]: any }, builders: any): boolean
	local main = model.PrimaryPart
	if not main then
		return false
	end
	local parts, leftover = Fusion.makeHead(fh, params, builders)
	if #parts == 0 then
		if leftover then
			leftover:Destroy()
		end
		return false
	end
	local all = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and not table.find(parts, d) then
			table.insert(all, d)
		end
	end
	local center, size = Fusion.bounds(all)
	local front = main.CFrame.LookVector
	local at = CFrame.lookAt(center + front * (size.Z * 0.42) + Vector3.new(0, size.Y * 0.35, 0), center + front * size.Z)
	Fusion.fit(parts, at, math.max(size.Y * 0.9, 3))
	Fusion.attach(parts, main, model)
	if leftover then
		leftover:Destroy()
	end
	model:SetAttribute("Hibrido", fh.id)
	return true
end

return Fusion
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!strict
-- Kit de construção procedural.
-- Um "Builder" monta um Model em coordenadas locais (unidade = 1 stud na escala 1)
-- e aplica escala, posição de origem e modificadores (cor, material, elemento).
-- Papéis (role) das partes permitem que modificadores alterem só o que faz sentido:
--   primary/secondary = corpo; accent = detalhes coloridos; eye/glow = olhos e luzes;
--   fixed = nunca muda (ex.: dentes, rodas).

local Config = require(game:GetService("ReplicatedStorage").IdeiasShared.Config)

local Kit = {}

export type PartOpts = {
	role: string?,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?,
	name: string?,
	shadow: boolean?,
	parent: Instance?,
}

-- Materiais dos modificadores ----------------------------------------------
Kit.MaterialPresets = {
	gold = { material = Enum.Material.Foil, color = Color3.fromRGB(255, 196, 38), reflect = 0.25 },
	diamond = { material = Enum.Material.Glass, color = Color3.fromRGB(160, 235, 255), reflect = 0.4, transparency = 0.15 },
	crystal = { material = Enum.Material.Glass, color = Color3.fromRGB(196, 140, 255), reflect = 0.2, transparency = 0.2 },
	metal = { material = Enum.Material.DiamondPlate, color = Color3.fromRGB(140, 146, 158) },
	wood = { material = Enum.Material.WoodPlanks, color = Color3.fromRGB(150, 103, 62) },
	stone = { material = Enum.Material.Slate, color = Color3.fromRGB(118, 118, 124) },
	glass = { material = Enum.Material.Glass, color = Color3.fromRGB(200, 230, 255), transparency = 0.45 },
	candy = { material = Enum.Material.SmoothPlastic, color = Color3.fromRGB(255, 140, 200) },
	jelly = { material = Enum.Material.Glass, color = Color3.fromRGB(110, 230, 120), transparency = 0.35 },
	toy = { material = Enum.Material.SmoothPlastic, color = nil },
	neon = { material = Enum.Material.Neon, color = nil },
	chocolate = { material = Enum.Material.SmoothPlastic, color = Color3.fromRGB(92, 52, 30) },
	ice = { material = Enum.Material.Ice, color = Color3.fromRGB(170, 225, 255), transparency = 0.1 },
	lava = { material = Enum.Material.CrackedLava, color = Color3.fromRGB(255, 90, 20) },
}

-- Elementos: cores e efeitos -------------------------------------------------
Kit.Elements = {
	fire = { color = Color3.fromRGB(255, 120, 30), color2 = Color3.fromRGB(255, 220, 80), light = Color3.fromRGB(255, 140, 50), tint = Color3.fromRGB(200, 70, 30) },
	ice = { color = Color3.fromRGB(140, 220, 255), color2 = Color3.fromRGB(255, 255, 255), light = Color3.fromRGB(150, 220, 255), tint = Color3.fromRGB(120, 200, 245) },
	electric = { color = Color3.fromRGB(255, 240, 80), color2 = Color3.fromRGB(120, 200, 255), light = Color3.fromRGB(255, 245, 140), tint = Color3.fromRGB(240, 220, 60) },
	poison = { color = Color3.fromRGB(120, 230, 60), color2 = Color3.fromRGB(180, 80, 220), light = Color3.fromRGB(130, 255, 90), tint = Color3.fromRGB(90, 170, 50) },
	water = { color = Color3.fromRGB(60, 150, 255), color2 = Color3.fromRGB(200, 240, 255), light = Color3.fromRGB(90, 170, 255), tint = Color3.fromRGB(50, 120, 220) },
	shadow = { color = Color3.fromRGB(90, 40, 140), color2 = Color3.fromRGB(20, 10, 30), light = Color3.fromRGB(150, 70, 220), tint = Color3.fromRGB(45, 30, 70) },
	light = { color = Color3.fromRGB(255, 245, 190), color2 = Color3.fromRGB(255, 210, 90), light = Color3.fromRGB(255, 240, 180), tint = Color3.fromRGB(250, 235, 170) },
	lava = { color = Color3.fromRGB(255, 80, 20), color2 = Color3.fromRGB(60, 20, 10), light = Color3.fromRGB(255, 110, 40), tint = Color3.fromRGB(150, 40, 20) },
	wind = { color = Color3.fromRGB(230, 245, 255), color2 = Color3.fromRGB(180, 210, 230), light = Color3.fromRGB(220, 240, 255), tint = Color3.fromRGB(200, 225, 240) },
	nature = { color = Color3.fromRGB(110, 200, 80), color2 = Color3.fromRGB(255, 200, 220), light = Color3.fromRGB(160, 255, 140), tint = Color3.fromRGB(80, 160, 60) },
	rainbow = { color = Color3.fromRGB(255, 80, 200), color2 = Color3.fromRGB(80, 220, 255), light = Color3.fromRGB(255, 200, 255), tint = Color3.fromRGB(255, 120, 220) },
}

Kit.RainbowColors = {
	Color3.fromRGB(255, 70, 70),
	Color3.fromRGB(255, 160, 50),
	Color3.fromRGB(255, 230, 60),
	Color3.fromRGB(80, 220, 90),
	Color3.fromRGB(70, 160, 255),
	Color3.fromRGB(150, 90, 255),
}

-- Builder ---------------------------------------------------------------------
local Builder = {}
Builder.__index = Builder

export type Builder = typeof(setmetatable(
	{} :: {
		model: Model,
		origin: CFrame,
		s: number,
		anchored: boolean,
		collide: boolean,
		params: { [string]: any },
		parts: { BasePart },
		roles: { [BasePart]: string },
		primary: Color3?,
	},
	Builder
))

function Kit.new(name: string, origin: CFrame, params: { [string]: any }?): Builder
	local model = Instance.new("Model")
	model.Name = name
	local p = params or {}
	local self = setmetatable({
		model = model,
		origin = origin,
		s = (p.scale or 1) * (p.size or 1),
		anchored = if p.anchored == nil then true else p.anchored,
		collide = if p.collide == nil then true else p.collide,
		params = p,
		parts = {},
		roles = {},
		primary = nil,
	}, Builder)
	return self
end

-- Converte posição/orientação locais (escala 1) em CFrame de mundo
function Builder.at(self: Builder, localCf: CFrame): CFrame
	local s = self.s
	return self.origin * (CFrame.new(localCf.Position * s) * localCf.Rotation)
end

local SHAPES = {
	block = Enum.PartType.Block,
	ball = Enum.PartType.Ball,
	cyl = Enum.PartType.Cylinder,
	wedge = "WedgePart",
	corner = "CornerWedgePart",
}

function Builder.part(self: Builder, shape: string, size: Vector3, localCf: CFrame, color: Color3, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	local kind = SHAPES[shape] or Enum.PartType.Block
	local part: BasePart
	-- No Roblox uma "Ball" usa sempre o MENOR eixo como diâmetro. Para elipsoides
	-- (corpos, cabeças, folhagens) usamos bloco + SpecialMesh esférico.
	local ellipsoid = shape == "ball" and (math.max(size.X, size.Y, size.Z) - math.min(size.X, size.Y, size.Z)) > 0.02
	if ellipsoid then
		kind = Enum.PartType.Block
	end
	if kind == "WedgePart" then
		part = Instance.new("WedgePart")
	elseif kind == "CornerWedgePart" then
		part = Instance.new("CornerWedgePart")
	else
		local p = Instance.new("Part")
		p.Shape = kind :: Enum.PartType
		part = p
	end
	local s = self.s
	part.Size = Vector3.new(math.max(size.X * s, 0.05), math.max(size.Y * s, 0.05), math.max(size.Z * s, 0.05))
	part.CFrame = self:at(localCf)
	part.Color = color
	part.Material = o.material or Enum.Material.SmoothPlastic
	part.Transparency = o.transparency or 0
	part.Reflectance = o.reflectance or 0
	part.Anchored = self.anchored
	local collide = if o.collide == nil then self.collide else o.collide
	part.CanCollide = collide
	part.CanTouch = false
	-- partes pequenas não fazem sombra (economia em celular)
	local volume = part.Size.X * part.Size.Y * part.Size.Z
	part.CastShadow = if o.shadow ~= nil then o.shadow else volume > 8
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Name = o.name or shape
	if ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	part.Parent = o.parent or self.model
	table.insert(self.parts, part)
	self.roles[part] = o.role or "primary"
	if (o.role or "primary") == "primary" and not self.primary then
		self.primary = color
	end
	return part
end

-- atalhos
function Builder.box(self: Builder, size: Vector3, localCf: CFrame, color: Color3, opts: PartOpts?): BasePart
	return self:part("block", size, localCf, color, opts)
end

function Builder.ball(self: Builder, diameter: number, localCf: CFrame, color: Color3, opts: PartOpts?): BasePart
	return self:part("ball", Vector3.new(diameter, diameter, diameter), localCf, color, opts)
end

-- Elipsoide: bola esticada (Ball só aceita diâmetro uniforme; usamos bloco com SpecialMesh não disponível
-- em todos os contextos, então aproximamos com bola + bloco arredondado)
function Builder.blob(self: Builder, size: Vector3, localCf: CFrame, color: Color3, opts: PartOpts?): BasePart
	local d = math.min(size.X, size.Y, size.Z)
	if math.max(size.X, size.Y, size.Z) - d < 0.15 then
		return self:ball(d, localCf, color, opts)
	end
	-- cilindro deitado no eixo maior + duas bolas nas pontas = cápsula
	local axis: string = "X"
	local long = size.X
	if size.Y > long then
		axis, long = "Y", size.Y
	end
	if size.Z > long then
		axis, long = "Z", size.Z
	end
	local thick = d
	local bodyLen = math.max(long - thick, 0.05)
	local rot = CFrame.identity
	if axis == "Y" then
		rot = CFrame.Angles(0, 0, math.rad(90))
	elseif axis == "Z" then
		rot = CFrame.Angles(0, math.rad(90), 0)
	end
	local main = self:part("cyl", Vector3.new(bodyLen, thick, thick), localCf * rot, color, opts)
	local dir = (rot.RightVector) * (bodyLen / 2)
	self:ball(thick, localCf * CFrame.new(dir), color, opts)
	self:ball(thick, localCf * CFrame.new(-dir), color, opts)
	return main
end

-- Cilindro em pé (eixo Y). No Roblox o eixo do Cylinder é X.
function Builder.cylY(self: Builder, height: number, diameter: number, localCf: CFrame, color: Color3, opts: PartOpts?): BasePart
	return self:part("cyl", Vector3.new(height, diameter, diameter), localCf * CFrame.Angles(0, 0, math.rad(90)), color, opts)
end

-- Segmento entre dois pontos locais (galhos, pernas, cabos)
function Builder.beam(self: Builder, a: Vector3, b: Vector3, thickness: number, color: Color3, opts: PartOpts?, round: boolean?): BasePart
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	local cf = CFrame.lookAt(mid, b)
	if round then
		return self:part("cyl", Vector3.new(len, thickness, thickness), cf * CFrame.Angles(0, math.rad(90), 0), color, opts)
	end
	return self:part("block", Vector3.new(thickness, thickness, len), cf, color, opts)
end

-- Cone aproximado por anéis de cilindros (telhados, chapéus, montanhas)
function Builder.cone(self: Builder, height: number, baseDiameter: number, localCf: CFrame, color: Color3, steps: number?, opts: PartOpts?): { BasePart }
	local n = steps or 4
	local out = {}
	for i = 0, n - 1 do
		local t = i / n
		local d = baseDiameter * (1 - t)
		local h = height / n
		table.insert(out, self:cylY(h, math.max(d, 0.2), localCf * CFrame.new(0, h * (i + 0.5), 0), color, opts))
	end
	return out
end

-- Telhado de duas águas com cunhas
function Builder.roof(self: Builder, width: number, depth: number, height: number, localCf: CFrame, color: Color3, opts: PartOpts?)
	local half = width / 2
	self:part("wedge", Vector3.new(depth, height, half), localCf * CFrame.new(half / 2, height / 2, 0) * CFrame.Angles(0, math.rad(90), 0), color, opts)
	self:part("wedge", Vector3.new(depth, height, half), localCf * CFrame.new(-half / 2, height / 2, 0) * CFrame.Angles(0, math.rad(-90), 0), color, opts)
end

function Builder.light(self: Builder, part: BasePart, color: Color3, range: number, brightness: number?)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = math.min(range * math.sqrt(self.s), 60)
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Parent = part
	return l
end

function Builder.attachment(self: Builder, part: BasePart, name: string, localPos: Vector3?): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = (localPos or Vector3.zero) * self.s
	a.Parent = part
	return a
end

-- Aplica modificadores visuais (cor, material, traço) às partes conforme o papel
function Builder.applyStyle(self: Builder)
	local p = self.params
	local mat = p.material and Kit.MaterialPresets[p.material]
	local color: Color3? = nil
	if type(p.color) == "table" then
		color = Color3.new(p.color[1], p.color[2], p.color[3])
	end
	local trait = p.trait
	local elem = p.element and Kit.Elements[p.element]
	local i = 0
	for _, part in self.parts do
		local role = self.roles[part]
		i += 1
		if role == "primary" or role == "secondary" then
			local base = part.Color
			if color then
				part.Color = if role == "primary" then color else color:Lerp(Color3.new(0, 0, 0), 0.35)
			end
			if trait == "undead" then
				part.Color = part.Color:Lerp(Color3.fromRGB(110, 150, 90), 0.55)
			elseif trait == "robotic" then
				part.Color = base:Lerp(Color3.fromRGB(150, 156, 168), 0.6)
			elseif trait == "ancient" or trait == "medieval" then
				part.Color = part.Color:Lerp(Color3.fromRGB(150, 140, 120), 0.45)
			end
			if elem and p.elementMod and p.element ~= "rainbow" and not color and not mat and not p.keepColor then
				part.Color = part.Color:Lerp(elem.tint, 0.45)
			end
			if p.element == "rainbow" and p.elementMod and not color then
				part.Color = Kit.RainbowColors[(i % #Kit.RainbowColors) + 1]
			end
			if mat then
				part.Material = mat.material
				if mat.color and not color then
					part.Color = if role == "primary" then mat.color else mat.color:Lerp(Color3.new(0, 0, 0), 0.25)
				end
				if mat.reflect then
					part.Reflectance = mat.reflect
				end
				if mat.transparency then
					part.Transparency = math.max(part.Transparency, mat.transparency)
				end
			end
			if trait == "ghostly" then
				part.Transparency = math.max(part.Transparency, 0.45)
				part.Material = Enum.Material.ForceField
			end
		elseif role == "accent" then
			if elem then
				part.Color = elem.color
				part.Material = Enum.Material.Neon
			elseif trait == "futuristic" or trait == "robotic" then
				part.Material = Enum.Material.Neon
			end
		elseif role == "eye" then
			if trait == "robotic" or trait == "futuristic" then
				part.Color = Color3.fromRGB(80, 230, 255)
				part.Material = Enum.Material.Neon
			elseif trait == "undead" then
				part.Color = Color3.fromRGB(190, 255, 120)
				part.Material = Enum.Material.Neon
			elseif elem and (p.faction == "hostile") then
				part.Color = elem.color
				part.Material = Enum.Material.Neon
			end
		end
	end
end

-- Efeitos de elemento (partículas + luz) presos a uma parte
function Kit.elementEffects(part: BasePart, element: string?, intensity: number?): { Instance }
	local out = {}
	if not element then
		return out
	end
	local e = Kit.Elements[element]
	if not e then
		return out
	end
	local k = intensity or 1
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Elemento"
	emitter.LightEmission = 0.6
	emitter.Rate = 10 * k
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6 * k), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	emitter.Color = ColorSequence.new(e.color, e.color2)
	if element == "fire" or element == "lava" then
		emitter.Texture = Config.Textures.Fire
		emitter.Acceleration = Vector3.new(0, 6, 0)
	elseif element == "poison" or element == "shadow" or element == "wind" then
		emitter.Texture = Config.Textures.Smoke
		emitter.Rate = 6 * k
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8 * k), NumberSequenceKeypoint.new(1, 2 * k) })
	else
		emitter.Texture = Config.Textures.Sparkle
	end
	emitter.Parent = part
	emitter:AddTag("IdeiasFx")
	table.insert(out, emitter)
	local light = Instance.new("PointLight")
	light.Color = e.light
	light.Range = 10 * math.min(k, 3)
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = part
	table.insert(out, light)
	return out
end

function Builder.finish(self: Builder, primaryPart: BasePart?): Model
	self:applyStyle()
	if primaryPart then
		self.model.PrimaryPart = primaryPart
	elseif self.parts[1] then
		self.model.PrimaryPart = self.parts[1]
	end
	self.model.WorldPivot = self.origin
	self.model:SetAttribute("PartCount", #self.parts)
	return self.model
end

-- Cores utilitárias
function Kit.rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

function Kit.darker(c: Color3, f: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), f)
end

function Kit.lighter(c: Color3, f: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), f)
end

-- Solda todas as partes não ancoradas de um modelo à parte raiz
function Kit.weldAll(model: Model, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root and not d:FindFirstChildWhichIsA("JointInstance") then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
end

return Kit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Memes</string>
            <string name="Source"><![CDATA[--!strict
-- Criaturas "meme" e personagens especiais com corpo próprio (versões originais):
-- Tronco Tum-Tum, Tubarão Patinador, Crocodilo Bombardeiro, Bailarina Cappuccino,
-- Macaco Banana, Elefante Cacto, Arbusto-Bomba, Privada Cantora, Monstro de
-- Pelúcia, Urso Animatrônico, Ouriço Veloz e Ratinho Elétrico.
-- Coordenadas locais: chão em y = 0, frente = -Z.

local Rig = require(script.Parent.Rig)
local Kit = require(script.Parent.Kit)

local Memes = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new

type Builder = (CFrame, { [string]: any }) -> Rig.RigResult

-- olhos de desenho animado olhando para frente (-Z) a partir de `center`
local function eyes(b: any, center: Vector3, spread: number, size: number, pupil: Color3?)
	for _, side in { -1, 1 } do
		local p = center + V(side * spread, 0, 0)
		b:ball(size, CF(p), rgb(250, 250, 252), { role = "fixed" })
		b:ball(size * 0.55, CF(p + V(side * -0.03, -0.02, -size * 0.32)), pupil or rgb(20, 20, 25), { role = "eye" })
		b:ball(size * 0.18, CF(p + V(side * -0.1 * size, size * 0.12, -size * 0.47)), rgb(255, 255, 255), { role = "fixed", material = Enum.Material.Neon })
	end
end

-- pernas simples ligadas a `parent` (alternadas ao andar)
local function legs(R: any, parent: BasePart, xs: { number }, hipY: number, legH: number, thick: number, color: Color3, foot: Color3?, footLen: number?)
	local b = R.b
	for i, x in xs do
		local m = R:mark()
		b:box(V(thick, legH, thick), CF(x, hipY - legH / 2, 0), color, { role = "secondary" })
		if foot then
			b:box(V(thick * 1.2, 0.35, footLen or thick * 1.6), CF(x, 0.18, -0.15), foot, { role = "fixed" })
		end
		R:group(m, parent, V(x, hipY, 0), { kind = "leg", axis = "X", amp = 0.75, phase = if i % 2 == 0 then math.pi else 0 })
	end
end

local function arm(R: any, parent: BasePart, shoulder: Vector3, len: number, thick: number, color: Color3, hand: Color3?, side: number, pose: CFrame?): BasePart?
	local b = R.b
	local m = R:mark()
	local cf = CF(shoulder) * (pose or CFrame.identity) * CF(0, -len / 2, 0)
	b:box(V(thick, len, thick), cf, color, { role = "primary" })
	if hand then
		b:ball(thick * 1.25, cf * CF(0, -len / 2, 0), hand, { role = "fixed" })
	end
	return R:group(m, parent, shoulder, { kind = "arm", axis = "X", amp = 0.6, phase = if side < 0 then math.pi else 0 })
end

local B: { [string]: Builder } = {}

-- TRONCO TUM-TUM: tronco vivo com taco, toca "tum tum tum" -------------------------
B.tum_tum_log = function(origin, params)
	local R = Rig.new("TroncoTumTum", origin, params)
	local b = R.b
	local wood, bark = rgb(176, 124, 74), rgb(110, 72, 40)
	local legH, bodyH = 1.3, 4.4
	local cy = legH + bodyH / 2
	local root = R:makeRoot(V(2.2, bodyH, 2.2), cy)
	local body = b:cylY(bodyH, 2.3, CF(0, cy, 0), wood, { role = "primary", material = Enum.Material.Wood, name = "Tronco" })
	R:join(body, root)
	for k = 0, 3 do
		b:cylY(0.12, 2.36, CF(0, legH + 0.5 + k * 1.1, 0), bark, { role = "secondary", material = Enum.Material.Wood })
	end
	b:cylY(0.1, 2.0, CF(0, legH + bodyH + 0.04, 0), rgb(220, 180, 120), { role = "fixed", material = Enum.Material.Wood })
	b:cylY(0.11, 1.0, CF(0, legH + bodyH + 0.05, 0), rgb(190, 140, 90), { role = "fixed", material = Enum.Material.Wood })
	-- rosto entalhado
	eyes(b, V(0, cy + 1.0, -1.05), 0.45, 0.62)
	b:box(V(1.0, 0.35, 0.12), CF(0, cy + 0.15, -1.13), rgb(50, 30, 15), { role = "fixed" })
	b:box(V(0.8, 0.12, 0.13), CF(0, cy + 0.05, -1.14), rgb(240, 235, 225), { role = "fixed" })
	for _, side in { -1, 1 } do
		b:box(V(0.5, 0.1, 0.1), CF(side * 0.45, cy + 1.5, -1.12) * CFrame.Angles(0, 0, side * 0.35), rgb(60, 35, 18), { role = "fixed" })
	end
	R.head = body
	R:setMouth(body, V(0, 0.2, -1.2))
	-- braços e taco
	arm(R, body, V(-1.3, cy + 0.4, 0), 1.8, 0.45, wood, wood, -1)
	local m = R:mark()
	local shoulder = V(1.3, cy + 0.4, 0)
	b:box(V(0.45, 1.8, 0.45), CF(shoulder) * CF(0, -0.9, 0), wood, { role = "primary", material = Enum.Material.Wood })
	b:part("cyl", V(3.4, 0.35, 0.35), CF(shoulder + V(0.15, -1.2, -1.5)) * CFrame.Angles(0, math.rad(90), math.rad(20)), rgb(225, 200, 150), { role = "accent", material = Enum.Material.Wood })
	b:part("cyl", V(1.2, 0.55, 0.55), CF(shoulder + V(0.15, -0.6, -3.0)) * CFrame.Angles(0, math.rad(90), math.rad(20)), rgb(225, 200, 150), { role = "accent", material = Enum.Material.Wood })
	R:group(m, body, shoulder, { kind = "arm", axis = "X", amp = 0.9, phase = 0 })
	legs(R, body, { -0.55, 0.55 }, legH, legH, 0.55, wood, bark)
	return R:finish({ hp = params.hp or 400, speed = params.speed or 18, hipHeight = legH, height = legH + bodyH + 0.2, radius = 1.4 })
end

-- TUBARÃO PATINADOR: tubarão em pé sobre duas pernas com patins --------------------
B.skate_shark = function(origin, params)
	local R = Rig.new("TubaraoPatinador", origin, params)
	local b = R.b
	local top, belly = rgb(90, 130, 175), rgb(240, 242, 245)
	local legH = 3.0
	local cy = legH + 1.1
	local root = R:makeRoot(V(1.8, 2.2, 4.2), cy)
	local body = b:part("ball", V(1.9, 2.0, 5.2), CF(0, cy, 0), top, { role = "primary", name = "Corpo" })
	R:join(body, root)
	b:part("ball", V(1.6, 1.4, 4.4), CF(0, cy - 0.35, -0.2), belly, { role = "fixed" })
	b:part("wedge", V(0.25, 1.4, 1.4), CF(0, cy + 1.45, 0.3), top, { role = "primary" })
	-- boca com dentes e olhos
	b:box(V(1.2, 0.18, 0.5), CF(0, cy - 0.35, -2.25), rgb(60, 20, 25), { role = "fixed" })
	for k = -2, 2 do
		b:part("wedge", V(0.12, 0.22, 0.12), CF(k * 0.22, cy - 0.22, -2.42) * CFrame.Angles(math.rad(180), 0, 0), rgb(255, 255, 255), { role = "fixed" })
	end
	eyes(b, V(0, cy + 0.45, -1.95), 0.55, 0.42)
	R.head = body
	R:setMouth(body, V(0, -0.3, -2.6))
	-- cauda animada
	local m = R:mark()
	b:part("wedge", V(0.2, 1.6, 1.2), CF(0, cy + 0.6, 3.0) * CFrame.Angles(math.rad(-30), 0, 0), top, { role = "primary" })
	b:part("wedge", V(0.2, 1.2, 1.0), CF(0, cy - 0.5, 3.0) * CFrame.Angles(math.rad(210), 0, 0), top, { role = "primary" })
	R:group(m, body, V(0, cy, 2.5), { kind = "tail", axis = "Y", amp = 0.45, speed = 1.6 })
	-- nadadeiras como braços
	for _, side in { -1, 1 } do
		local mm = R:mark()
		b:part("wedge", V(0.15, 0.5, 1.1), CF(side * 1.05, cy - 0.4, -0.4) * CFrame.Angles(0, 0, side * 0.9), top, { role = "primary" })
		R:group(mm, body, V(side * 0.9, cy - 0.3, -0.4), { kind = "fin", axis = "Z", amp = 0.4, phase = if side < 0 then 0 else math.pi })
	end
	-- pernas com patins
	for i, x in { -0.5, 0.5 } do
		local mm = R:mark()
		b:box(V(0.55, legH, 0.55), CF(x, legH / 2 + 0.4, 0), belly, { role = "fixed" })
		b:box(V(0.75, 0.6, 1.3), CF(x, 0.55, -0.1), rgb(240, 70, 120), { role = "accent" })
		for _, z in { -0.5, 0.35 } do
			b:part("cyl", V(0.25, 0.4, 0.4), CF(x, 0.2, z), rgb(30, 30, 35), { role = "fixed" })
		end
		R:group(mm, body, V(x, legH + 0.4, 0), { kind = "leg", axis = "X", amp = 0.55, phase = if i == 2 then math.pi else 0 })
	end
	return R:finish({ hp = params.hp or 450, speed = params.speed or 34, hipHeight = legH + 0.0, height = cy + 1.6, radius = 2 })
end

-- CROCODILO BOMBARDEIRO: crocodilo-avião que voa e solta bombas ----------------------
B.croco_bomber = function(origin, params)
	local R = Rig.new("CrocodiloBombardeiro", origin, params)
	local b = R.b
	local green, belly = rgb(70, 130, 60), rgb(200, 210, 150)
	local cy = 2.2
	local root = R:makeRoot(V(2, 1.8, 6), cy)
	local body = b:box(V(1.9, 1.5, 6.4), CF(0, cy, 0), green, { role = "primary", name = "Fuselagem" })
	R:join(body, root)
	b:box(V(1.7, 0.4, 6.2), CF(0, cy - 0.7, 0), belly, { role = "fixed" })
	for k = -3, 3 do
		b:part("wedge", V(0.5, 0.35, 0.5), CF(0, cy + 0.9, k * 0.8), Kit.darker(green, 0.2), { role = "secondary" })
	end
	-- cabeça de crocodilo na frente
	local hm = R:mark()
	local head = b:box(V(1.6, 1.1, 2.8), CF(0, cy + 0.1, -4.4), green, { role = "primary" })
	b:box(V(1.5, 0.35, 2.6), CF(0, cy - 0.45, -4.5), Kit.darker(green, 0.1), { role = "secondary" })
	for k = -4, 4 do
		b:part("wedge", V(0.1, 0.2, 0.12), CF(0.7, cy - 0.25, -4.5 + k * 0.3) * CFrame.Angles(math.rad(180), 0, 0), rgb(255, 255, 255), { role = "fixed" })
		b:part("wedge", V(0.1, 0.2, 0.12), CF(-0.7, cy - 0.25, -4.5 + k * 0.3) * CFrame.Angles(math.rad(180), 0, 0), rgb(255, 255, 255), { role = "fixed" })
	end
	eyes(b, V(0, cy + 0.85, -3.6), 0.45, 0.5, rgb(230, 180, 40))
	R:group(hm, body, V(0, cy, -3.1), { kind = "head", axis = "Y", amp = 0.12, speed = 0.5 })
	R.head = head
	R:setMouth(head, V(0, -0.2, -1.5))
	-- asas, cauda e motores com hélices
	b:box(V(9, 0.25, 1.8), CF(0, cy + 0.2, 0.2), rgb(150, 160, 150), { role = "secondary", material = Enum.Material.Metal })
	b:box(V(3.5, 0.2, 1.1), CF(0, cy + 0.4, 3.2), rgb(150, 160, 150), { role = "secondary", material = Enum.Material.Metal })
	b:part("wedge", V(0.2, 1.4, 1.2), CF(0, cy + 1.2, 3.3), green, { role = "primary" })
	for _, side in { -1, 1 } do
		b:part("cyl", V(1.6, 0.8, 0.8), CF(side * 2.6, cy - 0.15, -0.2) * CFrame.Angles(0, math.rad(90), 0), rgb(90, 95, 100), { role = "fixed", material = Enum.Material.Metal })
		local pm = R:mark()
		b:box(V(2.2, 0.25, 0.1), CF(side * 2.6, cy - 0.15, -1.05), rgb(40, 40, 45), { role = "fixed" })
		b:box(V(0.25, 2.2, 0.1), CF(side * 2.6, cy - 0.15, -1.05), rgb(40, 40, 45), { role = "fixed" })
		R:group(pm, body, V(side * 2.6, cy - 0.15, -1.05), { kind = "spin", axis = "Z", speed = 6 })
	end
	-- bomba pendurada
	b:ball(0.9, CF(0, cy - 1.2, 0.4), rgb(30, 30, 35), { role = "fixed" })
	b:box(V(0.1, 0.4, 0.1), CF(0, cy - 0.85, 0.4), rgb(80, 80, 80), { role = "fixed" })
	return R:finish({ hp = params.hp or 700, speed = params.speed or 26, hipHeight = cy - 0.9, height = cy + 1.8, radius = 3.5, flying = true })
end

-- BAILARINA CAPPUCCINO: bailarina com cabeça de xícara -------------------------------
B.coffee_ballerina = function(origin, params)
	local R = Rig.new("BailarinaCappuccino", origin, params)
	local b = R.b
	local pink, skin = rgb(255, 160, 200), rgb(250, 215, 190)
	local legH = 2.4
	local torsoY = legH + 0.9
	local root = R:makeRoot(V(1.4, 1.8, 0.9), torsoY)
	local torso = b:box(V(1.3, 1.8, 0.8), CF(0, torsoY, 0), pink, { role = "primary", name = "Tronco" })
	R:join(torso, root)
	b:part("cyl", V(0.35, 3.6, 3.6), CF(0, legH + 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(255, 200, 225), { role = "secondary", material = Enum.Material.Fabric })
	b:part("cyl", V(0.25, 3.0, 3.0), CF(0, legH + 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)), rgb(255, 225, 240), { role = "fixed", material = Enum.Material.Fabric })
	for i, x in { -0.35, 0.35 } do
		local m = R:mark()
		b:box(V(0.42, legH, 0.42), CF(x, legH / 2, 0), skin, { role = "fixed" })
		b:box(V(0.45, 0.3, 0.7), CF(x, 0.15, -0.1), rgb(255, 120, 170), { role = "accent" })
		R:group(m, torso, V(x, legH, 0), { kind = "leg", axis = "X", amp = 0.5, phase = if i == 2 then math.pi else 0 })
	end
	-- braços em pose de balé (para cima)
	for _, side in { -1, 1 } do
		arm(R, torso, V(side * 0.85, torsoY + 0.75, 0), 1.7, 0.32, skin, skin, side, CFrame.Angles(0, 0, side * math.rad(150)))
	end
	-- cabeça: xícara de cappuccino com rostinho
	local hm = R:mark()
	local cupY = torsoY + 1.9
	local cup = b:cylY(1.5, 1.8, CF(0, cupY, 0), rgb(250, 250, 250), { role = "fixed", name = "Xicara" })
	b:cylY(0.12, 1.65, CF(0, cupY + 0.72, 0), rgb(150, 95, 55), { role = "fixed" })
	b:ball(0.7, CF(-0.3, cupY + 0.82, 0.1), rgb(250, 235, 210), { role = "fixed" })
	b:ball(0.55, CF(0.35, cupY + 0.8, -0.2), rgb(250, 235, 210), { role = "fixed" })
	b:part("cyl", V(0.25, 0.9, 0.9), CF(1.05, cupY, 0) * CFrame.Angles(0, math.rad(90), 0), rgb(250, 250, 250), { role = "fixed" })
	eyes(b, V(0, cupY + 0.15, -0.88), 0.32, 0.38)
	b:box(V(0.35, 0.08, 0.05), CF(0, cupY - 0.3, -0.91), rgb(200, 80, 110), { role = "fixed" })
	b:cylY(0.12, 2.2, CF(0, cupY - 0.8, 0), rgb(250, 250, 250), { role = "fixed" })
	R:group(hm, torso, V(0, torsoY + 0.9, 0), { kind = "head", axis = "Y", amp = 0.2, speed = 0.6 })
	R.head = cup
	R:setMouth(cup, V(0, -0.3, -0.95))
	return R:finish({ hp = params.hp or 300, speed = params.speed or 22, hipHeight = legH, height = cupY + 1, radius = 1.6 })
end

-- MACACO BANANA: macaquinho saindo de uma banana --------------------------------------
B.banana_monkey = function(origin, params)
	local R = Rig.new("MacacoBanana", origin, params)
	local b = R.b
	local yellow, brown, face = rgb(250, 215, 60), rgb(120, 80, 45), rgb(235, 200, 160)
	local legH = 1.0
	local cy = legH + 1.6
	local root = R:makeRoot(V(1.6, 3.2, 1.6), cy)
	local peel = b:cylY(3.2, 1.7, CF(0, cy, 0), yellow, { role = "primary", name = "Banana" })
	R:join(peel, root)
	b:cylY(0.5, 0.5, CF(0, legH + 3.4, 0.3) * CFrame.Angles(math.rad(25), 0, 0), rgb(110, 90, 40), { role = "fixed" })
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.4
		b:part("wedge", V(0.15, 1.3, 0.9), CF(math.cos(a) * 0.95, cy + 0.9, math.sin(a) * 0.95) * CFrame.Angles(0, -a + math.pi / 2, math.rad(180)), yellow, { role = "primary" })
	end
	-- cabeça do macaco saindo da banana
	local hm = R:mark()
	local hy = cy + 0.9
	local head = b:ball(1.35, CF(0, hy, -0.55), brown, { role = "secondary" })
	b:part("ball", V(1.0, 0.75, 0.4), CF(0, hy - 0.15, -1.1), face, { role = "fixed" })
	eyes(b, V(0, hy + 0.2, -1.12), 0.24, 0.32)
	b:box(V(0.4, 0.07, 0.05), CF(0, hy - 0.3, -1.3), rgb(80, 40, 30), { role = "fixed" })
	for _, side in { -1, 1 } do
		b:part("cyl", V(0.15, 0.55, 0.55), CF(side * 0.72, hy + 0.05, -0.55) * CFrame.Angles(0, 0, 0), face, { role = "fixed" })
	end
	R:group(hm, peel, V(0, hy - 0.4, -0.5), { kind = "head", axis = "Y", amp = 0.25, speed = 0.8 })
	R.head = head
	R:setMouth(head, V(0, -0.3, -0.8))
	for _, side in { -1, 1 } do
		arm(R, peel, V(side * 0.9, cy + 0.4, -0.2), 1.3, 0.3, brown, face, side)
	end
	legs(R, peel, { -0.4, 0.4 }, legH, legH, 0.35, brown, face)
	return R:finish({ hp = params.hp or 260, speed = params.speed or 22, hipHeight = legH, height = hy + 0.8, radius = 1.2 })
end

-- ELEFANTE CACTO: cabeça de elefante num corpo de cacto, de sandálias ----------------
B.cactus_elephant = function(origin, params)
	local R = Rig.new("ElefanteCacto", origin, params)
	local b = R.b
	local cactus, grey = rgb(80, 160, 70), rgb(150, 150, 160)
	local legH = 1.2
	local cy = legH + 1.8
	local root = R:makeRoot(V(2, 3.6, 2), cy)
	local body = b:cylY(3.6, 2.2, CF(0, cy, 0), cactus, { role = "primary", name = "Cacto" })
	R:join(body, root)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:box(V(0.12, 3.4, 0.2), CF(math.cos(a) * 1.1, cy, math.sin(a) * 1.1) * CFrame.Angles(0, -a, 0), Kit.darker(cactus, 0.2), { role = "secondary" })
		for j = 0, 2 do
			b:part("wedge", V(0.06, 0.25, 0.12), CF(math.cos(a) * 1.18, cy - 1 + j, math.sin(a) * 1.18) * CFrame.Angles(0, -a + math.pi / 2, math.rad(90)), rgb(250, 250, 230), { role = "fixed" })
		end
	end
	for _, side in { -1, 1 } do
		local m = R:mark()
		b:cylY(1.2, 0.7, CF(side * 1.5, cy + 0.2, 0) * CFrame.Angles(0, 0, side * math.rad(-70)), cactus, { role = "primary" })
		b:cylY(1.3, 0.7, CF(side * 2.0, cy + 1.0, 0), cactus, { role = "primary" })
		R:group(m, body, V(side * 1.1, cy, 0), { kind = "arm", axis = "Z", amp = 0.15, phase = if side < 0 then 0 else math.pi })
	end
	-- cabeça de elefante
	local hm = R:mark()
	local hy = cy + 2.5
	local head = b:ball(2.0, CF(0, hy, -0.2), grey, { role = "secondary" })
	eyes(b, V(0, hy + 0.3, -1.05), 0.45, 0.42)
	for _, side in { -1, 1 } do
		b:part("wedge", V(0.12, 1.7, 1.4), CF(side * 1.15, hy, 0.1) * CFrame.Angles(0, side * math.rad(-60), 0), Kit.darker(grey, 0.1), { role = "secondary" })
	end
	R:group(hm, body, V(0, cy + 1.8, 0), { kind = "head", axis = "Y", amp = 0.15, speed = 0.4 })
	R.head = head
	local tm = R:mark()
	b:part("cyl", V(1.6, 0.5, 0.5), CF(0, hy - 0.8, -1.1) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(0, 0, math.rad(15)), grey, { role = "secondary" })
	R:group(tm, head, V(0, hy - 0.2, -1.0), { kind = "tail", axis = "X", amp = 0.3, speed = 0.8 })
	R:setMouth(head, V(0, -1.2, -1.1))
	-- pernas com sandálias
	for i, x in { -0.55, 0.55 } do
		local m = R:mark()
		b:box(V(0.6, legH, 0.6), CF(x, legH / 2 + 0.15, 0), cactus, { role = "primary" })
		b:box(V(0.9, 0.15, 1.3), CF(x, 0.08, -0.1), rgb(150, 100, 60), { role = "fixed" })
		b:box(V(0.9, 0.12, 0.15), CF(x, 0.3, -0.45), rgb(150, 100, 60), { role = "fixed" })
		R:group(m, body, V(x, legH, 0), { kind = "leg", axis = "X", amp = 0.6, phase = if i == 2 then math.pi else 0 })
	end
	return R:finish({ hp = params.hp or 800, speed = params.speed or 12, hipHeight = legH, height = hy + 1, radius = 1.6 })
end

-- ARBUSTO-BOMBA: moita com pavio que explode perto de você ---------------------------
B.boom_bush = function(origin, params)
	local R = Rig.new("ArbustoBomba", origin, params)
	local b = R.b
	local leaf = rgb(60, 150, 60)
	local legH = 0.8
	local cy = legH + 1.3
	local root = R:makeRoot(V(2.2, 2.4, 2.2), cy)
	local body = b:ball(2.6, CF(0, cy, 0), leaf, { role = "primary", material = Enum.Material.Grass, name = "Moita" })
	R:join(body, root)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:ball(1.2, CF(math.cos(a) * 1.0, cy + 0.3 + (k % 2) * 0.4, math.sin(a) * 1.0), Kit.lighter(leaf, (k % 3) * 0.08), { role = "secondary", material = Enum.Material.Grass })
	end
	eyes(b, V(0, cy + 0.35, -1.25), 0.45, 0.45, rgb(200, 20, 20))
	for _, side in { -1, 1 } do
		b:box(V(0.5, 0.12, 0.1), CF(side * 0.45, cy + 0.8, -1.3) * CFrame.Angles(0, 0, side * 0.45), rgb(20, 40, 20), { role = "fixed" })
	end
	b:box(V(0.8, 0.2, 0.1), CF(0, cy - 0.35, -1.32), rgb(30, 20, 10), { role = "fixed" })
	b:cylY(0.8, 0.2, CF(0, cy + 1.6, 0), rgb(90, 70, 50), { role = "fixed" })
	local spark = b:ball(0.4, CF(0, cy + 2.05, 0), rgb(255, 180, 40), { role = "accent", material = Enum.Material.Neon, name = "Faisca" })
	b:light(spark, rgb(255, 170, 60), 8, 2)
	R.head = body
	R:setMouth(body, V(0, 0, -1.3))
	legs(R, body, { -0.5, 0.5 }, legH, legH, 0.4, rgb(90, 70, 50))
	return R:finish({ hp = params.hp or 80, speed = params.speed or 15, hipHeight = legH, height = cy + 2.2, radius = 1.4 })
end

-- PRIVADA CANTORA: privada com cabeça cantando ------------------------------------------
B.singing_toilet = function(origin, params)
	local R = Rig.new("PrivadaCantora", origin, params)
	local b = R.b
	local white = rgb(245, 245, 250)
	local cy = 1.2
	local root = R:makeRoot(V(2.2, 2.4, 2.6), cy)
	local bowl = b:cylY(1.6, 2.2, CF(0, 0.9, 0), white, { role = "primary", name = "Privada" })
	R:join(bowl, root)
	b:cylY(0.25, 2.4, CF(0, 1.8, 0), white, { role = "primary" })
	b:box(V(2.0, 2.2, 0.8), CF(0, 2.3, 1.2), white, { role = "primary" })
	b:box(V(0.5, 0.15, 0.2), CF(0.6, 3.2, 0.85), rgb(190, 190, 200), { role = "fixed", material = Enum.Material.Metal })
	local hm = R:mark()
	local hy = 3.0
	local head = b:ball(1.7, CF(0, hy, -0.1), rgb(240, 200, 170), { role = "fixed" })
	eyes(b, V(0, hy + 0.3, -0.85), 0.32, 0.38)
	b:part("ball", V(0.55, 0.5, 0.2), CF(0, hy - 0.35, -0.85), rgb(120, 30, 40), { role = "fixed" })
	b:box(V(1.4, 0.35, 1.4), CF(0, hy + 0.85, 0), rgb(60, 40, 25), { role = "fixed" })
	R:group(hm, bowl, V(0, 1.9, 0), { kind = "bob", axis = "Y", amp = 0.5, speed = 2.5 })
	R.head = head
	R:setMouth(head, V(0, -0.35, -0.9))
	return R:finish({ hp = params.hp or 200, speed = params.speed or 14, hipHeight = 0.0, height = hy + 1, radius = 1.4 })
end

-- MONSTRO DE PELÚCIA: braços compridos e sorriso cheio de dentes ----------------------
B.plush_monster = function(origin, params)
	local R = Rig.new("MonstroPelucia", origin, params)
	local b = R.b
	local fur = rgb(230, 110, 170)
	local legH = 3.2
	local torsoY = legH + 1.3
	local root = R:makeRoot(V(1.6, 2.6, 1), torsoY)
	local torso = b:box(V(1.6, 2.6, 1), CF(0, torsoY, 0), fur, { role = "primary", material = Enum.Material.Fabric, name = "Tronco" })
	R:join(torso, root)
	legs(R, torso, { -0.45, 0.45 }, legH, legH, 0.6, fur, rgb(255, 230, 120), 1.3)
	for _, side in { -1, 1 } do
		arm(R, torso, V(side * 1.1, torsoY + 1.0, 0), 4.2, 0.5, fur, rgb(255, 230, 120), side)
	end
	local hm = R:mark()
	local hy = torsoY + 2.4
	local head = b:ball(2.4, CF(0, hy, 0), fur, { role = "primary", material = Enum.Material.Fabric })
	eyes(b, V(0, hy + 0.4, -1.05), 0.55, 0.6)
	b:part("ball", V(1.8, 0.6, 0.4), CF(0, hy - 0.45, -1.0), rgb(250, 60, 80), { role = "fixed" })
	for k = -3, 3 do
		b:part("wedge", V(0.15, 0.25, 0.1), CF(k * 0.22, hy - 0.3, -1.2) * CFrame.Angles(math.rad(180), 0, 0), rgb(255, 255, 255), { role = "fixed" })
	end
	R:group(hm, torso, V(0, torsoY + 1.3, 0), { kind = "head", axis = "Y", amp = 0.2, speed = 0.5 })
	R.head = head
	R:setMouth(head, V(0, -0.4, -1.2))
	return R:finish({ hp = params.hp or 600, speed = params.speed or 18, hipHeight = legH, height = hy + 1.2, radius = 1.4 })
end

-- URSO ANIMATRÔNICO: urso de metal com olhos brilhantes --------------------------------
B.animatronic_bear = function(origin, params)
	local R = Rig.new("UrsoAnimatronico", origin, params)
	local b = R.b
	local metal, dark = rgb(140, 105, 80), rgb(60, 60, 65)
	local legH = 2.2
	local torsoY = legH + 1.3
	local root = R:makeRoot(V(2.4, 2.6, 1.6), torsoY)
	local torso = b:box(V(2.4, 2.6, 1.6), CF(0, torsoY, 0), metal, { role = "primary", material = Enum.Material.Metal, name = "Tronco" })
	R:join(torso, root)
	b:part("ball", V(1.8, 1.8, 0.4), CF(0, torsoY - 0.1, -0.75), Kit.lighter(metal, 0.25), { role = "secondary" })
	legs(R, torso, { -0.6, 0.6 }, legH, legH, 0.8, metal, dark)
	for _, side in { -1, 1 } do
		arm(R, torso, V(side * 1.55, torsoY + 1.0, 0), 2.2, 0.65, metal, dark, side)
	end
	local hm = R:mark()
	local hy = torsoY + 2.2
	local head = b:box(V(1.9, 1.7, 1.7), CF(0, hy, 0), metal, { role = "primary", material = Enum.Material.Metal })
	b:box(V(1.0, 0.7, 0.6), CF(0, hy - 0.35, -1.0), Kit.lighter(metal, 0.2), { role = "secondary" })
	b:ball(0.35, CF(0, hy - 0.15, -1.32), rgb(25, 20, 20), { role = "fixed" })
	for _, side in { -1, 1 } do
		b:ball(0.3, CF(side * 0.45, hy + 0.3, -0.86), rgb(255, 230, 120), { role = "eye", material = Enum.Material.Neon })
		b:part("cyl", V(0.25, 0.7, 0.7), CF(side * 0.8, hy + 1.0, 0) * CFrame.Angles(0, math.rad(90), 0), metal, { role = "primary" })
	end
	local jm = R:mark()
	b:box(V(0.9, 0.25, 0.55), CF(0, hy - 0.85, -0.95), dark, { role = "fixed" })
	R.head = head
	R:group(hm, torso, V(0, torsoY + 1.3, 0), { kind = "head", axis = "Y", amp = 0.25, speed = 0.3 })
	R:group(jm, head, V(0, hy - 0.7, -0.7), { kind = "jaw", axis = "X", amp = 0.35 })
	R:setMouth(head, V(0, -0.6, -1.1))
	return R:finish({ hp = params.hp or 500, speed = params.speed or 14, hipHeight = legH, height = hy + 1.4, radius = 1.6 })
end

-- OURIÇO VELOZ: ouriço de tênis que corre muito ---------------------------------------
B.speed_hedgehog = function(origin, params)
	local R = Rig.new("OuricoVeloz", origin, params)
	local b = R.b
	local quills, belly = rgb(120, 90, 60), rgb(240, 215, 170)
	local legH = 1.1
	local cy = legH + 1.0
	local root = R:makeRoot(V(1.6, 2, 1.6), cy)
	local body = b:ball(2.1, CF(0, cy, 0), quills, { role = "primary", name = "Corpo" })
	R:join(body, root)
	b:part("ball", V(1.5, 1.6, 0.6), CF(0, cy - 0.1, -0.75), belly, { role = "fixed" })
	for k = 0, 8 do
		local a = (k / 9 - 0.5) * math.pi * 1.4
		b:part("wedge", V(0.3, 1.4, 0.6), CF(math.sin(a) * 0.8, cy + math.cos(a) * 0.6, 0.7) * CFrame.Angles(math.rad(-120), 0, -a * 0.6), Kit.darker(quills, 0.1), { role = "secondary" })
	end
	eyes(b, V(0, cy + 0.4, -0.95), 0.3, 0.42, rgb(40, 140, 60))
	b:ball(0.25, CF(0, cy + 0.05, -1.08), rgb(20, 20, 20), { role = "fixed" })
	R.head = body
	R:setMouth(body, V(0, -0.2, -1.1))
	for _, side in { -1, 1 } do
		arm(R, body, V(side * 0.95, cy, -0.2), 0.9, 0.28, belly, rgb(250, 250, 250), side)
	end
	for i, x in { -0.4, 0.4 } do
		local m = R:mark()
		b:box(V(0.35, legH, 0.35), CF(x, legH / 2 + 0.3, 0), belly, { role = "fixed" })
		b:box(V(0.6, 0.5, 1.3), CF(x, 0.25, -0.25), rgb(240, 240, 245), { role = "fixed" })
		b:box(V(0.62, 0.18, 1.32), CF(x, 0.35, -0.25), rgb(40, 170, 90), { role = "accent" })
		R:group(m, body, V(x, legH + 0.3, 0), { kind = "leg", axis = "X", amp = 1.0, speed = 1.8, phase = if i == 2 then math.pi else 0 })
	end
	return R:finish({ hp = params.hp or 300, speed = params.speed or 48, hipHeight = legH, height = cy + 1.2, radius = 1.1 })
end

-- RATINHO ELÉTRICO: ratinho azul de bochechas elétricas --------------------------------
B.electric_mouse = function(origin, params)
	local R = Rig.new("RatinhoEletrico", origin, params)
	local b = R.b
	local fur = rgb(120, 180, 240)
	local legH = 0.9
	local cy = legH + 1.0
	local root = R:makeRoot(V(1.6, 2, 1.4), cy)
	local body = b:part("ball", V(1.7, 2.0, 1.5), CF(0, cy, 0), fur, { role = "primary", name = "Corpo" })
	R:join(body, root)
	local hm = R:mark()
	local hy = cy + 1.5
	local head = b:ball(1.7, CF(0, hy, -0.1), fur, { role = "primary" })
	eyes(b, V(0, hy + 0.15, -0.9), 0.35, 0.4)
	for _, side in { -1, 1 } do
		b:ball(0.4, CF(side * 0.58, hy - 0.3, -0.72), rgb(255, 230, 60), { role = "accent", material = Enum.Material.Neon })
		b:part("wedge", V(0.2, 1.4, 0.7), CF(side * 0.55, hy + 1.2, 0) * CFrame.Angles(0, 0, side * -0.3), fur, { role = "primary" })
		b:part("wedge", V(0.22, 0.45, 0.72), CF(side * 0.75, hy + 1.75, 0) * CFrame.Angles(0, 0, side * -0.3), rgb(30, 30, 40), { role = "fixed" })
	end
	R:group(hm, body, V(0, cy + 0.9, 0), { kind = "head", axis = "Y", amp = 0.2, speed = 0.7 })
	R.head = head
	R:setMouth(head, V(0, -0.35, -0.9))
	-- cauda em zigue-zague (raio)
	local tm = R:mark()
	b:box(V(0.25, 1.0, 0.25), CF(0, cy - 0.1, 1.0) * CFrame.Angles(math.rad(40), 0, 0), rgb(255, 230, 60), { role = "accent", material = Enum.Material.Neon })
	b:box(V(0.6, 0.25, 0.25), CF(0.2, cy + 0.4, 1.4), rgb(255, 230, 60), { role = "accent", material = Enum.Material.Neon })
	b:box(V(0.25, 1.1, 0.25), CF(0.45, cy + 0.95, 1.5) * CFrame.Angles(math.rad(-25), 0, 0), rgb(255, 230, 60), { role = "accent", material = Enum.Material.Neon })
	R:group(tm, body, V(0, cy - 0.4, 0.7), { kind = "tail", axis = "Y", amp = 0.35, speed = 1.4 })
	for _, side in { -1, 1 } do
		arm(R, body, V(side * 0.85, cy + 0.3, -0.1), 0.8, 0.3, fur, fur, side)
	end
	legs(R, body, { -0.4, 0.4 }, legH, legH, 0.4, fur, fur)
	return R:finish({ hp = params.hp or 260, speed = params.speed or 24, hipHeight = legH, height = hy + 2, radius = 1.1 })
end

Memes.Variants = B

function Memes.build(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local f = B[variant] or B.tum_tum_log
	return f(origin, params)
end

return Memes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Monsters</string>
            <string name="Source"><![CDATA[--!strict
-- Criaturas especiais: dragão (e hidra), fantasma, robôs (robô, mecha, drone)
-- e disco voador.

local Rig = require(script.Parent.Rig)
local Kit = require(script.Parent.Kit)

local Monsters = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

-- DRAGÃO ----------------------------------------------------------------------------
function Monsters.dragon(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local hydra = variant == "hydra"
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local element = params.element or "fire"
	local base = if hydra then rgb(60, 110, 70) else rgb(170, 35, 35)
	if element == "ice" then
		base = rgb(110, 170, 220)
	elseif element == "electric" then
		base = rgb(60, 70, 150)
	elseif element == "poison" then
		base = rgb(70, 130, 60)
	elseif element == "shadow" then
		base = rgb(45, 30, 60)
	elseif element == "light" then
		base = rgb(240, 225, 170)
	end
	local belly = rgb(235, 200, 130)
	local wingCol = Kit.darker(base, 0.25)
	local glow = (Kit.Elements[element] or Kit.Elements.fire).color
	local legH = 2.6
	local bodyY = legH + 1.4
	local root = R:makeRoot(V(3, 2.8, 5), bodyY)
	local torso = b:part("ball", V(3.2, 3.0, 5.6), CF(0, bodyY, 0), base, { role = "primary", name = "Corpo" })
	R:join(torso, root)
	local bel = b:part("ball", V(2.6, 2.2, 4.6), CF(0, bodyY - 0.6, -0.2), belly, { role = "fixed" })
	R:join(bel, torso)
	-- espinhos nas costas
	for k = 0, 5 do
		local sp = b:part("wedge", V(0.3, 0.9, 0.9), CF(0, bodyY + 1.6, -2 + k * 0.8), glow, { role = "accent", material = Enum.Material.Neon })
		R:join(sp, torso)
	end
	-- pernas
	local legPos = { { -1.2, -1.6, 0 }, { 1.2, -1.6, math.pi }, { -1.3, 1.7, math.pi }, { 1.3, 1.7, 0 } }
	for _, l in legPos do
		local m = R:mark()
		local x, z, ph = l[1], l[2], l[3]
		b:part("ball", V(1.1, 1.8, 1.3), CF(x, legH + 0.1, z), base, { role = "primary" })
		b:box(V(0.7, legH, 0.7), CF(x, legH / 2, z), base, { role = "primary" })
		for c = -1, 1 do
			b:part("wedge", V(0.2, 0.3, 0.5), CF(x + c * 0.25, 0.15, z - 0.55), rgb(30, 25, 25), { role = "fixed" })
		end
		R:group(m, torso, V(x, legH + 0.6, z), { kind = "leg", axis = "X", amp = 0.5, phase = ph })
	end
	-- asas (duas partes cada)
	if not hydra then
		for _, side in { -1, 1 } do
			local m = R:mark()
			local shoulder = V(side * 1.3, bodyY + 1.2, -0.8)
			b:beam(shoulder, shoulder + V(side * 3.2, 1.6, 0.4), 0.35, base, { role = "primary" })
			b:beam(shoulder + V(side * 3.2, 1.6, 0.4), shoulder + V(side * 6.4, 0.6, 1.4), 0.25, base, { role = "primary" })
			b:part("wedge", V(0.12, 3.2, 3.4), CF(shoulder + V(side * 1.8, 0.2, 1.4)) * ANG(rad(-90), side * rad(90), 0), wingCol, { role = "secondary" })
			b:part("wedge", V(0.12, 3.6, 3.0), CF(shoulder + V(side * 4.8, 0.3, 1.7)) * ANG(rad(-90), side * rad(90), 0), wingCol, { role = "secondary" })
			R:group(m, torso, shoulder, { kind = "wing", axis = "Z", amp = if params.fly ~= false then 0.6 else 0.15, phase = if side < 0 then 0 else math.pi, speed = 0.9 })
		end
	end
	-- pescoço(s) e cabeça(s)
	local heads = if hydra then { -1.2, 0, 1.2 } else { 0 }
	local firstHead: BasePart? = nil
	for _, hx in heads do
		local prev: BasePart = torso
		local p0 = V(hx * 0.6, bodyY + 0.8, -2.6)
		local dir = V(hx * 0.25, 0.75, -0.7).Unit
		local pos = p0
		for k = 1, 3 do
			local m = R:mark()
			pos = p0 + dir * (k * 1.1)
			b:part("ball", V(1.3 - k * 0.12, 1.3 - k * 0.12, 1.6), CF(pos, pos + dir), base, { role = "primary" })
			prev = R:group(m, prev, pos - dir * 0.6, { kind = "segment", axis = "Y", amp = 0.12, phase = k * 0.5 + hx, speed = 0.6 }) or prev
		end
		local hm = R:mark()
		local headPos = pos + V(0, 0.5, -1.1)
		local head = b:box(V(1.4, 1.2, 2.2), CF(headPos), base, { role = "primary", name = "Cabeca" })
		b:box(V(1.0, 0.7, 1.4), CF(headPos + V(0, -0.15, -1.4)), base, { role = "primary" })
		for _, side in { -1, 1 } do
			b:box(V(0.25, 0.22, 0.1), CF(headPos + V(side * 0.55, 0.3, -1.05)), glow, { role = "eye", material = Enum.Material.Neon })
			b:cone(1.4, 0.4, CF(headPos + V(side * 0.45, 0.5, 0.6)) * ANG(rad(70), 0, side * rad(-15)), rgb(240, 230, 200), 3, { role = "fixed" })
			b:box(V(0.15, 0.15, 0.1), CF(headPos + V(side * 0.3, 0.05, -2.12)), rgb(20, 15, 15), { role = "fixed" })
		end
		for k = 0, 3 do
			for _, side in { -1, 1 } do
				b:part("wedge", V(0.1, 0.25, 0.15), CF(headPos + V(side * 0.45, -0.55, -1.9 + k * 0.35)) * ANG(rad(180), 0, 0), rgb(250, 250, 240), { role = "fixed" })
			end
		end
		local hb = R:group(hm, prev, headPos + V(0, -0.3, 0.9), { kind = "head", axis = "X", amp = 0.15, speed = 0.7 })
		local jm = R:mark()
		b:box(V(0.95, 0.3, 1.8), CF(headPos + V(0, -0.65, -1.2)), belly, { role = "fixed", name = "Mandibula" })
		R:group(jm, hb or prev, headPos + V(0, -0.5, 0.2), { kind = "jaw", axis = "X", amp = 0.3, speed = 0.4 })
		if not firstHead then
			firstHead = head
			R.head = head
			R:setMouth(head, V(0, -0.3, -2.2))
		end
	end
	-- cauda com ponta em lança
	local prev: BasePart = torso
	local tb = V(0, bodyY + 0.2, 2.6)
	for k = 1, 5 do
		local m = R:mark()
		local th = 1.4 - k * 0.2
		local pos = tb + V(0, -k * 0.2, k * 1.2)
		b:part("ball", V(th, th, 1.6), CF(pos), base, { role = "primary" })
		if k == 5 then
			b:part("wedge", V(0.15, 1.2, 1.2), CF(pos + V(0, 0, 0.9)) * ANG(rad(90), 0, 0), glow, { role = "accent", material = Enum.Material.Neon })
		end
		prev = R:group(m, prev, pos - V(0, 0, 0.7), { kind = "tail", axis = "Y", amp = 0.2, phase = k * 0.6, speed = 0.8 }) or prev
	end
	return R:finish({ hp = params.hp or 900, speed = params.speed or 24, hipHeight = legH, height = bodyY + 4.5, flying = params.fly ~= false and not hydra, radius = 3.4 })
end

-- FANTASMA --------------------------------------------------------------------------
function Monsters.ghost(origin: CFrame, params: { [string]: any }, _variant: string): Rig.RigResult
	local R = Rig.new("ghost", origin, params)
	local b = R.b
	local col = rgb(235, 240, 255)
	local root = R:makeRoot(V(2, 3, 2), 3)
	local m = R:mark()
	b:ball(2.4, CF(0, 4.2, 0), col, { role = "primary", material = Enum.Material.ForceField, transparency = 0.35, name = "Cabeca" })
	b:part("cyl", V(2.2, 2.4, 2.4), CF(0, 2.9, 0) * ANG(0, 0, rad(90)), col, { role = "primary", material = Enum.Material.ForceField, transparency = 0.35 })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:part("wedge", V(0.6, 0.9, 0.4), CF(math.cos(a) * 0.95, 1.4, math.sin(a) * 0.95) * ANG(rad(180), -a, 0), col, { role = "primary", material = Enum.Material.ForceField, transparency = 0.35 })
	end
	for _, side in { -1, 1 } do
		b:part("ball", V(0.45, 0.7, 0.2), CF(side * 0.45, 4.4, -1.1), rgb(10, 10, 15), { role = "eye" })
		b:part("ball", V(0.6, 0.9, 0.8), CF(side * 1.3, 3.2, -0.3), col, { role = "primary", material = Enum.Material.ForceField, transparency = 0.35 })
	end
	b:part("ball", V(0.6, 0.8, 0.2), CF(0, 3.7, -1.15), rgb(10, 10, 15), { role = "fixed" })
	local body = R:group(m, root, V(0, 2, 0), { kind = "bob", axis = "Y", amp = 0.5, speed = 0.7 })
	R.head = body
	if body then
		R:setMouth(body, V(0, 0.8, -1.2))
	end
	local light = Instance.new("PointLight")
	light.Color = rgb(180, 200, 255)
	light.Range = 10
	light.Brightness = 1
	light.Parent = root
	return R:finish({ hp = params.hp or 120, speed = params.speed or 14, hipHeight = 1.5, height = 5.4, flying = true, radius = 1.4 })
end

-- ROBÔS -----------------------------------------------------------------------------
function Monsters.robot(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	if variant == "drone" then
		return Monsters.drone(origin, params)
	end
	local mech = variant == "mech"
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local metal = if mech then rgb(70, 75, 85) else rgb(170, 180, 195)
	local dark = rgb(45, 48, 55)
	local glow = if mech then rgb(255, 60, 60) else rgb(80, 220, 255)
	local legH = 2.4
	local torsoY = legH + 1.3
	local root = R:makeRoot(V(2.6, 2.6, 1.6), torsoY)
	local torso = b:box(V(2.6, 2.6, 1.6), CF(0, torsoY, 0), metal, { role = "primary", material = Enum.Material.DiamondPlate, name = "Tronco" })
	R:join(torso, root)
	local panel = b:box(V(1.4, 0.9, 0.1), CF(0, torsoY + 0.3, -0.82), dark, { role = "secondary" })
	R:join(panel, torso)
	for k = -1, 1 do
		local l = b:box(V(0.25, 0.25, 0.08), CF(k * 0.4, torsoY + 0.3, -0.88), if k == 0 then rgb(255, 220, 60) else glow, { role = "accent", material = Enum.Material.Neon })
		R:join(l, torso)
	end
	if mech then
		local cockpit = b:part("ball", V(1.8, 1.4, 1.2), CF(0, torsoY + 1.2, -0.6), rgb(120, 200, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.3 })
		R:join(cockpit, torso)
		for _, side in { -1, 1 } do
			local cannon = b:part("cyl", V(2.2, 0.6, 0.6), CF(side * 1.0, torsoY + 1.8, -0.4) * ANG(0, rad(90), 0), dark, { role = "secondary" })
			R:join(cannon, torso)
		end
	end
	for _, side in { -1, 1 } do
		local m = R:mark()
		local x = side * 0.75
		b:box(V(0.9, legH, 0.9), CF(x, legH / 2, 0), dark, { role = "secondary" })
		b:box(V(1.0, 0.5, 1.0), CF(x, legH * 0.55, 0), metal, { role = "primary" })
		b:box(V(1.1, 0.4, 1.5), CF(x, 0.2, -0.2), metal, { role = "primary" })
		R:group(m, torso, V(x, legH, 0), { kind = "leg", axis = "X", amp = 0.5, phase = if side < 0 then 0 else math.pi })
		local am = R:mark()
		local sx = side * 1.75
		b:ball(1.0, CF(sx, torsoY + 1.0, 0), metal, { role = "primary" })
		b:box(V(0.7, 2.2, 0.7), CF(sx, torsoY - 0.3, 0), dark, { role = "secondary" })
		b:box(V(0.9, 0.7, 0.9), CF(sx, torsoY - 1.6, 0), metal, { role = "primary" })
		if side == 1 then
			b:part("cyl", V(0.9, 0.35, 0.35), CF(sx, torsoY - 1.7, -0.6) * ANG(0, rad(90), 0), glow, { role = "accent", material = Enum.Material.Neon })
		end
		R:group(am, torso, V(sx, torsoY + 1.0, 0), { kind = "arm", axis = "X", amp = 0.4, phase = if side < 0 then math.pi else 0 })
	end
	local hm = R:mark()
	local headY = torsoY + 1.3 + 0.75
	local head = b:box(V(1.5, 1.3, 1.3), CF(0, headY, 0), metal, { role = "primary", material = Enum.Material.DiamondPlate, name = "Cabeca" })
	b:box(V(1.2, 0.35, 0.1), CF(0, headY + 0.1, -0.66), glow, { role = "eye", material = Enum.Material.Neon })
	b:beam(V(0, headY + 0.65, 0), V(0, headY + 1.4, 0), 0.1, dark, { role = "fixed" })
	b:ball(0.3, CF(0, headY + 1.45, 0), rgb(255, 60, 60), { role = "accent", material = Enum.Material.Neon })
	R.head = head
	R:group(hm, torso, V(0, torsoY + 1.3, 0), { kind = "head", axis = "Y", amp = 0.25, speed = 0.5 })
	R:setMouth(head, V(0, 0, -0.7))
	return R:finish({ hp = params.hp or 380, speed = params.speed or 16, hipHeight = legH, height = headY + 1.6, radius = 1.6 })
end

function Monsters.drone(origin: CFrame, params: { [string]: any }): Rig.RigResult
	local R = Rig.new("drone", origin, params)
	local b = R.b
	local root = R:makeRoot(V(1.6, 0.6, 1.6), 1)
	local body = b:box(V(1.4, 0.5, 1.4), CF(0, 1, 0), rgb(40, 42, 48), { role = "primary", name = "Corpo" })
	R:join(body, root)
	local cam = b:ball(0.5, CF(0, 0.7, -0.6), rgb(20, 20, 20), { role = "fixed" })
	R:join(cam, body)
	local lens = b:ball(0.25, CF(0, 0.7, -0.85), rgb(255, 60, 60), { role = "eye", material = Enum.Material.Neon })
	R:join(lens, body)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + math.pi / 4
		local tip = V(math.cos(a) * 1.4, 1.1, math.sin(a) * 1.4)
		local arm = b:beam(V(0, 1, 0), tip, 0.18, rgb(60, 62, 70), { role = "secondary" })
		R:join(arm, body)
		local m = R:mark()
		b:part("cyl", V(0.05, 1.2, 1.2), CF(tip + V(0, 0.15, 0)) * ANG(0, 0, rad(90)), rgb(200, 220, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.5 })
		b:box(V(1.2, 0.06, 0.15), CF(tip + V(0, 0.18, 0)), rgb(30, 30, 30), { role = "fixed" })
		R:group(m, body, tip + V(0, 0.15, 0), { kind = "spin", axis = "Y", amp = 1, speed = 8 })
	end
	R.head = body
	R:setMouth(body, V(0, -0.3, -0.8))
	return R:finish({ hp = params.hp or 60, speed = params.speed or 24, hipHeight = 0.7, height = 1.5, flying = true, radius = 1.6 })
end

-- DISCO VOADOR -----------------------------------------------------------------------
function Monsters.ufo(origin: CFrame, params: { [string]: any }, _variant: string): Rig.RigResult
	local R = Rig.new("ufo", origin, params)
	local b = R.b
	local metal = rgb(170, 180, 190)
	local root = R:makeRoot(V(6, 1.6, 6), 2)
	local m = R:mark()
	b:part("cyl", V(0.9, 9, 9), CF(0, 2, 0) * ANG(0, 0, rad(90)), metal, { role = "primary", material = Enum.Material.DiamondPlate, name = "Corpo" })
	b:part("cyl", V(0.7, 6.5, 6.5), CF(0, 1.5, 0) * ANG(0, 0, rad(90)), Kit.darker(metal, 0.3), { role = "secondary" })
	b:part("ball", V(4, 3, 4), CF(0, 3, 0), rgb(140, 230, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.35 })
	-- piloto alienígena dentro da cúpula
	b:ball(1.1, CF(0, 3.3, 0), rgb(140, 200, 140), { role = "fixed" })
	for _, side in { -1, 1 } do
		b:part("ball", V(0.3, 0.45, 0.2), CF(side * 0.2, 3.4, -0.5), rgb(10, 10, 10), { role = "fixed" })
	end
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		b:ball(0.5, CF(math.cos(a) * 4.3, 2, math.sin(a) * 4.3), Kit.RainbowColors[(k % 6) + 1], { role = "accent", material = Enum.Material.Neon })
	end
	b:part("cyl", V(0.3, 2, 2), CF(0, 1.05, 0) * ANG(0, 0, rad(90)), rgb(120, 255, 160), { role = "accent", material = Enum.Material.Neon })
	local body = R:group(m, root, V(0, 2, 0), { kind = "spin", axis = "Y", amp = 1, speed = 0.4 })
	R.head = body
	if body then
		R:setMouth(body, V(0, -1, 0))
	end
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Color = rgb(120, 255, 160)
	light.Range = 40
	light.Angle = 50
	light.Brightness = 3
	light.Parent = root
	return R:finish({ hp = params.hp or 700, speed = params.speed or 24, hipHeight = 1.2, height = 4.5, flying = true, radius = 4.5 })
end

return Monsters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--!strict
-- Objetos, comidas e natureza. Tamanho "de brinquedo gigante": bem visível
-- no celular e engraçado (uma pizza de 6 studs, uma TV de 8 studs).
-- Também fornece árvores, pedras e cristais reutilizados pelo mapa.

local Kit = require(script.Parent.Kit)

local Props = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

export type PropResult = { model: Model, height: number, radius: number, main: BasePart }

type Fn = (b: any, rng: any) -> (number, number)

local function screen(part: BasePart, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(320, 200)
	gui.LightInfluence = 0
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(color, Color3.fromRGB(40, 20, 90))
	grad.Rotation = 45
	grad.Parent = f
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Parent = f
	gui.Parent = part
	part:AddTag("IdeiasTela")
end

local OBJ: { [string]: Fn } = {}

OBJ.tv = function(b, rng)
	b:box(V(10, 6.4, 1), CF(0, 5.5, 0), rgb(25, 25, 30), { role = "primary" })
	local scr = b:box(V(9.2, 5.6, 0.1), CF(0, 5.5, -0.52), rgb(60, 180, 255), { role = "fixed", material = Enum.Material.Neon })
	screen(scr, rng:pick({ "IDEIAS TV", "AO VIVO", "📺", "NOTÍCIAS" }), rgb(40, 120, 255))
	b:box(V(1, 2, 1), CF(0, 1.5, 0), rgb(40, 40, 45), { role = "secondary" })
	b:box(V(5, 0.4, 3), CF(0, 0.2, 0), rgb(40, 40, 45), { role = "secondary" })
	return 9, 5
end
OBJ.computer = function(b, _rng)
	b:box(V(7, 4.6, 0.6), CF(0, 4.6, 0), rgb(30, 30, 35), { role = "primary" })
	local scr = b:box(V(6.4, 4, 0.1), CF(0, 4.6, -0.32), rgb(80, 255, 160), { role = "fixed", material = Enum.Material.Neon })
	screen(scr, "> criar ideia_", rgb(10, 40, 20))
	b:box(V(0.6, 1.6, 0.6), CF(0, 1.6, 0.2), rgb(50, 50, 55), { role = "secondary" })
	b:box(V(6, 0.3, 2), CF(0, 0.15, -2.6), rgb(220, 220, 225), { role = "secondary" })
	b:box(V(2.2, 5, 4.6), CF(5.6, 2.5, 0.8), rgb(35, 35, 40), { role = "primary" })
	b:box(V(0.1, 0.4, 0.4), CF(4.48, 4, -1), rgb(80, 200, 255), { role = "accent", material = Enum.Material.Neon })
	return 7, 6
end
OBJ.phone = function(b, rng)
	b:box(V(4, 8, 0.5), CF(0, 4.3, 0) * ANG(rad(-10), 0, 0), rgb(30, 30, 35), { role = "primary" })
	local scr = b:box(V(3.6, 7.2, 0.1), CF(0, 4.3, -0.28) * ANG(rad(-10), 0, 0), rgb(255, 120, 200), { role = "fixed", material = Enum.Material.Neon })
	screen(scr, rng:pick({ "😂", "📱", "♥ 999+", "OI!" }), rgb(255, 90, 180))
	b:part("cyl", V(0.1, 0.5, 0.5), CF(-1.2, 7.7, 0.32) * ANG(rad(-10), rad(90), 0), rgb(20, 20, 20), { role = "fixed" })
	b:box(V(0.15, 1, 0.3), CF(2.05, 6, 0) * ANG(rad(-10), 0, 0), rgb(60, 60, 65), { role = "fixed" })
	b:box(V(3, 0.3, 2), CF(0, 0.15, 0.8), rgb(40, 40, 45), { role = "secondary" })
	return 9, 3
end
OBJ.arcade = function(b, rng)
	local col = rng:pick({ rgb(220, 40, 120), rgb(40, 120, 230), rgb(250, 170, 30) })
	b:box(V(4, 8, 3.4), CF(0, 4, 0), col, { role = "primary" })
	local scr = b:box(V(3.2, 2.6, 0.1), CF(0, 5.4, -1.72), rgb(40, 255, 200), { role = "fixed", material = Enum.Material.Neon })
	screen(scr, "GAME", rgb(20, 30, 60))
	b:part("wedge", V(4, 1, 1.6), CF(0, 3.6, -2.4) * ANG(0, rad(180), 0), Kit.darker(col, 0.3), { role = "secondary" })
	b:ball(0.6, CF(-0.8, 4.3, -2.6), rgb(255, 40, 40), { role = "accent" })
	b:ball(0.4, CF(0.6, 4.2, -2.6), rgb(255, 230, 40), { role = "accent", material = Enum.Material.Neon })
	return 8, 3
end
OBJ.table = function(b, rng)
	local wood = rng:pick({ rgb(150, 100, 60), rgb(110, 75, 45), rgb(220, 200, 170) })
	b:box(V(9, 0.6, 6), CF(0, 4, 0), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	for _, x in { -4, 4 } do
		for _, z in { -2.5, 2.5 } do
			b:box(V(0.6, 3.7, 0.6), CF(x, 1.85, z), Kit.darker(wood, 0.2), { role = "secondary" })
		end
	end
	return 4.5, 5
end
OBJ.chair = function(b, rng)
	local throne = rng:chance(0.25)
	local col = if throne then rgb(220, 180, 40) else rgb(140, 95, 55)
	b:box(V(4, 0.5, 4), CF(0, 2.8, 0), col, { role = "primary", material = if throne then Enum.Material.Foil else Enum.Material.WoodPlanks })
	b:box(V(4, if throne then 7 else 4.5, 0.5), CF(0, if throne then 6.3 else 5.2, 1.75), col, { role = "primary", material = if throne then Enum.Material.Foil else Enum.Material.WoodPlanks })
	for _, x in { -1.7, 1.7 } do
		for _, z in { -1.7, 1.7 } do
			b:box(V(0.4, 2.6, 0.4), CF(x, 1.3, z), Kit.darker(col, 0.2), { role = "secondary" })
		end
	end
	if throne then
		b:box(V(3.6, 0.6, 3.6), CF(0, 3.3, 0), rgb(170, 30, 50), { role = "accent", material = Enum.Material.Fabric })
	end
	return if throne then 10 else 7.5, 2.5
end
OBJ.sofa = function(b, rng)
	local col = rng:pick({ rgb(200, 60, 60), rgb(60, 110, 200), rgb(120, 170, 90), rgb(130, 100, 160) })
	b:box(V(10, 2, 4), CF(0, 1.5, 0), col, { role = "primary", material = Enum.Material.Fabric })
	b:box(V(10, 3.4, 1.2), CF(0, 3.2, 1.6), col, { role = "primary", material = Enum.Material.Fabric })
	for _, x in { -5.2, 5.2 } do
		b:box(V(1.2, 3, 4), CF(x, 2, 0), Kit.darker(col, 0.15), { role = "secondary", material = Enum.Material.Fabric })
	end
	return 5, 5.5
end
OBJ.bed = function(b, rng)
	local col = rng:pick({ rgb(90, 140, 230), rgb(240, 120, 170), rgb(120, 200, 140) })
	b:box(V(7, 1.6, 11), CF(0, 1.3, 0), rgb(150, 105, 65), { role = "secondary", material = Enum.Material.WoodPlanks })
	b:box(V(6.6, 1, 10.4), CF(0, 2.6, 0), rgb(250, 250, 250), { role = "fixed", material = Enum.Material.Fabric })
	b:box(V(6.8, 0.5, 6.5), CF(0, 3.2, 1.8), col, { role = "primary", material = Enum.Material.Fabric })
	b:box(V(4, 0.9, 2), CF(0, 3.4, -4), rgb(250, 250, 250), { role = "fixed", material = Enum.Material.Fabric })
	b:box(V(7, 4, 0.6), CF(0, 3, -5.4), rgb(150, 105, 65), { role = "secondary", material = Enum.Material.WoodPlanks })
	return 5, 6
end
OBJ.lamp = function(b, rng)
	local col = rng:pick({ rgb(255, 200, 120), rgb(255, 150, 200), rgb(150, 220, 255) })
	b:cylY(0.5, 3, CF(0, 0.25, 0), rgb(50, 50, 55), { role = "secondary" })
	b:cylY(8, 0.4, CF(0, 4.5, 0), rgb(60, 60, 65), { role = "secondary", material = Enum.Material.Metal })
	local shade = b:cone(3, 4, CF(0, 7.5, 0), col, 3, { role = "primary", material = Enum.Material.Fabric })
	local bulb = b:ball(1.4, CF(0, 8, 0), rgb(255, 250, 220), { role = "fixed", material = Enum.Material.Neon })
	b:light(bulb, col, 22, 2)
	local _ = shade
	return 10.5, 2
end
OBJ.fridge = function(b, _rng)
	b:box(V(5, 10, 4.4), CF(0, 5, 0), rgb(235, 240, 245), { role = "primary", material = Enum.Material.Metal })
	b:box(V(4.9, 0.15, 0.1), CF(0, 6.6, -2.25), rgb(150, 150, 160), { role = "fixed" })
	for _, y in { 4, 8 } do
		b:box(V(0.3, 1.6, 0.3), CF(1.8, y, -2.4), rgb(160, 160, 170), { role = "fixed", material = Enum.Material.Metal })
	end
	b:ball(0.8, CF(-1, 8.6, -2.25), rgb(255, 80, 80), { role = "accent" })
	return 10, 3
end
OBJ.piano = function(b, _rng)
	b:box(V(10, 5, 5), CF(0, 4, 1), rgb(20, 20, 25), { role = "primary", reflectance = 0.2 })
	b:box(V(9.6, 0.5, 1.6), CF(0, 4.2, -2.2), rgb(250, 250, 250), { role = "fixed" })
	for k = -6, 6 do
		if k % 7 ~= 2 and k % 7 ~= 6 then
			b:box(V(0.35, 0.3, 1), CF(k * 0.7 + 0.35, 4.55, -2.0), rgb(15, 15, 15), { role = "fixed" })
		end
	end
	for _, x in { -4.5, 4.5 } do
		b:box(V(0.6, 2, 0.6), CF(x, 1, -1.5), rgb(20, 20, 25), { role = "secondary" })
	end
	return 7, 5.5
end
OBJ.guitar = function(b, rng)
	local col = rng:pick({ rgb(200, 40, 40), rgb(230, 150, 50), rgb(40, 40, 45) })
	b:part("ball", V(4, 5, 1.2), CF(0, 3, 0), col, { role = "primary" })
	b:part("ball", V(3.2, 3.6, 1.2), CF(0, 5.5, 0), col, { role = "primary" })
	b:part("cyl", V(0.1, 1.2, 1.2), CF(0, 4.2, -0.62) * ANG(0, rad(90), 0), rgb(20, 20, 20), { role = "fixed" })
	b:box(V(0.8, 6, 0.4), CF(0, 9.6, 0), rgb(110, 75, 45), { role = "secondary" })
	b:box(V(1.4, 1.4, 0.5), CF(0, 13.2, 0), rgb(90, 60, 35), { role = "secondary" })
	return 14, 2.5
end
OBJ.drum = function(b, _rng)
	b:cylY(3, 5, CF(0, 1.5, 0), rgb(200, 40, 50), { role = "primary" })
	b:cylY(0.2, 5.1, CF(0, 3.05, 0), rgb(245, 245, 245), { role = "fixed" })
	for _, x in { -4, 4 } do
		b:cylY(2.4, 3, CF(x, 3.2, 1), rgb(200, 40, 50), { role = "primary" })
		b:cylY(5, 0.2, CF(x * 1.3, 2.5, -1.5), rgb(190, 190, 200), { role = "fixed", material = Enum.Material.Metal })
		b:cylY(0.1, 3.4, CF(x * 1.3, 5, -1.5), rgb(250, 210, 60), { role = "fixed", material = Enum.Material.Foil })
	end
	return 5, 6
end
OBJ.clock = function(b, _rng)
	b:part("cyl", V(1, 8, 8), CF(0, 6, 0) * ANG(0, rad(90), 0), rgb(160, 110, 60), { role = "primary", material = Enum.Material.Wood })
	b:part("cyl", V(0.2, 7, 7), CF(0, 6, -0.55) * ANG(0, rad(90), 0), rgb(250, 245, 230), { role = "fixed" })
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		b:box(V(0.3, 0.6, 0.1), CF(math.sin(a) * 3, 6 + math.cos(a) * 3, -0.7) * ANG(0, 0, -a), rgb(30, 30, 30), { role = "fixed" })
	end
	local hand = b:box(V(0.25, 2.6, 0.1), CF(0, 7.2, -0.75), rgb(20, 20, 20), { role = "fixed", name = "Ponteiro" })
	hand:AddTag("IdeiasGirar")
	hand:SetAttribute("GirarEixo", "Z")
	hand:SetAttribute("GirarVel", 1)
	hand:SetAttribute("GirarPivo", Vector3.new(0, -1.2, 0))
	b:box(V(2, 2, 2), CF(0, 1, 0), rgb(140, 95, 50), { role = "secondary" })
	return 10, 4
end
OBJ.book = function(b, rng)
	local col = rng:pick({ rgb(160, 40, 40), rgb(40, 80, 160), rgb(60, 130, 70), rgb(120, 60, 150) })
	b:box(V(6, 1.4, 8), CF(0, 0.7, 0), rgb(245, 240, 225), { role = "fixed" })
	b:box(V(6.4, 0.25, 8.4), CF(0, 0.12, 0), col, { role = "primary" })
	b:box(V(6.4, 0.25, 8.4), CF(0, 1.5, 0), col, { role = "primary" })
	b:box(V(0.4, 1.6, 8.4), CF(-3.2, 0.8, 0), col, { role = "primary" })
	b:box(V(2, 2, 0.1), CF(0, 1.65, 0) * ANG(rad(90), 0, 0), rgb(255, 215, 60), { role = "accent", material = Enum.Material.Neon })
	return 2, 4.5
end
OBJ.ball = function(b, rng)
	local kind = rng:int(1, 3)
	if kind == 1 then
		b:ball(5, CF(0, 2.5, 0), rgb(250, 250, 250), { role = "primary" })
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			b:ball(1.2, CF(math.cos(a) * 2.1, 2.5 + math.sin(a) * 2.1, -0.6), rgb(25, 25, 30), { role = "fixed" })
		end
	elseif kind == 2 then
		b:ball(5, CF(0, 2.5, 0), rgb(240, 120, 40), { role = "primary" })
		b:part("cyl", V(0.1, 5.05, 5.05), CF(0, 2.5, 0), rgb(30, 20, 15), { role = "fixed" })
		b:part("cyl", V(0.1, 5.05, 5.05), CF(0, 2.5, 0) * ANG(0, rad(90), 0), rgb(30, 20, 15), { role = "fixed" })
	else
		b:ball(5, CF(0, 2.5, 0), rgb(255, 80, 80), { role = "primary" })
		b:part("cyl", V(1.6, 5.05, 5.05), CF(0, 2.5, 0), rgb(255, 230, 60), { role = "fixed" })
		b:part("cyl", V(1.6, 5.05, 5.05), CF(0, 2.5, 0) * ANG(0, rad(90), 0), rgb(60, 140, 255), { role = "fixed" })
	end
	return 5, 2.5
end
OBJ.balloon = function(b, rng)
	local col = rng:pick(Kit.RainbowColors)
	b:part("ball", V(4, 4.8, 4), CF(0, 9, 0), col, { role = "primary", reflectance = 0.15 })
	b:part("wedge", V(0.6, 0.6, 0.6), CF(0, 6.4, 0) * ANG(rad(180), 0, 0), col, { role = "primary" })
	b:box(V(0.08, 6, 0.08), CF(0, 3.2, 0), rgb(240, 240, 240), { role = "fixed" })
	return 11.5, 2
end
OBJ.gift = function(b, rng)
	local col = rng:pick(Kit.RainbowColors)
	b:box(V(5, 5, 5), CF(0, 2.5, 0), col, { role = "primary" })
	b:box(V(5.1, 5.1, 1), CF(0, 2.5, 0), rgb(255, 230, 80), { role = "fixed" })
	b:box(V(1, 5.1, 5.1), CF(0, 2.5, 0), rgb(255, 230, 80), { role = "fixed" })
	b:box(V(5.4, 1, 5.4), CF(0, 5.3, 0), Kit.darker(col, 0.1), { role = "secondary" })
	for _, s in { -1, 1 } do
		b:part("ball", V(1.8, 1.2, 1.2), CF(s * 0.9, 6.2, 0) * ANG(0, 0, s * rad(30)), rgb(255, 230, 80), { role = "fixed" })
	end
	return 7, 3
end
OBJ.chest = function(b, _rng)
	local wood = rgb(130, 85, 45)
	b:box(V(7, 4, 4.6), CF(0, 2, 0), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	b:part("cyl", V(7, 4.6, 4.6), CF(0, 4, 0), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	for _, x in { -2.6, 2.6 } do
		b:box(V(0.5, 4.2, 4.8), CF(x, 2.1, 0), rgb(220, 180, 60), { role = "fixed", material = Enum.Material.Foil })
	end
	b:box(V(1, 1.2, 0.3), CF(0, 3.2, -2.4), rgb(240, 200, 60), { role = "fixed", material = Enum.Material.Foil })
	local glow = b:ball(2, CF(0, 4.4, 0), rgb(255, 215, 80), { role = "fixed", material = Enum.Material.Neon, transparency = 0.5, collide = false })
	b:light(glow, rgb(255, 210, 90), 14, 2)
	return 6.5, 4
end
OBJ.coin = function(b, _rng)
	b:part("cyl", V(0.5, 4, 4), CF(0, 2.2, 0) * ANG(0, rad(90), 0), rgb(255, 205, 50), { role = "primary", material = Enum.Material.Foil })
	b:box(V(1, 1.6, 0.6), CF(0, 2.2, 0), rgb(240, 180, 40), { role = "fixed", material = Enum.Material.Foil })
	b:part("cyl", V(0.6, 4.2, 4.2), CF(0, 2.2, 0) * ANG(0, rad(90), 0), rgb(230, 175, 40), { role = "fixed", material = Enum.Material.Foil, transparency = 0.6 })
	local glint = b:ball(0.5, CF(1.2, 3.3, -0.3), rgb(255, 250, 220), { role = "fixed", material = Enum.Material.Neon })
	local _ = glint
	return 4.2, 2
end
OBJ.gem = function(b, rng)
	local col = rng:pick({ rgb(120, 220, 255), rgb(255, 60, 90), rgb(60, 220, 120), rgb(70, 110, 255) })
	b:part("wedge", V(3, 3, 3), CF(0, 4.5, 0), col, { role = "primary", material = Enum.Material.Glass, transparency = 0.15, reflectance = 0.3 })
	b:part("wedge", V(3, 3, 3), CF(0, 4.5, 0) * ANG(0, rad(180), 0), col, { role = "primary", material = Enum.Material.Glass, transparency = 0.15, reflectance = 0.3 })
	b:part("wedge", V(3, 3, 3), CF(0, 1.5, 0) * ANG(rad(180), 0, 0), col, { role = "primary", material = Enum.Material.Glass, transparency = 0.15 })
	b:part("wedge", V(3, 3, 3), CF(0, 1.5, 0) * ANG(rad(180), rad(180), 0), col, { role = "primary", material = Enum.Material.Glass, transparency = 0.15 })
	local core = b:ball(1.2, CF(0, 3, 0), col, { role = "accent", material = Enum.Material.Neon })
	b:light(core, col, 14, 2)
	return 6, 2
end
OBJ.crown = function(b, _rng)
	local gold = rgb(255, 205, 50)
	b:part("cyl", V(1.6, 5, 5), CF(0, 0.8, 0) * ANG(0, 0, rad(90)), gold, { role = "primary", material = Enum.Material.Foil })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b:part("wedge", V(1.0, 2, 0.4), CF(math.cos(a) * 2.2, 2.6, math.sin(a) * 2.2) * ANG(0, -a + math.pi / 2, 0), gold, { role = "primary", material = Enum.Material.Foil })
		b:ball(0.5, CF(math.cos(a) * 2.4, 1, math.sin(a) * 2.4), Kit.RainbowColors[(k % 6) + 1], { role = "accent", material = Enum.Material.Neon })
	end
	return 3.6, 2.5
end
OBJ.trophy = function(b, _rng)
	local gold = rgb(255, 205, 50)
	b:box(V(3, 1.4, 3), CF(0, 0.7, 0), rgb(40, 40, 45), { role = "secondary" })
	b:cylY(2.6, 0.7, CF(0, 2.7, 0), gold, { role = "primary", material = Enum.Material.Foil })
	b:part("ball", V(3.4, 3.4, 3.4), CF(0, 5.4, 0), gold, { role = "primary", material = Enum.Material.Foil })
	for _, s in { -1, 1 } do
		b:part("cyl", V(0.4, 1.6, 1.6), CF(s * 2, 5.6, 0), gold, { role = "primary", material = Enum.Material.Foil })
	end
	return 7, 2
end
OBJ.barrel = function(b, _rng)
	b:cylY(5, 3.6, CF(0, 2.5, 0), rgb(200, 40, 35), { role = "primary" })
	for _, y in { 0.8, 4.2 } do
		b:cylY(0.4, 3.7, CF(0, y, 0), rgb(60, 60, 65), { role = "fixed", material = Enum.Material.Metal })
	end
	b:box(V(1.6, 1.6, 0.1), CF(0, 2.5, -1.82) * ANG(0, 0, rad(45)), rgb(255, 220, 40), { role = "fixed" })
	return 5, 2
end
OBJ.crate = function(b, _rng)
	local wood = rgb(170, 125, 70)
	b:box(V(5, 5, 5), CF(0, 2.5, 0), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	for _, s in { -1, 1 } do
		b:box(V(5.1, 0.5, 0.5), CF(0, 2.5 + s * 2.2, -2.3), Kit.darker(wood, 0.25), { role = "secondary" })
	end
	b:box(V(0.5, 6.4, 0.5), CF(0, 2.5, -2.4) * ANG(0, 0, rad(45)), Kit.darker(wood, 0.25), { role = "secondary" })
	return 5, 2.5
end
OBJ.tnt = function(b, _rng)
	for k = -1, 1 do
		b:cylY(5, 1.6, CF(k * 1.6, 2.5, 0), rgb(220, 40, 35), { role = "primary" })
	end
	b:box(V(5, 1.2, 1.8), CF(0, 2.5, 0), rgb(245, 240, 230), { role = "fixed" })
	local fuse = b:box(V(0.15, 1.2, 0.15), CF(0, 5.5, 0), rgb(40, 40, 40), { role = "fixed", name = "Pavio" })
	local sp = Instance.new("Sparkles")
	sp.SparkleColor = rgb(255, 200, 80)
	sp.Parent = fuse
	return 6, 2.5
end
OBJ.cannon = function(b, _rng)
	b:box(V(4, 1.6, 6), CF(0, 1.4, 0), rgb(120, 80, 45), { role = "secondary", material = Enum.Material.WoodPlanks })
	for _, s in { -1, 1 } do
		b:part("cyl", V(0.6, 3, 3), CF(s * 2.2, 1.5, 0), rgb(90, 60, 35), { role = "secondary" })
	end
	b:part("cyl", V(7, 2, 2), CF(0, 3, -1.5) * ANG(rad(20), rad(90), 0), rgb(40, 40, 45), { role = "primary", material = Enum.Material.Metal })
	b:ball(2.4, CF(0, 2.6, 1.8), rgb(40, 40, 45), { role = "primary", material = Enum.Material.Metal })
	return 5, 4
end
OBJ.magnet = function(b, _rng)
	for _, s in { -1, 1 } do
		b:box(V(1.8, 6, 1.8), CF(s * 2.2, 4, 0), rgb(220, 40, 40), { role = "primary" })
		b:box(V(1.8, 1.4, 1.8), CF(s * 2.2, 0.7, 0), rgb(220, 220, 230), { role = "fixed", material = Enum.Material.Metal })
	end
	b:part("cyl", V(1.8, 6.2, 6.2), CF(0, 7, 0), rgb(220, 40, 40), { role = "primary" })
	return 10, 4
end
OBJ.disco_ball = function(b, _rng)
	b:box(V(0.2, 6, 0.2), CF(0, 13, 0), rgb(200, 200, 210), { role = "fixed" })
	local ball = b:ball(5, CF(0, 9, 0), rgb(220, 225, 235), { role = "primary", material = Enum.Material.Foil, reflectance = 0.6, name = "Globo" })
	ball:AddTag("IdeiasGirar")
	ball:SetAttribute("GirarEixo", "Y")
	ball:SetAttribute("GirarVel", 1)
	for k = 0, 3 do
		local l = Instance.new("SpotLight")
		l.Color = Kit.RainbowColors[k + 1]
		l.Brightness = 4
		l.Range = 40
		l.Angle = 30
		l.Face = ({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right })[k + 1]
		l.Parent = ball
	end
	b:cylY(0.6, 6, CF(0, 0.3, 0), rgb(40, 40, 50), { role = "secondary" })
	b:cylY(16, 0.3, CF(0, 8, 2), rgb(40, 40, 50), { role = "secondary" })
	return 16, 3
end
OBJ.campfire = function(b, _rng)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b:ball(1.3, CF(math.cos(a) * 2.6, 0.5, math.sin(a) * 2.6), rgb(120, 120, 125), { role = "fixed", material = Enum.Material.Slate })
	end
	for k = 0, 3 do
		local a = k / 4 * math.pi
		b:box(V(0.7, 0.7, 4), CF(0, 0.6, 0) * ANG(0, a, 0), rgb(110, 70, 40), { role = "secondary", material = Enum.Material.Wood })
	end
	local core = b:ball(1.4, CF(0, 1.4, 0), rgb(255, 140, 40), { role = "fixed", material = Enum.Material.Neon, collide = false })
	local f = Instance.new("Fire")
	f.Size = 7
	f.Heat = 10
	f.Parent = core
	b:light(core, rgb(255, 150, 60), 26, 2.5)
	return 3, 3.5
end
OBJ.bench = function(b, _rng)
	local wood = rgb(150, 100, 60)
	for k = 0, 2 do
		b:box(V(9, 0.4, 0.9), CF(0, 2.4, -0.9 + k * 1), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	end
	b:box(V(9, 1.6, 0.4), CF(0, 3.6, 1.3) * ANG(rad(-10), 0, 0), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	for _, x in { -3.8, 3.8 } do
		b:box(V(0.5, 2.4, 3), CF(x, 1.2, 0.2), rgb(40, 40, 45), { role = "secondary", material = Enum.Material.Metal })
	end
	return 4.5, 4.5
end
OBJ.flag = function(b, _rng)
	b:cylY(14, 0.5, CF(0, 7, 0), rgb(220, 220, 225), { role = "fixed", material = Enum.Material.Metal })
	local cloth = b:box(V(0.2, 4, 6.4), CF(0, 11.6, -3.3), rgb(30, 160, 70), { role = "primary", material = Enum.Material.Fabric })
	b:box(V(0.25, 2.4, 3.6), CF(0, 11.6, -3.3) * ANG(rad(45), 0, 0), rgb(255, 220, 40), { role = "fixed", material = Enum.Material.Fabric })
	b:part("cyl", V(0.3, 1.6, 1.6), CF(0, 11.6, -3.3), rgb(40, 70, 170), { role = "fixed" })
	local _ = cloth
	return 14, 3.5
end
OBJ.toilet = function(b, rng)
	local gold = rng:chance(0.15)
	local col = if gold then rgb(255, 205, 50) else rgb(250, 250, 252)
	local mat = if gold then Enum.Material.Foil else Enum.Material.SmoothPlastic
	b:cylY(2.6, 3, CF(0, 1.3, -0.4), col, { role = "primary", material = mat })
	b:part("cyl", V(0.7, 4.4, 5.2), CF(0, 2.9, -0.8) * ANG(0, 0, rad(90)), col, { role = "primary", material = mat })
	b:part("cyl", V(0.2, 3.4, 4.2), CF(0, 3.3, -0.8) * ANG(0, 0, rad(90)), rgb(120, 190, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.3 })
	b:box(V(4.4, 4, 1.8), CF(0, 4.4, 2.2), col, { role = "primary", material = mat })
	return 6.4, 3
end
OBJ.umbrella = function(b, rng)
	local col = rng:pick(Kit.RainbowColors)
	b:cylY(10, 0.35, CF(0, 5, 0), rgb(220, 220, 225), { role = "fixed", material = Enum.Material.Metal })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b:part("wedge", V(2.6, 1.6, 4.4), CF(math.cos(a) * 2, 9.6, math.sin(a) * 2) * ANG(0, -a - math.pi / 2, 0), if k % 2 == 0 then col else rgb(250, 250, 250), { role = "fixed", material = Enum.Material.Fabric })
	end
	return 11, 5
end
OBJ.rubber_duck = function(b, _rng)
	local y = rgb(255, 215, 40)
	b:part("ball", V(6, 4.4, 7), CF(0, 2.2, 0.5), y, { role = "primary" })
	b:ball(3.8, CF(0, 5.2, -1.4), y, { role = "primary" })
	b:box(V(1.8, 0.6, 1.6), CF(0, 4.9, -3.6), rgb(255, 130, 30), { role = "fixed" })
	for _, s in { -1, 1 } do
		b:ball(0.5, CF(s * 0.8, 5.8, -3.1), rgb(20, 20, 20), { role = "eye" })
	end
	b:part("wedge", V(2, 1.6, 1.6), CF(0, 3.4, 3.8) * ANG(rad(-30), 0, 0), y, { role = "primary" })
	return 7, 3.5
end
OBJ.teddy = function(b, rng)
	local col = rng:pick({ rgb(170, 120, 75), rgb(250, 180, 200), rgb(200, 200, 210) })
	local m = Enum.Material.Fabric
	b:part("ball", V(4, 4.6, 3.6), CF(0, 2.6, 0), col, { role = "primary", material = m })
	b:ball(3.4, CF(0, 6, 0), col, { role = "primary", material = m })
	for _, s in { -1, 1 } do
		b:ball(1.3, CF(s * 1.4, 7.4, 0), col, { role = "primary", material = m })
		b:ball(1.6, CF(s * 2.2, 3.2, -0.3), col, { role = "primary", material = m })
		b:ball(1.8, CF(s * 1.2, 0.8, -0.8), col, { role = "primary", material = m })
		b:ball(0.4, CF(s * 0.6, 6.4, -1.5), rgb(20, 20, 20), { role = "eye" })
	end
	b:ball(1.3, CF(0, 5.6, -1.4), Kit.lighter(col, 0.4), { role = "secondary", material = m })
	b:ball(0.4, CF(0, 5.9, -2.0), rgb(30, 20, 20), { role = "fixed" })
	b:part("wedge", V(2, 1, 0.4), CF(0, 4.6, -1.7), rgb(220, 40, 60), { role = "accent" })
	return 8, 3
end
OBJ.snowman = function(b, _rng)
	local snow = rgb(250, 252, 255)
	b:ball(6, CF(0, 3, 0), snow, { role = "primary", material = Enum.Material.Snow })
	b:ball(4.4, CF(0, 7.6, 0), snow, { role = "primary", material = Enum.Material.Snow })
	b:ball(3.2, CF(0, 10.9, 0), snow, { role = "primary", material = Enum.Material.Snow })
	b:cone(1.6, 0.5, CF(0, 10.9, -1.5) * ANG(rad(-90), 0, 0), rgb(255, 130, 30), 2, { role = "fixed" })
	for _, s in { -1, 1 } do
		b:ball(0.4, CF(s * 0.6, 11.4, -1.4), rgb(20, 20, 20), { role = "eye" })
		b:beam(V(s * 2, 8, 0), V(s * 4.4, 9.6, 0), 0.25, rgb(110, 70, 40), { role = "fixed" })
	end
	b:part("cyl", V(0.25, 3.6, 3.6), CF(0, 12.4, 0) * ANG(0, 0, rad(90)), rgb(25, 25, 30), { role = "fixed" })
	b:cylY(2, 2.4, CF(0, 13.5, 0), rgb(25, 25, 30), { role = "fixed" })
	b:part("cyl", V(4.6, 0.6, 0.6), CF(0, 9.3, 0) * ANG(0, 0, rad(90)), rgb(220, 40, 40), { role = "accent" })
	return 14.5, 3
end
OBJ.pumpkin = function(b, _rng)
	local o = rgb(250, 130, 30)
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:part("ball", V(3, 5, 3), CF(math.cos(a) * 1.4, 2.5, math.sin(a) * 1.4), o, { role = "primary" })
	end
	b:cylY(1.4, 0.6, CF(0, 5.4, 0), rgb(70, 120, 40), { role = "fixed" })
	for _, s in { -1, 1 } do
		b:part("wedge", V(0.8, 0.8, 0.2), CF(s * 0.9, 3.2, -2.75), rgb(255, 230, 80), { role = "fixed", material = Enum.Material.Neon })
	end
	b:box(V(2.2, 0.5, 0.2), CF(0, 1.8, -2.8), rgb(255, 230, 80), { role = "fixed", material = Enum.Material.Neon })
	return 6, 3
end
OBJ.xmas_tree = function(b, _rng)
	b:cylY(2, 1.4, CF(0, 1, 0), rgb(110, 70, 40), { role = "fixed" })
	for k = 0, 3 do
		b:cone(5, 11 - k * 2.4, CF(0, 2 + k * 3.4, 0), rgb(40, 130, 60), 3, { role = "primary" })
	end
	for k = 0, 11 do
		local a = k * 1.7
		local y = 3 + (k % 6) * 2
		local r = 4.4 - (k % 6) * 0.7
		b:ball(0.8, CF(math.cos(a) * r, y, math.sin(a) * r), Kit.RainbowColors[(k % 6) + 1], { role = "accent", material = Enum.Material.Neon })
	end
	local star = b:ball(1.6, CF(0, 17.5, 0), rgb(255, 225, 60), { role = "fixed", material = Enum.Material.Neon })
	b:light(star, rgb(255, 220, 120), 20, 2)
	return 18.5, 5.5
end
OBJ.toy_car = function(b, rng)
	local col = rng:pick(Kit.RainbowColors)
	b:box(V(3, 1.2, 5), CF(0, 1.2, 0), col, { role = "primary" })
	b:box(V(2.6, 1, 2.4), CF(0, 2.3, 0.4), rgb(150, 210, 240), { role = "fixed", material = Enum.Material.Glass, transparency = 0.2 })
	for _, x in { -1.6, 1.6 } do
		for _, z in { -1.6, 1.6 } do
			b:part("cyl", V(0.6, 1.4, 1.4), CF(x, 0.7, z), rgb(30, 30, 35), { role = "fixed" })
		end
	end
	return 3, 2.5
end
OBJ.hat = function(b, rng)
	local col = rng:pick({ rgb(30, 30, 35), rgb(170, 40, 50), rgb(140, 95, 50) })
	b:part("cyl", V(0.4, 7, 7), CF(0, 0.2, 0) * ANG(0, 0, rad(90)), col, { role = "primary", material = Enum.Material.Fabric })
	b:cylY(4.4, 4, CF(0, 2.6, 0), col, { role = "primary", material = Enum.Material.Fabric })
	b:cylY(0.8, 4.1, CF(0, 1.2, 0), rgb(220, 40, 60), { role = "accent" })
	return 5, 3.5
end
OBJ.mirror = function(b, _rng)
	b:box(V(6, 10, 0.6), CF(0, 6, 0), rgb(220, 180, 60), { role = "primary", material = Enum.Material.Foil })
	b:box(V(5, 9, 0.1), CF(0, 6, -0.32), rgb(220, 235, 255), { role = "fixed", material = Enum.Material.Glass, reflectance = 0.9 })
	b:box(V(4, 1, 2), CF(0, 0.5, 0), rgb(220, 180, 60), { role = "primary", material = Enum.Material.Foil })
	return 11, 3
end
OBJ.vacuum = function(b, _rng)
	b:cylY(1.2, 5, CF(0, 0.6, 0), rgb(40, 40, 45), { role = "primary" })
	b:cylY(0.2, 4.4, CF(0, 1.25, 0), rgb(150, 150, 160), { role = "secondary", material = Enum.Material.Metal })
	b:ball(0.6, CF(0, 1.4, -1.5), rgb(80, 220, 255), { role = "accent", material = Enum.Material.Neon })
	return 1.4, 2.5
end
OBJ.fan = function(b, _rng)
	b:cylY(0.6, 4, CF(0, 0.3, 0), rgb(240, 240, 245), { role = "secondary" })
	b:cylY(7, 0.6, CF(0, 3.8, 0), rgb(240, 240, 245), { role = "secondary" })
	local hub = b:part("cyl", V(1, 1.4, 1.4), CF(0, 8, -0.6) * ANG(0, rad(90), 0), rgb(80, 160, 255), { role = "primary", name = "Helice" })
	hub:AddTag("IdeiasGirar")
	hub:SetAttribute("GirarEixo", "Z")
	hub:SetAttribute("GirarVel", 6)
	for k = 0, 2 do
		local blade = b:box(V(1.4, 3.4, 0.2), CF(0, 8, -0.8) * ANG(0, 0, k / 3 * math.pi * 2) * CF(0, 1.8, 0), rgb(80, 160, 255), { role = "primary" })
		blade.Parent = hub
	end
	return 10, 2.5
end
OBJ.speaker = function(b, _rng)
	b:box(V(5, 9, 4), CF(0, 4.5, 0), rgb(30, 30, 35), { role = "primary" })
	for _, y in { 2.6, 6.6 } do
		b:part("cyl", V(0.3, 3.2, 3.2), CF(0, y, -2.05) * ANG(0, rad(90), 0), rgb(60, 60, 70), { role = "secondary" })
		b:part("cyl", V(0.35, 1.2, 1.2), CF(0, y, -2.1) * ANG(0, rad(90), 0), rgb(255, 60, 200), { role = "accent", material = Enum.Material.Neon })
	end
	return 9, 3
end
OBJ.sign = function(b, rng)
	b:cylY(8, 0.5, CF(-3, 4, 0), rgb(200, 200, 205), { role = "fixed", material = Enum.Material.Metal })
	b:cylY(8, 0.5, CF(3, 4, 0), rgb(200, 200, 205), { role = "fixed", material = Enum.Material.Metal })
	local board = b:box(V(8, 4, 0.4), CF(0, 9, 0), rgb(40, 130, 70), { role = "primary" })
	screen(board, rng:pick({ "IDEIAS SEM LIMITES", "CUIDADO: DRAGÕES", "PROIBIDO ENTEDIAR", "CRIE ALGO!" }), rgb(30, 110, 60))
	return 11, 4
end

-- COMIDAS -------------------------------------------------------------------------
local FOOD: { [string]: Fn } = {}

FOOD.pizza = function(b, _rng)
	b:part("cyl", V(0.8, 9, 9), CF(0, 0.4, 0) * ANG(0, 0, rad(90)), rgb(230, 170, 90), { role = "secondary" })
	b:part("cyl", V(0.3, 8, 8), CF(0, 0.9, 0) * ANG(0, 0, rad(90)), rgb(250, 210, 90), { role = "primary" })
	for k = 0, 7 do
		local a = k * 0.8
		local r = 1.5 + (k % 3) * 1.1
		b:part("cyl", V(0.3, 1.4, 1.4), CF(math.cos(a) * r, 1.1, math.sin(a) * r) * ANG(0, 0, rad(90)), rgb(200, 50, 40), { role = "accent" })
	end
	return 1.3, 4.5
end
FOOD.burger = function(b, _rng)
	b:part("ball", V(7, 3.4, 7), CF(0, 4.6, 0), rgb(220, 150, 70), { role = "primary" })
	b:part("cyl", V(0.5, 7.2, 7.2), CF(0, 3.2, 0) * ANG(0, 0, rad(90)), rgb(250, 210, 60), { role = "fixed" })
	b:part("cyl", V(1.2, 6.8, 6.8), CF(0, 2.4, 0) * ANG(0, 0, rad(90)), rgb(110, 60, 35), { role = "secondary" })
	b:part("cyl", V(0.4, 7.4, 7.4), CF(0, 1.6, 0) * ANG(0, 0, rad(90)), rgb(90, 190, 60), { role = "fixed" })
	b:part("cyl", V(1.2, 6.8, 6.8), CF(0, 0.8, 0) * ANG(0, 0, rad(90)), rgb(220, 150, 70), { role = "primary" })
	for k = 0, 5 do
		local a = k * 1.05
		b:ball(0.3, CF(math.cos(a) * 1.8, 6.2, math.sin(a) * 1.8), rgb(250, 240, 210), { role = "fixed" })
	end
	return 6.3, 3.7
end
FOOD.hotdog = function(b, _rng)
	b:part("ball", V(3, 2.4, 9), CF(0, 1.2, 0), rgb(230, 170, 90), { role = "primary" })
	b:part("cyl", V(10, 1.6, 1.6), CF(0, 2.2, 0) * ANG(0, rad(90), 0), rgb(200, 80, 50), { role = "secondary" })
	for k = -3, 3 do
		b:box(V(0.3, 0.2, 1.2), CF(math.sin(k) * 0.3, 3.05, k * 1.1) * ANG(0, rad(30 * k), 0), rgb(250, 210, 40), { role = "fixed" })
	end
	return 3, 5
end
FOOD.cake = function(b, rng)
	local icing = rng:pick({ rgb(255, 170, 200), rgb(250, 250, 250), rgb(120, 70, 40) })
	b:cylY(3, 8, CF(0, 1.5, 0), rgb(240, 210, 160), { role = "secondary" })
	b:cylY(0.6, 8.3, CF(0, 3.2, 0), icing, { role = "primary" })
	b:cylY(2.6, 5.6, CF(0, 4.8, 0), rgb(240, 210, 160), { role = "secondary" })
	b:cylY(0.5, 5.9, CF(0, 6.3, 0), icing, { role = "primary" })
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		local c = b:cylY(1.6, 0.35, CF(math.cos(a) * 1.8, 7.3, math.sin(a) * 1.8), Kit.RainbowColors[k + 1], { role = "fixed" })
		local flame = b:ball(0.4, CF(math.cos(a) * 1.8, 8.3, math.sin(a) * 1.8), rgb(255, 200, 60), { role = "fixed", material = Enum.Material.Neon })
		local _ = c
		local _f = flame
	end
	b:ball(1.4, CF(0, 7.2, 0), rgb(220, 30, 50), { role = "accent" })
	return 8.5, 4.2
end
FOOD.donut = function(b, rng)
	local icing = rng:pick({ rgb(255, 140, 190), rgb(110, 60, 30), rgb(250, 250, 250) })
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		b:ball(2.6, CF(math.cos(a) * 2.6, 1.3, math.sin(a) * 2.6), rgb(220, 160, 80), { role = "secondary" })
		b:part("ball", V(2.4, 1.2, 2.4), CF(math.cos(a) * 2.6, 2.2, math.sin(a) * 2.6), icing, { role = "primary" })
		b:box(V(0.6, 0.15, 0.15), CF(math.cos(a) * 2.6, 2.85, math.sin(a) * 2.6) * ANG(0, a * 3, 0), Kit.RainbowColors[(k % 6) + 1], { role = "fixed" })
	end
	return 3, 4
end
FOOD.icecream = function(b, rng)
	b:cone(6, 3.4, CF(0, 6, 0) * ANG(rad(180), 0, 0), rgb(220, 170, 100), 4, { role = "secondary" })
	local flavors = { rgb(255, 180, 210), rgb(250, 245, 220), rgb(120, 70, 40), rgb(160, 230, 160) }
	for k = 0, 2 do
		b:ball(3.6 - k * 0.4, CF(0, 6.6 + k * 2.4, 0), rng:pick(flavors), { role = "primary" })
	end
	b:ball(1, CF(0, 12.4, 0), rgb(220, 30, 50), { role = "accent" })
	return 13, 2
end
FOOD.apple = function(b, _rng)
	b:ball(5, CF(0, 2.5, 0), rgb(220, 40, 40), { role = "primary", reflectance = 0.1 })
	b:cylY(1.2, 0.3, CF(0, 5.3, 0), rgb(100, 70, 40), { role = "fixed" })
	b:part("wedge", V(0.2, 0.8, 1.4), CF(0.6, 5.5, 0) * ANG(0, 0, rad(-40)), rgb(80, 170, 60), { role = "fixed" })
	return 6, 2.5
end
FOOD.banana = function(b, _rng)
	for k = 0, 4 do
		local a = (k - 2) * 0.32
		b:part("cyl", V(2.0, 1.2, 1.2), CF(math.sin(a) * 4, 1 + math.cos(a) * 1.5 - 1.5 + 0.6, 0) * ANG(0, 0, a), rgb(250, 220, 60), { role = "primary" })
	end
	b:box(V(0.4, 0.6, 0.4), CF(4 * math.sin(0.64) + 0.8, 1.2, 0), rgb(90, 70, 40), { role = "fixed" })
	return 2, 4
end
FOOD.watermelon = function(b, _rng)
	b:part("ball", V(6, 5, 8), CF(0, 2.5, 0), rgb(50, 140, 60), { role = "primary" })
	for k = -2, 2 do
		b:part("ball", V(0.3, 5.05, 8.05), CF(k * 1.1, 2.5, 0), rgb(30, 90, 40), { role = "secondary" })
	end
	return 5, 4
end
FOOD.orange = function(b, _rng)
	b:ball(4.4, CF(0, 2.2, 0), rgb(255, 150, 30), { role = "primary", material = Enum.Material.Sand })
	b:part("wedge", V(0.2, 0.6, 1), CF(0.3, 4.5, 0) * ANG(0, 0, rad(-30)), rgb(70, 150, 50), { role = "fixed" })
	b:cylY(0.5, 0.25, CF(0, 4.45, 0), rgb(100, 70, 40), { role = "fixed" })
	return 4.8, 2.2
end
FOOD.strawberry = function(b, _rng)
	b:part("ball", V(4, 4.6, 4), CF(0, 2.3, 0), rgb(230, 40, 60), { role = "primary" })
	b:part("wedge", V(3.4, 1.8, 3.4), CF(0, 0.8, 0) * ANG(rad(180), 0, 0), rgb(230, 40, 60), { role = "primary" })
	for k = 0, 9 do
		local a = k * 2.4
		b:ball(0.25, CF(math.cos(a) * 1.9, 1.6 + (k % 3) * 0.9, math.sin(a) * 1.9), rgb(255, 240, 160), { role = "fixed" })
	end
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		b:part("wedge", V(0.15, 0.5, 1.4), CF(math.cos(a) * 0.7, 4.7, math.sin(a) * 0.7) * ANG(0, -a, 0), rgb(70, 160, 50), { role = "fixed" })
	end
	return 5, 2
end
FOOD.carrot = function(b, _rng)
	b:cone(7, 2.4, CF(0, 7.5, 0) * ANG(rad(180), 0, 0), rgb(255, 130, 30), 4, { role = "primary" })
	for k = 0, 2 do
		b:part("wedge", V(0.2, 3, 1), CF((k - 1) * 0.4, 9, 0) * ANG(0, 0, rad((k - 1) * 20)), rgb(70, 170, 50), { role = "fixed" })
	end
	return 10, 1.2
end
FOOD.cookie = function(b, _rng)
	b:part("cyl", V(0.8, 6, 6), CF(0, 0.4, 0) * ANG(0, 0, rad(90)), rgb(200, 140, 70), { role = "primary" })
	for k = 0, 7 do
		local a = k * 1.9
		b:ball(0.6, CF(math.cos(a) * (1 + k % 3 * 0.8), 0.85, math.sin(a) * (1 + k % 3 * 0.8)), rgb(70, 40, 20), { role = "fixed" })
	end
	return 1, 3
end
FOOD.lollipop = function(b, _rng)
	b:cylY(6, 0.4, CF(0, 3, 0), rgb(250, 250, 250), { role = "fixed" })
	b:part("cyl", V(0.8, 5, 5), CF(0, 7.5, 0), rgb(255, 80, 160), { role = "primary" })
	for k = 0, 2 do
		b:part("cyl", V(0.85, 3.6 - k * 1.1, 3.6 - k * 1.1), CF(0, 7.5, 0), Kit.RainbowColors[(k * 2) + 1], { role = "accent" })
	end
	return 10, 2.5
end
FOOD.chocolate = function(b, _rng)
	for x = 0, 2 do
		for z = 0, 3 do
			b:box(V(1.8, 0.8, 1.8), CF((x - 1) * 1.9, 0.9, (z - 1.5) * 1.9), rgb(95, 55, 30), { role = "primary" })
		end
	end
	b:box(V(5.8, 0.5, 7.8), CF(0, 0.25, 0), rgb(85, 50, 28), { role = "secondary" })
	b:box(V(5.9, 0.4, 3.4), CF(0, 0.7, 2.4), rgb(200, 40, 50), { role = "accent" })
	return 1.3, 4
end
FOOD.bread = function(b, _rng)
	b:part("ball", V(4, 3, 9), CF(0, 1.5, 0), rgb(220, 160, 80), { role = "primary" })
	for k = -1, 1 do
		b:box(V(2.6, 0.2, 0.4), CF(0, 2.95, k * 2.2) * ANG(0, rad(30), 0), rgb(245, 225, 180), { role = "fixed" })
	end
	return 3, 4.5
end
FOOD.cheese = function(b, _rng)
	b:part("wedge", V(5, 3.4, 6), CF(0, 1.7, 0), rgb(250, 210, 60), { role = "primary" })
	for k = 0, 3 do
		b:part("cyl", V(0.3, 0.8, 0.8), CF(2.55, 0.8 + (k % 2) * 1.2, -1.5 + k), rgb(220, 170, 40), { role = "fixed" })
	end
	return 3.4, 3
end
FOOD.egg = function(b, rng)
	local easter = rng:chance(0.5)
	local base = if easter then rng:pick(Kit.RainbowColors) else rgb(250, 245, 235)
	b:part("ball", V(4, 5.2, 4), CF(0, 2.6, 0), base, { role = "primary" })
	if easter then
		for k = 0, 2 do
			b:part("cyl", V(0.35, 4.05 - math.abs(k - 1) * 0.3, 4.05 - math.abs(k - 1) * 0.3), CF(0, 1.8 + k * 0.8, 0) * ANG(0, 0, rad(90)), rgb(255, 255, 255), { role = "fixed" })
		end
	else
		b:part("cyl", V(0.3, 6, 6), CF(0, 0.15, 0) * ANG(0, 0, rad(90)), rgb(250, 250, 250), { role = "fixed" })
		b:part("ball", V(2.4, 0.4, 2.4), CF(0, 0.4, 0), rgb(255, 200, 40), { role = "fixed" })
	end
	return 5.2, 2
end
FOOD.popcorn = function(b, _rng)
	b:cylY(5, 4, CF(0, 2.5, 0), rgb(220, 40, 40), { role = "primary" })
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		b:box(V(0.6, 5.05, 0.6), CF(math.cos(a) * 1.85, 2.5, math.sin(a) * 1.85), rgb(250, 250, 250), { role = "fixed" })
	end
	for k = 0, 11 do
		local a = k * 2.1
		b:ball(1.1, CF(math.cos(a) * (k % 3) * 0.6, 5.3 + (k % 4) * 0.4, math.sin(a) * (k % 3) * 0.6), rgb(255, 245, 210), { role = "fixed" })
	end
	return 7, 2.2
end
FOOD.soda = function(b, rng)
	local col = rng:pick({ rgb(200, 30, 30), rgb(40, 160, 70), rgb(30, 80, 200) })
	b:cylY(6, 3.2, CF(0, 3, 0), col, { role = "primary", reflectance = 0.2 })
	b:cylY(0.4, 3, CF(0, 6.2, 0), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal })
	b:cylY(1.6, 3.25, CF(0, 3, 0), rgb(250, 250, 250), { role = "fixed" })
	return 6.4, 1.6
end
FOOD.coffee = function(b, _rng)
	b:cylY(3, 3.4, CF(0, 1.5, 0), rgb(250, 250, 250), { role = "primary" })
	b:cylY(0.2, 3, CF(0, 2.95, 0), rgb(100, 60, 30), { role = "fixed" })
	b:part("cyl", V(0.5, 1.8, 1.8), CF(2, 1.6, 0) * ANG(0, rad(90), 0), rgb(250, 250, 250), { role = "primary" })
	local steam = b:ball(0.5, CF(0, 3.4, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false })
	local s = Instance.new("Smoke")
	s.Color = rgb(255, 255, 255)
	s.Opacity = 0.15
	s.RiseVelocity = 3
	s.Size = 1
	s.Parent = steam
	return 3.5, 2.5
end
FOOD.fries = function(b, _rng)
	b:box(V(4, 4, 2.6), CF(0, 2, 0), rgb(220, 40, 40), { role = "primary" })
	for k = 0, 8 do
		b:box(V(0.5, 3.4, 0.5), CF((k % 3 - 1) * 1, 4.6 + (k % 2) * 0.4, (k // 3 - 1) * 0.6) * ANG(0, 0, rad((k - 4) * 4)), rgb(250, 210, 80), { role = "fixed" })
	end
	return 6.5, 2.2
end
FOOD.brigadeiro = function(b, _rng)
	b:part("cyl", V(0.6, 4.2, 4.2), CF(0, 0.3, 0) * ANG(0, 0, rad(90)), rgb(250, 250, 250), { role = "fixed" })
	b:ball(3.4, CF(0, 2.1, 0), rgb(70, 40, 25), { role = "primary" })
	for k = 0, 14 do
		local a = k * 2.4
		local el = (k % 5) / 5 * math.pi * 0.5
		b:box(V(0.35, 0.12, 0.12), CF(math.cos(a) * math.cos(el) * 1.7, 2.1 + math.sin(el) * 1.7, math.sin(a) * math.cos(el) * 1.7) * ANG(0, a, 0), rgb(40, 22, 14), { role = "fixed" })
	end
	return 3.8, 2
end
FOOD.coxinha = function(b, _rng)
	b:part("ball", V(4, 4, 4), CF(0, 2, 0), rgb(210, 140, 60), { role = "primary", material = Enum.Material.Sand })
	b:cone(3, 3.4, CF(0, 2.8, 0), rgb(210, 140, 60), 3, { role = "primary", material = Enum.Material.Sand })
	return 6, 2
end
FOOD.cheese_bread = function(b, _rng)
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2
		b:part("ball", V(3, 2.6, 3), CF(math.cos(a) * 1.8, 1.3, math.sin(a) * 1.8), rgb(240, 200, 120), { role = "primary", material = Enum.Material.Sand })
	end
	b:part("ball", V(3, 2.6, 3), CF(0, 2.9, 0), rgb(245, 210, 130), { role = "primary", material = Enum.Material.Sand })
	return 4.2, 3.4
end
FOOD.acai = function(b, _rng)
	b:part("cyl", V(3, 6, 6), CF(0, 1.5, 0) * ANG(0, 0, rad(90)), rgb(110, 70, 40), { role = "secondary", material = Enum.Material.Wood })
	b:part("cyl", V(0.5, 5.4, 5.4), CF(0, 3.1, 0) * ANG(0, 0, rad(90)), rgb(80, 20, 70), { role = "primary" })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:part("cyl", V(0.4, 1.2, 1.2), CF(math.cos(a) * 1.6, 3.4, math.sin(a) * 1.6) * ANG(0, 0, rad(90)), rgb(250, 230, 120), { role = "fixed" })
	end
	b:ball(1.2, CF(0, 3.6, 0), rgb(220, 40, 60), { role = "accent" })
	return 3.8, 3
end
FOOD.pastel = function(b, _rng)
	b:part("wedge", V(5, 1, 3), CF(0, 0.5, -1.5) * ANG(0, rad(180), 0), rgb(240, 190, 90), { role = "primary" })
	b:part("wedge", V(5, 1, 3), CF(0, 0.5, 1.5), rgb(240, 190, 90), { role = "primary" })
	for k = -4, 4 do
		b:box(V(0.35, 0.2, 0.5), CF(k * 0.55, 0.12, -3.1), rgb(225, 170, 75), { role = "secondary" })
	end
	return 1, 3
end
FOOD.sushi = function(b, _rng)
	b:part("cyl", V(2.6, 3, 3), CF(0, 1.5, 0) * ANG(0, 0, rad(90)), rgb(20, 40, 25), { role = "secondary" })
	b:part("cyl", V(2.62, 2.4, 2.4), CF(0, 1.5, 0) * ANG(0, 0, rad(90)), rgb(250, 250, 245), { role = "fixed" })
	b:part("cyl", V(2.64, 1, 1), CF(0, 1.5, 0) * ANG(0, 0, rad(90)), rgb(255, 120, 80), { role = "primary" })
	return 3, 1.5
end
FOOD.feijoada = function(b, _rng)
	b:part("cyl", V(3, 7, 7), CF(0, 1.5, 0) * ANG(0, 0, rad(90)), rgb(60, 60, 65), { role = "secondary", material = Enum.Material.Metal })
	b:part("cyl", V(0.4, 6.2, 6.2), CF(0, 3, 0) * ANG(0, 0, rad(90)), rgb(50, 25, 20), { role = "primary" })
	for k = 0, 5 do
		local a = k * 1.1
		b:ball(0.9, CF(math.cos(a) * 1.8, 3.3, math.sin(a) * 1.8), rgb(150, 60, 40), { role = "fixed" })
	end
	for _, s in { -1, 1 } do
		b:part("cyl", V(1, 0.5, 0.5), CF(s * 4, 2.5, 0), rgb(60, 60, 65), { role = "secondary" })
	end
	return 3.4, 4
end

-- NATUREZA --------------------------------------------------------------------------
local NAT: { [string]: Fn } = {}

NAT.tree = function(b, rng)
	local h = rng:range(9, 14)
	local bark = rgb(105, 72, 45)
	b:cylY(h, rng:range(1.6, 2.4), CF(0, h / 2, 0), bark, { role = "secondary", material = Enum.Material.Wood })
	local leaf = rng:pick({ rgb(70, 150, 60), rgb(90, 170, 70), rgb(60, 130, 55), rgb(110, 175, 80) })
	for k = 0, 4 do
		local a = k * 1.3
		local r = if k == 0 then 0 else 3
		b:ball(rng:range(6, 8), CF(math.cos(a) * r, h + rng:range(-1, 2), math.sin(a) * r), Kit.darker(leaf, k * 0.03), { role = "primary", material = Enum.Material.Grass, shadow = k == 0 })
	end
	b:beam(V(0, h * 0.6, 0), V(2.6, h * 0.8, 0.5), 0.8, bark, { role = "secondary" })
	return h + 4, 5
end
NAT.pine = function(b, rng)
	local h = rng:range(12, 18)
	b:cylY(h * 0.4, 1.4, CF(0, h * 0.2, 0), rgb(100, 70, 45), { role = "secondary", material = Enum.Material.Wood })
	local col = rgb(40, 110, 60)
	for k = 0, 3 do
		b:cone(h * 0.35, 9 - k * 2, CF(0, h * 0.25 + k * h * 0.18, 0), Kit.darker(col, k * 0.04), 3, { role = "primary", material = Enum.Material.Grass })
	end
	return h + 2, 4.5
end
NAT.palm = function(b, rng)
	local h = rng:range(12, 16)
	local lean = rng:range(-0.25, 0.25)
	local top = V(lean * h, h, 0)
	for k = 0, 5 do
		local p0 = V(lean * h * k / 6, h * k / 6, 0)
		local p1 = V(lean * h * (k + 1) / 6, h * (k + 1) / 6, 0)
		b:beam(p0, p1, 1.2 - k * 0.08, rgb(150, 110, 70), { role = "secondary", material = Enum.Material.Wood }, true)
	end
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2
		local tip = top + V(math.cos(a) * 6, -2.5, math.sin(a) * 6)
		b:beam(top, tip, 1.4, rgb(60, 160, 60), { role = "primary", material = Enum.Material.Grass })
	end
	for k = 0, 2 do
		b:ball(1, CF(top + V(math.cos(k * 2) * 0.8, -0.8, math.sin(k * 2) * 0.8)), rgb(120, 80, 40), { role = "fixed" })
	end
	return h + 1, 6
end
NAT.flowers = function(b, rng)
	for k = 0, 9 do
		local a = k * 2.3
		local r = rng:range(0.5, 5)
		local p = V(math.cos(a) * r, 0, math.sin(a) * r)
		local stem = rng:range(1.5, 3)
		b:cylY(stem, 0.2, CF(p + V(0, stem / 2, 0)), rgb(70, 150, 50), { role = "fixed" })
		local col = rng:pick({ rgb(255, 80, 120), rgb(255, 220, 60), rgb(160, 90, 255), rgb(255, 140, 40), rgb(250, 250, 250) })
		for pt = 0, 4 do
			local pa = pt / 5 * math.pi * 2
			b:ball(0.7, CF(p + V(math.cos(pa) * 0.45, stem, math.sin(pa) * 0.45)), col, { role = "primary" })
		end
		b:ball(0.5, CF(p + V(0, stem + 0.05, 0)), rgb(255, 210, 60), { role = "fixed" })
	end
	return 3.5, 5.5
end
NAT.mushroom = function(b, rng)
	local glow = rng:chance(0.5)
	local cap = rng:pick({ rgb(220, 40, 40), rgb(160, 80, 255), rgb(60, 200, 255) })
	b:cylY(4, 1.8, CF(0, 2, 0), rgb(245, 240, 225), { role = "fixed" })
	local top = b:part("ball", V(7, 3.6, 7), CF(0, 4.6, 0), cap, { role = "primary", material = if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic, name = "Chapeu" })
	for k = 0, 5 do
		local a = k * 1.05
		b:ball(0.8, CF(math.cos(a) * 2.2, 5.9, math.sin(a) * 2.2), rgb(250, 250, 250), { role = "fixed" })
	end
	if glow then
		b:light(top, cap, 16, 1.5)
	end
	return 6.5, 3.5
end
NAT.cactus = function(b, _rng)
	local g = rgb(80, 150, 70)
	b:cylY(10, 2.2, CF(0, 5, 0), g, { role = "primary" })
	b:ball(2.2, CF(0, 10, 0), g, { role = "primary" })
	for _, s in { -1, 1 } do
		b:beam(V(0, 4 + s, 0), V(s * 2.4, 4.5 + s, 0), 1.4, g, { role = "primary" }, true)
		b:cylY(3, 1.4, CF(s * 2.4, 6 + s, 0), g, { role = "primary" })
		b:ball(1.4, CF(s * 2.4, 7.5 + s, 0), g, { role = "primary" })
	end
	b:ball(0.9, CF(0, 11, 0), rgb(255, 120, 180), { role = "accent" })
	return 11.5, 3.5
end
NAT.rock = function(b, rng)
	local col = rng:pick({ rgb(120, 118, 115), rgb(100, 95, 90), rgb(140, 135, 125) })
	for k = 0, 3 do
		local a = k * 1.7
		local s = rng:range(3, 6)
		b:part("ball", V(s * 1.3, s, s * 1.1), CF(math.cos(a) * 1.4, s / 2 - 0.4, math.sin(a) * 1.4) * ANG(0, a, 0), Kit.darker(col, k * 0.04), { role = "primary", material = Enum.Material.Slate })
	end
	return 5, 4
end
NAT.crystal = function(b, rng)
	local col = rng:pick({ rgb(170, 120, 255), rgb(90, 220, 255), rgb(255, 120, 200), rgb(120, 255, 180) })
	for k = 0, 5 do
		local a = k * 1.2
		local h = rng:range(4, 9)
		local tilt = rng:range(0.1, 0.4)
		local base = V(math.cos(a) * 1.2, 0, math.sin(a) * 1.2)
		b:part("wedge", V(1.4, h, 1.4), CF(base + V(0, h / 2, 0)) * ANG(math.cos(a) * tilt, 0, math.sin(a) * tilt), col, { role = "primary", material = Enum.Material.Glass, transparency = 0.15, reflectance = 0.2 })
	end
	local core = b:ball(1.8, CF(0, 1.5, 0), col, { role = "accent", material = Enum.Material.Neon })
	b:light(core, col, 18, 2)
	return 9, 3
end
NAT.cloud = function(b, _rng)
	for k = 0, 5 do
		local a = k * 1.1
		b:ball(5 + (k % 3), CF(math.cos(a) * 3.5, 10 + (k % 2), math.sin(a) * 2), rgb(250, 252, 255), { role = "primary", collide = true })
	end
	return 14, 7
end
NAT.bush = function(b, rng)
	local col = rng:pick({ rgb(70, 140, 60), rgb(90, 160, 70) })
	for k = 0, 3 do
		local a = k * 1.6
		b:ball(rng:range(2.4, 3.6), CF(math.cos(a) * 1.2, 1.4, math.sin(a) * 1.2), col, { role = "primary", material = Enum.Material.Grass })
	end
	if rng:chance(0.5) then
		for k = 0, 3 do
			b:ball(0.5, CF(math.cos(k * 1.7) * 1.8, 2.4, math.sin(k * 1.7) * 1.8), rgb(220, 40, 60), { role = "accent" })
		end
	end
	return 3, 2.5
end
NAT.mountain = function(b, _rng)
	b:cone(40, 60, CF(0, 0, 0), rgb(120, 110, 100), 6, { role = "primary", material = Enum.Material.Slate })
	b:cone(10, 20, CF(0, 30, 0), rgb(250, 252, 255), 3, { role = "fixed", material = Enum.Material.Snow })
	return 40, 30
end
NAT.garden = function(b, rng)
	b:box(V(24, 0.4, 24), CF(0, 0.2, 0), rgb(90, 160, 70), { role = "fixed", material = Enum.Material.Grass })
	for k = 0, 15 do
		local x = (k % 4 - 1.5) * 5
		local z = (k // 4 - 1.5) * 5
		local col = rng:pick({ rgb(255, 80, 120), rgb(255, 220, 60), rgb(160, 90, 255), rgb(255, 140, 40) })
		b:cylY(1.6, 0.2, CF(x, 1, z), rgb(70, 150, 50), { role = "fixed" })
		b:ball(1.1, CF(x, 2, z), col, { role = "primary" })
	end
	b:cylY(1, 4, CF(0, 0.5, 0), rgb(200, 200, 205), { role = "fixed", material = Enum.Material.Marble })
	b:cylY(4, 0.8, CF(0, 2.5, 0), rgb(200, 200, 205), { role = "fixed", material = Enum.Material.Marble })
	return 4, 12
end

Props.Objects = OBJ
Props.Foods = FOOD
Props.Nature = NAT

function Props.build(origin: CFrame, params: { [string]: any }, model: string, variant: string): PropResult
	local p = table.clone(params)
	if p.physics then
		p.anchored = false
	end
	local b = Kit.new(variant, origin, p)
	local rng = params.rng
	local table_ = if model == "food" then FOOD elseif model == "nature" then NAT else OBJ
	local f = table_[variant] or OBJ.crate
	if variant == "forest" then
		f = NAT.tree
	end
	local h, r = f(b, rng)
	local m = b:finish()
	if p.physics then
		local main = m.PrimaryPart :: BasePart
		for _, part in b.parts do
			if part ~= main then
				part.Massless = true
				local w = Instance.new("WeldConstraint")
				w.Part0 = main
				w.Part1 = part
				w.Parent = part
			end
			part.CanCollide = true
		end
	end
	return { model = m, height = h * b.s, radius = r * b.s, main = m.PrimaryPart :: BasePart }
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[--!strict
-- Montagem de "rigs" de criaturas: partes soltas (não ancoradas) ligadas por
-- Motor6D a uma raiz. Cada junta animada recebe atributos que o cliente lê
-- para animar localmente (Motor6D.Transform), sem tráfego de rede:
--   Anim  = leg | arm | wing | tail | head | jaw | fin | tentacle | spin | bob | cape | segment
--   AnimAxis = X | Y | Z, AnimAmp (rad), AnimPhase (rad), AnimSpeed (multiplicador)
-- Coordenadas locais: origem no chão, +Y para cima, frente = -Z.

local Kit = require(script.Parent.Kit)

local Rig = {}
Rig.__index = Rig

export type AnimSpec = { kind: string, axis: string?, amp: number?, phase: number?, speed: number? }

export type RigResult = {
	model: Model,
	root: BasePart,
	humanoid: Humanoid,
	hipHeight: number,
	height: number,
	mouth: Attachment?,
	head: BasePart?,
	flying: boolean,
	radius: number,
	builder: any,
}

function Rig.new(name: string, origin: CFrame, params: { [string]: any }): any
	local p = table.clone(params)
	p.anchored = false
	p.collide = false
	local b = Kit.new(name, origin, p)
	local self = setmetatable({ b = b, root = nil, head = nil, mouth = nil, joints = 0 }, Rig)
	return self
end

-- raiz invisível (HumanoidRootPart). centerY = altura do centro em escala 1
function Rig.makeRoot(self: any, size: Vector3, centerY: number, collide: boolean?): BasePart
	local root = self.b:box(size, CFrame.new(0, centerY, 0), Color3.new(1, 1, 1), {
		role = "fixed",
		transparency = 1,
		collide = if collide == nil then true else collide,
		name = "HumanoidRootPart",
		shadow = false,
	})
	self.root = root
	self.rootSize = size
	self.centerY = centerY
	return root
end

-- liga `part` a `parent`. Com anim: Motor6D na posição local `joint`; sem: solda rígida.
function Rig.join(self: any, part: BasePart, parent: BasePart, joint: Vector3?, anim: AnimSpec?): Instance
	self.joints += 1
	if anim and joint then
		local jointCf = self.b:at(CFrame.new(joint))
		local m = Instance.new("Motor6D")
		m.Name = anim.kind .. tostring(self.joints)
		m.Part0 = parent
		m.Part1 = part
		m.C0 = parent.CFrame:Inverse() * jointCf
		m.C1 = part.CFrame:Inverse() * jointCf
		m:SetAttribute("Anim", anim.kind)
		m:SetAttribute("AnimAxis", anim.axis or "X")
		m:SetAttribute("AnimAmp", anim.amp or 0.5)
		m:SetAttribute("AnimPhase", anim.phase or 0)
		m:SetAttribute("AnimSpeed", anim.speed or 1)
		m.Parent = parent
		return m
	end
	local w = Instance.new("WeldConstraint")
	w.Part0 = parent
	w.Part1 = part
	w.Parent = part
	return w
end

-- solda várias partes a uma mesma base
function Rig.weld(self: any, parts: { BasePart }, base: BasePart)
	for _, p in parts do
		if p ~= base then
			self:join(p, base)
		end
	end
end

-- grava as partes criadas a partir de um índice (para agrupar membros)
function Rig.mark(self: any): number
	return #self.b.parts
end

function Rig.since(self: any, mark: number): { BasePart }
	local out = {}
	for i = mark + 1, #self.b.parts do
		table.insert(out, self.b.parts[i])
	end
	return out
end

-- cria um grupo de partes já posicionadas: a primeira vira a base do grupo e as
-- demais são soldadas nela; a base é ligada ao pai pela junta animada.
function Rig.group(self: any, mark: number, parent: BasePart, joint: Vector3?, anim: AnimSpec?): BasePart?
	local parts = self:since(mark)
	local base = parts[1]
	if not base then
		return nil
	end
	for i = 2, #parts do
		self:join(parts[i], base)
	end
	self:join(base, parent, joint, anim)
	return base
end

function Rig.setMouth(self: any, part: BasePart, localOffset: Vector3)
	self.mouth = self.b:attachment(part, "Boca", localOffset)
end

function Rig.finish(self: any, opts: { hp: number, speed: number, hipHeight: number, height: number, flying: boolean?, radius: number? }): RigResult
	local b = self.b
	local model: Model = b:finish(self.root)
	local s = b.s
	local h = Instance.new("Humanoid")
	h.RigType = Enum.HumanoidRigType.R15
	h.MaxHealth = opts.hp
	h.Health = opts.hp
	h.WalkSpeed = opts.speed
	h.HipHeight = opts.hipHeight * s
	h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	h.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	h.BreakJointsOnDeath = false
	h.RequiresNeck = false
	h.UseJumpPower = true
	h.JumpPower = 45
	h.Parent = model
	-- massa: só a raiz pesa (física estável para o Humanoid)
	for _, p in b.parts do
		if p ~= self.root then
			p.Massless = true
			p.CanQuery = true
		end
	end
	model:SetAttribute("Altura", opts.height * s)
	return {
		model = model,
		root = self.root,
		humanoid = h,
		hipHeight = opts.hipHeight * s,
		height = opts.height * s,
		mouth = self.mouth,
		head = self.head,
		flying = opts.flying == true,
		radius = (opts.radius or 2) * s,
		builder = b,
	}
end

return Rig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Vehicles</string>
            <string name="Source"><![CDATA[--!strict
-- Veículos procedurais. Todos têm um "Chassi" invisível (parte principal),
-- um VehicleSeat e peças soldadas. Rodas e hélices recebem juntas "wheel"/"spin"
-- que o cliente anima localmente.

local Kit = require(script.Parent.Kit)

local Vehicles = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

local PAINT = { rgb(220, 40, 45), rgb(40, 110, 230), rgb(250, 200, 40), rgb(40, 170, 90), rgb(240, 240, 245), rgb(30, 30, 35), rgb(255, 120, 30), rgb(150, 70, 200) }

export type VehicleResult = {
	model: Model,
	chassis: BasePart,
	seat: VehicleSeat,
	length: number,
	height: number,
	drive: string,
}

local function spinJoint(part: BasePart, chassis: BasePart, kind: string, axis: string, speed: number)
	local m = Instance.new("Motor6D")
	m.Part0 = chassis
	m.Part1 = part
	m.C0 = chassis.CFrame:Inverse() * part.CFrame
	m.C1 = CFrame.identity
	m:SetAttribute("Anim", kind)
	m:SetAttribute("AnimAxis", axis)
	m:SetAttribute("AnimAmp", 1)
	m:SetAttribute("AnimPhase", 0)
	m:SetAttribute("AnimSpeed", speed)
	m.Parent = chassis
end

function Vehicles.build(origin: CFrame, params: { [string]: any }, variant: string): VehicleResult
	local p = table.clone(params)
	p.anchored = false
	p.collide = false
	local b = Kit.new(variant, origin, p)
	local rng = params.rng
	local paint = if rng then rng:pick(PAINT) else PAINT[1]
	local glass = rgb(150, 210, 240)
	local dark = rgb(30, 30, 35)
	local spinners: { { any } } = {}
	local drive = params.drive or "ground"

	local L, W, H = 9, 5, 2 -- dimensões do chassi (frente = -Z)
	local seatPos = V(0, 2.2, 0.5)
	local function wheel(x: number, z: number, d: number)
		local w = b:part("cyl", V(0.9, d, d), CF(x, d / 2, z), dark, { role = "fixed", collide = false, name = "Roda" })
		b:part("cyl", V(0.95, d * 0.45, d * 0.45), CF(x, d / 2, z), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal, collide = false })
		table.insert(spinners, { w, "wheel", "X", 6 })
	end
	local function lights(z: number, y: number, x: number)
		for _, side in { -1, 1 } do
			b:box(V(0.6, 0.35, 0.1), CF(side * x, y, z), rgb(255, 250, 210), { role = "fixed", material = Enum.Material.Neon })
			b:box(V(0.6, 0.35, 0.1), CF(side * x, y, -z), rgb(230, 30, 30), { role = "fixed", material = Enum.Material.Neon })
		end
	end

	if variant == "car" or variant == "sportscar" or variant == "police_car" then
		local low = variant == "sportscar"
		local col = if variant == "police_car" then rgb(245, 245, 248) else paint
		L, W = if low then 10 else 9, 5
		local bodyY = if low then 1.5 else 1.8
		b:box(V(W, 1.4, L), CF(0, bodyY, 0), col, { role = "primary" })
		b:part("wedge", V(W, 0.8, 2.2), CF(0, bodyY + 1.1, -1.8) * ANG(0, rad(180), 0), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.3 })
		b:box(V(W - 0.2, if low then 0.9 else 1.2, 3.4), CF(0, bodyY + (if low then 1.1 else 1.3), 0.6), if low then col else glass, { role = if low then "primary" else "fixed", material = if low then Enum.Material.SmoothPlastic else Enum.Material.Glass, transparency = if low then 0 else 0.3 })
		b:box(V(W - 0.1, 0.25, 3.5), CF(0, bodyY + (if low then 1.6 else 1.95), 0.6), col, { role = "primary" })
		b:box(V(W + 0.1, 0.4, 0.4), CF(0, bodyY - 0.4, -L / 2), rgb(60, 60, 65), { role = "fixed" })
		b:box(V(W + 0.1, 0.4, 0.4), CF(0, bodyY - 0.4, L / 2), rgb(60, 60, 65), { role = "fixed" })
		lights(-L / 2 - 0.02, bodyY + 0.2, W / 2 - 0.7)
		if low then
			b:box(V(W, 0.15, 1.2), CF(0, bodyY + 1.4, L / 2 - 0.4), dark, { role = "fixed" })
			for _, side in { -1, 1 } do
				b:box(V(0.2, 0.7, 0.3), CF(side * 1.8, bodyY + 1.0, L / 2 - 0.4), dark, { role = "fixed" })
			end
			b:box(V(W * 0.3, 0.1, L * 0.8), CF(0, bodyY + 0.72, -0.2), rgb(250, 250, 250), { role = "accent" })
		end
		if variant == "police_car" then
			b:box(V(W - 0.1, 0.9, L * 0.55), CF(0, bodyY, 0), dark, { role = "fixed" })
			b:box(V(0.9, 0.35, 0.5), CF(-0.6, bodyY + 2.25, 0.6), rgb(255, 40, 40), { role = "fixed", material = Enum.Material.Neon })
			b:box(V(0.9, 0.35, 0.5), CF(0.6, bodyY + 2.25, 0.6), rgb(40, 80, 255), { role = "fixed", material = Enum.Material.Neon })
		end
		for _, z in { -L / 2 + 1.6, L / 2 - 1.6 } do
			for _, side in { -1, 1 } do
				wheel(side * (W / 2), z, 2)
			end
		end
		seatPos = V(-0.9, bodyY + 0.8, 0.4)
		H = bodyY + 2
	elseif variant == "truck" or variant == "firetruck" or variant == "bus" then
		local col = if variant == "firetruck" then rgb(210, 30, 30) elseif variant == "bus" then rgb(250, 200, 30) else paint
		L, W = if variant == "bus" then 18 else 14, 6
		if variant == "bus" then
			b:box(V(W, 5, L), CF(0, 3.5, 0), col, { role = "primary" })
			for k = 0, 5 do
				for _, side in { -1, 1 } do
					b:box(V(0.1, 1.6, 2.0), CF(side * W / 2, 4.3, -L / 2 + 2 + k * 2.6), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.25 })
				end
			end
			b:box(V(W - 0.4, 2.2, 0.1), CF(0, 4.2, -L / 2), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.25 })
			b:box(V(W + 0.05, 0.4, L + 0.05), CF(0, 2.0, 0), dark, { role = "fixed" })
			seatPos = V(-1.6, 2.6, -L / 2 + 2.2)
		else
			b:box(V(W, 4, 4), CF(0, 3, -L / 2 + 2), col, { role = "primary" })
			b:box(V(W - 0.4, 1.6, 0.1), CF(0, 3.8, -L / 2), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.25 })
			b:box(V(W - 0.4, 0.6, L - 4.5), CF(0, 1.5, 2.2), rgb(70, 70, 75), { role = "fixed" })
			if variant == "firetruck" then
				b:box(V(W, 2.4, L - 4.6), CF(0, 2.9, 2.2), col, { role = "primary" })
				b:box(V(W + 0.05, 0.4, L - 4.5), CF(0, 2.3, 2.2), rgb(250, 250, 250), { role = "fixed" })
				for _, side in { -1, 1 } do
					b:box(V(0.25, 0.25, L - 5), CF(side * 0.9, 4.5, 2.2), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal })
				end
				for k = 0, 7 do
					b:box(V(1.9, 0.18, 0.18), CF(0, 4.5, -0.2 + k * 1.1), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal })
				end
				b:box(V(1.6, 0.4, 0.5), CF(0, 5.1, -L / 2 + 2), rgb(40, 80, 255), { role = "fixed", material = Enum.Material.Neon })
			else
				b:box(V(W, 3.6, L - 4.6), CF(0, 3.5, 2.2), Kit.lighter(col, 0.3), { role = "secondary" })
			end
			seatPos = V(-1.5, 2.6, -L / 2 + 2)
		end
		lights(-L / 2 - 0.02, 2.2, W / 2 - 0.8)
		for _, z in { -L / 2 + 2, L / 2 - 2.5 } do
			for _, side in { -1, 1 } do
				wheel(side * (W / 2), z, 2.6)
			end
		end
		H = 6
	elseif variant == "tractor" then
		L, W = 8, 5
		local col = rgb(60, 160, 60)
		b:box(V(3, 2.4, 5), CF(0, 2.6, -0.5), col, { role = "primary" })
		b:box(V(3.4, 3, 2.6), CF(0, 4.3, 1.6), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.35 })
		b:box(V(3.5, 0.3, 2.8), CF(0, 5.9, 1.6), col, { role = "primary" })
		b:cylY(2, 0.4, CF(0.8, 4.4, -2.2), dark, { role = "fixed" })
		for _, side in { -1, 1 } do
			wheel(side * 2.4, 2.2, 4.2)
			wheel(side * 1.9, -2.6, 2.2)
		end
		seatPos = V(0, 3.4, 1.6)
		H = 6
	elseif variant == "tank" then
		L, W = 11, 7
		local col = rgb(90, 105, 70)
		b:box(V(W - 2, 2, L), CF(0, 2.2, 0), col, { role = "primary" })
		for _, side in { -1, 1 } do
			b:box(V(1.4, 2, L + 0.6), CF(side * (W / 2 - 0.7), 1.1, 0), dark, { role = "fixed" })
			for k = -2, 2 do
				b:part("cyl", V(1.45, 1.4, 1.4), CF(side * (W / 2 - 0.7), 1.0, k * 2), rgb(70, 70, 70), { role = "fixed" })
			end
		end
		b:part("cyl", V(1.6, 4.6, 4.6), CF(0, 4, 0.5) * ANG(0, 0, rad(90)), col, { role = "primary" })
		b:part("cyl", V(6, 0.7, 0.7), CF(0, 4.1, -3.5) * ANG(0, rad(90), 0), Kit.darker(col, 0.2), { role = "secondary" })
		seatPos = V(0, 3.4, 1.8)
		H = 5
	elseif variant == "motorcycle" then
		L, W = 6, 1.6
		b:box(V(0.8, 1.2, 3.4), CF(0, 2.0, 0), paint, { role = "primary" })
		b:part("wedge", V(0.9, 0.9, 1.2), CF(0, 2.6, -1.8) * ANG(0, rad(180), 0), paint, { role = "primary" })
		b:box(V(2.2, 0.15, 0.15), CF(0, 3.1, -1.9), dark, { role = "fixed" })
		b:box(V(0.6, 0.3, 0.1), CF(0, 2.5, -2.45), rgb(255, 250, 200), { role = "fixed", material = Enum.Material.Neon })
		wheel(0, -2.1, 2.2)
		wheel(0, 2.1, 2.2)
		seatPos = V(0, 2.5, 0.6)
		H = 3
		W = 2.4
	elseif variant == "skateboard" then
		L, W = 4, 1.4
		b:box(V(1.4, 0.2, 4), CF(0, 0.7, 0), paint, { role = "primary" })
		b:box(V(1.2, 0.05, 3.6), CF(0, 0.82, 0), rgb(80, 255, 220), { role = "accent", material = Enum.Material.Neon })
		for _, z in { -1.4, 1.4 } do
			for _, side in { -1, 1 } do
				wheel(side * 0.5, z, 0.5)
			end
		end
		seatPos = V(0, 1.2, 0)
		H = 1
	elseif variant == "boat" or variant == "ship" then
		local big = variant == "ship"
		L, W = if big then 26 else 12, if big then 9 else 5
		local hull = if big then rgb(110, 70, 40) else rgb(245, 245, 250)
		b:box(V(W, 2.2, L - 3), CF(0, 1.6, 1), hull, { role = "primary", material = if big then Enum.Material.WoodPlanks else Enum.Material.SmoothPlastic })
		b:part("wedge", V(W, 2.2, 4), CF(0, 1.6, -L / 2 + 1.5) * ANG(0, rad(180), 0), hull, { role = "primary", material = if big then Enum.Material.WoodPlanks else Enum.Material.SmoothPlastic })
		b:box(V(W - 0.6, 0.3, L - 2.5), CF(0, 2.75, 0.8), rgb(180, 140, 90), { role = "fixed", material = Enum.Material.WoodPlanks })
		if big then
			for _, z in { -4, 4 } do
				b:cylY(14, 0.7, CF(0, 9.8, z), rgb(90, 60, 35), { role = "fixed" })
				b:box(V(8, 6, 0.2), CF(0, 11, z - 0.3), rgb(240, 235, 220), { role = "fixed", material = Enum.Material.Fabric })
			end
			b:box(V(2.5, 1.6, 0.1), CF(0, 17.4, -4), rgb(20, 20, 20), { role = "fixed" })
			b:box(V(W, 3, 4), CF(0, 4.2, L / 2 - 2.5), hull, { role = "primary", material = Enum.Material.WoodPlanks })
			for k = -2, 2 do
				b:part("cyl", V(2, 0.6, 0.6), CF(W / 2 + 0.6, 2.3, k * 3) * ANG(0, 0, 0), dark, { role = "fixed" })
			end
			seatPos = V(0, 3.4, L / 2 - 5)
		else
			b:part("wedge", V(W - 1, 1.2, 1.4), CF(0, 3.5, -1.5) * ANG(0, rad(180), 0), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.3 })
			b:box(V(1.4, 1.6, 1.2), CF(0, 2.4, L / 2), dark, { role = "fixed" })
			seatPos = V(0, 3.2, 1)
		end
		H = if big then 18 else 4
	elseif variant == "plane" or variant == "spaceship" then
		local space = variant == "spaceship"
		L, W = 14, 16
		local col = if space then rgb(220, 225, 235) else paint
		b:part("cyl", V(L, 2.6, 2.6), CF(0, 3, 0) * ANG(0, rad(90), 0), col, { role = "primary" })
		b:part("ball", V(2.6, 2.6, 3), CF(0, 3, -L / 2), col, { role = "primary" })
		b:part("ball", V(1.8, 1.4, 3.2), CF(0, 4.1, -L / 2 + 2.5), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.2 })
		if space then
			b:part("wedge", V(W, 0.5, 6), CF(0, 2.6, 1.5), col, { role = "primary" })
			for _, side in { -1, 1 } do
				b:part("cyl", V(3, 1.2, 1.2), CF(side * 2.4, 2.8, L / 2 - 0.5) * ANG(0, rad(90), 0), rgb(60, 60, 70), { role = "fixed" })
				b:part("cyl", V(0.3, 1.0, 1.0), CF(side * 2.4, 2.8, L / 2 + 1.05) * ANG(0, rad(90), 0), rgb(90, 200, 255), { role = "accent", material = Enum.Material.Neon })
			end
		else
			b:box(V(W, 0.4, 3), CF(0, 2.6, -0.5), col, { role = "primary" })
			b:box(V(5, 0.3, 1.6), CF(0, 3.2, L / 2 - 1), col, { role = "primary" })
			b:part("wedge", V(0.3, 2.4, 2.2), CF(0, 4.6, L / 2 - 1), col, { role = "primary" })
			local prop = b:box(V(4.4, 0.4, 0.15), CF(0, 3, -L / 2 - 1.5), dark, { role = "fixed", name = "Helice" })
			table.insert(spinners, { prop, "spin", "Z", 10 })
			for _, side in { -1, 1 } do
				wheel(side * 1.5, -1, 1.2)
			end
		end
		seatPos = V(0, 3.4, -L / 2 + 2.5)
		H = 5
	elseif variant == "helicopter" then
		L, W = 12, 4
		local col = paint
		b:part("ball", V(4, 3.6, 5.4), CF(0, 3.4, -1), col, { role = "primary" })
		b:part("ball", V(3.4, 2.6, 2.6), CF(0, 3.6, -3.1), glass, { role = "fixed", material = Enum.Material.Glass, transparency = 0.25 })
		b:part("cyl", V(6.5, 0.8, 0.8), CF(0, 3.8, 4) * ANG(0, rad(90), 0), col, { role = "primary" })
		b:part("wedge", V(0.3, 2, 1.6), CF(0, 4.9, 7), col, { role = "primary" })
		for _, side in { -1, 1 } do
			b:box(V(0.3, 0.3, 6), CF(side * 1.6, 0.6, -0.8), dark, { role = "fixed" })
			b:box(V(0.2, 1.4, 0.2), CF(side * 1.4, 1.2, -0.8), dark, { role = "fixed" })
		end
		b:cylY(0.8, 0.5, CF(0, 5.5, -1), dark, { role = "fixed" })
		local rotor = b:box(V(13, 0.2, 0.7), CF(0, 6, -1), dark, { role = "fixed", name = "Rotor" })
		table.insert(spinners, { rotor, "spin", "Y", 12 })
		local tail = b:box(V(0.15, 2.4, 0.4), CF(0.5, 4.9, 7.2), dark, { role = "fixed", name = "RotorCauda" })
		table.insert(spinners, { tail, "spin", "X", 14 })
		seatPos = V(0, 2.6, -2.2)
		H = 6
	elseif variant == "rocket" then
		L, W = 4, 4
		b:cylY(12, 3.2, CF(0, 7, 0), rgb(245, 245, 250), { role = "primary" })
		b:cone(4, 3.2, CF(0, 13, 0), rgb(220, 40, 40), 4, { role = "secondary" })
		b:part("cyl", V(0.2, 1.4, 1.4), CF(0, 10, -1.6) * ANG(0, rad(90), 0), glass, { role = "fixed", material = Enum.Material.Glass })
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2
			b:part("wedge", V(0.3, 3, 2), CF(math.cos(a) * 1.9, 2.4, math.sin(a) * 1.9) * ANG(0, -a + math.pi / 2, 0), rgb(220, 40, 40), { role = "secondary" })
		end
		b:cylY(1, 2.2, CF(0, 0.6, 0), dark, { role = "fixed" })
		seatPos = V(0, 9, 0)
		H = 17
	elseif variant == "hot_air_balloon" then
		L, W = 6, 6
		local cols = { rgb(230, 50, 50), rgb(255, 210, 50), rgb(60, 140, 240) }
		b:ball(16, CF(0, 20, 0), cols[1], { role = "primary" })
		for k = 1, 3 do
			b:part("cyl", V(1.6, 16.2 - k * 2.5, 16.2 - k * 2.5), CF(0, 20 + (k - 2) * 4.2, 0) * ANG(0, 0, rad(90)), cols[(k % 3) + 1], { role = "secondary" })
		end
		b:box(V(5, 3, 5), CF(0, 1.8, 0), rgb(150, 100, 55), { role = "fixed", material = Enum.Material.WoodPlanks })
		for _, x in { -2.2, 2.2 } do
			for _, z in { -2.2, 2.2 } do
				b:beam(V(x, 3.3, z), V(x * 1.6, 13, z * 1.6), 0.12, rgb(80, 60, 40), { role = "fixed" })
			end
		end
		local fire = b:ball(1.2, CF(0, 5, 0), rgb(255, 160, 40), { role = "fixed", material = Enum.Material.Neon })
		local f = Instance.new("Fire")
		f.Size = 4
		f.Parent = fire
		seatPos = V(0, 2, 0)
		H = 28
	elseif variant == "train" then
		L, W = 20, 6
		local col = rgb(40, 50, 60)
		b:part("cyl", V(9, 4, 4), CF(0, 4, -4.5) * ANG(0, rad(90), 0), col, { role = "primary" })
		b:box(V(W, 5, 4), CF(0, 4.6, 1.6), rgb(170, 30, 30), { role = "secondary" })
		b:cylY(2.6, 1.3, CF(0, 7.2, -7.3), dark, { role = "fixed" })
		b:part("wedge", V(W, 2, 2), CF(0, 1.5, -9.6) * ANG(0, rad(180), 0), rgb(200, 30, 30), { role = "secondary" })
		b:box(V(W, 4, 7), CF(0, 4, 7.5), rgb(120, 80, 45), { role = "fixed", material = Enum.Material.WoodPlanks })
		for _, z in { -7, -3, 1, 6, 9 } do
			for _, side in { -1, 1 } do
				wheel(side * (W / 2), z, 2.4)
			end
		end
		local smoke = Instance.new("Smoke")
		smoke.Color = rgb(220, 220, 220)
		smoke.Opacity = 0.3
		smoke.RiseVelocity = 6
		smoke.Parent = b.parts[#b.parts]
		seatPos = V(0, 3.2, 1.6)
		H = 8
	end

	-- chassi físico e assento
	local chassisY = if drive == "air" then H * 0.4 else 1.5
	local chassis = b:box(V(W, 1, L), CF(0, chassisY, 0), rgb(0, 0, 0), { role = "fixed", transparency = 1, collide = true, name = "Chassi" })
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.25, 0.1, 1, 1)
	local seat = Instance.new("VehicleSeat")
	seat.Name = "Assento"
	seat.Size = V(2, 0.4, 2) * b.s
	seat.CFrame = b:at(CF(seatPos))
	seat.Transparency = 0.5
	seat.Color = rgb(40, 40, 45)
	seat.Anchored = false
	seat.CanCollide = false
	seat.MaxSpeed = params.speed or 60
	seat.Torque = 1e5
	seat.TurnSpeed = 2
	seat.Parent = b.model
	table.insert(b.parts, seat)
	b.roles[seat] = "fixed"

	local model = b:finish(chassis)
	for _, part in b.parts do
		if part ~= chassis then
			part.Massless = true
		end
	end
	for _, s in spinners do
		spinJoint(s[1], chassis, s[2], s[3], s[4])
	end
	-- soldas rígidas para tudo que não gira
	local spinning = {}
	for _, s in spinners do
		spinning[s[1]] = true
	end
	for _, part in b.parts do
		if part ~= chassis and not spinning[part] then
			local w = Instance.new("WeldConstraint")
			w.Part0 = chassis
			w.Part1 = part
			w.Parent = part
		end
	end
	model:SetAttribute("Veiculo", variant)
	model:SetAttribute("Conducao", drive)
	model:AddTag("IdeiasVeiculo")
	return {
		model = model,
		chassis = chassis,
		seat = seat,
		length = L * b.s,
		height = H * b.s,
		drive = drive,
	}
end

return Vehicles
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="54">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Actors</string>
            <string name="Source"><![CDATA[--!strict
-- Registro de "atores": jogadores e NPCs criados pelos acontecimentos.
-- Permite consultas baratas por proximidade sem varrer o Workspace.

local Players = game:GetService("Players")

local Actors = {}

export type Npc = {
	kind: "npc",
	id: number,
	eventId: number,
	model: Model,
	root: BasePart,
	humanoid: Humanoid,
	faction: string,
	owner: Player?,
	params: { [string]: any },
	def: any,
	[string]: any,
}

local npcs: { [Model]: Npc } = {}
local byHumanoid: { [Humanoid]: Npc } = {}
local playerActors: { [Player]: any } = {}
local count = 0
local nextId = 0

function Actors.register(npc: Npc): Npc
	nextId += 1
	npc.id = nextId
	npcs[npc.model] = npc
	byHumanoid[npc.humanoid] = npc
	count += 1
	return npc
end

function Actors.unregister(npc: Npc)
	if npcs[npc.model] then
		npcs[npc.model] = nil
		byHumanoid[npc.humanoid] = nil
		count -= 1
	end
end

function Actors.count(): number
	return count
end

function Actors.npcs(): { [Model]: Npc }
	return npcs
end

function Actors.playerActor(player: Player): any
	local a = playerActors[player]
	if not a then
		a = { kind = "player", faction = "player", owner = player, player = player }
		playerActors[player] = a
	end
	local char = player.Character
	a.model = char
	a.humanoid = char and char:FindFirstChildOfClass("Humanoid")
	a.root = char and char:FindFirstChild("HumanoidRootPart")
	return a
end

Players.PlayerRemoving:Connect(function(p)
	playerActors[p] = nil
end)

function Actors.ofHumanoid(h: Humanoid): any
	local npc = byHumanoid[h]
	if npc then
		return npc
	end
	local model = h.Parent
	local player = model and Players:GetPlayerFromCharacter(model)
	if player then
		return Actors.playerActor(player)
	end
	return nil
end

function Actors.ofModel(m: Instance): any
	local npc = npcs[m :: Model]
	if npc then
		return npc
	end
	local player = Players:GetPlayerFromCharacter(m)
	if player then
		return Actors.playerActor(player)
	end
	return nil
end

local function alive(a: any): boolean
	return a.humanoid ~= nil and a.humanoid.Health > 0 and a.root ~= nil and a.root.Parent ~= nil
end
Actors.alive = alive

-- todos os atores vivos dentro do raio (jogadores + NPCs)
function Actors.near(pos: Vector3, radius: number): { any }
	local out = {}
	local r2 = radius * radius
	for _, player in Players:GetPlayers() do
		local a = Actors.playerActor(player)
		if alive(a) then
			local d = a.root.Position - pos
			if d:Dot(d) <= r2 then
				table.insert(out, a)
			end
		end
	end
	for _, npc in npcs do
		if alive(npc) then
			local d = npc.root.Position - pos
			if d:Dot(d) <= r2 then
				table.insert(out, npc)
			end
		end
	end
	return out
end

function Actors.players(): { any }
	local out = {}
	for _, player in Players:GetPlayers() do
		local a = Actors.playerActor(player)
		if alive(a) then
			table.insert(out, a)
		end
	end
	return out
end

return Actors
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Ambience</string>
            <string name="Source"><![CDATA[--!strict
-- Céu, iluminação, clima e gravidade com "pilha" de alterações temporárias.
-- Cada acontecimento empurra uma alteração com prazo; ao terminar, o estado é
-- recalculado a partir do ciclo dia/noite base. Nada fica preso (ex.: gravidade
-- zero sempre volta ao normal, mesmo se dois pedidos se sobrepuserem).

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.IdeiasShared.Config)

local Ambience = {}

local BASE_GRAVITY = 196.2

type Override = { id: number, expires: number, props: { [string]: any }, priority: number }
local overrides: { Override } = {}
local nextId = 0
local cycleStart = os.clock()
local atmosphere: Atmosphere? = nil

local BASE = {
	Brightness = 2.4,
	Ambient = Color3.fromRGB(46, 46, 56),
	OutdoorAmbient = Color3.fromRGB(128, 128, 142),
	FogEnd = 100000,
	ExposureCompensation = 0,
	AtmosphereDensity = 0.28,
	AtmosphereColor = Color3.fromRGB(199, 220, 255),
	AtmosphereDecay = Color3.fromRGB(106, 120, 160),
	AtmosphereHaze = 1.2,
	Gravity = BASE_GRAVITY,
	Clima = "",
}

function Ambience.setup()
	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		local a = Instance.new("Atmosphere")
		a.Density = BASE.AtmosphereDensity
		a.Offset = 0.15
		a.Color = BASE.AtmosphereColor
		a.Decay = BASE.AtmosphereDecay
		a.Glare = 0.4
		a.Haze = BASE.AtmosphereHaze
		a.Parent = Lighting
		atmosphere = a
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		local sky = Instance.new("Sky")
		sky.SunAngularSize = 14
		sky.MoonAngularSize = 9
		sky.StarCount = 3500
		sky.Parent = Lighting
	end
	if not Lighting:FindFirstChild("BrilhoIdeias") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "BrilhoIdeias"
		bloom.Intensity = 0.6
		bloom.Size = 26
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "CorIdeias"
		cc.Saturation = 0.12
		cc.Contrast = 0.06
		cc.Parent = Lighting
		local rays = Instance.new("SunRaysEffect")
		rays.Name = "RaiosIdeias"
		rays.Intensity = 0.05
		rays.Spread = 0.7
		rays.Parent = Lighting
	end
	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds")
	if not clouds then
		local c = Instance.new("Clouds")
		c.Cover = 0.55
		c.Density = 0.6
		c.Color = Color3.fromRGB(250, 252, 255)
		c.Parent = Workspace.Terrain
	end
end

local function baseClock(): number
	local dayLen = Config.World.DayLengthMinutes * 60
	local t = ((os.clock() - cycleStart) / dayLen) % 1
	-- dia mais longo que a noite: 06h -> 20h ocupa 70% do ciclo
	if t < 0.7 then
		return 6 + t / 0.7 * 14
	end
	return (20 + (t - 0.7) / 0.3 * 10) % 24
end

local function apply()
	local now = os.clock()
	for i = #overrides, 1, -1 do
		if now >= overrides[i].expires then
			table.remove(overrides, i)
		end
	end
	table.sort(overrides, function(a, b)
		return a.priority < b.priority
	end)
	local state = table.clone(BASE)
	state.ClockTime = baseClock()
	for _, o in overrides do
		for k, v in o.props do
			state[k] = v
		end
	end
	Lighting.ClockTime = state.ClockTime
	Lighting.Brightness = state.Brightness
	Lighting.Ambient = state.Ambient
	Lighting.OutdoorAmbient = state.OutdoorAmbient
	Lighting.FogEnd = state.FogEnd
	Lighting.ExposureCompensation = state.ExposureCompensation
	if atmosphere then
		atmosphere.Density = state.AtmosphereDensity
		atmosphere.Color = state.AtmosphereColor
		atmosphere.Decay = state.AtmosphereDecay
		atmosphere.Haze = state.AtmosphereHaze
	end
	if math.abs(Workspace.Gravity - state.Gravity) > 0.01 then
		Workspace.Gravity = state.Gravity
	end
	Workspace:SetAttribute("Clima", state.Clima)
end

-- empurra uma alteração temporária; retorna função que a remove antes do prazo
function Ambience.push(props: { [string]: any }, duration: number, priority: number?): () -> ()
	nextId += 1
	local o: Override = { id = nextId, expires = os.clock() + duration, props = props, priority = priority or 1 }
	table.insert(overrides, o)
	apply()
	return function()
		local i = table.find(overrides, o)
		if i then
			table.remove(overrides, i)
			apply()
		end
	end
end

function Ambience.clearAll()
	table.clear(overrides)
	apply()
end

function Ambience.clock(): number
	return Lighting.ClockTime
end

function Ambience.start()
	Ambience.setup()
	task.spawn(function()
		while true do
			apply()
			task.wait(1)
		end
	end)
end

Ambience.BaseGravity = BASE_GRAVITY
Ambience._tween = TweenService

return Ambience
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source"><![CDATA[--!strict
-- Inicialização do servidor. Também usado pelos testes na nuvem
-- (Luau Execution), que não executam Scripts automaticamente.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.IdeiasShared
local Catalog = require(Shared.Catalog)
local Lexicon = require(Shared.Lexicon)

local Core = script.Parent
local Server = Core.Parent
local EventManager = require(Core.EventManager)
local Status = require(Core.Status)
local Ambience = require(Core.Ambience)
local Destruction = require(Core.Destruction)
local Reactions = require(Core.Reactions)
local Requests = require(Core.Requests)
local RequestGate = require(Core.RequestGate)
local Combat = require(Core.Combat)
local PropActions = require(Core.PropActions)
local Brain = require(Server.Brains.Brain)

local Bootstrap = {}
Bootstrap.started = false
Bootstrap.mapStats = nil :: any

function Bootstrap.start(opts: { map: boolean?, remotes: boolean?, progress: boolean? }?)
	if Bootstrap.started then
		return
	end
	Bootstrap.started = true
	local o = opts or {}
	local errors = Catalog.validate()
	for _, e in errors do
		warn("[Ideias] catálogo: " .. e)
	end
	for _, c in Lexicon.collisions() do
		warn("[Ideias] vocabulário: " .. c)
	end

	if o.map ~= false then
		local MapBuilder = require(Server.Map.MapBuilder)
		local ok, stats = pcall(MapBuilder.build, {})
		if ok then
			Bootstrap.mapStats = stats
			require(Server.Map.MapRuntime).start()
		else
			warn("[Ideias] falha ao gerar o mapa: " .. tostring(stats))
		end
	end

	Ambience.start()
	Status.start()
	Destruction.start()
	Brain.start()
	EventManager.init()
	Reactions.start(EventManager)

	local remotes = ReplicatedStorage:FindFirstChild("IdeiasRemotes")
	local estado = remotes and remotes:FindFirstChild("Estado") :: RemoteEvent?

	if o.progress ~= false then
		local Progress = require(Server.Progress.Progress)
		Progress.start(estado)
		Requests.progress = Progress
		PropActions.rewardHook = Progress.reward
		Combat.onKill(function(_victim, attacker)
			local owner = attacker and (if attacker.kind == "player" then attacker.player else attacker.owner)
			if owner and owner.Parent then
				Progress.onKill(owner)
			end
		end)
	end

	if o.remotes ~= false and remotes then
		local criar = remotes:FindFirstChild("Criar") :: RemoteFunction
		local acao = remotes:FindFirstChild("Acao") :: RemoteEvent
		criar.OnServerInvoke = function(player: Player, text: any)
			local ok, res = pcall(Requests.handle, player, text)
			if ok then
				return res
			end
			warn("[Ideias] erro no pedido: " .. tostring(res))
			return { ok = false, reason = "invalid", message = "Algo deu errado. Tente outra ideia." }
		end
		-- ações da interface: no máximo 10 a cada 5 s por jogador
		local actionHits: { [Player]: { number } } = {}
		Players.PlayerRemoving:Connect(function(p)
			actionHits[p] = nil
		end)
		acao.OnServerEvent:Connect(function(player: Player, action: any, arg: any)
			local hits = actionHits[player] or {}
			actionHits[player] = hits
			local now = os.clock()
			while hits[1] and now - hits[1] > 5 do
				table.remove(hits, 1)
			end
			if #hits >= 10 then
				return
			end
			table.insert(hits, now)
			if Requests.progress then
				pcall(Requests.progress.action, player, action, arg)
			end
		end)
		-- capacidade do mundo para a interface
		task.spawn(function()
			local last = ""
			while true do
				task.wait(1)
				local cap = EventManager.capacity()
				local key = cap.events .. "/" .. cap.npcs .. "/" .. math.floor(cap.load * 20)
				if key ~= last and estado then
					last = key
					estado:FireAllClients("capacidade", cap)
				end
			end
		end)
		Players.PlayerRemoving:Connect(function(player)
			RequestGate.forget(player)
			EventManager.removeOwnedBy(player)
		end)
	end
	print(string.format("[Ideias Sem Limites] servidor pronto: %d conceitos, %d palavras no vocabulário", #Catalog.Concepts, Lexicon.size()))
end

return Bootstrap
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Budget</string>
            <string name="Source"><![CDATA[--!strict
-- Orçamento global de desempenho. Cada acontecimento reserva um custo antes de
-- nascer e devolve ao ser removido. Nada nasce se o orçamento não comportar.

local Config = require(game:GetService("ReplicatedStorage").IdeiasShared.Config)

local Budget = {}

export type Cost = { events: number?, npcs: number?, dynamic: number?, effects: number?, parts: number? }

local KEYS = { "events", "npcs", "dynamic", "effects", "parts" }
local used: { [string]: number } = { events = 0, npcs = 0, dynamic = 0, effects = 0, parts = 0 }

function Budget.limits(): { [string]: number }
	return Config.Budget
end

function Budget.used(): { [string]: number }
	return table.clone(used)
end

function Budget.fits(cost: Cost): (boolean, string?)
	for _, k in KEYS do
		local need = (cost :: any)[k] or 0
		if need > 0 and used[k] + need > (Config.Budget :: any)[k] then
			return false, k
		end
	end
	return true, nil
end

-- quanto de "npcs"/"dynamic" ainda cabe (para reduzir quantidades)
function Budget.free(key: string): number
	return math.max(0, (Config.Budget :: any)[key] - used[key])
end

function Budget.reserve(cost: Cost)
	for _, k in KEYS do
		used[k] += (cost :: any)[k] or 0
	end
end

function Budget.release(cost: Cost)
	for _, k in KEYS do
		used[k] = math.max(0, used[k] - ((cost :: any)[k] or 0))
	end
end

function Budget.adjust(key: string, delta: number)
	used[key] = math.max(0, used[key] + delta)
end

function Budget.reset()
	for _, k in KEYS do
		used[k] = 0
	end
end

-- 0..1, usado no indicador de capacidade da interface
function Budget.load(): number
	local worst = 0
	for _, k in KEYS do
		worst = math.max(worst, used[k] / (Config.Budget :: any)[k])
	end
	return worst
end

return Budget
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Chains</string>
            <string name="Source"><![CDATA[--!strict
-- Cadeias de ação: "arma que atira cachorro e o cachorro caga elefante que o
-- elefante explode". Cada elo é um "nó" (EventSpec) criado DENTRO do
-- acontecimento raiz: mesma pasta, mesmo id (não brigam entre si), mesmo dono.
-- Limites: MAX_ALIVE elos vivos e MAX_TOTAL criados por raiz, sempre pelo
-- orçamento global (Budget). Ao remover a raiz, todos os elos somem juntos.

local Budget = require(script.Parent.Budget)
local Actors = require(script.Parent.Actors)
local Combat = require(script.Parent.Combat)
local Fx = require(script.Parent.Fx)

local Chains = {}

Chains.MAX_ALIVE = 10
Chains.MAX_TOTAL = 30
Chains.MAX_PER_ACTOR = 3

export type Entry = { handle: any, record: any, folder: Folder, spawnedAt: number }
export type State = { alive: number, total: number, entries: { Entry }, running: boolean }

local function rootOf(ctx: any): any
	return ctx.chainRoot or ctx
end

function Chains.state(ctx: any): State
	local root = rootOf(ctx)
	local rec = root.record
	if not rec.chain then
		rec.chain = { alive = 0, total = 0, entries = {}, running = false }
	end
	return rec.chain
end

local function releaseEntry(st: State, e: Entry)
	local idx = table.find(st.entries, e)
	if idx then
		table.remove(st.entries, idx)
		st.alive = math.max(0, st.alive - 1)
	end
	if e.handle and e.handle.stop then
		pcall(e.handle.stop)
	end
	if e.record then
		Budget.release(e.record.cost)
		e.record.cost = {}
	end
	if e.folder and e.folder.Parent then
		e.folder:Destroy()
	end
end

-- faxina dos elos terminados (NPC morto, explosão acabou...)
local function watch(root: any, st: State)
	if st.running then
		return
	end
	st.running = true
	task.spawn(function()
		while root.record.alive ~= false and root.folder.Parent do
			task.wait(1)
			for i = #st.entries, 1, -1 do
				local e = st.entries[i]
				local finished = false
				if e and e.handle and e.handle.done then
					local ok, res = pcall(e.handle.done)
					finished = ok and res == true
				end
				if e and (finished or not e.folder.Parent) then
					releaseEntry(st, e)
				end
			end
		end
		st.running = false
	end)
end

-- remove todos os elos (chamado quando o acontecimento raiz acaba)
function Chains.cleanup(rec: any)
	local st = rec.chain
	if not st then
		return
	end
	for i = #st.entries, 1, -1 do
		releaseEntry(st, st.entries[i])
	end
end

-- Cria um nó da cadeia em `cf`. opts.ttl: segundos de vida (clones)
function Chains.spawnNode(ctx: any, node: any, cf: CFrame, opts: { ttl: number? }?): any?
	local root = rootOf(ctx)
	if root.record.alive == false or not root.folder.Parent then
		return nil
	end
	local st = Chains.state(ctx)
	if st.total >= Chains.MAX_TOTAL or st.alive >= Chains.MAX_ALIVE then
		return nil
	end
	local manager = root.manager
	local handler = manager and manager.handler(node.handler)
	if not handler then
		return nil
	end
	local count = math.clamp(node.count or 1, 1, 3)
	local spec = table.clone(node)
	spec.count = count
	if spec.handler == "npc" then
		count = math.min(count, math.max(Budget.free("npcs"), 0))
		if count < 1 then
			return nil
		end
		spec.count = count
	end
	local cost = manager.estimate(spec)
	if not Budget.fits(cost) then
		return nil
	end
	Budget.reserve(cost)
	local folder = Instance.new("Folder")
	folder.Name = "Elo_" .. tostring(node.concept and node.concept.id or "?")
	folder.Parent = root.folder
	local childRecord = { id = root.id, cost = cost, alive = true }
	local child = {
		id = root.id,
		record = childRecord,
		spec = spec,
		def = node.concept,
		params = node.params,
		count = count,
		owner = root.owner,
		origin = cf,
		folder = folder,
		rng = root.rng:fork(st.total + 11),
		manager = manager,
		element = node.params and node.params.element,
		scale = (node.params and node.params.scale) or 1,
		lifetime = root.lifetime,
		plan = root.plan,
		chainRoot = root,
	}
	local ok, handle = pcall(handler.spawn, child)
	if not ok then
		warn("[Ideias] elo da cadeia falhou: " .. tostring(handle))
		Budget.release(cost)
		folder:Destroy()
		return nil
	end
	st.total += 1
	st.alive += 1
	local entry: Entry = { handle = handle, record = childRecord, folder = folder, spawnedAt = os.clock() }
	table.insert(st.entries, entry)
	watch(root, st)
	Chains.afterSpawn(handle, child)
	if opts and opts.ttl then
		task.delay(opts.ttl, function()
			if table.find(st.entries, entry) then
				for _, npc in (handle and handle.npcs) or {} do
					if Actors.alive(npc) then
						Fx.near(npc.root.Position, 300, "poof", { p = npc.root.Position, s = npc.scale })
					end
				end
				releaseEntry(st, entry)
			end
		end)
	end
	return handle
end

-- explosão de um ator da cadeia (ou de um objeto) com dano em área
local function blast(pos: Vector3, scale: number, attacker: any?)
	local s = math.clamp(scale, 0.6, 3)
	Fx.near(pos, 500, "boom", { p = pos, s = s })
	Fx.shake(pos, 0.8 * s, 160)
	if attacker then
		Combat.areaEnemies(pos, 9 * s, 45 * s, attacker, "fire", 70)
	end
end

local function behind(npc: any): CFrame
	local back = npc.root.CFrame * CFrame.new(0, 0, (npc.radius or 2) + 3)
	return CFrame.new(back.Position)
end

local POOP_WORDS = { caga = true, cagam = true, cagando = true, cagar = true, poops = true }

-- Liga as ações da frase a um NPC recém-criado
function Chains.attachNpc(npc: any, ctx: any, actions: { any })
	local spawnActs, explode, transformTo, multiply, grow, shrink = {}, false, nil, false, false, false
	for _, a in actions do
		if a.elementOnly then
			continue
		elseif a.verb == "spawn" and a.node then
			table.insert(spawnActs, a)
		elseif a.verb == "shoot" and a.node then
			npc.launchNode = a.node
			if not table.find(npc.attacks, "launch") then
				table.insert(npc.attacks, 1, "launch")
			end
		elseif a.verb == "transform" and a.node then
			transformTo = a.node
		elseif a.verb == "explode" then
			explode = true
		elseif a.verb == "multiply" then
			multiply = true
		elseif a.verb == "grow" then
			grow = true
		elseif a.verb == "shrink" then
			shrink = true
		end
	end
	local made = 0
	-- "caga/bota/solta/cospe X": cria X atrás de tempos em tempos
	if #spawnActs > 0 then
		task.spawn(function()
			task.wait(2 + math.random() * 1.5)
			while Actors.alive(npc) and made < Chains.MAX_PER_ACTOR do
				for _, a in spawnActs do
					if not Actors.alive(npc) then
						break
					end
					local cf = behind(npc)
					local poop = POOP_WORDS[a.word or ""] == true
					Fx.near(cf.Position, 300, if poop then "poop" else "poof", { p = cf.Position, s = npc.scale })
					if Chains.spawnNode(ctx, a.node, cf) then
						made += 1
					end
				end
				task.wait(4.5)
			end
		end)
	end
	if multiply then
		task.spawn(function()
			task.wait(3)
			local copies = 0
			while Actors.alive(npc) and copies < Chains.MAX_PER_ACTOR do
				local copy = table.clone(ctx.spec)
				local acts = {}
				for _, a in actions do
					if a.verb ~= "multiply" then
						table.insert(acts, a)
					end
				end
				copy.actions = acts
				copy.count = 1
				local cf = npc.root.CFrame * CFrame.new(math.random(-6, 6), 0, math.random(-6, 6))
				Fx.near(cf.Position, 300, "poof", { p = cf.Position, s = npc.scale })
				if Chains.spawnNode(ctx, copy, CFrame.new(cf.Position)) then
					copies += 1
				end
				task.wait(5)
			end
		end)
	end
	if grow or shrink then
		task.spawn(function()
			local k = 1
			for _ = 1, 6 do
				task.wait(2)
				if not Actors.alive(npc) then
					break
				end
				k *= if grow then 1.18 else 0.85
				pcall(function()
					(npc.model :: any):ScaleTo(k)
				end)
				npc.scale = (npc.scale or 1) * (if grow then 1.18 else 0.85)
				Fx.near(npc.root.Position, 300, "power", { p = npc.root.Position })
			end
		end)
	end
	if transformTo then
		task.delay(4 + math.random(), function()
			if not Actors.alive(npc) then
				return
			end
			local cf = CFrame.new(npc.root.Position)
			Fx.near(cf.Position, 400, "poof", { p = cf.Position, s = npc.scale * 1.5 })
			Fx.near(cf.Position, 400, "spawn", { p = cf.Position, s = npc.scale, c = Color3.fromRGB(255, 220, 120) })
			Chains.spawnNode(ctx, transformTo, cf)
			npc.silentDeath = true
			npc.humanoid.Health = 0
		end)
	end
	if explode then
		local fuse = if #spawnActs > 0 or multiply then 7.5 else 2.2 + math.random() * 1.6
		task.delay(fuse, function()
			if not Actors.alive(npc) then
				return
			end
			npc.model:SetAttribute("Pavio", workspace:GetServerTimeNow())
			Fx.near(npc.root.Position, 300, "fuse", { p = npc.root.Position, d = 1.1 })
			task.wait(1.1)
			if not Actors.alive(npc) then
				return
			end
			blast(npc.root.Position, npc.scale or 1, npc)
			npc.silentDeath = true
			npc.humanoid.Health = 0
		end)
	end
end

-- Chamado depois de qualquer acontecimento (raiz ou elo) com ações
function Chains.afterSpawn(handle: any, ctx: any)
	local actions = ctx.spec and ctx.spec.actions
	if not actions or #actions == 0 or not handle then
		return
	end
	if handle.npcs and #handle.npcs > 0 then
		for _, npc in handle.npcs do
			npc.ctx = ctx
			Chains.attachNpc(npc, ctx, actions)
		end
		return
	end
	-- objetos, construções, veículos: só "explode" faz sentido aqui
	for _, a in actions do
		if a.verb == "explode" then
			task.delay(2.5 + math.random(), function()
				if not ctx.folder.Parent then
					return
				end
				local pos = handle.position or ctx.origin.Position
				Fx.near(pos, 300, "fuse", { p = pos, d = 1 })
				task.wait(1)
				if not ctx.folder.Parent then
					return
				end
				local owner = ctx.owner and Actors.playerActor(ctx.owner)
				blast(pos, ctx.scale or 1, owner)
				for _, child in ctx.folder:GetChildren() do
					if not child:IsA("Folder") then
						child:Destroy()
					end
				end
				handle.exploded = true
			end)
			break
		end
	end
end

return Chains
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Combat</string>
            <string name="Source"><![CDATA[--!strict
-- Dano, cura e empurrões com regras de facção e PvP.
-- Todo dano passa por aqui: assim cooldowns, créditos de abate e status ficam
-- consistentes e o cliente nunca decide quem tomou dano.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.IdeiasShared.Config)
local Actors = require(script.Parent.Actors)
local Factions = require(script.Parent.Factions)
local Status = require(script.Parent.Status)
local Fx = require(script.Parent.Fx)

local Combat = {}

local killListeners: { (victim: any, attacker: any?) -> () } = {}

function Combat.onKill(fn: (victim: any, attacker: any?) -> ())
	table.insert(killListeners, fn)
end

local function creditOwner(attacker: any?): Player?
	if not attacker then
		return nil
	end
	if attacker.kind == "player" then
		return attacker.player
	end
	return attacker.owner
end

function Combat.canHurt(attacker: any?, victim: any): boolean
	if not victim or not victim.humanoid then
		return false
	end
	if attacker == victim then
		return false
	end
	if victim.invulnerable then
		return false -- personagens sagrados nunca tomam dano
	end
	if attacker and attacker.faction == "player" and victim.faction == "player" then
		return Config.Combat.PvP
	end
	-- NPCs de um jogador nunca machucam o próprio dono
	if attacker and victim.faction == "player" and attacker.owner == victim.player and attacker.faction ~= "hostile" then
		return false
	end
	return true
end

function Combat.damage(victim: any, amount: number, attacker: any?, element: string?): boolean
	if not victim or not Actors.alive(victim) then
		return false
	end
	if not Combat.canHurt(attacker, victim) then
		return false
	end
	local h: Humanoid = victim.humanoid
	if attacker then
		Factions.provoke(victim, attacker)
	end
	local scale = if victim.faction == "player" then Config.Combat.PlayerDamageScale else 1
	-- luz causa dano extra em mortos-vivos e sombras
	if element == "light" and victim.def and victim.def.tagSet and (victim.def.tagSet.undead or victim.def.tagSet.evil) then
		scale *= 1.6
	end
	local before = h.Health
	h:TakeDamage(amount * scale)
	if element then
		Status.applyElement(h, element)
	end
	local owner = creditOwner(attacker)
	if owner then
		h:SetAttribute("UltimoAtacante", owner.UserId)
	end
	if before > 0 and h.Health <= 0 and not h:GetAttribute("Abatido") then
		h:SetAttribute("Abatido", true)
		for _, fn in killListeners do
			task.spawn(fn, victim, attacker)
		end
	end
	return true
end

function Combat.heal(victim: any, amount: number)
	if victim and Actors.alive(victim) then
		local h: Humanoid = victim.humanoid
		h.Health = math.min(h.MaxHealth, h.Health + amount)
	end
end

-- empurrão: jogadores recebem o impulso pelo cliente (dono da física do personagem)
function Combat.push(victim: any, velocity: Vector3)
	if not victim or not Actors.alive(victim) then
		return
	end
	if victim.kind == "player" then
		Fx.impulse(victim.player, velocity)
	else
		local root: BasePart = victim.root
		if not root.Anchored then
			root.AssemblyLinearVelocity += velocity
		end
	end
end

-- dano em área com queda linear por distância
function Combat.area(pos: Vector3, radius: number, amount: number, attacker: any?, element: string?, knock: number?, filter: ((any) -> boolean)?): number
	local hits = 0
	for _, a in Actors.near(pos, radius) do
		if (not filter or filter(a)) and (not attacker or attacker == nil or a ~= attacker) then
			local d = (a.root.Position - pos).Magnitude
			local f = 1 - math.clamp(d / radius, 0, 1) * 0.6
			if Combat.damage(a, amount * f, attacker, element) then
				hits += 1
				if knock and knock > 0 then
					local dir = (a.root.Position - pos)
					dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.yAxis
					Combat.push(a, (dir + Vector3.new(0, 0.6, 0)).Unit * knock * f)
				end
			end
		end
	end
	return hits
end

-- dano em área só contra inimigos do atacante (para NPCs e ferramentas)
function Combat.areaEnemies(pos: Vector3, radius: number, amount: number, attacker: any, element: string?, knock: number?): number
	return Combat.area(pos, radius, amount, attacker, element, knock, function(a)
		if attacker.kind == "player" then
			return a.kind == "npc" and a.faction ~= "pet" and a.owner ~= attacker.player
		end
		return Factions.hostileTo(attacker, a)
	end)
end

return Combat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Destruction</string>
            <string name="Source"><![CDATA[--!strict
-- Áreas destrutíveis e regeneráveis do mapa. Peças com a tag "Destrutivel"
-- podem ser arremessadas por explosões, meteoros, tornados e ondas. Cada peça
-- guarda seu estado original e volta sozinha depois de alguns segundos
-- (ou na hora, com "restaurar").

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.IdeiasShared.Config)
local Budget = require(script.Parent.Budget)

local Destruction = {}

type Saved = { cf: CFrame, anchored: boolean, collide: boolean, restoreAt: number }
local saved: { [BasePart]: Saved } = {}
local loose = 0
local MAX_LOOSE = 160

local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include

local function refreshFilter()
	overlap.FilterDescendantsInstances = CollectionService:GetTagged("DestrutivelGrupo")
end

function Destruction.count(): number
	return loose
end

-- arremessa peças destrutíveis no raio
function Destruction.blast(pos: Vector3, radius: number, power: number, pull: boolean?)
	refreshFilter()
	overlap.MaxParts = 50
	local parts = Workspace:GetPartBoundsInRadius(pos, radius, overlap)
	local now = os.clock()
	for _, part in parts do
		if part:HasTag("Destrutivel") and loose < MAX_LOOSE then
			local s = saved[part]
			if not s then
				s = { cf = part.CFrame, anchored = part.Anchored, collide = part.CanCollide, restoreAt = 0 }
				saved[part] = s
				loose += 1
				Budget.adjust("dynamic", 1)
			end
			s.restoreAt = now + Config.World.RestoreDelay + math.random() * 6
			if part.Anchored then
				part.Anchored = false
				pcall(function()
					part:SetNetworkOwner(nil)
				end)
			end
			local dir = part.Position - pos
			dir = if dir.Magnitude > 0.1 then dir.Unit else Vector3.yAxis
			if pull then
				dir = -dir
			end
			local f = 1 - math.clamp((part.Position - pos).Magnitude / radius, 0, 1) * 0.5
			part.AssemblyLinearVelocity = (dir + Vector3.new(0, if pull then 0.2 else 0.8, 0)).Unit * power * f
			part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 6
		end
	end
end

local function restore(part: BasePart, s: Saved, smooth: boolean)
	saved[part] = nil
	loose -= 1
	Budget.adjust("dynamic", -1)
	if not part.Parent then
		return
	end
	part.Anchored = true
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
	part.CanCollide = s.collide
	if smooth and (part.Position - s.cf.Position).Magnitude < 400 then
		TweenService:Create(part, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = s.cf }):Play()
	else
		part.CFrame = s.cf
	end
	part.Anchored = s.anchored
end

function Destruction.restoreAll()
	for part, s in saved do
		restore(part, s, true)
	end
end

function Destruction.start()
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for part, s in saved do
				if now >= s.restoreAt or part.Position.Y < -200 then
					restore(part, s, true)
				end
			end
		end
	end)
end

return Destruction
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">EventManager</string>
            <string name="Source"><![CDATA[--!strict
-- Gerenciador de acontecimentos.
--   * calcula o custo de cada ideia e respeita o orçamento global
--   * recicla o acontecimento mais antigo quando o mundo está cheio
--   * cada acontecimento vive numa pasta própria em Workspace.IdeiasEventos:
--     remover a pasta remove tudo (nada fica esquecido no Workspace)
--   * tempo de vida controlado + faxina periódica
-- Handlers ficam em ServerScriptService.IdeiasServer.Handlers e se registram
-- pelo nome (novos tipos de acontecimento não exigem mudanças aqui).

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.IdeiasShared
local Config = require(Shared.Config)
local Rng = require(Shared.Util.Rng)
local Budget = require(script.Parent.Budget)
local Placement = require(script.Parent.Placement)

local EventManager = {}

export type Handle = {
	npcs: { any }?,
	anchor: BasePart?,
	position: Vector3?,
	radius: number?,
	elements: { string }?,
	stop: (() -> ())?,
	done: (() -> boolean)?,
	seat: Seat? | VehicleSeat?,
	model: Model?,
	[string]: any,
}

export type Record = {
	id: number,
	spec: any,
	def: any,
	owner: Player?,
	ownerId: number,
	createdAt: number,
	expiresAt: number,
	folder: Folder,
	cost: { [string]: number },
	handle: Handle?,
	label: string,
	alive: boolean,
	origin: CFrame,
}

local handlers: { [string]: any } = {}
local active: { Record } = {}
local nextId = 0
local root: Folder
local listeners = { spawned = {} :: { (Record) -> () }, removed = {} :: { (Record) -> () } }
local stats = { spawned = 0, removed = 0, recycled = 0, failed = 0, rejected = 0 }

EventManager.stats = stats

-- custos padrão por handler (os handlers podem sobrescrever com estimate())
local DEFAULT_COST = {
	npc = function(spec)
		return { events = 1, npcs = spec.count, effects = spec.count, parts = 30 * spec.count }
	end,
	vehicle = function(spec)
		return { events = 1, dynamic = 6 * spec.count, parts = 40 * spec.count, effects = 1 }
	end,
	building = function(spec)
		return { events = 1, parts = 160 * spec.count, effects = 2 }
	end,
	prop = function(spec)
		local physics = spec.params.physics and spec.count or 0
		return { events = 1, parts = 14 * spec.count, dynamic = physics, effects = 1 }
	end,
	disaster = function(_spec)
		return { events = 1, dynamic = 20, effects = 8, parts = 30 }
	end,
	rain = function(spec)
		return { events = 1, dynamic = if spec.heavy then 70 else 45, effects = 2 }
	end,
	world = function(_spec)
		return { events = 1, effects = 3, parts = 20 }
	end,
	power = function(_spec)
		return { events = 1, effects = 2 }
	end,
	tool = function(_spec)
		return { events = 1, parts = 8 }
	end,
}

function EventManager.registerHandler(name: string, handler: any)
	handlers[name] = handler
end

function EventManager.handler(name: string): any
	return handlers[name]
end

function EventManager.init()
	root = Workspace:FindFirstChild("IdeiasEventos") :: Folder
	if not root then
		root = Instance.new("Folder")
		root.Name = "IdeiasEventos"
		root.Parent = Workspace
	end
	local folder = script.Parent.Parent:FindFirstChild("Handlers")
	if folder then
		for _, mod in folder:GetChildren() do
			if mod:IsA("ModuleScript") then
				local ok, h = pcall(require, mod)
				if ok and type(h) == "table" and h.name then
					EventManager.registerHandler(h.name, h)
				else
					warn("[Ideias] handler inválido " .. mod.Name .. ": " .. tostring(h))
				end
			end
		end
	end
	-- faxina periódica
	task.spawn(function()
		while true do
			task.wait(1)
			EventManager.sweep()
		end
	end)
end

function EventManager.onSpawned(fn: (Record) -> ())
	table.insert(listeners.spawned, fn)
end

function EventManager.onRemoved(fn: (Record) -> ())
	table.insert(listeners.removed, fn)
end

function EventManager.active(): { Record }
	return active
end

function EventManager.estimate(spec: any): { [string]: number }
	local h = handlers[spec.handler]
	if h and h.estimate then
		return h.estimate(spec)
	end
	local f = DEFAULT_COST[spec.handler]
	return if f then f(spec) else { events = 1 }
end

function EventManager.remove(rec: Record, reason: string?)
	if not rec.alive then
		return
	end
	rec.alive = false
	local idx = table.find(active, rec)
	if idx then
		table.remove(active, idx)
	end
	if (rec :: any).chain then
		local Chains = require(script.Parent.Chains)
		pcall(Chains.cleanup, rec)
	end
	if rec.handle and rec.handle.stop then
		local ok, err = pcall(rec.handle.stop)
		if not ok then
			warn("[Ideias] erro ao encerrar " .. rec.label .. ": " .. tostring(err))
		end
	end
	if rec.folder then
		rec.folder:Destroy()
	end
	Budget.release(rec.cost)
	stats.removed += 1
	if reason == "recycled" then
		stats.recycled += 1
	end
	for _, fn in listeners.removed do
		task.spawn(fn, rec)
	end
end

function EventManager.removeOwnedBy(player: Player): number
	local n = 0
	for i = #active, 1, -1 do
		local rec = active[i]
		if rec and rec.owner == player then
			EventManager.remove(rec, "owner")
			n += 1
		end
	end
	return n
end

function EventManager.clearAll()
	for i = #active, 1, -1 do
		EventManager.remove(active[i], "clear")
	end
end

function EventManager.sweep()
	local now = os.clock()
	for i = #active, 1, -1 do
		local rec = active[i]
		if rec then
			local expired = now >= rec.expiresAt
			local finished = false
			if rec.handle and rec.handle.done then
				local ok, res = pcall(rec.handle.done)
				finished = ok and res == true
			end
			if expired or finished or not rec.folder.Parent then
				EventManager.remove(rec, if expired then "expired" else "finished")
			end
		end
	end
end

-- tenta abrir espaço removendo acontecimentos antigos (primeiro do mesmo dono)
local function makeRoom(cost: { [string]: number }, owner: Player?): boolean
	local fits = Budget.fits(cost)
	local attempts = 0
	while not fits and attempts < 5 do
		attempts += 1
		local victim: Record? = nil
		local now = os.clock()
		for _, rec in active do
			if now - rec.createdAt >= Config.Budget.recycleMinAge then
				if owner and rec.owner == owner then
					victim = rec
					break
				end
				if not victim then
					victim = rec
				end
			end
		end
		if not victim then
			return false
		end
		EventManager.remove(victim, "recycled")
		fits = Budget.fits(cost)
	end
	return fits
end

local function ownerCount(owner: Player?): { Record }
	local list = {}
	if owner then
		for _, rec in active do
			if rec.owner == owner then
				table.insert(list, rec)
			end
		end
	end
	return list
end

-- origem de cada acontecimento do plano
local function originFor(plan: any, spec: any, owner: Player?, index: number, total: number, rng: Rng.Rng): CFrame
	local cat = spec.concept.category
	local dist = Config.Limits.SpawnDistance
	if cat == "building" then
		dist = 34 * math.max(1, spec.params.scale or 1)
	elseif cat == "vehicle" then
		dist = 22
	elseif spec.concept.handler == "npc" then
		dist = 16 + 6 * math.max(1, spec.params.scale or 1)
	end
	if plan.location then
		local cf = Placement.region(plan.location.id, rng)
		return cf + Vector3.new((index - 1) * 20, 0, 0)
	end
	return Placement.forPlayer(owner, math.min(dist, 90), index, total)
end

export type ExecResult = { ok: boolean, records: { Record }, notes: { string }, reason: string? }

function EventManager.executePlan(plan: any, owner: Player?): ExecResult
	local result: ExecResult = { ok = false, records = {}, notes = {} }
	local rng = Rng.new(math.floor(os.clock() * 1000) % 2147483647 + (owner and owner.UserId or 0))
	local total = #plan.events
	local byIndex: { [number]: Record } = {}

	for index, spec in plan.events do
		local handler = handlers[spec.handler]
		if not handler then
			table.insert(result.notes, "Sem executor para " .. spec.label)
			stats.failed += 1
			continue
		end
		-- reduz quantidade de NPCs ao que cabe
		if spec.handler == "npc" then
			local free = Budget.free("npcs")
			if spec.count > free then
				if free < 1 then
					-- tenta reciclar antes de desistir
					makeRoom({ npcs = 1, events = 1 }, owner)
					free = Budget.free("npcs")
				end
				if free >= 1 and spec.count > free then
					table.insert(result.notes, string.format("%s: %d (mundo quase cheio)", spec.concept.label, free))
					spec.count = free
				end
			end
		end
		local cost = EventManager.estimate(spec)
		-- limite por jogador: recicla as ideias antigas do próprio jogador
		local mine = ownerCount(owner)
		while #mine >= Config.Budget.perPlayer do
			EventManager.remove(mine[1], "recycled")
			table.remove(mine, 1)
		end
		if not makeRoom(cost, owner) then
			stats.rejected += 1
			table.insert(result.notes, "Mundo cheio: " .. spec.label .. " não coube agora")
			result.reason = "full"
			continue
		end

		nextId += 1
		local folder = Instance.new("Folder")
		folder.Name = string.format("Ev%d_%s", nextId, spec.concept.id)
		folder:SetAttribute("Conceito", spec.concept.id)
		folder:SetAttribute("Rotulo", spec.label)
		folder:SetAttribute("Dono", owner and owner.UserId or 0)
		folder.Parent = root

		local lifetime = math.min(spec.concept.lifetime or Config.Limits.DefaultLifetime, Config.Limits.MaxLifetime)
		local origin = originFor(plan, spec, owner, index, total, rng)
		local rec: Record = {
			id = nextId,
			spec = spec,
			def = spec.concept,
			owner = owner,
			ownerId = owner and owner.UserId or 0,
			createdAt = os.clock(),
			expiresAt = os.clock() + lifetime,
			folder = folder,
			cost = cost,
			handle = nil,
			label = spec.label,
			alive = true,
			origin = origin,
		}
		Budget.reserve(cost)
		local ctx = {
			id = rec.id,
			record = rec,
			spec = spec,
			def = spec.concept,
			params = spec.params,
			count = spec.count,
			owner = owner,
			origin = origin,
			folder = folder,
			rng = rng:fork(index),
			manager = EventManager,
			element = spec.params.element,
			scale = spec.params.scale or 1,
			lifetime = lifetime,
			plan = plan,
		}
		local ok, handleOrErr = pcall(handler.spawn, ctx)
		if not ok then
			warn("[Ideias] falha ao criar " .. spec.label .. ": " .. tostring(handleOrErr))
			folder:Destroy()
			Budget.release(cost)
			stats.failed += 1
			table.insert(result.notes, "Falhou: " .. spec.label)
			continue
		end
		rec.handle = handleOrErr
		if spec.actions and #spec.actions > 0 then
			local Chains = require(script.Parent.Chains)
			local okC, errC = pcall(Chains.afterSpawn, handleOrErr, ctx)
			if not okC then
				warn("[Ideias] cadeia falhou: " .. tostring(errC))
			end
		end
		table.insert(active, rec)
		byIndex[index] = rec
		table.insert(result.records, rec)
		stats.spawned += 1
		for _, fn in listeners.spawned do
			task.spawn(fn, rec)
		end
	end

	-- vínculos entre as ideias (rivais, guarda, montaria...)
	local Links = require(script.Parent.Links)
	for _, link in plan.links or {} do
		local a = byIndex[link.a]
		local b = if link.b and link.b > 0 then byIndex[link.b] else nil
		if a then
			local ok, err = pcall(Links.apply, link.type, a, b, owner)
			if not ok then
				warn("[Ideias] vínculo " .. link.type .. " falhou: " .. tostring(err))
			end
		end
	end

	result.ok = #result.records > 0
	return result
end

function EventManager.capacity(): { [string]: any }
	local used = Budget.used()
	return {
		events = #active,
		maxEvents = Config.Budget.events,
		npcs = used.npcs,
		maxNpcs = Config.Budget.npcs,
		load = Budget.load(),
	}
end

-- prolonga a vida (ex.: construção protegida por um dragão)
function EventManager.extend(rec: Record, seconds: number)
	rec.expiresAt = math.max(rec.expiresAt, os.clock() + seconds)
end

return EventManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">Factions</string>
            <string name="Source"><![CDATA[--!strict
-- Quem ataca quem. Facções: hostile, ally, pet, neutral, player.
-- Vínculos de rivalidade/caça entre acontecimentos têm prioridade.

local Factions = {}

export type Actor = {
	faction: string,
	eventId: number?,
	enemies: { [number]: boolean }?, -- ids de acontecimentos rivais
	prey: { [number]: boolean }?, -- ids de acontecimentos caçados
	provokedBy: { [any]: number }?, -- atacantes recentes -> instante
	owner: Player?,
}

local now = os.clock

-- a é inimigo de b?
function Factions.hostileTo(a: Actor, b: Actor): boolean
	if a == b then
		return false
	end
	if a.eventId and b.eventId and a.eventId == b.eventId then
		return false
	end
	if (b :: any).invulnerable or (a :: any).invulnerable then
		return false -- ninguém briga com personagens sagrados (e eles não brigam)
	end
	local calm = (a :: any).calmUntil
	if calm and now() < calm then
		return false -- acalmado pela Luz Celestial / presença de Jesus
	end
	if b.eventId and a.enemies and a.enemies[b.eventId] then
		return true
	end
	if b.eventId and a.prey and a.prey[b.eventId] then
		return true
	end
	if a.provokedBy then
		local key: any = if b.eventId then b.eventId else b.owner
		local t = a.provokedBy[key]
		if t and now() - t < 12 then
			return true
		end
	end
	local fa, fb = a.faction, b.faction
	if fa == "hostile" then
		return fb == "player" or fb == "ally" or fb == "pet"
	elseif fa == "ally" or fa == "pet" then
		return fb == "hostile"
	end
	return false
end

-- registra provocação (neutros revidam por alguns segundos)
function Factions.provoke(victim: Actor, attacker: Actor)
	if victim.faction == "player" then
		return
	end
	victim.provokedBy = victim.provokedBy or {}
	local key: any = if attacker.eventId then attacker.eventId else attacker.owner
	if key then
		(victim.provokedBy :: any)[key] = now()
	end
end

return Factions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- Efeitos visuais enviados aos clientes próximos (UnreliableRemoteEvent "Fx").
-- O servidor decide o que acontece; os clientes desenham (rastros, ondas de
-- choque, tremor de câmera, empurrões no próprio personagem).
-- Mantém o tráfego baixo: só jogadores dentro do raio recebem.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Fx = {}

local remote: any = nil
local function getRemote(): any
	if remote then
		return remote
	end
	local folder = ReplicatedStorage:FindFirstChild("IdeiasRemotes")
	remote = folder and folder:FindFirstChild("Fx")
	return remote
end

Fx.sent = 0

local function rootOf(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- envia para jogadores a até `radius` studs de `pos` (radius nil = todos)
function Fx.near(pos: Vector3?, radius: number?, kind: string, data: { [string]: any })
	local r = getRemote()
	if not r then
		return
	end
	data.k = kind
	for _, player in Players:GetPlayers() do
		local ok = true
		if pos and radius then
			local root = rootOf(player)
			ok = root ~= nil and (root.Position - pos).Magnitude <= radius
		end
		if ok then
			-- pcall: o jogador pode ter saído entre a checagem e o envio
			if pcall(r.FireClient, r, player, data) then
				Fx.sent += 1
			end
		end
	end
end

function Fx.to(player: Player, kind: string, data: { [string]: any })
	local r = getRemote()
	if r then
		data.k = kind
		if pcall(r.FireClient, r, player, data) then
			Fx.sent += 1
		end
	end
end

-- atalhos ---------------------------------------------------------------------
function Fx.shockwave(pos: Vector3, radius: number, color: Color3)
	Fx.near(pos, 400, "ring", { p = pos, r = radius, c = color })
end

function Fx.shake(pos: Vector3, intensity: number, radius: number)
	Fx.near(pos, radius, "shake", { p = pos, i = intensity })
end

function Fx.flash(pos: Vector3, color: Color3, size: number)
	Fx.near(pos, 500, "flash", { p = pos, c = color, s = size })
end

function Fx.bolt(from: Vector3, to: Vector3, color: Color3, speed: number, width: number?)
	Fx.near(from, 350, "bolt", { a = from, b = to, c = color, v = speed, w = width or 0.6 })
end

function Fx.zap(from: Vector3, to: Vector3, color: Color3)
	Fx.near(from, 400, "zap", { a = from, b = to, c = color })
end

-- empurra personagens de jogadores (o cliente aplica no próprio corpo)
function Fx.impulse(player: Player, velocity: Vector3, mode: string?)
	Fx.to(player, "push", { v = velocity, m = mode or "add" })
end

function Fx.blind(player: Player, color: Color3, duration: number)
	Fx.to(player, "tint", { c = color, d = duration })
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Links</string>
            <string name="Source"><![CDATA[--!strict
-- Vínculos entre acontecimentos do mesmo pedido.
--   rivals    os NPCs de A e B lutam entre si
--   guard     NPCs de A protegem a posição de B (atacam quem se aproxima)
--   bodyguard NPCs de A seguem e defendem o jogador que pediu
--   ride      NPC de A monta/dirige B (veículo ou criatura)
--   at        A aparece dentro/perto de B
--   hunt      A persegue B; B foge de A

local Links = {}

local function npcsOf(rec: any): { any }
	return rec and rec.handle and rec.handle.npcs or {}
end

local function centerOf(rec: any): Vector3
	local h = rec.handle
	if h then
		if h.position then
			return h.position
		end
		if h.anchor and h.anchor.Parent then
			return h.anchor.Position
		end
		if h.model and h.model.PrimaryPart then
			return h.model.PrimaryPart.Position
		end
	end
	return rec.origin.Position
end

local function radiusOf(rec: any): number
	return rec.handle and rec.handle.radius or 25
end

local apply = {}

function apply.rivals(a: any, b: any)
	for _, n in npcsOf(a) do
		n.enemies = n.enemies or {}
		n.enemies[b.id] = true
	end
	for _, n in npcsOf(b) do
		n.enemies = n.enemies or {}
		n.enemies[a.id] = true
	end
	-- aproxima os grupos para a luta começar logo
	local ca, cb = centerOf(a), centerOf(b)
	local mid = (ca + cb) / 2
	for _, n in npcsOf(b) do
		if n.root and n.root.Parent and (n.root.Position - mid).Magnitude > 60 then
			n.root.CFrame = CFrame.new(mid + Vector3.new(math.random(-8, 8), 6, math.random(-8, 8)))
		end
	end
end

function apply.guard(a: any, b: any)
	local pos = centerOf(b)
	local radius = radiusOf(b) + 12
	for _, n in npcsOf(a) do
		n.guard = { position = pos, radius = radius }
		n.home = pos
	end
	-- a construção vive enquanto o guardião viver
	if a.expiresAt > b.expiresAt then
		b.expiresAt = a.expiresAt
	end
end

function apply.bodyguard(a: any, _b: any, owner: Player?)
	for _, n in npcsOf(a) do
		n.faction = "pet"
		n.owner = owner
	end
end

function apply.ride(a: any, b: any)
	local riders = npcsOf(a)
	local rider = riders[1]
	if not rider or not b then
		return
	end
	local seat = b.handle and b.handle.seat
	if seat and seat.Parent then
		rider.riding = true
		rider.root.CFrame = seat.CFrame + Vector3.new(0, 3, 0)
		task.defer(function()
			if seat.Parent and rider.humanoid.Parent then
				(seat :: any):Sit(rider.humanoid)
			end
		end)
		b.handle.autopilot = true
		return
	end
	local mounts = npcsOf(b)
	local mount = mounts[1]
	if mount and mount.root and rider.root then
		rider.riding = true
		rider.humanoid.PlatformStand = true
		local top = mount.height or 6
		rider.root.CFrame = mount.root.CFrame * CFrame.new(0, top * 0.6, 0)
		for _, d in rider.model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Massless = true
				d.CanCollide = false
			end
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = mount.root
		weld.Part1 = rider.root
		weld.Parent = rider.root
		-- montaria e cavaleiro lutam do mesmo lado
		mount.faction = rider.faction
		mount.owner = rider.owner
	end
end

function apply.at(a: any, b: any)
	local pos = centerOf(b)
	local i = 0
	for _, n in npcsOf(a) do
		i += 1
		if n.root and n.root.Parent then
			local ang = i * 2.3
			n.root.CFrame = CFrame.new(pos + Vector3.new(math.cos(ang) * 6, 5, math.sin(ang) * 6))
			n.home = pos
		end
	end
	local model = a.handle and a.handle.model
	if model and model.Parent and #npcsOf(a) == 0 then
		model:PivotTo(CFrame.new(pos + Vector3.new(0, 4, 0)))
	end
end

function apply.hunt(a: any, b: any)
	for _, n in npcsOf(a) do
		n.prey = n.prey or {}
		n.prey[b.id] = true
	end
	for _, n in npcsOf(b) do
		n.fleeFrom = n.fleeFrom or {}
		n.fleeFrom[a.id] = true
	end
end

function Links.apply(kind: string, a: any, b: any, owner: Player?)
	local f = apply[kind]
	if f then
		f(a, b, owner)
	end
end

return Links
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">Placement</string>
            <string name="Source"><![CDATA[--!strict
-- Onde cada acontecimento aparece: à frente do jogador, em uma região
-- escolhida ("no vulcão"), no céu, ou perto do centro quando não há dono.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapLayout = require(ReplicatedStorage.IdeiasShared.MapLayout)
local Rng = require(ReplicatedStorage.IdeiasShared.Util.Rng)

local Placement = {}

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.IgnoreWater = false

local function refreshFilter()
	local ignore = {}
	local ev = Workspace:FindFirstChild("IdeiasEventos")
	if ev then
		table.insert(ignore, ev)
	end
	for _, p in game:GetService("Players"):GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	params.FilterDescendantsInstances = ignore
end

-- ponto no chão abaixo (ou acima) de pos
function Placement.ground(pos: Vector3, fromHeight: number?): Vector3
	refreshFilter()
	local up = fromHeight or 140
	local result = Workspace:Raycast(pos + Vector3.new(0, up, 0), Vector3.new(0, -up - 400, 0), params)
	if result then
		return result.Position
	end
	return Vector3.new(pos.X, 0, pos.Z)
end

local function facing(at: Vector3, lookTo: Vector3): CFrame
	local flat = Vector3.new(lookTo.X, at.Y, lookTo.Z)
	if (flat - at).Magnitude < 0.1 then
		return CFrame.new(at)
	end
	return CFrame.lookAt(at, flat)
end

-- à frente do jogador; index/total espalham várias ideias lado a lado
function Placement.forPlayer(player: Player?, distance: number, index: number?, total: number?): CFrame
	local char = player and player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local i, n = index or 1, total or 1
	if not root then
		local base = Vector3.new((i - (n + 1) / 2) * 24, 0, -30)
		return facing(Placement.ground(base), Vector3.new(0, 0, 30))
	end
	local look = root.CFrame.LookVector
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude < 0.1 then
		look = Vector3.new(0, 0, -1)
	end
	look = look.Unit
	local right = look:Cross(Vector3.yAxis)
	local lateral = (i - (n + 1) / 2) * (distance * 0.9)
	local target = root.Position + look * distance + right * lateral
	local g = Placement.ground(target, 60)
	return facing(g, root.Position)
end

function Placement.region(regionId: string, rng: Rng.Rng): CFrame
	local r = MapLayout.ById[regionId] or MapLayout.ById.hub
	local ang = rng:range(0, math.pi * 2)
	local dist = rng:range(0, r.radius * 0.5)
	local pos = r.center + Vector3.new(math.cos(ang) * dist, 0, math.sin(ang) * dist)
	if regionId == "sky" then
		return CFrame.new(Placement.ground(pos + Vector3.new(0, 60, 0), 20))
	elseif regionId == "arena" then
		return CFrame.new(Placement.ground(r.center + Vector3.new(rng:range(-30, 30), 10, rng:range(-30, 30)), 15))
	end
	return facing(Placement.ground(pos), r.center)
end

function Placement.sky(base: CFrame, height: number): CFrame
	return base + Vector3.new(0, height, 0)
end

return Placement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">PropActions</string>
            <string name="Source"><![CDATA[--!strict
-- Interações dos objetos criados (comer, abrir presente, acender dinamite,
-- disparar canhão, vestir chapéu, fogueira que cura...). Usa ProximityPrompt:
-- funciona igual no celular (toque) e no computador (tecla E).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Combat = require(script.Parent.Combat)
local Actors = require(script.Parent.Actors)
local Status = require(script.Parent.Status)
local Fx = require(script.Parent.Fx)
local Destruction = require(script.Parent.Destruction)
local Kit = require(script.Parent.Parent.Builders.Kit)
local Config = require(ReplicatedStorage.IdeiasShared.Config)

local PropActions = {}

PropActions.rewardHook = nil :: ((Player, string, number) -> ())?

local function prompt(part: BasePart, action: string, object: string, hold: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.Parent = part
	return p
end

local function sound(parent: Instance, id: string, volume: number?)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.6
	s.Parent = parent
	s:Play()
	Debris:AddItem(s, 4)
end

function PropActions.explode(pos: Vector3, power: number, attacker: any?)
	Fx.flash(pos, Color3.fromRGB(255, 170, 60), 18 * power)
	Fx.shockwave(pos, 22 * power, Color3.fromRGB(255, 140, 40))
	Fx.shake(pos, 1.2 * power, 160)
	Fx.near(pos, 500, "boom", { p = pos, s = power })
	Combat.area(pos, 18 * power, 40 * power, attacker, "fire", 80 * power)
	Destruction.blast(pos, 24 * power, 110 * power)
end

local RANDOM_POWERS = { "heal", "speed", "jump", "shield", "aura", "giant", "tiny" }

function PropActions.attach(model: Model, main: BasePart, kind: string?, params: { [string]: any }, ctx: any)
	local label = ctx.def.label
	if params.edible then
		local p = prompt(main, "Comer", label)
		p.Triggered:Connect(function(player)
			local a = Actors.playerActor(player)
			if Actors.alive(a) then
				Combat.heal(a, 25)
				Fx.to(player, "toast", { t = "Nham! +25 de vida", c = Color3.fromRGB(120, 255, 140) })
				if params.element then
					Status.applyElement(a.humanoid, params.element)
				end
				if PropActions.rewardHook then
					PropActions.rewardHook(player, "eat", 1)
				end
			end
			sound(main, Config.Sounds.Splat, 0.5)
			model:Destroy()
		end)
	end
	if kind == "gift" then
		local p = prompt(main, "Abrir", label)
		p.Triggered:Connect(function(player)
			Fx.near(main.Position, 300, "confetti", { p = main.Position })
			local power = RANDOM_POWERS[math.random(1, #RANDOM_POWERS)]
			local Power = require(script.Parent.Parent.Handlers.Power)
			pcall(Power.apply, player, power, nil)
			if PropActions.rewardHook then
				PropActions.rewardHook(player, "gift", 1)
			end
			model:Destroy()
		end)
	elseif kind == "treasure" then
		local p = prompt(main, "Abrir", label, 0.5)
		p.Triggered:Connect(function(player)
			Fx.near(main.Position, 300, "confetti", { p = main.Position, gold = true })
			Fx.to(player, "toast", { t = "Tesouro! +10 Faíscas", c = Color3.fromRGB(255, 215, 80) })
			if PropActions.rewardHook then
				PropActions.rewardHook(player, "treasure", 10)
			end
			p.Enabled = false
		end)
	elseif kind == "explode" then
		local fuse = params.fuse
		local function boom(player: Player?)
			if not model.Parent then
				return
			end
			local pos = main.Position
			model:Destroy()
			PropActions.explode(pos, 1.2 * (params.scale or 1), if player then Actors.playerActor(player) else nil)
		end
		if fuse then
			task.delay(fuse, function()
				boom(ctx.owner)
			end)
		else
			local p = prompt(main, "Acender", label)
			p.Triggered:Connect(function(player)
				p.Enabled = false
				local sp = Instance.new("Sparkles")
				sp.Parent = main
				task.delay(2.5, function()
					boom(player)
				end)
			end)
		end
	elseif kind == "cannon" then
		local p = prompt(main, "Disparar", label)
		local cooldown = 0
		p.Triggered:Connect(function(player)
			if os.clock() < cooldown then
				return
			end
			cooldown = os.clock() + 2
			local dir = main.CFrame.LookVector
			local from = main.Position + Vector3.new(0, 3, 0) + dir * 4
			local to = from + dir * 140 + Vector3.new(0, -20, 0)
			Fx.bolt(from, to, Color3.fromRGB(40, 40, 45), 140, 2)
			sound(main, Config.Sounds.Rocket, 0.8)
			task.delay(1, function()
				PropActions.explode(to, 1, Actors.playerActor(player))
			end)
		end)
	elseif kind == "magnet" then
		task.spawn(function()
			while model.Parent do
				Destruction.blast(main.Position, 40, 30, true)
				for _, a in Actors.near(main.Position, 40) do
					if a.kind == "npc" then
						local d = main.Position - a.root.Position
						if d.Magnitude > 5 then
							Combat.push(a, d.Unit * 18)
						end
					end
				end
				task.wait(0.6)
			end
		end)
	elseif kind == "party" then
		model:SetAttribute("Festa", true)
		task.spawn(function()
			while model.Parent do
				for _, a in Actors.near(main.Position, 60) do
					if a.kind == "npc" and a.faction ~= "hostile" then
						a.behavior = "dance"
					end
				end
				task.wait(2)
			end
		end)
	elseif kind == "heal" then
		task.spawn(function()
			while model.Parent do
				for _, a in Actors.near(main.Position, 16) do
					if a.kind == "player" then
						Combat.heal(a, 6)
						Status.clear(a.humanoid, "freeze")
					end
				end
				task.wait(1.5)
			end
		end)
	elseif kind == "bounce" then
		local top = model:FindFirstChild("Chapeu") :: BasePart?
		if top then
			top:AddTag("IdeiasPulo")
			top:SetAttribute("Forca", 120)
		end
	elseif kind == "wind" then
		task.spawn(function()
			while model.Parent do
				local look = main.CFrame.LookVector
				for _, a in Actors.near(main.Position, 45) do
					local to = a.root.Position - main.Position
					if to.Magnitude > 0.1 and look:Dot(to.Unit) > 0.6 then
						Combat.push(a, look * 35)
					end
				end
				task.wait(0.5)
			end
		end)
	elseif kind == "wear" then
		local p = prompt(main, "Vestir", label)
		p.Triggered:Connect(function(player)
			local char = player.Character
			local head = char and char:FindFirstChild("Head") :: BasePart?
			if not head then
				return
			end
			local old = char:FindFirstChild("ChapeuIdeias")
			if old then
				old:Destroy()
			end
			local hat = model:Clone()
			hat.Name = "ChapeuIdeias"
			local hb = hat.PrimaryPart :: BasePart
			local scale = 1.4 / math.max(hb.Size.X, 0.5)
			for _, d in hat:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = false
					d.CanCollide = false
					d.Massless = true
					d.Size *= scale
				elseif d:IsA("ProximityPrompt") then
					d:Destroy()
				end
			end
			hat:PivotTo(head.CFrame * CFrame.new(0, head.Size.Y * 0.55, 0))
			for _, d in hat:GetDescendants() do
				if d:IsA("BasePart") then
					local w = Instance.new("WeldConstraint")
					w.Part0 = head
					w.Part1 = d
					w.Parent = d
				end
			end
			hat.Parent = char
			Debris:AddItem(hat, 120)
		end)
	end
end

function PropActions.elementize(main: BasePart, params: { [string]: any })
	if params.elementMod and params.element then
		Kit.elementEffects(main, params.element, math.min(params.scale or 1, 2))
	end
end

PropActions._players = Players

return PropActions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">Reactions</string>
            <string name="Source"><![CDATA[--!strict
-- Interações entre acontecimentos ativos no mundo, por elemento e proximidade.
-- Ex.: tornado de fogo encontra explosão de gelo -> vapor e os dois enfraquecem;
-- chuva/tsunami apaga incêndios; eletricidade perto de água eletrifica a área;
-- lava + água vira obsidiana; fogo perto de natureza espalha chamas.
-- Regras são dados: novas reações não exigem mudar o laço.

local Combat = require(script.Parent.Combat)
local Fx = require(script.Parent.Fx)
local Kit = require(script.Parent.Parent.Builders.Kit)

local Reactions = {}

local function elementsOf(rec: any): { [string]: boolean }
	local set = {}
	local h = rec.handle
	if h and h.elements then
		for _, e in h.elements do
			if e then
				set[e] = true
			end
		end
	end
	local tags = rec.def.tagSet
	for _, t in { "fire", "ice", "water", "nature", "electric", "lava", "wind" } do
		if tags[t] then
			set[t] = true
		end
	end
	return set
end

local function positionOf(rec: any): Vector3?
	local h = rec.handle
	if not h then
		return nil
	end
	if h.positionAt then
		return h.positionAt()
	end
	return h.position
end

type Rule = { a: string, b: string, text: string, color: Color3, act: (ra: any, rb: any, pos: Vector3, manager: any) -> () }

local RULES: { Rule } = {
	{
		a = "fire",
		b = "ice",
		text = "Fogo + Gelo = Vapor!",
		color = Color3.fromRGB(230, 240, 255),
		act = function(ra, rb, pos, manager)
			Fx.near(pos, 400, "steam", { p = pos, s = 2 })
			ra.expiresAt = math.min(ra.expiresAt, os.clock() + 4)
			rb.expiresAt = math.min(rb.expiresAt, os.clock() + 4)
		end,
	},
	{
		a = "water",
		b = "fire",
		text = "A água apagou o fogo!",
		color = Color3.fromRGB(150, 210, 255),
		act = function(_ra, rb, pos, manager)
			Fx.near(pos, 400, "steam", { p = pos, s = 1.5 })
			if rb.handle and rb.handle.extinguish then
				rb.handle.extinguish()
			end
			rb.expiresAt = math.min(rb.expiresAt, os.clock() + 2)
		end,
	},
	{
		a = "electric",
		b = "water",
		text = "Água eletrificada!",
		color = Color3.fromRGB(255, 240, 120),
		act = function(_ra, _rb, pos)
			for i = 1, 5 do
				local p = pos + Vector3.new(math.random(-20, 20), 0, math.random(-20, 20))
				Fx.zap(p + Vector3.new(0, 30, 0), p, Color3.fromRGB(255, 240, 120))
				task.delay(i * 0.2, function()
					Combat.area(p, 10, 15, nil, "electric", 20)
				end)
			end
		end,
	},
	{
		a = "lava",
		b = "water",
		text = "Lava + Água = Obsidiana!",
		color = Color3.fromRGB(120, 90, 160),
		act = function(ra, _rb, pos)
			Fx.near(pos, 400, "steam", { p = pos, s = 2.5 })
			local b = Kit.new("Obsidiana", CFrame.new(pos), { anchored = true, collide = true })
			for k = 0, 6 do
				local a = k * 0.9
				b:part("wedge", Vector3.new(3, math.random(3, 7), 3), CFrame.new(math.cos(a) * 6, 2, math.sin(a) * 6) * CFrame.Angles(0, a, 0.2), Color3.fromRGB(35, 25, 45), { role = "fixed", material = Enum.Material.Glass, reflectance = 0.3 })
			end
			b:finish().Parent = ra.folder
		end,
	},
	{
		a = "ice",
		b = "water",
		text = "A água congelou!",
		color = Color3.fromRGB(180, 230, 255),
		act = function(_ra, rb, pos)
			Fx.shockwave(pos, 30, Color3.fromRGB(180, 230, 255))
			rb.expiresAt = math.min(rb.expiresAt, os.clock() + 1)
			for _, a in require(script.Parent.Actors).near(pos, 30) do
				require(script.Parent.Status).apply(a.humanoid, "freeze", 3)
			end
		end,
	},
	{
		a = "fire",
		b = "nature",
		text = "As chamas se espalharam!",
		color = Color3.fromRGB(255, 150, 60),
		act = function(_ra, rb, _pos)
			local n = 0
			for _, d in rb.folder:GetDescendants() do
				if d:IsA("BasePart") and n < 6 and math.random() < 0.3 then
					n += 1
					local f = Instance.new("Fire")
					f.Size = 6
					f.Parent = d
				end
			end
		end,
	},
	{
		a = "wind",
		b = "fire",
		text = "O vento alimentou o fogo!",
		color = Color3.fromRGB(255, 180, 90),
		act = function(_ra, rb, pos)
			Fx.shockwave(pos, 20, Color3.fromRGB(255, 160, 60))
			rb.expiresAt += 8
		end,
	},
	{
		a = "light",
		b = "shadow",
		text = "Luz e sombra se anularam!",
		color = Color3.fromRGB(255, 255, 230),
		act = function(_ra, _rb, pos)
			Fx.flash(pos, Color3.fromRGB(255, 255, 230), 40)
		end,
	},
}

Reactions.Rules = RULES
Reactions.count = 0

local done: { [string]: boolean } = {}

function Reactions.check(active: { any }, manager: any)
	for i = 1, #active do
		local ra = active[i]
		local pa = positionOf(ra)
		if pa and ra.alive then
			local ea = elementsOf(ra)
			for j = 1, #active do
				if i ~= j then
					local rb = active[j]
					local pb = positionOf(rb)
					if pb and rb.alive then
						local key = ra.id .. ":" .. rb.id
						if not done[key] then
							local reach = (ra.handle.radius or 10) + (rb.handle.radius or 10) + 10
							if (pa - pb).Magnitude <= reach then
								local eb = elementsOf(rb)
								for _, rule in RULES do
									if ea[rule.a] and eb[rule.b] then
										done[key] = true
										done[rb.id .. ":" .. ra.id] = true
										local mid = (pa + pb) / 2
										Reactions.count += 1
										Fx.near(mid, 600, "toast", { t = "✨ " .. rule.text, c = rule.color })
										local ok, err = pcall(rule.act, ra, rb, mid, manager)
										if not ok then
											warn("[Ideias] reação: " .. tostring(err))
										end
										break
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

function Reactions.start(manager: any)
	task.spawn(function()
		while true do
			task.wait(0.75)
			local ok, err = pcall(Reactions.check, manager.active(), manager)
			if not ok then
				warn("[Ideias] reações: " .. tostring(err))
			end
		end
	end)
	manager.onRemoved(function(rec)
		for key in done do
			if string.find(key, "^" .. rec.id .. ":") or string.find(key, ":" .. rec.id .. "$") then
				done[key] = nil
			end
		end
	end)
end

return Reactions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">RequestGate</string>
            <string name="Source"><![CDATA[--!strict
-- Porteiro dos pedidos vindos do cliente. Nunca confia no cliente:
--   * tipo e tamanho do texto, UTF-8 válido, sem caracteres de controle
--   * cooldown por jogador (relógio do servidor)
--   * detecção de spam de RemoteFunction com bloqueio temporário
--   * limite global de ideias por janela de tempo no servidor

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.IdeiasShared.Config)
local Normalizer = require(ReplicatedStorage.IdeiasShared.Text.Normalizer)

local RequestGate = {}

type State = { lastOk: number, hits: { number }, mutedUntil: number }

local states: { [any]: State } = {}
local globalHits: { number } = {}

local function stateFor(key: any): State
	local s = states[key]
	if not s then
		s = { lastOk = -math.huge, hits = {}, mutedUntil = 0 }
		states[key] = s
	end
	return s
end

local function prune(list: { number }, window: number, now: number)
	while list[1] and now - list[1] > window do
		table.remove(list, 1)
	end
end

export type Verdict = { ok: boolean, reason: string?, wait: number?, text: string? }

-- key: Player (ou qualquer chave nos testes); clock: relógio (injetável em testes)
function RequestGate.check(key: any, raw: any, clock: number?): Verdict
	local now = clock or os.clock()
	local s = stateFor(key)
	local R = Config.Request

	-- spam: conta TODAS as chamadas, inclusive inválidas
	prune(s.hits, R.SpamWindow, now)
	table.insert(s.hits, now)
	if now < s.mutedUntil then
		return { ok = false, reason = "spam", wait = s.mutedUntil - now }
	end
	if #s.hits > R.SpamMaxRequests then
		s.mutedUntil = now + R.SpamMute
		return { ok = false, reason = "spam", wait = R.SpamMute }
	end

	if type(raw) ~= "string" then
		return { ok = false, reason = "invalid" }
	end
	if #raw > R.MaxRawLength * 4 then
		return { ok = false, reason = "too_long" }
	end
	local text = Normalizer.sanitize(raw, R.MaxTextLength)
	if not text then
		return { ok = false, reason = "empty" }
	end

	local since = now - s.lastOk
	if since < R.Cooldown then
		return { ok = false, reason = "cooldown", wait = R.Cooldown - since }
	end

	prune(globalHits, R.GlobalWindow, now)
	if #globalHits >= R.GlobalMaxRequests then
		return { ok = false, reason = "busy", wait = R.GlobalWindow - (now - globalHits[1]) }
	end

	s.lastOk = now
	table.insert(globalHits, now)
	return { ok = true, text = text }
end

function RequestGate.forget(key: any)
	states[key] = nil
end

function RequestGate.reset()
	table.clear(states)
	table.clear(globalHits)
end

RequestGate.Messages = {
	spam = "Calma! Muitos pedidos seguidos. Aguarde alguns segundos.",
	invalid = "Pedido inválido.",
	too_long = "Texto longo demais.",
	empty = "Digite uma ideia primeiro.",
	cooldown = "Aguarde a recarga.",
	busy = "O servidor está criando muitas ideias. Tente em instantes.",
	full = "O mundo está cheio. Aguarde algumas ideias sumirem.",
}

return RequestGate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">Requests</string>
            <string name="Source"><![CDATA[--!strict
-- Ponto de entrada dos pedidos: RemoteFunction "Criar" -> porteiro ->
-- interpretador -> gerenciador -> progressão -> resposta ao cliente.
-- Para os outros jogadores só vão rótulos do catálogo e o DisplayName (já
-- filtrado pelo Roblox): nenhum texto livre digitado é retransmitido.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.IdeiasShared
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Planner = require(Shared.Planner)
local RequestGate = require(script.Parent.RequestGate)
local EventManager = require(script.Parent.EventManager)

local Requests = {}

Requests.progress = nil :: any
Requests.log = {} :: { any }

local function icon(plan: any): string
	local first = plan.events[1]
	local info = first and Catalog.CategoryInfo[first.concept.category]
	return if info then info.icon else "💡"
end

-- Nomes digitados ("verity") só aparecem depois do filtro de texto do Roblox.
-- Se o filtro falhar ou cortar o nome, vira "Personagem Misterioso".
local function filterNames(plan: any, player: Player)
	local changed = false
	local function visit(ev: any, depth: number)
		local name = ev.params and ev.params.customName
		if name then
			local ok, filtered = pcall(function()
				local TextService = game:GetService("TextService")
				local res = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
				return res:GetNonChatStringForBroadcastAsync()
			end)
			local safe = "Personagem Misterioso"
			if ok and type(filtered) == "string" and #filtered > 0 and not string.find(filtered, "#", 1, true) then
				safe = filtered
			end
			ev.params.customName = safe
			ev.baseLabel = safe
			changed = true
		end
		if depth < 6 then
			for _, a in ev.actions or {} do
				if a.node then
					visit(a.node, depth + 1)
				end
			end
		end
	end
	for _, ev in plan.events do
		visit(ev, 1)
	end
	if changed then
		Planner.relabel(plan)
	end
end

Requests.filterNames = filterNames

function Requests.handle(player: Player, raw: any): { [string]: any }
	local verdict = RequestGate.check(player, raw)
	if not verdict.ok then
		return {
			ok = false,
			reason = verdict.reason,
			wait = verdict.wait,
			message = RequestGate.Messages[verdict.reason or "invalid"] or "Não foi possível criar.",
		}
	end
	local okPlan, plan = pcall(Planner.plan, verdict.text :: string)
	if not okPlan then
		warn("[Ideias] interpretador falhou: " .. tostring(plan))
		return { ok = false, reason = "invalid", message = "Não entendi essa ideia." }
	end
	filterNames(plan, player)
	local result = EventManager.executePlan(plan, player)
	if #Requests.log > 50 then
		table.remove(Requests.log, 1)
	end
	table.insert(Requests.log, { user = player.UserId, label = plan.label, ok = result.ok, t = os.time() })
	if not result.ok then
		return {
			ok = false,
			reason = result.reason or "full",
			message = RequestGate.Messages[result.reason or "full"] or "O mundo está cheio.",
			notes = result.notes,
		}
	end
	local prog = { discovered = {}, secrets = {} }
	if Requests.progress then
		local okP, res = pcall(Requests.progress.onPlan, player, plan)
		if okP then
			prog = res
		end
	end
	-- avisa todo mundo (só textos do catálogo)
	local estado = ReplicatedStorage.IdeiasRemotes:FindFirstChild("Estado") :: RemoteEvent?
	if estado then
		for _, other in Players:GetPlayers() do
			if other ~= player then
				estado:FireClient(other, "feed", { name = player.DisplayName, label = plan.label, icon = icon(plan) })
			end
		end
	end
	local notes = table.clone(plan.notes)
	for _, n in result.notes do
		table.insert(notes, n)
	end
	return {
		ok = true,
		label = plan.label,
		icon = icon(plan),
		surprise = plan.surprise,
		notes = notes,
		cooldown = Config.Request.Cooldown,
		discovered = prog.discovered,
		secrets = prog.secrets,
		corrected = #plan.corrections > 0,
	}
end

return Requests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Status</string>
            <string name="Source"><![CDATA[--!strict
-- Efeitos de status em Humanoids (jogadores e NPCs): queimadura, congelamento,
-- choque, veneno, lentidão, pressa, pulo, escudo. A velocidade final é sempre
-- recalculada a partir do valor base, então efeitos acumulados nunca "vazam".

local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage").IdeiasShared.Config)

local Status = {}

type Effect = { kind: string, expires: number, power: number, visual: Instance? }
type Entry = { humanoid: Humanoid, effects: { [string]: Effect }, baseSpeed: number, baseJump: number }

local entries: { [Humanoid]: Entry } = {}

-- multiplicadores de velocidade por efeito
local SPEED = { freeze = 0.25, shock = 0, slow = 0.5, haste = 1.9, poison = 0.85, wet = 0.9, root = 0.15 }
local JUMP = { freeze = 0.4, shock = 0, superjump = 2.6, root = 0 }
local DOT = { burn = 6, poison = 4, acid = 5 }

local ELEMENT_STATUS = {
	fire = { "burn", 3 },
	lava = { "burn", 4.5 },
	ice = { "freeze", 2.5 },
	electric = { "shock", 0.9 },
	poison = { "poison", 5 },
	water = { "wet", 4 },
	nature = { "root", 1.5 },
	shadow = { "slow", 3 },
}

local function entryFor(h: Humanoid): Entry
	local e = entries[h]
	if not e then
		local baseSpeed = h:GetAttribute("BaseWalkSpeed")
		if type(baseSpeed) ~= "number" then
			baseSpeed = h.WalkSpeed
			h:SetAttribute("BaseWalkSpeed", baseSpeed)
		end
		local baseJump = h:GetAttribute("BaseJump")
		if type(baseJump) ~= "number" then
			baseJump = if h.UseJumpPower then h.JumpPower else h.JumpHeight
			h:SetAttribute("BaseJump", baseJump)
		end
		e = { humanoid = h, effects = {}, baseSpeed = baseSpeed :: number, baseJump = baseJump :: number }
		entries[h] = e
	end
	return e
end

local function recompute(e: Entry)
	local h = e.humanoid
	local sm, jm = 1, 1
	for kind, _ in e.effects do
		sm *= SPEED[kind] or 1
		jm *= JUMP[kind] or 1
	end
	h.WalkSpeed = e.baseSpeed * sm
	if h.UseJumpPower then
		h.JumpPower = e.baseJump * jm
	else
		h.JumpHeight = e.baseJump * jm
	end
end

local function makeVisual(kind: string, h: Humanoid): Instance?
	local model = h.Parent
	local root = model and (model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart"))
	if not root then
		return nil
	end
	if kind == "burn" then
		local f = Instance.new("Fire")
		f.Size = 4
		f.Heat = 6
		f.Parent = root
		return f
	elseif kind == "poison" or kind == "acid" then
		local s = Instance.new("Smoke")
		s.Color = Color3.fromRGB(120, 230, 60)
		s.Opacity = 0.25
		s.RiseVelocity = 2
		s.Size = 2
		s.Parent = root
		return s
	elseif kind == "shock" then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 240, 90)
		sp.Parent = root
		return sp
	elseif kind == "freeze" or kind == "shield" or kind == "haste" then
		local hl = Instance.new("Highlight")
		hl.FillColor = if kind == "freeze" then Color3.fromRGB(150, 220, 255) elseif kind == "shield" then Color3.fromRGB(255, 230, 120) else Color3.fromRGB(120, 255, 200)
		hl.FillTransparency = 0.55
		hl.OutlineTransparency = 0.3
		hl.DepthMode = Enum.HighlightDepthMode.Occluded
		hl.Parent = model
		return hl
	end
	return nil
end

function Status.apply(h: Humanoid?, kind: string, duration: number, power: number?)
	if not h or h.Health <= 0 then
		return
	end
	local e = entryFor(h)
	local existing = e.effects[kind]
	local expires = os.clock() + duration
	if existing then
		existing.expires = math.max(existing.expires, expires)
		existing.power = math.max(existing.power, power or 1)
	else
		-- molhado apaga queimadura; fogo descongela
		if kind == "wet" and e.effects.burn then
			Status.clear(h, "burn")
		elseif kind == "burn" and e.effects.freeze then
			Status.clear(h, "freeze")
		end
		e.effects[kind] = { kind = kind, expires = expires, power = power or 1, visual = makeVisual(kind, h) }
	end
	if kind == "shield" then
		local model = h.Parent
		if model and not model:FindFirstChildWhichIsA("ForceField") then
			local ff = Instance.new("ForceField")
			ff.Visible = false
			ff.Name = "EscudoIdeias"
			ff.Parent = model
		end
	end
	recompute(e)
end

function Status.applyElement(h: Humanoid?, element: string?, scale: number?)
	if not element then
		return
	end
	local s = ELEMENT_STATUS[element]
	if s then
		Status.apply(h, s[1], s[2] * math.clamp(scale or 1, 0.5, 2))
	end
end

function Status.clear(h: Humanoid, kind: string)
	local e = entries[h]
	if not e then
		return
	end
	local eff = e.effects[kind]
	if eff then
		if eff.visual then
			eff.visual:Destroy()
		end
		e.effects[kind] = nil
		if kind == "shield" and h.Parent then
			local ff = h.Parent:FindFirstChild("EscudoIdeias")
			if ff then
				ff:Destroy()
			end
		end
	end
	recompute(e)
end

function Status.clearAll(h: Humanoid)
	local e = entries[h]
	if e then
		for kind in e.effects do
			Status.clear(h, kind)
		end
		entries[h] = nil
	end
end

function Status.has(h: Humanoid, kind: string): boolean
	local e = entries[h]
	return e ~= nil and e.effects[kind] ~= nil
end

local function tick(dt: number)
	local t = os.clock()
	for h, e in entries do
		if not h.Parent or h.Health <= 0 then
			for _, eff in e.effects do
				if eff.visual then
					eff.visual:Destroy()
				end
			end
			entries[h] = nil
		else
			local changed = false
			for kind, eff in e.effects do
				local dps = DOT[kind]
				if dps then
					h:TakeDamage(dps * eff.power * dt)
				end
				if t >= eff.expires then
					if eff.visual then
						eff.visual:Destroy()
					end
					e.effects[kind] = nil
					if kind == "shield" and h.Parent then
						local ff = h.Parent:FindFirstChild("EscudoIdeias")
						if ff then
							ff:Destroy()
						end
					end
					changed = true
				end
			end
			if changed then
				recompute(e)
			end
		end
	end
end

local started = false
function Status.start()
	if started then
		return
	end
	started = true
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.5)
			local t = os.clock()
			tick(t - last)
			last = t
		end
	end)
	-- personagens novos sempre começam limpos e com valores base corretos
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			local h = char:WaitForChild("Humanoid", 10) :: Humanoid?
			if h then
				h:SetAttribute("BaseWalkSpeed", game:GetService("StarterPlayer").CharacterWalkSpeed)
			end
		end)
	end)
end

Status.ElementStatus = ELEMENT_STATUS
Status._config = Config

return Status
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="72">
        <Properties>
          <string name="Name">Handlers</string>
        </Properties>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">Blessing</string>
            <string name="Source"><![CDATA[--!strict
-- Luz Celestial ("deus", "luz divina"...): acontecimento sagrado e respeitoso.
-- Coluna de luz suave, pombas, cura total de quem está perto e paz: monstros
-- próximos param de atacar por alguns segundos. Sem corpo, sem combate.

local Actors = require(script.Parent.Parent.Core.Actors)
local Combat = require(script.Parent.Parent.Core.Combat)
local Fx = require(script.Parent.Parent.Core.Fx)

local H = { name = "blessing" }

function H.estimate(_spec: any): { [string]: number }
	return { events = 1, effects = 3 }
end

function H.spawn(ctx: any): any
	local params = ctx.params
	local pos = ctx.origin.Position
	local radius = params.radius or 70
	local calm = params.calm or 20
	Fx.near(pos, 600, "holy", { p = pos, r = radius, d = math.min(ctx.lifetime or 14, 14) })
	local healed, calmed = 0, 0
	for _, a in Actors.near(pos, radius * 1.5) do
		if a.faction == "player" or a.faction == "ally" or a.faction == "pet" then
			if a.humanoid and a.humanoid.Health < a.humanoid.MaxHealth then
				Combat.heal(a, a.humanoid.MaxHealth)
				healed += 1
			end
		elseif a.kind == "npc" and a.faction == "hostile" then
			a.calmUntil = os.clock() + calm
			calmed += 1
			Fx.near(a.root.Position, 300, "calm", { p = a.root.Position })
		end
	end
	if ctx.owner then
		local msg = "✨ Paz e luz para todos!"
		if calmed > 0 then
			msg ..= string.format(" %d monstro(s) se acalmaram.", calmed)
		end
		Fx.to(ctx.owner, "toast", { t = msg, c = Color3.fromRGB(255, 240, 190) })
	end
	local endsAt = os.clock() + math.min(ctx.lifetime or 14, 14)
	return {
		position = pos,
		radius = radius,
		healed = healed,
		calmed = calmed,
		done = function()
			return os.clock() >= endsAt
		end,
	}
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">Building</string>
            <string name="Source"><![CDATA[--!strict
-- Executor de construções. Algumas têm interação: portal teleporta, jaula
-- prende inimigos próximos, labirinto tem prêmio, estátua copia o jogador.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Builders = require(script.Parent.Parent.Builders)
local Fx = require(script.Parent.Parent.Core.Fx)
local Actors = require(script.Parent.Parent.Core.Actors)
local PropActions = require(script.Parent.Parent.Core.PropActions)
local Brain = require(script.Parent.Parent.Brains.Brain)
local MapLayout = require(ReplicatedStorage.IdeiasShared.MapLayout)
local Placement = require(script.Parent.Parent.Core.Placement)

local H = { name = "building" }

function H.estimate(spec: any): { [string]: number }
	local v = spec.params.variant
	local parts = if v == "city" or v == "maze" or v == "castle" then 600 else 260
	return { events = 1, parts = parts * spec.count, effects = 2 }
end

-- estátua do próprio jogador (cópia do avatar em mármore/ouro)
local function playerStatue(player: Player, origin: CFrame, folder: Instance, params: { [string]: any }): Model?
	local char = player.Character
	if not char then
		return nil
	end
	local old = char.Archivable
	char.Archivable = true
	local ok, copy = pcall(function()
		return char:Clone()
	end)
	char.Archivable = old
	if not ok or not copy then
		return nil
	end
	local statue = copy :: Model
	statue.Name = "Estátua de " .. player.DisplayName
	local mat = if params.material == "gold" then Enum.Material.Foil else Enum.Material.Marble
	local col = if params.material == "gold" then Color3.fromRGB(255, 200, 50) else Color3.fromRGB(235, 235, 230)
	for _, d in statue:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.Material = mat
			d.Color = col
			d.CanCollide = true
		elseif d:IsA("Decal") then
			d.Transparency = 0.6
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			d.PlatformStand = true
		end
	end
	local s = math.clamp(params.scale or 1, 1, 4) * 2.5
	pcall(function()
		statue:ScaleTo(s)
	end)
	local _, size = statue:GetBoundingBox()
	statue:PivotTo(origin * CFrame.new(0, 4 + size.Y / 2, 0))
	statue.Parent = folder
	return statue
end

function H.spawn(ctx: any): any
	local params = table.clone(ctx.params)
	params.rng = ctx.rng
	local results = {}
	for i = 1, ctx.count do
		local origin = ctx.origin
		if i > 1 then
			origin = ctx.origin * CFrame.new((i - 1) * 60 * (params.scale or 1), 0, 0)
		end
		local r = Builders.building(origin, params)
		r.model.Name = ctx.def.label
		r.model.Parent = ctx.folder
		table.insert(results, r)
		if params.elementMod and r.model.PrimaryPart then
			PropActions.elementize(r.model.PrimaryPart, params)
		end
	end
	local main = results[1]
	local variant = params.variant

	if variant == "statue" and ctx.owner then
		local st = playerStatue(ctx.owner, ctx.origin, ctx.folder, params)
		if st then
			-- a estátua genérica vira só o pedestal
			for _, d in main.model:GetDescendants() do
				if d:IsA("BasePart") and d.Position.Y > ctx.origin.Position.Y + 4 then
					d:Destroy()
				end
			end
		end
	elseif variant == "portal" then
		local disc = main.model:FindFirstChild("Vortice", true) :: BasePart?
		if disc then
			local p = Instance.new("ProximityPrompt")
			p.ActionText = "Atravessar"
			p.ObjectText = "Portal"
			p.MaxActivationDistance = 18
			p.RequiresLineOfSight = false
			p.Parent = disc
			p.Triggered:Connect(function(player)
				local char = player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					local regions = MapLayout.Regions
					local target = regions[math.random(1, #regions)]
					local cf = Placement.region(target.id, ctx.rng)
					root.CFrame = cf + Vector3.new(0, 5, 0)
					Fx.to(player, "toast", { t = "Portal → " .. target.label, c = Color3.fromRGB(190, 120, 255) })
				end
			end)
		end
	elseif variant == "cage" then
		-- prende até 3 inimigos próximos dentro da jaula
		local caught = 0
		for _, a in Actors.near(main.center, 70) do
			if a.kind == "npc" and a.faction == "hostile" and caught < 3 then
				caught += 1
				a.root.CFrame = CFrame.new(main.center + Vector3.new(caught * 3 - 6, 4, 0))
				a.riding = true
				a.humanoid.WalkSpeed = 0
				task.delay(ctx.lifetime - 1, function()
					a.riding = false
				end)
			end
		end
		if caught > 0 then
			Fx.near(main.center, 300, "toast", { t = caught .. " inimigo(s) preso(s)!", c = Color3.fromRGB(255, 220, 120) })
		end
	elseif variant == "maze" then
		local prize = main.model:FindFirstChild("Premio", true) :: BasePart?
		if prize then
			local p = Instance.new("ProximityPrompt")
			p.ActionText = "Pegar prêmio"
			p.ObjectText = "Centro do labirinto"
			p.RequiresLineOfSight = false
			p.Parent = prize
			p.Triggered:Connect(function(player)
				p.Enabled = false
				prize.Transparency = 1
				Fx.near(prize.Position, 300, "confetti", { p = prize.Position, gold = true })
				if PropActions.rewardHook then
					PropActions.rewardHook(player, "maze", 25)
				end
			end)
		end
	end

	Fx.near(ctx.origin.Position, 400, "build", { p = ctx.origin.Position, r = main.radius })
	Fx.shake(ctx.origin.Position, 0.25, 120)
	local _brain = Brain
	return {
		model = main.model,
		anchor = main.model.PrimaryPart,
		position = main.center,
		radius = main.radius,
		elements = { params.element },
		tags = ctx.def.tagSet,
	}
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Disaster</string>
            <string name="Source"><![CDATA[--!strict
-- Despachante de desastres: escolhe a implementação pelo params.kind.

local Impact = require(script.Parent.Disasters.Impact)
local Storms = require(script.Parent.Disasters.Storms)
local Ground = require(script.Parent.Disasters.Ground)
local Cosmic = require(script.Parent.Disasters.Cosmic)

local H = { name = "disaster" }

local KINDS: { [string]: (any) -> any } = {
	meteor = Impact.meteor,
	rockfall = Impact.rockfall,
	laser_storm = Impact.laser_storm,
	explosion = Impact.explosion,
	tornado = Storms.tornado,
	tsunami = Storms.tsunami,
	lightning = Storms.lightning,
	blizzard = Storms.blizzard,
	acid_rain = Storms.acid_rain,
	sandstorm = Storms.sandstorm,
	wind = Storms.wind,
	gravity = Storms.gravity,
	earthquake = Ground.earthquake,
	volcano = Ground.volcano,
	fire = Ground.fire,
	ice = Ground.ice,
	lava = Ground.lava,
	black_hole = Cosmic.black_hole,
	chaos = Cosmic.chaos,
}

H.Kinds = KINDS

function H.estimate(spec: any): { [string]: number }
	local k = spec.params.kind
	if k == "meteor" then
		return { events = 1, dynamic = 4, effects = 6, parts = 12 * math.min((spec.params.count or 1) * spec.count, 14) }
	elseif k == "volcano" then
		return { events = 1, effects = 6, parts = 20 }
	elseif k == "fire" then
		return { events = 1, effects = 14, parts = 20 }
	elseif k == "ice" then
		return { events = 1, effects = 2, parts = 30 }
	elseif k == "chaos" then
		return { events = 1 }
	end
	return { events = 1, effects = 6, parts = 10 }
end

function H.spawn(ctx: any): any
	local f = KINDS[ctx.params.kind]
	if not f then
		error("desastre desconhecido: " .. tostring(ctx.params.kind))
	end
	return f(ctx)
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="76">
          <Properties>
            <string name="Name">Disasters</string>
          </Properties>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Cosmic</string>
              <string name="Source"><![CDATA[--!strict
-- Buraco negro e "fim do mundo" (vários desastres de uma vez).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local FxPaths = require(ReplicatedStorage.IdeiasShared.FxPaths)
local Combat = require(script.Parent.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Parent.Core.Actors)
local Fx = require(script.Parent.Parent.Parent.Core.Fx)
local Destruction = require(script.Parent.Parent.Parent.Core.Destruction)
local Placement = require(script.Parent.Parent.Parent.Core.Placement)

local Cosmic = {}

function Cosmic.black_hole(ctx: any): any
	local p = ctx.params
	local scale = math.min(p.scale or 1, 4)
	local center = ctx.origin.Position + Vector3.new(0, 22 * scale, 0)
	local dur = 18
	local spec = { pos = center, vel = Vector3.zero, t0 = Workspace:GetServerTimeNow(), dur = dur, radius = 8 * scale, height = 0, seed = 0, power = scale }
	FxPaths.write(ctx.folder, "black_hole", spec, p.element)
	if p.payload then
		ctx.folder:SetAttribute("FxPayload", p.payload)
	end
	local reach = 95 * scale
	local running = true
	task.spawn(function()
		local t0 = os.clock()
		while running and ctx.folder.Parent and os.clock() - t0 < dur do
			local grow = math.min(1, (os.clock() - t0) / 4)
			for _, a in Actors.near(center, reach) do
				local to = center - a.root.Position
				local d = to.Magnitude
				if d < spec.radius * 0.8 then
					if a.kind == "npc" then
						a.humanoid.Health = 0
					else
						-- jogadores são "cuspidos" longe em vez de morrer em loop
						Combat.damage(a, 25, nil, nil)
						local out = Placement.ground(center + Vector3.new(math.random(-150, 150), 0, math.random(-150, 150)))
						a.root.CFrame = CFrame.new(out + Vector3.new(0, 6, 0))
						Fx.to(a.player, "toast", { t = "O buraco negro te cuspiu longe!", c = Color3.fromRGB(190, 150, 255) })
					end
				elseif d > 0.1 then
					local pull = (1 - d / reach) * 70 * grow * math.sqrt(scale)
					Combat.push(a, to.Unit * pull + Vector3.new(0, 4, 0))
				end
			end
			Destruction.blast(center, reach * 0.6, 60 * grow, true)
			task.wait(0.2)
		end
		if ctx.folder.Parent then
			Fx.flash(center, Color3.fromRGB(200, 160, 255), 60 * scale)
			Fx.shockwave(center, reach * 0.5, Color3.fromRGB(170, 120, 255))
			for _, a in Actors.near(center, reach * 0.6) do
				local away = a.root.Position - center
				Combat.push(a, (if away.Magnitude > 0.1 then away.Unit else Vector3.yAxis) * 90 + Vector3.new(0, 30, 0))
			end
		end
	end)
	return {
		position = center,
		radius = spec.radius,
		elements = { "shadow" },
		stop = function()
			running = false
		end,
		absorbs = true,
	}
end

local CHAOS_POOL = { "chuva de meteoros", "tornado de fogo", "raio", "terremoto", "tsunami", "chuva acida", "tempestade de lasers", "erupcao" }

function Cosmic.chaos(ctx: any): any
	local Planner = require(ReplicatedStorage.IdeiasShared.Planner)
	Fx.near(nil, nil, "toast", { t = "☄️ O FIM DO MUNDO COMEÇOU!", c = Color3.fromRGB(255, 90, 90) })
	Fx.near(nil, nil, "tint", { c = Color3.fromRGB(255, 120, 100), d = 3 })
	local picks = {}
	local pool = table.clone(CHAOS_POOL)
	ctx.rng:shuffle(pool)
	for i = 1, 3 do
		table.insert(picks, pool[i])
	end
	task.spawn(function()
		for _, word in picks do
			if not ctx.folder.Parent then
				break
			end
			local plan = Planner.plan(word)
			plan.location = nil
			ctx.manager.executePlan(plan, ctx.owner)
			task.wait(3)
		end
	end)
	return { position = ctx.origin.Position, radius = 0, elements = {}, done = function()
		return true
	end }
end

return Cosmic
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Ground</string>
              <string name="Source"><![CDATA[--!strict
-- Terremoto, vulcão, incêndio, congelamento e lago de lava.

local Workspace = game:GetService("Workspace")
local Combat = require(script.Parent.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Parent.Core.Actors)
local Status = require(script.Parent.Parent.Parent.Core.Status)
local Fx = require(script.Parent.Parent.Parent.Core.Fx)
local Destruction = require(script.Parent.Parent.Parent.Core.Destruction)
local Placement = require(script.Parent.Parent.Parent.Core.Placement)
local Kit = require(script.Parent.Parent.Parent.Builders.Kit)

local Ground = {}

local function loop(ctx: any, duration: number, interval: number, fn: (number) -> ()): () -> ()
	local running = true
	local t0 = os.clock()
	task.spawn(function()
		while running and ctx.folder.Parent and os.clock() - t0 < duration do
			local ok, err = pcall(fn, os.clock() - t0)
			if not ok then
				warn("[Ideias] desastre: " .. tostring(err))
			end
			task.wait(interval)
		end
	end)
	return function()
		running = false
	end
end

-- zona perigosa: queima/congela quem está dentro (checagem barata por distância)
local function hazard(ctx: any, pos: Vector3, radius: number, element: string, dps: number, duration: number): () -> ()
	return loop(ctx, duration, 0.5, function()
		for _, a in Actors.near(pos, radius) do
			if math.abs(a.root.Position.Y - pos.Y) < 8 then
				Combat.damage(a, dps * 0.5, nil, element)
			end
		end
	end)
end

function Ground.earthquake(ctx: any): any
	local center = ctx.origin.Position
	local scale = ctx.params.scale or 1
	Fx.near(center, 800, "toast", { t = "⚠️ Terremoto!", c = Color3.fromRGB(255, 200, 120) })
	-- rachaduras no chão
	local b = Kit.new("Rachaduras", CFrame.new(center), { anchored = true, collide = false })
	for k = 0, 9 do
		local a = ctx.rng:range(0, math.pi * 2)
		local r = ctx.rng:range(5, 40)
		b:box(Vector3.new(ctx.rng:range(0.8, 2), 0.3, ctx.rng:range(10, 24)), CFrame.new(math.cos(a) * r, 0.15, math.sin(a) * r) * CFrame.Angles(0, a, 0), Color3.fromRGB(30, 22, 18), { role = "fixed" })
	end
	b:finish().Parent = ctx.folder
	local stop = loop(ctx, 14, 0.4, function()
		Fx.shake(center, 1.1 * math.min(scale, 3), 350)
		local p = center + Vector3.new(ctx.rng:range(-80, 80), 0, ctx.rng:range(-80, 80))
		Destruction.blast(p, 25, 40)
		for _, a in Actors.near(center, 120) do
			if ctx.rng:chance(0.15) then
				Combat.push(a, Vector3.new(ctx.rng:range(-10, 10), 18, ctx.rng:range(-10, 10)))
			end
		end
	end)
	return { position = center, radius = 120, elements = {}, stop = stop }
end

function Ground.volcano(ctx: any): any
	local center = ctx.origin.Position
	local scale = ctx.params.scale or 1
	local b = Kit.new("Vulcao", ctx.origin, { anchored = true, collide = true, scale = scale })
	b:cone(26, 40, CFrame.new(0, 0, 0), Color3.fromRGB(70, 55, 50), 6, { role = "fixed", material = Enum.Material.Basalt })
	local lava = b:part("cyl", Vector3.new(1, 12, 12), CFrame.new(0, 24, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(255, 90, 20), { role = "fixed", material = Enum.Material.Neon, name = "Cratera" })
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2 + 0.4
		b:part("wedge", Vector3.new(2.5, 1, 18), CFrame.new(math.cos(a) * 12, 12, math.sin(a) * 12) * CFrame.Angles(0, -a - math.pi / 2, 0) * CFrame.Angles(math.rad(-50), 0, 0), Color3.fromRGB(255, 110, 30), { role = "fixed", material = Enum.Material.Neon, collide = false })
	end
	local m = b:finish(lava)
	m.Parent = ctx.folder
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(60, 55, 55)
	smoke.Size = 20
	smoke.RiseVelocity = 20
	smoke.Opacity = 0.4
	smoke.Parent = lava
	b:light(lava, Color3.fromRGB(255, 120, 40), 60, 3)
	local top = lava.Position
	Fx.shake(center, 1, 300)
	local stop = loop(ctx, 26, 0.5, function()
		-- bombas de lava
		local target = Placement.ground(center + Vector3.new(ctx.rng:range(-70, 70), 0, ctx.rng:range(-70, 70)))
		Fx.bolt(top, target, Color3.fromRGB(255, 100, 30), 70, 3)
		local d = (target - top).Magnitude
		task.delay(d / 70, function()
			if ctx.folder.Parent then
				Fx.near(target, 400, "boom", { p = target, s = 0.5 })
				Combat.area(target, 9, 22, nil, "lava", 40)
				Destruction.blast(target, 10, 50)
			end
		end)
		for _, a in Actors.near(center, 22 * scale) do
			Combat.damage(a, 4, nil, "lava")
		end
	end)
	return { position = center, radius = 20 * scale, elements = { "lava", "fire" }, model = m, stop = stop }
end

function Ground.fire(ctx: any): any
	local center = ctx.origin.Position
	local patches: { BasePart } = {}
	local scale = ctx.params.scale or 1
	local stops = {}
	local running = true
	task.spawn(function()
		for i = 1, math.floor(10 * math.min(scale, 2)) do
			if not running or not ctx.folder.Parent then
				break
			end
			local ang = i * 2.4
			local r = 4 + i * 2.2
			local pos = Placement.ground(center + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r))
			local patch = Instance.new("Part")
			patch.Anchored = true
			patch.CanCollide = false
			patch.CanQuery = false
			patch.Size = Vector3.new(7, 0.4, 7)
			patch.CFrame = CFrame.new(pos + Vector3.new(0, 0.2, 0))
			patch.Material = Enum.Material.CrackedLava
			patch.Color = Color3.fromRGB(80, 30, 15)
			patch.Name = "Fogo"
			local f = Instance.new("Fire")
			f.Size = 9
			f.Heat = 14
			f.Parent = patch
			patch.Parent = ctx.folder
			table.insert(patches, patch)
			table.insert(stops, hazard(ctx, pos, 6, "fire", 10, 22))
			Destruction.blast(pos, 8, 15)
			task.wait(0.6)
		end
	end)
	return {
		position = center,
		radius = 25,
		elements = { "fire" },
		patches = patches,
		stop = function()
			running = false
			for _, s in stops do
				s()
			end
		end,
		extinguish = function()
			for _, p in patches do
				p:Destroy()
			end
			running = false
			for _, s in stops do
				s()
			end
		end,
	}
end

function Ground.ice(ctx: any): any
	local center = ctx.origin.Position
	local scale = ctx.params.scale or 1
	local radius = 30 * math.min(scale, 3)
	local b = Kit.new("Gelo", CFrame.new(center), { anchored = true, collide = true })
	for i = 1, 22 do
		local ang = ctx.rng:range(0, math.pi * 2)
		local r = ctx.rng:range(3, radius)
		local h = ctx.rng:range(4, 12) * math.min(scale, 2)
		local tilt = ctx.rng:range(-0.4, 0.4)
		b:part("wedge", Vector3.new(2.2, h, 2.2), CFrame.new(math.cos(ang) * r, h / 2 - 0.5, math.sin(ang) * r) * CFrame.Angles(tilt, ang, tilt), Color3.fromRGB(170, 225, 255), { role = "fixed", material = Enum.Material.Ice, transparency = 0.15 })
		if i % 4 == 0 then
			b:part("wedge", Vector3.new(2.2, h, 2.2), CFrame.new(math.cos(ang) * r, h / 2 - 0.5, math.sin(ang) * r) * CFrame.Angles(tilt, ang + math.pi, tilt), Color3.fromRGB(200, 240, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.3 })
		end
	end
	local floor = b:part("cyl", Vector3.new(0.3, radius * 2, radius * 2), CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(200, 235, 255), { role = "fixed", material = Enum.Material.Glacier })
	local m = b:finish(floor)
	m.Parent = ctx.folder
	Fx.shockwave(center, radius, Color3.fromRGB(170, 230, 255))
	for _, a in Actors.near(center, radius) do
		Combat.damage(a, 12, nil, "ice")
		Status.apply(a.humanoid, "freeze", 3.5)
	end
	return { position = center, radius = radius, elements = { "ice" }, model = m }
end

function Ground.lava(ctx: any): any
	local center = ctx.origin.Position
	local scale = ctx.params.scale or 1
	local pool = Instance.new("Part")
	pool.Anchored = true
	pool.CanCollide = false
	pool.Shape = Enum.PartType.Cylinder
	pool.Material = Enum.Material.Neon
	pool.Color = Color3.fromRGB(255, 90, 20)
	pool.Size = Vector3.new(0.6, 6, 6)
	pool.CFrame = CFrame.new(center + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pool.Name = "Lava"
	pool.Parent = ctx.folder
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = 40
	light.Parent = pool
	local maxD = 50 * math.min(scale, 2.5)
	local stop = loop(ctx, 20, 0.25, function(t)
		local d = math.min(6 + t * 6, maxD)
		pool.Size = Vector3.new(0.6, d, d)
		for _, a in Actors.near(center, d / 2) do
			if math.abs(a.root.Position.Y - center.Y) < 7 then
				Combat.damage(a, 3, nil, "lava")
			end
		end
	end)
	return {
		position = center,
		radius = maxD / 2,
		elements = { "lava", "fire" },
		stop = function()
			stop()
			pool.Material = Enum.Material.Basalt
			pool.Color = Color3.fromRGB(30, 28, 32)
		end,
	}
end

Ground._ws = Workspace

return Ground
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Impact</string>
              <string name="Source"><![CDATA[--!strict
-- Desastres de impacto: meteoros, chuva de pedras, lasers orbitais, explosões.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local FxPaths = require(ReplicatedStorage.IdeiasShared.FxPaths)
local Combat = require(script.Parent.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Parent.Core.Actors)
local Fx = require(script.Parent.Parent.Parent.Core.Fx)
local Destruction = require(script.Parent.Parent.Parent.Core.Destruction)
local Placement = require(script.Parent.Parent.Parent.Core.Placement)
local PropActions = require(script.Parent.Parent.Parent.Core.PropActions)
local Kit = require(script.Parent.Parent.Parent.Builders.Kit)
local Builders = require(script.Parent.Parent.Parent.Builders)

local Impact = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- cada meteoro é uma sub-pasta com atributos de trajetória (o cliente desenha)
local function meteorFolder(parent: Instance, from: Vector3, to: Vector3, t0: number, dur: number, radius: number, element: string?, seed: number): Folder
	local f = Instance.new("Folder")
	f.Name = "Meteoro"
	FxPaths.write(f, "meteor", { pos = from, vel = to - from, t0 = t0, dur = dur, radius = radius, height = 0, seed = seed, power = 1 }, element)
	f.Parent = parent
	return f
end

local function crater(ctx: any, pos: Vector3, radius: number, element: string?)
	local b = Kit.new("Cratera", CFrame.new(pos), { anchored = true, collide = true })
	local rock = Color3.fromRGB(70, 60, 55)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b:part("wedge", Vector3.new(radius * 0.5, radius * 0.3, radius * 0.5), CFrame.new(math.cos(a) * radius * 0.8, radius * 0.1, math.sin(a) * radius * 0.8) * CFrame.Angles(0, -a + math.pi / 2, 0), rock, { role = "fixed", material = Enum.Material.Basalt })
	end
	local core = b:part("cyl", Vector3.new(0.4, radius * 1.2, radius * 1.2), CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), if element == "ice" then Color3.fromRGB(150, 220, 255) else Color3.fromRGB(255, 90, 20), { role = "fixed", material = if element == "ice" then Enum.Material.Ice else Enum.Material.CrackedLava })
	local m = b:finish(core)
	m.Parent = ctx.folder
	if element ~= "ice" then
		local fire = Instance.new("Fire")
		fire.Size = radius * 0.6
		fire.Parent = core
	end
	task.delay(10, function()
		if m.Parent then
			m:Destroy()
		end
	end)
end

function Impact.meteor(ctx: any): any
	local p = ctx.params
	local n = math.clamp((p.count or 1) * (if ctx.count > 1 then ctx.count else 1), 1, 14)
	local scale = p.scale or 1
	local element = p.element or "fire"
	local center = ctx.origin.Position
	local t0 = now() + 0.5
	local radius = 10 * scale
	local payloadDef = p.payload and require(ReplicatedStorage.IdeiasShared.Catalog).ById[p.payload]
	-- molde do "recheio" para o cliente usar no lugar da rocha
	if payloadDef then
		local pp = table.clone(payloadDef.params)
		pp.scale = 0.8 * scale
		pp.rng = ctx.rng
		local ok, model = pcall(Builders.any, payloadDef, CFrame.new(0, -1000, 0), pp)
		if ok and model then
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
				end
			end
			model.Name = "Molde"
			model.Parent = ctx.folder
		end
	end
	for i = 1, n do
		local spread = if n == 1 then 0 else 55
		local target = center + Vector3.new(ctx.rng:range(-spread, spread), 0, ctx.rng:range(-spread, spread))
		-- meteoros miram perto dos jogadores próximos às vezes
		local players = Actors.players()
		if #players > 0 and ctx.rng:chance(0.35) then
			local a = players[ctx.rng:int(1, #players)]
			if (a.root.Position - center).Magnitude < 160 then
				target = a.root.Position + Vector3.new(ctx.rng:range(-12, 12), 0, ctx.rng:range(-12, 12))
			end
		end
		target = Placement.ground(target)
		local from = target + Vector3.new(ctx.rng:range(-120, 120), 260, ctx.rng:range(-120, 120))
		local start = t0 + (i - 1) * ctx.rng:range(0.6, 1.2)
		local dur = 2.4
		meteorFolder(ctx.folder, from, target, start, dur, radius, element, i)
		Fx.near(target, 500, "warn", { p = target, r = radius, d = start - now() + dur })
		task.delay(start - now() + dur, function()
			if not ctx.folder.Parent then
				return
			end
			Fx.flash(target, (Kit.Elements[element] or Kit.Elements.fire).color, radius * 2)
			Fx.shockwave(target, radius * 2.2, Color3.fromRGB(255, 160, 80))
			Fx.shake(target, 1.4 * math.min(scale, 3), 260)
			Fx.near(target, 600, "boom", { p = target, s = scale })
			Combat.area(target, radius * 1.6, 45 * scale, nil, element, 80 * math.min(scale, 3))
			Destruction.blast(target, radius * 2, 100 * math.min(scale, 3))
			crater(ctx, target, radius, element)
			if payloadDef and payloadDef.handler == "prop" and ctx.rng:chance(0.6) then
				local pp = table.clone(payloadDef.params)
				pp.scale = 0.7
				pp.rng = ctx.rng
				pp.physics = true
				local ok, r = pcall(Builders.Props.build, CFrame.new(target + Vector3.new(0, 4, 0)), pp, pp.model or "prop", pp.variant)
				if ok and r then
					r.model.Parent = ctx.folder
				end
			end
		end)
	end
	local last = t0 + n * 1.2 + 3
	return {
		position = center,
		radius = 50,
		elements = { element },
		done = function()
			return now() > last + 4
		end,
	}
end

function Impact.rockfall(ctx: any): any
	local p = ctx.params
	local element = p.element
	local center = ctx.origin.Position
	local running = true
	local t0 = os.clock()
	task.spawn(function()
		while running and ctx.folder.Parent and os.clock() - t0 < 14 do
			local players = Actors.players()
			local base = center
			if #players > 0 and ctx.rng:chance(0.5) then
				local a = players[ctx.rng:int(1, #players)]
				if (a.root.Position - center).Magnitude < 150 then
					base = a.root.Position
				end
			end
			local target = Placement.ground(base + Vector3.new(ctx.rng:range(-35, 35), 0, ctx.rng:range(-35, 35)))
			local size = ctx.rng:range(3, 6) * (p.scale or 1)
			local from = target + Vector3.new(0, 120, 0)
			meteorFolder(ctx.folder, from, target, now() + 0.2, 1.8, size, element or "stone", ctx.rng:int(1, 999))
			Fx.near(target, 400, "warn", { p = target, r = size, d = 2 })
			task.delay(2, function()
				if ctx.folder.Parent then
					Fx.near(target, 400, "dust", { p = target, s = size })
					Combat.area(target, size * 1.3, 18, nil, element, 30)
					Destruction.blast(target, size * 1.5, 50)
				end
			end)
			task.wait(0.45)
		end
	end)
	return {
		position = center,
		radius = 40,
		elements = { element },
		stop = function()
			running = false
		end,
	}
end

function Impact.laser_storm(ctx: any): any
	local center = ctx.origin.Position
	local running = true
	local t0 = os.clock()
	local color = Color3.fromRGB(255, 60, 90)
	task.spawn(function()
		while running and ctx.folder.Parent and os.clock() - t0 < 14 do
			local players = Actors.players()
			local target = center + Vector3.new(ctx.rng:range(-60, 60), 0, ctx.rng:range(-60, 60))
			if #players > 0 and ctx.rng:chance(0.45) then
				local a = players[ctx.rng:int(1, #players)]
				if (a.root.Position - center).Magnitude < 150 then
					target = a.root.Position
				end
			end
			target = Placement.ground(target)
			Fx.near(target, 400, "warn", { p = target, r = 7, d = 1.2 })
			task.delay(1.2, function()
				if ctx.folder.Parent then
					Fx.near(target, 600, "laser", { p = target, c = color })
					Combat.area(target, 8, 30, nil, "electric", 40)
					Destruction.blast(target, 10, 60)
				end
			end)
			task.wait(0.5)
		end
	end)
	return {
		position = center,
		radius = 60,
		elements = { "electric" },
		stop = function()
			running = false
		end,
	}
end

function Impact.explosion(ctx: any): any
	local p = ctx.params
	local power = (p.power or 1) * (p.scale or 1)
	local pos = ctx.origin.Position + Vector3.new(0, 2, 0)
	local element = p.element or "fire"
	ctx.folder:SetAttribute("FxKind", "explosion")
	ctx.folder:SetAttribute("FxPos", pos)
	ctx.folder:SetAttribute("FxPower", power)
	ctx.folder:SetAttribute("FxT0", now() + 1)
	ctx.folder:SetAttribute("FxElement", element)
	if p.payload then
		ctx.folder:SetAttribute("FxPayload", p.payload)
	end
	Fx.near(pos, 400, "warn", { p = pos, r = 12 * power, d = 1 })
	task.delay(1, function()
		if ctx.folder.Parent then
			PropActions.explode(pos, power, nil)
			if power >= 3 then
				Fx.near(pos, 2000, "nuke", { p = pos, s = power })
			end
		end
	end)
	return {
		position = pos,
		radius = 20 * power,
		elements = { element },
		done = function()
			return false
		end,
	}
end

return Impact
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Storms</string>
              <string name="Source"><![CDATA[--!strict
-- Tornados, tempestades elétricas, nevasca, chuva ácida, areia, vento,
-- gravidade e tsunami. Movimento por trajetória determinística (FxPaths).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local FxPaths = require(ReplicatedStorage.IdeiasShared.FxPaths)
local Combat = require(script.Parent.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Parent.Core.Actors)
local Status = require(script.Parent.Parent.Parent.Core.Status)
local Fx = require(script.Parent.Parent.Parent.Core.Fx)
local Destruction = require(script.Parent.Parent.Parent.Core.Destruction)
local Ambience = require(script.Parent.Parent.Parent.Core.Ambience)
local Placement = require(script.Parent.Parent.Parent.Core.Placement)
local Builders = require(script.Parent.Parent.Parent.Builders)

local Storms = {}

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function addMold(ctx: any, payloadId: string?, scale: number)
	if not payloadId then
		return
	end
	local def = require(ReplicatedStorage.IdeiasShared.Catalog).ById[payloadId]
	if not def then
		return
	end
	local pp = table.clone(def.params)
	pp.scale = scale
	pp.rng = ctx.rng
	local ok, model = pcall(Builders.any, def, CFrame.new(0, -1000, 0), pp)
	if ok and model then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
			end
		end
		model.Name = "Molde"
		model.Parent = ctx.folder
		ctx.folder:SetAttribute("FxPayload", payloadId)
	end
end

local function loop(ctx: any, duration: number, interval: number, fn: (number) -> ()): () -> ()
	local running = true
	local t0 = os.clock()
	task.spawn(function()
		while running and ctx.folder.Parent and os.clock() - t0 < duration do
			local ok, err = pcall(fn, os.clock() - t0)
			if not ok then
				warn("[Ideias] desastre: " .. tostring(err))
			end
			task.wait(interval)
		end
	end)
	return function()
		running = false
	end
end

function Storms.tornado(ctx: any): any
	local p = ctx.params
	local scale = p.scale or 1
	local element = if p.elementMod then p.element else nil
	local dir = ctx.origin.LookVector
	local start = ctx.origin.Position - dir * 70
	local speed = 14 * (p.speedMul or 1)
	local spec = { pos = start, vel = dir * speed, t0 = now(), dur = 26, radius = 16 * scale, height = 90 * scale, seed = ctx.rng:range(0, 6), power = scale }
	FxPaths.write(ctx.folder, "tornado", spec, element or "wind")
	addMold(ctx, p.payload, 0.6)
	local stop = loop(ctx, 26, 0.15, function()
		local c = FxPaths.tornado(spec, now())
		for _, a in Actors.near(c, spec.radius * 1.6) do
			local rel = a.root.Position - c
			local flat = Vector3.new(rel.X, 0, rel.Z)
			local tangent = if flat.Magnitude > 0.1 then Vector3.new(-flat.Z, 0, flat.X).Unit else Vector3.xAxis
			local inward = if flat.Magnitude > 0.1 then -flat.Unit else Vector3.zero
			local lift = if a.root.Position.Y < c.Y + spec.height * 0.6 then 22 else -5
			Combat.push(a, tangent * 18 * math.min(scale, 3) + inward * 6 + Vector3.new(0, lift, 0))
			Combat.damage(a, 1.5 * scale, nil, element)
		end
		Destruction.blast(c, spec.radius * 1.4, 45 * math.min(scale, 3))
	end)
	return {
		position = start,
		radius = spec.radius,
		elements = { element or "wind" },
		positionAt = function()
			return FxPaths.tornado(spec, now())
		end,
		stop = stop,
	}
end

function Storms.tsunami(ctx: any): any
	local p = ctx.params
	local scale = p.scale or 1
	local dir = ctx.origin.LookVector * -1
	local start = ctx.origin.Position - dir * 150
	local speed = 32 * (p.speedMul or 1)
	local width = 260
	local spec = { pos = start, vel = dir * speed, t0 = now() + 1, dur = 12, radius = width / 2, height = 26 * scale, seed = 0, power = scale }
	FxPaths.write(ctx.folder, "tsunami", spec, p.element or "water")
	addMold(ctx, p.payload, 0.6)
	Fx.near(ctx.origin.Position, 600, "toast", { t = "🌊 Onda gigante chegando!", c = Color3.fromRGB(120, 200, 255) })
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local stop = loop(ctx, 14, 0.15, function()
		local front = FxPaths.wave(spec, now())
		for _, a in Actors.near(front, width * 0.6) do
			local rel = a.root.Position - front
			local along = rel:Dot(dir)
			local side = math.abs(rel:Dot(right))
			if along > -12 and along < 8 and side < width / 2 and a.root.Position.Y < front.Y + spec.height then
				Combat.push(a, dir * speed * 1.3 + Vector3.new(0, 26, 0))
				Combat.damage(a, 3 * scale, nil, "water")
			end
		end
		for k = -3, 3 do
			Destruction.blast(front + right * (k * 35), 20, 70)
		end
	end)
	return { position = ctx.origin.Position, radius = 60, elements = { "water" }, stop = stop }
end

function Storms.lightning(ctx: any): any
	local center = ctx.origin.Position
	local heavy = ctx.spec.heavy or (ctx.params.scale or 1) > 1.5
	local restore = Ambience.push({ Brightness = 0.9, OutdoorAmbient = Color3.fromRGB(70, 75, 95), AtmosphereDensity = 0.45, Clima = "tempestade" }, 18, 2)
	ctx.folder:SetAttribute("FxKind", "storm")
	ctx.folder:SetAttribute("FxPos", center)
	local stop = loop(ctx, 17, if heavy then 0.45 else 0.8, function()
		local players = Actors.players()
		local target = center + Vector3.new(ctx.rng:range(-70, 70), 0, ctx.rng:range(-70, 70))
		if #players > 0 and ctx.rng:chance(0.4) then
			local a = players[ctx.rng:int(1, #players)]
			if (a.root.Position - center).Magnitude < 160 then
				target = a.root.Position
			end
		end
		target = Placement.ground(target)
		Fx.near(target, 500, "warn", { p = target, r = 7, d = 0.8 })
		task.delay(0.8, function()
			if ctx.folder.Parent then
				Fx.near(target, 900, "lightning", { p = target })
				Combat.area(target, 9, 28, nil, "electric", 35)
				Destruction.blast(target, 10, 50)
			end
		end)
	end)
	return {
		position = center,
		radius = 70,
		elements = { "electric" },
		stop = function()
			stop()
			restore()
		end,
	}
end

local function weather(ctx: any, clima: string, props: { [string]: any }, duration: number, tick: (number) -> ()): any
	local merged = table.clone(props)
	merged.Clima = clima
	local restore = Ambience.push(merged, duration, 2)
	local stop = loop(ctx, duration, 1, tick)
	return {
		position = ctx.origin.Position,
		radius = 200,
		elements = {},
		stop = function()
			stop()
			restore()
		end,
	}
end

local function sheltered(a: any): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { a.model :: Instance }
	return Workspace:Raycast(a.root.Position + Vector3.new(0, 3, 0), Vector3.new(0, 80, 0), params) ~= nil
end

function Storms.blizzard(ctx: any): any
	local h = weather(ctx, "nevasca", { Brightness = 1.4, AtmosphereDensity = 0.55, AtmosphereColor = Color3.fromRGB(220, 235, 255), AtmosphereHaze = 3 }, 26, function()
		for _, a in Actors.players() do
			if not sheltered(a) then
				Status.apply(a.humanoid, "slow", 1.5)
			end
		end
	end)
	h.elements = { "ice" }
	return h
end

function Storms.acid_rain(ctx: any): any
	local h = weather(ctx, "chuva_acida", { Brightness = 1.2, OutdoorAmbient = Color3.fromRGB(110, 140, 90), AtmosphereColor = Color3.fromRGB(170, 220, 140), AtmosphereDensity = 0.42 }, 20, function()
		for _, a in Actors.near(ctx.origin.Position, 220) do
			if not sheltered(a) then
				Combat.damage(a, 3, nil, nil)
				Status.apply(a.humanoid, "poison", 1.2)
			end
		end
	end)
	h.elements = { "poison" }
	return h
end

function Storms.sandstorm(ctx: any): any
	local dir = ctx.origin.RightVector
	local h = weather(ctx, "areia", { Brightness = 1.6, AtmosphereColor = Color3.fromRGB(230, 190, 120), AtmosphereDecay = Color3.fromRGB(200, 150, 90), AtmosphereDensity = 0.6, AtmosphereHaze = 4 }, 24, function()
		for _, a in Actors.near(ctx.origin.Position, 250) do
			if not sheltered(a) then
				Combat.push(a, dir * 22)
			end
		end
	end)
	h.elements = { "wind" }
	return h
end

function Storms.wind(ctx: any): any
	local dir = ctx.origin.LookVector * -1
	ctx.folder:SetAttribute("FxKind", "wind")
	ctx.folder:SetAttribute("FxVel", dir)
	local stop = loop(ctx, 15, 0.5, function()
		for _, a in Actors.near(ctx.origin.Position, 220) do
			Combat.push(a, dir * 28 + Vector3.new(0, 4, 0))
		end
		Destruction.blast(ctx.origin.Position + dir * 30, 60, 25)
	end)
	return { position = ctx.origin.Position, radius = 200, elements = { "wind" }, stop = stop }
end

function Storms.gravity(ctx: any): any
	local restore = Ambience.push({ Gravity = 38 }, 20, 3)
	Fx.near(nil, nil, "toast", { t = "🪐 Gravidade baixa por 20 segundos!", c = Color3.fromRGB(200, 170, 255) })
	return {
		position = ctx.origin.Position,
		radius = 0,
		elements = {},
		stop = restore,
	}
end

return Storms
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">Npc</string>
            <string name="Source"><![CDATA[--!strict
-- Executor de criaturas e personagens: constrói o rig, aplica atributos de
-- combate escalados pelo tamanho, registra no Brain e cuida da morte/limpeza.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Builders = require(script.Parent.Parent.Builders)
local Kit = Builders.Kit
local Actors = require(script.Parent.Parent.Core.Actors)
local Budget = require(script.Parent.Parent.Core.Budget)
local Fx = require(script.Parent.Parent.Core.Fx)
local PropActions = require(script.Parent.Parent.Core.PropActions)
local Brain = require(script.Parent.Parent.Brains.Brain)
local Config = require(ReplicatedStorage.IdeiasShared.Config)

local H = { name = "npc" }

function H.estimate(spec: any): { [string]: number }
	local s = spec.params.scale or 1
	local per = math.ceil(35 * math.clamp(s, 1, 3))
	return { events = 1, npcs = spec.count, effects = spec.count * 2, parts = per * spec.count }
end

local function healthBar(model: Model, root: BasePart, height: number, label: string, boss: boolean, hostile: boolean)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Barra"
	gui.Size = UDim2.fromOffset(if boss then 160 else 110, 30)
	gui.StudsOffsetWorldSpace = Vector3.new(0, height * 0.55 + 2, 0)
	gui.MaxDistance = if boss then 160 else 80
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0.55, 0)
	name.BackgroundTransparency = 1
	name.Text = label
	name.TextScaled = true
	name.Font = Enum.Font.GothamBold
	name.TextColor3 = if hostile then Color3.fromRGB(255, 120, 110) else Color3.fromRGB(150, 255, 170)
	name.TextStrokeTransparency = 0.4
	name.Parent = gui
	local back = Instance.new("Frame")
	back.Size = UDim2.new(1, 0, 0.3, 0)
	back.Position = UDim2.new(0, 0, 0.65, 0)
	back.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	back.BorderSizePixel = 0
	back.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Vida"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = if hostile then Color3.fromRGB(240, 70, 60) else Color3.fromRGB(80, 220, 120)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local c2 = corner:Clone()
	c2.Parent = fill
	gui.Parent = root
	return fill
end

local function breathEmitter(mouth: Attachment?, element: string?, scale: number): ParticleEmitter?
	if not mouth then
		return nil
	end
	local e = Kit.Elements[element or "fire"] or Kit.Elements.fire
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sopro"
	emitter.Enabled = false
	emitter.Texture = if element == "ice" or element == "electric" or element == "light" then Config.Textures.Sparkle else Config.Textures.Fire
	emitter.Rate = 70
	emitter.Lifetime = NumberRange.new(0.5, 0.8)
	emitter.Speed = NumberRange.new(30 * math.sqrt(scale), 45 * math.sqrt(scale))
	emitter.SpreadAngle = Vector2.new(12, 12)
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1 * scale), NumberSequenceKeypoint.new(1, 5 * scale) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.Color = ColorSequence.new(e.color2, e.color)
	emitter.LightEmission = 0.8
	emitter.Parent = mouth
	return emitter
end

function H.spawn(ctx: any): any
	local def, params = ctx.def, ctx.params
	local npcs = {}
	local scale = params.scale or 1
	local size = (params.size or 1) * scale
	local faction = params.faction or "neutral"
	local hostile = faction == "hostile"
	local boss = params.boss == true
	local flying = params.fly == true or params.flying == true
	local count = ctx.count
	local deadCount = 0
	local released = 0

	local function release(n: number)
		-- devolve vagas de NPC ao orçamento quando morrem
		released += n
		ctx.record.cost.npcs = math.max(0, (ctx.record.cost.npcs or 0) - n)
		Budget.adjust("npcs", -n)
	end

	for i = 1, count do
		local ring = if count == 1 then 0 else 5 + size * 3
		local ang = (i / count) * math.pi * 2
		local offset = Vector3.new(math.cos(ang) * ring, 0, math.sin(ang) * ring)
		local origin = ctx.origin * CFrame.new(offset)
		if flying then
			origin += Vector3.new(0, 8 + 4 * size, 0)
		end
		local p2 = table.clone(params)
		p2.rng = ctx.rng:fork(i)
		local rig = Builders.creature(origin, p2)
		local model: Model = rig.model
		model.Name = if params.customName then params.customName elseif params.isClone then def.label .. " (clone)" else def.label
		model:SetAttribute("Criatura", def.id)
		model:SetAttribute("Faccao", faction)
		model:SetAttribute("Voa", flying)
		model:AddTag("IdeiasNpc")
		local hp = math.floor((params.hp or 100) * (params.hpMul or 1) * math.max(1, size ^ 1.3))
		rig.humanoid.MaxHealth = hp
		rig.humanoid.Health = hp
		local speed = (params.speed or 16) * (params.speedMul or 1) * (if size > 1 then math.sqrt(size) else 1)
		rig.humanoid.WalkSpeed = speed
		model.Parent = ctx.folder
		pcall(function()
			rig.root:SetNetworkOwner(nil)
		end)
		if params.elementMod then
			Kit.elementEffects(rig.root, params.element, math.min(size, 2.5))
		end
		if params.aura then
			local fx = Kit.elementEffects(rig.root, params.element or "electric", 1.6 * math.min(size, 2))
			for _, inst in fx do
				if inst:IsA("ParticleEmitter") then
					inst.Rate = 28
					inst.Speed = NumberRange.new(3, 7)
					inst.Acceleration = Vector3.new(0, 14, 0)
				end
			end
		end
		if params.glow then
			local fx = Kit.elementEffects(rig.root, "light", 1.2)
			for _, inst in fx do
				if inst:IsA("PointLight") then
					inst.Range = 18
					inst.Brightness = 1.6
				end
			end
		end
		local attacks = params.attacks or { "melee" }
		local emitter = nil
		if table.find(attacks, "breath") then
			emitter = breathEmitter(rig.mouth, params.element, size)
		end
		local label = model.Name
		if boss then
			label = "👑 " .. label
		end
		local bar = healthBar(model, rig.root, rig.height, label, boss, hostile)
		if params.invulnerable then
			-- personagens sagrados: só o nome, sem barra de vida
			local back = bar.Parent :: Frame
			back.Visible = false
			local nameLabel = (back.Parent :: Instance):FindFirstChildOfClass("TextLabel")
			if nameLabel then
				nameLabel.TextColor3 = Color3.fromRGB(255, 235, 170)
			end
		end
		local npc: any = {
			kind = "npc",
			eventId = ctx.id,
			model = model,
			root = rig.root,
			humanoid = rig.humanoid,
			faction = faction,
			owner = if faction == "pet" or faction == "ally" then ctx.owner else nil,
			params = params,
			def = def,
			flying = flying,
			speed = speed,
			dmg = (params.dmg or 8) * math.max(1, size ^ 0.8) * (if boss then 1.5 else 1),
			scale = size,
			attacks = attacks,
			element = params.element,
			mouth = rig.mouth,
			breathEmitter = emitter,
			hipHeight = rig.hipHeight,
			height = rig.height,
			radius = rig.radius,
			reach = rig.radius + 3 * math.max(1, size * 0.6),
			behavior = params.behavior,
			hover = if flying then 8 + 5 * size else nil,
			enemies = {},
			invulnerable = params.invulnerable == true,
			calmAura = params.calmAura,
			isClone = params.isClone == true,
			boltColor = params.boltColor,
			ctx = ctx,
		}
		if params.giftKind or table.find(attacks, "gift") then
			npc.spawnGift = function(_npc: any, near: Vector3)
				local kind = params.giftKind or "gift"
				local variant, model2 = "gift", "prop"
				if kind == "food" then
					variant, model2 = ctx.rng:pick({ "pizza", "cake", "burger", "donut", "brigadeiro", "coxinha" }), "food"
				elseif kind == "ball" then
					variant = "ball"
				end
				local pos = near + Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
				local pp = { scale = 0.6, rng = ctx.rng, edible = kind == "food", physics = kind == "ball" }
				local ok, r = pcall(Builders.Props.build, CFrame.new(pos), pp, model2, variant)
				if ok and r then
					r.model.Parent = ctx.folder
					PropActions.attach(r.model, r.main, if kind == "gift" then "gift" else nil, pp, ctx)
					Debris:AddItem(r.model, 30)
				end
			end
		end
		Actors.register(npc)
		Brain.add(npc)
		table.insert(npcs, npc)

		rig.humanoid.HealthChanged:Connect(function(h)
			bar.Size = UDim2.fromScale(math.clamp(h / math.max(rig.humanoid.MaxHealth, 1), 0, 1), 1)
		end)
		rig.humanoid.Died:Connect(function()
			if npc.dead then
				return
			end
			npc.dead = true
			deadCount += 1
			Brain.remove(npc)
			Actors.unregister(npc)
			release(1)
			if npc.align then
				npc.align.Enabled = false
				npc.alignOri.Enabled = false
			end
			if not npc.silentDeath then
				Fx.near(rig.root.Position, 300, "poof", { p = rig.root.Position, s = size })
			end
			for _, d in model:GetDescendants() do
				if d:IsA("Motor6D") then
					d:SetAttribute("Anim", nil)
				elseif d:IsA("BasePart") then
					d.CanCollide = d == rig.root
				end
			end
			task.delay(2.5, function()
				if model.Parent then
					model:Destroy()
				end
			end)
		end)
	end

	Fx.near(ctx.origin.Position, 400, "spawn", { p = ctx.origin.Position, s = size, c = if hostile then Color3.fromRGB(255, 80, 80) else Color3.fromRGB(120, 220, 255) })

	return {
		npcs = npcs,
		position = ctx.origin.Position,
		radius = 6 * size,
		elements = { params.element },
		stop = function()
			for _, npc in npcs do
				Brain.remove(npc)
				Actors.unregister(npc)
			end
		end,
		done = function()
			return deadCount >= count
		end,
	}
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">Power</string>
            <string name="Source"><![CDATA[--!strict
-- Poderes aplicados a quem pediu: cura, velocidade, pulo, voo, crescer,
-- encolher, invisibilidade, escudo, teletransporte, clones, parar o tempo...

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MapLayout = require(ReplicatedStorage.IdeiasShared.MapLayout)

local Status = require(script.Parent.Parent.Core.Status)
local Combat = require(script.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Core.Actors)
local Fx = require(script.Parent.Parent.Core.Fx)
local Placement = require(script.Parent.Parent.Core.Placement)
local Kit = require(script.Parent.Parent.Builders.Kit)
local Brain = require(script.Parent.Parent.Brains.Brain)

local H = { name = "power" }

local SCALE_VALUES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale" }

local function humanoidOf(player: Player): (Humanoid?, BasePart?)
	local char = player.Character
	if not char then
		return nil, nil
	end
	return char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function resize(player: Player, factor: number, duration: number)
	local h = humanoidOf(player)
	if not h or h.RigType ~= Enum.HumanoidRigType.R15 then
		Fx.to(player, "toast", { t = "Seu avatar não suporta mudar de tamanho (precisa ser R15)", c = Color3.fromRGB(255, 200, 120) })
		return
	end
	local originals = {}
	for _, name in SCALE_VALUES do
		local v = h:FindFirstChild(name) :: NumberValue?
		if v then
			originals[name] = v.Value
			v.Value = v.Value * factor
		end
	end
	local base = h:GetAttribute("BaseWalkSpeed") or h.WalkSpeed
	h:SetAttribute("BaseWalkSpeed", base * (if factor > 1 then 1.25 else 0.8))
	Status.apply(h, "haste", 0.01) -- força recálculo da velocidade
	task.delay(duration, function()
		if h.Parent then
			for name, value in originals do
				local v = h:FindFirstChild(name) :: NumberValue?
				if v then
					v.Value = value
				end
			end
			h:SetAttribute("BaseWalkSpeed", base)
			Status.apply(h, "haste", 0.01)
		end
	end)
end

local function invisible(player: Player, duration: number)
	local char = player.Character
	if not char then
		return
	end
	local saved = {}
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then
			saved[d] = d.Transparency
			d.Transparency = 0.92
		elseif d:IsA("Decal") then
			saved[d] = d.Transparency
			d.Transparency = 1
		end
	end
	char:SetAttribute("Invisivel", true)
	task.delay(duration, function()
		for inst, t in saved do
			if inst.Parent then
				(inst :: any).Transparency = t
			end
		end
		if char.Parent then
			char:SetAttribute("Invisivel", nil)
		end
	end)
end

local function aura(root: BasePart, element: string?, duration: number)
	local fx = Kit.elementEffects(root, element or "light", 1.6)
	task.delay(duration, function()
		for _, i in fx do
			i:Destroy()
		end
	end)
end

local function cape(player: Player, duration: number)
	local char = player.Character
	local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")) :: BasePart?
	if not torso then
		return
	end
	local c = Instance.new("Part")
	c.Name = "CapaIdeias"
	c.Size = Vector3.new(2, 3.4, 0.15)
	c.Color = Color3.fromRGB(200, 25, 35)
	c.Material = Enum.Material.Fabric
	c.CanCollide = false
	c.Massless = true
	c.CFrame = torso.CFrame * CFrame.new(0, -1.1, torso.Size.Z / 2 + 0.15) * CFrame.Angles(math.rad(8), 0, 0)
	local w = Instance.new("WeldConstraint")
	w.Part0 = torso
	w.Part1 = c
	w.Parent = c
	c.Parent = char
	task.delay(duration, function()
		c:Destroy()
	end)
end

-- aplica um poder diretamente (também usado por presentes e poções)
function H.apply(player: Player, kind: string, ctx: any?)
	local h, root = humanoidOf(player)
	if not h or not root then
		return
	end
	local actor = Actors.playerActor(player)
	local dur = 20
	if kind == "heal" then
		h.Health = h.MaxHealth
		for _, k in { "burn", "poison", "freeze", "shock", "slow" } do
			Status.clear(h, k)
		end
		Fx.shockwave(root.Position, 10, Color3.fromRGB(120, 255, 160))
	elseif kind == "speed" then
		Status.apply(h, "haste", dur)
	elseif kind == "jump" then
		Status.apply(h, "superjump", dur)
	elseif kind == "fly" then
		Fx.to(player, "fly", { d = dur })
		aura(root, "wind", dur)
	elseif kind == "giant" then
		resize(player, 2.2, dur)
	elseif kind == "tiny" then
		resize(player, 0.45, dur)
	elseif kind == "invisible" then
		invisible(player, 15)
	elseif kind == "shield" then
		Status.apply(h, "shield", 12)
	elseif kind == "teleport" then
		local regionId = ctx and ctx.params.region
		if not regionId then
			local regions = MapLayout.Regions
			regionId = regions[math.random(1, #regions)].id
		end
		local rng = ctx and ctx.rng or require(ReplicatedStorage.IdeiasShared.Util.Rng).new(os.time())
		local cf = Placement.region(regionId, rng)
		Fx.near(root.Position, 300, "poof", { p = root.Position, s = 1 })
		root.CFrame = cf + Vector3.new(0, 5, 0)
		Fx.to(player, "toast", { t = "Teletransporte: " .. (MapLayout.ById[regionId] and MapLayout.ById[regionId].label or regionId), c = Color3.fromRGB(190, 140, 255) })
	elseif kind == "time_stop" then
		Brain.freezeUntil = os.clock() + 6
		Fx.near(nil, nil, "tint", { c = Color3.fromRGB(150, 150, 160), d = 6, gray = true })
	elseif kind == "slowmo" then
		Brain.slowUntil = os.clock() + 10
		Fx.near(nil, nil, "tint", { c = Color3.fromRGB(120, 170, 255), d = 10 })
	elseif kind == "aura" then
		aura(root, ctx and ctx.params.element, 30)
		Status.apply(h, "haste", 8)
	elseif kind == "cape" then
		cape(player, 60)
		Status.apply(h, "haste", 12)
	elseif kind == "potion" then
		local options = { "heal", "speed", "jump", "giant", "tiny", "invisible", "shield", "fly" }
		local pick = options[math.random(1, #options)]
		Fx.to(player, "toast", { t = "A poção fez efeito: " .. pick, c = Color3.fromRGB(200, 120, 255) })
		H.apply(player, pick, ctx)
		return
	end
	Fx.near(root.Position, 200, "power", { p = root.Position, kind = kind })
	local _ = actor
	local _c = Combat
end

local function spawnClones(ctx: any)
	local player: Player = ctx.owner
	local char = player.Character
	if not char then
		return {}
	end
	local Npc = require(script.Parent.Npc)
	local _ = Npc
	local npcs = {}
	local old = char.Archivable
	char.Archivable = true
	for i = 1, 3 do
		local ok, clone = pcall(function()
			return char:Clone()
		end)
		if ok and clone then
			local model = clone :: Model
			for _, d in model:GetDescendants() do
				if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Tool") then
					d:Destroy()
				elseif d:IsA("BasePart") then
					d.Transparency = math.max(d.Transparency, if d.Name == "HumanoidRootPart" then 1 else 0.25)
				end
			end
			model.Name = "Clone de " .. player.DisplayName
			local h = model:FindFirstChildOfClass("Humanoid")
			local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
			if h and root then
				model:PivotTo(char:GetPivot() * CFrame.new((i - 2) * 5, 0, 5))
				model.Parent = ctx.folder
				h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				h.MaxHealth = 150
				h.Health = 150
				pcall(function()
					root:SetNetworkOwner(nil)
				end)
				local npc: any = {
					kind = "npc",
					eventId = ctx.id,
					model = model,
					root = root,
					humanoid = h,
					faction = "pet",
					owner = player,
					params = {},
					def = ctx.def,
					speed = 18,
					dmg = 12,
					scale = 1,
					attacks = { "melee" },
					reach = 5,
					hipHeight = h.HipHeight,
					height = 5,
					radius = 2,
					enemies = {},
				}
				Actors.register(npc)
				Brain.add(npc)
				h.Died:Connect(function()
					npc.dead = true
					Brain.remove(npc)
					Actors.unregister(npc)
				end)
				table.insert(npcs, npc)
			end
		end
	end
	char.Archivable = old
	return npcs
end

function H.estimate(spec: any): { [string]: number }
	if spec.params.kind == "clone" then
		return { events = 1, npcs = 3, effects = 2 }
	end
	return { events = 1, effects = 2 }
end

function H.spawn(ctx: any): any
	local player: Player? = ctx.owner
	if not player then
		return { position = ctx.origin.Position, done = function()
			return true
		end }
	end
	local kind = ctx.params.kind
	if kind == "clone" then
		local npcs = spawnClones(ctx)
		return {
			npcs = npcs,
			position = ctx.origin.Position,
			stop = function()
				for _, n in npcs do
					Brain.remove(n)
					Actors.unregister(n)
				end
			end,
		}
	elseif kind == "pet" then
		local Planner = require(ReplicatedStorage.IdeiasShared.Planner)
		local pets = { "cachorro", "gato", "coelho", "raposa", "pinguim", "capivara", "panda", "dragao pequeno" }
		local plan = Planner.plan(pets[math.random(1, #pets)] .. " de estimacao")
		task.defer(function()
			ctx.manager.executePlan(plan, player)
		end)
		return { position = ctx.origin.Position, done = function()
			return true
		end }
	end
	H.apply(player, kind, ctx)
	return { position = ctx.origin.Position, elements = { ctx.params.element } }
end

H._players = Players

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">Prop</string>
            <string name="Source"><![CDATA[--!strict
-- Executor de objetos, comidas e natureza.

local Builders = require(script.Parent.Parent.Builders)
local Fx = require(script.Parent.Parent.Core.Fx)
local PropActions = require(script.Parent.Parent.Core.PropActions)

local H = { name = "prop" }

function H.estimate(spec: any): { [string]: number }
	local p = spec.params
	local n = spec.count * (p.cluster or 1)
	return { events = 1, parts = 20 * n, dynamic = if p.physics then n else 0, effects = if p.elementMod then n * 2 else 1 }
end

function H.spawn(ctx: any): any
	local params = ctx.params
	local models = {}
	local n = ctx.count * (params.cluster or 1)
	local first: BasePart? = nil
	local scale = params.scale or 1
	for i = 1, n do
		local origin = ctx.origin
		if n > 1 then
			local ring = 6 * scale + i * 1.5
			local ang = i * 2.39
			origin = ctx.origin * CFrame.new(math.cos(ang) * ring, 0, math.sin(ang) * ring)
		end
		if params.physics then
			origin += Vector3.new(0, 4 * scale, 0)
		end
		if params.float then
			origin += Vector3.new(0, 6, 0)
		end
		local p2 = table.clone(params)
		p2.rng = ctx.rng:fork(i)
		local r = Builders.prop(origin * CFrame.Angles(0, ctx.rng:range(-0.4, 0.4), 0), p2)
		r.model.Name = ctx.def.label
		r.model.Parent = ctx.folder
		if params.physics then
			pcall(function()
				r.main:SetNetworkOwner(nil)
			end)
		end
		if params.float then
			r.model:AddTag("IdeiasFlutuar")
		end
		PropActions.elementize(r.main, params)
		PropActions.attach(r.model, r.main, params.interact, params, ctx)
		table.insert(models, r.model)
		first = first or r.main
	end
	Fx.near(ctx.origin.Position, 300, "spawn", { p = ctx.origin.Position, s = scale, c = Color3.fromRGB(255, 220, 120) })
	return {
		models = models,
		model = models[1],
		anchor = first,
		position = ctx.origin.Position,
		radius = 4 * scale,
		elements = { params.element },
		tags = ctx.def.tagSet,
	}
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">Rain</string>
            <string name="Source"><![CDATA[--!strict
-- "Chuva de X": qualquer coisa física cai do céu (pizzas, gatos, carros...).
-- Os itens são modelos reais com física, limitados por um teto de itens vivos
-- e removidos automaticamente depois de alguns segundos.

local Debris = game:GetService("Debris")
local Builders = require(script.Parent.Parent.Builders)
local Fx = require(script.Parent.Parent.Core.Fx)
local Actors = require(script.Parent.Parent.Core.Actors)
local PropActions = require(script.Parent.Parent.Core.PropActions)

local H = { name = "rain" }

function H.estimate(spec: any): { [string]: number }
	return { events = 1, dynamic = if spec.heavy then 70 else 45, effects = 2, parts = 300 }
end

function H.spawn(ctx: any): any
	local def = ctx.def
	local params = table.clone(ctx.params)
	local heavy = ctx.spec.heavy
	local maxAlive = if heavy then 16 else 11
	local rate = if heavy then 0.18 else 0.3
	local itemScale = 0.55
	if def.handler == "building" or def.handler == "vehicle" then
		itemScale = 0.18
		maxAlive = 6
		rate = 0.6
	elseif def.handler == "npc" then
		itemScale = 0.75
		maxAlive = 8
	end
	local alive = 0
	local running = true
	local center = ctx.origin.Position
	local duration = math.min(ctx.lifetime - 4, if heavy then 24 else 18)
	ctx.folder:SetAttribute("FxKind", "rain_items")
	Fx.near(center, 500, "toast", { t = "☁️ " .. ctx.spec.label .. "!", c = Color3.fromRGB(200, 230, 255) })

	task.spawn(function()
		local t0 = os.clock()
		while running and ctx.folder.Parent and os.clock() - t0 < duration do
			if alive < maxAlive then
				-- cai perto dos jogadores próximos (ou do centro)
				local near = Actors.players()
				local base = center
				if #near > 0 and math.random() < 0.6 then
					local a = near[math.random(1, #near)]
					if (a.root.Position - center).Magnitude < 150 then
						base = a.root.Position
					end
				end
				local pos = base + Vector3.new(math.random(-40, 40), 70 + math.random() * 30, math.random(-40, 40))
				local p2 = table.clone(params)
				p2.scale = (params.scale or 1) * itemScale
				p2.rng = ctx.rng:fork(math.floor(os.clock() * 100))
				p2.physics = true
				p2.anchored = false
				local cf = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
				local ok, model = pcall(Builders.any, def, cf, p2)
				if ok and model then
					local m = model :: Model
					for _, d in m:GetDescendants() do
						if d:IsA("BasePart") then
							d.Anchored = false
							d.CanCollide = true
						elseif d:IsA("Humanoid") then
							d.PlatformStand = true
							d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
						end
					end
					local main = m.PrimaryPart
					if main then
						for _, d in m:GetDescendants() do
							if d:IsA("BasePart") and d ~= main and not d:FindFirstChildWhichIsA("WeldConstraint") then
								local hasJoint = false
								for _, j in d:GetJoints() do
									hasJoint = true
									break
								end
								if not hasJoint then
									local w = Instance.new("WeldConstraint")
									w.Part0 = main
									w.Part1 = d
									w.Parent = d
								end
							end
						end
						main.AssemblyLinearVelocity = Vector3.new(0, -40, 0)
					end
					m.Name = def.label
					m.Parent = ctx.folder
					if main then
						pcall(function()
							main:SetNetworkOwner(nil)
						end)
					end
					if params.edible and main then
						PropActions.attach(m, main, nil, { edible = true }, ctx)
					end
					alive += 1
					task.delay(7, function()
						alive -= 1
						if m.Parent then
							m:Destroy()
						end
					end)
				end
			end
			task.wait(rate)
		end
	end)

	return {
		position = center,
		radius = 50,
		elements = { params.element },
		stop = function()
			running = false
		end,
	}
end

H._debris = Debris

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Tool</string>
            <string name="Source"><![CDATA[--!strict
-- Ferramentas na mochila: espada, martelo, varinha, blaster, arco, bolas de
-- neve, pistola d'água, lança-chamas e gancho. Mira automática no inimigo mais
-- próximo à frente (ótimo no celular). O servidor valida cada golpe.

local Debris = game:GetService("Debris")
local Kit = require(script.Parent.Parent.Builders.Kit)
local Combat = require(script.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Core.Actors)
local Factions = require(script.Parent.Parent.Core.Factions)
local Fx = require(script.Parent.Parent.Core.Fx)

local H = { name = "tool" }

local COOLDOWN = { sword = 0.5, hammer = 1.2, wand = 0.6, blaster = 0.35, bow = 0.8, snowball = 0.4, water_gun = 0.15, flamethrower = 0.25, grapple = 1.5 }
local RANGE = { wand = 120, blaster = 110, bow = 140, snowball = 70, water_gun = 45, flamethrower = 22, grapple = 150 }

function H.estimate(_spec: any): { [string]: number }
	return { events = 1, parts = 10 }
end

local function buildHandle(kind: string, params: { [string]: any }): (Tool, BasePart)
	local tool = Instance.new("Tool")
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	local b = Kit.new("Ferramenta", CFrame.identity, { anchored = false, collide = false, scale = 1, material = params.material, color = params.color, element = params.element, elementMod = params.elementMod })
	local handle: BasePart
	local metal = Color3.fromRGB(210, 215, 225)
	if kind == "sword" then
		handle = b:box(Vector3.new(0.3, 1.2, 0.3), CFrame.new(), Color3.fromRGB(110, 75, 40), { role = "fixed" })
		b:box(Vector3.new(1.4, 0.25, 0.3), CFrame.new(0, 0.7, 0), Color3.fromRGB(255, 200, 50), { role = "fixed", material = Enum.Material.Foil })
		b:box(Vector3.new(0.2, 3.6, 0.5), CFrame.new(0, 2.6, 0), metal, { role = "accent", material = Enum.Material.Metal })
	elseif kind == "hammer" then
		handle = b:box(Vector3.new(0.35, 3, 0.35), CFrame.new(), Color3.fromRGB(110, 75, 40), { role = "fixed" })
		b:box(Vector3.new(1.4, 1.2, 2.2), CFrame.new(0, 1.9, 0), Color3.fromRGB(120, 125, 135), { role = "primary", material = Enum.Material.Metal })
	elseif kind == "wand" then
		handle = b:box(Vector3.new(0.2, 2.4, 0.2), CFrame.new(), Color3.fromRGB(90, 60, 40), { role = "fixed" })
		b:ball(0.6, CFrame.new(0, 1.4, 0), Color3.fromRGB(255, 230, 120), { role = "accent", material = Enum.Material.Neon })
	elseif kind == "bow" then
		handle = b:box(Vector3.new(0.3, 1, 0.3), CFrame.new(), Color3.fromRGB(110, 75, 40), { role = "fixed" })
		b:box(Vector3.new(0.2, 4, 0.3), CFrame.new(0, 0, -0.6), Color3.fromRGB(140, 95, 50), { role = "primary" })
	else
		handle = b:box(Vector3.new(0.4, 1, 0.4), CFrame.new(), Color3.fromRGB(40, 40, 45), { role = "fixed" })
		local col = if kind == "water_gun" then Color3.fromRGB(60, 160, 255) elseif kind == "flamethrower" then Color3.fromRGB(220, 60, 30) elseif kind == "snowball" then Color3.fromRGB(240, 245, 255) else Color3.fromRGB(80, 230, 255)
		b:box(Vector3.new(0.6, 0.7, 2.4), CFrame.new(0, 0.6, -0.9), col, { role = "accent", material = if kind == "blaster" then Enum.Material.Neon else Enum.Material.SmoothPlastic })
	end
	handle.Name = "Handle"
	local model = b:finish(handle)
	for _, p in b.parts do
		p.Massless = true
		p.CanCollide = false
		if p ~= handle then
			local w = Instance.new("WeldConstraint")
			w.Part0 = handle
			w.Part1 = p
			w.Parent = p
		end
		p.Parent = tool
	end
	model:Destroy()
	tool.Grip = CFrame.new(0, -0.3, 0)
	return tool, handle
end

-- inimigo mais próximo à frente do jogador
local function autoAim(player: Player, root: BasePart, range: number): any?
	local me = Actors.playerActor(player)
	local look = root.CFrame.LookVector
	local best, bestScore = nil, math.huge
	for _, a in Actors.near(root.Position, range) do
		if a.kind == "npc" and a.owner ~= player and (a.faction == "hostile" or Factions.hostileTo(a, me) or (a.provokedBy ~= nil)) then
			local to = a.root.Position - root.Position
			local d = to.Magnitude
			local dot = if d > 0.1 then look:Dot(to.Unit) else 1
			if dot > 0.45 then
				local score = d * (1.6 - dot)
				if score < bestScore then
					best, bestScore = a, score
				end
			end
		end
	end
	return best
end

function H.spawn(ctx: any): any
	local player: Player? = ctx.owner
	if not player then
		return { position = ctx.origin.Position, done = function()
			return true
		end }
	end
	local kind = ctx.params.kind
	local params = ctx.params
	-- "arma que atira cachorro": a ferramenta vira um lançador do elo da cadeia
	local launchNode = nil
	for _, a in (ctx.spec and ctx.spec.actions) or {} do
		if a.verb == "shoot" and a.node then
			launchNode = a.node
			break
		end
	end
	local tool, handle = buildHandle(if launchNode and (kind == "sword" or kind == "hammer") then "blaster" else kind, params)
	local toolName = if launchNode then ctx.def.label .. " de " .. (launchNode.baseLabel or launchNode.label) else ctx.def.label
	tool.Name = toolName
	tool.ToolTip = toolName
	local backpack = player:FindFirstChildOfClass("Backpack")
	tool.Parent = backpack or player.Character
	local dmg = (params.dmg or 20) * math.max(1, (params.scale or 1) ^ 0.5)
	local element = params.element
	local color = (element and Kit.Elements[element] and Kit.Elements[element].color) or Color3.fromRGB(255, 255, 255)
	local cd = if launchNode then 1.3 else (COOLDOWN[kind] or 0.6)
	local nextUse = 0

	tool.Activated:Connect(function()
		local now = os.clock()
		if now < nextUse then
			return
		end
		nextUse = now + cd
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 or tool.Parent ~= char then
			return
		end
		local me = Actors.playerActor(player)
		if launchNode then
			local target = autoAim(player, root, 75)
			local landing: Vector3
			if target then
				landing = target.root.Position
			else
				local ahead = root.Position + root.CFrame.LookVector * 32 + Vector3.new(0, 25, 0)
				local rp = RaycastParams.new()
				rp.FilterType = Enum.RaycastFilterType.Exclude
				rp.FilterDescendantsInstances = { char :: Instance }
				local ok, hit = pcall(function()
					return workspace:Raycast(ahead, Vector3.new(0, -90, 0), rp)
				end)
				landing = if ok and hit then hit.Position else root.Position + root.CFrame.LookVector * 32
			end
			local from = handle.Position
			local flight = math.clamp((landing - from).Magnitude / 55, 0.35, 1.4)
			Fx.near(from, 400, "launch", { a = from, b = landing, t = flight, c = color })
			task.delay(flight, function()
				if ctx.folder.Parent then
					local Chains = require(script.Parent.Parent.Core.Chains)
					if not Chains.spawnNode(ctx, launchNode, CFrame.new(landing + Vector3.new(0, 1, 0))) then
						Fx.to(player, "toast", { t = "Mundo cheio: espere um pouco para lançar mais.", c = Color3.fromRGB(255, 200, 120) })
					end
				end
			end)
			return
		end
		if kind == "sword" or kind == "hammer" then
			local reach = if kind == "sword" then 8 else 11
			local center = root.Position + root.CFrame.LookVector * (reach * 0.6)
			local hits = 0
			for _, a in Actors.near(center, reach) do
				if a.kind == "npc" and a.owner ~= player and a.faction ~= "pet" then
					Combat.damage(a, dmg, me, element)
					if kind == "hammer" then
						Combat.push(a, (root.CFrame.LookVector + Vector3.new(0, 0.7, 0)).Unit * 70)
					end
					hits += 1
				end
			end
			if kind == "hammer" then
				Fx.shockwave(center - Vector3.new(0, 2.5, 0), 10, Color3.fromRGB(220, 220, 255))
				Fx.shake(center, 0.4, 60)
			else
				Fx.near(root.Position, 200, "slash", { p = center, c = color })
			end
		elseif kind == "grapple" then
			local origin = root.Position + Vector3.new(0, 1.5, 0)
			local params2 = RaycastParams.new()
			params2.FilterType = Enum.RaycastFilterType.Exclude
			params2.FilterDescendantsInstances = { char :: Instance }
			local look = (root.CFrame.LookVector + Vector3.new(0, 0.35, 0)).Unit
			local hit = workspace:Raycast(origin, look * RANGE.grapple, params2)
			if hit then
				Fx.zap(origin, hit.Position, Color3.fromRGB(240, 240, 240))
				local to = hit.Position - root.Position
				Fx.impulse(player, to.Unit * math.min(to.Magnitude * 1.6, 160) + Vector3.new(0, 25, 0), "set")
			end
		else
			local range = RANGE[kind] or 100
			local target = autoAim(player, root, range)
			local from = handle.Position
			local to = if target then target.root.Position else root.Position + root.CFrame.LookVector * range
			if kind == "flamethrower" then
				Fx.near(from, 200, "cone", { a = from, b = root.Position + root.CFrame.LookVector * range, c = Color3.fromRGB(255, 120, 30) })
				for _, a in Actors.near(root.Position + root.CFrame.LookVector * (range / 2), range / 2 + 2) do
					if a.kind == "npc" and a.owner ~= player and a.faction ~= "pet" then
						Combat.damage(a, dmg * 0.6, me, "fire")
					end
				end
			else
				local speed = if kind == "bow" then 160 elseif kind == "snowball" then 90 else 180
				local boltColor = if kind == "water_gun" then Color3.fromRGB(80, 170, 255) elseif kind == "snowball" then Color3.fromRGB(245, 250, 255) else color
				Fx.bolt(from, to, boltColor, speed, if kind == "snowball" then 1.2 else 0.5)
				if target then
					local d = (to - from).Magnitude
					local el = if kind == "snowball" then "ice" elseif kind == "water_gun" then "water" else element
					task.delay(d / speed, function()
						if Actors.alive(target) then
							Combat.damage(target, dmg, me, el)
						end
					end)
				end
			end
		end
	end)

	Fx.to(player, "toast", { t = "🎒 " .. toolName .. " na mochila! Toque para usar.", c = Color3.fromRGB(255, 230, 140) })
	return {
		position = ctx.origin.Position,
		elements = { element },
		stop = function()
			if tool.Parent then
				tool:Destroy()
			end
		end,
		done = function()
			return tool.Parent == nil
		end,
	}
end

H._debris = Debris

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">Vehicle</string>
            <string name="Source"><![CDATA[--!strict
-- Executor de veículos. Física "arcade" estável:
--   terrestres/aquáticos: LinearVelocity no plano XZ + AlignOrientation (sempre em pé)
--   aéreos: LinearVelocity 3D (compensa a gravidade) + AlignOrientation
-- Quando um JOGADOR senta, o cliente dele assume a física e dirige localmente
-- (resposta imediata); o servidor só limita a velocidade máxima.
-- Sem jogador: estaciona; com NPC (vínculo "ride"): piloto automático.

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Builders = require(script.Parent.Parent.Builders)
local Fx = require(script.Parent.Parent.Core.Fx)
local Actors = require(script.Parent.Parent.Core.Actors)
local PropActions = require(script.Parent.Parent.Core.PropActions)

local H = { name = "vehicle" }

local active: { any } = {}
local loopStarted = false

function H.estimate(spec: any): { [string]: number }
	return { events = 1, dynamic = 4 * spec.count, parts = 70 * spec.count, effects = 1 }
end

local function setupPhysics(v: any)
	local chassis: BasePart = v.chassis
	local att = Instance.new("Attachment")
	att.Name = "Motor"
	att.Parent = chassis
	local lv = Instance.new("LinearVelocity")
	lv.Name = "Tracao"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	if v.drive == "air" or v.drive == "rocket" then
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.VectorVelocity = Vector3.zero
		lv.MaxForce = 5e5
	else
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		lv.PrimaryTangentAxis = Vector3.xAxis
		lv.SecondaryTangentAxis = Vector3.zAxis
		lv.PlaneVelocity = Vector2.zero
		lv.MaxForce = 2e5
	end
	lv.Parent = chassis
	local ao = Instance.new("AlignOrientation")
	ao.Name = "Estabilizador"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 5e6
	ao.Responsiveness = 18
	ao.CFrame = chassis.CFrame.Rotation
	ao.Parent = chassis
	v.lv = lv
	v.ao = ao
	v.yaw = math.atan2(-chassis.CFrame.LookVector.X, -chassis.CFrame.LookVector.Z)
end

local function driverPlayer(seat: VehicleSeat): Player?
	local h = seat.Occupant
	return h and Players:GetPlayerFromCharacter(h.Parent)
end

local function autopilot(v: any, dt: number)
	local chassis: BasePart = v.chassis
	local seat: VehicleSeat = v.seat
	local npcDriver = seat.Occupant ~= nil and driverPlayer(seat) == nil
	local speed = 0
	if npcDriver or v.autopilot then
		-- persegue o jogador mais próximo se o piloto for hostil; senão passeia
		local rider = seat.Occupant and Actors.ofHumanoid(seat.Occupant)
		local goal: Vector3? = nil
		if rider and rider.faction == "hostile" then
			local best, bd = nil, 200
			for _, a in Actors.players() do
				local d = (a.root.Position - chassis.Position).Magnitude
				if d < bd then
					best, bd = a, d
				end
			end
			goal = best and best.root.Position
		end
		if not goal then
			v.wanderT = (v.wanderT or 0) - dt
			if v.wanderT <= 0 or not v.wanderGoal then
				v.wanderT = 6
				local ang = math.random() * math.pi * 2
				v.wanderGoal = v.home + Vector3.new(math.cos(ang) * 70, 0, math.sin(ang) * 70)
			end
			goal = v.wanderGoal
		end
		local to = (goal :: Vector3) - chassis.Position
		local desired = math.atan2(-to.X, -to.Z)
		local diff = (desired - v.yaw + math.pi) % (2 * math.pi) - math.pi
		v.yaw += math.clamp(diff, -1.6 * dt, 1.6 * dt)
		speed = if to.Magnitude > 12 then v.maxSpeed * 0.55 else 0
	end
	local look = Vector3.new(-math.sin(v.yaw), 0, -math.cos(v.yaw))
	v.ao.CFrame = CFrame.Angles(0, v.yaw, 0)
	if v.drive == "air" then
		local alt = v.home.Y + (if npcDriver or v.autopilot then 40 else 0)
		local vy = math.clamp((alt - chassis.Position.Y) * 0.8, -20, 20)
		v.lv.VectorVelocity = look * speed + Vector3.new(0, if v.parked then -6 else vy, 0)
	elseif v.drive ~= "rocket" then
		v.lv.PlaneVelocity = Vector2.new(look.X * speed, look.Z * speed)
	end
end

local function rocketLaunch(v: any)
	if v.launched then
		return
	end
	v.launched = true
	local chassis: BasePart = v.chassis
	local player = driverPlayer(v.seat)
	if player then
		Fx.to(player, "toast", { t = "3... 2... 1... DECOLAR! 🚀", c = Color3.fromRGB(255, 200, 80) })
	end
	task.wait(3)
	if not chassis.Parent then
		return
	end
	pcall(function()
		chassis:SetNetworkOwner(nil)
	end)
	local fire = Instance.new("Fire")
	fire.Size = 10
	fire.Heat = 25
	fire.Parent = chassis
	local t0 = os.clock()
	while chassis.Parent and os.clock() - t0 < 5 do
		v.lv.VectorVelocity = Vector3.new(0, 30 + (os.clock() - t0) * 40, 0)
		task.wait(0.1)
	end
	if chassis.Parent then
		local pos = chassis.Position
		local occupant = v.seat.Occupant
		if occupant then
			occupant.Sit = false
			local p = Players:GetPlayerFromCharacter(occupant.Parent)
			if p then
				Fx.to(p, "slowfall", { d = 12 })
			end
		end
		Fx.near(pos, 1000, "fireworks", { p = pos, n = 12 })
		PropActions.explode(pos, 0.6, nil)
		v.model:Destroy()
	end
end

local function step(dt: number)
	for i = #active, 1, -1 do
		local v = active[i]
		if not v.model.Parent then
			table.remove(active, i)
		else
			local player = driverPlayer(v.seat)
			if player then
				-- jogador dirige no próprio cliente; servidor só limita abusos
				local vel = v.chassis.AssemblyLinearVelocity
				if vel.Magnitude > v.maxSpeed * 1.6 then
					v.chassis.AssemblyLinearVelocity = vel.Unit * v.maxSpeed
				end
				v.parked = false
				if v.drive == "rocket" then
					task.spawn(rocketLaunch, v)
				end
			else
				if v.wasDriven then
					pcall(function()
						v.chassis:SetNetworkOwner(nil)
					end)
				end
				v.parked = v.seat.Occupant == nil and not v.autopilot
				autopilot(v, dt)
			end
			v.wasDriven = player ~= nil
		end
	end
end

function H.spawn(ctx: any): any
	if not loopStarted then
		loopStarted = true
		RunService.Heartbeat:Connect(step)
	end
	local params = table.clone(ctx.params)
	params.rng = ctx.rng
	local first: any = nil
	for i = 1, ctx.count do
		local origin = ctx.origin * CFrame.new((i - 1) * 14, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
		if params.drive == "air" then
			origin += Vector3.new(0, 3, 0)
		end
		local v = Builders.vehicle(origin + Vector3.new(0, 1, 0), params)
		v.model.Name = ctx.def.label
		v.model.Parent = ctx.folder
		pcall(function()
			v.chassis:SetNetworkOwner(nil)
		end)
		local rec = {
			model = v.model,
			chassis = v.chassis,
			seat = v.seat,
			drive = v.drive,
			maxSpeed = (params.speed or 60) * (params.speedMul or 1),
			home = v.chassis.Position,
			autopilot = false,
		}
		setupPhysics(rec)
		v.model:SetAttribute("VelMax", rec.maxSpeed)
		table.insert(active, rec)
		PropActions.elementize(v.chassis, params)
		first = first or rec
	end
	Fx.near(ctx.origin.Position, 300, "spawn", { p = ctx.origin.Position, s = 1.5, c = Color3.fromRGB(150, 220, 255) })
	local handle: any = {
		model = first.model,
		seat = first.seat,
		anchor = first.chassis,
		position = first.home,
		radius = 8,
		elements = { params.element },
	}
	-- o vínculo "ride" liga o piloto automático por aqui
	task.spawn(function()
		while first.model.Parent do
			if handle.autopilot then
				first.autopilot = true
			end
			task.wait(0.5)
		end
	end)
	return handle
end

return H
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[--!strict
-- Clima, céu e magia: noite, dia, pôr do sol, eclipse, chuva, neblina,
-- arco-íris, aurora, festa, fogos, lua gigante, estrelas, bênção, maldição,
-- invocação, desejo, tesouro, restaurar o mapa e limpar as próprias ideias.
-- Tudo é temporário (Ambience) e volta sozinho.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Ambience = require(script.Parent.Parent.Core.Ambience)
local Destruction = require(script.Parent.Parent.Core.Destruction)
local Combat = require(script.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Core.Actors)
local Status = require(script.Parent.Parent.Core.Status)
local Fx = require(script.Parent.Parent.Core.Fx)
local Kit = require(script.Parent.Parent.Builders.Kit)
local Builders = require(script.Parent.Parent.Builders)
local PropActions = require(script.Parent.Parent.Core.PropActions)

local H = { name = "world" }

function H.estimate(spec: any): { [string]: number }
	local k = spec.params.kind
	if k == "restore" or k == "clear" then
		return {}
	end
	return { events = 1, effects = 3, parts = 40 }
end

local function sky(ctx: any, props: { [string]: any }): () -> ()
	return Ambience.push(props, ctx.lifetime, 1)
end

local function rainbow(ctx: any)
	local b = Kit.new("ArcoIris", ctx.origin * CFrame.new(0, 0, -60), { anchored = true, collide = false })
	for band = 1, 6 do
		local r = 70 - band * 4
		for k = 0, 17 do
			local a = k / 17 * math.pi
			b:box(Vector3.new(4, 4, 12), CFrame.new(math.cos(a) * r, math.sin(a) * r, 0) * CFrame.Angles(0, 0, a + math.pi / 2), Kit.RainbowColors[band], { role = "fixed", material = Enum.Material.Neon, transparency = 0.3, collide = false, shadow = false })
		end
	end
	b:finish().Parent = ctx.folder
end

local function moon(ctx: any)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(160, 160, 160)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.Material = Enum.Material.Slate
	p.Color = Color3.fromRGB(225, 225, 210)
	p.CFrame = CFrame.new(ctx.origin.Position + ctx.origin.LookVector * -450 + Vector3.new(0, 320, 0))
	p.Name = "Lua"
	p.Parent = ctx.folder
	for k = 1, 6 do
		local c = Instance.new("Part")
		c.Shape = Enum.PartType.Ball
		local s = math.random(18, 36)
		c.Size = Vector3.new(s, s, s)
		c.Anchored = true
		c.CanCollide = false
		c.CanQuery = false
		c.Material = Enum.Material.Slate
		c.Color = Color3.fromRGB(190, 190, 180)
		local dir = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5).Unit
		c.CFrame = CFrame.new(p.Position + dir * 76)
		c.Parent = ctx.folder
	end
end

local function circle(ctx: any, color: Color3): Model
	local b = Kit.new("Circulo", ctx.origin, { anchored = true, collide = false })
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		b:box(Vector3.new(4.2, 0.3, 0.8), CFrame.new(math.cos(a) * 10, 0.2, math.sin(a) * 10) * CFrame.Angles(0, -a + math.pi / 2, 0), color, { role = "fixed", material = Enum.Material.Neon })
	end
	for k = 0, 4 do
		local a1 = k / 5 * math.pi * 2
		local a2 = (k + 2) / 5 * math.pi * 2
		b:beam(Vector3.new(math.cos(a1) * 9, 0.25, math.sin(a1) * 9), Vector3.new(math.cos(a2) * 9, 0.25, math.sin(a2) * 9), 0.5, color, { role = "fixed", material = Enum.Material.Neon })
	end
	local m = b:finish()
	m.Parent = ctx.folder
	return m
end

local function child(ctx: any, text: string)
	local Planner = require(ReplicatedStorage.IdeiasShared.Planner)
	local plan = Planner.plan(text)
	plan.location = nil
	task.defer(function()
		ctx.manager.executePlan(plan, ctx.owner)
	end)
end

local SUMMONS = { "dragao", "fenix", "unicornio", "golem", "anjo", "lobo", "kraken", "mago", "fada", "robo gigante" }

function H.spawn(ctx: any): any
	local k = ctx.params.kind
	local handle: any = { position = ctx.origin.Position, radius = 0, elements = {} }
	local restore: (() -> ())? = nil
	if k == "night" then
		restore = sky(ctx, { ClockTime = 0.2, Brightness = 1.2 })
	elseif k == "day" then
		restore = sky(ctx, { ClockTime = 13, Brightness = 2.8 })
	elseif k == "sunset" then
		restore = sky(ctx, { ClockTime = 18.1, AtmosphereColor = Color3.fromRGB(255, 190, 150), AtmosphereDecay = Color3.fromRGB(190, 90, 70) })
	elseif k == "eclipse" then
		restore = sky(ctx, { ClockTime = 12.5, Brightness = 0.25, OutdoorAmbient = Color3.fromRGB(90, 40, 40), AtmosphereColor = Color3.fromRGB(140, 60, 50), AtmosphereDensity = 0.45 })
	elseif k == "rain" then
		restore = sky(ctx, { Brightness = 1.4, OutdoorAmbient = Color3.fromRGB(90, 95, 110), AtmosphereDensity = 0.42, Clima = "chuva" })
		handle.elements = { "water" }
		handle.radius = 300
		task.spawn(function()
			while ctx.folder.Parent do
				for _, a in Actors.players() do
					Status.apply(a.humanoid, "wet", 3)
				end
				task.wait(2)
			end
		end)
	elseif k == "fog" then
		restore = sky(ctx, { AtmosphereDensity = 0.7, AtmosphereHaze = 6, Brightness = 1.6 })
	elseif k == "rainbow" then
		rainbow(ctx)
		restore = sky(ctx, { Clima = "arco_iris" })
	elseif k == "aurora" then
		restore = sky(ctx, { ClockTime = 23, Brightness = 1, Clima = "aurora" })
	elseif k == "party" then
		restore = sky(ctx, { ClockTime = 21, Brightness = 1.1, Clima = "festa" })
		task.spawn(function()
			while ctx.folder.Parent do
				for _, a in Actors.near(ctx.origin.Position, 120) do
					if a.kind == "npc" and a.faction ~= "hostile" then
						a.behavior = "dance"
					end
				end
				task.wait(2)
			end
		end)
	elseif k == "fireworks" then
		task.spawn(function()
			for _ = 1, 10 do
				if not ctx.folder.Parent then
					break
				end
				Fx.near(ctx.origin.Position, 1500, "fireworks", { p = ctx.origin.Position + Vector3.new(math.random(-60, 60), 0, math.random(-60, 60)), n = 4 })
				task.wait(1.6)
			end
		end)
	elseif k == "moon" then
		moon(ctx)
		restore = sky(ctx, { ClockTime = 22.5, Brightness = 1.3, Gravity = 110 })
	elseif k == "stars" then
		restore = sky(ctx, { ClockTime = 0, Brightness = 1, Clima = "estrelas" })
	elseif k == "restore" then
		Destruction.restoreAll()
		Fx.near(nil, nil, "toast", { t = "🔧 Mapa restaurado!", c = Color3.fromRGB(150, 255, 190) })
		handle.done = function()
			return true
		end
	elseif k == "clear" then
		local n = 0
		if ctx.owner then
			for _, rec in table.clone(ctx.manager.active()) do
				if rec.owner == ctx.owner and rec.id ~= ctx.id then
					ctx.manager.remove(rec, "clear")
					n += 1
				end
			end
			Fx.to(ctx.owner, "toast", { t = "🧹 " .. n .. " ideia(s) removida(s)", c = Color3.fromRGB(200, 230, 255) })
		end
		handle.done = function()
			return true
		end
	elseif k == "magic" then
		local options = { "arco iris", "fogos", "bencao", "invocacao", "estrelas", "chuva de presentes" }
		child(ctx, options[ctx.rng:int(1, #options)])
		handle.done = function()
			return true
		end
	elseif k == "blessing" then
		Fx.near(nil, nil, "tint", { c = Color3.fromRGB(255, 240, 180), d = 2 })
		for _, a in Actors.players() do
			Combat.heal(a, 1000)
			Status.apply(a.humanoid, "shield", 6)
		end
		Fx.shockwave(ctx.origin.Position, 60, Color3.fromRGB(255, 230, 140))
		restore = sky(ctx, { Brightness = 3.2, AtmosphereColor = Color3.fromRGB(255, 240, 200) })
	elseif k == "curse" then
		restore = sky(ctx, { ClockTime = 0.5, Brightness = 0.7, OutdoorAmbient = Color3.fromRGB(70, 40, 90), AtmosphereColor = Color3.fromRGB(110, 60, 140) })
		for _, a in Actors.near(ctx.origin.Position, 400) do
			if a.kind == "npc" and a.faction == "hostile" then
				a.speed *= 1.3
				a.dmg *= 1.3
			end
		end
		child(ctx, "3 fantasmas")
	elseif k == "summon" then
		local m = circle(ctx, Color3.fromRGB(190, 110, 255))
		Fx.shockwave(ctx.origin.Position, 14, Color3.fromRGB(190, 110, 255))
		task.delay(2, function()
			if ctx.folder.Parent then
				child(ctx, SUMMONS[ctx.rng:int(1, #SUMMONS)] .. " aliado")
			end
		end)
		handle.model = m
	elseif k == "wish" then
		Fx.near(ctx.origin.Position, 800, "fireworks", { p = ctx.origin.Position, n = 6 })
		local pp = { scale = 1, rng = ctx.rng }
		local ok, r = pcall(Builders.Props.build, ctx.origin, pp, "prop", "chest")
		if ok and r then
			r.model.Parent = ctx.folder
			PropActions.attach(r.model, r.main, "treasure", pp, ctx)
		end
		if ctx.owner then
			local Power = require(script.Parent.Power)
			Power.apply(ctx.owner, ({ "shield", "speed", "jump", "aura" })[ctx.rng:int(1, 4)], ctx)
		end
	elseif k == "treasure" then
		child(ctx, "chuva de moedas")
		local pp = { scale = 1.2, rng = ctx.rng }
		local ok, r = pcall(Builders.Props.build, ctx.origin, pp, "prop", "chest")
		if ok and r then
			r.model.Parent = ctx.folder
			PropActions.attach(r.model, r.main, "treasure", pp, ctx)
		end
	end
	if restore then
		handle.stop = restore
	end
	Workspace:SetAttribute("UltimoClima", k)
	return handle
end

return H
]]></string>
          </Properties>
        </Item>
