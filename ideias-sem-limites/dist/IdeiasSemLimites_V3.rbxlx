  <Item class="ServerScriptService" referent="38">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="39">
      <Properties>
        <string name="Name">IdeiasServer</string>
      </Properties>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Brains</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Abilities</string>
            <string name="Source"><![CDATA[--!strict
-- Habilidades de ataque e suporte dos NPCs. Cada habilidade tem alcance,
-- recarga e efeito; o Brain chama tryUse() a cada "pensamento".

local Combat = require(script.Parent.Parent.Core.Combat)
local Actors = require(script.Parent.Parent.Core.Actors)
local Factions = require(script.Parent.Parent.Core.Factions)
local Fx = require(script.Parent.Parent.Core.Fx)
local Kit = require(script.Parent.Parent.Builders.Kit)

local Abilities = {}

local function elementColor(element: string?): Color3
	local e = element and Kit.Elements[element]
	return if e then e.color else Color3.fromRGB(255, 255, 255)
end

local function ready(npc: any, name: string, now: number): boolean
	npc.cd = npc.cd or {}
	return (npc.cd[name] or 0) <= now
end

local function cooldown(npc: any, name: string, now: number, seconds: number)
	npc.cd[name] = now + seconds * (0.85 + math.random() * 0.3)
end

local function face(npc: any, target: Vector3)
	if npc.flying then
		return -- orientação dos voadores é controlada pelo Brain
	end
	local pos = npc.root.Position
	local flat = Vector3.new(target.X, pos.Y, target.Z)
	if (flat - pos).Magnitude > 0.5 then
		npc.root.CFrame = CFrame.lookAt(pos, flat)
	end
end

local function mark(npc: any, kind: string)
	-- o cliente usa este atributo para animar o golpe
	npc.model:SetAttribute("Golpe", kind)
	npc.model:SetAttribute("GolpeEm", workspace:GetServerTimeNow())
end

local impl = {}

function impl.melee(npc: any, target: any, dist: number, now: number): boolean
	local reach = npc.reach or 5
	if dist > reach + (target.radius or 2) then
		return false
	end
	mark(npc, "melee")
	Combat.damage(target, npc.dmg, npc, if npc.faction == "hostile" then npc.element else nil)
	if npc.scale > 1.6 then
		Combat.push(target, (target.root.Position - npc.root.Position).Unit * 25 * math.min(npc.scale, 3) + Vector3.new(0, 18, 0))
	end
	cooldown(npc, "melee", now, 1.1)
	return true
end

function impl.breath(npc: any, target: any, dist: number, now: number): boolean
	local range = 16 + 14 * npc.scale
	if dist > range then
		return false
	end
	mark(npc, "breath")
	face(npc, target.root.Position)
	local emitter = npc.breathEmitter
	if emitter then
		emitter.Enabled = true
	end
	cooldown(npc, "breath", now, 6)
	npc.busyUntil = now + 1.2
	task.spawn(function()
		for _ = 1, 4 do
			if not Actors.alive(npc) then
				break
			end
			local origin = if npc.mouth then npc.mouth.WorldPosition else npc.root.Position
			local look = npc.root.CFrame.LookVector
			for _, a in Actors.near(origin, range) do
				if Factions.hostileTo(npc, a) then
					local to = a.root.Position - origin
					if to.Magnitude > 0.1 and look:Dot(to.Unit) > 0.75 then
						Combat.damage(a, npc.dmg * 0.45, npc, npc.element or "fire")
					end
				end
			end
			task.wait(0.3)
		end
		if emitter and emitter.Parent then
			emitter.Enabled = false
		end
	end)
	return true
end

function impl.bolt(npc: any, target: any, dist: number, now: number): boolean
	if dist > 95 or dist < 4 then
		return false
	end
	mark(npc, "bolt")
	face(npc, target.root.Position)
	local from = (if npc.mouth then npc.mouth.WorldPosition else npc.root.Position + Vector3.new(0, 2, 0))
	local aim = target.root.Position
	local speed = 130
	local boltColor = if npc.boltColor == "banana" then Color3.fromRGB(250, 220, 60) else elementColor(npc.element)
	Fx.bolt(from, aim, boltColor, speed, 0.5 + 0.2 * npc.scale)
	cooldown(npc, "bolt", now, 2.2)
	task.delay(dist / speed, function()
		if Actors.alive(target) and (target.root.Position - aim).Magnitude < 7 then
			Combat.damage(target, npc.dmg * 0.8, npc, npc.element)
		end
	end)
	return true
end

function impl.stomp(npc: any, target: any, dist: number, now: number): boolean
	local radius = 12 + 6 * npc.scale
	if dist > radius then
		return false
	end
	mark(npc, "stomp")
	local pos = npc.root.Position - Vector3.new(0, npc.hipHeight or 2, 0)
	Fx.shockwave(pos, radius, Color3.fromRGB(200, 180, 140))
	Fx.shake(pos, 0.6 * math.min(npc.scale, 3), radius * 4)
	Combat.areaEnemies(pos, radius, npc.dmg * 1.1, npc, nil, 55)
	cooldown(npc, "stomp", now, 5)
	npc.busyUntil = now + 0.6
	return true
end

function impl.charge(npc: any, target: any, dist: number, now: number): boolean
	if dist < 8 or dist > 50 then
		return false
	end
	mark(npc, "charge")
	npc.chargeUntil = now + 1.1
	cooldown(npc, "charge", now, 6)
	return false -- não bloqueia o movimento: o Brain acelera durante a investida
end

function impl.beam(npc: any, target: any, dist: number, now: number): boolean
	if dist > 70 then
		return false
	end
	mark(npc, "beam")
	Fx.near(npc.root.Position, 300, "beam", { a = npc.root.Position, b = target.root.Position, c = elementColor(npc.element), d = 1.6 })
	Combat.push(target, Vector3.new(0, 55, 0))
	Combat.damage(target, npc.dmg, npc, nil)
	cooldown(npc, "beam", now, 7)
	return true
end

function impl.whirlwind(npc: any, _target: any, dist: number, now: number): boolean
	if dist > 26 then
		return false
	end
	mark(npc, "whirlwind")
	local pos = npc.root.Position
	Fx.near(pos, 300, "whirl", { p = pos, r = 18, d = 3 })
	for _, a in Actors.near(pos, 22) do
		if Factions.hostileTo(npc, a) or a.faction == "player" then
			local away = a.root.Position - pos
			away = if away.Magnitude > 0.1 then away.Unit else Vector3.xAxis
			Combat.push(a, away * 40 + Vector3.new(0, 50, 0))
			Combat.damage(a, npc.dmg * 0.5, npc, nil)
		end
	end
	cooldown(npc, "whirlwind", now, 9)
	return true
end

-- PODERES DOS PERSONAGENS POR NOME --------------------------------------------------
local Status = require(script.Parent.Parent.Core.Status)

local function lineHit(npc: any, from: Vector3, to: Vector3, width: number, dmg: number, push: number)
	local ab = to - from
	local len2 = ab:Dot(ab)
	if len2 < 0.01 then
		return
	end
	for _, a in Actors.near((from + to) / 2, math.sqrt(len2) / 2 + width + 4) do
		if Factions.hostileTo(npc, a) then
			local t = math.clamp((a.root.Position - from):Dot(ab) / len2, 0, 1)
			if (a.root.Position - (from + ab * t)).Magnitude < width + (a.radius or 2) then
				Combat.damage(a, dmg, npc, npc.element)
				if push > 0 then
					Combat.push(a, ab.Unit * push + Vector3.new(0, push * 0.5, 0))
				end
			end
		end
	end
end

-- Guerreiro de Energia: carrega (aura) e solta um raio enorme
function impl.energy_beam(npc: any, target: any, dist: number, now: number): boolean
	if dist > 85 or dist < 6 then
		return false
	end
	mark(npc, "beam")
	face(npc, target.root.Position)
	local color = elementColor(npc.element)
	Fx.near(npc.root.Position, 450, "charge", { p = npc.root.Position, c = color, d = 0.9, s = npc.scale })
	npc.busyUntil = now + 1.7
	cooldown(npc, "energy_beam", now, 7)
	task.delay(0.9, function()
		if not Actors.alive(npc) or not Actors.alive(target) then
			return
		end
		local from = npc.root.Position + npc.root.CFrame.LookVector * (2 + npc.scale) + Vector3.new(0, 0.8, 0)
		local to = target.root.Position
		Fx.near(from, 500, "kame", { a = from, b = to, c = color, w = 2.2 * math.max(1, npc.scale) })
		Fx.shake(to, 0.7, 200)
		lineHit(npc, from, to, 3, npc.dmg * 2.2, 70)
	end)
	return true
end

-- Herói Careca: um soco que manda qualquer um para longe
function impl.super_punch(npc: any, target: any, dist: number, now: number): boolean
	local reach = (npc.reach or 5) + 1.5
	if dist > reach + (target.radius or 2) then
		return false
	end
	mark(npc, "punch")
	face(npc, target.root.Position)
	local dir = target.root.Position - npc.root.Position
	dir = Vector3.new(dir.X, 0, dir.Z)
	dir = if dir.Magnitude > 0.1 then dir.Unit else npc.root.CFrame.LookVector
	Combat.damage(target, npc.dmg * 12, npc, nil)
	Combat.push(target, dir * 230 + Vector3.new(0, 120, 0))
	Fx.near(target.root.Position, 500, "punch", { p = target.root.Position, d = dir, s = 1.6 })
	Fx.shake(target.root.Position, 1.4, 260)
	cooldown(npc, "super_punch", now, 2.5)
	npc.busyUntil = now + 0.5
	return true
end

-- Ninja das Sombras: dois clones que lutam por 12 segundos
function impl.clones(npc: any, _target: any, dist: number, now: number): boolean
	if dist > 70 or npc.isClone or not npc.ctx then
		return false
	end
	cooldown(npc, "clones", now, 18)
	mark(npc, "clones")
	local Chains = require(script.Parent.Parent.Core.Chains)
	local p = table.clone(npc.params)
	p.isClone = true
	p.hp = math.floor((p.hp or 200) * 0.3)
	local atk = {}
	for _, a in npc.attacks do
		if a ~= "clones" then
			table.insert(atk, a)
		end
	end
	p.attacks = atk
	local node = { concept = npc.def, handler = "npc", params = p, count = 1, label = npc.def.label, mods = {} }
	for i = 1, 2 do
		local cf = npc.root.CFrame * CFrame.new(if i == 1 then -4 else 4, 0, 1)
		Fx.near(cf.Position, 300, "poof", { p = cf.Position, s = 1 })
		Chains.spawnNode(npc.ctx, node, CFrame.new(cf.Position), { ttl = 12 })
	end
	return false
end

-- Herói Aranha: teia que prende o alvo
function impl.web(npc: any, target: any, dist: number, now: number): boolean
	if dist > 70 or dist < 5 then
		return false
	end
	mark(npc, "bolt")
	face(npc, target.root.Position)
	local from = npc.root.Position + Vector3.new(0, 1, 0)
	Fx.near(from, 400, "web", { a = from, b = target.root.Position })
	cooldown(npc, "web", now, 4)
	task.delay(dist / 140, function()
		if Actors.alive(target) then
			Status.apply(target.humanoid, "root", 2.5)
			Combat.damage(target, npc.dmg * 0.5, npc, nil)
		end
	end)
	return true
end

-- Olhos de laser (herói voador, armadura)
function impl.laser_eyes(npc: any, target: any, dist: number, now: number): boolean
	if dist > 75 or dist < 5 then
		return false
	end
	mark(npc, "beam")
	face(npc, target.root.Position)
	local head = npc.model:FindFirstChild("Cabeca") :: BasePart?
	local from = if head then head.Position else npc.root.Position + Vector3.new(0, 2, 0)
	local to = target.root.Position
	Fx.near(from, 400, "lasereyes", { a = from, b = to, c = if npc.element == "electric" then Color3.fromRGB(120, 230, 255) else Color3.fromRGB(255, 60, 60) })
	lineHit(npc, from, to, 1.5, npc.dmg * 1.3, 0)
	cooldown(npc, "laser_eyes", now, 3.5)
	return true
end

-- Deus do Trovão / Ratinho Elétrico: raio do céu no alvo
function impl.lightning_call(npc: any, target: any, dist: number, now: number): boolean
	if dist > 90 then
		return false
	end
	mark(npc, "bolt")
	local pos = target.root.Position
	Fx.near(pos, 500, "lightning", { p = pos })
	Combat.areaEnemies(pos, 8 + 2 * npc.scale, npc.dmg * 1.3, npc, "electric", 30)
	cooldown(npc, "lightning_call", now, 4.5)
	return true
end

-- Crocodilo Bombardeiro: solta bombas por cima do alvo
function impl.bomb_drop(npc: any, target: any, dist: number, now: number): boolean
	local flat = Vector3.new(target.root.Position.X - npc.root.Position.X, 0, target.root.Position.Z - npc.root.Position.Z)
	if flat.Magnitude > 30 or dist > 70 then
		return false
	end
	mark(npc, "bomb")
	local from = npc.root.Position - Vector3.new(0, 1.5, 0)
	local to = target.root.Position
	Fx.bolt(from, to, Color3.fromRGB(40, 40, 45), 70, 1.4)
	cooldown(npc, "bomb_drop", now, 3)
	task.delay((to - from).Magnitude / 70, function()
		Fx.near(to, 500, "boom", { p = to, s = 1.3 })
		Fx.shake(to, 0.8, 200)
		if Actors.alive(npc) then
			Combat.areaEnemies(to, 11, npc.dmg * 1.4, npc, "fire", 60)
		end
	end)
	return false
end

-- Medusa: olhar que transforma em pedra por alguns segundos
function impl.petrify(npc: any, target: any, dist: number, now: number): boolean
	if dist > 40 then
		return false
	end
	mark(npc, "beam")
	face(npc, target.root.Position)
	Fx.near(target.root.Position, 300, "petrify", { p = target.root.Position })
	Status.apply(target.humanoid, "freeze", 3)
	Combat.damage(target, npc.dmg * 0.6, npc, nil)
	cooldown(npc, "petrify", now, 8)
	return true
end

-- Arbusto-Bomba: chega perto, chia e explode
function impl.self_destruct(npc: any, target: any, dist: number, now: number): boolean
	if dist > 8 + (target.radius or 2) or npc.fusing then
		return false
	end
	npc.fusing = true
	cooldown(npc, "self_destruct", now, 99)
	npc.model:SetAttribute("Pavio", workspace:GetServerTimeNow())
	Fx.near(npc.root.Position, 300, "fuse", { p = npc.root.Position, d = 1.3 })
	npc.busyUntil = now + 1.4
	task.delay(1.3, function()
		if not Actors.alive(npc) then
			return
		end
		local pos = npc.root.Position
		Fx.near(pos, 500, "boom", { p = pos, s = 1.4 })
		Fx.shake(pos, 1, 200)
		Combat.areaEnemies(pos, 12, npc.dmg, npc, "fire", 80)
		npc.silentDeath = true
		npc.humanoid.Health = 0
	end)
	return true
end

-- Tronco Tum-Tum: "tum tum tum" que derruba quem está perto
function impl.drum(npc: any, target: any, dist: number, now: number): boolean
	local radius = 14 + 4 * npc.scale
	if dist > radius then
		return false
	end
	mark(npc, "stomp")
	local pos = npc.root.Position - Vector3.new(0, npc.hipHeight or 2, 0)
	Fx.near(pos, 400, "drum", { p = pos, r = radius })
	for k = 0, 2 do
		task.delay(k * 0.35, function()
			if Actors.alive(npc) then
				Fx.shockwave(pos, radius * (0.6 + k * 0.2), Color3.fromRGB(200, 150, 90))
				Combat.areaEnemies(pos, radius, npc.dmg * 0.45, npc, nil, 35)
			end
		end)
	end
	cooldown(npc, "drum", now, 6)
	npc.busyUntil = now + 1.1
	return true
end

-- Cantar: notas musicais que fazem os inimigos perto dançarem um pouco
function impl.sing(npc: any, _target: any, dist: number, now: number): boolean
	if dist > 30 then
		return false
	end
	mark(npc, "sing")
	local pos = npc.root.Position
	Fx.near(pos, 300, "notes", { p = pos + Vector3.new(0, npc.height or 4, 0), d = 3 })
	for _, a in Actors.near(pos, 22) do
		if a.kind == "npc" and Factions.hostileTo(npc, a) then
			a.calmUntil = os.clock() + 3.5
			a.model:SetAttribute("Dancando", true)
			task.delay(3.5, function()
				if a.model and a.model.Parent and a.behavior ~= "dance" then
					a.model:SetAttribute("Dancando", false)
				end
			end)
		end
	end
	cooldown(npc, "sing", now, 9)
	return false
end

-- "dragão que atira tubarões": lança o elo da cadeia no alvo
function impl.launch(npc: any, target: any, dist: number, now: number): boolean
	if not npc.launchNode or not npc.ctx or dist > 75 or dist < 6 then
		return false
	end
	mark(npc, "bolt")
	face(npc, target.root.Position)
	local from = if npc.mouth then npc.mouth.WorldPosition else npc.root.Position + Vector3.new(0, 2, 0)
	local to = target.root.Position
	local t = math.clamp(dist / 55, 0.35, 1.4)
	Fx.near(from, 400, "launch", { a = from, b = to, t = t, c = elementColor(npc.element) })
	cooldown(npc, "launch", now, 5)
	task.delay(t, function()
		if Actors.alive(npc) then
			local Chains = require(script.Parent.Parent.Core.Chains)
			Chains.spawnNode(npc.ctx, npc.launchNode, CFrame.new(to + Vector3.new(0, 1, 0)))
		end
	end)
	return true
end

-- suporte: cura aliados e jogadores próximos (não precisa de alvo inimigo)
function Abilities.support(npc: any, now: number)
	local attacks = npc.attacks
	if npc.calmAura and ready(npc, "calm", now) then
		for _, a in Actors.near(npc.root.Position, npc.calmAura) do
			if a.kind == "npc" and a.faction == "hostile" then
				a.calmUntil = os.clock() + 3
			end
		end
		npc.cd.calm = now + 1
	end
	if table.find(attacks, "heal") and ready(npc, "heal", now) then
		local healed = 0
		for _, a in Actors.near(npc.root.Position, 28) do
			local friendly = (a.faction == "player" and npc.faction ~= "hostile") or (a.kind == "npc" and not Factions.hostileTo(npc, a) and a ~= npc)
			if friendly and a.humanoid.Health < a.humanoid.MaxHealth then
				Combat.heal(a, 14)
				healed += 1
			end
		end
		if healed > 0 then
			mark(npc, "heal")
			Fx.shockwave(npc.root.Position, 14, Color3.fromRGB(120, 255, 160))
		end
		cooldown(npc, "heal", now, 3.5)
	end
	if table.find(attacks, "gift") and ready(npc, "gift", now) and npc.spawnGift then
		npc.gifts = (npc.gifts or 0)
		if npc.gifts < 4 then
			local nearest, best = nil, 45
			for _, a in Actors.players() do
				local d = (a.root.Position - npc.root.Position).Magnitude
				if d < best then
					nearest, best = a, d
				end
			end
			if nearest then
				npc.gifts += 1
				mark(npc, "gift")
				npc.spawnGift(npc, nearest.root.Position)
			end
		end
		cooldown(npc, "gift", now, 11)
	end
end

-- tenta usar uma habilidade ofensiva; retorna true se deve parar de andar
function Abilities.tryUse(npc: any, target: any, dist: number, now: number): boolean
	for _, name in npc.attacks do
		local f = impl[name]
		if f and ready(npc, name, now) then
			if f(npc, target, dist, now) then
				return true
			end
		end
	end
	return false
end

-- alcance preferido (atiradores mantêm distância)
function Abilities.preferredRange(npc: any): number
	local attacks = npc.attacks
	if table.find(attacks, "melee") or table.find(attacks, "stomp") or table.find(attacks, "charge") then
		return 0
	end
	if table.find(attacks, "breath") then
		return 10 + 8 * npc.scale
	end
	if table.find(attacks, "bolt") or table.find(attacks, "beam") or table.find(attacks, "energy_beam") or table.find(attacks, "laser_eyes") or table.find(attacks, "web") or table.find(attacks, "lightning_call") or table.find(attacks, "launch") then
		return 28
	end
	return 0
end

return Abilities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Brain</string>
            <string name="Source"><![CDATA[--!strict
-- Inteligência dos NPCs. Um único laço no Heartbeat agenda todos os NPCs,
-- cada um "pensa" a cada ~0,3 s (escalonado), o que mantém o custo baixo
-- mesmo com dezenas de criaturas.
-- Terrestres: Humanoid:MoveTo + detecção de travamento + Pathfinding sob demanda.
-- Voadores: AlignPosition/AlignOrientation (física suave replicada pelo servidor).

local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.IdeiasShared.Config)
local Actors = require(script.Parent.Parent.Core.Actors)
local Factions = require(script.Parent.Parent.Core.Factions)
local Abilities = require(script.Parent.Abilities)

local Brain = {}

local list: { any } = {}
local started = false
Brain.freezeUntil = 0 -- "parar o tempo"
Brain.slowUntil = 0 -- "câmera lenta"
local pathBudget = 0 -- cálculos de caminho permitidos neste segundo

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundBelow(pos: Vector3, ignore: { Instance }): number?
	rayParams.FilterDescendantsInstances = ignore
	local r = Workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -300, 0), rayParams)
	return r and r.Position.Y
end

function Brain.add(npc: any)
	npc.nextThink = os.clock() + math.random() * Config.Combat.NpcThinkInterval
	npc.home = npc.home or npc.root.Position
	npc.lastPos = npc.root.Position
	npc.stuck = 0
	npc.wanderAt = 0
	npc.cd = npc.cd or {}
	table.insert(list, npc)
	if npc.flying then
		Brain.setupFlight(npc)
	end
end

function Brain.remove(npc: any)
	local i = table.find(list, npc)
	if i then
		table.remove(list, i)
	end
end

function Brain.count(): number
	return #list
end

function Brain.setupFlight(npc: any)
	local root: BasePart = npc.root
	local att = root:FindFirstChild("VooAtt") :: Attachment?
	if not att then
		att = Instance.new("Attachment")
		att.Name = "VooAtt"
		att.Parent = root
	end
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.MaxForce = 1e7
	ap.MaxVelocity = npc.speed
	ap.Responsiveness = 18
	ap.Position = root.Position
	ap.Parent = root
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 1e7
	ao.Responsiveness = 12
	ao.CFrame = root.CFrame
	ao.Parent = root
	npc.align = ap
	npc.alignOri = ao
	npc.humanoid.PlatformStand = true
	npc.hover = npc.hover or (10 + 6 * npc.scale)
end

local function speedOf(npc: any, now: number): number
	local s = npc.speed
	if npc.chargeUntil and now < npc.chargeUntil then
		s *= 2.4
	end
	if now < Brain.slowUntil and npc.faction ~= "pet" then
		s *= 0.3
	end
	return s
end

local function flyTo(npc: any, target: Vector3, look: Vector3?, now: number)
	local g = groundBelow(target, { npc.model, Workspace:FindFirstChild("IdeiasEventos") :: Instance })
	local y = math.max(target.Y, (g or target.Y) + npc.hover)
	local goal = Vector3.new(target.X, y, target.Z)
	npc.align.Position = goal
	npc.align.MaxVelocity = speedOf(npc, now)
	local pos = npc.root.Position
	local dir = (look or goal) - pos
	dir = Vector3.new(dir.X, dir.Y * 0.3, dir.Z)
	if dir.Magnitude > 1 then
		npc.alignOri.CFrame = CFrame.lookAt(pos, pos + dir.Unit)
	end
end

local function computePath(npc: any, goal: Vector3)
	if pathBudget <= 0 or npc.computing then
		return
	end
	pathBudget -= 1
	npc.computing = true
	task.spawn(function()
		local path = npc.path
		if not path then
			path = PathfindingService:CreatePath({
				AgentRadius = math.clamp(2 * npc.scale, 2, 10),
				AgentHeight = math.clamp(5 * npc.scale, 4, 30),
				AgentCanJump = true,
				WaypointSpacing = 6,
			})
			npc.path = path
		end
		local ok = pcall(function()
			path:ComputeAsync(npc.root.Position, goal)
		end)
		npc.computing = false
		if ok and path.Status == Enum.PathStatus.Success then
			npc.waypoints = path:GetWaypoints()
			npc.wpIndex = 2
			npc.pathUntil = os.clock() + 4
		end
	end)
end

local function walkTo(npc: any, goal: Vector3, now: number)
	local h: Humanoid = npc.humanoid
	h.WalkSpeed = speedOf(npc, now)
	-- seguindo um caminho calculado?
	if npc.waypoints and npc.pathUntil and now < npc.pathUntil then
		local wp = npc.waypoints[npc.wpIndex]
		if wp then
			if (wp.Position - npc.root.Position).Magnitude < 4 then
				npc.wpIndex += 1
				wp = npc.waypoints[npc.wpIndex]
			end
			if wp then
				if wp.Action == Enum.PathWaypointAction.Jump then
					h.Jump = true
				end
				h:MoveTo(wp.Position)
				return
			end
		end
		npc.waypoints = nil
	end
	h:MoveTo(goal)
	-- travado? pula, desvia e pede um caminho
	local moved = (npc.root.Position - npc.lastPos).Magnitude
	npc.lastPos = npc.root.Position
	if moved < 0.6 and (goal - npc.root.Position).Magnitude > 6 then
		npc.stuck += 1
		if npc.stuck == 2 then
			h.Jump = true
		elseif npc.stuck >= 4 then
			npc.stuck = 0
			computePath(npc, goal)
		end
	else
		npc.stuck = 0
	end
end

local function moveTo(npc: any, goal: Vector3, now: number, look: Vector3?)
	if npc.flying then
		flyTo(npc, goal, look, now)
	else
		walkTo(npc, goal, now)
	end
end

local function hold(npc: any, now: number)
	if npc.flying then
		flyTo(npc, npc.root.Position, nil, now)
	else
		npc.humanoid:MoveTo(npc.root.Position)
	end
end

local function pickTarget(npc: any): (any?, number)
	local pos = npc.root.Position
	local range = Config.Combat.TargetRange
	if npc.faction == "neutral" then
		range = 45
	end
	local center = pos
	if npc.guard then
		center = npc.guard.position
		range = npc.guard.radius * 2
	end
	-- mantém o alvo atual se ainda é válido (evita trocar a cada instante)
	local cur = npc.target
	if cur and Actors.alive(cur) and Factions.hostileTo(npc, cur) then
		local d = (cur.root.Position - pos).Magnitude
		if d < range * 1.3 then
			return cur, d
		end
	end
	local best, bestD = nil, math.huge
	for _, a in Actors.near(center, range) do
		if a ~= npc and Factions.hostileTo(npc, a) then
			local d = (a.root.Position - pos).Magnitude
			if d < bestD then
				best, bestD = a, d
			end
		end
	end
	return best, bestD
end

local function threatNear(npc: any): any?
	local pos = npc.root.Position
	for _, a in Actors.near(pos, 34) do
		if a.kind == "npc" and a ~= npc then
			local hunts = a.prey and a.prey[npc.eventId]
			local scary = npc.def and npc.def.tagSet and npc.def.tagSet.prey and a.faction == "hostile"
			if hunts or scary or (npc.fleeFrom and npc.fleeFrom[a.eventId]) then
				return a
			end
		end
	end
	return nil
end

local function think(npc: any, now: number)
	local h: Humanoid = npc.humanoid
	if npc.riding then
		return
	end
	if now < Brain.freezeUntil and npc.faction ~= "pet" then
		hold(npc, now)
		return
	end
	if npc.busyUntil and now < npc.busyUntil then
		return
	end
	if npc.behavior == "dance" then
		npc.model:SetAttribute("Dancando", true)
		hold(npc, now)
		return
	end

	Abilities.support(npc, now)

	local target, dist = pickTarget(npc)
	npc.target = target
	if target then
		local stop = Abilities.tryUse(npc, target, dist, now)
		if stop then
			hold(npc, now)
			return
		end
		local tpos = target.root.Position
		local pref = Abilities.preferredRange(npc)
		if pref > 0 and dist < pref * 0.7 then
			-- atirador: recua mantendo distância
			local away = (npc.root.Position - tpos)
			away = Vector3.new(away.X, 0, away.Z)
			if away.Magnitude > 0.1 then
				moveTo(npc, npc.root.Position + away.Unit * 12, now, tpos)
			end
		elseif pref > 0 and dist < pref then
			hold(npc, now)
			if npc.flying then
				flyTo(npc, npc.root.Position, tpos, now)
			end
		else
			local goal = if npc.flying then tpos + Vector3.new(0, 4 + 2 * npc.scale, 0) else tpos
			moveTo(npc, goal, now, tpos)
		end
		return
	end

	-- presas fogem de predadores
	local threat = threatNear(npc)
	if threat then
		local away = npc.root.Position - threat.root.Position
		away = Vector3.new(away.X, 0, away.Z)
		if away.Magnitude > 0.1 then
			h.WalkSpeed = npc.speed * 1.3
			moveTo(npc, npc.root.Position + away.Unit * 25, now)
			return
		end
	end

	-- seguir o dono (mascotes e aliados)
	local owner: Player? = npc.owner
	if owner and (npc.faction == "pet" or npc.faction == "ally") then
		local oa = Actors.playerActor(owner)
		if Actors.alive(oa) then
			local d = (oa.root.Position - npc.root.Position).Magnitude
			local near = if npc.faction == "pet" then 10 else 22
			if d > near then
				if d > 160 then
					-- ficou muito para trás: teleporta perto do dono
					npc.root.CFrame = oa.root.CFrame * CFrame.new(math.random(-6, 6), 4 + npc.hover * (if npc.flying then 1 else 0), 8)
				else
					moveTo(npc, oa.root.Position, now)
				end
			else
				hold(npc, now)
			end
			return
		end
	end

	-- guarda: patrulha em volta do ponto protegido
	if npc.guard then
		local g = npc.guard
		local ang = now * 0.4 + npc.id
		local r = g.radius * 0.8
		moveTo(npc, g.position + Vector3.new(math.cos(ang) * r, if npc.flying then 12 else 0, math.sin(ang) * r), now)
		return
	end

	-- vagar perto de casa
	if now >= npc.wanderAt then
		npc.wanderAt = now + 3 + math.random() * 4
		local radius = if npc.faction == "hostile" then 30 else 22
		local ang = math.random() * math.pi * 2
		npc.wanderGoal = npc.home + Vector3.new(math.cos(ang) * radius, 0, math.sin(ang) * radius)
	end
	if npc.wanderGoal then
		moveTo(npc, npc.wanderGoal, now)
	end
end

local function step(_dt: number)
	local now = os.clock()
	local interval = Config.Combat.NpcThinkInterval
	for i = #list, 1, -1 do
		local npc = list[i]
		if npc and now >= npc.nextThink then
			npc.nextThink = now + interval * (0.85 + math.random() * 0.3)
			if not Actors.alive(npc) or npc.dead then
				table.remove(list, i)
			else
				local ok, err = pcall(think, npc, now)
				if not ok then
					warn("[Ideias] NPC " .. tostring(npc.def and npc.def.id) .. ": " .. tostring(err))
					npc.nextThink = now + 2
				end
			end
		end
	end
end

function Brain.start()
	if started then
		return
	end
	started = true
	RunService.Heartbeat:Connect(step)
	task.spawn(function()
		while true do
			pathBudget = 4
			task.wait(1)
		end
	end)
end

Brain._think = think

return Brain
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">Builders</string>
          <string name="Source"><![CDATA[--!strict
-- Registro de construtores procedurais por "model" do catálogo.
-- Para adicionar uma nova família de modelos: crie o construtor e registre aqui.

local Figures = require(script.Figures)
local Beasts = require(script.Beasts)
local Monsters = require(script.Monsters)
local Vehicles = require(script.Vehicles)
local Buildings = require(script.Buildings)
local Props = require(script.Props)
local Memes = require(script.Memes)
local Fusion = require(script.Fusion)

local Builders = {}

Builders.Kit = require(script.Kit)
Builders.Rig = require(script.Rig)
Builders.Props = Props
Builders.Buildings = Buildings
Builders.Vehicles = Vehicles
Builders.Figures = Figures

local CREATURES: { [string]: (CFrame, { [string]: any }, string) -> any } = {
	figure = Figures.build,
	quadruped = Beasts.quadruped,
	theropod = Beasts.theropod,
	bird = Beasts.bird,
	fish = Beasts.fish,
	octopus = Beasts.octopus,
	serpent = Beasts.serpent,
	bug = Beasts.bug,
	slime = Beasts.slime,
	dragon = Monsters.dragon,
	ghost = Monsters.ghost,
	robot = Monsters.robot,
	ufo = Monsters.ufo,
	meme = Memes.build,
}

Builders.Creatures = CREATURES

local function plainCreature(origin: CFrame, params: { [string]: any }): any
	local f = CREATURES[params.model] or Figures.build
	return f(origin, params, params.variant or "villager")
end

Builders.Fusion = Fusion

function Builders.creature(origin: CFrame, params: { [string]: any }): any
	local rig = plainCreature(origin, params)
	local fh = params.fusionHead
	if fh then
		local ok, err = pcall(Fusion.ontoRig, rig, fh, params, { creature = plainCreature, prop = Builders.prop })
		if not ok then
			warn("[Ideias] híbrido falhou: " .. tostring(err))
		end
	end
	return rig
end

function Builders.vehicle(origin: CFrame, params: { [string]: any }): any
	local v = Vehicles.build(origin, params, params.variant or "car")
	local fh = params.fusionHead
	if fh and v and v.model then
		local ok, err = pcall(Fusion.ontoVehicle, v.model, fh, params, { creature = plainCreature, prop = Builders.prop })
		if not ok then
			warn("[Ideias] híbrido de veículo falhou: " .. tostring(err))
		end
	end
	return v
end

function Builders.building(origin: CFrame, params: { [string]: any }): any
	return Buildings.build(origin, params, params.variant or "house")
end

function Builders.prop(origin: CFrame, params: { [string]: any }): any
	return Props.build(origin, params, params.model or "prop", params.variant or "crate")
end

-- constrói qualquer conceito "físico" (usado pela chuva de objetos e testes)
function Builders.any(def: any, origin: CFrame, params: { [string]: any }): (Model?, number)
	local h = def.handler
	if h == "npc" then
		local rig = Builders.creature(origin, params)
		return rig.model, rig.height
	elseif h == "vehicle" then
		local v = Builders.vehicle(origin, params)
		return v.model, v.height
	elseif h == "building" then
		local r = Builders.building(origin, params)
		return r.model, r.height
	elseif h == "prop" then
		local r = Builders.prop(origin, params)
		return r.model, r.height
	end
	return nil, 0
end

return Builders
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Beasts</string>
            <string name="Source"><![CDATA[--!strict
-- Animais e bestas procedurais. Cada família tem um construtor parametrizado
-- por espécie (proporções, cores e detalhes), o que dá variedade sem repetir
-- código e mantém cada criatura reconhecível.

local Rig = require(script.Parent.Rig)
local Kit = require(script.Parent.Kit)

local Beasts = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

-- QUADRÚPEDES ------------------------------------------------------------------
type Quad = {
	body: Vector3,
	legH: number,
	legW: number,
	neck: number,
	head: Vector3,
	snout: Vector3?,
	ears: string?,
	tail: string?,
	color: Color3,
	color2: Color3?,
	mat: Enum.Material?,
	extras: { string }?,
	low: boolean?,
}

local QUAD: { [string]: Quad } = {
	dog = { body = V(1.7, 1.5, 3.0), legH = 1.5, legW = 0.55, neck = 0.7, head = V(1.2, 1.1, 1.2), snout = V(0.7, 0.55, 0.8), ears = "flop", tail = "up", color = rgb(205, 150, 85), color2 = rgb(245, 230, 210), extras = { "collar" } },
	cat = { body = V(1.3, 1.2, 2.6), legH = 1.3, legW = 0.4, neck = 0.5, head = V(1.1, 1.0, 1.0), snout = V(0.5, 0.35, 0.3), ears = "point", tail = "thin_up", color = rgb(240, 150, 60), color2 = rgb(250, 240, 230), extras = { "whiskers", "stripes_thin" } },
	wolf = { body = V(1.7, 1.6, 3.4), legH = 1.8, legW = 0.55, neck = 0.8, head = V(1.2, 1.1, 1.2), snout = V(0.6, 0.55, 1.0), ears = "point", tail = "bushy", color = rgb(120, 120, 130), color2 = rgb(210, 210, 215) },
	lion = { body = V(2.0, 1.9, 3.8), legH = 2.0, legW = 0.7, neck = 0.6, head = V(1.5, 1.4, 1.4), snout = V(0.8, 0.6, 0.7), ears = "round", tail = "tuft", color = rgb(220, 170, 90), color2 = rgb(240, 210, 150), extras = { "mane" } },
	tiger = { body = V(2.0, 1.8, 3.9), legH = 1.9, legW = 0.7, neck = 0.6, head = V(1.4, 1.3, 1.3), snout = V(0.8, 0.55, 0.6), ears = "round", tail = "thin", color = rgb(240, 130, 40), color2 = rgb(250, 245, 235), extras = { "stripes" } },
	jaguar = { body = V(1.8, 1.6, 3.6), legH = 1.7, legW = 0.6, neck = 0.5, head = V(1.3, 1.2, 1.2), snout = V(0.7, 0.5, 0.5), ears = "round", tail = "thin", color = rgb(235, 185, 80), color2 = rgb(250, 240, 220), extras = { "spots" } },
	bear = { body = V(2.6, 2.4, 3.6), legH = 1.6, legW = 0.95, neck = 0.4, head = V(1.6, 1.5, 1.5), snout = V(0.8, 0.6, 0.6), ears = "round", tail = "stub", color = rgb(110, 70, 40), color2 = rgb(150, 110, 70), mat = Enum.Material.Fabric },
	panda = { body = V(2.4, 2.3, 3.2), legH = 1.4, legW = 0.95, neck = 0.3, head = V(1.6, 1.5, 1.4), snout = V(0.6, 0.45, 0.4), ears = "round_black", tail = "stub", color = rgb(245, 245, 245), color2 = rgb(25, 25, 28), mat = Enum.Material.Fabric, extras = { "panda" } },
	cow = { body = V(2.4, 2.2, 4.0), legH = 2.0, legW = 0.7, neck = 0.6, head = V(1.3, 1.3, 1.5), snout = V(1.1, 0.7, 0.5), ears = "side", tail = "tuft", color = rgb(245, 245, 245), color2 = rgb(30, 30, 30), extras = { "cow_spots", "horns_small", "udder" } },
	pig = { body = V(2.0, 1.7, 3.0), legH = 1.0, legW = 0.6, neck = 0.2, head = V(1.3, 1.2, 1.1), snout = V(0.7, 0.6, 0.35), ears = "point", tail = "curl", color = rgb(250, 170, 180), color2 = rgb(240, 140, 155) },
	sheep = { body = V(2.0, 1.8, 2.8), legH = 1.3, legW = 0.45, neck = 0.4, head = V(0.9, 1.1, 1.2), snout = V(0.6, 0.6, 0.4), ears = "side", tail = "stub", color = rgb(245, 245, 240), color2 = rgb(40, 40, 45), extras = { "wool" } },
	horse = { body = V(1.9, 2.0, 4.0), legH = 2.8, legW = 0.6, neck = 1.6, head = V(0.9, 1.0, 2.0), snout = V(0.8, 0.8, 0.6), ears = "point", tail = "long", color = rgb(140, 90, 55), color2 = rgb(50, 35, 25), extras = { "mane_strip" } },
	unicorn = { body = V(1.9, 2.0, 4.0), legH = 2.8, legW = 0.6, neck = 1.6, head = V(0.9, 1.0, 2.0), snout = V(0.8, 0.8, 0.6), ears = "point", tail = "rainbow", color = rgb(250, 248, 255), color2 = rgb(255, 160, 220), extras = { "mane_rainbow", "horn_unicorn" } },
	headless_mule = { body = V(1.8, 1.9, 3.8), legH = 2.6, legW = 0.6, neck = 1.2, head = V(0, 0, 0), ears = nil, tail = "long", color = rgb(70, 50, 40), color2 = rgb(30, 25, 20), extras = { "headless_fire" } },
	elephant = { body = V(3.4, 3.2, 4.6), legH = 2.6, legW = 1.2, neck = 0.3, head = V(2.2, 2.2, 1.8), snout = nil, ears = "elephant", tail = "thin", color = rgb(140, 140, 150), color2 = rgb(120, 120, 130), extras = { "trunk", "tusks" } },
	giraffe = { body = V(1.9, 2.0, 3.4), legH = 4.0, legW = 0.5, neck = 5.0, head = V(0.8, 0.9, 1.6), snout = V(0.6, 0.6, 0.5), ears = "point", tail = "tuft", color = rgb(240, 200, 100), color2 = rgb(150, 90, 40), extras = { "giraffe_spots", "ossicones" } },
	rhino = { body = V(2.8, 2.5, 4.4), legH = 1.7, legW = 1.0, neck = 0.3, head = V(1.5, 1.5, 2.0), snout = V(1.2, 1.0, 0.6), ears = "point", tail = "thin", color = rgb(130, 130, 135), color2 = rgb(110, 110, 115), extras = { "rhino_horn", "armor_plates" } },
	deer = { body = V(1.5, 1.6, 3.0), legH = 2.3, legW = 0.4, neck = 1.2, head = V(0.8, 0.9, 1.3), snout = V(0.5, 0.5, 0.4), ears = "side", tail = "stub", color = rgb(170, 110, 60), color2 = rgb(240, 230, 210), extras = { "antlers", "fawn_spots" } },
	fox = { body = V(1.3, 1.2, 2.6), legH = 1.2, legW = 0.4, neck = 0.5, head = V(1.0, 0.9, 1.0), snout = V(0.45, 0.4, 0.8), ears = "point_big", tail = "fox", color = rgb(235, 110, 40), color2 = rgb(250, 245, 240) },
	rabbit = { body = V(1.2, 1.2, 1.7), legH = 0.6, legW = 0.4, neck = 0.2, head = V(1.0, 1.0, 1.0), snout = V(0.4, 0.3, 0.2), ears = "bunny", tail = "cotton", color = rgb(230, 225, 220), color2 = rgb(255, 255, 255) },
	mouse = { body = V(1.0, 0.9, 1.6), legH = 0.4, legW = 0.25, neck = 0.1, head = V(0.8, 0.7, 0.9), snout = V(0.3, 0.3, 0.4), ears = "mouse", tail = "thin_long", color = rgb(160, 160, 165), color2 = rgb(255, 190, 200) },
	capybara = { body = V(2.0, 1.8, 3.0), legH = 0.9, legW = 0.6, neck = 0.3, head = V(1.3, 1.3, 1.7), snout = V(1.1, 0.9, 0.5), ears = "tiny", tail = "none", color = rgb(150, 105, 65), color2 = rgb(120, 85, 50), mat = Enum.Material.Fabric },
	sloth = { body = V(1.6, 1.8, 2.2), legH = 1.4, legW = 0.4, neck = 0.3, head = V(1.1, 1.0, 1.0), snout = V(0.5, 0.4, 0.3), ears = "none", tail = "stub", color = rgb(150, 125, 95), color2 = rgb(220, 200, 170), mat = Enum.Material.Fabric, extras = { "sloth_mask", "claws_long" } },
	crocodile = { body = V(1.9, 1.0, 4.2), legH = 0.7, legW = 0.5, neck = 0.1, head = V(1.2, 0.8, 1.2), snout = V(0.9, 0.5, 2.0), ears = "none", tail = "croc", color = rgb(70, 110, 60), color2 = rgb(170, 180, 120), low = true, extras = { "croc_teeth", "back_ridges" } },
	lizard = { body = V(1.0, 0.6, 2.0), legH = 0.4, legW = 0.25, neck = 0.1, head = V(0.7, 0.5, 0.8), snout = V(0.5, 0.35, 0.4), ears = "none", tail = "croc", color = rgb(90, 200, 90), color2 = rgb(220, 230, 120), low = true },
	turtle = { body = V(2.0, 1.0, 2.4), legH = 0.6, legW = 0.5, neck = 0.6, head = V(0.7, 0.6, 0.8), snout = nil, ears = "none", tail = "stub", color = rgb(120, 160, 90), color2 = rgb(110, 80, 50), low = true, extras = { "shell" } },
	frog = { body = V(1.4, 0.9, 1.4), legH = 0.4, legW = 0.4, neck = 0, head = V(1.3, 0.7, 0.9), snout = nil, ears = "none", tail = "none", color = rgb(90, 190, 70), color2 = rgb(230, 240, 150), extras = { "frog_eyes" } },
	monkey = { body = V(1.4, 1.7, 1.8), legH = 1.4, legW = 0.4, neck = 0.3, head = V(1.1, 1.1, 1.0), snout = V(0.8, 0.6, 0.4), ears = "monkey", tail = "curl_long", color = rgb(120, 80, 50), color2 = rgb(230, 200, 160), mat = Enum.Material.Fabric },
	triceratops = { body = V(3.0, 2.8, 5.0), legH = 2.0, legW = 1.1, neck = 0.3, head = V(1.8, 1.6, 2.2), snout = V(1.0, 0.9, 0.8), ears = "none", tail = "dino", color = rgb(110, 140, 90), color2 = rgb(200, 180, 120), extras = { "frill", "tri_horns" } },
	stegosaurus = { body = V(2.8, 2.6, 5.4), legH = 2.0, legW = 1.0, neck = 0.6, head = V(0.9, 0.8, 1.4), snout = nil, ears = "none", tail = "spiked", color = rgb(120, 140, 110), color2 = rgb(200, 120, 70), extras = { "back_plates" } },
	brachiosaurus = { body = V(3.6, 3.4, 6.0), legH = 4.2, legW = 1.3, neck = 9.0, head = V(1.1, 1.0, 1.8), snout = nil, ears = "none", tail = "dino", color = rgb(120, 150, 160), color2 = rgb(190, 200, 190) },
}

local function quadruped(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local q = QUAD[variant] or QUAD.dog
	local ex = {}
	for _, e in q.extras or {} do
		ex[e] = true
	end
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local mat = q.mat or Enum.Material.SmoothPlastic
	local c1, c2 = q.color, q.color2 or Kit.lighter(q.color, 0.4)
	local body = q.body
	local legH = q.legH
	local bodyY = legH + body.Y / 2 - (if q.low then 0.2 else 0)
	local root = R:makeRoot(V(body.X, body.Y, body.Z), bodyY)

	local torso = b:blob(body, CF(0, bodyY, 0), c1, { role = "primary", material = mat, name = "Corpo" })
	R:weld(R:since(0), root)
	if ex.cow_spots or ex.giraffe_spots or ex.spots or ex.fawn_spots then
		local col = c2
		for k = 1, 7 do
			local ang = k * 2.39
			local p = V(math.cos(ang) * body.X * 0.48, bodyY + math.sin(k * 1.3) * body.Y * 0.25, (k / 7 - 0.5) * body.Z * 0.8)
			local d = if ex.cow_spots then 0.9 else 0.45
			local spot = b:ball(d, CF(p), col, { role = "secondary" })
			R:join(spot, torso)
		end
	end
	if ex.stripes or ex.stripes_thin then
		local stripeCol = if ex.stripes then rgb(25, 20, 20) else Kit.darker(c1, 0.35)
		for k = -3, 3 do
			local s = b:box(V(body.X * 1.03, body.Y * 0.45, if ex.stripes then 0.2 else 0.12), CF(0, bodyY + body.Y * 0.28, k * body.Z * 0.12), stripeCol, { role = "secondary" })
			R:join(s, torso)
		end
	end
	if ex.wool then
		for k = 0, 9 do
			local ang = k * 2.4
			local w = b:ball(1.1, CF(math.cos(ang) * body.X * 0.4, bodyY + 0.3 + math.sin(k) * 0.3, (k / 9 - 0.5) * body.Z * 0.8), c1, { role = "primary", material = Enum.Material.Fabric })
			R:join(w, torso)
		end
	end
	if ex.shell then
		local s = b:part("ball", V(body.X * 1.25, body.Y * 1.5, body.Z * 1.15), CF(0, bodyY + body.Y * 0.35, 0), c2, { role = "secondary", material = Enum.Material.Slate })
		R:join(s, torso)
	end
	if ex.back_plates or ex.back_ridges then
		local n = if ex.back_plates then 7 else 6
		for k = 1, n do
			local z = (k / (n + 1) - 0.5) * body.Z
			local h = if ex.back_plates then 1.2 + math.sin(k / n * math.pi) * 0.8 else 0.4
			local plate = b:part("wedge", V(0.25, h, h), CF(0, bodyY + body.Y / 2 + h / 2 - 0.1, z), c2, { role = "accent" })
			R:join(plate, torso)
		end
	end
	if ex.udder then
		local u = b:ball(0.7, CF(0, legH + 0.1, body.Z * 0.25), rgb(255, 170, 180), { role = "fixed" })
		R:join(u, torso)
	end
	if ex.armor_plates then
		for _, z in { -0.8, 0.8 } do
			local a = b:box(V(body.X * 1.03, 0.15, 0.6), CF(0, bodyY + 0.2, z), Kit.darker(c1, 0.15), { role = "secondary" })
			R:join(a, torso)
		end
	end
	if ex.collar then
		local col = b:part("cyl", V(0.3, 1.3, 1.3), CF(0, bodyY + body.Y * 0.3, -body.Z / 2 + 0.1) * ANG(0, rad(90), 0), rgb(220, 40, 50), { role = "accent" })
		R:join(col, torso)
	end

	-- pernas
	local lx = body.X / 2 - q.legW / 2
	local lz = body.Z / 2 - q.legW * 0.8
	local legs = { { -lx, -lz, 0 }, { lx, -lz, math.pi }, { -lx, lz, math.pi }, { lx, lz, 0 } }
	for _, l in legs do
		local m = R:mark()
		local x, z, ph = l[1], l[2], l[3]
		local legCol = if variant == "panda" or variant == "sheep" then c2 else c1
		b:box(V(q.legW, legH, q.legW), CF(x, legH / 2, z), legCol, { role = "primary", material = mat })
		b:box(V(q.legW * 1.1, 0.25, q.legW * 1.2), CF(x, 0.12, z - 0.05), Kit.darker(legCol, 0.35), { role = "secondary" })
		if ex.claws_long then
			b:part("wedge", V(0.2, 0.4, 0.5), CF(x, 0.3, z - 0.45), rgb(240, 235, 220), { role = "fixed" })
		end
		R:group(m, torso, V(x, legH, z), { kind = "leg", axis = "X", amp = if q.low then 0.4 else 0.6, phase = ph })
	end

	-- pescoço + cabeça
	local neckBase = V(0, bodyY + body.Y * 0.25, -body.Z / 2 + 0.3)
	local tall = variant == "giraffe" or variant == "brachiosaurus" or variant == "horse" or variant == "unicorn" or variant == "deer" or variant == "headless_mule"
	local neckDir = if tall then V(0, 0.85, -0.5).Unit else V(0, 0.35, -1).Unit
	local headPos = neckBase + neckDir * (q.neck + q.head.Z * 0.3)
	if q.low then
		headPos = V(0, bodyY, -body.Z / 2 - q.head.Z / 2 + 0.2)
	end
	local hm = R:mark()
	local headPart: BasePart
	if variant == "headless_mule" then
		headPart = b:part("cyl", V(q.neck, 0.9, 0.9), CF((neckBase + headPos) / 2) * CFrame.lookAt(V(), neckDir).Rotation * ANG(0, rad(90), 0), c1, { role = "primary" })
		local fire = Instance.new("Fire")
		fire.Size = 6
		fire.Heat = 12
		fire.Color = rgb(255, 120, 30)
		fire.SecondaryColor = rgb(255, 220, 80)
		fire.Parent = headPart
	else
		if q.neck > 0.3 then
			b:beam(neckBase, headPos, math.min(q.head.X, 1.1) * 0.75, c1, { role = "primary", material = mat })
			if variant == "giraffe" then
				for k = 1, 4 do
					b:ball(0.4, CF(neckBase:Lerp(headPos, k / 5) + V(0.3, 0, 0)), c2, { role = "secondary" })
				end
			end
		end
		headPart = b:box(q.head, CF(headPos), if variant == "panda" then c1 else c1, { role = "primary", material = mat, name = "Cabeca" })
		local front = headPos.Z - q.head.Z / 2
		local snoutPos = V(0, headPos.Y - q.head.Y * 0.15, front)
		if q.snout then
			local sn = q.snout
			snoutPos = V(0, headPos.Y - q.head.Y * 0.2, front - sn.Z / 2 + 0.05)
			b:box(sn, CF(snoutPos), if variant == "pig" or variant == "cow" then c2 else Kit.lighter(c1, 0.15), { role = "secondary", material = mat })
			b:box(V(sn.X * 0.5, sn.Y * 0.35, 0.1), CF(0, snoutPos.Y + sn.Y * 0.2, snoutPos.Z - sn.Z / 2), rgb(30, 25, 25), { role = "fixed", name = "Nariz" })
		end
		-- olhos
		for _, side in { -1, 1 } do
			local eyeX = side * q.head.X * 0.32
			if ex.frog_eyes then
				b:ball(0.55, CF(side * 0.45, headPos.Y + 0.4, front + 0.2), rgb(240, 240, 220), { role = "fixed" })
				b:ball(0.28, CF(side * 0.45, headPos.Y + 0.45, front - 0.02), rgb(15, 15, 15), { role = "eye" })
			else
				if variant == "panda" then
					b:part("ball", V(0.45, 0.5, 0.2), CF(eyeX, headPos.Y + 0.1, front + 0.02), c2, { role = "fixed" })
				end
				b:box(V(0.18, 0.2, 0.08), CF(eyeX, headPos.Y + q.head.Y * 0.15, front - 0.03), if variant == "panda" then rgb(240, 240, 240) else rgb(20, 20, 25), { role = "eye" })
			end
		end
		-- orelhas
		local ears = q.ears
		local earY = headPos.Y + q.head.Y / 2
		for _, side in { -1, 1 } do
			local ex2 = side * q.head.X * 0.32
			local earCol = if ears == "round_black" then c2 else c1
			if ears == "point" or ears == "point_big" then
				local s = if ears == "point_big" then 1.4 else 1
				b:part("wedge", V(0.2, 0.55 * s, 0.4 * s), CF(ex2, earY + 0.25 * s, headPos.Z + 0.1), earCol, { role = "primary" })
			elseif ears == "round" or ears == "round_black" or ears == "mouse" or ears == "monkey" then
				local d = if ears == "mouse" then 0.6 else 0.45
				b:part("cyl", V(0.15, d, d), CF(ex2 * (if ears == "monkey" then 1.5 else 1), if ears == "monkey" then headPos.Y else earY + 0.1, headPos.Z) * ANG(0, rad(90), 0), earCol, { role = "secondary" })
			elseif ears == "flop" or ears == "side" then
				b:box(V(0.2, 0.7, 0.45), CF(side * (q.head.X / 2 + 0.1), headPos.Y + 0.05, headPos.Z) * ANG(0, 0, side * rad(25)), Kit.darker(c1, 0.25), { role = "secondary" })
			elseif ears == "bunny" then
				b:box(V(0.22, 1.4, 0.35), CF(side * 0.22, earY + 0.65, headPos.Z + 0.1) * ANG(rad(-10), 0, side * rad(8)), c1, { role = "primary" })
			elseif ears == "elephant" then
				b:box(V(0.15, 2.0, 1.8), CF(side * (q.head.X / 2 + 0.3), headPos.Y, headPos.Z + 0.4) * ANG(0, side * rad(25), 0), c2, { role = "secondary" })
			elseif ears == "tiny" then
				b:ball(0.3, CF(ex2, earY + 0.05, headPos.Z + 0.3), Kit.darker(c1, 0.2), { role = "secondary" })
			end
		end
		if ex.mane then
			b:ball(q.head.X * 1.7, CF(headPos + V(0, 0.1, 0.35)), rgb(140, 80, 30), { role = "secondary", material = Enum.Material.Fabric })
		end
		if ex.horns_small then
			for _, side in { -1, 1 } do
				b:part("wedge", V(0.15, 0.45, 0.25), CF(side * q.head.X * 0.45, earY + 0.15, headPos.Z + 0.1), rgb(240, 230, 210), { role = "fixed" })
			end
		end
		if ex.horn_unicorn then
			b:cone(1.4, 0.35, CF(0, earY - 0.05, front + 0.3) * ANG(rad(-35), 0, 0), rgb(255, 215, 80), 3, { role = "fixed", material = Enum.Material.Neon })
		end
		if ex.antlers then
			for _, side in { -1, 1 } do
				local base = V(side * 0.3, earY, headPos.Z + 0.2)
				local tip = base + V(side * 0.8, 1.4, 0.3)
				b:beam(base, tip, 0.15, rgb(200, 180, 140), { role = "fixed" })
				b:beam(base:Lerp(tip, 0.5), base:Lerp(tip, 0.5) + V(side * 0.1, 0.6, -0.4), 0.12, rgb(200, 180, 140), { role = "fixed" })
			end
		end
		if ex.ossicones then
			for _, side in { -1, 1 } do
				b:beam(V(side * 0.2, earY, headPos.Z + 0.3), V(side * 0.25, earY + 0.6, headPos.Z + 0.35), 0.15, c2, { role = "fixed" })
			end
		end
		if ex.trunk then
			local base = V(0, headPos.Y - 0.3, front)
			for k = 1, 4 do
				local seg = base + V(0, -k * 0.55, -0.15 * k)
				b:ball(0.75 - k * 0.08, CF(seg), c1, { role = "primary" })
			end
		end
		if ex.tusks then
			for _, side in { -1, 1 } do
				b:beam(V(side * 0.5, headPos.Y - 0.6, front), V(side * 0.6, headPos.Y - 0.9, front - 1.2), 0.22, rgb(250, 245, 230), { role = "fixed" }, true)
			end
		end
		if ex.rhino_horn and q.snout then
			b:cone(1.2, 0.6, CF(0, snoutPos.Y + q.snout.Y / 2, snoutPos.Z) * ANG(rad(-15), 0, 0), rgb(200, 195, 185), 3, { role = "fixed" })
		end
		if ex.frill then
			b:part("cyl", V(0.3, 3.0, 3.0), CF(0, headPos.Y + 0.5, headPos.Z + q.head.Z / 2) * ANG(rad(20), rad(90), 0), c2, { role = "secondary" })
		end
		if ex.tri_horns then
			for _, side in { -1, 1 } do
				b:cone(1.5, 0.35, CF(side * 0.45, headPos.Y + 0.5, front + 0.3) * ANG(rad(-60), 0, 0), rgb(240, 235, 220), 3, { role = "fixed" })
			end
			if q.snout then
				b:cone(0.7, 0.35, CF(0, snoutPos.Y + q.snout.Y / 2, snoutPos.Z) * ANG(rad(-30), 0, 0), rgb(240, 235, 220), 2, { role = "fixed" })
			end
		end
		if ex.croc_teeth and q.snout then
			for k = 0, 5 do
				for _, side in { -1, 1 } do
					b:part("wedge", V(0.08, 0.2, 0.12), CF(side * q.snout.X * 0.45, snoutPos.Y - q.snout.Y / 2 - 0.05, snoutPos.Z - q.snout.Z / 2 + 0.25 + k * 0.3) * ANG(rad(180), 0, 0), rgb(250, 250, 240), { role = "fixed" })
				end
			end
		end
		if ex.whiskers and q.snout then
			for _, side in { -1, 1 } do
				b:box(V(0.9, 0.04, 0.04), CF(side * 0.45, snoutPos.Y, snoutPos.Z), rgb(250, 250, 250), { role = "fixed" })
			end
		end
		if ex.sloth_mask then
			b:box(V(q.head.X * 0.8, q.head.Y * 0.5, 0.06), CF(0, headPos.Y + 0.05, front - 0.01), c2, { role = "fixed" })
		end
		if ex.mane_strip or ex.mane_rainbow then
			for k = 0, 5 do
				local p = neckBase:Lerp(headPos, k / 6) + V(0, 0.45, 0.2)
				local col = if ex.mane_rainbow then Kit.RainbowColors[(k % #Kit.RainbowColors) + 1] else c2
				b:box(V(0.25, 0.6, 0.45), CF(p), col, { role = if ex.mane_rainbow then "fixed" else "secondary", material = if ex.mane_rainbow then Enum.Material.Neon else mat })
			end
		end
		R.head = headPart
	end
	R:group(hm, torso, neckBase, { kind = "head", axis = "X", amp = 0.12, speed = 0.6 })
	if R.head then
		R:setMouth(R.head, V(0, -0.2, -(q.head.Z / 2 + (q.snout and q.snout.Z or 0))))
	end

	-- cauda
	local tailBase = V(0, bodyY + body.Y * 0.2, body.Z / 2)
	local tail = q.tail
	if tail and tail ~= "none" then
		local tm = R:mark()
		local tcol = if tail == "fox" then c1 else c1
		if tail == "up" or tail == "thin_up" then
			b:beam(tailBase, tailBase + V(0, 1.2, 0.8), if tail == "up" then 0.35 else 0.2, tcol, { role = "primary" })
		elseif tail == "thin" or tail == "tuft" or tail == "thin_long" then
			local len = if tail == "thin_long" then 2.2 else 1.6
			b:beam(tailBase, tailBase + V(0, -0.6, len), 0.2, tcol, { role = "primary" })
			if tail == "tuft" then
				b:ball(0.5, CF(tailBase + V(0, -0.65, len)), rgb(60, 40, 25), { role = "secondary" })
			end
		elseif tail == "bushy" or tail == "fox" then
			b:part("ball", V(0.8, 0.8, 2.0), CF(tailBase + V(0, -0.2, 1.0)) * ANG(rad(-20), 0, 0), tcol, { role = "primary", material = Enum.Material.Fabric })
			if tail == "fox" then
				b:ball(0.6, CF(tailBase + V(0, -0.45, 1.9)), rgb(250, 250, 250), { role = "fixed" })
			end
		elseif tail == "curl" then
			b:part("cyl", V(0.15, 0.5, 0.5), CF(tailBase + V(0, 0.2, 0.25)) * ANG(0, 0, 0), tcol, { role = "primary" })
		elseif tail == "curl_long" then
			b:beam(tailBase, tailBase + V(0, 1.6, 1.0), 0.18, tcol, { role = "primary" })
			b:beam(tailBase + V(0, 1.6, 1.0), tailBase + V(0, 2.0, 0.6), 0.18, tcol, { role = "primary" })
		elseif tail == "stub" then
			b:ball(0.5, CF(tailBase), tcol, { role = "primary" })
		elseif tail == "cotton" then
			b:ball(0.55, CF(tailBase), rgb(255, 255, 255), { role = "fixed" })
		elseif tail == "long" or tail == "rainbow" then
			for k = 0, 3 do
				local col = if tail == "rainbow" then Kit.RainbowColors[k + 1] else q.color2 or c1
				b:box(V(0.35, 2.4, 0.3), CF(tailBase + V((k - 1.5) * 0.12, -1.1, 0.4)) * ANG(rad(15), 0, 0), col, { role = "fixed", material = if tail == "rainbow" then Enum.Material.Neon else mat })
			end
		elseif tail == "croc" or tail == "dino" or tail == "spiked" then
			local len = if tail == "croc" then body.Z * 0.9 else body.Z * 0.8
			local th = if tail == "croc" then body.Y * 0.6 else body.Y * 0.55
			b:part("wedge", V(th, th, len), CF(tailBase + V(0, -th * 0.3, len / 2)) * ANG(0, rad(180), 0), c1, { role = "primary" })
			if tail == "spiked" then
				for _, side in { -1, 1 } do
					b:cone(1.0, 0.3, CF(tailBase + V(side * 0.3, 0, len * 0.85)) * ANG(0, 0, side * rad(-70)), rgb(230, 220, 200), 2, { role = "fixed" })
				end
			end
		end
		R:group(tm, torso, tailBase, { kind = "tail", axis = "Y", amp = if tail == "croc" or tail == "dino" then 0.25 else 0.45, speed = 1.2 })
	end

	local height = math.max(bodyY + body.Y / 2, headPos.Y + q.head.Y / 2)
	return R:finish({ hp = params.hp or 100, speed = params.speed or 16, hipHeight = legH - body.Y * 0 , height = height, radius = math.max(body.X, body.Z) / 2 })
end

-- DINOSSAUROS BÍPEDES -------------------------------------------------------------
local THERO = {
	trex = { s = 1.6, color = rgb(90, 120, 70), color2 = rgb(190, 170, 110), arms = 0.5, spikes = false },
	raptor = { s = 0.75, color = rgb(160, 120, 70), color2 = rgb(230, 200, 150), arms = 0.9, spikes = false, stripe = rgb(120, 60, 40) },
	kaiju = { s = 2.0, color = rgb(60, 70, 75), color2 = rgb(90, 100, 105), arms = 1.0, spikes = true },
}

local function theropod(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local t = THERO[variant] or THERO.trex
	local p2 = table.clone(params)
	p2.size = (params.size or 1) * t.s
	local R = Rig.new(variant, origin, p2)
	local b = R.b
	local c1, c2 = t.color, t.color2
	local legH = 3.2
	local bodyY = legH + 1.2
	local root = R:makeRoot(V(2.4, 2.4, 3.6), bodyY)
	local torso = b:part("ball", V(2.6, 2.6, 4.2), CF(0, bodyY, 0) * ANG(rad(-12), 0, 0), c1, { role = "primary", name = "Corpo" })
	R:join(torso, root)
	local belly = b:part("ball", V(2.0, 1.8, 3.4), CF(0, bodyY - 0.5, -0.3), c2, { role = "secondary" })
	R:join(belly, torso)
	if t.stripe then
		for k = -1, 1 do
			local s = b:box(V(2.65, 0.5, 0.3), CF(0, bodyY + 0.6, k * 0.9), t.stripe, { role = "fixed" })
			R:join(s, torso)
		end
	end
	-- pernas fortes
	for _, side in { -1, 1 } do
		local m = R:mark()
		b:part("ball", V(1.3, 2.2, 1.6), CF(side * 1.1, legH + 0.2, 0.4), c1, { role = "primary" })
		b:box(V(0.7, legH - 0.6, 0.7), CF(side * 1.15, legH / 2 - 0.2, 0.7) * ANG(rad(-10), 0, 0), c1, { role = "primary" })
		b:box(V(1.0, 0.4, 1.8), CF(side * 1.15, 0.2, 0.3), Kit.darker(c1, 0.3), { role = "secondary" })
		for k = -1, 1 do
			b:part("wedge", V(0.2, 0.3, 0.4), CF(side * 1.15 + k * 0.3, 0.2, -0.8), rgb(240, 235, 220), { role = "fixed" })
		end
		R:group(m, torso, V(side * 1.1, legH + 0.6, 0.4), { kind = "leg", axis = "X", amp = 0.55, phase = if side < 0 then 0 else math.pi })
	end
	-- bracinhos
	for _, side in { -1, 1 } do
		local m = R:mark()
		b:beam(V(side * 0.9, bodyY - 0.2, -1.6), V(side * 1.0, bodyY - 1.0 * t.arms, -2.2), 0.35, c1, { role = "primary" })
		R:group(m, torso, V(side * 0.9, bodyY - 0.2, -1.6), { kind = "arm", axis = "X", amp = 0.3 })
	end
	-- cabeça com mandíbula
	local headPos = V(0, bodyY + 1.6, -3.0)
	local hm = R:mark()
	local head = b:box(V(1.8, 1.1, 2.6), CF(headPos + V(0, -0.15, 0)), c1, { role = "primary", name = "Cabeca" })
	b:part("wedge", V(1.8, 0.7, 1.6), CF(headPos + V(0, 0.75, 0.5)), c1, { role = "primary" })
	b:box(V(1.4, 0.5, 1.0), CF(headPos + V(0, 0.55, -0.8)), c1, { role = "primary" })
	b:box(V(1.2, 1.0, 1.4), CF(headPos + V(0, -0.6, 0.6)), c1, { role = "primary" })
	for _, side in { -1, 1 } do
		b:box(V(0.25, 0.25, 0.1), CF(headPos + V(side * 0.7, 0.35, -0.6)), rgb(250, 200, 40), { role = "eye", material = Enum.Material.Neon })
		b:box(V(0.3, 0.15, 0.6), CF(headPos + V(side * 0.6, 0.55, -0.5)), Kit.darker(c1, 0.2), { role = "secondary" })
	end
	for k = 0, 4 do
		for _, side in { -1, 1 } do
			b:part("wedge", V(0.12, 0.3, 0.18), CF(headPos + V(side * 0.75, -0.8, -1.2 + k * 0.4)) * ANG(rad(180), 0, 0), rgb(250, 250, 240), { role = "fixed" })
		end
	end
	R.head = head
	local headBase = R:group(hm, torso, V(0, bodyY + 0.9, -1.8), { kind = "head", axis = "Y", amp = 0.2, speed = 0.5 })
	local jm = R:mark()
	b:box(V(1.6, 0.45, 2.2), CF(headPos + V(0, -0.95, -0.25)), c2, { role = "secondary", name = "Mandibula" })
	R:group(jm, headBase or torso, headPos + V(0, -0.8, 1.0), { kind = "jaw", axis = "X", amp = 0.35, speed = 0.5 })
	R:setMouth(head, V(0, -0.6, -1.6))
	if t.spikes then
		for k = 0, 6 do
			local sp = b:part("wedge", V(0.3, 1.2 - k * 0.1, 1.0), CF(0, bodyY + 1.4 - k * 0.15, -1.2 + k * 0.8), rgb(110, 200, 255), { role = "accent", material = Enum.Material.Neon })
			R:join(sp, torso)
		end
	end
	-- cauda em segmentos
	local prev = torso
	local base = V(0, bodyY + 0.2, 1.8)
	for k = 1, 4 do
		local m = R:mark()
		local th = 1.6 - k * 0.3
		local pos = base + V(0, -k * 0.15, k * 1.3)
		b:part("ball", V(th, th, 1.8), CF(pos), c1, { role = "primary" })
		prev = R:group(m, prev, pos - V(0, 0, 0.8), { kind = "tail", axis = "Y", amp = 0.18, phase = k * 0.6, speed = 0.8 }) or prev
	end
	return R:finish({ hp = params.hp or 600, speed = params.speed or 18, hipHeight = legH, height = headPos.Y + 0.8, radius = 2.2 })
end

-- AVES -------------------------------------------------------------------------
local BIRDS = {
	bird = { body = V(1.0, 1.0, 1.6), color = rgb(140, 100, 70), color2 = rgb(230, 200, 160), beak = rgb(240, 180, 50), wing = 2.4, legs = false },
	eagle = { body = V(1.4, 1.4, 2.4), color = rgb(100, 70, 40), color2 = rgb(250, 250, 250), beak = rgb(250, 200, 40), wing = 4.4, headColor = rgb(250, 250, 250) },
	parrot = { body = V(1.0, 1.2, 1.6), color = rgb(220, 40, 40), color2 = rgb(40, 120, 230), beak = rgb(240, 230, 210), wing = 2.6, wingColor = rgb(40, 120, 230), tailColor = rgb(250, 210, 40) },
	toucan = { body = V(1.1, 1.3, 1.6), color = rgb(25, 25, 30), color2 = rgb(250, 250, 240), beak = rgb(255, 140, 20), wing = 2.4, bigBeak = true },
	owl = { body = V(1.4, 1.6, 1.4), color = rgb(150, 110, 70), color2 = rgb(230, 210, 170), beak = rgb(240, 200, 60), wing = 2.6, owl = true },
	chicken = { body = V(1.3, 1.3, 1.8), color = rgb(250, 250, 245), color2 = rgb(240, 240, 235), beak = rgb(250, 180, 40), wing = 1.2, legs = true, comb = true },
	duck = { body = V(1.3, 1.1, 2.0), color = rgb(250, 250, 250), color2 = rgb(240, 240, 240), beak = rgb(255, 150, 30), wing = 1.4, legs = true, flatBeak = true },
	penguin = { body = V(1.4, 2.2, 1.3), color = rgb(25, 25, 30), color2 = rgb(250, 250, 250), beak = rgb(255, 150, 30), wing = 1.0, legs = true, upright = true },
	flamingo = { body = V(1.1, 1.0, 1.8), color = rgb(255, 130, 170), color2 = rgb(255, 160, 190), beak = rgb(30, 30, 30), wing = 3.0, legs = true, longLegs = true },
	phoenix = { body = V(1.6, 1.6, 2.6), color = rgb(255, 110, 30), color2 = rgb(255, 210, 60), beak = rgb(255, 230, 120), wing = 3.6, glow = true },
	bat = { body = V(0.9, 0.9, 1.2), color = rgb(45, 35, 45), color2 = rgb(70, 50, 60), beak = rgb(45, 35, 45), wing = 2.8, bat = true },
	pterodactyl = { body = V(1.4, 1.2, 2.6), color = rgb(150, 110, 80), color2 = rgb(200, 170, 130), beak = rgb(200, 170, 120), wing = 6.0, ptero = true },
}

local function bird(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local d = BIRDS[variant] or BIRDS.bird
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local body = d.body
	local legH = if d.longLegs then 3 elseif d.legs then 0.8 else 0.6
	local bodyY = legH + body.Y / 2
	local root = R:makeRoot(body, bodyY)
	local tilt = if d.upright then CFrame.identity else ANG(rad(-10), 0, 0)
	local torso = b:part("ball", body, CF(0, bodyY, 0) * tilt, d.color, { role = "primary", name = "Corpo" })
	R:join(torso, root)
	local belly = b:part("ball", body * V(0.8, 0.8, 0.8), CF(0, bodyY - body.Y * 0.12, -body.Z * 0.12), d.color2, { role = "secondary" })
	R:join(belly, torso)
	if d.glow then
		local fire = Instance.new("Fire")
		fire.Size = 5
		fire.Heat = 8
		fire.Parent = torso
	end
	-- cabeça
	local hm = R:mark()
	local hs = if d.owl then 1.2 else body.X * 0.8
	local headPos = if d.upright then V(0, bodyY + body.Y * 0.55, -0.1) else V(0, bodyY + body.Y * 0.45, -body.Z * 0.45)
	local head = b:ball(hs, CF(headPos), d.headColor or d.color, { role = "primary", name = "Cabeca" })
	R.head = head
	local front = headPos.Z - hs / 2
	if d.bigBeak then
		b:part("wedge", V(0.5, 0.7, 2.0), CF(0, headPos.Y, front - 0.9) * ANG(0, rad(180), 0), d.beak, { role = "fixed" })
	elseif d.flatBeak then
		b:box(V(0.6, 0.18, 0.7), CF(0, headPos.Y - 0.1, front - 0.3), d.beak, { role = "fixed" })
	elseif d.ptero then
		b:part("wedge", V(0.3, 0.4, 2.4), CF(0, headPos.Y, front - 1.1) * ANG(0, rad(180), 0), d.beak, { role = "fixed" })
		b:part("wedge", V(0.15, 0.9, 1.4), CF(0, headPos.Y + 0.4, headPos.Z + 0.7), d.color2, { role = "secondary" })
	else
		b:part("wedge", V(0.3, 0.3, 0.6), CF(0, headPos.Y - 0.05, front - 0.25) * ANG(0, rad(180), 0), d.beak, { role = "fixed" })
	end
	for _, side in { -1, 1 } do
		if d.owl then
			b:part("cyl", V(0.1, 0.55, 0.55), CF(side * 0.28, headPos.Y + 0.1, front + 0.05) * ANG(0, rad(90), 0), rgb(255, 220, 60), { role = "fixed" })
			b:part("cyl", V(0.12, 0.25, 0.25), CF(side * 0.28, headPos.Y + 0.1, front) * ANG(0, rad(90), 0), rgb(10, 10, 10), { role = "eye" })
		else
			b:box(V(0.15, 0.15, 0.08), CF(side * hs * 0.32, headPos.Y + 0.08, front + 0.12), rgb(15, 15, 15), { role = "eye" })
		end
	end
	if d.comb then
		b:part("wedge", V(0.15, 0.4, 0.5), CF(0, headPos.Y + hs * 0.55, headPos.Z), rgb(230, 40, 40), { role = "fixed" })
	end
	if d.bat then
		for _, side in { -1, 1 } do
			b:part("wedge", V(0.12, 0.6, 0.35), CF(side * 0.25, headPos.Y + 0.5, headPos.Z), d.color, { role = "primary" })
		end
	end
	local neck = if d.longLegs then V(0, bodyY + 1.4, -0.9) else headPos
	if d.longLegs then
		b:beam(V(0, bodyY + 0.3, -body.Z * 0.4), neck, 0.3, d.color, { role = "primary" })
	end
	R:group(hm, torso, V(0, bodyY + body.Y * 0.3, -body.Z * 0.3), { kind = "head", axis = "Y", amp = 0.25, speed = 0.8 })
	R:setMouth(head, V(0, 0, -hs / 2 - 0.3))
	-- asas
	for _, side in { -1, 1 } do
		local m = R:mark()
		local span = d.wing
		local wcol = d.wingColor or d.color
		local wmat = Enum.Material.SmoothPlastic
		if d.bat or d.ptero then
			b:part("wedge", V(0.1, body.Z * 0.9, span), CF(side * (body.X / 2 + span / 2), bodyY + 0.1, 0) * ANG(rad(90), side * rad(90), 0), wcol, { role = "primary", material = wmat })
		else
			b:box(V(span, 0.15, body.Z * 0.7), CF(side * (body.X / 2 + span / 2 - 0.1), bodyY + 0.15, 0.1), wcol, { role = "primary" })
			b:box(V(span * 0.5, 0.12, body.Z * 0.45), CF(side * (body.X / 2 + span * 0.85), bodyY + 0.15, 0.3), Kit.darker(wcol, 0.15), { role = "secondary" })
			if d.glow then
				b:box(V(span * 0.8, 0.1, 0.3), CF(side * (body.X / 2 + span / 2), bodyY + 0.2, body.Z * 0.35), d.color2, { role = "accent", material = Enum.Material.Neon })
			end
		end
		R:group(m, torso, V(side * body.X / 2, bodyY + 0.15, 0), { kind = "wing", axis = "Z", amp = if params.fly then 0.75 else 0.2, phase = if side < 0 then 0 else math.pi, speed = if d.bat then 2.4 else 1.4 })
	end
	-- cauda
	local tm = R:mark()
	local tailCol = d.tailColor or d.color
	if d.glow then
		for k = -1, 1 do
			b:box(V(0.3, 0.1, 3.0), CF(k * 0.35, bodyY - 0.1, body.Z / 2 + 1.4) * ANG(rad(-15), rad(k * 12), 0), rgb(255, 180, 40), { role = "accent", material = Enum.Material.Neon })
		end
	else
		b:part("wedge", V(body.X * 0.8, 0.15, 1.0), CF(0, bodyY, body.Z / 2 + 0.4) * ANG(0, 0, 0), tailCol, { role = "primary" })
	end
	R:group(tm, torso, V(0, bodyY, body.Z / 2), { kind = "tail", axis = "X", amp = 0.15 })
	-- pernas
	if d.legs then
		for _, side in { -1, 1 } do
			local m = R:mark()
			b:box(V(0.15, legH, 0.15), CF(side * 0.3, legH / 2, 0), rgb(240, 160, 50), { role = "fixed" })
			b:box(V(0.5, 0.1, 0.6), CF(side * 0.3, 0.05, -0.15), rgb(240, 160, 50), { role = "fixed" })
			R:group(m, torso, V(side * 0.3, legH, 0), { kind = "leg", axis = "X", amp = 0.6, phase = if side < 0 then 0 else math.pi, speed = 1.5 })
		end
	end
	return R:finish({ hp = params.hp or 40, speed = params.speed or 16, hipHeight = legH, height = headPos.Y + hs / 2, flying = params.fly, radius = body.X })
end

-- PEIXES (nadam no ar) -----------------------------------------------------------
local FISH = {
	fish = { body = V(0.9, 1.2, 2.2), color = rgb(255, 140, 40), color2 = rgb(255, 250, 240), fin = rgb(255, 100, 30) },
	shark = { body = V(1.6, 1.8, 5.0), color = rgb(110, 125, 140), color2 = rgb(240, 240, 245), fin = rgb(100, 115, 130), shark = true },
	whale = { body = V(3.2, 3.0, 8.0), color = rgb(60, 90, 140), color2 = rgb(200, 210, 220), fin = rgb(55, 80, 125), whale = true },
	dolphin = { body = V(1.2, 1.4, 4.0), color = rgb(120, 150, 190), color2 = rgb(230, 235, 245), fin = rgb(110, 140, 180), dolphin = true },
	piranha = { body = V(0.8, 1.4, 1.6), color = rgb(160, 170, 180), color2 = rgb(230, 60, 40), fin = rgb(150, 160, 170), teeth = true },
}

local function fish(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local d = FISH[variant] or FISH.fish
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local body = d.body
	local y = body.Y / 2 + 0.5
	local root = R:makeRoot(body, y)
	local torso = b:part("ball", body, CF(0, y, 0), d.color, { role = "primary", name = "Corpo" })
	R:join(torso, root)
	local belly = b:part("ball", body * V(0.85, 0.6, 0.9), CF(0, y - body.Y * 0.2, -0.1), d.color2, { role = "secondary" })
	R:join(belly, torso)
	local front = -body.Z / 2
	for _, side in { -1, 1 } do
		local eye = b:ball(0.18 * math.max(1, body.Y), CF(side * body.X * 0.42, y + body.Y * 0.12, front + body.Z * 0.18), rgb(15, 15, 15), { role = "eye" })
		R:join(eye, torso)
		local fin = b:part("wedge", V(0.1, body.Y * 0.35, body.Z * 0.2), CF(side * body.X * 0.5, y - body.Y * 0.2, front + body.Z * 0.35) * ANG(0, 0, side * rad(60)), d.fin, { role = "primary" })
		R:join(fin, torso, V(side * body.X * 0.45, y - body.Y * 0.2, front + body.Z * 0.3), { kind = "fin", axis = "Z", amp = 0.35, phase = if side < 0 then 0 else math.pi, speed = 1.5 })
	end
	local dorsal = b:part("wedge", V(0.15, body.Y * (if d.shark then 0.7 else 0.4), body.Z * 0.25), CF(0, y + body.Y * 0.55, body.Z * 0.05), d.fin, { role = "primary" })
	R:join(dorsal, torso)
	if d.shark or d.teeth then
		for k = -2, 2 do
			local tooth = b:part("wedge", V(0.12, 0.25, 0.12), CF(k * 0.18 * body.X, y - body.Y * 0.18, front + 0.15) * ANG(rad(180), 0, 0), rgb(255, 255, 255), { role = "fixed" })
			R:join(tooth, torso)
		end
	end
	if d.shark then
		for k = 0, 2 do
			local g = b:box(V(0.05, body.Y * 0.4, 0.06), CF(body.X * 0.48, y, front + body.Z * 0.28 + k * 0.25), Kit.darker(d.color, 0.3), { role = "fixed" })
			R:join(g, torso)
		end
	end
	if d.dolphin then
		local beak = b:box(V(0.4, 0.35, 0.8), CF(0, y - 0.1, front - 0.3), d.color, { role = "primary" })
		R:join(beak, torso)
	end
	-- cauda
	local tm = R:mark()
	if d.whale or d.dolphin then
		b:part("wedge", V(body.X * 1.8, 0.2, body.Z * 0.18), CF(0, y, body.Z / 2 + body.Z * 0.08), d.fin, { role = "primary" })
	else
		b:part("wedge", V(0.15, body.Y * 1.1, body.Z * 0.3), CF(0, y, body.Z / 2 + body.Z * 0.12) * ANG(0, rad(180), 0), d.fin, { role = "primary" })
	end
	R:group(tm, torso, V(0, y, body.Z / 2), { kind = "tail", axis = if (d.whale or d.dolphin) then "X" else "Y", amp = 0.45, speed = 1.3 })
	R.head = torso
	R:setMouth(torso, V(0, 0, front))
	return R:finish({ hp = params.hp or 40, speed = params.speed or 14, hipHeight = 0.5, height = body.Y + 0.5, flying = true, radius = body.Z / 2 })
end

-- POLVO / KRAKEN -------------------------------------------------------------------
local function octopus(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local kraken = variant == "kraken"
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local c1 = if kraken then rgb(140, 30, 50) else rgb(230, 110, 150)
	local c2 = Kit.lighter(c1, 0.3)
	local y = 3
	local root = R:makeRoot(V(2.4, 2.4, 2.4), y)
	local mantle = b:part("ball", V(2.6, 3.2, 2.8), CF(0, y + 0.8, 0.2), c1, { role = "primary", name = "Cabeca" })
	R:join(mantle, root)
	R.head = mantle
	for _, side in { -1, 1 } do
		local e = b:ball(0.7, CF(side * 0.75, y + 0.2, -1.2), rgb(250, 250, 230), { role = "fixed" })
		R:join(e, mantle)
		local p = b:box(V(0.45, 0.2, 0.1), CF(side * 0.75, y + 0.2, -1.55), rgb(10, 10, 10), { role = "eye" })
		R:join(p, mantle)
	end
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local dir = V(math.cos(a), 0, math.sin(a))
		local prev = mantle
		local base = V(0, y - 0.4, 0) + dir * 0.9
		local pos = base
		for s = 1, 4 do
			local m = R:mark()
			local stepDir = (dir * 0.75 + V(0, -0.65 + s * 0.12, 0)).Unit
			local nextPos = pos + stepDir * 1.15
			local mid = (pos + nextPos) / 2
			local th = 1.0 - s * 0.16
			b:part("ball", V(th, th, 1.7), CF(mid, nextPos), if s % 2 == 1 then c1 else c2, { role = if s % 2 == 1 then "primary" else "secondary" })
			if s == 2 then
				b:ball(0.3, CF(mid + V(0, -th * 0.45, 0)), Kit.lighter(c2, 0.4), { role = "fixed" })
			end
			prev = R:group(m, prev, pos, { kind = "tentacle", axis = "X", amp = 0.25, phase = k * 0.8 + s * 0.6, speed = 0.9 }) or prev
			pos = nextPos
		end
	end
	R:setMouth(mantle, V(0, -1.4, -0.5))
	return R:finish({ hp = params.hp or 200, speed = params.speed or 12, hipHeight = 2, height = y + 2.4, flying = true, radius = 3 })
end

-- SERPENTES --------------------------------------------------------------------------
local SERP = {
	snake = { n = 8, d = 0.8, color = rgb(80, 150, 60), color2 = rgb(220, 210, 90), pattern = "bands" },
	anaconda = { n = 10, d = 1.0, color = rgb(100, 110, 50), color2 = rgb(30, 30, 20), pattern = "spots" },
	worm = { n = 9, d = 1.6, color = rgb(220, 140, 150), color2 = rgb(190, 110, 120), pattern = "rings", worm = true },
	boitata = { n = 10, d = 1.0, color = rgb(255, 120, 30), color2 = rgb(255, 220, 80), pattern = "glow", glow = true },
	sea_serpent = { n = 10, d = 1.3, color = rgb(40, 120, 130), color2 = rgb(160, 220, 200), pattern = "fins" },
}

local function serpent(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local d = SERP[variant] or SERP.snake
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local seg = d.d
	local y = seg / 2
	local root = R:makeRoot(V(seg * 1.2, seg, seg * 1.6), y + 0.3)
	local headPos = V(0, y + 0.4, -seg)
	local hm = R:mark()
	local head = b:part("ball", V(seg * 1.3, seg * 0.9, seg * 1.7), CF(headPos), d.color, { role = "primary", name = "Cabeca", material = if d.glow then Enum.Material.Neon else Enum.Material.SmoothPlastic })
	for _, side in { -1, 1 } do
		b:ball(seg * 0.28, CF(headPos + V(side * seg * 0.4, seg * 0.25, -seg * 0.5)), if d.glow then rgb(255, 255, 220) else rgb(240, 210, 40), { role = "eye", material = Enum.Material.Neon })
	end
	if d.worm then
		b:part("cyl", V(0.2, seg * 1.1, seg * 1.1), CF(headPos + V(0, 0, -seg * 0.85)) * ANG(0, rad(90), 0), rgb(60, 20, 30), { role = "fixed" })
		for k = 0, 5 do
			local a = k / 6 * math.pi * 2
			b:part("wedge", V(0.15, 0.4, 0.2), CF(headPos + V(math.cos(a) * seg * 0.45, math.sin(a) * seg * 0.45, -seg * 0.85)), rgb(250, 245, 230), { role = "fixed" })
		end
	else
		b:box(V(0.08, 0.05, seg * 0.6), CF(headPos + V(0, -seg * 0.15, -seg * 1.05)), rgb(220, 40, 60), { role = "fixed" })
	end
	R.head = head
	R:group(hm, root, headPos + V(0, 0, seg * 0.5), { kind = "head", axis = "Y", amp = 0.3, speed = 1 })
	local prev: BasePart = root
	for k = 1, d.n do
		local m = R:mark()
		local th = seg * (1 - k / (d.n + 4))
		local pos = V(0, th / 2 + 0.1, k * seg * 0.9)
		local col = if d.pattern == "bands" and k % 2 == 0 then d.color2 elseif d.pattern == "rings" and k % 2 == 0 then d.color2 else d.color
		b:ball(th * 1.15, CF(pos), col, { role = if col == d.color then "primary" else "secondary", material = if d.glow then Enum.Material.Neon else Enum.Material.SmoothPlastic })
		if d.pattern == "spots" and k % 2 == 1 then
			b:ball(th * 0.4, CF(pos + V(th * 0.45, th * 0.2, 0)), d.color2, { role = "secondary" })
		elseif d.pattern == "fins" and k % 2 == 1 then
			b:part("wedge", V(0.12, th * 0.7, th * 0.8), CF(pos + V(0, th * 0.6, 0)), d.color2, { role = "secondary" })
		end
		prev = R:group(m, prev, pos - V(0, 0, seg * 0.45), { kind = "segment", axis = "Y", amp = 0.22, phase = k * 0.7, speed = 1.2 }) or prev
	end
	if d.glow then
		Kit.elementEffects(head, "fire", 1)
	end
	R:setMouth(head, V(0, 0, -seg * 0.9))
	return R:finish({ hp = params.hp or 100, speed = params.speed or 14, hipHeight = 0.3, height = seg * 1.4, flying = params.fly, radius = seg * 2 })
end

-- INSETOS E ARACNÍDEOS -------------------------------------------------------------
local BUGS = {
	spider = { legs = 8, color = rgb(40, 35, 35), color2 = rgb(180, 30, 30), body = V(1.6, 1.0, 1.4), abdomen = V(2.2, 1.8, 2.4), eyes = 6 },
	scorpion = { legs = 8, color = rgb(70, 50, 30), color2 = rgb(120, 85, 50), body = V(1.6, 0.8, 2.0), abdomen = V(1.4, 0.7, 2.2), claws = true, stinger = true },
	ant = { legs = 6, color = rgb(160, 40, 30), color2 = rgb(120, 30, 25), body = V(0.8, 0.8, 1.0), abdomen = V(1.3, 1.2, 1.6), antenna = true },
	bee = { legs = 6, color = rgb(250, 200, 30), color2 = rgb(30, 25, 20), body = V(0.9, 0.9, 1.0), abdomen = V(1.2, 1.2, 1.6), wings = true, stripes = true, antenna = true },
	butterfly = { legs = 0, color = rgb(60, 40, 40), color2 = rgb(255, 120, 200), body = V(0.4, 0.4, 0.9), abdomen = V(0.4, 0.4, 1.0), bigWings = true, antenna = true },
	beetle = { legs = 6, color = rgb(40, 120, 90), color2 = rgb(30, 90, 70), body = V(1.0, 0.8, 0.9), abdomen = V(1.8, 1.2, 2.0), shell = true, antenna = true },
	mosquito = { legs = 6, color = rgb(70, 70, 75), color2 = rgb(120, 110, 100), body = V(0.5, 0.5, 0.7), abdomen = V(0.4, 0.4, 1.4), wings = true, proboscis = true },
}

local function bug(origin: CFrame, params: { [string]: any }, variant: string): Rig.RigResult
	local d = BUGS[variant] or BUGS.ant
	local R = Rig.new(variant, origin, params)
	local b = R.b
	local legH = if d.legs > 0 then 0.9 else 0.3
	local y = legH + d.body.Y / 2
	local root = R:makeRoot(V(d.body.X, d.body.Y, d.body.Z + d.abdomen.Z), y)
	local thorax = b:part("ball", d.body, CF(0, y, 0), d.color, { role = "primary", name = "Corpo" })
	R:join(thorax, root)
	local abd = b:part("ball", d.abdomen, CF(0, y + d.abdomen.Y * 0.15, d.body.Z / 2 + d.abdomen.Z / 2 - 0.1), if variant == "spider" or variant == "bee" then d.color else d.color2, { role = "primary" })
	R:join(abd, thorax, V(0, y, d.body.Z / 2), { kind = "tail", axis = "X", amp = 0.08 })
	if d.stripes then
		for k = -1, 1 do
			local s = b:part("cyl", V(0.2, d.abdomen.Y * 1.02, d.abdomen.Y * 1.02), CF(0, y + d.abdomen.Y * 0.15, d.body.Z / 2 + d.abdomen.Z / 2 + k * 0.4) * ANG(0, rad(90), 0), d.color2, { role = "secondary" })
			R:join(s, abd)
		end
	end
	if d.shell then
		local s = b:part("ball", d.abdomen * V(1.08, 1.05, 1.02), CF(0, y + d.abdomen.Y * 0.25, d.body.Z / 2 + d.abdomen.Z / 2 - 0.1), d.color, { role = "primary", reflectance = 0.2 })
		R:join(s, abd)
	end
	if variant == "spider" then
		local mark = b:box(V(0.5, 0.06, 0.8), CF(0, y + d.abdomen.Y * 0.62, d.body.Z / 2 + d.abdomen.Z / 2), d.color2, { role = "accent" })
		R:join(mark, abd)
	end
	-- cabeça
	local hm = R:mark()
	local headPos = V(0, y + 0.1, -d.body.Z / 2 - 0.35)
	local head = b:ball(math.max(d.body.X * 0.7, 0.4), CF(headPos), d.color, { role = "primary", name = "Cabeca" })
	R.head = head
	local eyes = d.eyes or 2
	for k = 1, eyes do
		local col = if variant == "spider" then rgb(220, 30, 30) else rgb(15, 15, 15)
		local x = (k - (eyes + 1) / 2) * 0.18
		b:ball(0.18, CF(headPos + V(x, 0.12 + (if k % 2 == 0 then 0.1 else 0), -0.3)), col, { role = "eye", material = if variant == "spider" then Enum.Material.Neon else Enum.Material.SmoothPlastic })
	end
	if d.antenna then
		for _, side in { -1, 1 } do
			b:beam(headPos + V(side * 0.12, 0.2, -0.2), headPos + V(side * 0.45, 0.9, -0.6), 0.06, d.color, { role = "fixed" })
		end
	end
	if d.proboscis then
		b:box(V(0.06, 0.06, 0.8), CF(headPos + V(0, -0.1, -0.6)), d.color, { role = "fixed" })
	end
	R:group(hm, thorax, headPos + V(0, 0, 0.3), { kind = "head", axis = "Y", amp = 0.2 })
	R:setMouth(head, V(0, -0.1, -0.4))
	if d.claws then
		for _, side in { -1, 1 } do
			local m = R:mark()
			b:beam(V(side * 0.6, y, -d.body.Z / 2), V(side * 1.2, y, -d.body.Z / 2 - 1.2), 0.3, d.color, { role = "primary" })
			b:part("wedge", V(0.5, 0.35, 0.8), CF(side * 1.25, y, -d.body.Z / 2 - 1.6), d.color2, { role = "secondary" })
			R:group(m, thorax, V(side * 0.6, y, -d.body.Z / 2), { kind = "arm", axis = "Y", amp = 0.3, phase = if side < 0 then 0 else math.pi })
		end
	end
	if d.stinger then
		local prev: BasePart = abd
		local base = V(0, y + 0.2, d.body.Z / 2 + d.abdomen.Z)
		for k = 1, 4 do
			local m = R:mark()
			local pos = base + V(0, k * 0.55, -k * 0.25 + (if k > 2 then -0.4 else 0))
			b:ball(0.5 - k * 0.05, CF(pos), d.color2, { role = "secondary" })
			if k == 4 then
				b:part("wedge", V(0.15, 0.5, 0.3), CF(pos + V(0, 0, -0.35)) * ANG(rad(-90), 0, 0), rgb(30, 20, 15), { role = "fixed" })
			end
			prev = R:group(m, prev, pos - V(0, 0.25, 0), { kind = "tail", axis = "X", amp = 0.15, phase = k * 0.5 }) or prev
		end
	end
	-- pernas
	local pairs = d.legs // 2
	for i = 1, pairs do
		for _, side in { -1, 1 } do
			local m = R:mark()
			local z = (i - (pairs + 1) / 2) * (d.body.Z / pairs) * 0.9
			local hip = V(side * d.body.X * 0.45, y, z)
			local knee = hip + V(side * 1.0, 0.5, z * 0.2)
			local foot = V(side * (d.body.X * 0.45 + 1.6), 0, z * 1.4)
			b:beam(hip, knee, 0.14, d.color, { role = "primary" })
			b:beam(knee, foot, 0.12, d.color, { role = "primary" })
			R:group(m, thorax, hip, { kind = "leg", axis = "Y", amp = 0.35, phase = (i + (if side < 0 then 0 else 1)) * math.pi, speed = 1.8 })
		end
	end
	-- asas
	if d.wings or d.bigWings then
		for _, side in { -1, 1 } do
			local m = R:mark()
			local span = if d.bigWings then 2.4 else 1.2
			local col = if d.bigWings then d.color2 else rgb(220, 235, 255)
			b:part("ball", V(span, 0.08, span * 0.8), CF(side * (d.body.X / 2 + span / 2), y + 0.5, 0), col, { role = if d.bigWings then "accent" else "fixed", material = if d.bigWings then Enum.Material.SmoothPlastic else Enum.Material.Glass, transparency = if d.bigWings then 0 else 0.4 })
			if d.bigWings then
				b:part("ball", V(span * 0.8, 0.08, span * 0.6), CF(side * (d.body.X / 2 + span * 0.4), y + 0.45, span * 0.55), Kit.lighter(col, 0.3), { role = "accent" })
				b:ball(0.4, CF(side * (d.body.X / 2 + span * 0.6), y + 0.55, 0), rgb(30, 30, 40), { role = "fixed" })
			end
			R:group(m, thorax, V(side * d.body.X / 2, y + 0.4, 0), { kind = "wing", axis = "Z", amp = if d.bigWings then 0.7 else 0.5, phase = if side < 0 then 0 else math.pi, speed = if d.bigWings then 1.2 else 5 })
		end
	end
	return R:finish({ hp = params.hp or 60, speed = params.speed or 16, hipHeight = legH, height = y + 1, flying = params.fly, radius = 1.6 })
end

-- SLIME ----------------------------------------------------------------------------
local function slime(origin: CFrame, params: { [string]: any }, _variant: string): Rig.RigResult
	local R = Rig.new("slime", origin, params)
	local b = R.b
	local col = rgb(90, 220, 110)
	local root = R:makeRoot(V(2.6, 2.4, 2.6), 1.4)
	local m = R:mark()
	b:box(V(2.6, 2.4, 2.6), CF(0, 1.4, 0), col, { role = "primary", material = Enum.Material.Glass, transparency = 0.25, name = "Corpo" })
	b:box(V(1.6, 1.4, 1.6), CF(0, 1.3, 0), Kit.darker(col, 0.25), { role = "secondary" })
	for _, side in { -1, 1 } do
		b:box(V(0.35, 0.5, 0.1), CF(side * 0.55, 1.8, -1.32), rgb(15, 30, 15), { role = "eye" })
	end
	b:box(V(0.9, 0.15, 0.1), CF(0, 1.2, -1.32), rgb(20, 60, 25), { role = "fixed" })
	local body = R:group(m, root, V(0, 0.4, 0), { kind = "bob", axis = "Y", amp = 0.35, speed = 1.6 })
	R.head = body
	if body then
		R:setMouth(body, V(0, -0.2, -1.3))
	end
	return R:finish({ hp = params.hp or 100, speed = params.speed or 12, hipHeight = 0.2, height = 2.6, radius = 1.4 })
end

Beasts.quadruped = quadruped
Beasts.theropod = theropod
Beasts.bird = bird
Beasts.fish = fish
Beasts.octopus = octopus
Beasts.serpent = serpent
Beasts.bug = bug
Beasts.slime = slime
Beasts.Quadrupeds = QUAD

return Beasts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Buildings</string>
            <string name="Source"><![CDATA[--!strict
-- Construções procedurais ancoradas. Retornam o modelo, raio e altura.
-- Partes giratórias (moinho, roda-gigante, farol) recebem a tag "IdeiasGirar":
-- o cliente gira localmente, sem replicação a cada quadro.

local Kit = require(script.Parent.Kit)

local Buildings = {}

local rgb = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad

export type BuildingResult = { model: Model, radius: number, height: number, door: Vector3?, center: Vector3 }

local WALLS = { rgb(240, 230, 210), rgb(200, 220, 240), rgb(245, 210, 200), rgb(220, 240, 210), rgb(250, 240, 200) }
local ROOFS = { rgb(170, 60, 50), rgb(70, 80, 100), rgb(90, 60, 45), rgb(60, 120, 90) }

local function spinTag(part: BasePart, axis: string, speed: number)
	part:AddTag("IdeiasGirar")
	part:SetAttribute("GirarEixo", axis)
	part:SetAttribute("GirarVel", speed)
end

-- parede com aberturas: segmentos ao redor de uma porta e janelas (eixo X)
local function wall(b: any, width: number, height: number, cf: CFrame, color: Color3, door: boolean, windows: number, mat: Enum.Material)
	local t = 0.8
	local doorW, doorH = 4, 6
	if door then
		local side = (width - doorW) / 2
		b:box(V(side, height, t), cf * CF(-(doorW / 2 + side / 2), height / 2, 0), color, { role = "primary", material = mat })
		b:box(V(side, height, t), cf * CF(doorW / 2 + side / 2, height / 2, 0), color, { role = "primary", material = mat })
		b:box(V(doorW, height - doorH, t), cf * CF(0, doorH + (height - doorH) / 2, 0), color, { role = "primary", material = mat })
		b:box(V(doorW + 0.6, 0.4, t + 0.2), cf * CF(0, doorH + 0.2, 0), Kit.darker(color, 0.25), { role = "secondary" })
	else
		b:box(V(width, height, t), cf * CF(0, height / 2, 0), color, { role = "primary", material = mat })
	end
	for i = 1, windows do
		local x = (i - (windows + 1) / 2) * (width / (windows + 0.5))
		if not door or math.abs(x) > 3.5 then
			b:box(V(2.6, 2.6, t + 0.15), cf * CF(x, height * 0.6, 0), rgb(150, 205, 240), { role = "fixed", material = Enum.Material.Glass, transparency = 0.2 })
			b:box(V(3.0, 0.3, t + 0.3), cf * CF(x, height * 0.6 - 1.45, 0), Kit.darker(color, 0.3), { role = "secondary" })
		end
	end
end

local function house(b: any, rng: any, big: boolean): BuildingResult
	local w = if big then 30 else 20
	local d = if big then 22 else 16
	local h = if big then 9 else 9
	local floors = if big then 2 else 1
	local wallCol = rng:pick(WALLS)
	local roofCol = rng:pick(ROOFS)
	local mat = Enum.Material.SmoothPlastic
	b:box(V(w + 2, 1, d + 2), CF(0, 0.5, 0), rgb(150, 140, 130), { role = "secondary", material = Enum.Material.Concrete })
	for f = 0, floors - 1 do
		local y = 1 + f * h
		wall(b, w, h, CF(0, y, -d / 2), wallCol, f == 0, if big then 4 else 2, mat)
		wall(b, w, h, CF(0, y, d / 2), wallCol, false, if big then 4 else 2, mat)
		wall(b, d, h, CF(-w / 2, y, 0) * ANG(0, rad(90), 0), wallCol, false, if big then 3 else 2, mat)
		wall(b, d, h, CF(w / 2, y, 0) * ANG(0, rad(90), 0), wallCol, false, if big then 3 else 2, mat)
		b:box(V(w, 0.6, d), CF(0, y + h - 0.3, 0), Kit.darker(wallCol, 0.1), { role = "secondary" })
	end
	local top = 1 + floors * h
	b:roof(w + 2, d + 2, if big then 8 else 6, CF(0, top, 0) * ANG(0, rad(90), 0), roofCol, { role = "secondary" })
	b:box(V(2, 6, 2), CF(w * 0.25, top + 3, d * 0.2), rgb(150, 90, 70), { role = "fixed", material = Enum.Material.Brick })
	b:box(V(4, 7, 0.3), CF(0, 4.5, -d / 2 - 0.1), rgb(120, 75, 40), { role = "fixed", material = Enum.Material.WoodPlanks, transparency = 0.9, collide = false })
	if big then
		for _, x in { -w / 2 + 3, w / 2 - 3 } do
			b:cylY(h * 2, 1.4, CF(x, 1 + h, -d / 2 - 2.5), rgb(245, 245, 245), { role = "fixed", material = Enum.Material.Marble })
		end
		b:box(V(w * 0.6, 0.6, 4), CF(0, 1 + h, -d / 2 - 2), Kit.darker(wallCol, 0.1), { role = "secondary" })
	end
	return { model = b.model, radius = math.max(w, d) / 2 + 2, height = top + 8, door = V(0, 1, -d / 2 - 3), center = V(0, top / 2, 0) }
end

local function skyscraper(b: any, rng: any): BuildingResult
	local w = 16
	local floors = rng:int(8, 13)
	local fh = 5
	local col = rng:pick({ rgb(70, 80, 100), rgb(210, 215, 225), rgb(40, 50, 70), rgb(160, 140, 120) })
	local glassC = rng:pick({ rgb(120, 200, 255), rgb(255, 200, 120), rgb(160, 255, 220) })
	b:box(V(w + 4, 1, w + 4), CF(0, 0.5, 0), rgb(120, 120, 125), { role = "secondary", material = Enum.Material.Concrete })
	b:box(V(w, floors * fh, w), CF(0, 1 + floors * fh / 2, 0), col, { role = "primary", material = Enum.Material.Concrete })
	for f = 1, floors do
		b:box(V(w + 0.3, 1.6, w + 0.3), CF(0, 1 + (f - 0.5) * fh, 0), glassC, { role = "accent", material = Enum.Material.Glass, transparency = 0.15, reflectance = 0.2 })
	end
	local top = 1 + floors * fh
	b:box(V(w * 0.6, 4, w * 0.6), CF(0, top + 2, 0), col, { role = "primary" })
	b:cylY(10, 0.5, CF(0, top + 9, 0), rgb(180, 180, 190), { role = "fixed", material = Enum.Material.Metal })
	local l = b:ball(1, CF(0, top + 14.5, 0), rgb(255, 40, 40), { role = "fixed", material = Enum.Material.Neon })
	b:light(l, rgb(255, 60, 60), 20, 2)
	b:box(V(5, 7, 0.4), CF(0, 4.5, -w / 2 - 0.1), rgb(30, 30, 35), { role = "fixed", material = Enum.Material.Glass, transparency = 0.3, collide = false })
	return { model = b.model, radius = w / 2 + 3, height = top + 15, center = V(0, top / 2, 0) }
end

local function tower(b: any, _rng: any): BuildingResult
	local stone = rgb(150, 145, 140)
	b:cylY(30, 12, CF(0, 15, 0), stone, { role = "primary", material = Enum.Material.Cobblestone })
	b:cylY(2, 14, CF(0, 31, 0), Kit.darker(stone, 0.15), { role = "secondary", material = Enum.Material.Cobblestone })
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		b:box(V(2, 2.4, 2), CF(math.cos(a) * 6.2, 33.2, math.sin(a) * 6.2) * ANG(0, -a, 0), stone, { role = "primary", material = Enum.Material.Cobblestone })
	end
	b:cone(10, 13, CF(0, 32, 0), rgb(60, 70, 130), 5, { role = "secondary" })
	for k = 0, 3 do
		b:box(V(1.6, 3, 0.6), CF(0, 8 + k * 6, -6) * ANG(0, 0, 0), rgb(255, 210, 120), { role = "fixed", material = Enum.Material.Neon })
	end
	b:box(V(4, 6, 1.5), CF(0, 3, -6), rgb(110, 70, 40), { role = "fixed", material = Enum.Material.WoodPlanks })
	return { model = b.model, radius = 7, height = 44, center = V(0, 15, 0) }
end

local function castle(b: any, rng: any): BuildingResult
	local stone = rgb(165, 160, 150)
	local roof = rgb(60, 70, 140)
	local s = 44
	local h = 14
	local mat = Enum.Material.Cobblestone
	b:box(V(s + 8, 1, s + 8), CF(0, 0.5, 0), rgb(120, 115, 110), { role = "secondary", material = Enum.Material.Slate })
	for _, side in { { 0, -s / 2, 0 }, { 0, s / 2, 0 }, { -s / 2, 0, 90 }, { s / 2, 0, 90 } } do
		local cf = CF(side[1], 1, side[2]) * ANG(0, rad(side[3]), 0)
		if side[2] < 0 and side[3] == 0 then
			-- muralha da frente com portão
			b:box(V((s - 10) / 2, h, 3), cf * CF(-(5 + (s - 10) / 4), h / 2, 0), stone, { role = "primary", material = mat })
			b:box(V((s - 10) / 2, h, 3), cf * CF(5 + (s - 10) / 4, h / 2, 0), stone, { role = "primary", material = mat })
			b:box(V(10, h - 9, 3), cf * CF(0, 9 + (h - 9) / 2, 0), stone, { role = "primary", material = mat })
			b:box(V(9, 8.6, 0.5), cf * CF(0, 4.3, -1.6), rgb(90, 60, 35), { role = "fixed", material = Enum.Material.WoodPlanks, transparency = 0.6, collide = false })
		else
			b:box(V(s, h, 3), cf * CF(0, h / 2, 0), stone, { role = "primary", material = mat })
		end
		for k = -5, 5 do
			b:box(V(2, 2, 3.4), cf * CF(k * 4, h + 1, 0), stone, { role = "primary", material = mat })
		end
	end
	for _, x in { -s / 2, s / 2 } do
		for _, z in { -s / 2, s / 2 } do
			b:cylY(h + 8, 10, CF(x, 1 + (h + 8) / 2, z), stone, { role = "primary", material = mat })
			b:cone(9, 11, CF(x, 1 + h + 8, z), roof, 4, { role = "secondary" })
			local pole = b:cylY(4, 0.3, CF(x, 1 + h + 19, z), rgb(80, 60, 40), { role = "fixed" })
			local flagCol = rng:pick({ rgb(220, 40, 40), rgb(250, 200, 40), rgb(60, 120, 230) })
			b:box(V(0.1, 1.6, 2.6), CF(x, 1 + h + 20.2, z + 1.3), flagCol, { role = "accent" })
			local _ = pole
		end
	end
	-- torre central
	b:box(V(16, h + 14, 16), CF(0, 1 + (h + 14) / 2, 6), Kit.lighter(stone, 0.05), { role = "primary", material = mat })
	b:cone(12, 18, CF(0, 1 + h + 14, 6), roof, 5, { role = "secondary" })
	for k = -1, 1 do
		b:box(V(2, 4, 0.5), CF(k * 4, h + 6, -2.2), rgb(255, 200, 100), { role = "fixed", material = Enum.Material.Neon })
	end
	return { model = b.model, radius = s / 2 + 6, height = h + 30, door = V(0, 1, -s / 2 - 4), center = V(0, 10, 0) }
end

local function bridge(b: any, _rng: any): BuildingResult
	local len = 70
	local wood = rgb(150, 105, 65)
	b:box(V(10, 1, len), CF(0, 6, -len / 2 - 4), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	for k = 0, 9 do
		local z = -4 - k * len / 9
		for _, side in { -1, 1 } do
			b:cylY(9, 0.8, CF(side * 5, 2.5, z), Kit.darker(wood, 0.2), { role = "secondary" })
			b:cylY(3, 0.4, CF(side * 4.8, 8, z), wood, { role = "primary" })
		end
	end
	for _, side in { -1, 1 } do
		b:box(V(0.5, 0.5, len), CF(side * 4.8, 9.3, -len / 2 - 4), wood, { role = "primary" })
	end
	b:part("wedge", V(10, 6, 8), CF(0, 3, 0) * ANG(0, rad(180), 0), wood, { role = "primary", material = Enum.Material.WoodPlanks })
	return { model = b.model, radius = len / 2, height = 10, center = V(0, 6, -len / 2) }
end

local function wallB(b: any, _rng: any): BuildingResult
	local stone = rgb(160, 150, 140)
	b:box(V(60, 12, 4), CF(0, 6, 0), stone, { role = "primary", material = Enum.Material.Brick })
	for k = -7, 7 do
		b:box(V(2.4, 2.4, 4.4), CF(k * 4, 13.2, 0), stone, { role = "primary", material = Enum.Material.Brick })
	end
	return { model = b.model, radius = 30, height = 15, center = V(0, 6, 0) }
end

-- labirinto gerado por backtracking recursivo
local function maze(b: any, rng: any): BuildingResult
	local n = 9
	local cell = 10
	local h = 8
	local hedge = rgb(60, 130, 55)
	local visited = {}
	local walls = {}
	local function key(x, y)
		return x .. ":" .. y
	end
	for x = 1, n do
		for y = 1, n do
			walls[key(x, y)] = { N = true, S = true, E = true, W = true }
		end
	end
	local stack = { { 1, 1 } }
	visited[key(1, 1)] = true
	local dirs = { { 0, -1, "N", "S" }, { 0, 1, "S", "N" }, { 1, 0, "E", "W" }, { -1, 0, "W", "E" } }
	while #stack > 0 do
		local cur = stack[#stack]
		local options = {}
		for _, d in dirs do
			local nx, ny = cur[1] + d[1], cur[2] + d[2]
			if nx >= 1 and nx <= n and ny >= 1 and ny <= n and not visited[key(nx, ny)] then
				table.insert(options, d)
			end
		end
		if #options == 0 then
			table.remove(stack)
		else
			local d = rng:pick(options)
			local nx, ny = cur[1] + d[1], cur[2] + d[2]
			walls[key(cur[1], cur[2])][d[3]] = false
			walls[key(nx, ny)][d[4]] = false
			visited[key(nx, ny)] = true
			table.insert(stack, { nx, ny })
		end
	end
	walls[key(math.ceil(n / 2), 1)].N = false -- entrada
	walls[key(math.ceil(n / 2), n)].S = false -- saída
	local off = -(n * cell) / 2
	b:box(V(n * cell + 2, 0.6, n * cell + 2), CF(0, 0.3, -n * cell / 2 - 6), rgb(190, 170, 120), { role = "secondary", material = Enum.Material.Sand })
	for x = 1, n do
		for y = 1, n do
			local w = walls[key(x, y)]
			local cx = off + (x - 0.5) * cell
			local cz = -6 - (y - 0.5) * cell
			if w.N then
				b:box(V(cell + 1, h, 1), CF(cx, h / 2, cz + cell / 2), hedge, { role = "primary", material = Enum.Material.Grass })
			end
			if w.W then
				b:box(V(1, h, cell + 1), CF(cx - cell / 2, h / 2, cz), hedge, { role = "primary", material = Enum.Material.Grass })
			end
			if y == n and w.S then
				b:box(V(cell + 1, h, 1), CF(cx, h / 2, cz - cell / 2), hedge, { role = "primary", material = Enum.Material.Grass })
			end
			if x == n and w.E then
				b:box(V(1, h, cell + 1), CF(cx + cell / 2, h / 2, cz), hedge, { role = "primary", material = Enum.Material.Grass })
			end
		end
	end
	local prize = b:ball(2.5, CF(0, 3, -6 - n * cell / 2), rgb(255, 210, 50), { role = "fixed", material = Enum.Material.Neon, collide = false })
	prize.Name = "Premio"
	return { model = b.model, radius = n * cell / 2 + 4, height = h, center = V(0, 2, -6 - n * cell / 2) }
end

local function pyramid(b: any, _rng: any): BuildingResult
	local sand = rgb(225, 195, 130)
	for k = 0, 9 do
		local s = 50 - k * 5
		b:box(V(s, 3, s), CF(0, 1.5 + k * 3, 0), Kit.darker(sand, (k % 2) * 0.05), { role = "primary", material = Enum.Material.Sandstone })
	end
	b:box(V(5, 6, 6), CF(0, 3, -24), rgb(30, 25, 20), { role = "fixed" })
	b:ball(2, CF(0, 31, 0), rgb(255, 215, 80), { role = "fixed", material = Enum.Material.Neon })
	return { model = b.model, radius = 26, height = 32, center = V(0, 10, 0) }
end

local function lighthouse(b: any, _rng: any): BuildingResult
	for k = 0, 5 do
		b:cylY(6, 9 - k * 0.6, CF(0, 3 + k * 6, 0), if k % 2 == 0 then rgb(240, 240, 240) else rgb(220, 40, 40), { role = if k % 2 == 0 then "primary" else "secondary" })
	end
	b:cylY(5, 6, CF(0, 38.5, 0), rgb(200, 240, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.4 })
	b:cone(4, 7, CF(0, 41, 0), rgb(220, 40, 40), 3, { role = "secondary" })
	local lamp = b:ball(3, CF(0, 38.5, 0), rgb(255, 250, 200), { role = "fixed", material = Enum.Material.Neon })
	local beam = b:part("wedge", V(0.2, 6, 40), CF(0, 38.5, -21), rgb(255, 250, 200), { role = "fixed", material = Enum.Material.Neon, transparency = 0.75, collide = false })
	local pivot = b:box(V(1, 1, 1), CF(0, 38.5, 0), rgb(255, 255, 255), { role = "fixed", transparency = 1, collide = false, name = "PivoFarol" })
	beam:SetAttribute("GirarCentro", true)
	spinTag(pivot, "Y", 1.2)
	beam.Parent = pivot
	b:light(lamp, rgb(255, 245, 200), 40, 3)
	return { model = b.model, radius = 6, height = 45, center = V(0, 18, 0) }
end

local function windmill(b: any, _rng: any): BuildingResult
	local wall = rgb(235, 225, 205)
	b:cone(26, 12, CF(0, 0, 0), wall, 6, { role = "primary" })
	b:cone(6, 8, CF(0, 25, 0), rgb(130, 70, 50), 3, { role = "secondary" })
	local hub = b:part("cyl", V(2, 2.2, 2.2), CF(0, 22, -5) * ANG(0, rad(90), 0), rgb(90, 60, 40), { role = "fixed", name = "Eixo" })
	spinTag(hub, "Z", 0.6)
	for k = 0, 3 do
		local a = k / 4 * math.pi * 2
		local blade = b:box(V(2.6, 14, 0.3), CF(0, 22, -6) * ANG(0, 0, a) * CF(0, 7.5, 0), rgb(240, 240, 235), { role = "fixed", material = Enum.Material.Fabric })
		blade.Parent = hub
	end
	b:box(V(3, 5, 1), CF(0, 2.5, -5.5), rgb(110, 70, 40), { role = "fixed", material = Enum.Material.WoodPlanks })
	return { model = b.model, radius = 9, height = 32, center = V(0, 12, 0) }
end

local function ferris(b: any, _rng: any): BuildingResult
	local steel = rgb(200, 205, 215)
	for _, side in { -1, 1 } do
		b:beam(V(side * 3, 0, -12), V(side * 3, 24, 0), 1, steel, { role = "primary" })
		b:beam(V(side * 3, 0, 12), V(side * 3, 24, 0), 1, steel, { role = "primary" })
	end
	local hub = b:part("cyl", V(7, 3, 3), CF(0, 24, 0), rgb(255, 210, 60), { role = "fixed", name = "Eixo" })
	spinTag(hub, "X", 0.25)
	for k = 0, 9 do
		local a = k / 10 * math.pi * 2
		local spoke = b:box(V(0.5, 20, 0.5), CF(0, 24, 0) * ANG(a, 0, 0) * CF(0, 10, 0), steel, { role = "primary" })
		spoke.Parent = hub
		local cab = b:box(V(4, 3, 3), CF(0, 24, 0) * ANG(a, 0, 0) * CF(0, 20, 0), Kit.RainbowColors[(k % 6) + 1], { role = "accent" })
		cab.Parent = hub
		local bulb = b:ball(0.8, CF(0, 24, 0) * ANG(a + 0.3, 0, 0) * CF(0, 20, 0), rgb(255, 250, 200), { role = "fixed", material = Enum.Material.Neon })
		bulb.Parent = hub
	end
	return { model = b.model, radius = 22, height = 46, center = V(0, 24, 0) }
end

local function igloo(b: any, _rng: any): BuildingResult
	local ice = rgb(230, 245, 255)
	for ring = 0, 4 do
		local y = ring * 2.2
		local r = 9 * math.cos(math.asin(math.min(y / 11, 0.99)))
		local n = math.max(6, math.floor(r * 1.4))
		for k = 0, n - 1 do
			local a = k / n * math.pi * 2 + ring * 0.2
			if not (ring < 2 and math.abs(a - math.pi * 1.5) < 0.35) then
				b:box(V(r * 6.3 / n + 0.3, 2.2, 1.6), CF(math.cos(a) * r, y + 1.1, math.sin(a) * r) * ANG(0, -a + math.pi / 2, 0), ice, { role = "primary", material = Enum.Material.Ice })
			end
		end
	end
	b:part("ball", V(9, 4, 9), CF(0, 10, 0), ice, { role = "primary", material = Enum.Material.Ice })
	b:box(V(4, 4, 5), CF(0, 2, -10), ice, { role = "primary", material = Enum.Material.Ice, transparency = 0.0 })
	return { model = b.model, radius = 11, height = 12, center = V(0, 4, 0) }
end

local function tent(b: any, rng: any): BuildingResult
	local col = rng:pick({ rgb(230, 120, 40), rgb(60, 150, 90), rgb(60, 110, 200) })
	b:part("wedge", V(10, 7, 6), CF(0, 3.5, 3), col, { role = "primary", material = Enum.Material.Fabric })
	b:part("wedge", V(10, 7, 6), CF(0, 3.5, -3) * ANG(0, rad(180), 0), col, { role = "primary", material = Enum.Material.Fabric })
	local fire = b:ball(1.4, CF(0, 0.8, -9), rgb(255, 140, 40), { role = "fixed", material = Enum.Material.Neon, collide = false })
	local f = Instance.new("Fire")
	f.Size = 4
	f.Parent = fire
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		b:box(V(0.6, 0.6, 2.4), CF(math.cos(a) * 1.6, 0.3, -9 + math.sin(a) * 1.6) * ANG(0, -a, 0), rgb(110, 70, 40), { role = "fixed" })
	end
	return { model = b.model, radius = 9, height = 8, center = V(0, 3, 0) }
end

local function temple(b: any, _rng: any): BuildingResult
	local marble = rgb(240, 238, 230)
	for k = 0, 2 do
		b:box(V(40 - k * 3, 1.2, 28 - k * 3), CF(0, 0.6 + k * 1.2, 0), marble, { role = "primary", material = Enum.Material.Marble })
	end
	for _, z in { -11, 11 } do
		for k = -4, 4 do
			b:cylY(14, 2, CF(k * 4, 3.6 + 7, z), marble, { role = "primary", material = Enum.Material.Marble })
		end
	end
	b:box(V(38, 2, 26), CF(0, 18.6, 0), marble, { role = "primary", material = Enum.Material.Marble })
	b:roof(38, 26, 6, CF(0, 19.6, 0) * ANG(0, rad(90), 0), Kit.darker(marble, 0.08), { role = "secondary", material = Enum.Material.Marble })
	b:ball(2.4, CF(0, 6, 0), rgb(255, 210, 90), { role = "fixed", material = Enum.Material.Neon })
	return { model = b.model, radius = 21, height = 26, center = V(0, 8, 0) }
end

local function sign(part: BasePart, text: string, color: Color3)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(400, 100)
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color
	label.Font = Enum.Font.GothamBlack
	label.Parent = gui
	gui.Parent = part
end

local function shopOrSchool(b: any, rng: any, kind: string): BuildingResult
	local w, d, h = 26, 18, 10
	local col = if kind == "school" then rgb(230, 180, 120) else rng:pick(WALLS)
	b:box(V(w + 2, 1, d + 2), CF(0, 0.5, 0), rgb(150, 150, 150), { role = "secondary", material = Enum.Material.Concrete })
	wall(b, w, h, CF(0, 1, -d / 2), col, true, 4, Enum.Material.Brick)
	wall(b, w, h, CF(0, 1, d / 2), col, false, 4, Enum.Material.Brick)
	wall(b, d, h, CF(-w / 2, 1, 0) * ANG(0, rad(90), 0), col, false, 2, Enum.Material.Brick)
	wall(b, d, h, CF(w / 2, 1, 0) * ANG(0, rad(90), 0), col, false, 2, Enum.Material.Brick)
	b:box(V(w + 1, 1, d + 1), CF(0, h + 1.5, 0), Kit.darker(col, 0.25), { role = "secondary" })
	local board = b:box(V(16, 3.2, 0.5), CF(0, h + 3.6, -d / 2 - 0.2) * ANG(0, rad(180), 0), rgb(30, 30, 40), { role = "fixed" })
	sign(board, if kind == "school" then "ESCOLA" else "LOJA", if kind == "school" then rgb(255, 230, 120) else rgb(120, 255, 220))
	for k = -3, 3 do
		b:box(V(3.6, 0.3, 4), CF(k * 3.6, 8.3, -d / 2 - 2) * ANG(rad(-15), 0, 0), if k % 2 == 0 then rgb(230, 60, 60) else rgb(250, 250, 250), { role = "fixed", material = Enum.Material.Fabric })
	end
	return { model = b.model, radius = w / 2 + 3, height = h + 6, door = V(0, 1, -d / 2 - 3), center = V(0, 5, 0) }
end

local function farm(b: any, _rng: any): BuildingResult
	local red = rgb(180, 45, 40)
	local white = rgb(245, 245, 240)
	b:box(V(22, 14, 18), CF(0, 7, 10), red, { role = "primary", material = Enum.Material.WoodPlanks })
	b:roof(24, 20, 8, CF(0, 14, 10) * ANG(0, rad(90), 0), rgb(90, 90, 95), { role = "secondary" })
	b:box(V(8, 9, 0.4), CF(0, 4.5, 0.9), white, { role = "fixed" })
	b:box(V(0.6, 11, 0.5), CF(0, 4.5, 0.7) * ANG(0, 0, rad(40)), white, { role = "fixed" })
	b:box(V(0.6, 11, 0.5), CF(0, 4.5, 0.7) * ANG(0, 0, rad(-40)), white, { role = "fixed" })
	b:cylY(20, 7, CF(16, 10, 14), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal })
	b:part("ball", V(7, 4, 7), CF(16, 20, 14), rgb(180, 45, 40), { role = "secondary" })
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		local p = V(math.cos(a) * 30, 1.5, math.sin(a) * 30 - 6)
		b:box(V(0.6, 3, 0.6), CF(p), rgb(150, 105, 60), { role = "fixed", material = Enum.Material.Wood })
		local p2 = V(math.cos(a + math.pi / 16 * 2) * 30, 2.2, math.sin(a + math.pi / 16 * 2) * 30 - 6)
		b:beam(p + V(0, 0.7, 0), p2, 0.3, rgb(150, 105, 60), { role = "fixed" })
	end
	for k = 0, 2 do
		b:part("cyl", V(3, 3, 3), CF(-14 + k * 3.4, 1.5, -4) * ANG(0, rad(90), 0), rgb(230, 200, 90), { role = "fixed", material = Enum.Material.Fabric })
	end
	return { model = b.model, radius = 31, height = 22, center = V(0, 5, 4) }
end

local function treehouse(b: any, _rng: any): BuildingResult
	local bark = rgb(110, 75, 45)
	b:cylY(26, 5, CF(0, 13, 0), bark, { role = "fixed", material = Enum.Material.Wood })
	for k = 0, 6 do
		local a = k / 7 * math.pi * 2
		b:ball(12, CF(math.cos(a) * 7, 30 + (k % 2) * 3, math.sin(a) * 7), rgb(70, 150, 60), { role = "fixed", material = Enum.Material.Grass })
	end
	b:ball(14, CF(0, 34, 0), rgb(80, 165, 65), { role = "fixed", material = Enum.Material.Grass })
	b:box(V(16, 1, 16), CF(0, 16, 0), rgb(150, 105, 65), { role = "primary", material = Enum.Material.WoodPlanks })
	b:box(V(10, 7, 10), CF(4, 20, 2), rgb(170, 120, 75), { role = "primary", material = Enum.Material.WoodPlanks })
	b:roof(11, 11, 4, CF(4, 23.5, 2) * ANG(0, rad(90), 0), rgb(150, 60, 45), { role = "secondary" })
	for k = 0, 7 do
		b:box(V(3, 0.4, 0.6), CF(0, 1 + k * 2, -3), rgb(150, 105, 65), { role = "fixed", material = Enum.Material.Wood })
	end
	return { model = b.model, radius = 10, height = 40, center = V(0, 16, 0) }
end

local function portal(b: any, _rng: any): BuildingResult
	local stone = rgb(90, 85, 100)
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		b:box(V(3.4, 3.4, 2.4), CF(math.cos(a) * 9, 10 + math.sin(a) * 9, 0) * ANG(0, 0, a), stone, { role = "primary", material = Enum.Material.Slate })
		if k % 3 == 0 then
			b:ball(1.2, CF(math.cos(a) * 9, 10 + math.sin(a) * 9, -1.3), rgb(180, 90, 255), { role = "accent", material = Enum.Material.Neon })
		end
	end
	local disc = b:part("cyl", V(0.5, 16, 16), CF(0, 10, 0) * ANG(0, rad(90), 0), rgb(170, 90, 255), { role = "accent", material = Enum.Material.Neon, transparency = 0.35, collide = false, name = "Vortice" })
	spinTag(disc, "X", 1.5)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Rate = 20
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(2, 6)
	e.Color = ColorSequence.new(rgb(200, 130, 255), rgb(90, 200, 255))
	e.Parent = disc
	b:box(V(22, 1, 8), CF(0, 0.5, 0), stone, { role = "secondary", material = Enum.Material.Slate })
	return { model = b.model, radius = 11, height = 20, center = V(0, 10, 0) }
end

local function cage(b: any, _rng: any): BuildingResult
	local steel = rgb(110, 110, 120)
	local s = 14
	b:box(V(s + 2, 1, s + 2), CF(0, 0.5, 0), steel, { role = "primary", material = Enum.Material.DiamondPlate })
	b:box(V(s + 2, 1, s + 2), CF(0, 14.5, 0), steel, { role = "primary", material = Enum.Material.DiamondPlate })
	for k = 0, 23 do
		local side = k // 6
		local t = (k % 6) / 6 * s - s / 2 + s / 12
		local x, z = 0, 0
		if side == 0 then
			x, z = t, -s / 2
		elseif side == 1 then
			x, z = s / 2, t
		elseif side == 2 then
			x, z = -t, s / 2
		else
			x, z = -s / 2, -t
		end
		b:cylY(13, 0.6, CF(x, 7.5, z), steel, { role = "primary", material = Enum.Material.Metal })
	end
	return { model = b.model, radius = s / 2 + 1, height = 15, center = V(0, 3, 0) }
end

local function ring(b: any, _rng: any): BuildingResult
	local s = 34
	b:box(V(s, 2, s), CF(0, 1, 0), rgb(40, 60, 140), { role = "primary" })
	b:box(V(s - 2, 0.2, s - 2), CF(0, 2.1, 0), rgb(240, 240, 245), { role = "fixed", material = Enum.Material.Fabric })
	for _, x in { -s / 2, s / 2 } do
		for _, z in { -s / 2, s / 2 } do
			b:cylY(8, 1, CF(x, 5, z), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal })
		end
	end
	for k = 1, 3 do
		local y = 2 + k * 1.8
		for _, e in { { 0, -s / 2, 0 }, { 0, s / 2, 0 }, { -s / 2, 0, 90 }, { s / 2, 0, 90 } } do
			b:box(V(s, 0.3, 0.3), CF(e[1], y, e[2]) * ANG(0, rad(e[3]), 0), if k == 2 then rgb(250, 250, 250) else rgb(220, 40, 40), { role = "accent" })
		end
	end
	return { model = b.model, radius = s / 2 + 2, height = 9, center = V(0, 4, 0) }
end

local function stairs(b: any, _rng: any): BuildingResult
	for k = 0, 24 do
		local a = k * 0.35
		b:box(V(8, 1, 4), CF(math.cos(a) * 8, 1 + k * 2, -12 + math.sin(a) * 8) * ANG(0, -a, 0), Kit.RainbowColors[(k % 6) + 1], { role = "accent" })
	end
	b:cylY(52, 3, CF(0, 26, -12), rgb(240, 240, 250), { role = "fixed", material = Enum.Material.Marble })
	b:ball(6, CF(0, 54, -12), rgb(255, 230, 120), { role = "fixed", material = Enum.Material.Neon })
	return { model = b.model, radius = 12, height = 56, center = V(0, 2, -12) }
end

local function slide(b: any, _rng: any): BuildingResult
	local col = rgb(250, 180, 40)
	for _, x in { -3, 3 } do
		for _, z in { -3, 3 } do
			b:cylY(16, 0.8, CF(x, 8, z), rgb(220, 60, 60), { role = "secondary" })
		end
	end
	b:box(V(7, 1, 7), CF(0, 16, 0), rgb(60, 140, 230), { role = "primary" })
	for k = 0, 7 do
		b:box(V(4, 0.4, 0.6), CF(0, 1.5 + k * 2, 4), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal })
	end
	b:part("wedge", V(5, 16, 26), CF(0, 8, -16.5) * ANG(0, rad(180), 0), col, { role = "accent", material = Enum.Material.SmoothPlastic })
	return { model = b.model, radius = 15, height = 18, center = V(0, 8, -8) }
end

local function trampoline(b: any, _rng: any): BuildingResult
	b:cylY(2, 18, CF(0, 1, 0), rgb(40, 40, 50), { role = "secondary" })
	for k = 0, 5 do
		local a = k / 6 * math.pi * 2
		b:cylY(1.4, 0.8, CF(math.cos(a) * 8, 0.7, math.sin(a) * 8), rgb(200, 200, 210), { role = "fixed", material = Enum.Material.Metal })
	end
	local pad = b:cylY(0.4, 16, CF(0, 2.1, 0), rgb(60, 200, 255), { role = "accent", material = Enum.Material.Neon, name = "Pulo" })
	pad:AddTag("IdeiasPulo")
	pad:SetAttribute("Forca", 140)
	return { model = b.model, radius = 9, height = 3, center = V(0, 2, 0) }
end

local function pool(b: any, _rng: any): BuildingResult
	local tile = rgb(240, 240, 245)
	b:box(V(30, 1, 20), CF(0, 0.5, 0), tile, { role = "primary", material = Enum.Material.Marble })
	for _, e in { { 0, -10.5, 30, 1 }, { 0, 10.5, 30, 1 }, { -15.5, 0, 1, 22 }, { 15.5, 0, 1, 22 } } do
		b:box(V(e[3], 3, e[4]), CF(e[1], 1.5, e[2]), tile, { role = "primary", material = Enum.Material.Marble })
	end
	b:box(V(30, 2, 20), CF(0, 2, 0), rgb(70, 170, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.45, collide = false, name = "Agua" })
	return { model = b.model, radius = 16, height = 4, center = V(0, 2, 0) }
end

local function island(b: any, _rng: any): BuildingResult
	local y = 40
	b:cylY(4, 30, CF(0, y, 0), rgb(90, 170, 70), { role = "primary", material = Enum.Material.Grass })
	b:cone(22, 30, CF(0, y - 2, 0) * ANG(rad(180), 0, 0), rgb(120, 95, 75), 5, { role = "secondary", material = Enum.Material.Slate })
	b:cylY(10, 2, CF(5, y + 7, 3), rgb(110, 75, 45), { role = "fixed", material = Enum.Material.Wood })
	b:ball(9, CF(5, y + 14, 3), rgb(255, 160, 210), { role = "fixed", material = Enum.Material.Grass })
	local fall = b:box(V(4, 30, 1), CF(-12, y - 14, -6), rgb(120, 200, 255), { role = "fixed", material = Enum.Material.Glass, transparency = 0.4, collide = false })
	local _ = fall
	for k = 0, 6 do
		b:box(V(6, 1, 6), CF(-20 + k * 2, 2 + k * 5.5, 26 - k * 4), rgb(240, 240, 255), { role = "fixed", material = Enum.Material.SmoothPlastic })
	end
	return { model = b.model, radius = 16, height = y + 20, center = V(0, y + 2, 0) }
end

local BUILDERS: { [string]: (any, any) -> BuildingResult } = {
	house = function(b, rng)
		return house(b, rng, false)
	end,
	mansion = function(b, rng)
		return house(b, rng, true)
	end,
	skyscraper = skyscraper,
	tower = tower,
	castle = castle,
	bridge = bridge,
	wall = wallB,
	maze = maze,
	pyramid = pyramid,
	lighthouse = lighthouse,
	windmill = windmill,
	ferris_wheel = ferris,
	igloo = igloo,
	tent = tent,
	temple = temple,
	school = function(b, rng)
		return shopOrSchool(b, rng, "school")
	end,
	shop = function(b, rng)
		return shopOrSchool(b, rng, "shop")
	end,
	farm = farm,
	treehouse = treehouse,
	portal = portal,
	cage = cage,
	ring = ring,
	stairs = stairs,
	slide = slide,
	trampoline = trampoline,
	pool = pool,
	floating_island = island,
}

-- cidade: várias construções menores lado a lado com ruas
local function city(origin: CFrame, params: { [string]: any }, rng: any): BuildingResult
	local b = Kit.new("city", origin, params)
	b:box(V(110, 0.4, 110), CF(0, 0.2, -55), rgb(60, 60, 65), { role = "fixed", material = Enum.Material.Asphalt })
	for _, z in { -55 } do
		b:box(V(110, 0.45, 2), CF(0, 0.25, z), rgb(250, 220, 60), { role = "fixed" })
		b:box(V(2, 0.45, 110), CF(0, 0.25, z), rgb(250, 220, 60), { role = "fixed" })
	end
	local model = b:finish()
	local kinds = { "skyscraper", "house", "shop", "skyscraper", "school", "house" }
	local spots = { V(-30, 0, -25), V(30, 0, -25), V(-30, 0, -85), V(30, 0, -85), V(-30, 0, -55 + 0.01), V(30, 0, -55) }
	for i = 1, 4 do
		local kind = kinds[((i + rng:int(0, 5)) % #kinds) + 1]
		local sub = Kit.new(kind, origin * CF(spots[i] * b.s), params)
		local r = BUILDERS[kind](sub, rng)
		sub:finish()
		r.model.Parent = model
	end
	return { model = model, radius = 56 * b.s, height = 70 * b.s, center = (origin * CF(V(0, 10, -55) * b.s)).Position }
end

function Buildings.build(origin: CFrame, params: { [string]: any }, variant: string): BuildingResult
	local rng = params.rng
	if variant == "city" then
		return city(origin, params, rng)
	end
	local b = Kit.new(variant, origin, params)
	local f = BUILDERS[variant] or BUILDERS.house
	local r = f(b, rng)
	b:finish()
	r.radius *= b.s
	r.height *= b.s
	r.center = (origin * CF(r.center * b.s)).Position
	if r.door then
		r.door = (origin * CF(r.door * b.s)).Position
	end
	return r
end

Buildings.Variants = BUILDERS
Buildings.sign = sign

return Buildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Figures</string>
            <string name="Source"><![CDATA[--!strict
-- Personagens humanoides procedurais. Um corpo base (pernas, tronco, braços,
-- cabeça) + "traje" de dados + acessórios. Cada traje muda proporções, cores,
-- materiais e adiciona peças (chapéus, capas, asas, armas, barbas...).

local Rig = require(script.Parent.Rig)
local Kit = require(script.Parent.Kit)

local Figures = {}

local rgb = Color3.fromRGB
local SKIN = { rgb(255, 214, 170), rgb(224, 172, 128), rgb(176, 120, 82), rgb(120, 78, 50), rgb(92, 60, 40) }

type Outfit = {
	skin: Color3?,
	shirt: Color3,
	pants: Color3,
	shoes: Color3?,
	hair: Color3?,
	hairStyle: string?,
	mat: Enum.Material?,
	robe: Color3?,
	bulk: number?, -- largura extra
	tall: number?, -- altura extra
	headSize: number?,
	acc: { string }?, -- acessórios
	eye: Color3?,
	glowEyes: boolean?,
	pose: string?,
	accent: Color3?,
	cape: Color3?,
	gloves: Color3?,
	glow: Color3?,
}

