      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[--!strict
-- Catálogo de dados do jogo: reúne conceitos, modificadores, gramática, regras
-- de interação e segredos, e valida tudo na carga. Para adicionar um novo
-- acontecimento basta incluir um item em um dos arquivos de dados.

local Modifiers = require(script.Modifiers)
local Grammar = require(script.Grammar)
local Interactions = require(script.Interactions)
local Secrets = require(script.Secrets)

local Catalog = {}

Catalog.Modifiers = Modifiers
Catalog.Grammar = Grammar
Catalog.Interactions = Interactions
Catalog.Secrets = Secrets

-- Eixos de modificadores aceitos por categoria
Catalog.CategoryAxes = {
	creature = { "size", "rank", "element", "material", "trait", "speed", "faction", "flight", "behavior", "color" },
	vehicle = { "size", "element", "material", "trait", "speed", "flight", "color" },
	building = { "size", "element", "material", "trait", "flight", "color" },
	object = { "size", "element", "material", "trait", "flight", "color" },
	food = { "size", "element", "material", "flight", "color" },
	nature = { "size", "element", "material", "flight", "color" },
	disaster = { "size", "element", "speed", "color" },
	weather = { "element", "color" },
	magic = { "element", "color" },
	power = { "element", "color", "speed" },
	tool = { "size", "element", "material", "color" },
}

Catalog.CategoryInfo = {
	creature = { label = "Criaturas", icon = "🐉", order = 1 },
	disaster = { label = "Desastres", icon = "🌪️", order = 2 },
	vehicle = { label = "Veículos", icon = "🚗", order = 3 },
	building = { label = "Construções", icon = "🏰", order = 4 },
	object = { label = "Objetos", icon = "📺", order = 5 },
	food = { label = "Comidas", icon = "🍕", order = 6 },
	nature = { label = "Natureza", icon = "🌳", order = 7 },
	weather = { label = "Clima", icon = "🌈", order = 8 },
	magic = { label = "Magia", icon = "✨", order = 9 },
	power = { label = "Poderes", icon = "⚡", order = 10 },
	tool = { label = "Ferramentas", icon = "🗡️", order = 11 },
}

local HANDLERS = {
	npc = true,
	vehicle = true,
	building = true,
	prop = true,
	disaster = true,
	world = true,
	power = true,
	tool = true,
	composite = true,
	blessing = true,
}

Catalog.Concepts = {} :: { any }
Catalog.ById = {} :: { [string]: any }
Catalog.ModifierById = {} :: { [string]: any }

local sources = {
	require(script.Creatures),
	require(script.Vehicles),
	require(script.Buildings),
	require(script.Objects),
	require(script.Phenomena),
	require(script.Powers),
	require(script.Characters),
}

for _, list in sources do
	for _, def in list do
		table.insert(Catalog.Concepts, def)
	end
end

for _, def in Catalog.Concepts do
	Catalog.ById[def.id] = def
	def.maxCount = def.maxCount or 1
	def.lifetime = def.lifetime or 60
	def.params = def.params or {}
	def.tags = def.tags or {}
	local tagSet = {}
	for _, t in def.tags do
		tagSet[t] = true
	end
	def.tagSet = tagSet
	local axes = {}
	for _, axis in Catalog.CategoryAxes[def.category] or {} do
		axes[axis] = true
	end
	def.axes = axes
end

for _, mod in Modifiers do
	Catalog.ModifierById[mod.id] = mod
end

-- Validação estrutural: retorna lista de erros (vazia = tudo certo)
function Catalog.validate(): { string }
	local errors = {}
	local seen = {}
	for _, def in Catalog.Concepts do
		if type(def.id) ~= "string" or not string.match(def.id, "^[%l%d_]+$") then
			table.insert(errors, "id inválido: " .. tostring(def.id))
		end
		if seen[def.id] then
			table.insert(errors, "id duplicado: " .. def.id)
		end
		seen[def.id] = true
		if not Catalog.CategoryAxes[def.category] then
			table.insert(errors, def.id .. ": categoria desconhecida " .. tostring(def.category))
		end
		if not HANDLERS[def.handler] then
			table.insert(errors, def.id .. ": handler desconhecido " .. tostring(def.handler))
		end
		if type(def.label) ~= "string" or #def.label == 0 then
			table.insert(errors, def.id .. ": sem rótulo")
		end
		if type(def.aliases) ~= "table" or #def.aliases == 0 then
			table.insert(errors, def.id .. ": sem aliases")
		end
		if def.asModifier and not Catalog.ModifierById[def.asModifier] then
			table.insert(errors, def.id .. ": asModifier inexistente " .. def.asModifier)
		end
		if def.handler == "composite" then
			for _, part in def.params.compose or {} do
				if not Catalog.ById[part.id] then
					table.insert(errors, def.id .. ": compose referencia " .. tostring(part.id))
				end
			end
		end
	end
	local modSeen = {}
	for _, mod in Modifiers do
		if modSeen[mod.id] then
			table.insert(errors, "modificador duplicado: " .. mod.id)
		end
		modSeen[mod.id] = true
		if mod.standalone and not Catalog.ById[mod.standalone] then
			table.insert(errors, "modificador " .. mod.id .. ": standalone inexistente " .. mod.standalone)
		end
	end
	for _, secret in Secrets do
		local m = secret.match
		if m.concept and not Catalog.ById[m.concept] then
			table.insert(errors, "segredo " .. secret.id .. ": conceito " .. m.concept)
		end
		for _, c in m.concepts or {} do
			if not Catalog.ById[c] then
				table.insert(errors, "segredo " .. secret.id .. ": conceito " .. c)
			end
		end
		for _, mid in m.mods or {} do
			if not Catalog.ModifierById[mid] then
				table.insert(errors, "segredo " .. secret.id .. ": modificador " .. mid)
			end
		end
	end
	return errors
end

return Catalog
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Buildings</string>
            <string name="Source"><![CDATA[--!strict
-- Construções (handler "building"). Aparecem à frente do jogador com animação
-- de "montagem" e ficam ancoradas até expirar.

local function bld(id: string, label: string, gender: string, aliases: { string }, params: { [string]: any }, tags: { string }, extra: { [string]: any }?)
	local def: { [string]: any } = {
		id = id,
		label = label,
		gender = gender,
		category = "building",
		handler = "building",
		aliases = aliases,
		params = params,
		tags = tags,
		maxCount = 2,
		lifetime = 100,
	}
	if extra then
		for k, v in extra do
			def[k] = v
		end
	end
	return def
end

return {
	bld("house", "Casa", "f", { "casa", "house", "home", "lar", "chale", "cabana", "barraco", "cottage" }, { model = "building", variant = "house" }, { "building", "home" }),
	bld("mansion", "Mansão", "f", { "mansao", "mansion", "palacete", "casarao", "villa" }, { model = "building", variant = "mansion" }, { "building", "home" }, { maxCount = 1 }),
	bld("skyscraper", "Arranha-céu", "m", { "arranha ceu", "predio", "skyscraper", "edificio", "torre comercial", "building" }, { model = "building", variant = "skyscraper" }, { "building", "city" }),
	bld("tower", "Torre", "f", { "torre", "tower", "torre de vigia", "atalaia", "minarete" }, { model = "building", variant = "tower" }, { "building" }),
	bld("castle", "Castelo", "m", { "castelo", "castle", "fortaleza", "fortress", "forte", "cidadela", "palacio", "palace" }, { model = "building", variant = "castle" }, { "building", "medieval" }, { maxCount = 1, lifetime = 120 }),
	bld("bridge", "Ponte", "f", { "ponte", "bridge", "passarela", "viaduto" }, { model = "building", variant = "bridge" }, { "building" }),
	bld("wall", "Muralha", "f", { "muralha", "muro", "wall", "parede", "barreira", "barricada" }, { model = "building", variant = "wall" }, { "building" }),
	bld("maze", "Labirinto", "m", { "labirinto", "maze", "labyrinth", "dedalo" }, { model = "building", variant = "maze" }, { "building", "puzzle" }, { maxCount = 1, lifetime = 140 }),
	bld("pyramid", "Pirâmide", "f", { "piramide", "pyramid", "piramide egipcia", "zigurate" }, { model = "building", variant = "pyramid" }, { "building", "ancient" }, { maxCount = 1 }),
	bld("lighthouse", "Farol", "m", { "farol", "lighthouse" }, { model = "building", variant = "lighthouse" }, { "building" }),
	bld("windmill", "Moinho", "m", { "moinho", "windmill", "moinho de vento", "cata vento", "turbina eolica" }, { model = "building", variant = "windmill" }, { "building", "farm" }),
	bld("ferris_wheel", "Roda-gigante", "f", { "roda gigante", "ferris wheel", "parque de diversoes", "carrossel", "carousel" }, { model = "building", variant = "ferris_wheel" }, { "building", "fun" }, { maxCount = 1 }),
	bld("statue", "Estátua", "f", { "estatua", "statue", "monumento", "escultura", "busto" }, { model = "building", variant = "statue" }, { "building", "art" }),
	bld("igloo", "Iglu", "m", { "iglu", "igloo", "oca de gelo" }, { model = "building", variant = "igloo" }, { "building", "ice" }),
	bld("tent", "Barraca", "f", { "barraca", "tenda", "tent", "acampamento", "camping", "oca", "tipi" }, { model = "building", variant = "tent" }, { "building" }),
	bld("temple", "Templo", "m", { "templo", "temple", "santuario", "shrine", "ruina", "ruins", "coliseu romano", "parthenon" }, { model = "building", variant = "temple" }, { "building", "ancient" }, { maxCount = 1 }),
	bld("school", "Escola", "f", { "escola", "school", "colegio", "faculdade", "universidade", "biblioteca", "library" }, { model = "building", variant = "school" }, { "building", "city" }),
	bld("shop", "Loja", "f", { "loja", "shop", "mercado", "supermercado", "padaria", "lanchonete", "restaurante", "store", "shopping" }, { model = "building", variant = "shop" }, { "building", "city", "food" }),
	bld("farm", "Fazenda", "f", { "fazenda", "farm", "celeiro", "barn", "sitio", "rancho", "curral", "chacara" }, { model = "building", variant = "farm" }, { "building", "farm" }, { maxCount = 1 }),
	bld("city", "Cidade", "f", { "cidade", "city", "metropole", "bairro", "cidadezinha", "vila", "village", "vilarejo", "povoado" }, { model = "building", variant = "city" }, { "building", "city" }, { maxCount = 1, lifetime = 110 }),
