        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Grammar</string>
            <string name="Source"><![CDATA[--!strict
-- Palavras de ligação, quantificadores, regiões e palavras ignoradas.

local Grammar = {}

-- Relações entre ideias. "of" e "location" dependem do contexto (ver Parser).
Grammar.Relations = {
	conjunction = { "e", "and", "com", "with", "mais", "plus", "junto com", "tambem", "alem de", "," },
	versus = {
		"contra",
		"vs",
		"versus",
		"x",
		"enfrentando",
		"lutando com",
		"lutando contra",
		"brigando com",
		"brigando contra",
		"against",
		"fighting",
		"versus o",
		"batalhando com",
		"atacando",
		"attacking",
	},
	guard = {
		"protegendo",
		"guardando",
		"defendendo",
		"protege",
		"guarda",
		"defende",
		"guarding",
		"protecting",
		"defending",
		"vigiando",
		"cuidando de",
		"cuidando do",
		"cuidando da",
	},
	ride = {
		"dirigindo",
		"pilotando",
		"montando",
		"montado em",
		"montado no",
		"montada no",
		"montado na",
		"riding",
		"driving",
		"piloting",
		"em cima de",
		"em cima do",
		"em cima da",
		"dentro de",
		"dentro do",
		"dentro da",
		"inside",
	},
	location = { "em", "no", "na", "nos", "nas", "in", "on", "at", "perto de", "perto do", "perto da", "near" },
	of = { "de", "do", "da", "dos", "das", "of", "feito de", "feita de", "made of", "cheio de", "cheia de", "full of" },
}

-- Verbos de ação: montam cadeias ("arma que atira cachorro", "cachorro caga
-- elefante", "elefante explode"). Transitivos pedem um objeto (o que vem
-- depois); os demais mudam o próprio sujeito.
Grammar.TransitiveVerbs = { shoot = true, spawn = true, transform = true }
Grammar.Verbs = {
	shoot = { "atira", "atiram", "atirando", "atirar", "atire", "dispara", "disparam", "disparando", "disparar", "lanca", "lancam", "lancando", "arremessa", "arremessam", "arremessando", "joga", "jogam", "jogando", "shoots", "shoot", "shooting", "fires", "throws", "launches" },
	spawn = { "caga", "cagam", "cagando", "cagar", "bota", "botam", "botando", "poe", "poem", "pondo", "solta", "soltam", "soltando", "cospe", "cospem", "cuspindo", "vomita", "vomitam", "vomitando", "espirra", "espirram", "espirrando", "invoca", "invocam", "invocando", "gera", "geram", "gerando", "fabrica", "fabricam", "fabricando", "produz", "produzem", "produzindo", "pare", "parindo", "poops", "spawns", "summons", "lays", "spits", "vomits", "drops" },
	transform = { "vira", "viram", "virando", "virar", "se transforma em", "transforma em", "se transformam em", "se transforma", "transforma", "transformando", "turns into", "becomes", "evolui para", "evolui" },
	explode = { "explode", "explodem", "explodindo", "explodir", "exploda", "explodes", "explodiu", "estoura", "estouram", "estourando" },
	burn = { "pega fogo", "pegam fogo", "pegando fogo", "queima", "queimando", "burns", "catches fire" },
	freeze = { "congela", "congelam", "congelando" },
	fly = { "voa", "voam", "flies", "sai voando", "levanta voo" },
	dance = { "danca", "dancam", "dances" },
	multiply = { "multiplica", "multiplicam", "se multiplica", "se multiplicam", "multiplicando", "se clona", "se clonam", "duplica", "multiplies" },
	grow = { "cresce", "crescem", "crescendo", "grows" },
	shrink = { "encolhe", "encolhem", "encolhendo", "diminui", "shrinks" },
	sing = { "canta", "cantam", "cantando", "sings", "singing" },
}

-- Rótulo curto de cada verbo (usado quando o jogador não escreveu o verbo)
Grammar.VerbLabels = {
	shoot = "atira",
	spawn = "solta",
	transform = "vira",
	explode = "explode",
	burn = "pega fogo",
	freeze = "congela",
	fly = "voa",
	dance = "dança",
	multiply = "se multiplica",
	grow = "cresce",
	shrink = "encolhe",
	sing = "canta",
}

-- Quantificadores: {frases, quantidade, chuva?}
Grammar.Quantifiers = {
	{ phrases = { "chuva de", "chovendo", "rain of", "raining", "caindo do ceu", "chuva com" }, count = 1, rain = true },
	{ phrases = { "tempestade de", "storm of", "diluvio de", "temporal de" }, count = 1, rain = true, heavy = true },
	{ phrases = { "horda de", "horde of", "invasao de" }, count = 10 },
	{ phrases = { "exercito de", "army of", "legiao de", "tropa de" }, count = 12 },
	{ phrases = { "enxame de", "swarm of", "nuvem de" }, count = 10 },
	{ phrases = { "manada de", "rebanho de", "bando de", "pack of", "herd of", "flock of", "matilha de" }, count = 6 },
	{ phrases = { "cardume de", "school of" }, count = 8 },
	{ phrases = { "frota de", "fleet of", "comboio de" }, count = 4 },
	{ phrases = { "monte de", "um monte de", "pilha de", "lots of", "a lot of", "bunch of", "varios", "varias", "several" }, count = 5 },
	{ phrases = { "muitos", "muitas", "many", "infinitos", "infinitas", "milhares de", "thousands of", "centenas de" }, count = 8 },
	{ phrases = { "par de", "pair of", "dupla de" }, count = 2 },
	{ phrases = { "trio de" }, count = 3 },
}

-- Intensificadores aumentam o efeito do próximo modificador de tamanho/velocidade
Grammar.Intensifiers = { "muito", "muita", "super", "mega", "ultra", "very", "really", "bem", "extremamente", "hiper", "demais", "too" }

-- Referência ao próprio jogador ("dragão me protegendo")
Grammar.Self = { "me", "mim", "eu", "comigo", "myself", "meu", "minha" }

-- Regiões do mapa (usadas depois de "no", "na", "em"...)
Grammar.Regions = {
	{ id = "hub", label = "Centro de Criação", aliases = { "centro", "praca", "hub", "spawn", "centro de criacao", "palco", "inicio" } },
	{ id = "forest", label = "Floresta Encantada", aliases = { "floresta", "mata", "bosque", "selva", "forest", "jungle", "floresta encantada" } },
	{ id = "city", label = "Cidade Neon", aliases = { "cidade", "cidade neon", "metropole", "city", "downtown" } },
	{ id = "glacier", label = "Região Glacial", aliases = { "geleira", "regiao glacial", "polo norte", "polo", "tundra", "glacier", "artico", "neve" } },
	{ id = "volcano", label = "Região Vulcânica", aliases = { "vulcao", "regiao vulcanica", "volcano", "lava", "inferno" } },
	{ id = "desert", label = "Deserto das Ruínas", aliases = { "deserto", "desert", "piramides", "ruinas", "dunas", "saara" } },
	{ id = "sky", label = "Céu", aliases = { "ceu", "sky", "nuvens", "ar", "alto", "ilhas flutuantes", "ilhas", "espaco" } },
	{ id = "arena", label = "Arena Subterrânea", aliases = { "arena", "arena subterranea", "subsolo", "coliseu", "underground" } },
	{ id = "beach", label = "Praia", aliases = { "praia", "beach", "mar", "oceano", "litoral", "ocean", "sea", "agua" } },
}

-- Palavras sem significado para o interpretador
Grammar.Stopwords = {
	"o",
	"a",
	"os",
	"as",
	"uns",
	"umas",
	"the",
	"an",
	"quero",
	"queria",
	"quer",
	"crie",
	"criar",
	"cria",
	"faca",
	"faz",
	"fazer",
	"gere",
	"gerar",
	"invoque",
	"invocar",
	"aparece",
	"aparecer",
	"apareca",
	"surge",
	"surgir",
	"spawn",
	"summon",
	"create",
	"make",
	"spawne",
	"por",
	"favor",
	"pls",
	"please",
	"plz",
	"agora",
	"now",
	"que",
	"qual",
	"isso",
	"esse",
	"essa",
	"este",
	"esta",
	"ele",
	"ela",
	"seu",
	"sua",
	"um pouco",
	"tipo",
	"like",
	"some",
	"algum",
	"alguma",
	"aqui",
	"here",
	"pra",
	"para",
	"for",
	"to",
	"ai",
	"la",
	"entao",
	"so",
	"tudo",
	"todo",
	"toda",
	"lol",
	"kkk",
	"kk",
	"haha",
	"pfv",
	"vc",
	"voce",
	"sendo",
	"is",
	"are",
	"be",
	"ser",
	"ter",
	"tem",
	"novo",
	"nova",
	"new",
	-- palavras vagas: nunca viram nome de personagem
	"algo",
	"alguma coisa",
	"coisa",
	"coisas",
	"qualquer",
	"qualquer coisa",
	"aleatorio",
	"aleatoria",
	"random",
	"legal",
	"maneiro",
	"maneira",
	"irado",
	"irada",
	"top",
	"daora",
	"massa",
	"incrivel",
	"bonito",
	"bonita",
	"doido",
	"doida",
	"engracado",
	"engracada",
	"estranho",
	"estranha",
	"diferente",
	"something",
	"anything",
	"cool",
	"awesome",
	"funny",
	"nada",
	"oi",
	"ola",
	"hello",
	"teste",
	"test",
	"sim",
	"nao",
	"ok",
	"eae",
	"salve",
	"mano",
	"cara",
	"vei",
	"mais um",
	"outro",
	"outra",
	"mesmo",
	"mesma",
	"muito louco",
	"novamente",
	"de novo",
	"again",
	"pode",
	"consegue",
	"tenta",
	"quando",
	"onde",
	"como",
	"porque",
	"pq",
	"mas",
	"tbm",
	"tambem nao",
	"bem vindo",
}

return Grammar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Interactions</string>
            <string name="Source"><![CDATA[--!strict
-- Regras de interação entre duas ideias do mesmo pedido.
-- Avaliadas em ordem; a primeira que combinar (em qualquer ordem A/B) vence.
--   rel     relação escrita: versus | guard | ride | location | conjunction
--   a, b    seletores: category (string ou lista), tag, notTag
--   link    vínculo aplicado: rivals | guard | bodyguard | ride | at | hunt
-- Novas interações entram aqui, sem alterar o interpretador.

export type Selector = { category: any?, tag: string?, notTag: string? }
export type Rule = { id: string, rel: string, a: Selector, b: Selector, link: string }

local rules: { Rule } = {
	-- relações explícitas --------------------------------------------------
	{ id = "versus_creatures", rel = "versus", a = { category = "creature" }, b = { category = "creature" }, link = "rivals" },
	{ id = "versus_vehicle", rel = "versus", a = { category = "creature" }, b = { category = "vehicle" }, link = "rivals" },
	{ id = "guard_building", rel = "guard", a = { category = "creature" }, b = { category = "building" }, link = "guard" },
	{ id = "guard_thing", rel = "guard", a = { category = "creature" }, b = { category = { "object", "food", "nature", "vehicle" } }, link = "guard" },
	{ id = "guard_creature", rel = "guard", a = { category = "creature" }, b = { category = "creature" }, link = "bodyguard" },
	{ id = "ride_vehicle", rel = "ride", a = { category = "creature" }, b = { category = "vehicle" }, link = "ride" },
	{ id = "ride_creature", rel = "ride", a = { category = "creature" }, b = { category = "creature" }, link = "ride" },
	{ id = "inside_vehicle", rel = "location", a = { category = "creature" }, b = { category = "vehicle" }, link = "ride" },
	{ id = "inside_building", rel = "location", a = { category = { "creature", "object", "food", "vehicle", "nature" } }, b = { category = "building" }, link = "at" },
	{ id = "at_nature", rel = "location", a = { category = { "creature", "object", "food" } }, b = { category = "nature" }, link = "at" },

	-- interações implícitas ("e", "com", vírgula) ---------------------------
	{ id = "good_vs_evil", rel = "conjunction", a = { tag = "good" }, b = { tag = "evil" }, link = "rivals" },
	{ id = "beast_vs_machine", rel = "conjunction", a = { tag = "beast" }, b = { tag = "machine" }, link = "rivals" },
	{ id = "predator_prey", rel = "conjunction", a = { tag = "predator" }, b = { tag = "prey" }, link = "hunt" },
	{ id = "undead_hunt", rel = "conjunction", a = { tag = "undead" }, b = { tag = "humanoid", notTag = "undead" }, link = "hunt" },
	{ id = "monster_castle", rel = "conjunction", a = { category = "creature", tag = "evil" }, b = { category = "building" }, link = "guard" },
	{ id = "creature_home", rel = "conjunction", a = { category = "creature" }, b = { category = "building" }, link = "at" },
}

return rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Modifiers</string>
            <string name="Source"><![CDATA[--!strict
-- Modificadores: palavras que alteram um conceito (tamanho, elemento, material...).
-- Campos:
--   id, axis       identificação e "eixo" (só um modificador por eixo é aplicado)
--   label/labelF   texto exibido (masculino/feminino); prefix=true coloca antes do nome
--   aliases        palavras reconhecidas (PT/EN, com ou sem acento)
--   patch          alterações aplicadas aos parâmetros do conceito
--   standalone     conceito usado quando a palavra aparece sozinha ("gigante" -> poder)
--   order          ordem do rótulo (menor aparece primeiro depois do nome)

export type Modifier = {
	id: string,
	axis: string,
	label: string,
	labelF: string?,
	aliases: { string },
	patch: { [string]: any },
	standalone: string?,
	order: number?,
}

local M: { Modifier } = {
	-- TAMANHO ----------------------------------------------------------------
	{
		id = "tiny",
		axis = "size",
		label = "Minúsculo",
		labelF = "Minúscula",
		aliases = { "minusculo", "minuscula", "tiny", "micro", "pequenininho", "pequenininha", "nanico" },
		patch = { scale = 0.35, hp = 0.4 },
		standalone = "power_tiny",
		order = 5,
	},
	{
		id = "small",
		axis = "size",
		label = "Pequeno",
		labelF = "Pequena",
		aliases = { "pequeno", "pequena", "small", "little", "mini", "baixinho", "filhote", "bebe", "baby" },
		patch = { scale = 0.6, hp = 0.6 },
		standalone = "power_tiny",
		order = 5,
	},
	{
		id = "giant",
		axis = "size",
		label = "Gigante",
		aliases = {
			"gigante",
			"grande",
			"enorme",
			"giant",
			"big",
			"huge",
			"large",
			"gigantesco",
			"gigantesca",
			"imenso",
			"imensa",
			"grandao",
		},
		patch = { scale = 2.4, hp = 3 },
		standalone = "power_giant",
		order = 5,
	},
	{
		id = "colossal",
		axis = "size",
		label = "Colossal",
		aliases = { "colossal", "titanico", "titanica", "titan", "colosso", "monstruoso", "monstruosa", "gigantesimo" },
		patch = { scale = 4, hp = 6 },
		standalone = "power_giant",
		order = 5,
	},
	{
		id = "boss",
		axis = "rank",
		label = "Rei",
		labelF = "Rainha",
		aliases = { "chefe", "boss", "lendario", "lendaria", "legendary", "supremo", "suprema", "alfa", "alpha", "lord" },
		patch = { scale = 1.7, hp = 5, boss = true },
		order = 1,
	},

	-- ELEMENTOS --------------------------------------------------------------
	{
		id = "fire",
		axis = "element",
		label = "de Fogo",
		aliases = {
			"flamejante",
			"em chamas",
			"pegando fogo",
			"incendiario",
			"incendiaria",
			"fire",
			"flame",
			"flaming",
			"burning",
			"fiery",
			"ardente",
			"infernal",
			"chamuscado",
		},
		patch = { element = "fire" },
		standalone = "fire",
		order = 2,
	},
	{
		id = "ice",
		axis = "element",
		label = "de Gelo",
		aliases = {
			"congelante",
			"gelado",
			"gelada",
			"glacial",
			"congelado",
			"congelada",
			"frio",
			"fria",
			"ice",
			"icy",
			"frozen",
			"frost",
			"nevado",
			"nevada",
			"polar",
		},
		patch = { element = "ice" },
		standalone = "ice_burst",
		order = 2,
	},
	{
		id = "electric",
		axis = "element",
		label = "Elétrico",
		labelF = "Elétrica",
		aliases = {
			"eletrico",
			"eletrica",
			"eletricidade",
			"eletrizante",
			"choque",
			"electric",
			"electrical",
			"shock",
			"voltaico",
			"energizado",
			"energizada",
			"plasma",
		},
		patch = { element = "electric" },
		standalone = "lightning",
		order = 2,
	},
	{
		id = "poison",
		axis = "element",
		label = "Venenoso",
		labelF = "Venenosa",
		aliases = {
			"venenoso",
			"venenosa",
			"veneno",
			"toxico",
			"toxica",
			"radioativo",
			"radioativa",
			"poison",
			"poisonous",
			"toxic",
			"acido",
			"acida",
			"radioactive",
		},
		patch = { element = "poison" },
		standalone = "acid_rain",
		order = 2,
	},
	{
		id = "water",
		axis = "element",
		label = "de Água",
		aliases = { "agua", "aquatico", "aquatica", "marinho", "marinha", "water", "aqua", "molhado", "molhada" },
		patch = { element = "water" },
		standalone = "rain",
		order = 2,
	},
	{
		id = "shadow",
		axis = "element",
		label = "Sombrio",
		labelF = "Sombria",
		aliases = {
			"sombrio",
			"sombria",
			"sombra",
			"trevas",
			"das trevas",
